{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "西遊記辞書 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dictionary_id",
    "title_ja",
    "sources",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dictionary_id": {
      "const": "xiyouji"
    },
    "title_ja": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "accessed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_ids",
        "reason_ja"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "estimated"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason_ja": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kana",
        "status",
        "source_ids",
        "reason_ja"
      ],
      "properties": {
        "kana": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ぁ-ゖァ-ヺー・ 　]+$"
        },
        "status": {
          "enum": [
            "verified",
            "estimated"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reason_ja": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "relation",
        "reading"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "relation": {
          "enum": [
            "preferred",
            "alias",
            "variant",
            "title",
            "short_form"
          ]
        },
        "reading": {
          "$ref": "#/$defs/reading"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "headword",
        "definition_ja",
        "definition_evidence",
        "forms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "enum": [
            "person",
            "place",
            "title",
            "object",
            "concept",
            "term"
          ]
        },
        "headword": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definition_ja": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "definition_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/form"
          },
          "minItems": 1
        }
      }
    }
  }
}
