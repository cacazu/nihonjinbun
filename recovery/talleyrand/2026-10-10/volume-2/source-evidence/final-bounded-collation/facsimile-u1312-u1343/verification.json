      "letter_heading": "Nº 9. — LE PRINCE DE TALLEYRAND AU ROI LOUIS XVIII.",
      "dateline_unit": "v02-u001337",
      "dateline_page": 409,
      "dateline_excerpt": "facsimile-u1312-u1343/u001337-letter9-date.png",
      "dateline_crop_xyxy": [
        190,
