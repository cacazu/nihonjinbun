        "edition": "日本学術研究会、1912年（明治45年）4月15日発行。"
      }
    ],
    "scope": {
      "included": [
        {
          "source_id": "ndl-899565",
          "description_ja": "標題・口絵と題詞・序・凡例・著者著述目録・印刷目次・全五編二十二章九十六節（本文一〜六一六頁）・刊記。"
        }
      ],
      "excluded": [
        {
          "source_id": "ndl-899565",
          "description_ja": "巻末の他書広告、所蔵管理書入れ、白紙、重複撮影の口絵・欧文標題紙と本文末尾・刊記。"
        }
      ],
      "known_gaps": [
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0027-001"
          ],
          "description_ja": "底本で「隠居家」に添えられた小字は「現岐小津氏」と採録したが、「現岐」の字形は確定できない。訳では、前後から確認できる小津氏の隠居家という関係だけを示した。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0088-003"
          ],
          "description_ja": "「翌る十年」は底本の記載による。直前の「延享三年」や後続の勤仕十四年という説明との年次関係は確定できないため、年号・年次を推定して補っていない。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0103-004"
          ],
          "description_ja": "底本は「思ひ四もに走せ」とあり、否定の字を確認できない。ここでは、続く「ただまのあたりのみにして」「さとさも少し」という文脈から「思いを四方へ走らせず」と解した。否定を含むこの読みは推定である。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0105-006"
          ],
          "description_ja": "この引用では「この五つ」と繰り返すが、直前に挙げるのは仁・義・礼・智の四語である。底本の不一致を残し、第五の語を補っていない。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0113-002"
          ],
          "description_ja": "千蔭の字と号の漢字表記には判読しきれない字があるため、訳では確認できる読みを用い、「常世まろ」「うけら園」とした。漢字表記を推定して確定したものではない。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0144-note-names"
          ],
          "description_ja": "帆足の引用のうち「亦據」の後から「孁之名」の前までの数文字は判読を留保する。「ひるめの名により」という訳は、続く「孁字和詁與女同」などの読める箇所を手掛かりにした解釈であり、不鮮明な字句を確定したものではない。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0172-note-ichikawa"
          ],
          "description_ja": "市川の名の後字は、この原注と本文の各出現箇所で一意に判読できない。訳では確認できる号「市川鶴鳴」を用い、名の漢字を推定して統一していない。通称と没日は底本の読める記載による。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0234-004"
          ],
          "description_ja": "底本は「道の爲、下には」と記す。「天下」の「天」が欠けた可能性を考え、訳では文脈によって「道のため、天下のためには」と補った。この補いは訳者の推定である。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0250-004"
          ],
          "description_ja": "「神の宮居」に続く一字は「と」「さ」のいずれかを確定できず、「ひきたかく」までの句切りと意味にも留保がある。「宮居と、ひときわ高く仰ぎ」は暫定の解釈である。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0262-005"
          ],
          "description_ja": "底本の引用冒頭は「神が氣の意なり」と見えるが、直前の「加美」の「加」と後続の「ミ」の説明に従い、「かが、気の意味」と解した。また「のは箆など」の「箆」の字形も確定できない。「か」と「箆」の訳にはこの留保がある。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0268-001"
          ],
          "description_ja": "底本は「弘訓の業を授かりたる荒木田久老」と記し、授受の関係が前後と整わない。直前の師事の記事と続く「師久老」に基づき、訳では久老が弘訓に学問を授けたと解した。これは文脈による解釈である。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0297-003"
          ],
          "description_ja": "歌の二箇所で「風の音の」に続く語は「とほさ」と採読したが、初字が不鮮明で確定できない。「遠くから聞き」という訳も暫定の解釈である。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0301-003"
          ],
          "description_ja": "市川の名の後字は本書の各出現箇所で判読を留保している。ここでも確認できる号「鶴鳴」を用い、名の漢字を推定して補っていない。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0314-002"
          ],
          "description_ja": "長歌冒頭の「うまこりの」は底本の表記に従った。この枕詞の語釈は確定できないため、訳にも原語を残した。"
        },
        {
          "source_id": "ndl-899565",
          "segment_ids": [
            "mn-0323-003"
          ],
          "description_ja": "「琢玉の器」は比喩の係り先を確定できないため、「玉を磨く器」と仮に訳した。器を人物とする解釈を本文で補わず、厳密な語釈は留保する。"
        }
      ]
    },
    "workflow": {
