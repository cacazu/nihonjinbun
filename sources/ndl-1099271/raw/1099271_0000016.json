[{"id":0,"contenttext":"二四","xmin":2774.0,"ymin":1712.0,"xmax":2817.0,"ymax":1791.0},{"id":1,"contenttext":"この据付に當つた日本人技師の精神、","xmin":2696.0,"ymin":1235.0,"xmax":2755.0,"ymax":1896.0},{"id":2,"contenttext":"來ません」と云つたさうであります。","xmin":2708.0,"ymin":561.0,"xmax":2766.0,"ymax":1220.0},{"id":3,"contenttext":"この据付に當つた日本人技師の精神、","xmin":2696.0,"ymin":1235.0,"xmax":2755.0,"ymax":1896.0},{"id":4,"contenttext":"これが日本精","xmin":2692.0,"ymin":1905.0,"xmax":2742.0,"ymax":2147.0},{"id":5,"contenttext":"神であります。","xmin":2647.0,"ymin":562.0,"xmax":2693.0,"ymax":821.0},{"id":6,"contenttext":"獨逸の","xmin":2571.0,"ymin":597.0,"xmax":2621.0,"ymax":722.0},{"id":7,"contenttext":"ヒットラーは、","xmin":2570.0,"ymin":731.0,"xmax":2616.0,"ymax":975.0},{"id":8,"contenttext":"初めは日本人に對する認識が、","xmin":2557.0,"ymin":989.0,"xmax":2614.0,"ymax":1537.0},{"id":9,"contenttext":"甚だ不十分で、","xmin":2550.0,"ymin":1540.0,"xmax":2604.0,"ymax":1812.0},{"id":10,"contenttext":"日本人は人眞似ば","xmin":2545.0,"ymin":1822.0,"xmax":2598.0,"ymax":2142.0},{"id":11,"contenttext":"かり上手で、","xmin":2498.0,"ymin":562.0,"xmax":2545.0,"ymax":784.0},{"id":12,"contenttext":"仮りに十年間西洋文明を日本に入れないやうにすれば、","xmin":2480.0,"ymin":787.0,"xmax":2545.0,"ymax":1766.0},{"id":13,"contenttext":"日本は德川時代の野","xmin":2472.0,"ymin":1781.0,"xmax":2526.0,"ymax":2142.0},{"id":14,"contenttext":"蠻に歸ると云ひました。","xmin":2426.0,"ymin":553.0,"xmax":2476.0,"ymax":977.0},{"id":15,"contenttext":"所が先年獨逸で開かれたオリンピツク大會の時、","xmin":2408.0,"ymin":985.0,"xmax":2471.0,"ymax":1838.0},{"id":16,"contenttext":"ヒットラーが日","xmin":2407.0,"ymin":1879.0,"xmax":2448.0,"ymax":2137.0},{"id":17,"contenttext":"本人選手の高尙なる武士道的態度を見て、","xmin":2340.0,"ymin":553.0,"xmax":2406.0,"ymax":1296.0},{"id":18,"contenttext":"全く威心しました。","xmin":2330.0,"ymin":1299.0,"xmax":2393.0,"ymax":1647.0},{"id":19,"contenttext":"かくて、","xmin":2335.0,"ymin":1659.0,"xmax":2378.0,"ymax":1806.0},{"id":20,"contenttext":"彼の日本に對する","xmin":2325.0,"ymin":1814.0,"xmax":2381.0,"ymax":2138.0},{"id":21,"contenttext":"認識を大いに修正したのであります。","xmin":2270.0,"ymin":553.0,"xmax":2329.0,"ymax":1210.0},{"id":22,"contenttext":"元來日本人は决してそんな眞似ばかりする國民では","xmin":2252.0,"ymin":1223.0,"xmax":2318.0,"ymax":2139.0},{"id":23,"contenttext":"ないのであります。","xmin":2209.0,"ymin":552.0,"xmax":2253.0,"ymax":889.0},{"id":24,"contenttext":"卽ち機械を作るだけの力があるから、","xmin":2191.0,"ymin":902.0,"xmax":2251.0,"ymax":1562.0},{"id":25,"contenttext":"据付も完全にやれるのである。","xmin":2181.0,"ymin":1579.0,"xmax":2239.0,"ymax":2119.0},{"id":26,"contenttext":"\"","xmin":2157.0,"ymin":1588.0,"xmax":2179.0,"ymax":1614.0},{"id":27,"contenttext":"學問にしても、","xmin":2129.0,"ymin":549.0,"xmax":2184.0,"ymax":810.0},{"id":28,"contenttext":"文字は支那から輸入したのであるが、","xmin":2114.0,"ymin":824.0,"xmax":2179.0,"ymax":1485.0},{"id":29,"contenttext":"別に仮名を發明してゐる。","xmin":2109.0,"ymin":1494.0,"xmax":2165.0,"ymax":1958.0},{"id":30,"contenttext":"文章は全","xmin":2102.0,"ymin":1970.0,"xmax":2158.0,"ymax":2138.0},{"id":31,"contenttext":"く日本の創造で、","xmin":2060.0,"ymin":550.0,"xmax":2106.0,"ymax":849.0},{"id":32,"contenttext":"それは支那人にもすぐは讀めません。","xmin":2046.0,"ymin":865.0,"xmax":2104.0,"ymax":1523.0},{"id":33,"contenttext":"儒〓などでも日本に來て、","xmin":2036.0,"ymin":1533.0,"xmax":2091.0,"ymax":1994.0},{"id":34,"contenttext":"皇道に","xmin":2034.0,"ymin":2009.0,"xmax":2083.0,"ymax":2135.0},{"id":35,"contenttext":"立脚して日本に擴まつたのであります。","xmin":1978.0,"ymin":549.0,"xmax":2038.0,"ymax":1242.0},{"id":36,"contenttext":"その外日本には國文學といふ立派な學問が創造せ","xmin":1956.0,"ymin":1255.0,"xmax":2025.0,"ymax":2134.0},{"id":37,"contenttext":"られてゐます。","xmin":1916.0,"ymin":547.0,"xmax":1961.0,"ymax":809.0},{"id":38,"contenttext":"宗〓にしても、","xmin":1907.0,"ymin":822.0,"xmax":1960.0,"ymax":1083.0},{"id":39,"contenttext":"佛〓、","xmin":1906.0,"ymin":1096.0,"xmax":1951.0,"ymax":1209.0},{"id":40,"contenttext":"キリスト〓等、","xmin":1899.0,"ymin":1219.0,"xmax":1952.0,"ymax":1477.0},{"id":41,"contenttext":"日本の佛〓、","xmin":1896.0,"ymin":1498.0,"xmax":1943.0,"ymax":1725.0},{"id":42,"contenttext":"日本のキリスト〓とし","xmin":1890.0,"ymin":1732.0,"xmax":1938.0,"ymax":2130.0},{"id":43,"contenttext":"これが日本精","xmin":2692.0,"ymin":1905.0,"xmax":2742.0,"ymax":2147.0},{"id":44,"contenttext":"て發達してゐる。","xmin":1326.0,"ymin":545.0,"xmax":1372.0,"ymax":839.0},{"id":45,"contenttext":"技術にしても日本建築は特別に創造せられてゐる。","xmin":1312.0,"ymin":855.0,"xmax":1370.0,"ymax":1751.0},{"id":46,"contenttext":"勿論耐震耐火とは云","xmin":1308.0,"ymin":1764.0,"xmax":1360.0,"ymax":2129.0},{"id":47,"contenttext":"へないが、","xmin":1252.0,"ymin":550.0,"xmax":1296.0,"ymax":724.0},{"id":48,"contenttext":"住み心地は、","xmin":1246.0,"ymin":733.0,"xmax":1296.0,"ymax":958.0},{"id":49,"contenttext":"實に申分ないのである。","xmin":1244.0,"ymin":972.0,"xmax":1294.0,"ymax":1393.0},{"id":50,"contenttext":"服裝でも、","xmin":1240.0,"ymin":1409.0,"xmax":1296.0,"ymax":1594.0},{"id":51,"contenttext":"洋服も便利ではあるが、","xmin":1235.0,"ymin":1603.0,"xmax":1288.0,"ymax":2029.0},{"id":52,"contenttext":"何と","xmin":1236.0,"ymin":2046.0,"xmax":1282.0,"ymax":2125.0},{"id":53,"contenttext":"云つても日本服は日本人に氣持がよい、","xmin":1170.0,"ymin":543.0,"xmax":1225.0,"ymax":1240.0},{"id":54,"contenttext":"又特徴を持つてゐる。","xmin":1168.0,"ymin":1249.0,"xmax":1216.0,"ymax":1631.0},{"id":55,"contenttext":"日本婦人の髪は日本人の發","xmin":1159.0,"ymin":1647.0,"xmax":1212.0,"ymax":2130.0},{"id":56,"contenttext":"明である。","xmin":1104.0,"ymin":542.0,"xmax":1150.0,"ymax":721.0},{"id":57,"contenttext":"科學にしても、","xmin":1102.0,"ymin":737.0,"xmax":1148.0,"ymax":997.0},{"id":58,"contenttext":"野口英世博士の樣な發明がある。","xmin":1090.0,"ymin":1013.0,"xmax":1147.0,"ymax":1591.0},{"id":59,"contenttext":"長岡半太郞博士の水銀から金","xmin":1085.0,"ymin":1605.0,"xmax":1141.0,"ymax":2129.0},{"id":60,"contenttext":"を採る發明がある。","xmin":1025.0,"ymin":539.0,"xmax":1078.0,"ymax":876.0},{"id":61,"contenttext":"昔から金を作るのには、","xmin":1020.0,"ymin":892.0,"xmax":1072.0,"ymax":1318.0},{"id":62,"contenttext":"各國の人が非常に苦心したものである。","xmin":1012.0,"ymin":1326.0,"xmax":1070.0,"ymax":2027.0},{"id":63,"contenttext":"然る","xmin":1016.0,"ymin":2039.0,"xmax":1060.0,"ymax":2125.0},{"id":64,"contenttext":"にそれを長岡博士は完成した。","xmin":951.0,"ymin":541.0,"xmax":1004.0,"ymax":1079.0},{"id":65,"contenttext":"殊にすぐれたものには美術がある。","xmin":944.0,"ymin":1091.0,"xmax":999.0,"ymax":1710.0},{"id":66,"contenttext":"日本の繪〓、","xmin":939.0,"ymin":1728.0,"xmax":991.0,"ymax":1956.0},{"id":67,"contenttext":"彫刻等は","xmin":941.0,"ymin":1961.0,"xmax":989.0,"ymax":2127.0},{"id":68,"contenttext":"頗る優美である。","xmin":881.0,"ymin":538.0,"xmax":933.0,"ymax":837.0},{"id":69,"contenttext":"日本の某洋〓家が佛蘭西に留學して、","xmin":872.0,"ymin":853.0,"xmax":927.0,"ymax":1508.0},{"id":70,"contenttext":"佛蘭西の大〓家ヴラマンク氏に就","xmin":869.0,"ymin":1523.0,"xmax":923.0,"ymax":2129.0},{"id":71,"contenttext":"いて學んだ。","xmin":807.0,"ymin":540.0,"xmax":856.0,"ymax":758.0},{"id":72,"contenttext":"或日ヴラマンク氏が、","xmin":803.0,"ymin":773.0,"xmax":856.0,"ymax":1154.0},{"id":73,"contenttext":"「貴君は日本から何の爲に佛蘭西に留學に來たか」と","xmin":789.0,"ymin":1184.0,"xmax":853.0,"ymax":2124.0},{"id":74,"contenttext":"たづねた。","xmin":734.0,"ymin":537.0,"xmax":781.0,"ymax":719.0},{"id":75,"contenttext":"「日本にはよい先生がないから留學に來たのです」と答へた。","xmin":718.0,"ymin":746.0,"xmax":783.0,"ymax":1830.0},{"id":76,"contenttext":"すると、","xmin":722.0,"ymin":1842.0,"xmax":765.0,"ymax":1991.0},{"id":77,"contenttext":"ヴラマ","xmin":724.0,"ymin":2002.0,"xmax":761.0,"ymax":2116.0},{"id":78,"contenttext":"ンク氏は、","xmin":661.0,"ymin":540.0,"xmax":707.0,"ymax":722.0},{"id":79,"contenttext":"「それは考が違つてゐる、","xmin":656.0,"ymin":748.0,"xmax":708.0,"ymax":1194.0},{"id":80,"contenttext":"私が多年先生として研究してゐるものを見せよう」","xmin":646.0,"ymin":1204.0,"xmax":702.0,"ymax":2110.0},{"id":81,"contenttext":"た","xmin":621.0,"ymin":1088.0,"xmax":646.0,"ymax":1135.0},{"id":82,"contenttext":"と云つて示したものは、","xmin":584.0,"ymin":538.0,"xmax":637.0,"ymax":959.0},{"id":83,"contenttext":"蕪村や大雅の描いた〓の〓帖であつた。","xmin":573.0,"ymin":964.0,"xmax":630.0,"ymax":1666.0},{"id":84,"contenttext":"ヴラマンク氏は、","xmin":573.0,"ymin":1683.0,"xmax":621.0,"ymax":1989.0},{"id":85,"contenttext":"かくて","xmin":573.0,"ymin":2002.0,"xmax":616.0,"ymax":2121.0},{"id":86,"contenttext":"告げて","xmin":517.0,"ymin":533.0,"xmax":561.0,"ymax":656.0},{"id":87,"contenttext":"「藝術は死せず。","xmin":511.0,"ymin":663.0,"xmax":562.0,"ymax":955.0},{"id":88,"contenttext":"日本獨特の大藝術がある。","xmin":503.0,"ymin":968.0,"xmax":560.0,"ymax":1430.0},{"id":89,"contenttext":"予も蕪村や大雅の境地に達せんと日夜","xmin":495.0,"ymin":1437.0,"xmax":553.0,"ymax":2127.0}]