[{"id":0,"contenttext":"一四","xmin":2769.0,"ymin":1724.0,"xmax":2812.0,"ymax":1796.0},{"id":1,"contenttext":"皇道は萬世一系の皇統を戴いてゐる。","xmin":2699.0,"ymin":604.0,"xmax":2749.0,"ymax":1260.0},{"id":2,"contenttext":"この萬世一系の皇統を戴いてゐる皇道の使命は、","xmin":2693.0,"ymin":1276.0,"xmax":2746.0,"ymax":2127.0},{"id":3,"contenttext":"東洋永遠の平和、","xmin":2623.0,"ymin":562.0,"xmax":2674.0,"ymax":863.0},{"id":4,"contenttext":"世界永遠の平和を建設し、","xmin":2622.0,"ymin":879.0,"xmax":2673.0,"ymax":1345.0},{"id":5,"contenttext":"八絃一字の大理想を實現するにあるのであり","xmin":2616.0,"ymin":1352.0,"xmax":2671.0,"ymax":2149.0},{"id":6,"contenttext":"ます。","xmin":2557.0,"ymin":564.0,"xmax":2598.0,"ymax":668.0},{"id":7,"contenttext":"世界永遠の平和といふことは、","xmin":2479.0,"ymin":603.0,"xmax":2528.0,"ymax":1137.0},{"id":8,"contenttext":"西洋などでも云ふのでありますが、","xmin":2478.0,"ymin":1154.0,"xmax":2525.0,"ymax":1776.0},{"id":9,"contenttext":"しかし西洋ではとて","xmin":2474.0,"ymin":1786.0,"xmax":2520.0,"ymax":2147.0},{"id":10,"contenttext":"も出來ぬのであります。","xmin":2405.0,"ymin":563.0,"xmax":2455.0,"ymax":982.0},{"id":11,"contenttext":"何故かと云へば、","xmin":2405.0,"ymin":993.0,"xmax":2452.0,"ymax":1296.0},{"id":12,"contenttext":"彼等の國家は朝に興り夕に亡ぶのであるからで","xmin":2400.0,"ymin":1311.0,"xmax":2450.0,"ymax":2147.0},{"id":13,"contenttext":"あります。","xmin":2340.0,"ymin":562.0,"xmax":2379.0,"ymax":739.0},{"id":14,"contenttext":"昔アレキサンダー大王は、","xmin":2333.0,"ymin":757.0,"xmax":2383.0,"ymax":1214.0},{"id":15,"contenttext":"四方を征服して、","xmin":2330.0,"ymin":1233.0,"xmax":2380.0,"ymax":1532.0},{"id":16,"contenttext":"大王國を建設したのでありました","xmin":2325.0,"ymin":1547.0,"xmax":2380.0,"ymax":2145.0},{"id":17,"contenttext":"が、","xmin":2262.0,"ymin":560.0,"xmax":2311.0,"ymax":624.0},{"id":18,"contenttext":"王一たび殘するや、","xmin":2261.0,"ymin":640.0,"xmax":2310.0,"ymax":978.0},{"id":19,"contenttext":"その大國家は四分五裂、","xmin":2255.0,"ymin":993.0,"xmax":2307.0,"ymax":1413.0},{"id":20,"contenttext":"あはれはかないものとなりました。","xmin":2250.0,"ymin":1430.0,"xmax":2304.0,"ymax":2047.0},{"id":21,"contenttext":"口","xmin":2262.0,"ymin":2073.0,"xmax":2288.0,"ymax":2140.0},{"id":22,"contenttext":"マ帝國亦當時各地を征服し、","xmin":2187.0,"ymin":569.0,"xmax":2236.0,"ymax":1062.0},{"id":23,"contenttext":"殆んど當時知られた全世界を征服し、","xmin":2180.0,"ymin":1071.0,"xmax":2232.0,"ymax":1730.0},{"id":24,"contenttext":"ローマの滅亡は世界の","xmin":2179.0,"ymin":1752.0,"xmax":2227.0,"ymax":2144.0},{"id":25,"contenttext":"滅亡であるとさへ豪語したのであります。","xmin":2108.0,"ymin":560.0,"xmax":2164.0,"ymax":1294.0},{"id":26,"contenttext":"而かしローマ人は、","xmin":2107.0,"ymin":1310.0,"xmax":2156.0,"ymax":1655.0},{"id":27,"contenttext":"多くの殖民地から、","xmin":2103.0,"ymin":1665.0,"xmax":2160.0,"ymax":2011.0},{"id":28,"contenttext":"山の樣","xmin":2105.0,"ymin":2022.0,"xmax":2152.0,"ymax":2147.0},{"id":29,"contenttext":"に金銀財寶が流れ込んだ、","xmin":2036.0,"ymin":558.0,"xmax":2090.0,"ymax":1023.0},{"id":30,"contenttext":"その金銀財寶で、","xmin":2034.0,"ymin":1033.0,"xmax":2087.0,"ymax":1340.0},{"id":31,"contenttext":"榮華の夢をむさぼつて居ります間に、","xmin":2031.0,"ymin":1349.0,"xmax":2082.0,"ymax":2011.0},{"id":32,"contenttext":"遂に北","xmin":2031.0,"ymin":2020.0,"xmax":2077.0,"ymax":2147.0},{"id":33,"contenttext":"おの競武の爲にはこれて仕舞つたのであるまで後又もヒロ大帝忠を","xmin":1956.0,"ymin":558.0,"xmax":2016.0,"ymax":2142.0},{"id":34,"contenttext":"のでありますが、","xmin":1893.0,"ymin":560.0,"xmax":1939.0,"ymax":856.0},{"id":35,"contenttext":"大帝一たび死するに及んでは、","xmin":1884.0,"ymin":870.0,"xmax":1941.0,"ymax":1418.0},{"id":36,"contenttext":"その大帝國も全く亡びてしまつたのであ","xmin":1880.0,"ymin":1423.0,"xmax":1936.0,"ymax":2144.0},{"id":37,"contenttext":"by","xmin":1365.0,"ymin":1149.0,"xmax":1389.0,"ymax":1192.0},{"id":38,"contenttext":"ります。","xmin":1336.0,"ymin":555.0,"xmax":1374.0,"ymax":694.0},{"id":39,"contenttext":"ナボレオン大帝の國家亦然りで、","xmin":1324.0,"ymin":709.0,"xmax":1379.0,"ymax":1293.0},{"id":40,"contenttext":"ウォータールーに一敗するや、","xmin":1320.0,"ymin":1313.0,"xmax":1366.0,"ymax":1838.0},{"id":41,"contenttext":"又憐むべき狀態","xmin":1316.0,"ymin":1857.0,"xmax":1364.0,"ymax":2142.0},{"id":42,"contenttext":"となつたのであります。","xmin":1258.0,"ymin":555.0,"xmax":1304.0,"ymax":973.0},{"id":43,"contenttext":"今日强國といはれてゐる國家がいくつもありますが、","xmin":1244.0,"ymin":986.0,"xmax":1301.0,"ymax":1920.0},{"id":44,"contenttext":"いづれも皆","xmin":1243.0,"ymin":1941.0,"xmax":1291.0,"ymax":2144.0},{"id":45,"contenttext":"以上の歷史をくり返へすものと思はれます。","xmin":1174.0,"ymin":551.0,"xmax":1237.0,"ymax":1327.0},{"id":46,"contenttext":"仮りに英國について見ましても、","xmin":1175.0,"ymin":1339.0,"xmax":1224.0,"ymax":1925.0},{"id":47,"contenttext":"昔はローマ","xmin":1172.0,"ymin":1937.0,"xmax":1218.0,"ymax":2130.0},{"id":48,"contenttext":"に征服せられ、","xmin":1109.0,"ymin":550.0,"xmax":1158.0,"ymax":809.0},{"id":49,"contenttext":"ローマから總督がいつて支配したのであります。","xmin":1097.0,"ymin":835.0,"xmax":1157.0,"ymax":1683.0},{"id":50,"contenttext":"ローマが滅亡しますと總","xmin":1089.0,"ymin":1706.0,"xmax":1147.0,"ymax":2141.0},{"id":51,"contenttext":"督は勿論引上ました。","xmin":1035.0,"ymin":548.0,"xmax":1085.0,"ymax":931.0},{"id":52,"contenttext":"然るにその後英國は、","xmin":1027.0,"ymin":941.0,"xmax":1079.0,"ymax":1330.0},{"id":53,"contenttext":"獨逸の方のアングロ·サクソン人の征服を蒙","xmin":1017.0,"ymin":1348.0,"xmax":1074.0,"ymax":2141.0},{"id":54,"contenttext":"りました。","xmin":965.0,"ymin":550.0,"xmax":1007.0,"ymax":728.0},{"id":55,"contenttext":"イングランドは、アングロ人の國と云ふ意味だと云はれて居ります。","xmin":945.0,"ymin":746.0,"xmax":1009.0,"ymax":1960.0},{"id":56,"contenttext":"併し、そ","xmin":948.0,"ymin":1971.0,"xmax":990.0,"ymax":2135.0},{"id":57,"contenttext":"れがしばらく續きますと、","xmin":886.0,"ymin":548.0,"xmax":938.0,"ymax":1009.0},{"id":58,"contenttext":"今度はデンマークのカヌート大王の爲に征服せられ、","xmin":869.0,"ymin":1016.0,"xmax":933.0,"ymax":1964.0},{"id":59,"contenttext":"それが又","xmin":869.0,"ymin":1970.0,"xmax":918.0,"ymax":2137.0},{"id":60,"contenttext":"暫くするとノルマンディー侯ウヰリアマの爲に侵略せられ、","xmin":804.0,"ymin":545.0,"xmax":865.0,"ymax":1600.0},{"id":61,"contenttext":"國家を建設せられたのであり","xmin":797.0,"ymin":1615.0,"xmax":852.0,"ymax":2137.0},{"id":62,"contenttext":"ます。","xmin":748.0,"ymin":543.0,"xmax":787.0,"ymax":648.0},{"id":63,"contenttext":"この樣に、","xmin":743.0,"ymin":667.0,"xmax":790.0,"ymax":845.0},{"id":64,"contenttext":"今日の强國、","xmin":736.0,"ymin":860.0,"xmax":787.0,"ymax":1086.0},{"id":65,"contenttext":"英","xmin":734.0,"ymin":1095.0,"xmax":787.0,"ymax":1167.0},{"id":66,"contenttext":"米、","xmin":734.0,"ymin":1179.0,"xmax":782.0,"ymax":1244.0},{"id":67,"contenttext":"獨、","xmin":731.0,"ymin":1256.0,"xmax":782.0,"ymax":1329.0},{"id":68,"contenttext":"佛その他の列國の歷史から見まして、","xmin":723.0,"ymin":1333.0,"xmax":781.0,"ymax":2003.0},{"id":69,"contenttext":"興亡常","xmin":718.0,"ymin":2010.0,"xmax":775.0,"ymax":2142.0},{"id":70,"contenttext":"ならないのでありますから、","xmin":663.0,"ymin":545.0,"xmax":716.0,"ymax":1050.0},{"id":71,"contenttext":"今强大をはこる某大國でも、","xmin":657.0,"ymin":1057.0,"xmax":711.0,"ymax":1562.0},{"id":72,"contenttext":"一兩年の間に滅亡して仕舞ふか","xmin":647.0,"ymin":1583.0,"xmax":703.0,"ymax":2135.0},{"id":73,"contenttext":"も知れません。","xmin":593.0,"ymin":545.0,"xmax":644.0,"ymax":806.0},{"id":74,"contenttext":"實に海外諸强國の運命ほど、","xmin":582.0,"ymin":816.0,"xmax":641.0,"ymax":1325.0},{"id":75,"contenttext":"はかり知られないものはありません。","xmin":576.0,"ymin":1335.0,"xmax":633.0,"ymax":1998.0},{"id":76,"contenttext":"それで","xmin":575.0,"ymin":2012.0,"xmax":622.0,"ymax":2133.0},{"id":77,"contenttext":"ゐて、","xmin":526.0,"ymin":545.0,"xmax":565.0,"ymax":650.0},{"id":78,"contenttext":"どうして世界永久の平和の建設などが云はれませうか。","xmin":503.0,"ymin":658.0,"xmax":568.0,"ymax":1635.0},{"id":79,"contenttext":"痴人の夢を語るやうなもの","xmin":503.0,"ymin":1651.0,"xmax":551.0,"ymax":2132.0}]