[{"id":1,"contenttext":"つて來るについて、","xmin":2679.0,"ymin":559.0,"xmax":2725.0,"ymax":882.0},{"id":2,"contenttext":"その据付の爲に技師を派遣すると云つて來た、","xmin":2681.0,"ymin":918.0,"xmax":2731.0,"ymax":1715.0},{"id":3,"contenttext":"所で諸君が、","xmin":2683.0,"ymin":1762.0,"xmax":2732.0,"ymax":1952.0},{"id":4,"contenttext":"刀鍛冶が","xmin":2683.0,"ymin":2006.0,"xmax":2730.0,"ymax":2123.0},{"id":5,"contenttext":"日本刀を鍛へる時、","xmin":2605.0,"ymin":555.0,"xmax":2652.0,"ymax":884.0},{"id":6,"contenttext":"身を〓め、","xmin":2606.0,"ymin":915.0,"xmax":2654.0,"ymax":1073.0},{"id":7,"contenttext":"仕事塲を神聖にして鍛へる。","xmin":2610.0,"ymin":1118.0,"xmax":2657.0,"ymax":1587.0},{"id":8,"contenttext":"あの心を以つて据付をしたら","xmin":2610.0,"ymin":1642.0,"xmax":2657.0,"ymax":2125.0},{"id":9,"contenttext":"出來ると思ふがどうであらうと云ひましたら、","xmin":2534.0,"ymin":553.0,"xmax":2584.0,"ymax":1357.0},{"id":10,"contenttext":"技師は、","xmin":2535.0,"ymin":1399.0,"xmax":2584.0,"ymax":1515.0},{"id":11,"contenttext":"やりませうといふことになつた。","xmin":2539.0,"ymin":1559.0,"xmax":2582.0,"ymax":2103.0},{"id":12,"contenttext":"日本刀は御承知の通り神聖なものである。","xmin":2460.0,"ymin":559.0,"xmax":2510.0,"ymax":1272.0},{"id":13,"contenttext":"鎌倉時代に皇室の御物となる刀を、","xmin":2464.0,"ymin":1317.0,"xmax":2513.0,"ymax":1904.0},{"id":14,"contenttext":"全國十八人","xmin":2464.0,"ymin":1965.0,"xmax":2513.0,"ymax":2123.0},{"id":15,"contenttext":"1","xmin":2428.0,"ymin":1422.0,"xmax":2454.0,"ymax":1433.0},{"id":16,"contenttext":"の刀鍛冶に仰せつけてうたせられ、そのうち最も優れた刀を御物とすることになりました、","xmin":2386.0,"ymin":555.0,"xmax":2441.0,"ymax":2122.0},{"id":17,"contenttext":"そこで出來上つた刀を比較〓究して、","xmin":2309.0,"ymin":549.0,"xmax":2364.0,"ymax":1203.0},{"id":18,"contenttext":"相州の正宗の鍛へた刀が當選して御物になつた。","xmin":2315.0,"ymin":1234.0,"xmax":2364.0,"ymax":2066.0},{"id":19,"contenttext":"處","xmin":2318.0,"ymin":2125.0,"xmax":2366.0,"ymax":2125.0},{"id":20,"contenttext":"が越中國に〓義弘といふ刀鍛冶があつて、","xmin":2237.0,"ymin":551.0,"xmax":2289.0,"ymax":1272.0},{"id":21,"contenttext":"この十八人の中に入つてゐたが、","xmin":2238.0,"ymin":1321.0,"xmax":2289.0,"ymax":1872.0},{"id":22,"contenttext":"十分自信を持","xmin":2241.0,"ymin":1921.0,"xmax":2291.0,"ymax":2127.0},{"id":23,"contenttext":"つてゐたのに、","xmin":2166.0,"ymin":556.0,"xmax":2211.0,"ymax":806.0},{"id":24,"contenttext":"それが落ちた。","xmin":2167.0,"ymin":831.0,"xmax":2212.0,"ymax":1074.0},{"id":25,"contenttext":"そこで義弘は考へた、","xmin":2169.0,"ymin":1118.0,"xmax":2215.0,"ymax":1477.0},{"id":26,"contenttext":"これは正宗が運動したに相違ない、","xmin":2166.0,"ymin":1518.0,"xmax":2217.0,"ymax":2100.0},{"id":27,"contenttext":"け","xmin":2128.0,"ymin":560.0,"xmax":2157.0,"ymax":578.0},{"id":28,"contenttext":"怪しからん奴だ、","xmin":2091.0,"ymin":551.0,"xmax":2141.0,"ymax":843.0},{"id":29,"contenttext":"ヨーシ一つ一騎打をしてやらう、","xmin":2096.0,"ymin":883.0,"xmax":2140.0,"ymax":1435.0},{"id":30,"contenttext":"乃ち决圖をしようと考へました。","xmin":2096.0,"ymin":1479.0,"xmax":2147.0,"ymax":2030.0},{"id":31,"contenttext":"で、","xmin":2099.0,"ymin":2091.0,"xmax":2145.0,"ymax":2105.0},{"id":32,"contenttext":"遙々鎌倉までやつて來て、","xmin":2017.0,"ymin":549.0,"xmax":2069.0,"ymax":994.0},{"id":33,"contenttext":"ひそかに正宗の家の樣子をうかゞつた。","xmin":2021.0,"ymin":1034.0,"xmax":2071.0,"ymax":1706.0},{"id":34,"contenttext":"そつと穴から正宗の家","xmin":2021.0,"ymin":1760.0,"xmax":2072.0,"ymax":2121.0},{"id":35,"contenttext":"の中をのぞくと、","xmin":1947.0,"ymin":555.0,"xmax":1989.0,"ymax":841.0},{"id":36,"contenttext":"正宗は衣冠に身を正して刀を鍛へてゐた。","xmin":1943.0,"ymin":873.0,"xmax":1997.0,"ymax":1586.0},{"id":37,"contenttext":"弟子もちやんと裝束をつけて","xmin":1950.0,"ymin":1638.0,"xmax":1996.0,"ymax":2120.0},{"id":38,"contenttext":"ゐる。","xmin":1875.0,"ymin":551.0,"xmax":1913.0,"ymax":636.0},{"id":39,"contenttext":"義弘といふ人はちと亂暴な性の人であるが、","xmin":1874.0,"ymin":670.0,"xmax":1921.0,"ymax":1434.0},{"id":40,"contenttext":"これを見て大いに感動して、","xmin":1875.0,"ymin":1479.0,"xmax":1925.0,"ymax":1952.0},{"id":41,"contenttext":"その翌日","xmin":1877.0,"ymin":2001.0,"xmax":1923.0,"ymax":2123.0},{"id":42,"contenttext":"禮服を身につけて正宗の家にゆき、","xmin":1299.0,"ymin":548.0,"xmax":1352.0,"ymax":1155.0},{"id":43,"contenttext":"罪を謝してその弟子になつた。","xmin":1306.0,"ymin":1194.0,"xmax":1353.0,"ymax":1708.0},{"id":44,"contenttext":"實に刀はよく切れるだ","xmin":1306.0,"ymin":1759.0,"xmax":1358.0,"ymax":2123.0},{"id":45,"contenttext":"けでなく、","xmin":1228.0,"ymin":550.0,"xmax":1270.0,"ymax":719.0},{"id":46,"contenttext":"魂がこもつてゐる。","xmin":1229.0,"ymin":750.0,"xmax":1272.0,"ymax":1072.0},{"id":47,"contenttext":"そういふ風に神聖にして、","xmin":1233.0,"ymin":1114.0,"xmax":1279.0,"ymax":1552.0},{"id":48,"contenttext":"日本刀は出來るのであります。","xmin":1235.0,"ymin":1602.0,"xmax":1280.0,"ymax":2106.0},{"id":49,"contenttext":"こんなわけで、","xmin":1155.0,"ymin":595.0,"xmax":1199.0,"ymax":843.0},{"id":50,"contenttext":"この精神で以つて製紙機械の据付をやることになつた。","xmin":1154.0,"ymin":873.0,"xmax":1207.0,"ymax":1827.0},{"id":51,"contenttext":"そこで英吉利の","xmin":1162.0,"ymin":1886.0,"xmax":1208.0,"ymax":2123.0},{"id":52,"contenttext":"方へは、電報で技師を派遣に及ばぬと謝絕つたのであります。","xmin":1078.0,"ymin":549.0,"xmax":1137.0,"ymax":1606.0},{"id":53,"contenttext":"けれども英吉利の會社では、","xmin":1085.0,"ymin":1661.0,"xmax":1138.0,"ymax":2123.0},{"id":54,"contenttext":"据付が惡い爲に機械の調子が惡くては、","xmin":1005.0,"ymin":548.0,"xmax":1058.0,"ymax":1231.0},{"id":55,"contenttext":"會社の面目にも關するからと云ふので、","xmin":1011.0,"ymin":1279.0,"xmax":1063.0,"ymax":1952.0},{"id":56,"contenttext":"技師を派","xmin":1014.0,"ymin":2005.0,"xmax":1062.0,"ymax":2125.0},{"id":57,"contenttext":"遣して來た。","xmin":931.0,"ymin":548.0,"xmax":980.0,"ymax":756.0},{"id":58,"contenttext":"こちらは据付をどん/〓進行させて、","xmin":935.0,"ymin":795.0,"xmax":986.0,"ymax":1433.0},{"id":59,"contenttext":"もう二三日で試運轉をやるところまで","xmin":939.0,"ymin":1481.0,"xmax":986.0,"ymax":2125.0},{"id":60,"contenttext":"になつた時、","xmin":856.0,"ymin":553.0,"xmax":904.0,"ymax":765.0},{"id":61,"contenttext":"英吉利の技師が到着しました。","xmin":856.0,"ymin":789.0,"xmax":907.0,"ymax":1314.0},{"id":62,"contenttext":"そして、","xmin":863.0,"ymin":1358.0,"xmax":909.0,"ymax":1477.0},{"id":63,"contenttext":"据付狀態を一目見て、","xmin":863.0,"ymin":1521.0,"xmax":911.0,"ymax":1872.0},{"id":64,"contenttext":"「私は本國へ","xmin":863.0,"ymin":1943.0,"xmax":912.0,"ymax":2121.0},{"id":65,"contenttext":"歸ります」と云ふ。","xmin":781.0,"ymin":549.0,"xmax":832.0,"ymax":876.0},{"id":66,"contenttext":"折角來たのだから、","xmin":783.0,"ymin":909.0,"xmax":834.0,"ymax":1231.0},{"id":67,"contenttext":"もう二三日待つて据付が完了するのを見て歸つて","xmin":788.0,"ymin":1279.0,"xmax":838.0,"ymax":2127.0},{"id":68,"contenttext":"欲しい、","xmin":709.0,"ymin":546.0,"xmax":758.0,"ymax":677.0},{"id":69,"contenttext":"そして据付の結果を本國の方へ報告して欲しいと、","xmin":708.0,"ymin":711.0,"xmax":767.0,"ymax":1594.0},{"id":70,"contenttext":"種々引留めても「イヤ私はも","xmin":719.0,"ymin":1641.0,"xmax":765.0,"ymax":2127.0},{"id":71,"contenttext":"う歸ります」","xmin":638.0,"ymin":551.0,"xmax":682.0,"ymax":764.0},{"id":72,"contenttext":"と云つて歸つてしまつた。","xmin":637.0,"ymin":791.0,"xmax":687.0,"ymax":1233.0},{"id":73,"contenttext":"所で英吉利の技師が本國へ歸つて、","xmin":639.0,"ymin":1277.0,"xmax":691.0,"ymax":1873.0},{"id":74,"contenttext":"社長に歸國の","xmin":641.0,"ymin":1928.0,"xmax":690.0,"ymax":2125.0},{"id":75,"contenttext":"旨を報告しますると、","xmin":566.0,"ymin":550.0,"xmax":610.0,"ymax":919.0},{"id":76,"contenttext":"社長は何故据付を見ないで歸つたかとの質問に對し、","xmin":566.0,"ymin":952.0,"xmax":618.0,"ymax":1871.0},{"id":77,"contenttext":"技師は","xmin":570.0,"ymin":1926.0,"xmax":617.0,"ymax":2008.0},{"id":78,"contenttext":"「全く","xmin":571.0,"ymin":2069.0,"xmax":617.0,"ymax":2128.0},{"id":79,"contenttext":"必要がありませんでした。","xmin":490.0,"ymin":551.0,"xmax":539.0,"ymax":997.0},{"id":80,"contenttext":"私が自分で据付けましても、","xmin":493.0,"ymin":1034.0,"xmax":539.0,"ymax":1516.0},{"id":81,"contenttext":"日本人技師以上の据付はとても出","xmin":493.0,"ymin":1566.0,"xmax":544.0,"ymax":2130.0}]