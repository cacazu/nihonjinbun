[{"id":0,"contenttext":"六","xmin":2768.0,"ymin":1754.0,"xmax":2812.0,"ymax":1798.0},{"id":1,"contenttext":"良くしよう。","xmin":2720.0,"ymin":567.0,"xmax":2761.0,"ymax":787.0},{"id":2,"contenttext":"今年の自分は不十分である、","xmin":2705.0,"ymin":799.0,"xmax":2761.0,"ymax":1303.0},{"id":3,"contenttext":"明年の自分は更に進んで十分なものにしようと","xmin":2691.0,"ymin":1314.0,"xmax":2751.0,"ymax":2147.0},{"id":4,"contenttext":"するのであります。","xmin":2646.0,"ymin":565.0,"xmax":2688.0,"ymax":901.0},{"id":5,"contenttext":"併しその自分卽ち自我或は人格といふものは色々に解釋せられます。","xmin":2616.0,"ymin":914.0,"xmax":2687.0,"ymax":2132.0},{"id":6,"contenttext":"西洋人は理論はともかく、","xmin":2561.0,"ymin":561.0,"xmax":2618.0,"ymax":1021.0},{"id":7,"contenttext":"實際は個人主義で、","xmin":2555.0,"ymin":1028.0,"xmax":2609.0,"ymax":1372.0},{"id":8,"contenttext":"その自分は利己的になり勝であります。","xmin":2539.0,"ymin":1389.0,"xmax":2604.0,"ymax":2085.0},{"id":9,"contenttext":"理想は、","xmin":2490.0,"ymin":599.0,"xmax":2542.0,"ymax":740.0},{"id":10,"contenttext":"已に人の性質、","xmin":2484.0,"ymin":758.0,"xmax":2539.0,"ymax":1022.0},{"id":11,"contenttext":"經驗、","xmin":2486.0,"ymin":1030.0,"xmax":2534.0,"ymax":1143.0},{"id":12,"contenttext":"理性、","xmin":2483.0,"ymin":1147.0,"xmax":2532.0,"ymax":1253.0},{"id":13,"contenttext":"想像等によつて夫々違ふのでありますから、","xmin":2467.0,"ymin":1269.0,"xmax":2531.0,"ymax":2051.0},{"id":14,"contenttext":"人類","xmin":2466.0,"ymin":2059.0,"xmax":2512.0,"ymax":2145.0},{"id":15,"contenttext":"といふ立塲から離れて、","xmin":2416.0,"ymin":562.0,"xmax":2470.0,"ymax":974.0},{"id":16,"contenttext":"國民と云ふ立塲に於いて觀察しますると、又一國民としての性質、","xmin":2392.0,"ymin":992.0,"xmax":2464.0,"ymax":2141.0},{"id":17,"contenttext":"經驗、","xmin":2345.0,"ymin":554.0,"xmax":2395.0,"ymax":665.0},{"id":18,"contenttext":"理性、","xmin":2344.0,"ymin":669.0,"xmax":2395.0,"ymax":778.0},{"id":19,"contenttext":"想像等特殊のものを有するので、","xmin":2333.0,"ymin":790.0,"xmax":2390.0,"ymax":1378.0},{"id":20,"contenttext":"自ら一國民共通の理想と云ふものが出來る","xmin":2316.0,"ymin":1384.0,"xmax":2380.0,"ymax":2141.0},{"id":21,"contenttext":"のであります。","xmin":2272.0,"ymin":557.0,"xmax":2316.0,"ymax":813.0},{"id":22,"contenttext":"そこで日本國民には、","xmin":2261.0,"ymin":829.0,"xmax":2315.0,"ymax":1210.0},{"id":23,"contenttext":"日本國民としての理想があり、","xmin":2252.0,"ymin":1228.0,"xmax":2308.0,"ymax":1764.0},{"id":24,"contenttext":"亞米利加國民には亞","xmin":2244.0,"ymin":1779.0,"xmax":2297.0,"ymax":2139.0},{"id":25,"contenttext":"米利加國民としての理想があり、","xmin":2192.0,"ymin":551.0,"xmax":2248.0,"ymax":1132.0},{"id":26,"contenttext":"英吉利國民としては、","xmin":2181.0,"ymin":1136.0,"xmax":2239.0,"ymax":1528.0},{"id":27,"contenttext":"英吉利國民の理想がありまして、","xmin":2172.0,"ymin":1533.0,"xmax":2230.0,"ymax":2115.0},{"id":28,"contenttext":"夫々違ふのであります。","xmin":2121.0,"ymin":551.0,"xmax":2175.0,"ymax":967.0},{"id":29,"contenttext":"されば日本國民は昔から日本國民としての理想を實現せんとして","xmin":2093.0,"ymin":985.0,"xmax":2166.0,"ymax":2136.0},{"id":30,"contenttext":"ゐる。","xmin":2055.0,"ymin":550.0,"xmax":2094.0,"ymax":648.0},{"id":31,"contenttext":"日本國民のすべての行爲はH本國民としての理想を實現して來て居り、","xmin":2024.0,"ymin":666.0,"xmax":2099.0,"ymax":1914.0},{"id":32,"contenttext":"實現しつゝ","xmin":2025.0,"ymin":1931.0,"xmax":2072.0,"ymax":2128.0},{"id":33,"contenttext":"あり、","xmin":1982.0,"ymin":548.0,"xmax":2020.0,"ymax":652.0},{"id":34,"contenttext":"實現せんとしてゐるのである。","xmin":1968.0,"ymin":660.0,"xmax":2024.0,"ymax":1201.0},{"id":35,"contenttext":"知つてゐると知らないとに拘らず常にしかしてゐる","xmin":1948.0,"ymin":1213.0,"xmax":2013.0,"ymax":2129.0},{"id":36,"contenttext":"のである。","xmin":1908.0,"ymin":547.0,"xmax":1949.0,"ymax":722.0},{"id":37,"contenttext":"これは全く恰も飯を食べるのと同じである。","xmin":1888.0,"ymin":741.0,"xmax":1948.0,"ymax":1511.0},{"id":38,"contenttext":"飯を食べるのは生きなければなら","xmin":1875.0,"ymin":1525.0,"xmax":1934.0,"ymax":2129.0},{"id":39,"contenttext":"ない、","xmin":1336.0,"ymin":528.0,"xmax":1379.0,"ymax":633.0},{"id":40,"contenttext":"生きて理想を實現せんが爲である。","xmin":1321.0,"ymin":641.0,"xmax":1380.0,"ymax":1261.0},{"id":41,"contenttext":"その理想は如何などと云ふことは、","xmin":1304.0,"ymin":1275.0,"xmax":1365.0,"ymax":1903.0},{"id":42,"contenttext":"不問に附し","xmin":1300.0,"ymin":1911.0,"xmax":1349.0,"ymax":2115.0},{"id":43,"contenttext":"て、","xmin":1267.0,"ymin":531.0,"xmax":1304.0,"ymax":588.0},{"id":44,"contenttext":"とに角食べるのであります。","xmin":1251.0,"ymin":604.0,"xmax":1307.0,"ymax":1103.0},{"id":45,"contenttext":"それと同樣に多くの日本人に","xmin":1235.0,"ymin":1116.0,"xmax":1296.0,"ymax":1648.0},{"id":46,"contenttext":"「日本國民の理想は」と","xmin":1221.0,"ymin":1648.0,"xmax":1282.0,"ymax":2110.0},{"id":47,"contenttext":"聞くと、","xmin":1190.0,"ymin":523.0,"xmax":1231.0,"ymax":668.0},{"id":48,"contenttext":"なかなか答が出來ないものであります。","xmin":1167.0,"ymin":678.0,"xmax":1233.0,"ymax":1380.0},{"id":49,"contenttext":"それは自覺してゐないものもあるし、","xmin":1151.0,"ymin":1392.0,"xmax":1214.0,"ymax":2063.0},{"id":50,"contenttext":"〓","xmin":1160.0,"ymin":2073.0,"xmax":1190.0,"ymax":2098.0},{"id":51,"contenttext":"言で云ひ表すことが出來ない爲でもある。","xmin":1101.0,"ymin":519.0,"xmax":1162.0,"ymax":1256.0},{"id":52,"contenttext":"勿論、","xmin":1096.0,"ymin":1269.0,"xmax":1145.0,"ymax":1380.0},{"id":53,"contenttext":"考へれば色々と云へるのであるが、","xmin":1081.0,"ymin":1387.0,"xmax":1144.0,"ymax":2019.0},{"id":54,"contenttext":"卒然","xmin":1077.0,"ymin":2020.0,"xmax":1123.0,"ymax":2110.0},{"id":55,"contenttext":"云ひ表すことは困難である。","xmin":1032.0,"ymin":521.0,"xmax":1089.0,"ymax":1015.0},{"id":56,"contenttext":"所が國民の中には昔から色々すぐれた人がある。","xmin":1007.0,"ymin":1027.0,"xmax":1080.0,"ymax":1887.0},{"id":57,"contenttext":"たとへば、","xmin":1004.0,"ymin":1904.0,"xmax":1056.0,"ymax":2085.0},{"id":58,"contenttext":"ズツト以前に、","xmin":960.0,"ymin":519.0,"xmax":1015.0,"ymax":784.0},{"id":59,"contenttext":"私の務めた學校で、","xmin":955.0,"ymin":785.0,"xmax":1008.0,"ymax":1135.0},{"id":60,"contenttext":"運動會の時、","xmin":946.0,"ymin":1143.0,"xmax":1002.0,"ymax":1375.0},{"id":61,"contenttext":"職員レースといふのをやる。","xmin":937.0,"ymin":1384.0,"xmax":995.0,"ymax":1888.0},{"id":62,"contenttext":"そんな時、","xmin":931.0,"ymin":1900.0,"xmax":977.0,"ymax":2081.0},{"id":63,"contenttext":"私は足の長い人にはとてもかなはない。","xmin":879.0,"ymin":514.0,"xmax":942.0,"ymax":1208.0},{"id":64,"contenttext":"云ふまでもなく、","xmin":874.0,"ymin":1226.0,"xmax":923.0,"ymax":1532.0},{"id":65,"contenttext":"足の長い人は走るのが極めて早","xmin":854.0,"ymin":1540.0,"xmax":918.0,"ymax":2105.0},{"id":66,"contenttext":"いです。","xmin":817.0,"ymin":515.0,"xmax":863.0,"ymax":655.0},{"id":67,"contenttext":"將棊でも碁でも、","xmin":804.0,"ymin":666.0,"xmax":864.0,"ymax":973.0},{"id":68,"contenttext":"劍道でも柔道でも、","xmin":799.0,"ymin":982.0,"xmax":856.0,"ymax":1332.0},{"id":69,"contenttext":"强い人には弱いものはどうしても叶はぬ。","xmin":780.0,"ymin":1341.0,"xmax":846.0,"ymax":2078.0},{"id":70,"contenttext":"そこで弱い人は、","xmin":740.0,"ymin":509.0,"xmax":790.0,"ymax":814.0},{"id":71,"contenttext":"强い人を尊び、","xmin":731.0,"ymin":821.0,"xmax":784.0,"ymax":1088.0},{"id":72,"contenttext":"それを先生として尊敬する。","xmin":720.0,"ymin":1101.0,"xmax":777.0,"ymax":1602.0},{"id":73,"contenttext":"これは何の道、","xmin":714.0,"ymin":1618.0,"xmax":766.0,"ymax":1885.0},{"id":74,"contenttext":"何の藝でも","xmin":709.0,"ymin":1892.0,"xmax":759.0,"ymax":2098.0},{"id":75,"contenttext":"同一である。","xmin":670.0,"ymin":507.0,"xmax":720.0,"ymax":727.0},{"id":76,"contenttext":"その道、","xmin":666.0,"ymin":745.0,"xmax":712.0,"ymax":895.0},{"id":77,"contenttext":"その藝の人であつて、","xmin":656.0,"ymin":899.0,"xmax":711.0,"ymax":1290.0},{"id":78,"contenttext":"それに關係ない人は格別尊敬しない。","xmin":637.0,"ymin":1295.0,"xmax":702.0,"ymax":1956.0},{"id":79,"contenttext":"然るに","xmin":635.0,"ymin":1969.0,"xmax":684.0,"ymax":2097.0},{"id":80,"contenttext":"日本國民の理想となると、","xmin":590.0,"ymin":507.0,"xmax":647.0,"ymax":970.0},{"id":81,"contenttext":"それを自覺すると否とに關せず、","xmin":568.0,"ymin":978.0,"xmax":636.0,"ymax":1563.0},{"id":82,"contenttext":"當然にそれを實現せんとする","xmin":562.0,"ymin":1569.0,"xmax":621.0,"ymax":2092.0},{"id":83,"contenttext":"精神が、","xmin":529.0,"ymin":504.0,"xmax":573.0,"ymax":648.0},{"id":84,"contenttext":"あらゆる國民に生じ來るので、","xmin":512.0,"ymin":660.0,"xmax":570.0,"ymax":1200.0},{"id":85,"contenttext":"日本國民の理想を實現し、","xmin":497.0,"ymin":1217.0,"xmax":557.0,"ymax":1680.0},{"id":86,"contenttext":"その方面に偉大なお方","xmin":486.0,"ymin":1689.0,"xmax":547.0,"ymax":2095.0}]