[{"id":0,"contenttext":"一六","xmin":2764.0,"ymin":1742.0,"xmax":2810.0,"ymax":1820.0},{"id":1,"contenttext":"でありませう。","xmin":2707.0,"ymin":593.0,"xmax":2747.0,"ymax":846.0},{"id":2,"contenttext":"かゝる世界列國の興亡常ならない中に、","xmin":2619.0,"ymin":629.0,"xmax":2681.0,"ymax":1323.0},{"id":3,"contenttext":"世界無比の皇道に基き、","xmin":2616.0,"ymin":1338.0,"xmax":2671.0,"ymax":1762.0},{"id":4,"contenttext":"萬世一系の皇統をいた","xmin":2613.0,"ymin":1767.0,"xmax":2665.0,"ymax":2173.0},{"id":5,"contenttext":"us","xmin":2591.0,"ymin":1183.0,"xmax":2613.0,"ymax":1226.0},{"id":6,"contenttext":"だき、","xmin":2562.0,"ymin":589.0,"xmax":2605.0,"ymax":690.0},{"id":7,"contenttext":"金甌無缺の國家をもつて、","xmin":2554.0,"ymin":706.0,"xmax":2604.0,"ymax":1170.0},{"id":8,"contenttext":"獨り興隆と發展の歷史を有する、","xmin":2546.0,"ymin":1181.0,"xmax":2598.0,"ymax":1756.0},{"id":9,"contenttext":"我が大日本帝國のみ、","xmin":2539.0,"ymin":1771.0,"xmax":2592.0,"ymax":2151.0},{"id":10,"contenttext":"世界永遠の平和を建設し、","xmin":2478.0,"ymin":584.0,"xmax":2535.0,"ymax":1047.0},{"id":11,"contenttext":"八紘一宇の大理想實現の使命を有するのであります。","xmin":2468.0,"ymin":1059.0,"xmax":2528.0,"ymax":1995.0},{"id":12,"contenttext":"卽ち世界","xmin":2467.0,"ymin":2005.0,"xmax":2515.0,"ymax":2174.0},{"id":13,"contenttext":"永遠の平和は我が皇道の使命であるのであります。","xmin":2400.0,"ymin":587.0,"xmax":2461.0,"ymax":1479.0},{"id":14,"contenttext":"皇道は右の如く、","xmin":2337.0,"ymin":622.0,"xmax":2389.0,"ymax":921.0},{"id":15,"contenttext":"天壤無窮の皇運を扶翼して、","xmin":2333.0,"ymin":940.0,"xmax":2385.0,"ymax":1437.0},{"id":16,"contenttext":"その使命を達成せんとするものでありま","xmin":2326.0,"ymin":1454.0,"xmax":2380.0,"ymax":2171.0},{"id":17,"contenttext":"して、","xmin":2274.0,"ymin":586.0,"xmax":2313.0,"ymax":692.0},{"id":18,"contenttext":"その爲に、","xmin":2267.0,"ymin":701.0,"xmax":2310.0,"ymax":889.0},{"id":19,"contenttext":"人生に於いて躬行實踐すべき種々の道を有するのであります。","xmin":2251.0,"ymin":899.0,"xmax":2314.0,"ymax":1993.0},{"id":20,"contenttext":"その第一","xmin":2254.0,"ymin":2007.0,"xmax":2298.0,"ymax":2159.0},{"id":21,"contenttext":"に擧ぐべきは、","xmin":2193.0,"ymin":587.0,"xmax":2243.0,"ymax":848.0},{"id":22,"contenttext":"敬神崇祖であります。","xmin":2189.0,"ymin":857.0,"xmax":2241.0,"ymax":1238.0},{"id":23,"contenttext":"敬神崇祖は外國にはない所のものであります。","xmin":2179.0,"ymin":1252.0,"xmax":2235.0,"ymax":2073.0},{"id":24,"contenttext":"その","xmin":2181.0,"ymin":2083.0,"xmax":2222.0,"ymax":2164.0},{"id":25,"contenttext":"敬神崇祖の根本義はと云へば、","xmin":2110.0,"ymin":580.0,"xmax":2169.0,"ymax":1118.0},{"id":26,"contenttext":"卽ち報本反始であります。","xmin":2111.0,"ymin":1133.0,"xmax":2160.0,"ymax":1596.0},{"id":27,"contenttext":"本にむくいることであり、","xmin":2106.0,"ymin":1606.0,"xmax":2152.0,"ymax":2067.0},{"id":28,"contenttext":"恩義","xmin":2105.0,"ymin":2083.0,"xmax":2148.0,"ymax":2169.0},{"id":29,"contenttext":"に感謝することであります。","xmin":2040.0,"ymin":585.0,"xmax":2092.0,"ymax":1077.0},{"id":30,"contenttext":"恩を感ずるといふことは非常に大切で","xmin":2034.0,"ymin":1092.0,"xmax":2087.0,"ymax":1771.0},{"id":31,"contenttext":"「恩を知らざるは禽獸","xmin":2029.0,"ymin":1779.0,"xmax":2079.0,"ymax":2169.0},{"id":32,"contenttext":"に等し」と云ふ位であります。","xmin":1972.0,"ymin":584.0,"xmax":2018.0,"ymax":1099.0},{"id":33,"contenttext":"所が西洋ではあまり恩を感ずることを彼れ此れ申しません。","xmin":1956.0,"ymin":1111.0,"xmax":2015.0,"ymax":2166.0},{"id":34,"contenttext":"大正三年物發の歐洲大戰の時の事ですが、","xmin":1891.0,"ymin":579.0,"xmax":1949.0,"ymax":1320.0},{"id":35,"contenttext":"郵船會社の船が盛に歐洲へ航海しました。","xmin":1882.0,"ymin":1328.0,"xmax":1941.0,"ymax":2069.0},{"id":36,"contenttext":"その","xmin":1886.0,"ymin":2081.0,"xmax":1930.0,"ymax":2164.0},{"id":37,"contenttext":"當時の船長は多く西洋人であります。","xmin":1347.0,"ymin":555.0,"xmax":1399.0,"ymax":1213.0},{"id":38,"contenttext":"つまり日本人船長には、","xmin":1346.0,"ymin":1230.0,"xmax":1397.0,"ymax":1645.0},{"id":39,"contenttext":"歐米人から、","xmin":1346.0,"ymin":1659.0,"xmax":1396.0,"ymax":1883.0},{"id":40,"contenttext":"歐米の航路を","xmin":1346.0,"ymin":1898.0,"xmax":1396.0,"ymax":2145.0},{"id":41,"contenttext":"乘切るといふ信用があまりなかつたのであります。","xmin":1272.0,"ymin":555.0,"xmax":1324.0,"ymax":1447.0},{"id":42,"contenttext":"しかるに偶々此の戰役の際、","xmin":1272.0,"ymin":1463.0,"xmax":1321.0,"ymax":1971.0},{"id":43,"contenttext":"日本人船","xmin":1274.0,"ymin":1980.0,"xmax":1321.0,"ymax":2145.0},{"id":44,"contenttext":"長の船がたくみに航海するのを見て、","xmin":1202.0,"ymin":555.0,"xmax":1248.0,"ymax":1218.0},{"id":45,"contenttext":"西洋人は全く驚いてしまつた。","xmin":1201.0,"ymin":1223.0,"xmax":1248.0,"ymax":1765.0},{"id":46,"contenttext":"それで日本人の航海","xmin":1197.0,"ymin":1778.0,"xmax":1246.0,"ymax":2144.0},{"id":47,"contenttext":"術は决して西洋人に讓るものではないと云ふ信用が出來だので、","xmin":1124.0,"ymin":553.0,"xmax":1177.0,"ymax":1693.0},{"id":48,"contenttext":"今日郵船會社の船長は、","xmin":1124.0,"ymin":1697.0,"xmax":1174.0,"ymax":2121.0},{"id":49,"contenttext":"全部日本人といふことである。","xmin":1053.0,"ymin":555.0,"xmax":1099.0,"ymax":1094.0},{"id":50,"contenttext":"そこでその當時の大戰の時、","xmin":1050.0,"ymin":1106.0,"xmax":1099.0,"ymax":1606.0},{"id":51,"contenttext":"英國人が船長をしてゐた船が","xmin":1048.0,"ymin":1620.0,"xmax":1099.0,"ymax":2142.0},{"id":52,"contenttext":"地中海とかで擊沈せられて、","xmin":980.0,"ymin":555.0,"xmax":1026.0,"ymax":1051.0},{"id":53,"contenttext":"船長が死んでしまつた。","xmin":980.0,"ymin":1067.0,"xmax":1026.0,"ymax":1489.0},{"id":54,"contenttext":"その船に乘組んでゐて、","xmin":977.0,"ymin":1503.0,"xmax":1024.0,"ymax":1932.0},{"id":55,"contenttext":"幸に助かつ","xmin":977.0,"ymin":1936.0,"xmax":1023.0,"ymax":2138.0},{"id":56,"contenttext":"た日本人が、","xmin":902.0,"ymin":555.0,"xmax":951.0,"ymax":782.0},{"id":57,"contenttext":"後日記念品をこしらへて、","xmin":905.0,"ymin":788.0,"xmax":950.0,"ymax":1249.0},{"id":58,"contenttext":"英國にある日本大使館を經て、","xmin":902.0,"ymin":1262.0,"xmax":954.0,"ymax":1805.0},{"id":59,"contenttext":"もとの船長の夫人","xmin":900.0,"ymin":1822.0,"xmax":950.0,"ymax":2144.0},{"id":60,"contenttext":"へ贈つた。","xmin":829.0,"ymin":562.0,"xmax":876.0,"ymax":738.0},{"id":61,"contenttext":"所がその船長の夫人が、","xmin":831.0,"ymin":747.0,"xmax":878.0,"ymax":1177.0},{"id":62,"contenttext":"それを受取らない。","xmin":831.0,"ymin":1183.0,"xmax":877.0,"ymax":1523.0},{"id":63,"contenttext":"夫は郵船會社の使用人である、","xmin":828.0,"ymin":1542.0,"xmax":877.0,"ymax":2093.0},{"id":64,"contenttext":"日","xmin":837.0,"ymin":2100.0,"xmax":864.0,"ymax":2137.0},{"id":65,"contenttext":"本人乘組員も同じ會社の使用人である。","xmin":756.0,"ymin":552.0,"xmax":806.0,"ymax":1248.0},{"id":66,"contenttext":"どちらも會社から給料を貰つてゐる。","xmin":758.0,"ymin":1267.0,"xmax":804.0,"ymax":1923.0},{"id":67,"contenttext":"給料を貰つ","xmin":755.0,"ymin":1937.0,"xmax":803.0,"ymax":2137.0},{"id":68,"contenttext":"てゐる使用人から、","xmin":685.0,"ymin":557.0,"xmax":733.0,"ymax":896.0},{"id":69,"contenttext":"給料を貰つてゐる使用人が、物を戴く理由がないといつて受取らない。","xmin":682.0,"ymin":905.0,"xmax":733.0,"ymax":2142.0},{"id":70,"contenttext":"大使館員も大いにてこずつたが、","xmin":612.0,"ymin":552.0,"xmax":660.0,"ymax":1133.0},{"id":71,"contenttext":"懇々と日本皇道の恩義のことを說明し、","xmin":609.0,"ymin":1144.0,"xmax":656.0,"ymax":1850.0},{"id":72,"contenttext":"船長の恩義に報","xmin":607.0,"ymin":1859.0,"xmax":655.0,"ymax":2144.0},{"id":73,"contenttext":"いる爲に記念品を贈るのだと、","xmin":538.0,"ymin":557.0,"xmax":582.0,"ymax":1089.0},{"id":74,"contenttext":"十分に說明したら、","xmin":534.0,"ymin":1103.0,"xmax":583.0,"ymax":1447.0},{"id":75,"contenttext":"夫人は非常に感激して、","xmin":532.0,"ymin":1463.0,"xmax":582.0,"ymax":1893.0},{"id":76,"contenttext":"それは誠に有","xmin":532.0,"ymin":1895.0,"xmax":582.0,"ymax":2144.0}]