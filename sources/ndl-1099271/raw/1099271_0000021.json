[{"id":0,"contenttext":"三四","xmin":2773.0,"ymin":1727.0,"xmax":2817.0,"ymax":1809.0},{"id":1,"contenttext":"て此の賊を亡さん」といつてゐる。","xmin":2691.0,"ymin":586.0,"xmax":2741.0,"ymax":1197.0},{"id":2,"contenttext":"これを西洋人の義務を盡したと云ふのに比較すれば、","xmin":2696.0,"ymin":1213.0,"xmax":2748.0,"ymax":2145.0},{"id":3,"contenttext":"훈","xmin":2659.0,"ymin":1210.0,"xmax":2688.0,"ymax":1256.0},{"id":4,"contenttext":"若し西洋人なら、","xmin":2617.0,"ymin":814.0,"xmax":2674.0,"ymax":1121.0},{"id":5,"contenttext":"れ","xmin":2666.0,"ymin":1922.0,"xmax":2688.0,"ymax":1967.0},{"id":6,"contenttext":"その差如何。","xmin":2618.0,"ymin":579.0,"xmax":2665.0,"ymax":804.0},{"id":7,"contenttext":"早く已に","xmin":2622.0,"ymin":1130.0,"xmax":2668.0,"ymax":1296.0},{"id":8,"contenttext":"「我は我が義務をつくした」といふ謬で、","xmin":2621.0,"ymin":1306.0,"xmax":2677.0,"ymax":2027.0},{"id":9,"contenttext":"足利尊","xmin":2627.0,"ymin":2041.0,"xmax":2674.0,"ymax":2166.0},{"id":10,"contenttext":"氏の軍門に降を請ふと云ふ次第であらう。","xmin":2543.0,"ymin":582.0,"xmax":2600.0,"ymax":1314.0},{"id":11,"contenttext":"尊氏は正成が降參して來たと聞くと、","xmin":2549.0,"ymin":1329.0,"xmax":2596.0,"ymax":1986.0},{"id":12,"contenttext":"降者を優","xmin":2550.0,"ymin":2000.0,"xmax":2602.0,"ymax":2168.0},{"id":13,"contenttext":"遇する彼れの政策から見て、","xmin":2469.0,"ymin":577.0,"xmax":2521.0,"ymax":1082.0},{"id":14,"contenttext":"彼れは正成を攝〓河、暴三州の大守としたに相違ない。","xmin":2471.0,"ymin":1088.0,"xmax":2526.0,"ymax":2025.0},{"id":15,"contenttext":"併し、","xmin":2483.0,"ymin":2034.0,"xmax":2527.0,"ymax":2144.0},{"id":16,"contenttext":"正成は斷平として七生報國を盟つて戰死したのである。","xmin":2398.0,"ymin":582.0,"xmax":2449.0,"ymax":1550.0},{"id":17,"contenttext":"これが皇道の精神なのであり、","xmin":2403.0,"ymin":1569.0,"xmax":2449.0,"ymax":2111.0},{"id":18,"contenttext":"惟","xmin":2405.0,"ymin":2115.0,"xmax":2454.0,"ymax":2167.0},{"id":19,"contenttext":"神の道であり、","xmin":2323.0,"ymin":581.0,"xmax":2369.0,"ymax":844.0},{"id":20,"contenttext":"我々が今日尙楠公の忠誠を尊ぶ所以なのであります。","xmin":2325.0,"ymin":855.0,"xmax":2372.0,"ymax":1788.0},{"id":21,"contenttext":"東〓大將は日本海々","xmin":2327.0,"ymin":1802.0,"xmax":2376.0,"ymax":2160.0},{"id":22,"contenttext":"戰の時「皇國の興廢此の一戰にあり各員一層奮勵努力せよ」の信號を發せられました。","xmin":2250.0,"ymin":581.0,"xmax":2304.0,"ymax":2108.0},{"id":23,"contenttext":"皇","xmin":2259.0,"ymin":2119.0,"xmax":2303.0,"ymax":2166.0},{"id":24,"contenttext":"國の興廢此の一戰にありと云ふ言葉は、","xmin":2175.0,"ymin":580.0,"xmax":2227.0,"ymax":1275.0},{"id":25,"contenttext":"我々日本人には、","xmin":2179.0,"ymin":1290.0,"xmax":2228.0,"ymax":1591.0},{"id":26,"contenttext":"今日尙血湧き肉躍るの感が致す","xmin":2182.0,"ymin":1605.0,"xmax":2231.0,"ymax":2167.0},{"id":27,"contenttext":"のであります。","xmin":2104.0,"ymin":580.0,"xmax":2147.0,"ymax":838.0},{"id":28,"contenttext":"我々は以上の如き皇道の精神で以て、","xmin":2102.0,"ymin":852.0,"xmax":2155.0,"ymax":1509.0},{"id":29,"contenttext":"東亞新秩序を建設し、","xmin":2106.0,"ymin":1524.0,"xmax":2155.0,"ymax":1915.0},{"id":30,"contenttext":"八紘一字の大","xmin":2110.0,"ymin":1920.0,"xmax":2159.0,"ymax":2166.0},{"id":31,"contenttext":"理想を實現せねばなりません。","xmin":2025.0,"ymin":579.0,"xmax":2082.0,"ymax":1118.0},{"id":32,"contenttext":"これ實に日本人の進むべき方針であつて、","xmin":2030.0,"ymin":1132.0,"xmax":2084.0,"ymax":1872.0},{"id":33,"contenttext":"卽ち皇道の使命","xmin":2036.0,"ymin":1876.0,"xmax":2083.0,"ymax":2164.0},{"id":34,"contenttext":"なのであります。","xmin":1955.0,"ymin":581.0,"xmax":1999.0,"ymax":880.0},{"id":35,"contenttext":"先刻宮司樣からお話がありました樣に、","xmin":1882.0,"ymin":618.0,"xmax":1932.0,"ymax":1310.0},{"id":36,"contenttext":"獨逸はソ聯と不可侵條約を締結しました。","xmin":1885.0,"ymin":1328.0,"xmax":1935.0,"ymax":2069.0},{"id":37,"contenttext":"長い","xmin":1886.0,"ymin":2078.0,"xmax":1932.0,"ymax":2160.0},{"id":38,"contenttext":"獨逸はソ聯と不可侵條約を締結しました。","xmin":1885.0,"ymin":1328.0,"xmax":1935.0,"ymax":2069.0},{"id":39,"contenttext":"長い","xmin":1886.0,"ymin":2078.0,"xmax":1932.0,"ymax":2160.0},{"id":40,"contenttext":"間我が國と防共協定をなし、","xmin":1319.0,"ymin":552.0,"xmax":1365.0,"ymax":1051.0},{"id":41,"contenttext":"殆んど同盟國の樣にしたゐた獨逸は、","xmin":1319.0,"ymin":1064.0,"xmax":1372.0,"ymax":1730.0},{"id":42,"contenttext":"その敵國の如きソ聯と","xmin":1327.0,"ymin":1732.0,"xmax":1376.0,"ymax":2137.0},{"id":43,"contenttext":"同盟のやうな風になつて來たのであります。","xmin":1243.0,"ymin":552.0,"xmax":1294.0,"ymax":1326.0},{"id":44,"contenttext":"國際間には殆んど信義も、","xmin":1246.0,"ymin":1340.0,"xmax":1299.0,"ymax":1798.0},{"id":45,"contenttext":"道德もない樣な有","xmin":1249.0,"ymin":1813.0,"xmax":1306.0,"ymax":2139.0},{"id":46,"contenttext":"様であります。","xmin":1172.0,"ymin":554.0,"xmax":1218.0,"ymax":810.0},{"id":47,"contenttext":"國際間の關係は實に明日のことは計られないのであります。","xmin":1170.0,"ymin":830.0,"xmax":1223.0,"ymax":1883.0},{"id":48,"contenttext":"全く一時の利","xmin":1178.0,"ymin":1898.0,"xmax":1228.0,"ymax":2142.0},{"id":49,"contenttext":"害關係にのみよつて動くといふやり方であります。","xmin":1098.0,"ymin":553.0,"xmax":1146.0,"ymax":1445.0},{"id":50,"contenttext":"西洋人のやり方は實にこの通りなので","xmin":1102.0,"ymin":1462.0,"xmax":1155.0,"ymax":2139.0},{"id":51,"contenttext":"あります。","xmin":1028.0,"ymin":555.0,"xmax":1067.0,"ymax":734.0},{"id":52,"contenttext":"こんな國際間に立つ我が國は、","xmin":1022.0,"ymin":752.0,"xmax":1075.0,"ymax":1289.0},{"id":53,"contenttext":"誠に戰國時代に遭遇してゐる樣なもので、","xmin":1028.0,"ymin":1304.0,"xmax":1082.0,"ymax":2051.0},{"id":54,"contenttext":"今後","xmin":1034.0,"ymin":2053.0,"xmax":1082.0,"ymax":2144.0},{"id":55,"contenttext":"我が國は如何なる難局に立つかわかりません。","xmin":951.0,"ymin":557.0,"xmax":999.0,"ymax":1369.0},{"id":56,"contenttext":"今日でこそ獨逸とソ聯が結び、","xmin":956.0,"ymin":1384.0,"xmax":1005.0,"ymax":1922.0},{"id":57,"contenttext":"英佛に當り","xmin":959.0,"ymin":1939.0,"xmax":1006.0,"ymax":2144.0},{"id":58,"contenttext":"ましても、","xmin":880.0,"ymin":559.0,"xmax":919.0,"ymax":736.0},{"id":59,"contenttext":"この調子では、","xmin":875.0,"ymin":755.0,"xmax":924.0,"ymax":1024.0},{"id":60,"contenttext":"いつ如何にして、","xmin":876.0,"ymin":1031.0,"xmax":929.0,"ymax":1332.0},{"id":61,"contenttext":"獨逸とソ聯が英佛と結び、","xmin":880.0,"ymin":1347.0,"xmax":929.0,"ymax":1806.0},{"id":62,"contenttext":"東洋に臨むかわか","xmin":881.0,"ymin":1820.0,"xmax":934.0,"ymax":2144.0},{"id":63,"contenttext":"りません。","xmin":802.0,"ymin":559.0,"xmax":845.0,"ymax":738.0},{"id":64,"contenttext":"或はこれ等の一國が、","xmin":800.0,"ymin":752.0,"xmax":852.0,"ymax":1133.0},{"id":65,"contenttext":"歐洲に覇を唱へ、","xmin":802.0,"ymin":1145.0,"xmax":851.0,"ymax":1448.0},{"id":66,"contenttext":"東洋に勢力を及ぼすかわかりません。","xmin":807.0,"ymin":1466.0,"xmax":856.0,"ymax":2125.0},{"id":67,"contenttext":"何れにしても、","xmin":731.0,"ymin":559.0,"xmax":777.0,"ymax":824.0},{"id":68,"contenttext":"私は、","xmin":729.0,"ymin":832.0,"xmax":775.0,"ymax":943.0},{"id":69,"contenttext":"世界の將來は、","xmin":731.0,"ymin":950.0,"xmax":778.0,"ymax":1219.0},{"id":70,"contenttext":"白人の世界と我が皇國との决戰に立至るかと思はれ","xmin":731.0,"ymin":1226.0,"xmax":788.0,"ymax":2147.0},{"id":71,"contenttext":"てなりません。","xmin":660.0,"ymin":564.0,"xmax":700.0,"ymax":819.0},{"id":72,"contenttext":"さう云ふ風にならねば、","xmin":660.0,"ymin":840.0,"xmax":705.0,"ymax":1263.0},{"id":73,"contenttext":"至幸でありますが、","xmin":660.0,"ymin":1265.0,"xmax":709.0,"ymax":1611.0},{"id":74,"contenttext":"東京·羅馬·伯林の樞軸は、","xmin":663.0,"ymin":1637.0,"xmax":712.0,"ymax":2132.0},{"id":75,"contenttext":"比較的鞏固なものと思ひましたが、","xmin":584.0,"ymin":558.0,"xmax":635.0,"ymax":1179.0},{"id":76,"contenttext":"實にあてになりませんでした。","xmin":587.0,"ymin":1188.0,"xmax":636.0,"ymax":1733.0},{"id":77,"contenttext":"かう云ふ次第で、","xmin":590.0,"ymin":1752.0,"xmax":641.0,"ymax":2056.0},{"id":78,"contenttext":"世界","xmin":592.0,"ymin":2063.0,"xmax":641.0,"ymax":2154.0},{"id":79,"contenttext":"t","xmin":551.0,"ymin":755.0,"xmax":571.0,"ymax":800.0},{"id":80,"contenttext":"の將來は豫測を許しません。","xmin":508.0,"ymin":560.0,"xmax":558.0,"ymax":1057.0},{"id":81,"contenttext":"今後我が國は如何なる難局に立つかわかりません。","xmin":509.0,"ymin":1069.0,"xmax":563.0,"ymax":1971.0},{"id":82,"contenttext":"されど我","xmin":514.0,"ymin":1987.0,"xmax":567.0,"ymax":2151.0}]