[{"id":0,"contenttext":"四","xmin":2740.0,"ymin":1780.0,"xmax":2781.0,"ymax":1821.0},{"id":1,"contenttext":"られる。","xmin":2690.0,"ymin":591.0,"xmax":2734.0,"ymax":733.0},{"id":2,"contenttext":"現時の樣な外國資源を獲得せねばならぬ時代には、","xmin":2668.0,"ymin":746.0,"xmax":2734.0,"ymax":1641.0},{"id":3,"contenttext":"少しでもこれを海外に出さね","xmin":2657.0,"ymin":1656.0,"xmax":2718.0,"ymax":2177.0},{"id":4,"contenttext":"ばならぬ。","xmin":2612.0,"ymin":587.0,"xmax":2662.0,"ymax":770.0},{"id":5,"contenttext":"そこでウドンは牛乳の代りになる。","xmin":2601.0,"ymin":784.0,"xmax":2657.0,"ymax":1400.0},{"id":6,"contenttext":"鰯一つと刺身一皿とは鰯の方に榮養價値が","xmin":2580.0,"ymin":1413.0,"xmax":2646.0,"ymax":2171.0},{"id":7,"contenttext":"ある。","xmin":2544.0,"ymin":584.0,"xmax":2583.0,"ymax":686.0},{"id":8,"contenttext":"かくの如く榮養を〓究して食べると能く生きることが出來る。","xmin":2518.0,"ymin":704.0,"xmax":2588.0,"ymax":1791.0},{"id":9,"contenttext":"能く生きてどうする","xmin":2509.0,"ymin":1806.0,"xmax":2561.0,"ymax":2166.0},{"id":10,"contenttext":"のであるかと申しますと、","xmin":2460.0,"ymin":583.0,"xmax":2514.0,"ymax":1038.0},{"id":11,"contenttext":"そこで人は能く理想を實現することが出來ると云ふことになり","xmin":2437.0,"ymin":1055.0,"xmax":2506.0,"ymax":2168.0},{"id":12,"contenttext":"1:","xmin":2422.0,"ymin":1293.0,"xmax":2440.0,"ymax":1333.0},{"id":13,"contenttext":"ます。","xmin":2396.0,"ymin":581.0,"xmax":2435.0,"ymax":682.0},{"id":14,"contenttext":"食物だけのことではありません。","xmin":2382.0,"ymin":697.0,"xmax":2439.0,"ymax":1277.0},{"id":15,"contenttext":"總ての事をよく考へて、","xmin":2373.0,"ymin":1289.0,"xmax":2426.0,"ymax":1710.0},{"id":16,"contenttext":"そうして十分に理想を實","xmin":2365.0,"ymin":1723.0,"xmax":2418.0,"ymax":2165.0},{"id":17,"contenttext":"現せんとするのが人間であります。","xmin":2312.0,"ymin":577.0,"xmax":2370.0,"ymax":1193.0},{"id":18,"contenttext":"かゝる理想は階段的に進むものであります。","xmin":2233.0,"ymin":617.0,"xmax":2297.0,"ymax":1389.0},{"id":19,"contenttext":"小學校に入學する、","xmin":2224.0,"ymin":1399.0,"xmax":2280.0,"ymax":1749.0},{"id":20,"contenttext":"入學當時は今迄理想で","xmin":2214.0,"ymin":1757.0,"xmax":2272.0,"ymax":2160.0},{"id":21,"contenttext":"あつた入學したことに滿足を感じる。","xmin":2164.0,"ymin":571.0,"xmax":2222.0,"ymax":1228.0},{"id":22,"contenttext":"學年が進むと今度は中學校に入學することを理想と","xmin":2142.0,"ymin":1240.0,"xmax":2210.0,"ymax":2158.0},{"id":23,"contenttext":"する。","xmin":2106.0,"ymin":570.0,"xmax":2145.0,"ymax":670.0},{"id":24,"contenttext":"中學校に入學する、","xmin":2093.0,"ymin":684.0,"xmax":2146.0,"ymax":1030.0},{"id":25,"contenttext":"初めはそれで滿足する、","xmin":2087.0,"ymin":1040.0,"xmax":2139.0,"ymax":1458.0},{"id":26,"contenttext":"しかし上級になると更に高等學校へ、","xmin":2069.0,"ymin":1477.0,"xmax":2130.0,"ymax":2139.0},{"id":27,"contenttext":"大學へと理想が進む。","xmin":2021.0,"ymin":565.0,"xmax":2077.0,"ymax":949.0},{"id":28,"contenttext":"その樣に理想は階段的に進むもので、","xmin":2007.0,"ymin":960.0,"xmax":2068.0,"ymax":1625.0},{"id":29,"contenttext":"人類はこの理想によつて進歩","xmin":1995.0,"ymin":1630.0,"xmax":2054.0,"ymax":2153.0},{"id":30,"contenttext":"發達するのであります。","xmin":1950.0,"ymin":565.0,"xmax":2004.0,"ymax":984.0},{"id":31,"contenttext":"それから理想は努力性を持つてゐる。","xmin":1865.0,"ymin":600.0,"xmax":1932.0,"ymax":1258.0},{"id":32,"contenttext":"努力奮闘以て理想を實現するのであります。","xmin":1849.0,"ymin":1270.0,"xmax":1916.0,"ymax":2049.0},{"id":33,"contenttext":"努力奮闘以て理想を實現するのであります。","xmin":1849.0,"ymin":1270.0,"xmax":1916.0,"ymax":2049.0},{"id":34,"contenttext":"理想","xmin":1845.0,"ymin":2065.0,"xmax":1893.0,"ymax":2150.0},{"id":35,"contenttext":"は决して空想ではありません。","xmin":1271.0,"ymin":553.0,"xmax":1324.0,"ymax":1090.0},{"id":36,"contenttext":"空想には努力性がなく從つて現實性がない。","xmin":1268.0,"ymin":1104.0,"xmax":1319.0,"ymax":1881.0},{"id":37,"contenttext":"そして理想は","xmin":1268.0,"ymin":1895.0,"xmax":1314.0,"ymax":2140.0},{"id":38,"contenttext":":","xmin":1236.0,"ymin":2017.0,"xmax":1255.0,"ymax":2062.0},{"id":39,"contenttext":"現實に不滿足を感じ、","xmin":1204.0,"ymin":554.0,"xmax":1250.0,"ymax":929.0},{"id":40,"contenttext":"過去の種々の經驗に徵し、","xmin":1200.0,"ymin":945.0,"xmax":1248.0,"ymax":1409.0},{"id":41,"contenttext":"事實上より、","xmin":1199.0,"ymin":1422.0,"xmax":1242.0,"ymax":1645.0},{"id":42,"contenttext":"より完全なる狀態を描いて","xmin":1199.0,"ymin":1661.0,"xmax":1242.0,"ymax":2140.0},{"id":43,"contenttext":"進むのでありますから、","xmin":1131.0,"ymin":550.0,"xmax":1177.0,"ymax":977.0},{"id":44,"contenttext":"當然實現性を有するのであります。","xmin":1128.0,"ymin":984.0,"xmax":1174.0,"ymax":1606.0},{"id":45,"contenttext":"理想は人の性質、","xmin":1053.0,"ymin":591.0,"xmax":1102.0,"ymax":889.0},{"id":46,"contenttext":"經驗、","xmin":1053.0,"ymin":903.0,"xmax":1102.0,"ymax":1009.0},{"id":47,"contenttext":"理性、","xmin":1051.0,"ymin":1023.0,"xmax":1102.0,"ymax":1133.0},{"id":48,"contenttext":"想像等に基くので、","xmin":1050.0,"ymin":1140.0,"xmax":1099.0,"ymax":1482.0},{"id":49,"contenttext":"自ら人によつて違ふ。","xmin":1050.0,"ymin":1502.0,"xmax":1097.0,"ymax":1882.0},{"id":50,"contenttext":"卽ち政治家に","xmin":1045.0,"ymin":1893.0,"xmax":1096.0,"ymax":2138.0},{"id":51,"contenttext":"は政治家の理想があり、","xmin":975.0,"ymin":550.0,"xmax":1029.0,"ymax":972.0},{"id":52,"contenttext":"實業家には實業家の理想があり、〓育家には〓育家の理想がある。","xmin":970.0,"ymin":979.0,"xmax":1025.0,"ymax":2135.0},{"id":53,"contenttext":"男子と女子とで亦その理想が違ふ。","xmin":903.0,"ymin":547.0,"xmax":956.0,"ymax":1170.0},{"id":54,"contenttext":"同じ男子の中、","xmin":899.0,"ymin":1179.0,"xmax":950.0,"ymax":1442.0},{"id":55,"contenttext":"或は女子の中でも亦違ふ。","xmin":899.0,"ymin":1456.0,"xmax":948.0,"ymax":1920.0},{"id":56,"contenttext":"かくて人に","xmin":899.0,"ymin":1939.0,"xmax":945.0,"ymax":2137.0},{"id":57,"contenttext":"よつて夫々違ふのであります。","xmin":833.0,"ymin":550.0,"xmax":882.0,"ymax":1092.0},{"id":58,"contenttext":"併し、","xmin":833.0,"ymin":1100.0,"xmax":877.0,"ymax":1214.0},{"id":59,"contenttext":"人間として高所から見ると、","xmin":824.0,"ymin":1221.0,"xmax":878.0,"ymax":1732.0},{"id":60,"contenttext":"その性質、","xmin":826.0,"ymin":1734.0,"xmax":872.0,"ymax":1920.0},{"id":61,"contenttext":"經驗、理性、","xmin":821.0,"ymin":1933.0,"xmax":873.0,"ymax":2137.0},{"id":62,"contenttext":"ほ","xmin":795.0,"ymin":901.0,"xmax":821.0,"ymax":948.0},{"id":63,"contenttext":"想像と云ふ風なのが略同一であるので、","xmin":756.0,"ymin":548.0,"xmax":814.0,"ymax":1245.0},{"id":64,"contenttext":"人間としての理想も略同一となり、","xmin":751.0,"ymin":1262.0,"xmax":804.0,"ymax":1888.0},{"id":65,"contenttext":"爲に人生行爲","xmin":750.0,"ymin":1888.0,"xmax":798.0,"ymax":2140.0},{"id":66,"contenttext":"の標準となるのであります。","xmin":687.0,"ymin":548.0,"xmax":735.0,"ymax":1046.0},{"id":67,"contenttext":"そこで西洋では昔からこの人間の理想はどんなものであらう","xmin":677.0,"ymin":1060.0,"xmax":732.0,"ymax":2137.0},{"id":68,"contenttext":"かと、","xmin":616.0,"ymin":550.0,"xmax":658.0,"ymax":653.0},{"id":69,"contenttext":"色々と研究し、","xmin":612.0,"ymin":662.0,"xmax":660.0,"ymax":929.0},{"id":70,"contenttext":"色々の學說を唱へたのであります。","xmin":608.0,"ymin":938.0,"xmax":657.0,"ymax":1559.0},{"id":71,"contenttext":"その中でも、","xmin":607.0,"ymin":1574.0,"xmax":650.0,"ymax":1798.0},{"id":72,"contenttext":"自我實現說、","xmin":604.0,"ymin":1810.0,"xmax":651.0,"ymax":2040.0},{"id":73,"contenttext":"又は","xmin":601.0,"ymin":2046.0,"xmax":650.0,"ymax":2136.0},{"id":74,"contenttext":"人格實現說といふ風な說が一番よいかと思ひます。","xmin":535.0,"ymin":545.0,"xmax":588.0,"ymax":1440.0},{"id":75,"contenttext":"卽ち","xmin":536.0,"ymin":1454.0,"xmax":580.0,"ymax":1540.0},{"id":76,"contenttext":"「人間の理想は自我或は自分を實","xmin":527.0,"ymin":1548.0,"xmax":580.0,"ymax":2139.0},{"id":77,"contenttext":"現することである」といふのであります。","xmin":462.0,"ymin":543.0,"xmax":512.0,"ymax":1281.0},{"id":78,"contenttext":"今日の自分は不十分である、","xmin":461.0,"ymin":1296.0,"xmax":507.0,"ymax":1804.0},{"id":79,"contenttext":"明日の自分はより","xmin":460.0,"ymin":1810.0,"xmax":504.0,"ymax":2137.0}]