[{"id":0,"contenttext":"使命と世界の將來」についてお話を伺ふことは甚だ幸であると思ひます。","xmin":2746.0,"ymin":575.0,"xmax":2803.0,"ymax":1864.0},{"id":1,"contenttext":"田中先生は、","xmin":2747.0,"ymin":1876.0,"xmax":2795.0,"ymax":2111.0},{"id":2,"contenttext":"當","xmin":2749.0,"ymin":2112.0,"xmax":2796.0,"ymax":2164.0},{"id":3,"contenttext":"地へは數度おいでになつてゐられますので、","xmin":2675.0,"ymin":575.0,"xmax":2726.0,"ymax":1353.0},{"id":4,"contenttext":"中にはお馴染の方もあると思ひます。","xmin":2673.0,"ymin":1359.0,"xmax":2720.0,"ymax":2023.0},{"id":5,"contenttext":"どうか","xmin":2673.0,"ymin":2037.0,"xmax":2715.0,"ymax":2157.0},{"id":6,"contenttext":"御〓聽をお願ひ致します。","xmin":2603.0,"ymin":574.0,"xmax":2652.0,"ymax":1029.0},{"id":7,"contenttext":"皇道の使命と世界の將來","xmin":1359.0,"ymin":738.0,"xmax":1470.0,"ymax":1622.0},{"id":8,"contenttext":"文","xmin":1265.0,"ymin":1174.0,"xmax":1309.0,"ymax":1224.0},{"id":9,"contenttext":"學博","xmin":1263.0,"ymin":1232.0,"xmax":1306.0,"ymax":1355.0},{"id":10,"contenttext":"士","xmin":1262.0,"ymin":1368.0,"xmax":1306.0,"ymax":1414.0},{"id":11,"contenttext":"田","xmin":1253.0,"ymin":1486.0,"xmax":1306.0,"ymax":1545.0},{"id":12,"contenttext":"中","xmin":1250.0,"ymin":1590.0,"xmax":1306.0,"ymax":1652.0},{"id":13,"contenttext":"義","xmin":1246.0,"ymin":1690.0,"xmax":1309.0,"ymax":1762.0},{"id":14,"contenttext":"能","xmin":1246.0,"ymin":1795.0,"xmax":1306.0,"ymax":1865.0},{"id":15,"contenttext":"氏","xmin":1241.0,"ymin":1903.0,"xmax":1302.0,"ymax":1971.0},{"id":16,"contenttext":"述","xmin":1243.0,"ymin":2003.0,"xmax":1304.0,"ymax":2069.0},{"id":17,"contenttext":"今回香川縣神職會に於かれまして、","xmin":1116.0,"ymin":582.0,"xmax":1173.0,"ymax":1204.0},{"id":18,"contenttext":"高松市で五日間講習會をお開きになりますので、私","xmin":1107.0,"ymin":1215.0,"xmax":1165.0,"ymax":2134.0},{"id":19,"contenttext":"はその御依賴により參りましたのでありますが、この機會に於いて本日こゝに諸君に對し","xmin":1031.0,"ymin":545.0,"xmax":1099.0,"ymax":2132.0},{"id":20,"contenttext":"所懷を述べる事を得まするのは、","xmin":969.0,"ymin":543.0,"xmax":1023.0,"ymax":1121.0},{"id":21,"contenttext":"私の光榮とする所で御座います。","xmin":960.0,"ymin":1136.0,"xmax":1016.0,"ymax":1717.0},{"id":22,"contenttext":"私は講演に先だちまして、","xmin":898.0,"ymin":582.0,"xmax":950.0,"ymax":1040.0},{"id":23,"contenttext":"今次事變にお國の爲に一身をさゝげられました英靈に對し敬","xmin":883.0,"ymin":1055.0,"xmax":945.0,"ymax":2132.0},{"id":24,"contenttext":"意を捧げると共に、","xmin":824.0,"ymin":541.0,"xmax":877.0,"ymax":886.0},{"id":25,"contenttext":"酷寒炎熱の下に奮戰力鬪せられる皇軍の勇士に感謝の意を表し、","xmin":808.0,"ymin":894.0,"xmax":871.0,"ymax":2037.0},{"id":26,"contenttext":"武運","xmin":811.0,"ymin":2042.0,"xmax":859.0,"ymax":2132.0},{"id":27,"contenttext":"長久を祈る所のものであります。","xmin":750.0,"ymin":541.0,"xmax":803.0,"ymax":1118.0},{"id":28,"contenttext":"扨これから","xmin":682.0,"ymin":581.0,"xmax":728.0,"ymax":787.0},{"id":29,"contenttext":"「皇道の使命と世界の將來」との題下に少時所懷を申上げまして、","xmin":664.0,"ymin":787.0,"xmax":727.0,"ymax":1949.0},{"id":30,"contenttext":"御〓聽の","xmin":663.0,"ymin":1964.0,"xmax":711.0,"ymax":2127.0},{"id":31,"contenttext":"程をお願致します次第であります。","xmin":603.0,"ymin":540.0,"xmax":656.0,"ymax":1157.0},{"id":32,"contenttext":"御〓聽の","xmin":663.0,"ymin":1964.0,"xmax":711.0,"ymax":2127.0}]