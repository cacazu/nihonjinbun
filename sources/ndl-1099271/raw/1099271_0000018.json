[{"id":0,"contenttext":"二八","xmin":2735.0,"ymin":1744.0,"xmax":2781.0,"ymax":1823.0},{"id":1,"contenttext":"に服する、","xmin":2690.0,"ymin":598.0,"xmax":2732.0,"ymax":778.0},{"id":2,"contenttext":"御馳走があつたら先づ父兄に差上げる、","xmin":2667.0,"ymin":788.0,"xmax":2732.0,"ymax":1491.0},{"id":3,"contenttext":"が、","xmin":2669.0,"ymin":1502.0,"xmax":2713.0,"ymax":1575.0},{"id":4,"contenttext":"これだけでは孝行にはならぬ。","xmin":2656.0,"ymin":1579.0,"xmax":2714.0,"ymax":2122.0},{"id":5,"contenttext":"先","xmin":2654.0,"ymin":2132.0,"xmax":2701.0,"ymax":2181.0},{"id":6,"contenttext":"의","xmin":2639.0,"ymin":1262.0,"xmax":2659.0,"ymax":1285.0},{"id":7,"contenttext":"づ親に對する誠心誠意で、","xmin":2598.0,"ymin":595.0,"xmax":2661.0,"ymax":1083.0},{"id":8,"contenttext":"親愛の情面に表れ、","xmin":2593.0,"ymin":1084.0,"xmax":2650.0,"ymax":1451.0},{"id":9,"contenttext":"顏色を相げることが大切であるといはれ","xmin":2576.0,"ymin":1453.0,"xmax":2643.0,"ymax":2178.0},{"id":10,"contenttext":"빅","xmin":2576.0,"ymin":708.0,"xmax":2600.0,"ymax":755.0},{"id":11,"contenttext":"た。","xmin":2540.0,"ymin":591.0,"xmax":2583.0,"ymax":658.0},{"id":12,"contenttext":"子游が孝をたづねた。","xmin":2525.0,"ymin":666.0,"xmax":2586.0,"ymax":1059.0},{"id":13,"contenttext":"」孔子が答へて云ふのには、「今之孝。者、是ヲ謂ニ能能養","xmin":2504.0,"ymin":1053.0,"xmax":2577.0,"ymax":2058.0},{"id":14,"contenttext":"至ルタタ","xmin":2508.0,"ymin":2071.0,"xmax":2551.0,"ymax":2176.0},{"id":15,"contenttext":"於犬馬一皆能\"有一養養ヲ。","xmin":2456.0,"ymin":585.0,"xmax":2514.0,"ymax":969.0},{"id":16,"contenttext":"不一〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓乎。」と云ひ、","xmin":2445.0,"ymin":980.0,"xmax":2505.0,"ymax":1564.0},{"id":17,"contenttext":"現今の孝行は、","xmin":2438.0,"ymin":1570.0,"xmax":2492.0,"ymax":1842.0},{"id":18,"contenttext":"能く親を養ふのを","xmin":2432.0,"ymin":1848.0,"xmax":2485.0,"ymax":2175.0},{"id":19,"contenttext":"以て孝行としてゐるが、","xmin":2389.0,"ymin":585.0,"xmax":2442.0,"ymax":1003.0},{"id":20,"contenttext":"養ふだけなら犬や馬も同じことである。","xmin":2371.0,"ymin":1016.0,"xmax":2433.0,"ymax":1715.0},{"id":21,"contenttext":"敬といふものがなかつた","xmin":2360.0,"ymin":1728.0,"xmax":2417.0,"ymax":2170.0},{"id":22,"contenttext":"ら、","xmin":2330.0,"ymin":586.0,"xmax":2364.0,"ymax":643.0},{"id":23,"contenttext":"犬馬を養ふのと何の區別もないのであると云つた。","xmin":2303.0,"ymin":663.0,"xmax":2369.0,"ymax":1557.0},{"id":24,"contenttext":"尊敬しなければ孝にはならぬと云","xmin":2285.0,"ymin":1568.0,"xmax":2350.0,"ymax":2170.0},{"id":25,"contenttext":"ふのである。","xmin":2249.0,"ymin":586.0,"xmax":2294.0,"ymax":802.0},{"id":26,"contenttext":"孔子の孝の說明はかやうに色々となつてゐる。","xmin":2225.0,"ymin":817.0,"xmax":2293.0,"ymax":1632.0},{"id":27,"contenttext":"勿論、孝行の仕方は色々ある。","xmin":2209.0,"ymin":1643.0,"xmax":2272.0,"ymax":2166.0},{"id":28,"contenttext":"し","xmin":2208.0,"ymin":805.0,"xmax":2235.0,"ymax":838.0},{"id":29,"contenttext":"併し孔子は、子貢の一言以て終身行ふべきものを問ふたのに對し、「それ恕か」と答へたので","xmin":2134.0,"ymin":576.0,"xmax":2218.0,"ymax":2165.0},{"id":30,"contenttext":"あるが、","xmin":2100.0,"ymin":578.0,"xmax":2146.0,"ymax":720.0},{"id":31,"contenttext":"孝行も一言以て孝を云へば、","xmin":2083.0,"ymin":731.0,"xmax":2144.0,"ymax":1242.0},{"id":32,"contenttext":"私は、","xmin":2080.0,"ymin":1242.0,"xmax":2132.0,"ymax":1358.0},{"id":33,"contenttext":"親の意志を尊重することであると云ひたいの","xmin":2062.0,"ymin":1363.0,"xmax":2131.0,"ymax":2161.0},{"id":34,"contenttext":"であります。","xmin":2026.0,"ymin":579.0,"xmax":2068.0,"ymax":796.0},{"id":35,"contenttext":"たとひ親をして、","xmin":2020.0,"ymin":811.0,"xmax":2066.0,"ymax":1114.0},{"id":36,"contenttext":"金殿玉樓に住まはしめ、","xmin":2004.0,"ymin":1129.0,"xmax":2062.0,"ymax":1549.0},{"id":37,"contenttext":"美衣美食に飽かしめましても、","xmin":1989.0,"ymin":1563.0,"xmax":2052.0,"ymax":2110.0},{"id":38,"contenttext":"親","xmin":1991.0,"ymin":2114.0,"xmax":2037.0,"ymax":2166.0},{"id":39,"contenttext":"そむ","xmin":1986.0,"ymin":733.0,"xmax":2015.0,"ymax":783.0},{"id":40,"contenttext":"の意志に背けば决して孝行とはなりません。","xmin":1940.0,"ymin":577.0,"xmax":2002.0,"ymax":1349.0},{"id":41,"contenttext":"卽ち如何なることをしても、","xmin":1930.0,"ymin":1360.0,"xmax":1982.0,"ymax":1864.0},{"id":42,"contenttext":"親の意志を尊重","xmin":1917.0,"ymin":1875.0,"xmax":1974.0,"ymax":2160.0},{"id":43,"contenttext":"し、","xmin":1889.0,"ymin":576.0,"xmax":1928.0,"ymax":634.0},{"id":44,"contenttext":"親の意志を維承するのでなくては孝行とはならないのであります。","xmin":1853.0,"ymin":649.0,"xmax":1929.0,"ymax":1827.0},{"id":45,"contenttext":"所で、","xmin":1852.0,"ymin":1834.0,"xmax":1899.0,"ymax":1940.0},{"id":46,"contenttext":"親の意志と","xmin":1842.0,"ymin":1953.0,"xmax":1897.0,"ymax":2156.0},{"id":47,"contenttext":"そつぜん","xmin":1372.0,"ymin":838.0,"xmax":1401.0,"ymax":928.0},{"id":48,"contenttext":"云ひましても、","xmin":1336.0,"ymin":565.0,"xmax":1382.0,"ymax":822.0},{"id":49,"contenttext":"卒然親に向ひ、","xmin":1332.0,"ymin":836.0,"xmax":1383.0,"ymax":1106.0},{"id":50,"contenttext":"その意志の如何なるかを尋ねましても、","xmin":1336.0,"ymin":1111.0,"xmax":1382.0,"ymax":1815.0},{"id":51,"contenttext":"直に答へられない","xmin":1336.0,"ymin":1827.0,"xmax":1384.0,"ymax":2145.0},{"id":52,"contenttext":"かも知れません。","xmin":1262.0,"ymin":565.0,"xmax":1307.0,"ymax":863.0},{"id":53,"contenttext":"併し、","xmin":1262.0,"ymin":872.0,"xmax":1308.0,"ymax":985.0},{"id":54,"contenttext":"親は本來孝子でありましたので、","xmin":1262.0,"ymin":996.0,"xmax":1307.0,"ymax":1574.0},{"id":55,"contenttext":"その親の意志を奉じて居られた","xmin":1260.0,"ymin":1588.0,"xmax":1309.0,"ymax":2149.0},{"id":56,"contenttext":"筈です。","xmin":1187.0,"ymin":560.0,"xmax":1235.0,"ymax":709.0},{"id":57,"contenttext":"そんな具合に、","xmin":1189.0,"ymin":720.0,"xmax":1235.0,"ymax":984.0},{"id":58,"contenttext":"親からその親に及びますので、","xmin":1189.0,"ymin":998.0,"xmax":1235.0,"ymax":1536.0},{"id":59,"contenttext":"結局親の意志は祖先の意志なので","xmin":1186.0,"ymin":1549.0,"xmax":1238.0,"ymax":2151.0},{"id":60,"contenttext":"あります。","xmin":1118.0,"ymin":565.0,"xmax":1160.0,"ymax":743.0},{"id":61,"contenttext":"我々の祖先の意志は如何と申しますと、","xmin":1116.0,"ymin":760.0,"xmax":1163.0,"ymax":1459.0},{"id":62,"contenttext":"そは悉く皇道を奉體し、","xmin":1114.0,"ymin":1469.0,"xmax":1163.0,"ymax":1890.0},{"id":63,"contenttext":"敬神崇祖の念","xmin":1114.0,"ymin":1905.0,"xmax":1163.0,"ymax":2152.0},{"id":64,"contenttext":"に厚く、","xmin":1041.0,"ymin":569.0,"xmax":1084.0,"ymax":708.0},{"id":65,"contenttext":"盡忠報國の至誠を致すを意志として來たのであります。","xmin":1040.0,"ymin":720.0,"xmax":1087.0,"ymax":1696.0},{"id":66,"contenttext":"私どもが、","xmin":1041.0,"ymin":1708.0,"xmax":1088.0,"ymax":1893.0},{"id":67,"contenttext":"今日かく陛下","xmin":1040.0,"ymin":1908.0,"xmax":1087.0,"ymax":2152.0},{"id":68,"contenttext":"の臣民として存在しまするのは、","xmin":967.0,"ymin":567.0,"xmax":1014.0,"ymax":1143.0},{"id":69,"contenttext":"最もよく之を證明して居るのであります。","xmin":965.0,"ymin":1155.0,"xmax":1014.0,"ymax":1898.0},{"id":70,"contenttext":"萬々一私ども","xmin":968.0,"ymin":1907.0,"xmax":1012.0,"ymax":2154.0},{"id":71,"contenttext":"の祖先に、","xmin":892.0,"ymin":565.0,"xmax":939.0,"ymax":746.0},{"id":72,"contenttext":"皇道を守らないものがあつたとしましたなら、","xmin":890.0,"ymin":762.0,"xmax":939.0,"ymax":1577.0},{"id":73,"contenttext":"私どもは今日存在しないのであ","xmin":893.0,"ymin":1593.0,"xmax":939.0,"ymax":2152.0},{"id":74,"contenttext":"ります。","xmin":824.0,"ymin":567.0,"xmax":863.0,"ymax":709.0},{"id":75,"contenttext":"何となれば、","xmin":821.0,"ymin":723.0,"xmax":867.0,"ymax":951.0},{"id":76,"contenttext":"難波大助のやうな反皇道者は、","xmin":821.0,"ymin":959.0,"xmax":867.0,"ymax":1497.0},{"id":77,"contenttext":"子孫を殘さないからであります。","xmin":821.0,"ymin":1515.0,"xmax":867.0,"ymax":2099.0},{"id":78,"contenttext":"平","xmin":819.0,"ymin":2107.0,"xmax":868.0,"ymax":2155.0},{"id":79,"contenttext":"重盛は、","xmin":746.0,"ymin":565.0,"xmax":795.0,"ymax":709.0},{"id":80,"contenttext":"忠ならんと欲すれば孝ならず、","xmin":746.0,"ymin":725.0,"xmax":794.0,"ymax":1267.0},{"id":81,"contenttext":"孝ならんと欲すれば忠ならずと云ひ、","xmin":743.0,"ymin":1272.0,"xmax":796.0,"ymax":1934.0},{"id":82,"contenttext":"父〓盛の意","xmin":744.0,"ymin":1951.0,"xmax":794.0,"ymax":2155.0},{"id":83,"contenttext":"志に反した樣でありますが、","xmin":671.0,"ymin":567.0,"xmax":722.0,"ymax":1062.0},{"id":84,"contenttext":"併し事實はさうでないのであります。","xmin":669.0,"ymin":1076.0,"xmax":719.0,"ymax":1737.0},{"id":85,"contenttext":"〓盛が後白河法皇を鳥","xmin":670.0,"ymin":1752.0,"xmax":719.0,"ymax":2159.0},{"id":86,"contenttext":"3)","xmin":639.0,"ymin":723.0,"xmax":660.0,"ymax":768.0},{"id":87,"contenttext":"羽の宮に遷し奉らんと致しまして、","xmin":599.0,"ymin":569.0,"xmax":646.0,"ymax":1190.0},{"id":88,"contenttext":"軍勢を集めました時、","xmin":595.0,"ymin":1196.0,"xmax":645.0,"ymax":1577.0},{"id":89,"contenttext":"重盛は內大臣の服裝で〓盛の邸","xmin":595.0,"ymin":1593.0,"xmax":644.0,"ymax":2159.0},{"id":90,"contenttext":"=","xmin":565.0,"ymin":2075.0,"xmax":583.0,"ymax":2118.0},{"id":91,"contenttext":"に行きました。","xmin":526.0,"ymin":569.0,"xmax":571.0,"ymax":825.0},{"id":92,"contenttext":"宗盛が、","xmin":524.0,"ymin":840.0,"xmax":570.0,"ymax":984.0},{"id":93,"contenttext":"この一大事の時に文官の服裝で來られるとはどうした事かと詰る","xmin":522.0,"ymin":1003.0,"xmax":570.0,"ymax":2154.0},{"id":94,"contenttext":"二九","xmin":448.0,"ymin":1719.0,"xmax":495.0,"ymax":1801.0}]