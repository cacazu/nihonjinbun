[{"id":0,"contenttext":"琴","xmin":1360.0,"ymin":859.0,"xmax":1424.0,"ymax":926.0},{"id":1,"contenttext":"陵","xmin":1362.0,"ymin":949.0,"xmax":1418.0,"ymax":1018.0},{"id":2,"contenttext":"宮","xmin":1360.0,"ymin":1042.0,"xmax":1413.0,"ymax":1112.0},{"id":3,"contenttext":"司","xmin":1355.0,"ymin":1127.0,"xmax":1416.0,"ymax":1199.0},{"id":4,"contenttext":"挨拶","xmin":1349.0,"ymin":1217.0,"xmax":1412.0,"ymax":1373.0},{"id":5,"contenttext":"本日は炎著の砌、","xmin":1250.0,"ymin":583.0,"xmax":1307.0,"ymax":886.0},{"id":6,"contenttext":"多數御參集下さいました段感謝いたします。","xmin":1231.0,"ymin":904.0,"xmax":1299.0,"ymax":1680.0},{"id":7,"contenttext":"皆さんも御承知の通り、","xmin":1220.0,"ymin":1689.0,"xmax":1280.0,"ymax":2117.0},{"id":8,"contenttext":"我が忠勇なる將兵諸君は、","xmin":1172.0,"ymin":544.0,"xmax":1235.0,"ymax":1008.0},{"id":9,"contenttext":"炎熱灼くがごとき支那の地に、","xmin":1160.0,"ymin":1013.0,"xmax":1224.0,"ymax":1559.0},{"id":10,"contenttext":"將又滿ソ國境に、","xmin":1150.0,"ymin":1568.0,"xmax":1207.0,"ymax":1878.0},{"id":11,"contenttext":"不撓不屈連戰","xmin":1141.0,"ymin":1884.0,"xmax":1200.0,"ymax":2135.0},{"id":12,"contenttext":"連勝してゐるのでありますが、","xmin":1099.0,"ymin":544.0,"xmax":1157.0,"ymax":1079.0},{"id":13,"contenttext":"戰局の前途は尙遼遠であります。","xmin":1083.0,"ymin":1094.0,"xmax":1143.0,"ymax":1673.0},{"id":14,"contenttext":"戰爭の相手は單に支那一","xmin":1069.0,"ymin":1685.0,"xmax":1129.0,"ymax":2120.0},{"id":15,"contenttext":"國ではありません。","xmin":1030.0,"ymin":542.0,"xmax":1083.0,"ymax":883.0},{"id":16,"contenttext":"支那の背後にある外國を相手にしてゐる。","xmin":1011.0,"ymin":893.0,"xmax":1077.0,"ymax":1631.0},{"id":17,"contenttext":"これは一体どういふ樣にな","xmin":998.0,"ymin":1647.0,"xmax":1059.0,"ymax":2128.0},{"id":18,"contenttext":"るのでありませうか。","xmin":957.0,"ymin":541.0,"xmax":1009.0,"ymax":915.0},{"id":19,"contenttext":"ソ聯は繰返し繰返し滿洲の國境を侵犯して來る。","xmin":935.0,"ymin":935.0,"xmax":1001.0,"ymax":1788.0},{"id":20,"contenttext":"この方面はどの樣","xmin":926.0,"ymin":1808.0,"xmax":979.0,"ymax":2127.0},{"id":21,"contenttext":"になるのでありませうか。","xmin":882.0,"ymin":539.0,"xmax":935.0,"ymax":993.0},{"id":22,"contenttext":"かう考へますと、","xmin":875.0,"ymin":1010.0,"xmax":924.0,"ymax":1313.0},{"id":23,"contenttext":"前途は益々多難なのであります。","xmin":857.0,"ymin":1323.0,"xmax":920.0,"ymax":1907.0},{"id":24,"contenttext":"然るに今回","xmin":850.0,"ymin":1916.0,"xmax":905.0,"ymax":2126.0},{"id":25,"contenttext":"獨逸とソビエートとの間に不可侵條約が結ばれたと聞きます。","xmin":791.0,"ymin":533.0,"xmax":868.0,"ymax":1624.0},{"id":26,"contenttext":"この結果は、","xmin":786.0,"ymin":1643.0,"xmax":837.0,"ymax":1871.0},{"id":27,"contenttext":"ソ聯はその全","xmin":777.0,"ymin":1880.0,"xmax":831.0,"ymax":2122.0},{"id":28,"contenttext":"力を擧げて日本に向つて來る樣になるのではなからうか。","xmin":719.0,"ymin":532.0,"xmax":794.0,"ymax":1544.0},{"id":29,"contenttext":"今日では、","xmin":716.0,"ymin":1557.0,"xmax":765.0,"ymax":1751.0},{"id":30,"contenttext":"世界の一角に出來た","xmin":705.0,"ymin":1755.0,"xmax":761.0,"ymax":2121.0},{"id":31,"contenttext":"ことも直ちに我が國にひゞいて來るのであります。","xmin":651.0,"ymin":533.0,"xmax":719.0,"ymax":1422.0},{"id":32,"contenttext":"この不可侵條約は、","xmin":640.0,"ymin":1440.0,"xmax":699.0,"ymax":1780.0},{"id":33,"contenttext":"一体日本にどうひ","xmin":633.0,"ymin":1806.0,"xmax":687.0,"ymax":2119.0},{"id":34,"contenttext":"びいて來るでせうか","xmin":591.0,"ymin":527.0,"xmax":647.0,"ymax":889.0},{"id":35,"contenttext":"此の時に當り、","xmin":576.0,"ymin":1039.0,"xmax":634.0,"ymax":1309.0},{"id":36,"contenttext":"本日こゝに、","xmin":574.0,"ymin":1314.0,"xmax":623.0,"ymax":1544.0},{"id":37,"contenttext":"然るに今回","xmin":850.0,"ymin":1916.0,"xmax":905.0,"ymax":2126.0},{"id":38,"contenttext":"この結果は、","xmin":786.0,"ymin":1643.0,"xmax":837.0,"ymax":1871.0},{"id":39,"contenttext":"この結果は、","xmin":786.0,"ymin":1643.0,"xmax":837.0,"ymax":1871.0},{"id":40,"contenttext":"ソ聯はその全","xmin":777.0,"ymin":1880.0,"xmax":831.0,"ymax":2122.0},{"id":41,"contenttext":"今日では、","xmin":716.0,"ymin":1557.0,"xmax":765.0,"ymax":1751.0},{"id":42,"contenttext":"世界の一角に出來た","xmin":705.0,"ymin":1755.0,"xmax":761.0,"ymax":2121.0},{"id":43,"contenttext":"この不可侵條約は、","xmin":640.0,"ymin":1440.0,"xmax":699.0,"ymax":1780