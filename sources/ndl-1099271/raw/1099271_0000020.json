[{"id":0,"contenttext":"三二","xmin":2778.0,"ymin":1701.0,"xmax":2817.0,"ymax":1782.0},{"id":1,"contenttext":"あり、","xmin":2692.0,"ymin":556.0,"xmax":2733.0,"ymax":657.0},{"id":2,"contenttext":"孝である。","xmin":2693.0,"ymin":674.0,"xmax":2739.0,"ymax":854.0},{"id":3,"contenttext":"忠孝一本、","xmin":2692.0,"ymin":868.0,"xmax":2744.0,"ymax":1054.0},{"id":4,"contenttext":"これは實に家族制度の我が國にのみ見らるゝ現象で、","xmin":2696.0,"ymin":1072.0,"xmax":2755.0,"ymax":2008.0},{"id":5,"contenttext":"皇道の","xmin":2708.0,"ymin":2015.0,"xmax":2754.0,"ymax":2138.0},{"id":6,"contenttext":"特色である。","xmin":2617.0,"ymin":557.0,"xmax":2662.0,"ymax":778.0},{"id":7,"contenttext":"我々はこれを以て世界の將來に處して行かねばならぬのであります。","xmin":2615.0,"ymin":791.0,"xmax":2681.0,"ymax":2001.0},{"id":8,"contenttext":"色々と皇道に就いて述べましたが、","xmin":2540.0,"ymin":597.0,"xmax":2600.0,"ymax":1215.0},{"id":9,"contenttext":"尙その內容をなすものは、","xmin":2550.0,"ymin":1226.0,"xmax":2601.0,"ymax":1686.0},{"id":10,"contenttext":"神ながらの精神であると","xmin":2556.0,"ymin":1701.0,"xmax":2608.0,"ymax":2142.0},{"id":11,"contenttext":"云ふことが出來るのであります。","xmin":2469.0,"ymin":562.0,"xmax":2521.0,"ymax":1135.0},{"id":12,"contenttext":"神ながらとは、","xmin":2475.0,"ymin":1150.0,"xmax":2526.0,"ymax":1410.0},{"id":13,"contenttext":"日本書紀の孝德天皇の條に、","xmin":2477.0,"ymin":1430.0,"xmax":2532.0,"ymax":1930.0},{"id":14,"contenttext":"惟神と云ふ","xmin":2485.0,"ymin":1939.0,"xmax":2535.0,"ymax":2142.0},{"id":15,"contenttext":"文字で示してあります。","xmin":2396.0,"ymin":562.0,"xmax":2444.0,"ymax":980.0},{"id":16,"contenttext":"西洋では何でも物をするのを義務といつて居ります。","xmin":2324.0,"ymin":602.0,"xmax":2378.0,"ymax":1533.0},{"id":17,"contenttext":"カントも","xmin":2340.0,"ymin":1552.0,"xmax":2379.0,"ymax":1712.0},{"id":18,"contenttext":"「道德は義務の爲に義務","xmin":2333.0,"ymin":1720.0,"xmax":2385.0,"ymax":2149.0},{"id":19,"contenttext":"をするのである」といつて居ります。","xmin":2250.0,"ymin":563.0,"xmax":2301.0,"ymax":1220.0},{"id":20,"contenttext":"この言葉は我が國にも輸入せられ、","xmin":2256.0,"ymin":1237.0,"xmax":2311.0,"ymax":1856.0},{"id":21,"contenttext":"義務〓育とか、","xmin":2264.0,"ymin":1863.0,"xmax":2310.0,"ymax":2132.0},{"id":22,"contenttext":"納稅の義務とか、","xmin":2176.0,"ymin":562.0,"xmax":2225.0,"ymax":863.0},{"id":23,"contenttext":"兵役の義務とか申します。","xmin":2179.0,"ymin":877.0,"xmax":2233.0,"ymax":1338.0},{"id":24,"contenttext":"しかしこれはあまり面白い言葉ではない。","xmin":2185.0,"ymin":1352.0,"xmax":2239.0,"ymax":2085.0},{"id":25,"contenttext":"若","xmin":2194.0,"ymin":2102.0,"xmax":2244.0,"ymax":2150.0},{"id":26,"contenttext":"し將來改めるならば、","xmin":2103.0,"ymin":564.0,"xmax":2152.0,"ymax":941.0},{"id":27,"contenttext":"私は道と改めて欲しいと思ひます。","xmin":2104.0,"ymin":957.0,"xmax":2163.0,"ymax":1578.0},{"id":28,"contenttext":"納稅の道、","xmin":2111.0,"ymin":1588.0,"xmax":2163.0,"ymax":1780.0},{"id":29,"contenttext":"兵役の道といふ風に","xmin":2116.0,"ymin":1790.0,"xmax":2166.0,"ymax":2149.0},{"id":30,"contenttext":"したいと思ひます。","xmin":2032.0,"ymin":567.0,"xmax":2077.0,"ymax":906.0},{"id":31,"contenttext":"納稅でもいや〓〓納めて、","xmin":2033.0,"ymin":920.0,"xmax":2082.0,"ymax":1386.0},{"id":32,"contenttext":"そしてこれで義務がすんだなどといふ言葉","xmin":2037.0,"ymin":1393.0,"xmax":2093.0,"ymax":2152.0},{"id":33,"contenttext":"は誠によくないのであります。","xmin":1957.0,"ymin":568.0,"xmax":2009.0,"ymax":1104.0},{"id":34,"contenttext":"旅順でのステツセルも、","xmin":1962.0,"ymin":1118.0,"xmax":2014.0,"ymax":1538.0},{"id":35,"contenttext":"我が義務はすんだと考へて白旗を","xmin":1965.0,"ymin":1552.0,"xmax":2022.0,"ymax":2154.0},{"id":36,"contenttext":"立てた。","xmin":1881.0,"ymin":569.0,"xmax":1930.0,"ymax":712.0},{"id":37,"contenttext":"日本のやうに城を枕にして討死の覺悟で戰はるれば、","xmin":1883.0,"ymin":726.0,"xmax":1943.0,"ymax":1659.0},{"id":38,"contenttext":"日本の方にも又損害が多か","xmin":1890.0,"ymin":1677.0,"xmax":1949.0,"ymax":2156.0},{"id":39,"contenttext":"皇道の","xmin":2708.0,"ymin":2015.0,"xmax":2754.0,"ymax":2138.0},{"id":40,"contenttext":"つたであろうが、","xmin":1311.0,"ymin":574.0,"xmax":1357.0,"ymax":870.0},{"id":41,"contenttext":"義務がすんだといふ考へで、","xmin":1311.0,"ymin":884.0,"xmax":1359.0,"ymax":1382.0},{"id":42,"contenttext":"白旗を立てたのは、","xmin":1311.0,"ymin":1396.0,"xmax":1358.0,"ymax":1738.0},{"id":43,"contenttext":"日本の爲にはよかつた","xmin":1314.0,"ymin":1759.0,"xmax":1360.0,"ymax":2157.0},{"id":44,"contenttext":"が、","xmin":1238.0,"ymin":570.0,"xmax":1282.0,"ymax":633.0},{"id":45,"contenttext":"いかにも西洋的である。","xmin":1237.0,"ymin":652.0,"xmax":1286.0,"ymax":1066.0},{"id":46,"contenttext":"日本海々戰のとき、","xmin":1238.0,"ymin":1086.0,"xmax":1288.0,"ymax":1422.0},{"id":47,"contenttext":"敵の司令長官ロジエストウエンスキーが","xmin":1241.0,"ymin":1440.0,"xmax":1285.0,"ymax":2152.0},{"id":48,"contenttext":"小さい船で逃げるとき、","xmin":1165.0,"ymin":570.0,"xmax":1213.0,"ymax":995.0},{"id":49,"contenttext":"この船に白旗が有るか無いかと問ふた。","xmin":1167.0,"ymin":1003.0,"xmax":1214.0,"ymax":1698.0},{"id":50,"contenttext":"自分の義務がすんだのだ","xmin":1168.0,"ymin":1717.0,"xmax":1218.0,"ymax":2159.0},{"id":51,"contenttext":"から、","xmin":1090.0,"ymin":576.0,"xmax":1133.0,"ymax":678.0},{"id":52,"contenttext":"白旗を立てゝもよいのであるといふ考である。","xmin":1090.0,"ymin":689.0,"xmax":1141.0,"ymax":1503.0},{"id":53,"contenttext":"トラフアルガーの海戰のとき、","xmin":1096.0,"ymin":1525.0,"xmax":1140.0,"ymax":2059.0},{"id":54,"contenttext":"英吉","xmin":1094.0,"ymin":2073.0,"xmax":1143.0,"ymax":2160.0},{"id":55,"contenttext":"利の提督ネルソンが「イギリスの國家は各員の義務を盡すを期待す」","xmin":1014.0,"ymin":572.0,"xmax":1067.0,"ymax":1791.0},{"id":56,"contenttext":"と信號を揭げた。","xmin":1018.0,"ymin":1798.0,"xmax":1067.0,"ymax":2103.0},{"id":57,"contenttext":"義","xmin":1021.0,"ymin":2112.0,"xmax":1068.0,"ymax":2162.0},{"id":58,"contenttext":"務と云ふのである。","xmin":941.0,"ymin":573.0,"xmax":993.0,"ymax":910.0},{"id":59,"contenttext":"そして、","xmin":948.0,"ymin":927.0,"xmax":985.0,"ymax":1068.0},{"id":60,"contenttext":"大戰も英吉利の勝利で終らんとする頃、","xmin":941.0,"ymin":1086.0,"xmax":996.0,"ymax":1788.0},{"id":61,"contenttext":"佛蘭西の軍艦が白旗","xmin":945.0,"ymin":1795.0,"xmax":992.0,"ymax":2162.0},{"id":62,"contenttext":"を立てゝ近寄つて來たので、","xmin":867.0,"ymin":572.0,"xmax":916.0,"ymax":1070.0},{"id":63,"contenttext":"降參したものは擊つなととめたが、","xmin":870.0,"ymin":1086.0,"xmax":919.0,"ymax":1707.0},{"id":64,"contenttext":"この佛蘭西の軍艦は、","xmin":872.0,"ymin":1720.0,"xmax":921.0,"ymax":2110.0},{"id":65,"contenttext":"ネ","xmin":883.0,"ymin":2119.0,"xmax":914.0,"ymax":2157.0},{"id":66,"contenttext":"ルソンの旗艦に近づいて、突然物蔭からネルソンをねらひ撃ちした。","xmin":795.0,"ymin":577.0,"xmax":846.0,"ymax":1769.0},{"id":67,"contenttext":"ネルソンは負傷した。","xmin":797.0,"ymin":1781.0,"xmax":849.0,"ymax":2163.0},{"id":68,"contenttext":"直に下方の船室に伴ひ、","xmin":721.0,"ymin":572.0,"xmax":772.0,"ymax":992.0},{"id":69,"contenttext":"治療を加へたが、","xmin":722.0,"ymin":1006.0,"xmax":773.0,"ymax":1314.0},{"id":70,"contenttext":"如何せん致命傷である。","xmin":724.0,"ymin":1323.0,"xmax":773.0,"ymax":1746.0},{"id":71,"contenttext":"ネルソンの最後の言葉","xmin":729.0,"ymin":1763.0,"xmax":775.0,"ymax":2164.0},{"id":72,"contenttext":"は、「神よ!","xmin":650.0,"ymin":576.0,"xmax":694.0,"ymax":795.0},{"id":73,"contenttext":"私は私の義務を盡した。","xmin":648.0,"ymin":806.0,"xmax":695.0,"ymax":1231.0},{"id":74,"contenttext":"」と云ふのである。","xmin":649.0,"ymin":1243.0,"xmax":700.0,"ymax":1586.0},{"id":75,"contenttext":"ネルソンは世界的勇將として尊","xmin":651.0,"ymin":1602.0,"xmax":700.0,"ymax":2164.0},{"id":76,"contenttext":"敬せられ、","xmin":573.0,"ymin":574.0,"xmax":621.0,"ymax":756.0},{"id":77,"contenttext":"その死ぬ時の言葉は非常に名高いものである。","xmin":577.0,"ymin":772.0,"xmax":622.0,"ymax":1589.0},{"id":78,"contenttext":"かくの如く西洋では何でも義務","xmin":578.0,"ymin":1608.0,"xmax":626.0,"ymax":2167.0},{"id":79,"contenttext":"である。","xmin":501.0,"ymin":578.0,"xmax":546.0,"ymax":718.0},{"id":80,"contenttext":"義務と云ふのである。","xmin":500.0,"ymin":732.0,"xmax":548.0,"ymax":1112.0},{"id":81,"contenttext":"楠正成公は湊川で戰死せられた。","xmin":497.0,"ymin":1125.0,"xmax":551.0,"ymax":1710.0},{"id":82,"contenttext":"その時","xmin":503.0,"ymin":1724.0,"xmax":549.0,"ymax":1847.0},{"id":83,"contenttext":"「七度人間に生れ","xmin":500.0,"ymin":1858.0,"xmax":553.0,"ymax":2169.0}]