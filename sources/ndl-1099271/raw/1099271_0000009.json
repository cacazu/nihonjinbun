[{"id":1,"contenttext":"の理想は、","xmin":2705.0,"ymin":548.0,"xmax":2754.0,"ymax":723.0},{"id":2,"contenttext":"祖先の神々がお示しになつて居るのであります。","xmin":2703.0,"ymin":746.0,"xmax":2753.0,"ymax":1587.0},{"id":3,"contenttext":"そして又、","xmin":2703.0,"ymin":1638.0,"xmax":2746.0,"ymax":1789.0},{"id":4,"contenttext":"日本國民の理想を","xmin":2701.0,"ymin":1843.0,"xmax":2749.0,"ymax":2123.0},{"id":5,"contenttext":"ミ","xmin":2673.0,"ymin":1278.0,"xmax":2695.0,"ymax":1294.0},{"id":6,"contenttext":"體現せられた方々を、","xmin":2628.0,"ymin":545.0,"xmax":2684.0,"ymax":916.0},{"id":7,"contenttext":"神樣としてお宮に祀つて居るのであります。","xmin":2630.0,"ymin":949.0,"xmax":2680.0,"ymax":1706.0},{"id":8,"contenttext":"神々のお示しになつた","xmin":2632.0,"ymin":1759.0,"xmax":2676.0,"ymax":2120.0},{"id":9,"contenttext":"この日本國民の理想を實現する、","xmin":2562.0,"ymin":552.0,"xmax":2608.0,"ymax":1109.0},{"id":10,"contenttext":"その道筋が卽ち道であつて、","xmin":2561.0,"ymin":1153.0,"xmax":2605.0,"ymax":1622.0},{"id":11,"contenttext":"皇道とは卽ちこの道である","xmin":2557.0,"ymin":1675.0,"xmax":2605.0,"ymax":2117.0},{"id":12,"contenttext":"のであります。","xmin":2493.0,"ymin":551.0,"xmax":2535.0,"ymax":795.0},{"id":13,"contenttext":"皇は","xmin":2488.0,"ymin":847.0,"xmax":2534.0,"ymax":916.0},{"id":14,"contenttext":"「すべらざ」「すめらぎ」と讀みます。","xmin":2488.0,"ymin":946.0,"xmax":2537.0,"ymax":1586.0},{"id":15,"contenttext":"「すべらぎ」の意味は「統べ","xmin":2486.0,"ymin":1652.0,"xmax":2534.0,"ymax":2111.0},{"id":16,"contenttext":"らるゝ君」であります。","xmin":2413.0,"ymin":546.0,"xmax":2464.0,"ymax":951.0},{"id":17,"contenttext":"我國を統治遊ばす君であります。","xmin":2415.0,"ymin":988.0,"xmax":2462.0,"ymax":1545.0},{"id":18,"contenttext":"古來、我が國の神々は、","xmin":2415.0,"ymin":1594.0,"xmax":2461.0,"ymax":1988.0},{"id":19,"contenttext":"皆この","xmin":2415.0,"ymin":2038.0,"xmax":2457.0,"ymax":2115.0},{"id":20,"contenttext":"すべらぎの大道を體現せられた御方であります。","xmin":2342.0,"ymin":548.0,"xmax":2391.0,"ymax":1389.0},{"id":21,"contenttext":"元來「君」と「神」とは同一の語であり","xmin":2338.0,"ymin":1435.0,"xmax":2388.0,"ymax":2118.0},{"id":22,"contenttext":"ます。","xmin":2271.0,"ymin":543.0,"xmax":2313.0,"ymax":639.0},{"id":23,"contenttext":"だから「すべらぎ」は神であり、","xmin":2263.0,"ymin":663.0,"xmax":2318.0,"ymax":1233.0},{"id":24,"contenttext":"君である。","xmin":2262.0,"ymin":1269.0,"xmax":2314.0,"ymax":1426.0},{"id":25,"contenttext":"依つて「皇道」は「神道」であり、","xmin":2262.0,"ymin":1473.0,"xmax":2313.0,"ymax":2066.0},{"id":26,"contenttext":"神","xmin":2264.0,"ymin":2119.0,"xmax":2310.0,"ymax":2123.0},{"id":27,"contenttext":"道と皇道とは同一のものであります。","xmin":2192.0,"ymin":543.0,"xmax":2241.0,"ymax":1191.0},{"id":28,"contenttext":"1)","xmin":2157.0,"ymin":1638.0,"xmax":2176.0,"ymax":1647.0},{"id":29,"contenttext":"近來王道といふことがよく云はれる。","xmin":2120.0,"ymin":587.0,"xmax":2168.0,"ymax":1225.0},{"id":30,"contenttext":"林羅山先生は「我が朝は神國也。","xmin":2118.0,"ymin":1268.0,"xmax":2165.0,"ymax":1821.0},{"id":31,"contenttext":"神道は乃ち王道","xmin":2116.0,"ymin":1879.0,"xmax":2160.0,"ymax":2118.0},{"id":32,"contenttext":"也。","xmin":2052.0,"ymin":545.0,"xmax":2096.0,"ymax":599.0},{"id":33,"contenttext":"一たび佛法興行してより、","xmin":2049.0,"ymin":637.0,"xmax":2098.0,"ymax":1070.0},{"id":34,"contenttext":"後、","xmin":2049.0,"ymin":1109.0,"xmax":2093.0,"ymax":1157.0},{"id":35,"contenttext":"王道、","xmin":2043.0,"ymin":1189.0,"xmax":2093.0,"ymax":1274.0},{"id":36,"contenttext":"神道都べて振却し去る」(羅山文集)","xmin":2037.0,"ymin":1306.0,"xmax":2094.0,"ymax":1923.0},{"id":37,"contenttext":"と云ひ、","xmin":2045.0,"ymin":1980.0,"xmax":2089.0,"ymax":2076.0},{"id":38,"contenttext":"つまり王道と神道卽ち皇道とを同一のものと考へたのである。","xmin":1969.0,"ymin":551.0,"xmax":2024.0,"ymax":1621.0},{"id":39,"contenttext":"王道は","xmin":1967.0,"ymin":1678.0,"xmax":2015.0,"ymax":1764.0},{"id":40,"contenttext":"「偏なく、","xmin":1967.0,"ymin":1816.0,"xmax":2013.0,"ymax":1943.0},{"id":41,"contenttext":"黨なく、","xmin":1972.0,"ymin":2004.0,"xmax":2010.0,"ymax":2101.0},{"id":42,"contenttext":"ん","xmin":1933.0,"ymin":2086.0,"xmax":1959.0,"ymax":2088.0},{"id":43,"contenttext":"王道蕩々たり、","xmin":1903.0,"ymin":548.0,"xmax":1950.0,"ymax":797.0},{"id":44,"contenttext":"黨なく、","xmin":1903.0,"ymin":824.0,"xmax":1945.0,"ymax":951.0},{"id":45,"contenttext":"偏なく、","xmin":1904.0,"ymin":986.0,"xmax":1945.0,"ymax":1112.0},{"id":46,"contenttext":"王道平々たり」(周書洪範)","xmin":1896.0,"ymin":1164.0,"xmax":1946.0,"ymax":1616.0},{"id":47,"contenttext":"など申して、","xmin":1899.0,"ymin":1666.0,"xmax":1940.0,"ymax":1855.0},{"id":48,"contenttext":"王道は不偏不","xmin":1894.0,"ymin":1919.0,"xmax":1941.0,"ymax":2118.0},{"id":49,"contenttext":"黨、","xmin":1331.0,"ymin":543.0,"xmax":1372.0,"ymax":599.0},{"id":50,"contenttext":"中庸の大道であると云ふのである。","xmin":1318.0,"ymin":620.0,"xmax":1376.0,"ymax":1227.0},{"id":51,"contenttext":"この點が皇道とよく似てゐる。","xmin":1310.0,"ymin":1271.0,"xmax":1365.0,"ymax":1781.0},{"id":52,"contenttext":"けれども王道は德","xmin":1303.0,"ymin":1835.0,"xmax":1356.0,"ymax":2119.0},{"id":53,"contenttext":"を以て基としてゐる。","xmin":1252.0,"ymin":541.0,"xmax":1301.0,"ymax":909.0},{"id":54,"contenttext":"受命といつて德あるものが天の命をうけて天子となる。","xmin":1233.0,"ymin":945.0,"xmax":1297.0,"ymax":1902.0},{"id":55,"contenttext":"これが王道","xmin":1233.0,"ymin":1958.0,"xmax":1279.0,"ymax":2118.0},{"id":56,"contenttext":"思想の根幹である。","xmin":1179.0,"ymin":538.0,"xmax":1229.0,"ymax":865.0},{"id":57,"contenttext":"皇道は萬世一系を根本不動の原則とするのである。","xmin":1163.0,"ymin":902.0,"xmax":1224.0,"ymax":1776.0},{"id":58,"contenttext":"德があるとか、","xmin":1159.0,"ymin":1832.0,"xmax":1209.0,"ymax":2054.0},{"id":59,"contenttext":"な","xmin":1162.0,"ymin":2113.0,"xmax":1201.0,"ymax":2119.0},{"id":60,"contenttext":"いとか云ふ段になると、","xmin":1103.0,"ymin":543.0,"xmax":1155.0,"ymax":951.0},{"id":61,"contenttext":"今德の大なる人が、","xmin":1097.0,"ymin":979.0,"xmax":1150.0,"ymax":1308.0},{"id":62,"contenttext":"天命をうけて天子となつても、","xmin":1088.0,"ymin":1346.0,"xmax":1143.0,"ymax":1854.0},{"id":63,"contenttext":"更に德の大な","xmin":1082.0,"ymin":1912.0,"xmax":1133.0,"ymax":2113.0},{"id":64,"contenttext":"かくめい","xmin":1063.0,"ymin":982.0,"xmax":1093.0,"ymax":1047.0},{"id":65,"contenttext":"るものが出ると、","xmin":1034.0,"ymin":540.0,"xmax":1077.0,"ymax":829.0},{"id":66,"contenttext":"こゝに革命といふことが現はれる。","xmin":1018.0,"ymin":861.0,"xmax":1077.0,"ymax":1457.0},{"id":67,"contenttext":"これは王道と皇道との根本的な相違","xmin":1010.0,"ymin":1510.0,"xmax":1065.0,"ymax":2115.0},{"id":68,"contenttext":"である。","xmin":964.0,"ymin":538.0,"xmax":1003.0,"ymax":666.0},{"id":69,"contenttext":"その他の點に至つては、","xmin":952.0,"ymin":698.0,"xmax":1009.0,"ymax":1100.0},{"id":70,"contenttext":"色々と相類してゐる所が、","xmin":947.0,"ymin":1141.0,"xmax":998.0,"ymax":1581.0},{"id":71,"contenttext":"極めて多いのである。","xmin":940.0,"ymin":1625.0,"xmax":991.0,"ymax":1973.0},{"id":72,"contenttext":"卽ち忠","xmin":939.0,"ymin":2032.0,"xmax":984.0,"ymax":2115.0},{"id":73,"contenttext":"孝仁義の實踐躬行を要としてゐる點などであります。","xmin":875.0,"ymin":535.0,"xmax":936.0,"ymax":1457.0},{"id":74,"contenttext":"道には使命がある。","xmin":811.0,"ymin":573.0,"xmax":861.0,"ymax":899.0},{"id":75,"contenttext":"使命とは、","xmin":806.0,"ymin":936.0,"xmax":856.0,"ymax":1103.0},{"id":76,"contenttext":"その道の精神を徹底せしむることである。","xmin":794.0,"ymin":1140.0,"xmax":851.0,"ymax":1852.0},{"id":77,"contenttext":"今度の事變は","xmin":788.0,"ymin":1907.0,"xmax":841.0,"ymax":2112.0},{"id":78,"contenttext":"に5","xmin":768.0,"ymin":1302.0,"xmax":789.0,"ymax":1316.0},{"id":79,"contenttext":"は","xmin":758.0,"ymin":1898.0,"xmax":785.0,"ymax":1907.0},{"id":80,"contenttext":"蔣介石が三民主義を主張し、","xmin":732.0,"ymin":529.0,"xmax":790.0,"ymax":1016.0},{"id":81,"contenttext":"學校で盛に抗日〓育をやり、","xmin":724.0,"ymin":1056.0,"xmax":781.0,"ymax":1539.0},{"id":82,"contenttext":"三民主義の徹底を圖り、","xmin":717.0,"ymin":1581.0,"xmax":772.0,"ymax":1973.0},{"id":83,"contenttext":"小學生","xmin":712.0,"ymin":2023.0,"xmax":765.0,"ymax":2111.0},{"id":84,"contenttext":"などにも毎朝日本排斥の精神を〓へたり、","xmin":653.0,"ymin":531.0,"xmax":715.0,"ymax":1253.0},{"id":85,"contenttext":"すべて抗日侮日の擧動に出たのが起りである。","xmin":643.0,"ymin":1298.0,"xmax":701.0,"ymax":2088.0},{"id":86,"contenttext":"皇軍の勇戰奮闘によつて、","xmin":587.0,"ymin":529.0,"xmax":644.0,"ymax":984.0},{"id":87,"contenttext":"頑迷なる蔣介石軍を打破り、","xmin":578.0,"ymin":1012.0,"xmax":637.0,"ymax":1494.0},{"id":88,"contenttext":"占領地域も日本の二倍を超えてゐ","xmin":571.0,"ymin":1540.0,"xmax":625.0,"ymax":2105.0},{"id":89,"contenttext":"る。","xmin":529.0,"ymin":532.0,"xmax":563.0,"ymax":577.0},{"id":90,"contenttext":"今や長期建設と云ふ時期となつたのであります。","xmin":506.0,"ymin":605.0,"xmax":570.0,"ymax":1451.0},{"id":91,"contenttext":"長期建設、","xmin":502.0,"ymin":1497.0,"xmax":551.0,"ymax":1647.0},{"id":92,"contenttext":"それには皇道精神を徹底","xmin":495.0,"ymin":1700.0,"xmax":550.0,"ymax":2107.0}]