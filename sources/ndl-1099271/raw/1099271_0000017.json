[{"id":0,"contenttext":"二六","xmin":2768.0,"ymin":1710.0,"xmax":2815.0,"ymax":1793.0},{"id":1,"contenttext":"努力してゐる」と云つたので、","xmin":2698.0,"ymin":562.0,"xmax":2751.0,"ymax":1098.0},{"id":2,"contenttext":"彼の洋〓家は一言もなく赤面したといふことである。","xmin":2692.0,"ymin":1113.0,"xmax":2747.0,"ymax":2047.0},{"id":3,"contenttext":"云ふ譯で、","xmin":2632.0,"ymin":564.0,"xmax":2678.0,"ymax":748.0},{"id":4,"contenttext":"日本は決して西洋の眞似ばかりしてゐるのではありません。","xmin":2623.0,"ymin":760.0,"xmax":2679.0,"ymax":1807.0},{"id":5,"contenttext":"滿洲事變以來盛に","xmin":2618.0,"ymin":1820.0,"xmax":2672.0,"ymax":2144.0},{"id":6,"contenttext":"叫ばれた日本精神、","xmin":2557.0,"ymin":559.0,"xmax":2605.0,"ymax":895.0},{"id":7,"contenttext":"無比の國體、","xmin":2554.0,"ymin":913.0,"xmax":2605.0,"ymax":1145.0},{"id":8,"contenttext":"これ等は、","xmin":2552.0,"ymin":1149.0,"xmax":2601.0,"ymax":1331.0},{"id":9,"contenttext":"實に皇道に由來するもので、","xmin":2552.0,"ymin":1347.0,"xmax":2600.0,"ymax":1852.0},{"id":10,"contenttext":"皇道は日本の創","xmin":2545.0,"ymin":1859.0,"xmax":2597.0,"ymax":2146.0},{"id":11,"contenttext":"造したものであるのであります。","xmin":2482.0,"ymin":558.0,"xmax":2532.0,"ymax":1136.0},{"id":12,"contenttext":"これを實現する爲には、","xmin":2480.0,"ymin":1152.0,"xmax":2529.0,"ymax":1569.0},{"id":13,"contenttext":"神意を奉體することが最も大切","xmin":2477.0,"ymin":1584.0,"xmax":2525.0,"ymax":2144.0},{"id":14,"contenttext":"な次第であります。","xmin":2417.0,"ymin":559.0,"xmax":2461.0,"ymax":893.0},{"id":15,"contenttext":"皇道の使命を達成しまする爲に、","xmin":2332.0,"ymin":592.0,"xmax":2390.0,"ymax":1176.0},{"id":16,"contenttext":"躬行實踐すべき道として、","xmin":2328.0,"ymin":1184.0,"xmax":2385.0,"ymax":1647.0},{"id":17,"contenttext":"更に注意すべきは家族制度","xmin":2326.0,"ymin":1659.0,"xmax":2380.0,"ymax":2142.0},{"id":18,"contenttext":"r","xmin":2301.0,"ymin":1252.0,"xmax":2323.0,"ymax":1280.0},{"id":19,"contenttext":"であります。","xmin":2267.0,"ymin":557.0,"xmax":2310.0,"ymax":775.0},{"id":20,"contenttext":"家族制度は、","xmin":2263.0,"ymin":789.0,"xmax":2312.0,"ymax":1021.0},{"id":21,"contenttext":"伊邪那岐、伊邪那天二柱の神樣が立てられたものであることは、","xmin":2251.0,"ymin":1020.0,"xmax":2312.0,"ymax":2146.0},{"id":22,"contenttext":"皆樣御承知の通りであります。","xmin":2187.0,"ymin":551.0,"xmax":2242.0,"ymax":1092.0},{"id":23,"contenttext":"この制度は、","xmin":2187.0,"ymin":1107.0,"xmax":2236.0,"ymax":1334.0},{"id":24,"contenttext":"小にしては一家、","xmin":2184.0,"ymin":1338.0,"xmax":2234.0,"ymax":1650.0},{"id":25,"contenttext":"大にしては國家となるもの","xmin":2180.0,"ymin":1656.0,"xmax":2230.0,"ymax":2137.0},{"id":26,"contenttext":"であります。","xmin":2121.0,"ymin":555.0,"xmax":2165.0,"ymax":769.0},{"id":27,"contenttext":"一家に於いては親に對する孝が根本になつてくる。","xmin":2109.0,"ymin":799.0,"xmax":2169.0,"ymax":1681.0},{"id":28,"contenttext":"論語に","xmin":2110.0,"ymin":1695.0,"xmax":2157.0,"ymax":1819.0},{"id":29,"contenttext":"「孟懿子問」孝ヲ子","xmin":2103.0,"ymin":1832.0,"xmax":2159.0,"ymax":2136.0},{"id":30,"contenttext":"はん ち","xmin":2082.0,"ymin":827.0,"xmax":2110.0,"ymax":904.0},{"id":31,"contenttext":"曰ハク無ル違フコト。","xmin":2052.0,"ymin":557.0,"xmax":2093.0,"ymax":814.0},{"id":32,"contenttext":"笑遲御ヲ〓子〓〓フ之〓曰曰、孟孫問三孝ニ我〓。","xmin":2039.0,"ymin":826.0,"xmax":2093.0,"ymax":1582.0},{"id":33,"contenttext":"我ル對ニヲ曰ハク無ルト違フ。雙遲曰ハク","xmin":2036.0,"ymin":1598.0,"xmax":2085.0,"ymax":2139.0},{"id":34,"contenttext":"何ノ謂シャ也。","xmin":1979.0,"ymin":552.0,"xmax":2023.0,"ymax":751.0},{"id":35,"contenttext":"子曰ハッ生ケルニハ事ツー之之ニ以シックリック\"ヲタリアック\"","xmin":1970.0,"ymin":765.0,"xmax":2024.0,"ymax":1308.0},{"id":36,"contenttext":"死セルニ、葬〓之之ヲ以マル禮祭ニュニ之ヲ以テスト。。","xmin":1963.0,"ymin":1320.0,"xmax":2019.0,"ymax":2137.0},{"id":37,"contenttext":"ります。","xmin":1903.0,"ymin":550.0,"xmax":1944.0,"ymax":689.0},{"id":38,"contenttext":"卽ち孟懿子が孔子に向つて、","xmin":1894.0,"ymin":702.0,"xmax":1949.0,"ymax":1211.0},{"id":39,"contenttext":"孝行のことを問ふた、","xmin":1892.0,"ymin":1218.0,"xmax":1944.0,"ymax":1608.0},{"id":40,"contenttext":"孔子は違ふなかれと〓へた。","xmin":1886.0,"ymin":1610.0,"xmax":1940.0,"ymax":2113.0},{"id":41,"contenttext":"孔子は孟懿子が更に何か問ふであらうと思つてゐられると、","xmin":1311.0,"ymin":550.0,"xmax":1372.0,"ymax":1606.0},{"id":42,"contenttext":"孟懿子はそのまゝ去つた。","xmin":1307.0,"ymin":1617.0,"xmax":1357.0,"ymax":2081.0},{"id":43,"contenttext":"孔","xmin":1306.0,"ymin":2090.0,"xmax":1350.0,"ymax":2137.0},{"id":44,"contenttext":"子が外に出て、","xmin":1246.0,"ymin":546.0,"xmax":1301.0,"ymax":815.0},{"id":45,"contenttext":"馬車に乘ると、","xmin":1248.0,"ymin":820.0,"xmax":1294.0,"ymax":1084.0},{"id":46,"contenttext":"その弟子の一人樊遲が御者になつてゐた。","xmin":1236.0,"ymin":1101.0,"xmax":1292.0,"ymax":1839.0},{"id":47,"contenttext":"そこで孔子は樊","xmin":1233.0,"ymin":1853.0,"xmax":1280.0,"ymax":2137.0},{"id":48,"contenttext":"遲に、","xmin":1177.0,"ymin":545.0,"xmax":1224.0,"ymax":656.0},{"id":49,"contenttext":"今孟懿子が孝行の事を自分に問ふたので、","xmin":1162.0,"ymin":660.0,"xmax":1224.0,"ymax":1400.0},{"id":50,"contenttext":"違ふ無れと答へたと話した。","xmin":1159.0,"ymin":1413.0,"xmax":1212.0,"ymax":1918.0},{"id":51,"contenttext":"樊通は孟懿","xmin":1153.0,"ymin":1927.0,"xmax":1209.0,"ymax":2136.0},{"id":52,"contenttext":"子より學問がすぐれて居るので、","xmin":1094.0,"ymin":546.0,"xmax":1150.0,"ymax":1123.0},{"id":53,"contenttext":"この意味の十分判らないやうな話を聞いて、","xmin":1086.0,"ymin":1138.0,"xmax":1141.0,"ymax":1923.0},{"id":54,"contenttext":"それで滿足","xmin":1085.0,"ymin":1929.0,"xmax":1131.0,"ymax":2132.0},{"id":55,"contenttext":"P","xmin":1051.0,"ymin":2010.0,"xmax":1075.0,"ymax":2054.0},{"id":56,"contenttext":"しないで、","xmin":1031.0,"ymin":545.0,"xmax":1075.0,"ymax":726.0},{"id":57,"contenttext":"それは何の事ですかと問ふた。","xmin":1019.0,"ymin":741.0,"xmax":1076.0,"ymax":1279.0},{"id":58,"contenttext":"孔子は、","xmin":1019.0,"ymin":1291.0,"xmax":1067.0,"ymax":1441.0},{"id":59,"contenttext":"生きてゐられるときは、","xmin":1015.0,"ymin":1450.0,"xmax":1064.0,"ymax":1881.0},{"id":60,"contenttext":"之れに事へる","xmin":1011.0,"ymin":1886.0,"xmax":1060.0,"ymax":2130.0},{"id":61,"contenttext":"のに禮を以てし、","xmin":953.0,"ymin":543.0,"xmax":1002.0,"ymax":843.0},{"id":62,"contenttext":"亡くなられたら之れを葬るに禮を以てし、","xmin":942.0,"ymin":860.0,"xmax":1001.0,"ymax":1603.0},{"id":63,"contenttext":"之れをお祭りするのに禮を以","xmin":935.0,"ymin":1610.0,"xmax":988.0,"ymax":2132.0},{"id":64,"contenttext":"てするのだと答へた。","xmin":881.0,"ymin":545.0,"xmax":930.0,"ymax":921.0},{"id":65,"contenttext":"孟懿子は魯の大夫の家であつて、","xmin":869.0,"ymin":933.0,"xmax":942.0,"ymax":1512.0},{"id":66,"contenttext":"孟懿子が違ふ無れを、","xmin":864.0,"ymin":1527.0,"xmax":917.0,"ymax":1917.0},{"id":67,"contenttext":"何でも親の","xmin":864.0,"ymin":1927.0,"xmax":913.0,"ymax":2127.0},{"id":68,"contenttext":"云ふ通りにすれば良いと解したのでは間違が出來るから、","xmin":793.0,"ymin":540.0,"xmax":858.0,"ymax":1559.0},{"id":69,"contenttext":"樊遲の質問をよい機會として、","xmin":790.0,"ymin":1566.0,"xmax":842.0,"ymax":2112.0},{"id":70,"contenttext":"子夏が","xmin":713.0,"ymin":1843.0,"xmax":780.0,"ymax":1965.0},{"id":71,"contenttext":"孟懿子を始め、","xmin":733.0,"ymin":535.0,"xmax":782.0,"ymax":804.0},{"id":72,"contenttext":"皆のものの誤解しない樣にさせようとしたのであります。","xmin":716.0,"ymin":811.0,"xmax":779.0,"ymax":1834.0},{"id":73,"contenttext":"孝をたづ","xmin":712.0,"ymin":1963.0,"xmax":762.0,"ymax":2124.0},{"id":74,"contenttext":"ねると孔子は、","xmin":659.0,"ymin":539.0,"xmax":711.0,"ymax":798.0},{"id":75,"contenttext":"「色難\"。","xmin":660.0,"ymin":820.0,"xmax":702.0,"ymax":967.0},{"id":76,"contenttext":"有ショルチ事子服〓其つ勞一、有一酒食","xmin":644.0,"ymin":980.0,"xmax":706.0,"ymax":1574.0},{"id":77,"contenttext":"先生\"僕ス。","xmin":643.0,"ymin":1610.0,"xmax":694.0,"ymax":1803.0},{"id":78,"contenttext":"曾テ是ヲ以テ爲以孝、","xmin":636.0,"ymin":1814.0,"xmax":692.0,"ymax":2122.0},{"id":79,"contenttext":"c.","xmin":619.0,"ymin":1490.0,"xmax":636.0,"ymax":1528.0},{"id":80,"contenttext":"乎」と云ひ、","xmin":584.0,"ymin":535.0,"xmax":635.0,"ymax":758.0},{"id":81,"contenttext":"一言色難しと答へられた。","xmin":581.0,"ymin":784.0,"xmax":631.0,"ymax":1237.0},{"id":82,"contenttext":"これは何時も和やかな色を以てしなければならな","xmin":566.0,"ymin":1247.0,"xmax":626.0,"ymax":2125.0},{"id":83,"contenttext":"い。","xmin":521.0,"ymin":540.0,"xmax":560.0,"ymax":595.0},{"id":84,"contenttext":"何時もニコ〓〓して居れ、","xmin":509.0,"ymin":612.0,"xmax":560.0,"ymax":1074.0},{"id":85,"contenttext":"ふくれ面をするな。","xmin":507.0,"ymin":1089.0,"xmax":555.0,"ymax":1426.0},{"id":86,"contenttext":"事があつたら子弟たるもの先づその勞","xmin":495.0,"ymin":1442.0,"xmax":551.0,"ymax":2125.0}]