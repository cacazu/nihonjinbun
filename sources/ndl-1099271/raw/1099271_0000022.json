[{"id":0,"contenttext":"三六","xmin":2749.0,"ymin":1708.0,"xmax":2795.0,"ymax":1792.0},{"id":1,"contenttext":"之を突破して、","xmin":2676.0,"ymin":1194.0,"xmax":2725.0,"ymax":1466.0},{"id":2,"contenttext":"皇道の使命達成に邁進せねばならな","xmin":2676.0,"ymin":1469.0,"xmax":2727.0,"ymax":2111.0},{"id":3,"contenttext":"が國は、","xmin":2673.0,"ymin":563.0,"xmax":2723.0,"ymax":711.0},{"id":4,"contenttext":"如何なる難局に立つても、","xmin":2676.0,"ymin":721.0,"xmax":2724.0,"ymax":1180.0},{"id":5,"contenttext":"之を突破して、","xmin":2676.0,"ymin":1194.0,"xmax":2725.0,"ymax":1466.0},{"id":6,"contenttext":"皇道の使命達成に邁進せねばならな","xmin":2676.0,"ymin":1469.0,"xmax":2727.0,"ymax":2111.0},{"id":7,"contenttext":"のであります。","xmin":2603.0,"ymin":565.0,"xmax":2646.0,"ymax":822.0},{"id":8,"contenttext":"熊澤蕃山の歌に","xmin":2601.0,"ymin":837.0,"xmax":2649.0,"ymax":1119.0},{"id":9,"contenttext":"っ","xmin":2573.0,"ymin":1114.0,"xmax":2593.0,"ymax":1146.0},{"id":10,"contenttext":"うきことのなほ此の上に積れかし限りある身の力ためさん","xmin":2527.0,"ymin":684.0,"xmax":2575.0,"ymax":1713.0},{"id":11,"contenttext":"と云ふのがあります。我々はこの精神を以て、如何なる國際難局が出來ても之を突破して進","xmin":2456.0,"ymin":565.0,"xmax":2503.0,"ymax":2149.0},{"id":12,"contenttext":"まねばなりません。","xmin":2382.0,"ymin":563.0,"xmax":2429.0,"ymax":901.0},{"id":13,"contenttext":"皇道はかんながらの道で、","xmin":2381.0,"ymin":913.0,"xmax":2430.0,"ymax":1374.0},{"id":14,"contenttext":"かんながらは惟神と書かれます。コレ神、卽","xmin":2384.0,"ymin":1395.0,"xmax":2430.0,"ymax":2149.0},{"id":15,"contenttext":"ち神としての活動がかんながらであります。","xmin":2310.0,"ymin":564.0,"xmax":2357.0,"ymax":1336.0},{"id":16,"contenttext":"前線に戰つてゐられる皇軍將士が、","xmin":2308.0,"ymin":1347.0,"xmax":2359.0,"ymax":1969.0},{"id":17,"contenttext":"一身を捧","xmin":2305.0,"ymin":1987.0,"xmax":2361.0,"ymax":2150.0},{"id":18,"contenttext":"1","xmin":2278.0,"ymin":842.0,"xmax":2296.0,"ymax":885.0},{"id":19,"contenttext":"げて奮闘される樣は、","xmin":2234.0,"ymin":562.0,"xmax":2284.0,"ymax":952.0},{"id":20,"contenttext":"これ神で、","xmin":2237.0,"ymin":955.0,"xmax":2283.0,"ymax":1145.0},{"id":21,"contenttext":"卽ち神であります。","xmin":2236.0,"ymin":1150.0,"xmax":2286.0,"ymax":1496.0},{"id":22,"contenttext":"義務などゝいふ觀念はその間に少し","xmin":2235.0,"ymin":1508.0,"xmax":2285.0,"ymax":2144.0},{"id":23,"contenttext":"もない。","xmin":2164.0,"ymin":565.0,"xmax":2205.0,"ymax":702.0},{"id":24,"contenttext":"「私は私の義務を盡した」といふ風な考は毛頭なく、","xmin":2159.0,"ymin":735.0,"xmax":2212.0,"ymax":1648.0},{"id":25,"contenttext":"敵彈に斃れ命が絕える際に","xmin":2160.0,"ymin":1666.0,"xmax":2211.0,"ymax":2144.0},{"id":26,"contenttext":"も「天皇陛下萬歲」を絕叫して死ぬのであります。","xmin":2089.0,"ymin":567.0,"xmax":2136.0,"ymax":1497.0},{"id":27,"contenttext":"我が國民の身体の中には、","xmin":2088.0,"ymin":1508.0,"xmax":2136.0,"ymax":1972.0},{"id":28,"contenttext":"祖先から","xmin":2091.0,"ymin":1981.0,"xmax":2137.0,"ymax":2147.0},{"id":29,"contenttext":"ちやく〓〓","xmin":2054.0,"ymin":562.0,"xmax":2079.0,"ymax":661.0},{"id":30,"contenttext":"嫡々受けついだ神明が宿られるのである。","xmin":2014.0,"ymin":563.0,"xmax":2067.0,"ymax":1293.0},{"id":31,"contenttext":"されど多くの人は、","xmin":2017.0,"ymin":1317.0,"xmax":2063.0,"ymax":1650.0},{"id":32,"contenttext":"動物である所の肉體に制せ","xmin":2015.0,"ymin":1666.0,"xmax":2065.0,"ymax":2145.0},{"id":33,"contenttext":"られて、","xmin":1940.0,"ymin":562.0,"xmax":1987.0,"ymax":704.0},{"id":34,"contenttext":"その神明をかくしまつりて、","xmin":1943.0,"ymin":720.0,"xmax":1987.0,"ymax":1224.0},{"id":35,"contenttext":"恰も動物であるかの如く行動して居る。","xmin":1942.0,"ymin":1232.0,"xmax":1990.0,"ymax":1930.0},{"id":36,"contenttext":"されど我々","xmin":1943.0,"ymin":1948.0,"xmax":1988.0,"ymax":2142.0},{"id":37,"contenttext":"はその動物性を制御して、","xmin":1871.0,"ymin":564.0,"xmax":1915.0,"ymax":1023.0},{"id":38,"contenttext":"神として活躍せねばならぬ。","xmin":1869.0,"ymin":1032.0,"xmax":1916.0,"ymax":1530.0},{"id":39,"contenttext":"神として活躍すれば、そこに「神","xmin":1871.0,"ymin":1546.0,"xmax":1915.0,"ymax":2147.0},{"id":40,"contenttext":"ながら」が實現する。","xmin":1294.0,"ymin":559.0,"xmax":1341.0,"ymax":935.0},{"id":41,"contenttext":"神そのものゝ活躍である。","xmin":1291.0,"ymin":952.0,"xmax":1343.0,"ymax":1413.0},{"id":42,"contenttext":"此の塲合に動物的利己心などは現れない","xmin":1287.0,"ymin":1425.0,"xmax":1340.0,"ymax":2140.0},{"id":43,"contenttext":"な","xmin":1258.0,"ymin":1632.0,"xmax":1285.0,"ymax":1665.0},{"id":44,"contenttext":"のである。","xmin":1224.0,"ymin":559.0,"xmax":1267.0,"ymax":739.0},{"id":45,"contenttext":"前線の將士が、","xmin":1221.0,"ymin":750.0,"xmax":1268.0,"ymax":1014.0},{"id":46,"contenttext":"一死以て天皇陛下に至誠を致す刹那は、","xmin":1219.0,"ymin":1040.0,"xmax":1268.0,"ymax":1730.0},{"id":47,"contenttext":"既に神であります。","xmin":1219.0,"ymin":1742.0,"xmax":1265.0,"ymax":2086.0},{"id":48,"contenttext":"銃","xmin":1216.0,"ymin":2093.0,"xmax":1267.0,"ymax":2147.0},{"id":49,"contenttext":"後の國民も亦至誠以て神として行動せねばならぬ。","xmin":1148.0,"ymin":559.0,"xmax":1198.0,"ymax":1448.0},{"id":50,"contenttext":"そこが矢張り神ながらである。","xmin":1146.0,"ymin":1466.0,"xmax":1196.0,"ymax":2003.0},{"id":51,"contenttext":"最も恐","xmin":1145.0,"ymin":2017.0,"xmax":1192.0,"ymax":2145.0},{"id":52,"contenttext":"るべきは內から出る墮落の心である。","xmin":1074.0,"ymin":562.0,"xmax":1125.0,"ymax":1211.0},{"id":53,"contenttext":"油斷の心である。","xmin":1069.0,"ymin":1224.0,"xmax":1124.0,"ymax":1530.0},{"id":54,"contenttext":"動物としてのさもしい心である。","xmin":1070.0,"ymin":1545.0,"xmax":1122.0,"ymax":2127.0},{"id":55,"contenttext":"如何に前線の將士が勇敢に働いても、","xmin":1000.0,"ymin":557.0,"xmax":1050.0,"ymax":1216.0},{"id":56,"contenttext":"銃後の國民が弛緩して來てはゆゝしき大事となる。","xmin":996.0,"ymin":1227.0,"xmax":1049.0,"ymax":2123.0},{"id":57,"contenttext":"この難局を突破しまするには、","xmin":928.0,"ymin":562.0,"xmax":977.0,"ymax":1099.0},{"id":58,"contenttext":"動物的では駄目であります。","xmin":924.0,"ymin":1108.0,"xmax":974.0,"ymax":1606.0},{"id":59,"contenttext":"西洋で云ふ「アルプスの上に","xmin":920.0,"ymin":1622.0,"xmax":976.0,"ymax":2142.0},{"id":60,"contenttext":"アルプス」","xmin":854.0,"ymin":559.0,"xmax":904.0,"ymax":749.0},{"id":61,"contenttext":"とも云ふべきこの難局を突破しまするには、","xmin":849.0,"ymin":753.0,"xmax":904.0,"ymax":1537.0},{"id":62,"contenttext":"前線と共に銃後も亦神ながらであ","xmin":849.0,"ymin":1540.0,"xmax":900.0,"ymax":2142.0},{"id":63,"contenttext":"らねばならないのであります。","xmin":783.0,"ymin":559.0,"xmax":828.0,"ymax":1094.0},{"id":64,"contenttext":"我々の先輩は、","xmin":704.0,"ymin":594.0,"xmax":757.0,"ymax":860.0},{"id":65,"contenttext":"かつて東洋の大帝國である支那を討ち、","xmin":701.0,"ymin":871.0,"xmax":755.0,"ymax":1572.0},{"id":66,"contenttext":"西洋の大帝國ロシアを討ちまし","xmin":701.0,"ymin":1584.0,"xmax":751.0,"ymax":2144.0},{"id":67,"contenttext":"た。","xmin":638.0,"ymin":557.0,"xmax":680.0,"ymax":617.0},{"id":68,"contenttext":"是れ皆皇道、","xmin":624.0,"ymin":627.0,"xmax":697.0,"ymax":863.0},{"id":69,"contenttext":"神ながらの大道に基いたが爲であります。","xmin":633.0,"ymin":871.0,"xmax":680.0,"ymax":1609.0},{"id":70,"contenttext":"今や蔣介石を膺懲して東亞新","xmin":623.0,"ymin":1618.0,"xmax":677.0,"ymax":2146.0},{"id":71,"contenttext":"秩序の建設に努力して居るのでありますが、","xmin":558.0,"ymin":554.0,"xmax":609.0,"ymax":1335.0},{"id":72,"contenttext":"蔣介石には後押がついてゐます。","xmin":549.0,"ymin":1340.0,"xmax":604.0,"ymax":1928.0},{"id":73,"contenttext":"仲哀天皇は","xmin":551.0,"ymin":1937.0,"xmax":602.0,"ymax":2145.0},{"id":74,"contenttext":"熊襲を征せられたのでありますが、","xmin":484.0,"ymin":553.0,"xmax":535.0,"ymax":1170.0},{"id":75,"contenttext":"熊襲には新羅といふ後押があつた。","xmin":477.0,"ymin":1184.0,"xmax":531.0,"ymax":1810.0},{"id":76,"contenttext":"そこで神功皇后は","xmin":478.0,"ymin":1822.0,"xmax":527.0,"ymax":2146.0}]