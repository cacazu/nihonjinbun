[{"id":1,"contenttext":"{","xmin":2788.0,"ymin":1004.0,"xmax":2811.0,"ymax":1034.0},{"id":2,"contenttext":"皇道と申すことは近來頻に申されまするので、","xmin":2746.0,"ymin":610.0,"xmax":2801.0,"ymax":1415.0},{"id":3,"contenttext":"諸君には既にその內容については、","xmin":2734.0,"ymin":1449.0,"xmax":2790.0,"ymax":2046.0},{"id":4,"contenttext":"御承","xmin":2734.0,"ymin":2090.0,"xmax":2778.0,"ymax":2147.0},{"id":5,"contenttext":"知の事とは存じますが、","xmin":2674.0,"ymin":566.0,"xmax":2729.0,"ymax":979.0},{"id":6,"contenttext":"先づ順序として、","xmin":2674.0,"ymin":1008.0,"xmax":2722.0,"ymax":1302.0},{"id":7,"contenttext":"御參考までに聊か私の考ふる所を申上ます。","xmin":2660.0,"ymin":1323.0,"xmax":2717.0,"ymax":2088.0},{"id":8,"contenttext":"体人間は何の爲に生活してゐるか、","xmin":2595.0,"ymin":566.0,"xmax":2655.0,"ymax":1181.0},{"id":9,"contenttext":"先づ第一にこの事を反省して見たいと思ひます。","xmin":2585.0,"ymin":1203.0,"xmax":2646.0,"ymax":2045.0},{"id":10,"contenttext":"論語","xmin":2583.0,"ymin":2086.0,"xmax":2632.0,"ymax":2145.0},{"id":11,"contenttext":"には、","xmin":2532.0,"ymin":568.0,"xmax":2576.0,"ymax":660.0},{"id":12,"contenttext":"曾子は日に三度吾が身を省ると申してありますが、","xmin":2519.0,"ymin":687.0,"xmax":2579.0,"ymax":1566.0},{"id":13,"contenttext":"なか〓〓そういふことは、","xmin":2511.0,"ymin":1605.0,"xmax":2562.0,"ymax":2041.0},{"id":14,"contenttext":"多く","xmin":2510.0,"ymin":2087.0,"xmax":2552.0,"ymax":2137.0},{"id":15,"contenttext":"の人はしないと考へるのであります。","xmin":2452.0,"ymin":568.0,"xmax":2506.0,"ymax":1216.0},{"id":16,"contenttext":"併し自ら省みなくとも人の爲る事は、","xmin":2443.0,"ymin":1239.0,"xmax":2496.0,"ymax":1883.0},{"id":17,"contenttext":"大體道理にか","xmin":2434.0,"ymin":1923.0,"xmax":2488.0,"ymax":2139.0},{"id":18,"contenttext":"なつた行動をしてゐる。","xmin":2386.0,"ymin":565.0,"xmax":2434.0,"ymax":972.0},{"id":19,"contenttext":"若し沒道理の行動をする人がありましたなら、","xmin":2371.0,"ymin":1000.0,"xmax":2429.0,"ymax":1810.0},{"id":20,"contenttext":"それは狂人か何か","xmin":2362.0,"ymin":1839.0,"xmax":2416.0,"ymax":2137.0},{"id":21,"contenttext":"であります。","xmin":2313.0,"ymin":565.0,"xmax":2354.0,"ymax":772.0},{"id":22,"contenttext":"卽ち自分のする事は皆意識して、","xmin":2303.0,"ymin":797.0,"xmax":2355.0,"ymax":1367.0},{"id":23,"contenttext":"すべきことを爲てゐる、","xmin":2296.0,"ymin":1401.0,"xmax":2346.0,"ymax":1808.0},{"id":24,"contenttext":"考へてしてゐるの","xmin":2293.0,"ymin":1839.0,"xmax":2340.0,"ymax":2139.0},{"id":25,"contenttext":"であります。","xmin":2238.0,"ymin":563.0,"xmax":2283.0,"ymax":775.0},{"id":26,"contenttext":"手紙を出すにしても、","xmin":2237.0,"ymin":800.0,"xmax":2283.0,"ymax":1165.0},{"id":27,"contenttext":"郵便局へ持つて行つてポストに入れるといふ事は、","xmin":2218.0,"ymin":1201.0,"xmax":2281.0,"ymax":2081.0},{"id":28,"contenttext":"卽","xmin":2218.0,"ymin":2118.0,"xmax":2262.0,"ymax":2137.0},{"id":29,"contenttext":"ち意識して行動してゐるのであります。けれども動物は殆んど無自覺的に行動してゐる、動","xmin":2144.0,"ymin":559.0,"xmax":2217.0,"ymax":2137.0},{"id":30,"contenttext":"物は殆んど考といふものがない。","xmin":2090.0,"ymin":558.0,"xmax":2142.0,"ymax":1125.0},{"id":31,"contenttext":"考があつても理想といふものがない。","xmin":2078.0,"ymin":1156.0,"xmax":2134.0,"ymax":1796.0},{"id":32,"contenttext":"理想とは\"かうあ","xmin":2073.0,"ymin":1837.0,"xmax":2122.0,"ymax":2130.0},{"id":33,"contenttext":"るべきである","xmin":2023.0,"ymin":560.0,"xmax":2066.0,"ymax":820.0},{"id":34,"contenttext":"\"かうなくてはならぬといふ考へであります。","xmin":2007.0,"ymin":841.0,"xmax":2064.0,"ymax":1676.0},{"id":35,"contenttext":"たとへば字を書く、","xmin":2000.0,"ymin":1718.0,"xmax":2052.0,"ymax":2035.0},{"id":36,"contenttext":"〓を","xmin":1998.0,"ymin":2075.0,"xmax":2045.0,"ymax":2132.0},{"id":37,"contenttext":"ち","xmin":1981.0,"ymin":833.0,"xmax":2007.0,"ymax":867.0},{"id":38,"contenttext":"描く、","xmin":1949.0,"ymin":556.0,"xmax":1991.0,"ymax":643.0},{"id":39,"contenttext":"かういふ風に書きたい、","xmin":1944.0,"ymin":677.0,"xmax":1991.0,"ymax":1081.0},{"id":40,"contenttext":"もつとうまく描きたい、","xmin":1937.0,"ymin":1115.0,"xmax":1983.0,"ymax":1515.0},{"id":41,"contenttext":"これが理想であります。","xmin":1926.0,"ymin":1557.0,"xmax":1983.0,"ymax":1954.0},{"id":42,"contenttext":"動物は全","xmin":1922.0,"ymin":1993.0,"xmax":1975.0,"ymax":2133.0},{"id":43,"contenttext":"然、無自覺、","xmin":1385.0,"ymin":558.0,"xmax":1430.0,"ymax":775.0},{"id":44,"contenttext":"無意識とは云へないかも知れませんが、","xmin":1374.0,"ymin":795.0,"xmax":1429.0,"ymax":1483.0},{"id":45,"contenttext":"少くとも理想と云ふものがありませ","xmin":1369.0,"ymin":1520.0,"xmax":1420.0,"ymax":2137.0},{"id":46,"contenttext":"성","xmin":1314.0,"ymin":558.0,"xmax":1357.0,"ymax":610.0},{"id":47,"contenttext":"犬が餌を拾ふ。","xmin":1309.0,"ymin":634.0,"xmax":1358.0,"ymax":887.0},{"id":48,"contenttext":"どうも不味かつた、","xmin":1302.0,"ymin":917.0,"xmax":1360.0,"ymax":1244.0},{"id":49,"contenttext":"この次にはもつと美味いものを拾ひたい。","xmin":1299.0,"ymin":1282.0,"xmax":1351.0,"ymax":1994.0},{"id":50,"contenttext":"どうや","xmin":1301.0,"ymin":2041.0,"xmax":1340.0,"ymax":2135.0},{"id":51,"contenttext":"つたらおいしいものを求められるか、","xmin":1233.0,"ymin":561.0,"xmax":1289.0,"ymax":1203.0},{"id":52,"contenttext":"又はおいしいものを造ることが出來るか、","xmin":1225.0,"ymin":1237.0,"xmax":1279.0,"ymax":1961.0},{"id":53,"contenttext":"犬にはそ","xmin":1224.0,"ymin":1999.0,"xmax":1272.0,"ymax":2135.0},{"id":54,"contenttext":"あ.","xmin":1201.0,"ymin":914.0,"xmax":1228.0,"ymax":950.0},{"id":55,"contenttext":"んな考がない。","xmin":1167.0,"ymin":556.0,"xmax":1213.0,"ymax":806.0},{"id":56,"contenttext":"行き當り次第に食べてそれですましてゐる。","xmin":1154.0,"ymin":835.0,"xmax":1210.0,"ymax":1600.0},{"id":57,"contenttext":"ところが人間には理想が伴ふ","xmin":1149.0,"ymin":1643.0,"xmax":1200.0,"ymax":2135.0},{"id":58,"contenttext":"からして、","xmin":1096.0,"ymin":558.0,"xmax":1138.0,"ymax":726.0},{"id":59,"contenttext":"同じ食べるにしても、","xmin":1089.0,"ymin":752.0,"xmax":1138.0,"ymax":1121.0},{"id":60,"contenttext":"もつと榮養に富めるものを食べたい、","xmin":1079.0,"ymin":1159.0,"xmax":1133.0,"ymax":1801.0},{"id":61,"contenttext":"もつと理想的なも","xmin":1077.0,"ymin":1840.0,"xmax":1124.0,"ymax":2135.0},{"id":62,"contenttext":"のが食べたいと考へる。","xmin":1016.0,"ymin":554.0,"xmax":1067.0,"ymax":964.0},{"id":63,"contenttext":"勿論夢中で食べる人もある。","xmin":1010.0,"ymin":993.0,"xmax":1060.0,"ymax":1474.0},{"id":64,"contenttext":"何の爲に食べるのか考へない人もあ","xmin":1002.0,"ymin":1514.0,"xmax":1055.0,"ymax":2134.0},{"id":65,"contenttext":"る。","xmin":953.0,"ymin":558.0,"xmax":985.0,"ymax":600.0},{"id":66,"contenttext":"徒らに飽食煖衣で逸居して居るものもある。","xmin":934.0,"ymin":630.0,"xmax":992.0,"ymax":1400.0},{"id":67,"contenttext":"そこでソクラテスは、","xmin":932.0,"ymin":1437.0,"xmax":977.0,"ymax":1795.0},{"id":68,"contenttext":"食はむが爲に生き","xmin":925.0,"ymin":1839.0,"xmax":978.0,"ymax":2136.0},{"id":69,"contenttext":"じ","xmin":899.0,"ymin":1640.0,"xmax":921.0,"ymax":1658.0},{"id":70,"contenttext":"るのではなく、","xmin":870.0,"ymin":553.0,"xmax":918.0,"ymax":802.0},{"id":71,"contenttext":"生きる爲に食ふのであると云つて、","xmin":863.0,"ymin":831.0,"xmax":917.0,"ymax":1442.0},{"id":72,"contenttext":"一世を警醒した。","xmin":860.0,"ymin":1487.0,"xmax":906.0,"ymax":1755.0},{"id":73,"contenttext":"日本には胃病のもの","xmin":853.0,"ymin":1799.0,"xmax":905.0,"ymax":2132.0},{"id":74,"contenttext":"が多いと云ふが、","xmin":794.0,"ymin":549.0,"xmax":847.0,"ymax":843.0},{"id":75,"contenttext":"それは大抵この道理のわからない人と思ふ。","xmin":784.0,"ymin":870.0,"xmax":843.0,"ymax":1640.0},{"id":76,"contenttext":"卽ち食ふのは生きるのが目","xmin":777.0,"ymin":1673.0,"xmax":835.0,"ymax":2134.0},{"id":77,"contenttext":"的である。","xmin":726.0,"ymin":550.0,"xmax":770.0,"ymax":721.0},{"id":78,"contenttext":"しからばよく生きる爲にはどんなものを食べればよいか、","xmin":710.0,"ymin":749.0,"xmax":769.0,"ymax":1751.0},{"id":79,"contenttext":"どんなものを食べる","xmin":707.0,"ymin":1795.0,"xmax":753.0,"ymax":2128.0},{"id":80,"contenttext":"とよく生きるかを考へねばならぬのであります。","xmin":642.0,"ymin":553.0,"xmax":697.0,"ymax":1398.0},{"id":81,"contenttext":"ウドン一杯は牛乳一合以上の榮養價値が","xmin":635.0,"ymin":1431.0,"xmax":686.0,"ymax":2130.0},{"id":82,"contenttext":"あると研究さるれば、","xmin":573.0,"ymin":549.0,"xmax":628.0,"ymax":926.0},{"id":83,"contenttext":"牛乳のかはりにウドンを食べる。","xmin":569.0,"ymin":946.0,"xmax":620.0,"ymax":1513.0},{"id":84,"contenttext":"牛乳はバターにして海外に輸出せ","xmin":558.0,"ymin":1550.0,"xmax":613.0,"ymax":2130.0},{"id":85,"contenttext":"三","xmin":495.0,"ymin":1753.0,"xmax":534.0,"ymax":1772.0}]