[{"id":0,"contenttext":"三〇","xmin":2763.0,"ymin":1713.0,"xmax":2803.0,"ymax":1794.0},{"id":1,"contenttext":"15","xmin":2720.0,"ymin":762.0,"xmax":2747.0,"ymax":809.0},{"id":2,"contenttext":"ご、","xmin":2691.0,"ymin":572.0,"xmax":2724.0,"ymax":634.0},{"id":3,"contenttext":"重盛は睨みつけて、","xmin":2685.0,"ymin":643.0,"xmax":2730.0,"ymax":984.0},{"id":4,"contenttext":"お前は何の爲に武裝してゐるか、","xmin":2688.0,"ymin":1005.0,"xmax":2733.0,"ymax":1573.0},{"id":5,"contenttext":"敵はどこに居るか。","xmin":2686.0,"ymin":1591.0,"xmax":2734.0,"ymax":1932.0},{"id":6,"contenttext":"吾は大臣大","xmin":2686.0,"ymin":1946.0,"xmax":2734.0,"ymax":2149.0},{"id":7,"contenttext":"將である。","xmin":2615.0,"ymin":565.0,"xmax":2659.0,"ymax":746.0},{"id":8,"contenttext":"賊があつて宮闘を侵す塲合の外、","xmin":2613.0,"ymin":759.0,"xmax":2661.0,"ymax":1343.0},{"id":9,"contenttext":"敢へて武裝しないのであると、","xmin":2615.0,"ymin":1351.0,"xmax":2661.0,"ymax":1889.0},{"id":10,"contenttext":"いたく宗盛ら","xmin":2617.0,"ymin":1910.0,"xmax":2661.0,"ymax":2149.0},{"id":11,"contenttext":"を叱りつけて屋内に進んだ。","xmin":2538.0,"ymin":565.0,"xmax":2587.0,"ymax":1063.0},{"id":12,"contenttext":"〓盛は遙かに重盛を見て、あわてゝ法衣を鎧の上からまとひ、","xmin":2540.0,"ymin":1078.0,"xmax":2588.0,"ymax":2150.0},{"id":13,"contenttext":"頻に鎧をかくさうとした。","xmin":2466.0,"ymin":565.0,"xmax":2510.0,"ymax":1019.0},{"id":14,"contenttext":"重盛は〓盛に向つて、","xmin":2467.0,"ymin":1037.0,"xmax":2513.0,"ymax":1424.0},{"id":15,"contenttext":"私は尊貌を拜見しまするに、","xmin":2467.0,"ymin":1428.0,"xmax":2516.0,"ymax":1935.0},{"id":16,"contenttext":"家運がもは","xmin":2469.0,"ymin":1946.0,"xmax":2513.0,"ymax":2149.0},{"id":17,"contenttext":"や傾きかけてゐる樣に思はれます。","xmin":2396.0,"ymin":565.0,"xmax":2442.0,"ymax":1182.0},{"id":18,"contenttext":"私は世に四恩といふものがあり、","xmin":2396.0,"ymin":1193.0,"xmax":2442.0,"ymax":1776.0},{"id":19,"contenttext":"就中皇室の恩が最も","xmin":2398.0,"ymin":1786.0,"xmax":2442.0,"ymax":2149.0},{"id":20,"contenttext":"重いと聞いて居ります。","xmin":2322.0,"ymin":564.0,"xmax":2367.0,"ymax":984.0},{"id":21,"contenttext":"今平家一門は、","xmin":2320.0,"ymin":993.0,"xmax":2369.0,"ymax":1262.0},{"id":22,"contenttext":"たとひ聊か功績があつたと致しましても、","xmin":2323.0,"ymin":1274.0,"xmax":2369.0,"ymax":2008.0},{"id":23,"contenttext":"日本の","xmin":2325.0,"ymin":2029.0,"xmax":2367.0,"ymax":2147.0},{"id":24,"contenttext":"の を","xmin":2288.0,"ymin":1273.0,"xmax":2313.0,"ymax":1318.0},{"id":25,"contenttext":"半を領有して、","xmin":2249.0,"ymin":564.0,"xmax":2293.0,"ymax":829.0},{"id":26,"contenttext":"大人は太政大臣の榮位に陞り、","xmin":2248.0,"ymin":836.0,"xmax":2302.0,"ymax":1376.0},{"id":27,"contenttext":"兒の不肖を以てして、","xmin":2252.0,"ymin":1388.0,"xmax":2296.0,"ymax":1771.0},{"id":28,"contenttext":"且つ大臣大將を辱う","xmin":2250.0,"ymin":1785.0,"xmax":2299.0,"ymax":2145.0},{"id":29,"contenttext":"む","xmin":2213.0,"ymin":1776.0,"xmax":2239.0,"ymax":1843.0},{"id":30,"contenttext":"し、","xmin":2181.0,"ymin":564.0,"xmax":2216.0,"ymax":624.0},{"id":31,"contenttext":"宗族皆榮爵を辱うしてゐるのであります。","xmin":2171.0,"ymin":640.0,"xmax":2222.0,"ymax":1377.0},{"id":32,"contenttext":"これ全く皇室の御恩を蒙ることの極めて大","xmin":2172.0,"ymin":1393.0,"xmax":2222.0,"ymax":2147.0},{"id":33,"contenttext":"さ","xmin":2137.0,"ymin":1033.0,"xmax":2163.0,"ymax":1082.0},{"id":34,"contenttext":"ざんじん","xmin":2135.0,"ymin":1111.0,"xmax":2164.0,"ymax":1202.0},{"id":35,"contenttext":"なるものであります。","xmin":2099.0,"ymin":562.0,"xmax":2140.0,"ymax":941.0},{"id":36,"contenttext":"今、","xmin":2101.0,"ymin":954.0,"xmax":2144.0,"ymax":1028.0},{"id":37,"contenttext":"已に讒人は捕へられたのであります。","xmin":2098.0,"ymin":1035.0,"xmax":2145.0,"ymax":1691.0},{"id":38,"contenttext":"何を苦しんでこんなこと","xmin":2099.0,"ymin":1707.0,"xmax":2144.0,"ymax":2144.0},{"id":39,"contenttext":"をなされるのでありますか。","xmin":2024.0,"ymin":562.0,"xmax":2073.0,"ymax":1060.0},{"id":40,"contenttext":"若し御志を遂げようとなさるならば、","xmin":2025.0,"ymin":1071.0,"xmax":2072.0,"ymax":1733.0},{"id":41,"contenttext":"先づ重盛の首を刎ねて","xmin":2022.0,"ymin":1742.0,"xmax":2081.0,"ymax":2146.0},{"id":42,"contenttext":"それからにせられたいと、","xmin":1951.0,"ymin":562.0,"xmax":1997.0,"ymax":1018.0},{"id":43,"contenttext":"懇々と諫めたのであります。","xmin":1954.0,"ymin":1033.0,"xmax":1998.0,"ymax":1531.0},{"id":44,"contenttext":"〓盛は、","xmin":1954.0,"ymin":1546.0,"xmax":1998.0,"ymax":1699.0},{"id":45,"contenttext":"淨海","xmin":1950.0,"ymin":1699.0,"xmax":2001.0,"ymax":1792.0},{"id":46,"contenttext":"(〓盛の法名)","xmin":1951.0,"ymin":1802.0,"xmax":1997.0,"ymax":2049.0},{"id":47,"contenttext":"衰老","xmin":1951.0,"ymin":2061.0,"xmax":2001.0,"ymax":2149.0},{"id":48,"contenttext":"ちやくし","xmin":1917.0,"ymin":1940.0,"xmax":1944.0,"ymax":2030.0},{"id":49,"contenttext":"の身を以て此の擧をなすは、","xmin":1878.0,"ymin":562.0,"xmax":1928.0,"ymax":1063.0},{"id":50,"contenttext":"我が一門を慮るのみである。","xmin":1880.0,"ymin":1071.0,"xmax":1925.0,"ymax":1570.0},{"id":51,"contenttext":"然るに汝は我が家の嫡子、","xmin":1879.0,"ymin":1581.0,"xmax":1928.0,"ymax":2045.0},{"id":52,"contenttext":"而し","xmin":1882.0,"ymin":2061.0,"xmax":1925.0,"ymax":2144.0},{"id":53,"contenttext":"て汝がさういふ考なら、","xmin":1309.0,"ymin":560.0,"xmax":1357.0,"ymax":971.0},{"id":54,"contenttext":"萬事は汝に任すから宜敷く處置をせよと云つて、","xmin":1309.0,"ymin":986.0,"xmax":1357.0,"ymax":1850.0},{"id":55,"contenttext":"そのまゝ奧へ引","xmin":1309.0,"ymin":1858.0,"xmax":1355.0,"ymax":2144.0},{"id":56,"contenttext":"込んでしまつた。","xmin":1233.0,"ymin":554.0,"xmax":1282.0,"ymax":855.0},{"id":57,"contenttext":"重盛はこの時忠ならんと欲すれば孝ならず、","xmin":1233.0,"ymin":869.0,"xmax":1284.0,"ymax":1645.0},{"id":58,"contenttext":"孝ならんと欲すれば忠なら","xmin":1231.0,"ymin":1660.0,"xmax":1286.0,"ymax":2144.0},{"id":59,"contenttext":"す、","xmin":1167.0,"ymin":554.0,"xmax":1206.0,"ymax":614.0},{"id":60,"contenttext":"重盛が進退こゝに窮まれりと云つたといふが、","xmin":1162.0,"ymin":633.0,"xmax":1209.0,"ymax":1455.0},{"id":61,"contenttext":"果してさう云つたかどうかは、","xmin":1162.0,"ymin":1459.0,"xmax":1209.0,"ymax":2010.0},{"id":62,"contenttext":"歷史家","xmin":1162.0,"ymin":2019.0,"xmax":1207.0,"ymax":2142.0},{"id":63,"contenttext":"そむ","xmin":1124.0,"ymin":1266.0,"xmax":1153.0,"ymax":1318.0},{"id":64,"contenttext":"の問題ですが、","xmin":1087.0,"ymin":554.0,"xmax":1136.0,"ymax":819.0},{"id":65,"contenttext":"こゝで重盛が父の意志に背いて、","xmin":1089.0,"ymin":827.0,"xmax":1136.0,"ymax":1414.0},{"id":66,"contenttext":"不孝をしたかの如く思はれる。","xmin":1085.0,"ymin":1422.0,"xmax":1137.0,"ymax":1961.0},{"id":67,"contenttext":"併しこゝ","xmin":1089.0,"ymin":1975.0,"xmax":1133.0,"ymax":2135.0},{"id":68,"contenttext":"は能く考へねばならぬ。","xmin":1011.0,"ymin":555.0,"xmax":1061.0,"ymax":969.0},{"id":69,"contenttext":"〓盛の1、","xmin":1012.0,"ymin":987.0,"xmax":1060.0,"ymax":1176.0},{"id":70,"contenttext":"貞盛は、","xmin":1012.0,"ymin":1181.0,"xmax":1060.0,"ymax":1333.0},{"id":71,"contenttext":"皇室に忠にして、","xmin":1012.0,"ymin":1340.0,"xmax":1060.0,"ymax":1645.0},{"id":72,"contenttext":"逆賊平將門を征し、","xmin":1011.0,"ymin":1658.0,"xmax":1060.0,"ymax":2010.0},{"id":73,"contenttext":"鎭守府","xmin":1011.0,"ymin":2015.0,"xmax":1060.0,"ymax":2144.0},{"id":74,"contenttext":"し","xmin":978.0,"ymin":1384.0,"xmax":1001.0,"ymax":1413.0},{"id":75,"contenttext":"はん","xmin":975.0,"ymin":1742.0,"xmax":1004.0,"ymax":1794.0},{"id":76,"contenttext":"將軍に任ぜられ、","xmin":935.0,"ymin":551.0,"xmax":987.0,"ymax":860.0},{"id":77,"contenttext":"その子係正盛詔を受けて追討使となり、","xmin":935.0,"ymin":865.0,"xmax":989.0,"ymax":1564.0},{"id":78,"contenttext":"源義親の叛を平げ、","xmin":935.0,"ymin":1579.0,"xmax":986.0,"ymax":1928.0},{"id":79,"contenttext":"その子忠盛","xmin":934.0,"ymin":1936.0,"xmax":982.0,"ymax":2144.0},{"id":80,"contenttext":"は、","xmin":867.0,"ymin":552.0,"xmax":911.0,"ymax":621.0},{"id":81,"contenttext":"卽ち〓盛の父で、","xmin":867.0,"ymin":626.0,"xmax":912.0,"ymax":935.0},{"id":82,"contenttext":"白河、","xmin":867.0,"ymin":944.0,"xmax":912.0,"ymax":1054.0},{"id":83,"contenttext":"鳥羽二上皇に仕へ奉り、","xmin":865.0,"ymin":1062.0,"xmax":912.0,"ymax":1482.0},{"id":84,"contenttext":"忠誠を致したのであるが、","xmin":867.0,"ymin":1498.0,"xmax":912.0,"ymax":1960.0},{"id":85,"contenttext":"殊に鳥羽","xmin":862.0,"ymin":1976.0,"xmax":913.0,"ymax":2142.0},{"id":86,"contenttext":"上皇は、","xmin":791.0,"ymin":552.0,"xmax":838.0,"ymax":694.0},{"id":87,"contenttext":"「忠盛意を用うることまことに苦しめり。","xmin":791.0,"ymin":718.0,"xmax":838.0,"ymax":1435.0},{"id":88,"contenttext":"死を以て君を衞る」と宣ふたのである。","xmin":791.0,"ymin":1452.0,"xmax":838.0,"ymax":2128.0},{"id":89,"contenttext":"かゝる忠誠の精神は〓盛の父忠盛の意志である。","xmin":719.0,"ymin":554.0,"xmax":765.0,"ymax":1406.0},{"id":90,"contenttext":"〓盛亦之れを繼いで居るのである。","xmin":717.0,"ymin":1418.0,"xmax":765.0,"ymax":2042.0},{"id":91,"contenttext":"唯、","xmin":717.0,"ymin":2054.0,"xmax":761.0,"ymax":2127.0},{"id":92,"contenttext":"ふん","xmin":682.0,"ymin":667.0,"xmax":711.0,"ymax":719.0},{"id":93,"contenttext":"ね","xmin":683.0,"ymin":715.0,"xmax":709.0,"ymax":743.0},{"id":94,"contenttext":"か","xmin":683.0,"ymin":872.0,"xmax":711.0,"ymax":901.0},{"id":95,"contenttext":"一時の忿怒の情に驅られて、","xmin":643.0,"ymin":560.0,"xmax":692.0,"ymax":1057.0},{"id":96,"contenttext":"この擧に出でんとしたのである。","xmin":643.0,"ymin":1064.0,"xmax":707.0,"ymax":1645.0},{"id":97,"contenttext":"重盛は祖先の意志をつぎ、","xmin":641.0,"ymin":1659.0,"xmax":692.0,"ymax":2123.0},{"id":98,"contenttext":"皇室に忠誠を致し、","xmin":565.0,"ymin":548.0,"xmax":617.0,"ymax":895.0},{"id":99,"contenttext":"又、","xmin":568.0,"ymin":901.0,"xmax":616.0,"ymax":975.0},{"id":100,"contenttext":"父をして一旦の怒の爲に大逆に陷らしめなかつたのは孝を全うし","xmin":568.0,"ymin":981.0,"xmax":616.0,"ymax":2138.0},{"id":101,"contenttext":"たのである。","xmin":496.0,"ymin":550.0,"xmax":543.0,"ymax":768.0},{"id":102,"contenttext":"卽ち忠孝を全うしたのであります。","xmin":493.0,"ymin":784.0,"xmax":543.0,"ymax":1404.0},{"id":103,"contenttext":"かくて祖先の志をつぐことは、","xmin":493.0,"ymin":1420.0,"xmax":543.0,"ymax":1959.0},{"id":104,"contenttext":"卽ち忠で","xmin":493.0,"ymin":1975.0,"xmax":539.0,"ymax":2138.0}]