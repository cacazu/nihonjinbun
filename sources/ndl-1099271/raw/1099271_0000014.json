[{"id":1,"contenttext":"ゐくく","xmin":2728.0,"ymin":1844.0,"xmax":2754.0,"ymax":1917.0},{"id":2,"contenttext":"するのであります。","xmin":2700.0,"ymin":587.0,"xmax":2744.0,"ymax":914.0},{"id":3,"contenttext":"此の爲に神社參拜が大切になるのであります。","xmin":2691.0,"ymin":944.0,"xmax":2744.0,"ymax":1742.0},{"id":4,"contenttext":"唯々區々たる一身を守","xmin":2687.0,"ymin":1791.0,"xmax":2735.0,"ymax":2161.0},{"id":5,"contenttext":"つていたゞいて、","xmin":2627.0,"ymin":590.0,"xmax":2669.0,"ymax":878.0},{"id":6,"contenttext":"一己の利益幸福を祈るといふ風なものではないのであります。","xmin":2612.0,"ymin":916.0,"xmax":2671.0,"ymax":1981.0},{"id":7,"contenttext":"目に見えぬ神の心に通ふこそ人の心のまことなりけれ","xmin":2545.0,"ymin":704.0,"xmax":2599.0,"ymax":1642.0},{"id":8,"contenttext":"明治天皇は御製にかく仰せられてあります。","xmin":2471.0,"ymin":581.0,"xmax":2526.0,"ymax":1343.0},{"id":9,"contenttext":"目に見えぬ神を拜む、","xmin":2467.0,"ymin":1383.0,"xmax":2519.0,"ymax":1747.0},{"id":10,"contenttext":"その心が誠の心なので","xmin":2461.0,"ymin":1784.0,"xmax":2515.0,"ymax":2156.0},{"id":11,"contenttext":"あります。","xmin":2405.0,"ymin":583.0,"xmax":2444.0,"ymax":750.0},{"id":12,"contenttext":"神前にはよく鏡が置かれてある。","xmin":2396.0,"ymin":780.0,"xmax":2448.0,"ymax":1343.0},{"id":13,"contenttext":"鏡を以て御神體とせられてゐる所も多いので","xmin":2390.0,"ymin":1385.0,"xmax":2442.0,"ymax":2156.0},{"id":14,"contenttext":"あります。","xmin":2332.0,"ymin":581.0,"xmax":2374.0,"ymax":750.0},{"id":15,"contenttext":"伊勢の皇大神宮の御神體は神鏡でありますことは、申すも畏き極みであります。","xmin":2317.0,"ymin":779.0,"xmax":2376.0,"ymax":2154.0},{"id":16,"contenttext":"3)","xmin":2288.0,"ymin":1827.0,"xmax":2308.0,"ymax":1837.0},{"id":17,"contenttext":"鏡は至誠を表現してゐます。","xmin":2254.0,"ymin":578.0,"xmax":2303.0,"ymax":1063.0},{"id":18,"contenttext":"鏡には僞がありません。","xmin":2249.0,"ymin":1100.0,"xmax":2298.0,"ymax":1501.0},{"id":19,"contenttext":"人間の目は誠を映すことが出來ない","xmin":2244.0,"ymin":1544.0,"xmax":2295.0,"ymax":2147.0},{"id":20,"contenttext":"塲合が多いのでありますが、","xmin":2181.0,"ymin":578.0,"xmax":2233.0,"ymax":1072.0},{"id":21,"contenttext":"鏡はそのまゝを映します。","xmin":2178.0,"ymin":1100.0,"xmax":2227.0,"ymax":1538.0},{"id":22,"contenttext":"卽ち誠をうつすのであります。","xmin":2176.0,"ymin":1581.0,"xmax":2222.0,"ymax":2096.0},{"id":23,"contenttext":"處","xmin":2171.0,"ymin":2146.0,"xmax":2220.0,"ymax":2154.0},{"id":24,"contenttext":"が若し人間が至誠となりますれば、","xmin":2104.0,"ymin":578.0,"xmax":2163.0,"ymax":1186.0},{"id":25,"contenttext":"神様の鏡と自分の鏡とが一致するのであります。","xmin":2096.0,"ymin":1220.0,"xmax":2155.0,"ymax":2054.0},{"id":26,"contenttext":":","xmin":2077.0,"ymin":820.0,"xmax":2099.0,"ymax":848.0},{"id":27,"contenttext":"が卽ち御製の聖旨でありますと拜察出來ます。","xmin":2031.0,"ymin":578.0,"xmax":2084.0,"ymax":1379.0},{"id":28,"contenttext":"誠は總てのものの根本であります。","xmin":2022.0,"ymin":1419.0,"xmax":2078.0,"ymax":2015.0},{"id":29,"contenttext":"本居先","xmin":2021.0,"ymin":2064.0,"xmax":2072.0,"ymax":2153.0},{"id":30,"contenttext":"生の","xmin":1964.0,"ymin":575.0,"xmax":2011.0,"ymax":648.0},{"id":31,"contenttext":"「生れなからのま心そ道にはありける」と申されたのは、","xmin":1953.0,"ymin":670.0,"xmax":2012.0,"ymax":1659.0},{"id":32,"contenttext":"これであります。","xmin":1951.0,"ymin":1704.0,"xmax":1999.0,"ymax":1971.0},{"id":33,"contenttext":"そこで皇道では至誠を以つて敬神崇祖をする。","xmin":1882.0,"ymin":615.0,"xmax":1934.0,"ymax":1415.0},{"id":34,"contenttext":"神社に參拜すると云ふことが大切である","xmin":1873.0,"ymin":1458.0,"xmax":1927.0,"ymax":2149.0},{"id":35,"contenttext":"のであります。","xmin":1334.0,"ymin":557.0,"xmax":1381.0,"ymax":806.0},{"id":36,"contenttext":"皇道では、","xmin":1326.0,"ymin":833.0,"xmax":1382.0,"ymax":1010.0},{"id":37,"contenttext":"この神樣に參りまするには、","xmin":1323.0,"ymin":1038.0,"xmax":1378.0,"ymax":1524.0},{"id":38,"contenttext":"その前にお祓といふものを致しま","xmin":1316.0,"ymin":1557.0,"xmax":1371.0,"ymax":2136.0},{"id":39,"contenttext":"す。","xmin":1262.0,"ymin":554.0,"xmax":1304.0,"ymax":607.0},{"id":40,"contenttext":"或はみそぎと云ふものを致します。","xmin":1253.0,"ymin":631.0,"xmax":1307.0,"ymax":1237.0},{"id":41,"contenttext":"先刻伺つたのでありますが、この金刀比羅宮にも、","xmin":1240.0,"ymin":1276.0,"xmax":1300.0,"ymax":2134.0},{"id":42,"contenttext":"東の祓川で參拜者がみそぎをして參拜したといふことであります","xmin":1176.0,"ymin":551.0,"xmax":1236.0,"ymax":1696.0},{"id":43,"contenttext":"祓は禊の簡單なもので、","xmin":1167.0,"ymin":1739.0,"xmax":1222.0,"ymax":2135.0},{"id":44,"contenttext":"祓には水を要しません。","xmin":1108.0,"ymin":550.0,"xmax":1163.0,"ymax":961.0},{"id":45,"contenttext":"みそぎには水が要ります。","xmin":1107.0,"ymin":996.0,"xmax":1155.0,"ymax":1433.0},{"id":46,"contenttext":"身をそそぐのであります。","xmin":1098.0,"ymin":1480.0,"xmax":1148.0,"ymax":1912.0},{"id":47,"contenttext":"神代の昔、","xmin":1096.0,"ymin":1961.0,"xmax":1143.0,"ymax":2115.0},{"id":48,"contenttext":"は","xmin":1068.0,"ymin":1365.0,"xmax":1096.0,"ymax":1374.0},{"id":49,"contenttext":"伊邪那岐神樣が、","xmin":1037.0,"ymin":550.0,"xmax":1089.0,"ymax":840.0},{"id":50,"contenttext":"筑紫の日向の橋の小戶の阿波岐原で萩を遊ばされた。","xmin":1024.0,"ymin":870.0,"xmax":1085.0,"ymax":1793.0},{"id":51,"contenttext":"これが禊の起源で","xmin":1021.0,"ymin":1839.0,"xmax":1073.0,"ymax":2125.0},{"id":52,"contenttext":"あると考へられます。","xmin":962.0,"ymin":553.0,"xmax":1020.0,"ymax":922.0},{"id":53,"contenttext":"現に神樣にお參りする前には、手を洗ひ口をそゝぐ、","xmin":952.0,"ymin":951.0,"xmax":1011.0,"ymax":1876.0},{"id":54,"contenttext":"つまりみそぎ","xmin":951.0,"ymin":1924.0,"xmax":994.0,"ymax":2125.0},{"id":55,"contenttext":"の簡略化されたものであります。","xmin":887.0,"ymin":546.0,"xmax":943.0,"ymax":1118.0},{"id":56,"contenttext":"日本國民の國民精神は、","xmin":877.0,"ymin":1153.0,"xmax":933.0,"ymax":1558.0},{"id":57,"contenttext":"この禊祓の精神に於いて、","xmin":874.0,"ymin":1597.0,"xmax":927.0,"ymax":2076.0},{"id":58,"contenttext":"特","xmin":873.0,"ymin":2121.0,"xmax":921.0,"ymax":2132.0},{"id":59,"contenttext":"色を發揮するのであります。","xmin":816.0,"ymin":550.0,"xmax":867.0,"ymax":1038.0},{"id":60,"contenttext":"此の精神の極致が、","xmin":807.0,"ymin":1068.0,"xmax":860.0,"ymax":1396.0},{"id":61,"contenttext":"前に申しました至誠でありまして、","xmin":800.0,"ymin":1431.0,"xmax":855.0,"ymax":2034.0},{"id":62,"contenttext":"神樣","xmin":799.0,"ymin":2081.0,"xmax":845.0,"ymax":2130.0},{"id":63,"contenttext":"と一致するのであります。","xmin":742.0,"ymin":551.0,"xmax":792.0,"ymax":997.0},{"id":64,"contenttext":"先年日本のある製紙會社が、","xmin":730.0,"ymin":1031.0,"xmax":788.0,"ymax":1517.0},{"id":65,"contenttext":"英吉利の會社へ、","xmin":725.0,"ymin":1550.0,"xmax":781.0,"ymax":1836.0},{"id":66,"contenttext":"製紙機械を註文","xmin":724.0,"ymin":1877.0,"xmax":773.0,"ymax":2127.0},{"id":67,"contenttext":"しました。","xmin":674.0,"ymin":550.0,"xmax":718.0,"ymax":718.0},{"id":68,"contenttext":"所が、","xmin":672.0,"ymin":746.0,"xmax":717.0,"ymax":843.0},{"id":69,"contenttext":"英吉利の會社から機械を發送して、","xmin":657.0,"ymin":862.0,"xmax":718.0,"ymax":1478.0},{"id":70,"contenttext":"この機械は非常に精巧だから、","xmin":651.0,"ymin":1516.0,"xmax":707.0,"ymax":2029.0},{"id":71,"contenttext":"据付","xmin":651.0,"ymin":2080.0,"xmax":697.0,"ymax":2128.0},{"id":72,"contenttext":"の爲に技師を派遣するから、","xmin":592.0,"ymin":550.0,"xmax":650.0,"ymax":1035.0},{"id":73,"contenttext":"それまで据付けるのを待てと云つて來ました。","xmin":581.0,"ymin":1072.0,"xmax":640.0,"ymax":1871.0},{"id":74,"contenttext":"そこでこちら","xmin":583.0,"ymin":1921.0,"xmax":622.0,"ymax":2125.0},{"id":75,"contenttext":"の會社の社長が、","xmin":519.0,"ymin":546.0,"xmax":574.0,"ymax":837.0},{"id":76,"contenttext":"その會社の技師を招んで云ひまするのに、","xmin":510.0,"ymin":870.0,"xmax":568.0,"ymax":1595.0},{"id":77,"contenttext":"今度英吉利から製紙機械を送","xmin":498.0,"ymin":1632.0,"xmax":558.0,"ymax":2129.0}]