[{"id":0,"contenttext":"三八","xmin":2746.0,"ymin":1708.0,"xmax":2791.0,"ymax":1791.0},{"id":1,"contenttext":";","xmin":2713.0,"ymin":801.0,"xmax":2732.0,"ymax":845.0},{"id":2,"contenttext":"我々の祖先を率ゐ給ひて、","xmin":2673.0,"ymin":564.0,"xmax":2718.0,"ymax":1022.0},{"id":3,"contenttext":"海を渡つてこれを征討遊されて融根を除かれたのであります。","xmin":2673.0,"ymin":1033.0,"xmax":2722.0,"ymax":2127.0},{"id":4,"contenttext":"ん","xmin":2637.0,"ymin":877.0,"xmax":2666.0,"ymax":926.0},{"id":5,"contenttext":"又弘安の役には、","xmin":2600.0,"ymin":564.0,"xmax":2646.0,"ymax":860.0},{"id":6,"contenttext":"元は百戰練贈の大軍を以て入寇して、","xmin":2595.0,"ymin":877.0,"xmax":2666.0,"ymax":1533.0},{"id":7,"contenttext":"敵前上陸をしようとしました。","xmin":2601.0,"ymin":1549.0,"xmax":2646.0,"ymax":2088.0},{"id":8,"contenttext":"之","xmin":2601.0,"ymin":2100.0,"xmax":2646.0,"ymax":2145.0},{"id":9,"contenttext":"つ","xmin":2564.0,"ymin":1825.0,"xmax":2593.0,"ymax":1872.0},{"id":10,"contenttext":"れに對し、","xmin":2527.0,"ymin":564.0,"xmax":2574.0,"ymax":750.0},{"id":11,"contenttext":"我々の祖先は、","xmin":2526.0,"ymin":753.0,"xmax":2576.0,"ymax":1018.0},{"id":12,"contenttext":"神ながらの精神を發揮して、","xmin":2528.0,"ymin":1035.0,"xmax":2574.0,"ymax":1531.0},{"id":13,"contenttext":"生きて歸るもの僅かに三人ならし","xmin":2528.0,"ymin":1547.0,"xmax":2574.0,"ymax":2144.0},{"id":14,"contenttext":"めたのであります。","xmin":2454.0,"ymin":565.0,"xmax":2500.0,"ymax":900.0},{"id":15,"contenttext":"されば、","xmin":2452.0,"ymin":920.0,"xmax":2499.0,"ymax":1063.0},{"id":16,"contenttext":"今後も、","xmin":2456.0,"ymin":1072.0,"xmax":2500.0,"ymax":1216.0},{"id":17,"contenttext":"このかんながらの精神を振興して、","xmin":2454.0,"ymin":1235.0,"xmax":2501.0,"ymax":1854.0},{"id":18,"contenttext":"日本民族傳統の","xmin":2452.0,"ymin":1863.0,"xmax":2499.0,"ymax":2142.0},{"id":19,"contenttext":"かみ","xmin":2417.0,"ymin":1306.0,"xmax":2444.0,"ymax":1354.0},{"id":20,"contenttext":"偉力を發揮して、","xmin":2381.0,"ymin":562.0,"xmax":2427.0,"ymax":867.0},{"id":21,"contenttext":"今後の大難局を突破し、","xmin":2376.0,"ymin":872.0,"xmax":2430.0,"ymax":1292.0},{"id":22,"contenttext":"上は宸襟を安んじ奉り、","xmin":2379.0,"ymin":1310.0,"xmax":2428.0,"ymax":1728.0},{"id":23,"contenttext":"下は我々祖先の遺志を","xmin":2379.0,"ymin":1741.0,"xmax":2428.0,"ymax":2147.0},{"id":24,"contenttext":"繼承し、","xmin":2303.0,"ymin":559.0,"xmax":2352.0,"ymax":709.0},{"id":25,"contenttext":"皇道の使命を完成しなければならぬと思ふものであります。","xmin":2306.0,"ymin":716.0,"xmax":2352.0,"ymax":1770.0},{"id":26,"contenttext":"私の話はこれで終ることに致します。","xmin":2232.0,"ymin":601.0,"xmax":2281.0,"ymax":1255.0},{"id":27,"contenttext":"御〓聽を感謝致します。","xmin":2233.0,"ymin":1267.0,"xmax":2278.0,"ymax":1687.0},{"id":28,"contenttext":"(終)","xmin":2233.0,"ymin":1820.0,"xmax":2274.0,"ymax":1932.0},{"id":29,"contenttext":"(終)","xmin":2233.0,"ymin":1820.0,"xmax":2274.0,"ymax":1932.0},{"id":30,"contenttext":"昭和十四年十二月廿五日印刷","xmin":1131.0,"ymin":1076.0,"xmax":1165.0,"ymax":1467.0},{"id":31,"contenttext":"昭和十五年","xmin":1102.0,"ymin":1075.0,"xmax":1139.0,"ymax":1230.0},{"id":32,"contenttext":"月","xmin":1107.0,"ymin":1284.0,"xmax":1129.0,"ymax":1318.0},{"id":33,"contenttext":"日發行","xmin":1102.0,"ymin":1373.0,"xmax":1135.0,"ymax":1467.0},{"id":34,"contenttext":"編","xmin":1058.0,"ymin":1171.0,"xmax":1092.0,"ymax":1209.0},{"id":35,"contenttext":"輯","xmin":1060.0,"ymin":1217.0,"xmax":1090.0,"ymax":1253.0},{"id":36,"contenttext":"兼","xmin":1060.0,"ymin":1261.0,"xmax":1090.0,"ymax":1297.0},{"id":37,"contenttext":"發行者","xmin":1031.0,"ymin":1173.0,"xmax":1065.0,"ymax":1296.0},{"id":38,"contenttext":"金刀比羅宮社務所文事課","xmin":1034.0,"ymin":1339.0,"xmax":1084.0,"ymax":1783.0},{"id":39,"contenttext":"右代表者","xmin":987.0,"ymin":1171.0,"xmax":1024.0,"ymax":1297.0},{"id":40,"contenttext":"琴","xmin":982.0,"ymin":1398.0,"xmax":1029.0,"ymax":1447.0},{"id":41,"contenttext":"陵","xmin":982.0,"ymin":1510.0,"xmax":1029.0,"ymax":1560.0},{"id":42,"contenttext":"光","xmin":978.0,"ymin":1620.0,"xmax":1028.0,"ymax":1672.0},{"id":43,"contenttext":"重","xmin":979.0,"ymin":1736.0,"xmax":1028.0,"ymax":1782.0},{"id":44,"contenttext":"香川錦仲多度郡琴平町七一五番〓","xmin":954.0,"ymin":147