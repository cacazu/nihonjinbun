[{"id":1,"contenttext":"せしめることが最も大切である。","xmin":2685.0,"ymin":568.0,"xmax":2741.0,"ymax":1132.0},{"id":2,"contenttext":"それには、","xmin":2682.0,"ymin":1168.0,"xmax":2735.0,"ymax":1335.0},{"id":3,"contenttext":"第一に我々國民自らが、","xmin":2679.0,"ymin":1370.0,"xmax":2733.0,"ymax":1766.0},{"id":4,"contenttext":"皇道精神をよく認識","xmin":2677.0,"ymin":1809.0,"xmax":2726.0,"ymax":2140.0},{"id":5,"contenttext":"して、","xmin":2622.0,"ymin":566.0,"xmax":2661.0,"ymax":661.0},{"id":6,"contenttext":"依つて以て、進んで長期建設に努力せねばならないと信ずるものであります。","xmin":2605.0,"ymin":684.0,"xmax":2665.0,"ymax":2039.0},{"id":7,"contenttext":"三民主義とは何でありますか、","xmin":2544.0,"ymin":606.0,"xmax":2593.0,"ymax":1126.0},{"id":8,"contenttext":"支那には昔から王道がありまして、","xmin":2535.0,"ymin":1166.0,"xmax":2589.0,"ymax":1756.0},{"id":9,"contenttext":"それは早く我が國に","xmin":2533.0,"ymin":1809.0,"xmax":2582.0,"ymax":2134.0},{"id":10,"contenttext":"さ","xmin":2510.0,"ymin":1004.0,"xmax":2528.0,"ymax":1029.0},{"id":11,"contenttext":"も入れられて、","xmin":2473.0,"ymin":566.0,"xmax":2520.0,"ymax":815.0},{"id":12,"contenttext":"皇道の羽翼となり、","xmin":2467.0,"ymin":844.0,"xmax":2518.0,"ymax":1164.0},{"id":13,"contenttext":"前述の如く、","xmin":2467.0,"ymin":1203.0,"xmax":2513.0,"ymax":1408.0},{"id":14,"contenttext":"甚だよい所の道であるのであります。","xmin":2456.0,"ymin":1442.0,"xmax":2513.0,"ymax":2081.0},{"id":15,"contenttext":"三","xmin":2459.0,"ymin":2133.0,"xmax":2501.0,"ymax":2133.0},{"id":16,"contenttext":"民主義は孫文によつて唱へられたものでありまして、","xmin":2395.0,"ymin":562.0,"xmax":2449.0,"ymax":1487.0},{"id":17,"contenttext":"卽ち民族主義、","xmin":2391.0,"ymin":1522.0,"xmax":2439.0,"ymax":1755.0},{"id":18,"contenttext":"民權主義、","xmin":2388.0,"ymin":1805.0,"xmax":2437.0,"ymax":1954.0},{"id":19,"contenttext":"民生主義","xmin":2386.0,"ymin":2007.0,"xmax":2434.0,"ymax":2133.0},{"id":20,"contenttext":"この三つをいふのであります。","xmin":2325.0,"ymin":565.0,"xmax":2375.0,"ymax":1086.0},{"id":21,"contenttext":"これは孫文の新しい考への樣に思はれますが、","xmin":2313.0,"ymin":1124.0,"xmax":2371.0,"ymax":1915.0},{"id":22,"contenttext":"實は米國か","xmin":2313.0,"ymin":1967.0,"xmax":2362.0,"ymax":2132.0},{"id":23,"contenttext":"ら持つて來たものであります。","xmin":2254.0,"ymin":559.0,"xmax":2300.0,"ymax":1087.0},{"id":24,"contenttext":"亞米利加にリンカーンといふ大統領がありました。","xmin":2240.0,"ymin":1124.0,"xmax":2297.0,"ymax":1993.0},{"id":25,"contenttext":"そのリ","xmin":2240.0,"ymin":2051.0,"xmax":2281.0,"ymax":2125.0},{"id":26,"contenttext":"ンカーンが、","xmin":2181.0,"ymin":563.0,"xmax":2224.0,"ymax":764.0},{"id":27,"contenttext":"人民の、","xmin":2173.0,"ymin":797.0,"xmax":2241.0,"ymax":938.0},{"id":28,"contenttext":"人民によつての、","xmin":2176.0,"ymin":957.0,"xmax":2227.0,"ymax":1241.0},{"id":29,"contenttext":"人民の爲の政治といふことを唱へました。","xmin":2167.0,"ymin":1283.0,"xmax":2231.0,"ymax":2022.0},{"id":30,"contenttext":"それ","xmin":2166.0,"ymin":2081.0,"xmax":2211.0,"ymax":2130.0},{"id":31,"contenttext":"を孫文が輸入したものであります。","xmin":2104.0,"ymin":559.0,"xmax":2155.0,"ymax":1162.0},{"id":32,"contenttext":"民族主義といふことは近來各方面で叫ばれてゐること","xmin":2091.0,"ymin":1198.0,"xmax":2149.0,"ymax":2127.0},{"id":33,"contenttext":"づ","xmin":2064.0,"ymin":1357.0,"xmax":2088.0,"ymax":1375.0},{"id":34,"contenttext":"で、","xmin":2040.0,"ymin":559.0,"xmax":2079.0,"ymax":607.0},{"id":35,"contenttext":"日本民族は、","xmin":2033.0,"ymin":638.0,"xmax":2081.0,"ymax":843.0},{"id":36,"contenttext":"日本民族主義でやるといふ風に、これは別段差支のないものであります。","xmin":2018.0,"ymin":880.0,"xmax":2080.0,"ymax":2127.0},{"id":37,"contenttext":"民權主義、","xmin":1960.0,"ymin":553.0,"xmax":2008.0,"ymax":731.0},{"id":38,"contenttext":"これは自由、","xmin":1960.0,"ymin":753.0,"xmax":2007.0,"ymax":957.0},{"id":39,"contenttext":"平等を主眼としてゐる。","xmin":1956.0,"ymin":994.0,"xmax":2004.0,"ymax":1394.0},{"id":40,"contenttext":"自由、","xmin":1954.0,"ymin":1436.0,"xmax":1999.0,"ymax":1511.0},{"id":41,"contenttext":"平等も或程度までは許されるので","xmin":1947.0,"ymin":1559.0,"xmax":1999.0,"ymax":2125.0},{"id":42,"contenttext":"あります。","xmin":1891.0,"ymin":553.0,"xmax":1932.0,"ymax":721.0},{"id":43,"contenttext":"憲法などにも、","xmin":1887.0,"ymin":752.0,"xmax":1932.0,"ymax":1002.0},{"id":44,"contenttext":"人民の權利、","xmin":1881.0,"ymin":1032.0,"xmax":1930.0,"ymax":1233.0},{"id":45,"contenttext":"義務などが規定せられて、","xmin":1875.0,"ymin":1273.0,"xmax":1928.0,"ymax":1708.0},{"id":46,"contenttext":"ある點までは認められ","xmin":1874.0,"ymin":1759.0,"xmax":1924.0,"ymax":2127.0},{"id":47,"contenttext":"て居るのであります。","xmin":1336.0,"ymin":555.0,"xmax":1390.0,"ymax":923.0},{"id":48,"contenttext":"併し、","xmin":1336.0,"ymin":949.0,"xmax":1380.0,"ymax":1045.0},{"id":49,"contenttext":"ある程度以上、","xmin":1326.0,"ymin":1074.0,"xmax":1375.0,"ymax":1314.0},{"id":50,"contenttext":"或は絕對自由、","xmin":1320.0,"ymin":1357.0,"xmax":1371.0,"ymax":1598.0},{"id":51,"contenttext":"平等などは到底認容せられま","xmin":1308.0,"ymin":1637.0,"xmax":1366.0,"ymax":2127.0},{"id":52,"contenttext":"せん。","xmin":1270.0,"ymin":551.0,"xmax":1314.0,"ymax":643.0},{"id":53,"contenttext":"社會主義などの申す自由などは、","xmin":1255.0,"ymin":669.0,"xmax":1316.0,"ymax":1240.0},{"id":54,"contenttext":"我が國體に反するのであります。","xmin":1241.0,"ymin":1271.0,"xmax":1302.0,"ymax":1828.0},{"id":55,"contenttext":"次の民生主義と","xmin":1236.0,"ymin":1880.0,"xmax":1287.0,"ymax":2121.0},{"id":56,"contenttext":"いふのは、","xmin":1190.0,"ymin":548.0,"xmax":1246.0,"ymax":724.0},{"id":57,"contenttext":"何とでも解釋のつく樣な文字でありますが、","xmin":1173.0,"ymin":747.0,"xmax":1241.0,"ymax":1506.0},{"id":58,"contenttext":"孫文は之れを社會主義、","xmin":1162.0,"ymin":1552.0,"xmax":1221.0,"ymax":1951.0},{"id":59,"contenttext":"又は共產","xmin":1158.0,"ymin":1999.0,"xmax":1213.0,"ymax":2124.0},{"id":60,"contenttext":"主義に解したのであります。","xmin":1114.0,"ymin":544.0,"xmax":1168.0,"ymax":1033.0},{"id":61,"contenttext":"勿論汪兆銘などは、","xmin":1099.0,"ymin":1065.0,"xmax":1156.0,"ymax":1391.0},{"id":62,"contenttext":"防共主義を說いて居るやうですが、蔣介","xmin":1085.0,"ymin":1431.0,"xmax":1148.0,"ymax":2124.0},{"id":63,"contenttext":",","xmin":1084.0,"ymin":943.0,"xmax":1097.0,"ymax":944.0},{"id":64,"contenttext":"石の如きは、","xmin":1044.0,"ymin":540.0,"xmax":1093.0,"ymax":752.0},{"id":65,"contenttext":"現に容共主義を主張して居るのであります。","xmin":1025.0,"ymin":782.0,"xmax":1092.0,"ymax":1545.0},{"id":66,"contenttext":"だから米國輸入の三民主義は、","xmin":1012.0,"ymin":1589.0,"xmax":1072.0,"ymax":2104.0},{"id":67,"contenttext":"大いに修正しませんと、","xmin":967.0,"ymin":540.0,"xmax":1025.0,"ymax":947.0},{"id":68,"contenttext":"東亞新秩序には適しません。","xmin":954.0,"ymin":981.0,"xmax":1014.0,"ymax":1463.0},{"id":69,"contenttext":"そこで支那には在來の王道の方がよ","xmin":940.0,"ymin":1507.0,"xmax":1002.0,"ymax":2119.0},{"id":70,"contenttext":"いのであります。","xmin":899.0,"ymin":541.0,"xmax":953.0,"ymax":827.0},{"id":71,"contenttext":"事變に日本の爲に敗れました蔣介石は、","xmin":878.0,"ymin":854.0,"xmax":947.0,"ymax":1538.0},{"id":72,"contenttext":"支那の民心をつなぐ爲に、","xmin":869.0,"ymin":1585.0,"xmax":927.0,"ymax":2015.0},{"id":73,"contenttext":"孔子","xmin":868.0,"ymin":2071.0,"xmax":916.0,"ymax":2115.0},{"id":74,"contenttext":"の子孫を曲阜から呼んで來て、","xmin":817.0,"ymin":535.0,"xmax":880.0,"ymax":1061.0},{"id":75,"contenttext":"抗日に利用してゐます。","xmin":804.0,"ymin":1098.0,"xmax":866.0,"ymax":1498.0},{"id":76,"contenttext":"何れにしても、","xmin":748.0,"ymin":575.0,"xmax":803.0,"ymax":827.0},{"id":77,"contenttext":"今後我が國の處する道は非常に困難なものでありますが、","xmin":723.0,"ymin":854.0,"xmax":797.0,"ymax":1851.0},{"id":78,"contenttext":"是非共此の困","xmin":718.0,"ymin":1902.0,"xmax":772.0,"ymax":2110.0},{"id":79,"contenttext":"ち","xmin":721.0,"ymin":616.0,"xmax":741.0,"ymax":646.0},{"id":80,"contenttext":"難に打克つ必要があり、","xmin":669.0,"ymin":528.0,"xmax":731.0,"ymax":935.0},{"id":81,"contenttext":"かくして我が國は、","xmin":662.0,"ymin":975.0,"xmax":719.0,"ymax":1293.0},{"id":82,"contenttext":"東洋永遠の平和、","xmin":653.0,"ymin":1331.0,"xmax":712.0,"ymax":1614.0},{"id":83,"contenttext":"世界永久の平和を打立てる","xmin":642.0,"ymin":1659.0,"xmax":702.0,"ymax":2109.0},{"id":84,"contenttext":"ことが出來るのであります。","xmin":593.0,"ymin":533.0,"xmax":656.0,"ymax":1019.0},{"id":85,"contenttext":"それには一体どうすればよいか、","xmin":580.0,"ymin":1052.0,"xmax":643.0,"ymax":1617.0},{"id":86,"contenttext":"已に申しました通り、","xmin":573.0,"ymin":1662.0,"xmax":626.0,"ymax":2004.0},{"id":87,"contenttext":"皇道","xmin":570.0,"ymin":2064.0,"xmax":617.0,"ymax":2110.0},{"id":88,"contenttext":"15:","xmin":556.0,"ymin":1134.0,"xmax":582.0,"ymax":1157.0},{"id":89,"contenttext":"を國民に徹底せしめる。","xmin":525.0,"ymin":526.0,"xmax":582.0,"ymax":933.0},{"id":90,"contenttext":"それより他に道がないのであります。","xmin":509.0,"ymin":968.0,"xmax":570.0,"ymax":1607.0}]