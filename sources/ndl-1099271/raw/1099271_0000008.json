[{"id":0,"contenttext":"八","xmin":2785.0,"ymin":1744.0,"xmax":2829.0,"ymax":1786.0},{"id":1,"contenttext":"は、","xmin":2707.0,"ymin":560.0,"xmax":2749.0,"ymax":627.0},{"id":2,"contenttext":"苟くも日本國民である以上、","xmin":2707.0,"ymin":637.0,"xmax":2754.0,"ymax":1135.0},{"id":3,"contenttext":"すべてのものが之れを尊敬し、ぞの行はれたる所、","xmin":2705.0,"ymin":1150.0,"xmax":2761.0,"ymax":2049.0},{"id":4,"contenttext":"その","xmin":2713.0,"ymin":2056.0,"xmax":2756.0,"ymax":2138.0},{"id":5,"contenttext":"示されたる事を模範とし、","xmin":2635.0,"ymin":559.0,"xmax":2681.0,"ymax":1021.0},{"id":6,"contenttext":"自分の云爲行動の規範とし、","xmin":2635.0,"ymin":1027.0,"xmax":2678.0,"ymax":1533.0},{"id":7,"contenttext":"依つて以て國民の理想を實現せん","xmin":2635.0,"ymin":1542.0,"xmax":2687.0,"ymax":2140.0},{"id":8,"contenttext":"とするのである。","xmin":2564.0,"ymin":562.0,"xmax":2606.0,"ymax":858.0},{"id":9,"contenttext":"例へば乃木大將は、","xmin":2562.0,"ymin":871.0,"xmax":2610.0,"ymax":1218.0},{"id":10,"contenttext":"國民のすべてが尊敬する。","xmin":2562.0,"ymin":1225.0,"xmax":2615.0,"ymax":1687.0},{"id":11,"contenttext":"勿論すべての人が乃木大","xmin":2566.0,"ymin":1700.0,"xmax":2615.0,"ymax":2142.0},{"id":12,"contenttext":"將の樣には出來ないのであるが、","xmin":2491.0,"ymin":557.0,"xmax":2537.0,"ymax":1138.0},{"id":13,"contenttext":"少くとも乃木大將の御精神を體して進みたいと云ふ心が","xmin":2492.0,"ymin":1145.0,"xmax":2542.0,"ymax":2140.0},{"id":14,"contenttext":"國民にあるからである。","xmin":2417.0,"ymin":559.0,"xmax":2462.0,"ymax":973.0},{"id":15,"contenttext":"一例で云へば、吾々が東京で電車に乘るとする。東京の電車は殆ん","xmin":2414.0,"ymin":999.0,"xmax":2467.0,"ymax":2140.0},{"id":16,"contenttext":"ど常に滿員である。","xmin":2345.0,"ymin":559.0,"xmax":2389.0,"ymax":897.0},{"id":17,"contenttext":"乃木大將は己に大將で伯爵である。","xmin":2343.0,"ymin":911.0,"xmax":2394.0,"ymax":1526.0},{"id":18,"contenttext":"當時こんな偉い方々は二頭立の馬","xmin":2347.0,"ymin":1542.0,"xmax":2395.0,"ymax":2142.0},{"id":19,"contenttext":"車に乘つた。","xmin":2269.0,"ymin":557.0,"xmax":2318.0,"ymax":780.0},{"id":20,"contenttext":"所が乃木大將は屢々電車に乘られる。","xmin":2269.0,"ymin":791.0,"xmax":2320.0,"ymax":1448.0},{"id":21,"contenttext":"しかも車掌臺の所に立つてゐられて中","xmin":2271.0,"ymin":1464.0,"xmax":2322.0,"ymax":2144.0},{"id":22,"contenttext":"には入られない。","xmin":2196.0,"ymin":561.0,"xmax":2248.0,"ymax":857.0},{"id":23,"contenttext":"昔の電車は、","xmin":2198.0,"ymin":871.0,"xmax":2244.0,"ymax":1101.0},{"id":24,"contenttext":"車掌臺から乘り降りする。","xmin":2199.0,"ymin":1106.0,"xmax":2244.0,"ymax":1564.0},{"id":25,"contenttext":"この車掌臺の所に立つてゐられ","xmin":2200.0,"ymin":1586.0,"xmax":2251.0,"ymax":2144.0},{"id":26,"contenttext":"るのであるが、","xmin":2127.0,"ymin":562.0,"xmax":2171.0,"ymax":824.0},{"id":27,"contenttext":"車掌も乃木大將には中におはいりなさいとは云はない。","xmin":2126.0,"ymin":828.0,"xmax":2176.0,"ymax":1803.0},{"id":28,"contenttext":"何故中には入られ","xmin":2128.0,"ymin":1820.0,"xmax":2178.0,"ymax":2144.0},{"id":29,"contenttext":"ないか。","xmin":2052.0,"ymin":559.0,"xmax":2094.0,"ymax":697.0},{"id":30,"contenttext":"乃木大將は、","xmin":2049.0,"ymin":713.0,"xmax":2098.0,"ymax":941.0},{"id":31,"contenttext":"全國に寫眞版などでその肖像がくばられてあるから、","xmin":2052.0,"ymin":952.0,"xmax":2099.0,"ymax":1886.0},{"id":32,"contenttext":"一目見たら誰","xmin":2055.0,"ymin":1915.0,"xmax":2101.0,"ymax":2144.0},{"id":33,"contenttext":"でも知つてゐる。","xmin":1979.0,"ymin":560.0,"xmax":2021.0,"ymax":856.0},{"id":34,"contenttext":"それで中へは入られると誰でもすぐ立つて席を讓る。","xmin":1978.0,"ymin":872.0,"xmax":2027.0,"ymax":1806.0},{"id":35,"contenttext":"それが氣の毒であ","xmin":1981.0,"ymin":1822.0,"xmax":2027.0,"ymax":2142.0},{"id":36,"contenttext":":","xmin":1948.0,"ymin":2100.0,"xmax":1973.0,"ymax":2145.0},{"id":37,"contenttext":"ると思召されたものと見えて中には入られない。","xmin":1907.0,"ymin":560.0,"xmax":1953.0,"ymax":1408.0},{"id":38,"contenttext":"普通の人間は、乘車するとすぐ鵜の目鷹","xmin":1907.0,"ymin":1423.0,"xmax":1957.0,"ymax":2144.0},{"id":39,"contenttext":"の目で誰か立たぬかと見てゐる、","xmin":1335.0,"ymin":536.0,"xmax":1393.0,"ymax":1113.0},{"id":40,"contenttext":"席があいたらあつちからもこつちからも爭つてその席を","xmin":1312.0,"ymin":1124.0,"xmax":1383.0,"ymax":2124.0},{"id":41,"contenttext":"占めんとする。","xmin":1266.0,"ymin":532.0,"xmax":1317.0,"ymax":793.0},{"id":42,"contenttext":"乃木大將は決してかういふことをせられない。","xmin":1247.0,"ymin":807.0,"xmax":1315.0,"ymax":1622.0},{"id":43,"contenttext":"かういふ所に、","xmin":1243.0,"ymin":1644.0,"xmax":1291.0,"ymax":1898.0},{"id":44,"contenttext":"神としての","xmin":1236.0,"ymin":1916.0,"xmax":1286.0,"ymax":2117.0},{"id":45,"contenttext":"乃木大將と、","xmin":1192.0,"ymin":530.0,"xmax":1241.0,"ymax":751.0},{"id":46,"contenttext":"人としての吾人國民との差があるのであります。","xmin":1173.0,"ymin":766.0,"xmax":1239.0,"ymax":1624.0},{"id":47,"contenttext":"尙乃木大將が、","xmin":1165.0,"ymin":1636.0,"xmax":1220.0,"ymax":1905.0},{"id":48,"contenttext":"甞て長野縣","xmin":1159.0,"ymin":1912.0,"xmax":1214.0,"ymax":2121.0},{"id":49,"contenttext":"を旅行せられた際、","xmin":1113.0,"ymin":529.0,"xmax":1171.0,"ymax":872.0},{"id":50,"contenttext":"路傍の或るさゝやかなる民家で腰をかけて休まれたことがある。","xmin":1091.0,"ymin":880.0,"xmax":1162.0,"ymax":2017.0},{"id":51,"contenttext":"する","xmin":1092.0,"ymin":2032.0,"xmax":1131.0,"ymax":2111.0},{"id":52,"contenttext":"とその家からウナリ聲が聞える。","xmin":1040.0,"ymin":529.0,"xmax":1093.0,"ymax":1101.0},{"id":53,"contenttext":"聽くと主人が病氣だとのことである。","xmin":1025.0,"ymin":1118.0,"xmax":1082.0,"ymax":1776.0},{"id":54,"contenttext":"素より貧しい家で","xmin":1015.0,"ymin":1791.0,"xmax":1067.0,"ymax":2112.0},{"id":55,"contenttext":"着てゐる布團なども、","xmin":972.0,"ymin":523.0,"xmax":1023.0,"ymax":904.0},{"id":56,"contenttext":"極めて薄い。","xmin":968.0,"ymin":916.0,"xmax":1014.0,"ymax":1136.0},{"id":57,"contenttext":"定めし寒からうと、","xmin":953.0,"ymin":1153.0,"xmax":1011.0,"ymax":1503.0},{"id":58,"contenttext":"乃木大將はお召になつてゐたマン","xmin":937.0,"ymin":1507.0,"xmax":1004.0,"ymax":2105.0},{"id":59,"contenttext":"トを脫いで與へられた。","xmin":894.0,"ymin":526.0,"xmax":949.0,"ymax":943.0},{"id":60,"contenttext":"勿論徽章などは皆とり去つて誰が着ても差支がない樣にして與へ","xmin":868.0,"ymin":956.0,"xmax":940.0,"ymax":2107.0},{"id":61,"contenttext":"られた。","xmin":828.0,"ymin":521.0,"xmax":873.0,"ymax":665.0},{"id":62,"contenttext":"普通の人でもかうしたいといふ心は持つてゐる。","xmin":807.0,"ymin":678.0,"xmax":873.0,"ymax":1532.0},{"id":63,"contenttext":"心はあつても遣つてしまつたら","xmin":793.0,"ymin":1550.0,"xmax":853.0,"ymax":2110.0},{"id":64,"contenttext":"自分が困るといふので實行しない。","xmin":742.0,"ymin":519.0,"xmax":800.0,"ymax":1135.0},{"id":65,"contenttext":"そのかうしたい、","xmin":733.0,"ymin":1150.0,"xmax":787.0,"ymax":1457.0},{"id":66,"contenttext":"かうあるべきだと思ふ所が、","xmin":723.0,"ymin":1467.0,"xmax":778.0,"ymax":1967.0},{"id":67,"contenttext":"日本人","xmin":719.0,"ymin":1985.0,"xmax":767.0,"ymax":2108.0},{"id":68,"contenttext":"の理想であります。","xmin":676.0,"ymin":518.0,"xmax":725.0,"ymax":857.0},{"id":69,"contenttext":"自己を沒して敢へてこれを實行せられた所に、","xmin":653.0,"ymin":871.0,"xmax":723.0,"ymax":1695.0},{"id":70,"contenttext":"乃木大將の神としての","xmin":649.0,"ymin":1701.0,"xmax":702.0,"ymax":2103.0},{"id":71,"contenttext":"偉大さが表現せられるのであります。","xmin":596.0,"ymin":514.0,"xmax":656.0,"ymax":1171.0},{"id":72,"contenttext":"すべて大は義勇奉公から、小は區々一身上のことに關するまで、","xmin":505.0,"ymin":551.0,"xmax":583.0,"ymax":1690.0},{"id":73,"contenttext":"かう云ふ風な日本國民","xmin":499.0,"ymin":1703.0,"xmax":556.0,"ymax":2101.0},{"id":74,"contenttext":"かう云ふ風な日本國民","xmin":499.0,"ymin":1703.0,"xmax":556.0,"ymax":2101.0}]