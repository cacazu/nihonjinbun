[{"id":0,"contenttext":"一八","xmin":2730.0,"ymin":1715.0,"xmax":2776.0,"ymax":1787.0},{"id":1,"contenttext":"がたい事であるとよろこんで受取つたといふのであります。","xmin":2661.0,"ymin":560.0,"xmax":2713.0,"ymax":1611.0},{"id":2,"contenttext":"斯樣に西洋人には恩といふこ","xmin":2658.0,"ymin":1620.0,"xmax":2722.0,"ymax":2140.0},{"id":3,"contenttext":"とが中々理解出來ないのであります。","xmin":2593.0,"ymin":560.0,"xmax":2640.0,"ymax":1218.0},{"id":4,"contenttext":"總てが物質主義でありますから、","xmin":2585.0,"ymin":1228.0,"xmax":2638.0,"ymax":1810.0},{"id":5,"contenttext":"精神的のことは容","xmin":2584.0,"ymin":1820.0,"xmax":2632.0,"ymax":2144.0},{"id":6,"contenttext":"易に理解出來ないのであります。","xmin":2518.0,"ymin":555.0,"xmax":2566.0,"ymax":1135.0},{"id":7,"contenttext":"我が國には、","xmin":2509.0,"ymin":1146.0,"xmax":2565.0,"ymax":1376.0},{"id":8,"contenttext":"昔から幾多の神々が出現せられて、","xmin":2507.0,"ymin":1382.0,"xmax":2562.0,"ymax":2002.0},{"id":9,"contenttext":"かゝる","xmin":2512.0,"ymin":2020.0,"xmax":2551.0,"ymax":2137.0},{"id":10,"contenttext":"めでたき國家を建設なされ、","xmin":2438.0,"ymin":557.0,"xmax":2493.0,"ymax":1059.0},{"id":11,"contenttext":"發展なされたのであります。","xmin":2439.0,"ymin":1069.0,"xmax":2488.0,"ymax":1569.0},{"id":12,"contenttext":"これに對し吾々は常に大いなる","xmin":2432.0,"ymin":1586.0,"xmax":2486.0,"ymax":2140.0},{"id":13,"contenttext":"感謝の念をさゝげ、","xmin":2371.0,"ymin":557.0,"xmax":2417.0,"ymax":901.0},{"id":14,"contenttext":"之れを神社に奉齋し、","xmin":2367.0,"ymin":911.0,"xmax":2415.0,"ymax":1296.0},{"id":15,"contenttext":"その祭祀を怠らないのであります。","xmin":2360.0,"ymin":1304.0,"xmax":2413.0,"ymax":1927.0},{"id":16,"contenttext":"之れが報本","xmin":2361.0,"ymin":1937.0,"xmax":2408.0,"ymax":2142.0},{"id":17,"contenttext":"反始であります。","xmin":2301.0,"ymin":559.0,"xmax":2347.0,"ymax":856.0},{"id":18,"contenttext":"それから皇道に於いて大切なことは、","xmin":2221.0,"ymin":596.0,"xmax":2275.0,"ymax":1251.0},{"id":19,"contenttext":"人生のすべての行動を、","xmin":2220.0,"ymin":1264.0,"xmax":2267.0,"ymax":1686.0},{"id":20,"contenttext":"至誠で一貫することであ","xmin":2220.0,"ymin":1702.0,"xmax":2264.0,"ymax":2140.0},{"id":21,"contenttext":"ります。","xmin":2157.0,"ymin":557.0,"xmax":2198.0,"ymax":699.0},{"id":22,"contenttext":"皇道では、","xmin":2150.0,"ymin":710.0,"xmax":2199.0,"ymax":900.0},{"id":23,"contenttext":"昔から明き、","xmin":2152.0,"ymin":908.0,"xmax":2198.0,"ymax":1135.0},{"id":24,"contenttext":"〓き、","xmin":2150.0,"ymin":1145.0,"xmax":2194.0,"ymax":1253.0},{"id":25,"contenttext":"直き、","xmin":2150.0,"ymin":1264.0,"xmax":2191.0,"ymax":1370.0},{"id":26,"contenttext":"マコトの心、","xmin":2147.0,"ymin":1391.0,"xmax":2193.0,"ymax":1609.0},{"id":27,"contenttext":"卽ち至誠一貫を高調して居る","xmin":2140.0,"ymin":1615.0,"xmax":2194.0,"ymax":2137.0},{"id":28,"contenttext":"のであります。","xmin":2081.0,"ymin":557.0,"xmax":2121.0,"ymax":814.0},{"id":29,"contenttext":"本居宣長先生は","xmin":2071.0,"ymin":828.0,"xmax":2125.0,"ymax":1113.0},{"id":30,"contenttext":"「生れなからのま心そ道にはありける」と申されてゐる。","xmin":2069.0,"ymin":1120.0,"xmax":2122.0,"ymax":2120.0},{"id":31,"contenttext":"卽ちマコトの心、","xmin":2004.0,"ymin":553.0,"xmax":2050.0,"ymax":858.0},{"id":32,"contenttext":"眞心そのものが、","xmin":2001.0,"ymin":865.0,"xmax":2051.0,"ymax":1174.0},{"id":33,"contenttext":"皇道の本質をなしてゐるのであります。","xmin":1997.0,"ymin":1183.0,"xmax":2049.0,"ymax":1886.0},{"id":34,"contenttext":"人の心は、","xmin":1990.0,"ymin":1894.0,"xmax":2044.0,"ymax":2083.0},{"id":35,"contenttext":"平","xmin":1993.0,"ymin":2095.0,"xmax":2042.0,"ymax":2144.0},{"id":36,"contenttext":"素はとかく利慾にとらはれ勝でありますが、","xmin":1925.0,"ymin":553.0,"xmax":1979.0,"ymax":1333.0},{"id":37,"contenttext":"一たび神明の前へ出ますると、","xmin":1922.0,"ymin":1352.0,"xmax":1973.0,"ymax":1890.0},{"id":38,"contenttext":"自然にその心","xmin":1921.0,"ymin":1897.0,"xmax":1967.0,"ymax":2140.0},{"id":39,"contenttext":"が至誠になるのであります。","xmin":1856.0,"ymin":555.0,"xmax":1905.0,"ymax":1055.0},{"id":40,"contenttext":"これは日本人だけではなく、","xmin":1855.0,"ymin":1067.0,"xmax":1901.0,"ymax":1563.0},{"id":41,"contenttext":"外國人もその感じを懷くと思は","xmin":1849.0,"ymin":1578.0,"xmax":1899.0,"ymax":2140.0},{"id":42,"contenttext":"れます。","xmin":1289.0,"ymin":564.0,"xmax":1335.0,"ymax":707.0},{"id":43,"contenttext":"甞て獨逸や、","xmin":1284.0,"ymin":716.0,"xmax":1331.0,"ymax":941.0},{"id":44,"contenttext":"伊太利の使節團など云ふのが來朝しまして、","xmin":1275.0,"ymin":952.0,"xmax":1332.0,"ymax":1739.0},{"id":45,"contenttext":"明治神宮、","xmin":1275.0,"ymin":1746.0,"xmax":1323.0,"ymax":1934.0},{"id":46,"contenttext":"靖國神社に","xmin":1274.0,"ymin":1942.0,"xmax":1321.0,"ymax":2147.0},{"id":47,"contenttext":"參拜しまして、","xmin":1214.0,"ymin":560.0,"xmax":1260.0,"ymax":826.0},{"id":48,"contenttext":"「我々ははじめて日本精神を知つたやうな感じを抱いた」","xmin":1199.0,"ymin":853.0,"xmax":1260.0,"ymax":1862.0},{"id":49,"contenttext":"と申しましたさ","xmin":1202.0,"ymin":1866.0,"xmax":1246.0,"ymax":2147.0},{"id":50,"contenttext":"うですが、外國人でも、","xmin":1137.0,"ymin":562.0,"xmax":1187.0,"ymax":982.0},{"id":51,"contenttext":"神前に出れば、","xmin":1133.0,"ymin":991.0,"xmax":1182.0,"ymax":1262.0},{"id":52,"contenttext":"自ら至誠の眞髓に觸れるものと思はれます。","xmin":1128.0,"ymin":1271.0,"xmax":1180.0,"ymax":2049.0},{"id":53,"contenttext":"まし","xmin":1136.0,"ymin":2061.0,"xmax":1170.0,"ymax":2144.0},{"id":54,"contenttext":"て日本人たるものに於いてをやであります。","xmin":1060.0,"ymin":562.0,"xmax":1118.0,"ymax":1333.0},{"id":55,"contenttext":"菅原道眞公の歌といふのに","xmin":1057.0,"ymin":1347.0,"xmax":1106.0,"ymax":1828.0},{"id":56,"contenttext":"心たに誠の道にかなひなは祈らすとても神や守らん","xmin":984.0,"ymin":677.0,"xmax":1040.0,"ymax":1591.0},{"id":57,"contenttext":"といふのがあります。","xmin":918.0,"ymin":558.0,"xmax":968.0,"ymax":938.0},{"id":58,"contenttext":"尤もこの歌は菅公のではないともいひ、疑問とせられて居りますが、","xmin":905.0,"ymin":948.0,"xmax":965.0,"ymax":2146.0},{"id":59,"contenttext":"或人が、","xmin":840.0,"ymin":553.0,"xmax":895.0,"ymax":698.0},{"id":60,"contenttext":"私は誠の心で生活してゐる、","xmin":836.0,"ymin":709.0,"xmax":890.0,"ymax":1217.0},{"id":61,"contenttext":"されば、","xmin":836.0,"ymin":1228.0,"xmax":885.0,"ymax":1370.0},{"id":62,"contenttext":"此の歌の通りで、","xmin":834.0,"ymin":1386.0,"xmax":884.0,"ymax":1692.0},{"id":63,"contenttext":"神樣には參らなくとも宜","xmin":831.0,"ymin":1703.0,"xmax":881.0,"ymax":2145.0},{"id":64,"contenttext":"しいと考へますが、","xmin":770.0,"ymin":555.0,"xmax":818.0,"ymax":897.0},{"id":65,"contenttext":"如何でせうと質問致しました。","xmin":764.0,"ymin":908.0,"xmax":813.0,"ymax":1448.0},{"id":66,"contenttext":"併し私は、","xmin":760.0,"ymin":1458.0,"xmax":811.0,"ymax":1646.0},{"id":67,"contenttext":"それは宜しくないと申しま","xmin":761.0,"ymin":1663.0,"xmax":806.0,"ymax":2145.0},{"id":68,"contenttext":"ぢ","xmin":724.0,"ymin":2049.0,"xmax":751.0,"ymax":2115.0},{"id":69,"contenttext":"した。","xmin":704.0,"ymin":554.0,"xmax":746.0,"ymax":658.0},{"id":70,"contenttext":"何故であるかと申しますると、","xmin":690.0,"ymin":670.0,"xmax":747.0,"ymax":1215.0},{"id":71,"contenttext":"一體神樣に參るのは、","xmin":690.0,"ymin":1232.0,"xmax":740.0,"ymax":1606.0},{"id":72,"contenttext":"卽ち敬神崇祖は、","xmin":686.0,"ymin":1618.0,"xmax":738.0,"ymax":1930.0},{"id":73,"contenttext":"神樣に徒ら","xmin":686.0,"ymin":1939.0,"xmax":734.0,"ymax":2144.0},{"id":74,"contenttext":"に一己の利益幸福を祈るためでは無いのであります。","xmin":609.0,"ymin":556.0,"xmax":690.0,"ymax":1488.0},{"id":75,"contenttext":"第一に肇國以來、","xmin":613.0,"ymin":1498.0,"xmax":665.0,"ymax":1810.0},{"id":76,"contenttext":"かゝる世界無比の","xmin":609.0,"ymin":1818.0,"xmax":664.0,"ymax":2141.0},{"id":77,"contenttext":"國家を肇められ、","xmin":549.0,"ymin":550.0,"xmax":599.0,"ymax":855.0},{"id":78,"contenttext":"發展せられましたことを、","xmin":545.0,"ymin":867.0,"xmax":597.0,"ymax":1330.0},{"id":79,"contenttext":"神樣に對して感謝するのであります。","xmin":539.0,"ymin":1342.0,"xmax":592.0,"ymax":2003.0},{"id":80,"contenttext":"報本反","xmin":536.0,"ymin":2017.0,"xmax":587.0,"ymax":2144.0},{"id":81,"contenttext":"始であります。","xmin":478.0,"ymin":548.0,"xmax":526.0,"ymax":811.0},{"id":82,"contenttext":"次に皇道の無限の發展を祈るのであります。","xmin":469.0,"ymin":825.0,"xmax":523.0,"ymax":1603.0},{"id":83,"contenttext":"卽ち至誠を致して神明に歸一","xmin":463.0,"ymin":1615.0,"xmax":516.0,"ymax":2130.0}]