[{"id":0,"contenttext":"皇國傳統の精神","xmin":2912.0,"ymin":756.0,"xmax":2946.0,"ymax":971.0},{"id":1,"contenttext":"三","xmin":2905.0,"ymin":2203.0,"xmax":2936.0,"ymax":2238.0},{"id":2,"contenttext":",","xmin":2871.0,"ymin":2258.0,"xmax":2885.0,"ymax":2275.0},{"id":3,"contenttext":"であります。","xmin":2844.0,"ymin":579.0,"xmax":2886.0,"ymax":769.0},{"id":4,"contenttext":"女性の御方であつてもさういふ風に勇敢だ。","xmin":2838.0,"ymin":781.0,"xmax":2888.0,"ymax":1457.0},{"id":5,"contenttext":"敵を恐れない精神が一般にあるのであります。","xmin":2832.0,"ymin":1466.0,"xmax":2880.0,"ymax":2177.0},{"id":6,"contenttext":"又須佐","xmin":2830.0,"ymin":2183.0,"xmax":2874.0,"ymax":2297.0},{"id":7,"contenttext":"之男命は最も勇敢な御方でありました。","xmin":2769.0,"ymin":576.0,"xmax":2819.0,"ymax":1181.0},{"id":8,"contenttext":"出雲にお出でになつてかの有名な八候大蛇を退治なさつたことは、","xmin":2761.0,"ymin":1191.0,"xmax":2815.0,"ymax":2210.0},{"id":9,"contenttext":"諸君","xmin":2762.0,"ymin":2215.0,"xmax":2808.0,"ymax":2295.0},{"id":10,"contenttext":"の御承知の通りであります。","xmin":2703.0,"ymin":580.0,"xmax":2750.0,"ymax":1007.0},{"id":11,"contenttext":"さういふものでも恐れずにそれを退治なさるといふ具合に、","xmin":2696.0,"ymin":1022.0,"xmax":2747.0,"ymax":1932.0},{"id":12,"contenttext":"昔の日本國民は全體に","xmin":2695.0,"ymin":1942.0,"xmax":2741.0,"ymax":2293.0},{"id":13,"contenttext":"於てこの義氣旺盛、","xmin":2637.0,"ymin":573.0,"xmax":2681.0,"ymax":872.0},{"id":14,"contenttext":"極めて勇敢の氣象に富んで居る。","xmin":2632.0,"ymin":880.0,"xmax":2682.0,"ymax":1385.0},{"id":15,"contenttext":"後世發展して所謂大和魂となるところの基礎が上代に旣に","xmin":2624.0,"ymin":1391.0,"xmax":2677.0,"ymax":2291.0},{"id":16,"contenttext":"現れて居るのであります。","xmin":2568.0,"ymin":575.0,"xmax":2614.0,"ymax":973.0},{"id":17,"contenttext":"かういふやうな精神が潜在的に日本國民にありましたが、","xmin":2493.0,"ymin":610.0,"xmax":2545.0,"ymax":1486.0},{"id":18,"contenttext":"それが段々發展して所謂皇國傳統の精神となつて參","xmin":2484.0,"ymin":1498.0,"xmax":2539.0,"ymax":2292.0},{"id":19,"contenttext":"る。","xmin":2434.0,"ymin":575.0,"xmax":2471.0,"ymax":626.0},{"id":20,"contenttext":"丁度支那に揚子江といふ川がありますが、","xmin":2425.0,"ymin":639.0,"xmax":2475.0,"ymax":1277.0},{"id":21,"contenttext":"揚子江といふやうな川は川の副でも三里も四里もあるといふこと","xmin":2417.0,"ymin":1288.0,"xmax":2468.0,"ymax":2290.0},{"id":22,"contenttext":"であります、","xmin":2365.0,"ymin":575.0,"xmax":2404.0,"ymax":762.0},{"id":23,"contenttext":"さういふ川などになると川だか海だが見當が付かぬ位であります。","xmin":2354.0,"ymin":777.0,"xmax":2404.0,"ymax":1793.0},{"id":24,"contenttext":"我國は國が小さいから川も皆小","xmin":2348.0,"ymin":1805.0,"xmax":2395.0,"ymax":2288.0},{"id":25,"contenttext":"さいのですが、","xmin":2295.0,"ymin":575.0,"xmax":2339.0,"ymax":800.0},{"id":26,"contenttext":"揚子江邊りは下から七百五十里位も汽船で上ることが出來るといふ、","xmin":2284.0,"ymin":807.0,"xmax":2337.0,"ymax":1860.0},{"id":27,"contenttext":"以て如何に大いなる川なる","xmin":2278.0,"ymin":1870.0,"xmax":2329.0,"ymax":2288.0},{"id":28,"contenttext":"かを知るべきであります。","xmin":2228.0,"ymin":573.0,"xmax":2268.0,"ymax":968.0},{"id":29,"contenttext":"その他御承知の通り地圖で見ますと、","xmin":2219.0,"ymin":981.0,"xmax":2269.0,"ymax":1551.0},{"id":30,"contenttext":"外國にはアフリカのナイル河、","xmin":2216.0,"ymin":1559.0,"xmax":2262.0,"ymax":2029.0},{"id":31,"contenttext":"アメリカのミシ","xmin":2214.0,"ymin":2044.0,"xmax":2256.0,"ymax":2285.0},{"id":32,"contenttext":"シツビー河、","xmin":2157.0,"ymin":575.0,"xmax":2200.0,"ymax":762.0},{"id":33,"contenttext":"アマゾン河とかいふやうな洋々たる大河がある。","xmin":2146.0,"ymin":775.0,"xmax":2203.0,"ymax":1513.0},{"id":34,"contenttext":"その洋々たる大河も源へ行きますとボタリ〓〓と","xmin":2142.0,"ymin":1528.0,"xmax":2194.0,"ymax":2285.0},{"id":35,"contenttext":"落ちる水です。","xmin":2089.0,"ymin":568.0,"xmax":2133.0,"ymax":797.0},{"id":36,"contenttext":"その山の中で〓水のやうになつてポタリ〓〓と落ちる水が下流になつて來ると洋々たる大河にな","xmin":2071.0,"ymin":809.0,"xmax":2131.0,"ymax":2286.0},{"id":37,"contenttext":"る。","xmin":2023.0,"ymin":571.0,"xmax":2059.0,"ymax":624.0},{"id":38,"contenttext":"この皇國傳統の精神も元はさういふ具合に潜在的になつて、","xmin":2010.0,"ymin":638.0,"xmax":2064.0,"ymax":1549.0},{"id":39,"contenttext":"チヨツトウツカリして居ると氣が付かぬやうで","xmin":2002.0,"ymin":1562.0,"xmax":2057.0,"ymax":2283.0},{"id":40,"contenttext":"ある。","xmin":1953.0,"ymin":569.0,"xmax":1990.0,"ymax":654.0},{"id":41,"contenttext":"併しそれが段々と發展して來て遂に今日のやうな大精神となつて參つて來て居るのであります。","xmin":1937.0,"ymin":667.0,"xmax":1994.0,"ymax":2129.0},{"id":42,"contenttext":"第一、","xmin":1881.0,"ymin":601.0,"xmax":1925.0,"ymax":691.0},{"id":43,"contenttext":"敬神崇祖","xmin":1876.0,"ymin":700.0,"xmax":1924.0,"ymax":844.0},{"id":44,"contenttext":"それがずつと發達して參りましていろ〓〓の方面になつて參りますが、","xmin":1803.0,"ymin":601.0,"xmax":1856.0,"ymax":1683.0},{"id":45,"contenttext":"その最も注意すべきは敬神崇祖であり","xmin":1796.0,"ymin":1693.0,"xmax":1845.0,"ymax":2281.0},{"id":46,"contenttext":"その最も注意すべきは敬神崇祖であり","xmin":1796.0,"ymin":1693.0,"xmax":1845.0,"ymax":2281.0},{"id":47,"contenttext":"ます。","xmin":1590.0,"ymin":552.0,"xmax":1629.0,"ymax":642.0},{"id":48,"contenttext":"それはどういふことであるかと言ひますと、","xmin":1584.0,"ymin":652.0,"xmax":1629.0,"ymax":1325.0},{"id":49,"contenttext":"只今申しましたやうに吾々日本國民は潜在的にその傳統の精","xmin":1583.0,"ymin":1338.0,"xmax":1632.0,"ymax":2272.0},{"id":50,"contenttext":"神を持つて居ります。","xmin":1514.0,"ymin":550.0,"xmax":1558.0,"ymax":880.0},{"id":51,"contenttext":"ところがそれがチョット分りませぬ。","xmin":1514.0,"ymin":894.0,"xmax":1558.0,"ymax":1461.0},{"id":52,"contenttext":"今日は日本精神といふものが非常に發展して非常に","xmin":1511.0,"ymin":1475.0,"xmax":1557.0,"ymax":2267.0},{"id":53,"contenttext":"大なる威力を持つて居るのでありますが、","xmin":1447.0,"ymin":550.0,"xmax":1489.0,"ymax":1186.0},{"id":54,"contenttext":"日本精神を知りたいと言つても今日でもチヨツト分りませぬでせう。","xmin":1444.0,"ymin":1202.0,"xmax":1491.0,"ymax":2247.0},{"id":55,"contenttext":"利根川といふ川、","xmin":1380.0,"ymin":550.0,"xmax":1424.0,"ymax":809.0},{"id":56,"contenttext":"石狩川といふ川が知りたいと思へば、","xmin":1378.0,"ymin":823.0,"xmax":1426.0,"ymax":1396.0},{"id":57,"contenttext":"そこ迄行つて見ればあゝこれが利根川か、","xmin":1378.0,"ymin":1406.0,"xmax":1424.0,"ymax":2046.0},{"id":58,"contenttext":"これが石狩","xmin":1378.0,"ymin":2060.0,"xmax":1424.0,"ymax":2270.0},{"id":59,"contenttext":"川かと直ぐ分る。","xmin":1309.0,"ymin":551.0,"xmax":1357.0,"ymax":812.0},{"id":60,"contenttext":"富士山が知りたいといふならば富士山に行つて見ればこれが富士山かといふことが直ぐ分る。","xmin":1310.0,"ymin":821.0,"xmax":1354.0,"ymax":2249.0},{"id":61,"contenttext":"ところが「ハハアこれが日本精神か」といふことはどこへ行つても分りますまい。","xmin":1243.0,"ymin":552.0,"xmax":1287.0,"ymax":1805.0},{"id":62,"contenttext":"けれどもこの日本精神といふ","xmin":1243.0,"ymin":1817.0,"xmax":1285.0,"ymax":2267.0},{"id":63,"contenttext":"ものが大切なものであります。","xmin":1174.0,"ymin":552.0,"xmax":1218.0,"ymax":1019.0},{"id":64,"contenttext":"吾々はそれを體驗して、","xmin":1174.0,"ymin":1028.0,"xmax":1218.0,"ymax":1394.0},{"id":65,"contenttext":"それに依つて吾々は行動しなければならない。","xmin":1171.0,"ymin":1406.0,"xmax":1219.0,"ymax":2119.0},{"id":66,"contenttext":"それをど","xmin":1172.0,"ymin":2126.0,"xmax":1214.0,"ymax":2267.0},{"id":67,"contenttext":"うして體驗したら宜いか、","xmin":1105.0,"ymin":550.0,"xmax":1149.0,"ymax":946.0},{"id":68,"contenttext":"今日は滿洲事變以來日本精神といふことが頻りと叫ばれて居りますけれども、","xmin":1103.0,"ymin":960.0,"xmax":1151.0,"ymax":2147.0},{"id":69,"contenttext":"これは","xmin":1103.0,"ymin":2164.0,"xmax":1147.0,"ymax":2268.0},{"id":70,"contenttext":"今日に始つたものではありませぬ。","xmin":1036.0,"ymin":550.0,"xmax":1079.0,"ymax":1082.0},{"id":71,"contenttext":"勿論太古から皇國傳統の精神といふものが今申しましたやうに潜在的にある","xmin":1035.0,"ymin":1098.0,"xmax":1080.0,"ymax":2268.0},{"id":72,"contenttext":"のです。","xmin":969.0,"ymin":553.0,"xmax":1013.0,"ymax":675.0},{"id":73,"contenttext":"ところが日本國民である以上はそれを體現しなくてはこの世に生存が出來ない。","xmin":968.0,"ymin":686.0,"xmax":1013.0,"ymax":1907.0},{"id":74,"contenttext":"大正十二年の關東大震","xmin":965.0,"ymin":1918.0,"xmax":1012.0,"ymax":2268.0},{"id":75,"contenttext":"災の時に東京は御承知の通りあゝいふことになつた。","xmin":898.0,"ymin":548.0,"xmax":945.0,"ymax":1359.0},{"id":76,"contenttext":"神田の方に私の以前の〓子があります。","xmin":897.0,"ymin":1366.0,"xmax":943.0,"ymax":1978.0},{"id":77,"contenttext":"それは大きな旅館","xmin":897.0,"ymin":1988.0,"xmax":941.0,"ymax":2268.0},{"id":78,"contenttext":"を經營して居るのですが、","xmin":830.0,"ymin":550.0,"xmax":874.0,"ymax":946.0},{"id":79,"contenttext":"そこらの家はみな燒けた。","xmin":830.0,"ymin":957.0,"xmax":876.0,"ymax":1359.0},{"id":80,"contenttext":"その時のことをその〓子が申しますのに、","xmin":827.0,"ymin":1371.0,"xmax":874.0,"ymax":2009.0},{"id":81,"contenttext":"私は日比谷公園","xmin":827.0,"ymin":2020.0,"xmax":871.0,"ymax":2267.0},{"id":82,"contenttext":"の方に避難しましたと言ふ。","xmin":760.0,"ymin":550.0,"xmax":805.0,"ymax":980.0},{"id":83,"contenttext":"ところがあの神田の方から日比谷公園の方にずつと何萬人といふ人がみな避難して","xmin":756.0,"ymin":994.0,"xmax":806.0,"ymax":2265.0},{"id":84,"contenttext":"行くのです。","xmin":689.0,"ymin":546.0,"xmax":735.0,"ymax":742.0},{"id":85,"contenttext":"ドウ〓〓〓〓と避難して行くのでせう。","xmin":688.0,"ymin":751.0,"xmax":737.0,"ymax":1357.0},{"id":86,"contenttext":"ところがその中で一人でも僕は日比谷を止めて上野にしよ","xmin":689.0,"ymin":1369.0,"xmax":731.0,"ymax":2265.0},{"id":87,"contenttext":"うといふ具合で反對に行かうと思つてもそれは行かれませぬ。","xmin":622.0,"ymin":539.0,"xmax":671.0,"ymax":1493.0},{"id":88,"contenttext":"さうでせう、十萬人、二十萬人の人がドウくく","xmin":624.0,"ymin":1506.0,"xmax":666.0,"ymax":2260.0},{"id":89,"contenttext":"と行くその中で一人だつて僕はこつちへ行かうと言つたつて行かれますか。","xmin":552.0,"ymin":546.0,"xmax":602.0,"ymax":1697.0},{"id":90,"contenttext":"そんなことをしたら突き飛ばされて","xmin":553.0,"ymin":1708.0,"xmax":597.0,"ymax":2261.0},{"id":91,"contenttext":"三","xmin":494.0,"ymin":2171.0,"xmax":525.0,"ymax":2205.0},{"id":92,"contenttext":"皇國傳統の精神","xmin":494.0,"ymin":728.0,"xmax":531.0,"ymax":941.0}]