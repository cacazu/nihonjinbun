[{"id":0,"contenttext":"二〇","xmin":2899.0,"ymin":2189.0,"xmax":2931.0,"ymax":2228.0},{"id":1,"contenttext":"皇國傳統の精神","xmin":2896.0,"ymin":744.0,"xmax":2935.0,"ymax":959.0},{"id":2,"contenttext":"\"","xmin":2862.0,"ymin":1013.0,"xmax":2882.0,"ymax":1050.0},{"id":3,"contenttext":"さふいう具合にこの神能盤境といふのが神社の起りであります。","xmin":2827.0,"ymin":603.0,"xmax":2883.0,"ymax":1583.0},{"id":4,"contenttext":"そしてその屋代と御屋とは後世には社を宮と","xmin":2825.0,"ymin":1593.0,"xmax":2868.0,"ymax":2284.0},{"id":5,"contenttext":"言ひ、","xmin":2762.0,"ymin":566.0,"xmax":2804.0,"ymax":657.0},{"id":6,"contenttext":"宮を社と言ふやうになつて一〓になつて終いました。","xmin":2758.0,"ymin":666.0,"xmax":2807.0,"ymax":1481.0},{"id":7,"contenttext":"けれども初めはチヤンと區別があつた譯でありま","xmin":2757.0,"ymin":1489.0,"xmax":2802.0,"ymax":2286.0},{"id":8,"contenttext":"す。","xmin":2693.0,"ymin":566.0,"xmax":2734.0,"ymax":624.0},{"id":9,"contenttext":"さういふわけで先きに申しましたところの、","xmin":2688.0,"ymin":634.0,"xmax":2734.0,"ymax":1304.0},{"id":10,"contenttext":"日本國民の偉大なる御方を神社に祭つて、","xmin":2686.0,"ymin":1320.0,"xmax":2734.0,"ymax":1960.0},{"id":11,"contenttext":"さうしてそれに依つ","xmin":2686.0,"ymin":1974.0,"xmax":2730.0,"ymax":2282.0},{"id":12,"contenttext":"て吾々が日本精神を體現して吾々の日々の道を行つて行かうといふことが卽ち我國で皇道と言ひ、","xmin":2617.0,"ymin":569.0,"xmax":2668.0,"ymax":2062.0},{"id":13,"contenttext":"又神道と言ふ","xmin":2619.0,"ymin":2073.0,"xmax":2663.0,"ymax":2284.0},{"id":14,"contenttext":"ところのものであります。","xmin":2554.0,"ymin":566.0,"xmax":2596.0,"ymax":964.0},{"id":15,"contenttext":"さういふ道に依つて吾々が日々御飯を食べて居ますやうに、","xmin":2552.0,"ymin":976.0,"xmax":2598.0,"ymax":1889.0},{"id":16,"contenttext":"我が國民の理想を實現せ","xmin":2550.0,"ymin":1902.0,"xmax":2596.0,"ymax":2284.0},{"id":17,"contenttext":"んとするのであります。","xmin":2487.0,"ymin":568.0,"xmax":2529.0,"ymax":929.0},{"id":18,"contenttext":"第二、","xmin":2422.0,"ymin":597.0,"xmax":2464.0,"ymax":691.0},{"id":19,"contenttext":"皇室の尊嚴","xmin":2420.0,"ymin":701.0,"xmax":2466.0,"ymax":881.0},{"id":20,"contenttext":"これから皇室の尊嚴といふことに就て申上げます。","xmin":2351.0,"ymin":599.0,"xmax":2397.0,"ymax":1375.0},{"id":21,"contenttext":"〓育が明治時代に西洋から日本に傳つて來ました時に、","xmin":2346.0,"ymin":1383.0,"xmax":2398.0,"ymax":2233.0},{"id":22,"contenttext":"ヘ","xmin":2356.0,"ymin":2252.0,"xmax":2385.0,"ymax":2275.0},{"id":23,"contenttext":"ルバルトの〓育學といふものが廣く行はれました。","xmin":2282.0,"ymin":566.0,"xmax":2328.0,"ymax":1341.0},{"id":24,"contenttext":"そのヘルバルトの〓育學の中に開化史的段階、","xmin":2279.0,"ymin":1351.0,"xmax":2327.0,"ymax":2060.0},{"id":25,"contenttext":"或は文化史的","xmin":2277.0,"ymin":2071.0,"xmax":2323.0,"ymax":2284.0},{"id":26,"contenttext":"段階、","xmin":2212.0,"ymin":560.0,"xmax":2260.0,"ymax":653.0},{"id":27,"contenttext":"かういふものがあることは〓育學をおやりになつた方は御承知のことゝ思ひます。","xmin":2212.0,"ymin":666.0,"xmax":2256.0,"ymax":1920.0},{"id":28,"contenttext":"この開化史的段階とい","xmin":2208.0,"ymin":1936.0,"xmax":2254.0,"ymax":2281.0},{"id":29,"contenttext":"ふのはどういふのであるかと申しますと、","xmin":2143.0,"ymin":564.0,"xmax":2185.0,"ymax":1200.0},{"id":30,"contenttext":"〓授の材料を配列しますのに、","xmin":2139.0,"ymin":1212.0,"xmax":2188.0,"ymax":1683.0},{"id":31,"contenttext":"人間の一人の發達といふものは、","xmin":2140.0,"ymin":1694.0,"xmax":2184.0,"ymax":2196.0},{"id":32,"contenttext":"種族","xmin":2138.0,"ymin":2205.0,"xmax":2184.0,"ymax":2282.0},{"id":33,"contenttext":"の發達と並行するものであるといふ原則から成り立つて居る。","xmin":2072.0,"ymin":566.0,"xmax":2117.0,"ymax":1509.0},{"id":34,"contenttext":"卽ち一個人に就いて見ても、","xmin":2073.0,"ymin":1519.0,"xmax":2115.0,"ymax":1956.0},{"id":35,"contenttext":"赤ん坊などは鼻など","xmin":2070.0,"ymin":1967.0,"xmax":2114.0,"ymax":2281.0},{"id":36,"contenttext":"はペチヤンコのやうになつて居りまして、","xmin":2007.0,"ymin":562.0,"xmax":2050.0,"ymax":1200.0},{"id":37,"contenttext":"唯々眼と口とが付いて居るやうに見えますが、","xmin":2006.0,"ymin":1213.0,"xmax":2051.0,"ymax":1921.0},{"id":38,"contenttext":"それが段々と成長する","xmin":2006.0,"ymin":1932.0,"xmax":2048.0,"ymax":2281.0},{"id":39,"contenttext":"に從つて目許もパツチリして來ます。","xmin":1941.0,"ymin":562.0,"xmax":1982.0,"ymax":1133.0},{"id":40,"contenttext":"鼻も高くなつて來ます、","xmin":1936.0,"ymin":1142.0,"xmax":1982.0,"ymax":1509.0},{"id":41,"contenttext":"眉毛も濃くなつて來ます。","xmin":1937.0,"ymin":1521.0,"xmax":1979.0,"ymax":1920.0},{"id":42,"contenttext":"それで立派な顏が出來","xmin":1937.0,"ymin":1933.0,"xmax":1983.0,"ymax":2282.0},{"id":43,"contenttext":"て來る。さういふ具合に一般に古代人は顏形が整つて居らぬ。文明人になる程非常に美しくなる。","xmin":1868.0,"ymin":564.0,"xmax":1918.0,"ymax":2022.0},{"id":44,"contenttext":"精神も亦小さい","xmin":1868.0,"ymin":2034.0,"xmax":1912.0,"ymax":2279.0},{"id":45,"contenttext":"子供の時には猿蟹合戰とか、","xmin":1801.0,"ymin":560.0,"xmax":1847.0,"ymax":994.0},{"id":46,"contenttext":"桃太郞の鬼ケ島征伐ー犬が團子一つ下さい、","xmin":1798.0,"ymin":1004.0,"xmax":1847.0,"ymax":1678.0},{"id":47,"contenttext":"お供しませうと言つた。","xmin":1798.0,"ymin":1694.0,"xmax":1844.0,"ymax":2059.0},{"id":48,"contenttext":"かういふ風な","xmin":1800.0,"ymin":2071.0,"xmax":1840.0,"ymax":2280.0},{"id":49,"contenttext":"話を話すと子供に非常によく分る。","xmin":1609.0,"ymin":562.0,"xmax":1656.0,"ymax":1100.0},{"id":50,"contenttext":"それで西洋ではメルヘン","xmin":1607.0,"ymin":1112.0,"xmax":1653.0,"ymax":1493.0},{"id":51,"contenttext":"(童話)","xmin":1606.0,"ymin":1499.0,"xmax":1649.0,"ymax":1619.0},{"id":52,"contenttext":"と言ひまして、","xmin":1604.0,"ymin":1626.0,"xmax":1646.0,"ymax":1852.0},{"id":53,"contenttext":"さういふやうなもので〓育","xmin":1600.0,"ymin":1868.0,"xmax":1644.0,"ymax":2282.0},{"id":54,"contenttext":"して行かうといふのであります。","xmin":1540.0,"ymin":564.0,"xmax":1589.0,"ymax":1063.0},{"id":55,"contenttext":"それから段々と發達して來るに從つて、","xmin":1537.0,"ymin":1075.0,"xmax":1586.0,"ymax":1680.0},{"id":56,"contenttext":"高尙なる材料に進み、","xmin":1534.0,"ymin":1690.0,"xmax":1583.0,"ymax":2023.0},{"id":57,"contenttext":"遂には哲學など","xmin":1531.0,"ymin":2033.0,"xmax":1580.0,"ymax":2281.0},{"id":58,"contenttext":"の話をしても理解されて來る。","xmin":1472.0,"ymin":565.0,"xmax":1522.0,"ymax":1030.0},{"id":59,"contenttext":"それを幼稚園などに居る四つや五つの子供に對して、","xmin":1466.0,"ymin":1041.0,"xmax":1517.0,"ymax":1853.0},{"id":60,"contenttext":"宇宙がどうだ、","xmin":1466.0,"ymin":1863.0,"xmax":1512.0,"ymax":2092.0},{"id":61,"contenttext":"世界の本體","xmin":1463.0,"ymin":2104.0,"xmax":1511.0,"ymax":2283.0},{"id":62,"contenttext":"がどうだ、","xmin":1408.0,"ymin":562.0,"xmax":1455.0,"ymax":721.0},{"id":63,"contenttext":"アインシユタインの相對性原理がどうだと言つても、","xmin":1402.0,"ymin":733.0,"xmax":1451.0,"ymax":1541.0},{"id":64,"contenttext":"譯は分りませぬ。","xmin":1401.0,"ymin":1555.0,"xmax":1445.0,"ymax":1819.0},{"id":65,"contenttext":"何のことだかチンプンカンで","xmin":1396.0,"ymin":1828.0,"xmax":1444.0,"ymax":2279.0},{"id":66,"contenttext":"す。","xmin":1345.0,"ymin":562.0,"xmax":1385.0,"ymax":619.0},{"id":67,"contenttext":"それに反して桃太郞が鬼ケ島を征伐に行かうとした。","xmin":1333.0,"ymin":627.0,"xmax":1386.0,"ymax":1442.0},{"id":68,"contenttext":"ところが犬が團子一つ下さればお供しやうと言つた、","xmin":1328.0,"ymin":1452.0,"xmax":1379.0,"ymax":2263.0},{"id":69,"contenttext":"といふやうなことを話しますと、","xmin":1268.0,"ymin":562.0,"xmax":1314.0,"ymax":1061.0},{"id":70,"contenttext":"直ぐ耳を澄まして聞きます。","xmin":1264.0,"ymin":1073.0,"xmax":1312.0,"ymax":1507.0},{"id":71,"contenttext":"さういふ具合に個人の發達といふものが種族の發","xmin":1259.0,"ymin":1521.0,"xmax":1310.0,"ymax":2283.0},{"id":72,"contenttext":"達といふものと並行するものだと言ふ。","xmin":1198.0,"ymin":558.0,"xmax":1248.0,"ymax":1165.0},{"id":73,"contenttext":"此の原理を應用したのが、","xmin":1194.0,"ymin":1175.0,"xmax":1243.0,"ymax":1574.0},{"id":74,"contenttext":"開化史的段階といふのであります。","xmin":1189.0,"ymin":1584.0,"xmax":1240.0,"ymax":2124.0},{"id":75,"contenttext":"さう云ふ","xmin":1191.0,"ymin":2136.0,"xmax":1234.0,"ymax":2275.0},{"id":76,"contenttext":"次第で上代に於きましては、","xmin":1133.0,"ymin":559.0,"xmax":1179.0,"ymax":994.0},{"id":77,"contenttext":"猿がものを言つたり、","xmin":1128.0,"ymin":1003.0,"xmax":1178.0,"ymax":1335.0},{"id":78,"contenttext":"兎がものを言つたりする話が興味を以て愉快に感ぜられるの","xmin":1120.0,"ymin":1346.0,"xmax":1174.0,"ymax":2277.0},{"id":79,"contenttext":"です。","xmin":1065.0,"ymin":559.0,"xmax":1113.0,"ymax":654.0},{"id":80,"contenttext":"そこで我國に於ても上代には、","xmin":1063.0,"ymin":661.0,"xmax":1109.0,"ymax":1128.0},{"id":81,"contenttext":"先刻申したところの偉い神樣が人民を〓化せられるのに、","xmin":1052.0,"ymin":1142.0,"xmax":1107.0,"ymax":2018.0},{"id":82,"contenttext":"矢張りさういふ","xmin":1053.0,"ymin":2030.0,"xmax":1097.0,"ymax":2274.0},{"id":83,"contenttext":"物語を以てせられたのであります。","xmin":993.0,"ymin":557.0,"xmax":1043.0,"ymax":1093.0},{"id":84,"contenttext":"それでありますから、『古事記』","xmin":988.0,"ymin":1107.0,"xmax":1037.0,"ymax":1579.0},{"id":85,"contenttext":"や","xmin":991.0,"ymin":1584.0,"xmax":1029.0,"ymax":1626.0},{"id":86,"contenttext":"『日本書紀』","xmin":988.0,"ymin":1630.0,"xmax":1033.0,"ymax":1817.0},{"id":87,"contenttext":"の上代に書いてありますのは","xmin":985.0,"ymin":1828.0,"xmax":1032.0,"ymax":2277.0},{"id":88,"contenttext":"さういふ物語が色々入れてありまして、","xmin":921.0,"ymin":560.0,"xmax":972.0,"ymax":1160.0},{"id":89,"contenttext":"その中には偉大なる日本精神、","xmin":917.0,"ymin":1175.0,"xmax":969.0,"ymax":1640.0},{"id":90,"contenttext":"偉大なる皇道の精神が養成されて來て居","xmin":916.0,"ymin":1653.0,"xmax":961.0,"ymax":2277.0},{"id":91,"contenttext":"るのであります。","xmin":858.0,"ymin":557.0,"xmax":901.0,"ymax":818.0},{"id":92,"contenttext":"それを先づ前提にして、","xmin":857.0,"ymin":830.0,"xmax":901.0,"ymax":1195.0},{"id":93,"contenttext":"皇室の尊嚴といふ傳統の精神が上代に旣に早く培はれて來たといふこ","xmin":846.0,"ymin":1207.0,"xmax":900.0,"ymax":2274.0},{"id":94,"contenttext":"とを申上げたいのであります。","xmin":788.0,"ymin":557.0,"xmax":835.0,"ymax":1021.0},{"id":95,"contenttext":"それには先づ皇室、","xmin":723.0,"ymin":590.0,"xmax":768.0,"ymax":887.0},{"id":96,"contenttext":"卽ち天照大御神樣に依つて肇められましたところの皇室の尊嚴、","xmin":710.0,"ymin":895.0,"xmax":767.0,"ymax":1879.0},{"id":97,"contenttext":"これは天照大御神樣が第","xmin":712.0,"ymin":1895.0,"xmax":758.0,"ymax":2274.0},{"id":98,"contenttext":"一に國民から非常に神聖に認識せられておいでになつたといふことであります。","xmin":641.0,"ymin":564.0,"xmax":701.0,"ymax":1777.0},{"id":99,"contenttext":"例へば先刻もお話した須佐之男","xmin":643.0,"ymin":1785.0,"xmax":689.0,"ymax":2274.0},{"id":100,"contenttext":"命が出雲の國にお出でになりました。","xmin":580.0,"ymin":553.0,"xmax":633.0,"ymax":1127.0},{"id":101,"contenttext":"出雲の國の肥の河の方を段々と上つてお出でになると、","xmin":574.0,"ymin":1133.0,"xmax":625.0,"ymax":1979.0},{"id":102,"contenttext":"上から箸が流れて","xmin":575.0,"ymin":1990.0,"xmax":620.0,"ymax":2270.0},{"id":103,"contenttext":"二","xmin":516.0,"ymin":2171.0,"xmax":544.0,"ymax":2207.0},{"id":104,"contenttext":"皇國傳統の精神","xmin":519.0,"ymin":733.0,"xmax":560.0,"ymax":947.0}]