[{"id":0,"contenttext":"皇國傳統の精神","xmin":2954.0,"ymin":756.0,"xmax":2991.0,"ymax":968.0},{"id":1,"contenttext":"층","xmin":2935.0,"ymin":2193.0,"xmax":2970.0,"ymax":2233.0},{"id":2,"contenttext":"なりました。","xmin":2883.0,"ymin":576.0,"xmax":2929.0,"ymax":768.0},{"id":3,"contenttext":"すると「仕へ奉ります」","xmin":2878.0,"ymin":775.0,"xmax":2932.0,"ymax":1153.0},{"id":4,"contenttext":"と皆申しました。","xmin":2874.0,"ymin":1154.0,"xmax":2922.0,"ymax":1417.0},{"id":5,"contenttext":"ところがその中に海鼠が一つ返事をしない。","xmin":2863.0,"ymin":1429.0,"xmax":2921.0,"ymax":2105.0},{"id":6,"contenttext":"それで天宇","xmin":2862.0,"ymin":2113.0,"xmax":2908.0,"ymax":2291.0},{"id":7,"contenttext":"受賣命が女性の持つ小さい刀を以て海鼠の口を「この口が答をせぬ口か」","xmin":2802.0,"ymin":572.0,"xmax":2863.0,"ymax":1698.0},{"id":8,"contenttext":"とお拆きになつた。","xmin":2797.0,"ymin":1702.0,"xmax":2846.0,"ymax":2001.0},{"id":9,"contenttext":"それで海鼠の口が","xmin":2795.0,"ymin":2013.0,"xmax":2841.0,"ymax":2291.0},{"id":10,"contenttext":"今日でも拆けて居るのだ、","xmin":2743.0,"ymin":572.0,"xmax":2794.0,"ymax":971.0},{"id":11,"contenttext":"かういふ傳說であります。","xmin":2742.0,"ymin":983.0,"xmax":2785.0,"ymax":1382.0},{"id":12,"contenttext":"宜うございますか、","xmin":2735.0,"ymin":1394.0,"xmax":2783.0,"ymax":1691.0},{"id":13,"contenttext":"これは曩に申しました通り傳說であり","xmin":2725.0,"ymin":1706.0,"xmax":2778.0,"ymax":2290.0},{"id":14,"contenttext":"ます。","xmin":2683.0,"ymin":573.0,"xmax":2723.0,"ymax":663.0},{"id":15,"contenttext":"これに依つて〓訓を施し、","xmin":2675.0,"ymin":679.0,"xmax":2721.0,"ymax":1075.0},{"id":16,"contenttext":"これに依つて國民を〓化せられたので、","xmin":2663.0,"ymin":1089.0,"xmax":2718.0,"ymax":1692.0},{"id":17,"contenttext":"そのお積りでお聞きになり、","xmin":2658.0,"ymin":1702.0,"xmax":2707.0,"ymax":2133.0},{"id":18,"contenttext":"又御覽に","xmin":2660.0,"ymin":2145.0,"xmax":2702.0,"ymax":2289.0},{"id":19,"contenttext":"ならなければならぬ。","xmin":2610.0,"ymin":573.0,"xmax":2651.0,"ymax":899.0},{"id":20,"contenttext":"上代の人は實際魚がものを言ふといふことを考へた。","xmin":2595.0,"ymin":912.0,"xmax":2652.0,"ymax":1726.0},{"id":21,"contenttext":"ところが海鼠の口の拆けたのはさう","xmin":2586.0,"ymin":1736.0,"xmax":2640.0,"ymax":2288.0},{"id":22,"contenttext":"いふ譯だといふ具合に聞いて居る。","xmin":2535.0,"ymin":576.0,"xmax":2591.0,"ymax":1107.0},{"id":23,"contenttext":"それが信仰されて居る。","xmin":2527.0,"ymin":1118.0,"xmax":2585.0,"ymax":1483.0},{"id":24,"contenttext":"さうして見るとそんな禽獸蟲魚に至る迄皇室の爲に","xmin":2519.0,"ymin":1496.0,"xmax":2579.0,"ymax":2288.0},{"id":25,"contenttext":"忠節を盡すのである。","xmin":2468.0,"ymin":570.0,"xmax":2520.0,"ymax":903.0},{"id":26,"contenttext":"況んや吾々人間に於てをやといふ觀念が、","xmin":2459.0,"ymin":911.0,"xmax":2514.0,"ymax":1553.0},{"id":27,"contenttext":"上代の國民に深く、","xmin":2454.0,"ymin":1563.0,"xmax":2506.0,"ymax":1860.0},{"id":28,"contenttext":"且つ强く印象されて來て居","xmin":2451.0,"ymin":1870.0,"xmax":2500.0,"ymax":2290.0},{"id":29,"contenttext":"る。","xmin":2409.0,"ymin":571.0,"xmax":2444.0,"ymax":624.0},{"id":30,"contenttext":"それが卽ち我が傳統の精神となつて、","xmin":2395.0,"ymin":638.0,"xmax":2449.0,"ymax":1211.0},{"id":31,"contenttext":"苟くも大日本の國に居るところの者は禽獸蟲魚悉く皇室中心で、","xmin":2380.0,"ymin":1219.0,"xmax":2442.0,"ymax":2202.0},{"id":32,"contenttext":"皇室","xmin":2383.0,"ymin":2212.0,"xmax":2427.0,"ymax":2289.0},{"id":33,"contenttext":"の爲に盡忠報國をするものであるといふことが分つた。","xmin":2323.0,"ymin":574.0,"xmax":2383.0,"ymax":1416.0},{"id":34,"contenttext":"それでありますから、","xmin":2321.0,"ymin":1426.0,"xmax":2368.0,"ymax":1754.0},{"id":35,"contenttext":"崇神天皇樣の時には曩に申しまし","xmin":2311.0,"ymin":1764.0,"xmax":2366.0,"ymax":2290.0},{"id":36,"contenttext":"たやうに、","xmin":2268.0,"ymin":571.0,"xmax":2309.0,"ymax":724.0},{"id":37,"contenttext":"大和の笠縫邑に天照大御神樣を御祭りし、","xmin":2256.0,"ymin":740.0,"xmax":2310.0,"ymax":1380.0},{"id":38,"contenttext":"その次の垂仁天皇樣の時にはこれを伊勢の五十鈴川の上流","xmin":2243.0,"ymin":1390.0,"xmax":2301.0,"ymax":2288.0},{"id":39,"contenttext":"に御祭りになつて今日の伊勢の大神宮樣の基が出來たのであります。","xmin":2185.0,"ymin":571.0,"xmax":2244.0,"ymax":1618.0},{"id":40,"contenttext":"さういふ具合にして段々とその皇國傳統の","xmin":2178.0,"ymin":1630.0,"xmax":2228.0,"ymax":2284.0},{"id":41,"contenttext":"精神が養成され、","xmin":2129.0,"ymin":565.0,"xmax":2178.0,"ymax":829.0},{"id":42,"contenttext":"皇室中心の思想が徹底して參つたのであります。","xmin":2117.0,"ymin":837.0,"xmax":2174.0,"ymax":1585.0},{"id":43,"contenttext":"第六、","xmin":2057.0,"ymin":597.0,"xmax":2104.0,"ymax":688.0},{"id":44,"contenttext":"和魂漢才","xmin":2056.0,"ymin":703.0,"xmax":2104.0,"ymax":845.0},{"id":45,"contenttext":"それが皇國傳統の精神はすべての外來思想を純化し、","xmin":1979.0,"ymin":601.0,"xmax":2036.0,"ymax":1410.0},{"id":46,"contenttext":"廣く之れを取り入れると云ふことであります。","xmin":1970.0,"ymin":1420.0,"xmax":2024.0,"ymax":2129.0},{"id":47,"contenttext":"之れは和","xmin":1969.0,"ymin":2141.0,"xmax":2015.0,"ymax":2282.0},{"id":48,"contenttext":"魂漢才と云ふ言葉がよく示して居ります。","xmin":1913.0,"ymin":565.0,"xmax":1968.0,"ymax":1204.0},{"id":49,"contenttext":"一番初に外國から參つたのが儒〓であります。","xmin":1902.0,"ymin":1219.0,"xmax":1960.0,"ymax":1924.0},{"id":50,"contenttext":"儒〓は應神天皇の時に","xmin":1902.0,"ymin":1933.0,"xmax":1948.0,"ymax":2282.0},{"id":51,"contenttext":"阿直岐、","xmin":1852.0,"ymin":562.0,"xmax":1899.0,"ymax":690.0},{"id":52,"contenttext":"王仁といふのが來て之れを傳へたといふのでありますが、","xmin":1842.0,"ymin":701.0,"xmax":1897.0,"ymax":1580.0},{"id":53,"contenttext":"勿論それより先きに儒〓は傳つて居つたこと","xmin":1834.0,"ymin":1591.0,"xmax":1884.0,"ymax":2283.0},{"id":54,"contenttext":"ゝ考へられます。","xmin":1600.0,"ymin":564.0,"xmax":1643.0,"ymax":820.0},{"id":55,"contenttext":"それで應神天皇の時には盛に儒〓が我國に傳へられて來たのであります。","xmin":1591.0,"ymin":830.0,"xmax":1645.0,"ymax":1953.0},{"id":56,"contenttext":"その儒〓はどういふ","xmin":1592.0,"ymin":1962.0,"xmax":1634.0,"ymax":2274.0},{"id":57,"contenttext":"のであるかと言ひますと、","xmin":1529.0,"ymin":560.0,"xmax":1576.0,"ymax":954.0},{"id":58,"contenttext":"申す迄もなく支那の〓へであります。","xmin":1524.0,"ymin":966.0,"xmax":1573.0,"ymax":1537.0},{"id":59,"contenttext":"支那といふ國は早くから文字が出來て、","xmin":1520.0,"ymin":1549.0,"xmax":1572.0,"ymax":2158.0},{"id":60,"contenttext":"早くか","xmin":1521.0,"ymin":2164.0,"xmax":1562.0,"ymax":2273.0},{"id":61,"contenttext":"ら學術の發達した國でありますから、","xmin":1461.0,"ymin":557.0,"xmax":1508.0,"ymax":1125.0},{"id":62,"contenttext":"儒〓といふ〓は實に論理的、","xmin":1458.0,"ymin":1137.0,"xmax":1506.0,"ymax":1571.0},{"id":63,"contenttext":"普遍的で而して哲學的、","xmin":1456.0,"ymin":1583.0,"xmax":1502.0,"ymax":1948.0},{"id":64,"contenttext":"倫理的、","xmin":1456.0,"ymin":1960.0,"xmax":1499.0,"ymax":2087.0},{"id":65,"contenttext":"政治的、","xmin":1450.0,"ymin":2097.0,"xmax":1499.0,"ymax":2225.0},{"id":66,"contenttext":"總","xmin":1452.0,"ymin":2233.0,"xmax":1496.0,"ymax":2277.0},{"id":67,"contenttext":"ての方面の學術として發達して居りました。","xmin":1393.0,"ymin":557.0,"xmax":1440.0,"ymax":1229.0},{"id":68,"contenttext":"ところが我國は已に申しました通り、","xmin":1390.0,"ymin":1242.0,"xmax":1436.0,"ymax":1808.0},{"id":69,"contenttext":"神ながら言擧げせぬ國で、","xmin":1383.0,"ymin":1820.0,"xmax":1436.0,"ymax":2223.0},{"id":70,"contenttext":"而","xmin":1384.0,"ymin":2231.0,"xmax":1429.0,"ymax":2277.0},{"id":71,"contenttext":"かも右のやうな傳統の大精神があります。","xmin":1321.0,"ymin":557.0,"xmax":1373.0,"ymax":1195.0},{"id":72,"contenttext":"けれどもその大精神を一々學理で〓究して國民に示すのでない。","xmin":1314.0,"ymin":1204.0,"xmax":1370.0,"ymax":2191.0},{"id":73,"contenttext":"天地","xmin":1315.0,"ymin":2194.0,"xmax":1361.0,"ymax":2274.0},{"id":74,"contenttext":"正大の氣粹然として神州に鍾る。","xmin":1257.0,"ymin":555.0,"xmax":1301.0,"ymax":1058.0},{"id":75,"contenttext":"秀でゝは不二の獄とあり、巍々として千秋に登ゆ。","xmin":1250.0,"ymin":1070.0,"xmax":1298.0,"ymax":1824.0},{"id":76,"contenttext":"注ぎては大瀛の水となり、洋","xmin":1248.0,"ymin":1837.0,"xmax":1292.0,"ymax":2274.0},{"id":77,"contenttext":"々として八州を環る。","xmin":1190.0,"ymin":559.0,"xmax":1232.0,"ymax":882.0},{"id":78,"contenttext":"發しては萬朶の櫻となり、","xmin":1184.0,"ymin":904.0,"xmax":1231.0,"ymax":1300.0},{"id":79,"contenttext":"衆芳與に儔し難し。","xmin":1184.0,"ymin":1324.0,"xmax":1228.0,"ymax":1623.0},{"id":80,"contenttext":"凝りては百鍊の鐵とあり、","xmin":1180.0,"ymin":1641.0,"xmax":1227.0,"ymax":2041.0},{"id":81,"contenttext":"銳利養を斷つ","xmin":1181.0,"ymin":2060.0,"xmax":1225.0,"ymax":2272.0},{"id":82,"contenttext":"べし。","xmin":1126.0,"ymin":553.0,"xmax":1162.0,"ymax":642.0},{"id":83,"contenttext":"さういふ具合に皇國傳統の精神といふものがずつと澎湃として發達して來て居るのであります。","xmin":1110.0,"ymin":655.0,"xmax":1166.0,"ymax":2117.0},{"id":84,"contenttext":"けれども","xmin":1112.0,"ymin":2127.0,"xmax":1153.0,"ymax":2272.0},{"id":85,"contenttext":"それを學術的に說明してはない。","xmin":1050.0,"ymin":553.0,"xmax":1099.0,"ymax":1051.0},{"id":86,"contenttext":"神ながら言擧げせぬ國、","xmin":1050.0,"ymin":1065.0,"xmax":1095.0,"ymax":1429.0},{"id":87,"contenttext":"不言實行の國であるのであります。","xmin":1043.0,"ymin":1441.0,"xmax":1092.0,"ymax":1980.0},{"id":88,"contenttext":"併し段々人智が發","xmin":1045.0,"ymin":1988.0,"xmax":1088.0,"ymax":2272.0},{"id":89,"contenttext":"達して來ますとそれをどうも學術化したい、","xmin":982.0,"ymin":551.0,"xmax":1032.0,"ymax":1225.0},{"id":90,"contenttext":"卽ち理窟で述べて見たいのであります。","xmin":976.0,"ymin":1237.0,"xmax":1030.0,"ymax":1842.0},{"id":91,"contenttext":"その學理で述べて見たいと","xmin":973.0,"ymin":1856.0,"xmax":1022.0,"ymax":2270.0},{"id":92,"contenttext":"いふ氣分が日本人の間に大變出來て來ましたが、","xmin":910.0,"ymin":555.0,"xmax":963.0,"ymax":1290.0},{"id":93,"contenttext":"その時儒〓が這入つて來た。","xmin":909.0,"ymin":1304.0,"xmax":955.0,"ymax":1738.0},{"id":94,"contenttext":"ところが儒〓といふものは支那で","xmin":905.0,"ymin":1750.0,"xmax":951.0,"ymax":2265.0},{"id":95,"contenttext":"出來たのでありますけれども、","xmin":845.0,"ymin":550.0,"xmax":892.0,"ymax":1015.0},{"id":96,"contenttext":"支那の國にはさういふ傳統の精神が充分でありませぬから、","xmin":838.0,"ymin":1029.0,"xmax":891.0,"ymax":1943.0},{"id":97,"contenttext":"所謂","xmin":839.0,"ymin":1953.0,"xmax":883.0,"ymax":2032.0},{"id":98,"contenttext":"「禪讓放伐」と","xmin":837.0,"ymin":2036.0,"xmax":881.0,"ymax":2268.0},{"id":99,"contenttext":"云ふことが行はれて居るのであります。","xmin":774.0,"ymin":551.0,"xmax":825.0,"ymax":1155.0},{"id":100,"contenttext":"卽ち発帝は舜帝と言つて匹夫を擧げて位を繼がしめて居る。","xmin":767.0,"ymin":1163.0,"xmax":821.0,"ymax":2080.0},{"id":101,"contenttext":"それを禪る","xmin":765.0,"ymin":2090.0,"xmax":809.0,"ymax":2269.0},{"id":102,"contenttext":"といふのであります。","xmin":709.0,"ymin":550.0,"xmax":753.0,"ymax":878.0},{"id":103,"contenttext":"或は匹夫がその君を放ち、","xmin":703.0,"ymin":890.0,"xmax":755.0,"ymax":1291.0},{"id":104,"contenttext":"又は伐つて位を奪ふことを放伐といふのです。","xmin":701.0,"ymin":1302.0,"xmax":748.0,"ymax":2008.0},{"id":105,"contenttext":"周の武王がその","xmin":700.0,"ymin":2020.0,"xmax":744.0,"ymax":2267.0},{"id":106,"contenttext":"君の紂を滅して自分が天子となる。","xmin":638.0,"ymin":548.0,"xmax":689.0,"ymax":1086.0},{"id":107,"contenttext":"さういふことが支那に於てはあるのであります。","xmin":634.0,"ymin":1098.0,"xmax":681.0,"ymax":1837.0},{"id":108,"contenttext":"けれどもこれは儒〓の精神","xmin":630.0,"ymin":1848.0,"xmax":679.0,"ymax":2269.0},{"id":109,"contenttext":"ではない。","xmin":571.0,"ymin":549.0,"xmax":621.0,"ymax":708.0},{"id":110,"contenttext":"儒〓の理想ではないのです。","xmin":571.0,"ymin":716.0,"xmax":617.0,"ymax":1153.0},{"id":111,"contenttext":"さういふことは支那國民の風俗であるのです。","xmin":565.0,"ymin":1165.0,"xmax":614.0,"ymax":1872.0},{"id":112,"contenttext":"儒〓の精神は王道と言ひ","xmin":564.0,"ymin":1881.0,"xmax":610.0,"ymax":2265.0},{"id":113,"contenttext":"三","xmin":502.0,"ymin":2170.0,"xmax":534.0,"ymax":2205.0},{"id":114,"contenttext":"皇國傳統の精神","xmin":508.0,"ymin":725.0,"xmax":546.0,"ymax":941.0}]