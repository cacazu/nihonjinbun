[{"id":0,"contenttext":"皇國傳統の精神","xmin":2943.0,"ymin":745.0,"xmax":2986.0,"ymax":959.0},{"id":1,"contenttext":"圖","xmin":2956.0,"ymin":2187.0,"xmax":2987.0,"ymax":2226.0},{"id":2,"contenttext":"て來ても、","xmin":2873.0,"ymin":569.0,"xmax":2919.0,"ymax":723.0},{"id":3,"contenttext":"吾々はこの祖國を維持し、","xmin":2873.0,"ymin":735.0,"xmax":2923.0,"ymax":1135.0},{"id":4,"contenttext":"祖國を發展することが出來るのであります。","xmin":2878.0,"ymin":1146.0,"xmax":2920.0,"ymax":1821.0},{"id":5,"contenttext":"さういふ具合にどこ迄も不健","xmin":2878.0,"ymin":1835.0,"xmax":2926.0,"ymax":2286.0},{"id":6,"contenttext":"全な外來の思想などに迷はないで、","xmin":2801.0,"ymin":564.0,"xmax":2853.0,"ymax":1104.0},{"id":7,"contenttext":"今日ありますところのマルキシズムとか、","xmin":2808.0,"ymin":1109.0,"xmax":2852.0,"ymax":1752.0},{"id":8,"contenttext":"アナーキズム卽ち無政府主義とか","xmin":2806.0,"ymin":1764.0,"xmax":2853.0,"ymax":2283.0},{"id":9,"contenttext":"その他色々の不健全な思想に迷はないで、","xmin":2734.0,"ymin":566.0,"xmax":2781.0,"ymax":1204.0},{"id":10,"contenttext":"以上申しましたやうな我國傳統の精神を高く揭げて、","xmin":2735.0,"ymin":1216.0,"xmax":2784.0,"ymax":2027.0},{"id":11,"contenttext":"かういふ外來の","xmin":2737.0,"ymin":2041.0,"xmax":2783.0,"ymax":2284.0},{"id":12,"contenttext":"不健全なる思想の這入る餘地がないやうにして、","xmin":2662.0,"ymin":564.0,"xmax":2712.0,"ymax":1306.0},{"id":13,"contenttext":"この天壤無窮の皇運を扶翼して行かなければなりませぬ。","xmin":2665.0,"ymin":1320.0,"xmax":2713.0,"ymax":2201.0},{"id":14,"contenttext":"さう","xmin":2674.0,"ymin":2215.0,"xmax":2705.0,"ymax":2284.0},{"id":15,"contenttext":"してこゝに我國家は實に永久不變のものとなりまして、","xmin":2592.0,"ymin":567.0,"xmax":2641.0,"ymax":1408.0},{"id":16,"contenttext":"國民の福利は益々增進して行くといふことになつて參る","xmin":2598.0,"ymin":1422.0,"xmax":2640.0,"ymax":2284.0},{"id":17,"contenttext":"のであります。","xmin":2523.0,"ymin":569.0,"xmax":2569.0,"ymax":794.0},{"id":18,"contenttext":"でありますからして吾々はどこ迄もこの皇國傳統の精神を十分に膽に銘じて進んで行かなければ","xmin":2526.0,"ymin":807.0,"xmax":2573.0,"ymax":2288.0},{"id":19,"contenttext":"ならないと考へる次第であります。","xmin":2451.0,"ymin":567.0,"xmax":2502.0,"ymax":1104.0},{"id":20,"contenttext":"炎暑の際に長時間御靜聽を煩しまして恐縮に存じます。","xmin":2457.0,"ymin":1114.0,"xmax":2505.0,"ymax":1960.0},{"id":21,"contenttext":"これを以て終りと致","xmin":2459.0,"ymin":1976.0,"xmax":2501.0,"ymax":2288.0},{"id":22,"contenttext":"します。","xmin":2390.0,"ymin":568.0,"xmax":2430.0,"ymax":691.0},{"id":23,"contenttext":"(拍手)","xmin":2388.0,"ymin":697.0,"xmax":2432.0,"ymax":813.0},{"id":24,"contenttext":"昭和十一年一月八日印刷","xmin":1616.0,"ymin":1553.0,"xmax":1646.0,"ymax":1780.0},{"id":25,"contenttext":"昭和十一年一月十日發行","xmin":1583.0,"ymin":1555.0,"xmax":1607.0,"ymax":1780.0},{"id":26,"contenttext":"新更論集分册","xmin":1609.0,"ymin":1805.0,"xmax":1644.0,"ymax":1992.0},{"id":27,"contenttext":"定價金十錢","xmin":1577.0,"ymin":1896.0,"xmax":1616.0,"ymax":2057.0},{"id":28,"contenttext":"編輯兼","xmin":1493.0,"ymin":1655.0,"xmax":1526.0,"ymax":1750.0},{"id":29,"contenttext":"發行者","xmin":1463.0,"ymin":1655.0,"xmax":1498.0,"ymax":1750.0},{"id":30,"contenttext":"神","xmin":1475.0,"ymin":1805.0,"xmax":1512.0,"ymax":1844.0},{"id":31,"contenttext":"崎","xmin":1475.0,"ymin":1896.0,"xmax":1512.0,"ymax":1935.0},{"id":32,"contenttext":"照","xmin":1475.0,"ymin":1989.0,"xmax":1513.0,"ymax":2030.0},{"id":33,"contenttext":"惠","xmin":1473.0,"ymin":2082.0,"xmax":1514.0,"ymax":2122.0},{"id":34,"contenttext":"千葉縣成田町一番地","xmin":1414.0,"ymin":1840.0,"xmax":1453.0,"ymax":2117.0},{"id":35,"contenttext":"印刷者","xmin":1324.0,"ymin":1655.0,"xmax":1359.0,"ymax":1750.0},{"id":36,"contenttext":"宮","xmin":1322.0,"ymin":1803.0,"xmax":1357.0,"ymax":1844.0},{"id":37,"contenttext":"內","xmin":1320.0,"ymin":1896.0,"xmax":1359.0,"ymax":1937.0},{"id":38,"contenttext":"利","xmin":1318.0,"ymin":1988.0,"xmax":1359.0,"ymax":2030.0},{"id":39,"contenttext":"平","xmin":1318.0,"ymin":2080.0,"xmax":1359.0,"ymax":2119.0},{"id":40,"contenttext":"東京市京橋區寶町","xmin":1265.0,"ymin":1838.0,"xmax":1304.0,"ymax":2115.0},{"id":41,"contenttext":"二丁目七","xmin":1228.0,"ymin":1840.0,"xmax":1264.0,"ymax":2008.0},{"id":42,"contenttext":"番","xmin":1227.0,"ymin":2022.0,"xmax":1262.0,"ymax":2066.0},{"id":43,"contentte