[{"id":0,"contenttext":"皇國傳統の精神","xmin":2949.0,"ymin":737.0,"xmax":2986.0,"ymax":949.0},{"id":1,"contenttext":"四〇","xmin":2943.0,"ymin":2178.0,"xmax":2973.0,"ymax":2217.0},{"id":2,"contenttext":"のものになつて終ひます。","xmin":2875.0,"ymin":559.0,"xmax":2922.0,"ymax":955.0},{"id":3,"contenttext":"それだからして象や鯨は永久に象や鯨で暮さなければなりません。","xmin":2869.0,"ymin":969.0,"xmax":2923.0,"ymax":1991.0},{"id":4,"contenttext":"その文化を發展せ","xmin":2868.0,"ymin":1992.0,"xmax":2913.0,"ymax":2275.0},{"id":5,"contenttext":"しめ人類より以上になることは出來ないのであります。","xmin":2803.0,"ymin":557.0,"xmax":2854.0,"ymax":1403.0},{"id":6,"contenttext":"人間に獲られて旨いと言つて刺身なぞにされて終ひま","xmin":2796.0,"ymin":1415.0,"xmax":2848.0,"ymax":2277.0},{"id":7,"contenttext":"す。","xmin":2742.0,"ymin":555.0,"xmax":2783.0,"ymax":612.0},{"id":8,"contenttext":"それは腦髓が小さいから駄目なのであります。","xmin":2737.0,"ymin":622.0,"xmax":2779.0,"ymax":1331.0},{"id":9,"contenttext":"ところが日本人と西洋人と較べて御覽なさい。","xmin":2734.0,"ymin":1344.0,"xmax":2776.0,"ymax":2050.0},{"id":10,"contenttext":"平均身長など","xmin":2730.0,"ymin":2062.0,"xmax":2776.0,"ymax":2277.0},{"id":11,"contenttext":"見ましても、","xmin":2670.0,"ymin":553.0,"xmax":2712.0,"ymax":745.0},{"id":12,"contenttext":"日本人の平均身長は大抵五尺三寸といふのであります。","xmin":2666.0,"ymin":760.0,"xmax":2717.0,"ymax":1605.0},{"id":13,"contenttext":"西洋人はイギリス人邊りが五尺七寸、","xmin":2662.0,"ymin":1618.0,"xmax":2712.0,"ymax":2191.0},{"id":14,"contenttext":"アメ","xmin":2668.0,"ymin":2203.0,"xmax":2704.0,"ymax":2268.0},{"id":15,"contenttext":"リカ人は大きくて五尺七寸五分といふのであります。","xmin":2600.0,"ymin":555.0,"xmax":2644.0,"ymax":1362.0},{"id":16,"contenttext":"五尺七寸五分と五尺三寸とは非常な違ひであります。","xmin":2596.0,"ymin":1378.0,"xmax":2642.0,"ymax":2189.0},{"id":17,"contenttext":"東京","xmin":2594.0,"ymin":2201.0,"xmax":2637.0,"ymax":2275.0},{"id":18,"contenttext":"などに居ますとアメリカの軍艦などが這入りますとその水兵が來ます。","xmin":2530.0,"ymin":553.0,"xmax":2579.0,"ymax":1639.0},{"id":19,"contenttext":"私は五尺三寸五分ですが、","xmin":2527.0,"ymin":1651.0,"xmax":2573.0,"ymax":2052.0},{"id":20,"contenttext":"西洋人はかう","xmin":2524.0,"ymin":2062.0,"xmax":2571.0,"ymax":2274.0},{"id":21,"contenttext":"して","xmin":2466.0,"ymin":555.0,"xmax":2506.0,"ymax":626.0},{"id":22,"contenttext":"(仰向く)","xmin":2466.0,"ymin":634.0,"xmax":2510.0,"ymax":786.0},{"id":23,"contenttext":"見るやうです。","xmin":2464.0,"ymin":791.0,"xmax":2510.0,"ymax":1024.0},{"id":24,"contenttext":"その大きい體ですから日本人より腦髓が少し重くても駄目なのであります。","xmin":2456.0,"ymin":1033.0,"xmax":2510.0,"ymax":2189.0},{"id":25,"contenttext":"そこ","xmin":2459.0,"ymin":2200.0,"xmax":2495.0,"ymax":2272.0},{"id":26,"contenttext":"で體に比較して見ますと、","xmin":2393.0,"ymin":555.0,"xmax":2439.0,"ymax":954.0},{"id":27,"contenttext":"世界中の人類の中で、","xmin":2393.0,"ymin":964.0,"xmax":2439.0,"ymax":1296.0},{"id":28,"contenttext":"日本人の腦髓が平均で一番重いといふことになつて來ます。","xmin":2385.0,"ymin":1308.0,"xmax":2437.0,"ymax":2223.0},{"id":29,"contenttext":"な","xmin":2388.0,"ymin":2233.0,"xmax":2429.0,"ymax":2275.0},{"id":30,"contenttext":"んと偉いではありませんか。","xmin":2326.0,"ymin":553.0,"xmax":2371.0,"ymax":987.0},{"id":31,"contenttext":"(笑聲)","xmin":2326.0,"ymin":996.0,"xmax":2371.0,"ymax":1112.0},{"id":32,"contenttext":"さうして見ると日本人は實に天然自然に世界優秀の民族として出て來て居","xmin":2318.0,"ymin":1138.0,"xmax":2371.0,"ymax":2276.0},{"id":33,"contenttext":"る譯なのであります。","xmin":2256.0,"ymin":555.0,"xmax":2302.0,"ymax":885.0},{"id":34,"contenttext":"これは決して架空な議論ではありません。","xmin":2253.0,"ymin":899.0,"xmax":2303.0,"ymax":1538.0},{"id":35,"contenttext":"科學的に說明が出來ます。","xmin":2250.0,"ymin":1547.0,"xmax":2299.0,"ymax":1950.0},{"id":36,"contenttext":"それでありますから","xmin":2249.0,"ymin":1960.0,"xmax":2293.0,"ymax":2274.0},{"id":37,"contenttext":"吾々が今日五大强國となつたが、","xmin":2185.0,"ymin":552.0,"xmax":2231.0,"ymax":1056.0},{"id":38,"contenttext":"日露戰爭當時は世界の八大强國だと言つた。","xmin":2182.0,"ymin":1068.0,"xmax":2230.0,"ymax":1741.0},{"id":39,"contenttext":"ところがロシヤは滅びて終ひ、","xmin":2178.0,"ymin":1755.0,"xmax":2224.0,"ymax":2223.0},{"id":40,"contenttext":"そ","xmin":2182.0,"ymin":2233.0,"xmax":2217.0,"ymax":2272.0},{"id":41,"contenttext":"の後にオーストリー·ハンガリーもなくなつて終ひ、","xmin":2119.0,"ymin":559.0,"xmax":2158.0,"ymax":1362.0},{"id":42,"contenttext":"獨逸が負けましたので五大强國となつた。","xmin":2111.0,"ymin":1373.0,"xmax":2161.0,"ymax":2017.0},{"id":43,"contenttext":"それが歐州戰亂","xmin":2109.0,"ymin":2028.0,"xmax":2158.0,"ymax":2276.0},{"id":44,"contenttext":"の時には五大强國と言つたのですが、","xmin":2048.0,"ymin":557.0,"xmax":2094.0,"ymax":1126.0},{"id":45,"contenttext":"今度ワシントン條約の時には三大强國、今日では事實上三大强國になつた。","xmin":2041.0,"ymin":1133.0,"xmax":2094.0,"ymax":2274.0},{"id":46,"contenttext":"初めは八つです。","xmin":1979.0,"ymin":552.0,"xmax":2025.0,"ymax":815.0},{"id":47,"contenttext":"それが段々なくなつて三つ取られて五大强國、","xmin":1976.0,"ymin":826.0,"xmax":2026.0,"ymax":1535.0},{"id":48,"contenttext":"それが又二つ程弱いやうなのが取れて三大强國","xmin":1971.0,"ymin":1547.0,"xmax":2023.0,"ymax":2276.0},{"id":49,"contenttext":"になつた。","xmin":1911.0,"ymin":555.0,"xmax":1956.0,"ymax":714.0},{"id":50,"contenttext":"又今後段々この順序で進みますと、","xmin":1909.0,"ymin":723.0,"xmax":1956.0,"ymax":1260.0},{"id":51,"contenttext":"とう〓〓一大强國になる。","xmin":1909.0,"ymin":1273.0,"xmax":1951.0,"ymax":1668.0},{"id":52,"contenttext":"處が右のやうに優秀な民族が優秀な傳","xmin":1905.0,"ymin":1683.0,"xmax":1953.0,"ymax":2274.0},{"id":53,"contenttext":"統の精神を發展して來ると、","xmin":1839.0,"ymin":552.0,"xmax":1885.0,"ymax":985.0},{"id":54,"contenttext":"何時でも日本が殘つて行きまして最後迄殘るでせう。","xmin":1836.0,"ymin":996.0,"xmax":1887.0,"ymax":1808.0},{"id":55,"contenttext":"歷史は繰返へすものと云はれて居ります。","xmin":1599.0,"ymin":603.0,"xmax":1643.0,"ymax":1241.0},{"id":56,"contenttext":"昔から日本を滅さうと思つて外國から軍を起して來ます。","xmin":1599.0,"ymin":1250.0,"xmax":1643.0,"ymax":2131.0},{"id":57,"contenttext":"弘安の役","xmin":1596.0,"ymin":2142.0,"xmax":1645.0,"ymax":2290.0},{"id":58,"contenttext":"に百戰練磨の蒙古軍が攻めて來ました。","xmin":1533.0,"ymin":575.0,"xmax":1577.0,"ymax":1177.0},{"id":59,"contenttext":"ところがその蒙古卽ち元國は日本を攻めて來たが、","xmin":1533.0,"ymin":1190.0,"xmax":1576.0,"ymax":1965.0},{"id":60,"contenttext":"負けて生きて歸る者","xmin":1533.0,"ymin":1978.0,"xmax":1576.0,"ymax":2291.0},{"id":61,"contenttext":"が僅かに三人であつた。","xmin":1459.0,"ymin":571.0,"xmax":1509.0,"ymax":936.0},{"id":62,"contenttext":"それが原因となつて元國は滅びて終ひました。","xmin":1461.0,"ymin":948.0,"xmax":1512.0,"ymax":1657.0},{"id":63,"contenttext":"維新後になりまして東洋の大國支那が、","xmin":1392.0,"ymin":603.0,"xmax":1438.0,"ymax":1211.0},{"id":64,"contenttext":"日本に對して野心を抱きました。","xmin":1392.0,"ymin":1221.0,"xmax":1438.0,"ymax":1725.0},{"id":65,"contenttext":"あの李鴻章がどうも日本が近來肩を","xmin":1392.0,"ymin":1738.0,"xmax":1438.0,"ymax":2291.0},{"id":66,"contenttext":"上げて來たから、","xmin":1324.0,"ymin":571.0,"xmax":1369.0,"ymax":833.0},{"id":67,"contenttext":"今の中にやつて置かぬといけないといふので、","xmin":1324.0,"ymin":844.0,"xmax":1369.0,"ymax":1553.0},{"id":68,"contenttext":"日〓戰爭を始めたのです。","xmin":1322.0,"ymin":1565.0,"xmax":1368.0,"ymax":1965.0},{"id":69,"contenttext":"ところが日〓戰爭を","xmin":1324.0,"ymin":1978.0,"xmax":1365.0,"ymax":2289.0},{"id":70,"contenttext":"やりますと、","xmin":1254.0,"ymin":572.0,"xmax":1297.0,"ymax":764.0},{"id":71,"contenttext":"それが原因になつて〓國は滅びて終ひました。","xmin":1253.0,"ymin":776.0,"xmax":1299.0,"ymax":1484.0},{"id":72,"contenttext":"その後露西亞が東洋に野心を抱きまして、","xmin":1253.0,"ymin":1496.0,"xmax":1299.0,"ymax":2134.0},{"id":73,"contenttext":"遂に日露","xmin":1253.0,"ymin":2147.0,"xmax":1299.0,"ymax":2291.0},{"id":74,"contenttext":"戰爭となりましたが、","xmin":1184.0,"ymin":568.0,"xmax":1227.0,"ymax":899.0},{"id":75,"contenttext":"その結果連戰連敗、","xmin":1183.0,"ymin":913.0,"xmax":1228.0,"ymax":1209.0},{"id":76,"contenttext":"ロシヤ帝國は滅びて終つた。","xmin":1183.0,"ymin":1227.0,"xmax":1228.0,"ymax":1654.0},{"id":77,"contenttext":"ロシヤは今でもありますが、","xmin":1184.0,"ymin":1674.0,"xmax":1227.0,"ymax":2099.0},{"id":78,"contenttext":"あれは帝國","xmin":1183.0,"ymin":2113.0,"xmax":1227.0,"ymax":2291.0},{"id":79,"contenttext":"ではありませぬ。","xmin":1114.0,"ymin":573.0,"xmax":1156.0,"ymax":834.0},{"id":80,"contenttext":"帝國は滅びて終ひました。","xmin":1114.0,"ymin":844.0,"xmax":1160.0,"ymax":1246.0},{"id":81,"contenttext":"さういふ具合に日本に向つて戰爭を仕かけて日本を取つてやらうと","xmin":1114.0,"ymin":1258.0,"xmax":1160.0,"ymax":2291.0},{"id":82,"contenttext":"思ふと、","xmin":1045.0,"ymin":569.0,"xmax":1086.0,"ymax":696.0},{"id":83,"contenttext":"その國が滅びて終ひます。","xmin":1045.0,"ymin":707.0,"xmax":1091.0,"ymax":1107.0},{"id":84,"contenttext":"何しろ日本は皇國でありまして、","xmin":1045.0,"ymin":1117.0,"xmax":1086.0,"ymax":1620.0},{"id":85,"contenttext":"偉大な傳統の精神がありますから、","xmin":1043.0,"ymin":1631.0,"xmax":1091.0,"ymax":2172.0},{"id":86,"contenttext":"どうか","xmin":1043.0,"ymin":2182.0,"xmax":1084.0,"ymax":2289.0},{"id":87,"contenttext":"すると外國で日本を取らうといふやうな考を起す國がありますと、","xmin":976.0,"ymin":569.0,"xmax":1020.0,"ymax":1586.0},{"id":88,"contenttext":"その國はあぶないのであります。","xmin":976.0,"ymin":1599.0,"xmax":1019.0,"ymax":2099.0},{"id":89,"contenttext":"今日では世","xmin":975.0,"ymin":2111.0,"xmax":1021.0,"ymax":2292.0},{"id":90,"contenttext":"界の各國がウツカリ手を出すと、","xmin":907.0,"ymin":567.0,"xmax":952.0,"ymax":1070.0},{"id":91,"contenttext":"これは自分の國が滅びて終ふといふことを知つたらしいのであります。","xmin":908.0,"ymin":1087.0,"xmax":954.0,"ymax":2168.0},{"id":92,"contenttext":"それは","xmin":905.0,"ymin":2180.0,"xmax":952.0,"ymax":2288.0},{"id":93,"contenttext":"さうならなければなりませぬ。又吾々國民もその精神で進まなければなりませぬ。吾々がこの傳統の精神を發揮し","xmin":837.0,"ymin":571.0,"xmax":883.0,"ymax":2288.0},{"id":94,"contenttext":"て居る以上は大丈夫であります。","xmin":767.0,"ymin":571.0,"xmax":818.0,"ymax":1070.0},{"id":95,"contenttext":"若しこの傳統の精神を失つて終つたら大變であります。","xmin":768.0,"ymin":1080.0,"xmax":816.0,"ymax":1925.0},{"id":96,"contenttext":"丁度犬がワン〓〓と言","xmin":770.0,"ymin":1939.0,"xmax":814.0,"ymax":2288.0},{"id":97,"contenttext":"はなくなり、","xmin":703.0,"ymin":569.0,"xmax":742.0,"ymax":758.0},{"id":98,"contenttext":"猫がニヤ〓〓と言はなくなると同じであります。","xmin":701.0,"ymin":771.0,"xmax":746.0,"ymax":1514.0},{"id":99,"contenttext":"さういふ具合にニヤノ〓と言はない猫が居ました","xmin":701.0,"ymin":1530.0,"xmax":744.0,"ymax":2288.0},{"id":100,"contenttext":"ら、","xmin":636.0,"ymin":568.0,"xmax":673.0,"ymax":624.0},{"id":101,"contenttext":"その猫は不思議な猫、","xmin":631.0,"ymin":634.0,"xmax":677.0,"ymax":966.0},{"id":102,"contenttext":"さういふ具合にワン〓〓と鳴かない犬が居りましたら不思議な犬です。","xmin":631.0,"ymin":980.0,"xmax":677.0,"ymax":2066.0},{"id":103,"contenttext":"(笑聲)","xmin":633.0,"ymin":2071.0,"xmax":678.0,"ymax":2187.0},{"id":104,"contenttext":"日本","xmin":633.0,"ymin":2214.0,"xmax":677.0,"ymax":2288.0},{"id":105,"contenttext":"國民であつて日本の傳統の精神を持つて居ない日本人が居りましたならば、","xmin":562.0,"ymin":566.0,"xmax":605.0,"ymax":1717.0},{"id":106,"contenttext":"それは不思議な日本人であります。","xmin":562.0,"ymin":1731.0,"xmax":609.0,"ymax":2269.0},{"id":107,"contenttext":"皇國傳統の精神","xmin":501.0,"ymin":749.0,"xmax":538.0,"ymax":962.0},{"id":108,"contenttext":"三","xmin":506.0,"ymin":2191.0,"xmax":536.0,"ymax":2226.0}]