[{"id":0,"contenttext":"*","xmin":2935.0,"ymin":2208.0,"xmax":2966.0,"ymax":2244.0},{"id":1,"contenttext":"皇國傳統の精神","xmin":2937.0,"ymin":763.0,"xmax":2979.0,"ymax":980.0},{"id":2,"contenttext":"a","xmin":2901.0,"ymin":1475.0,"xmax":2924.0,"ymax":1497.0},{"id":3,"contenttext":"直ぐそれが皇太子樣だといふことを御承知になる。","xmin":2865.0,"ymin":583.0,"xmax":2919.0,"ymax":1359.0},{"id":4,"contenttext":"又縮津見の神といふところにお出でになると、","xmin":2858.0,"ymin":1369.0,"xmax":2909.0,"ymax":2077.0},{"id":5,"contenttext":"これが又尊き","xmin":2859.0,"ymin":2092.0,"xmax":2905.0,"ymax":2302.0},{"id":6,"contenttext":"皇太子樣であらせられるといふことを直ぐ知られるといふ具合に、","xmin":2797.0,"ymin":581.0,"xmax":2846.0,"ymax":1595.0},{"id":7,"contenttext":"至るところ如何に皇室の尊嚴が上代に於て徹","xmin":2791.0,"ymin":1609.0,"xmax":2840.0,"ymax":2304.0},{"id":8,"contenttext":"底して居るかと云ふことがわかるのであります。","xmin":2728.0,"ymin":581.0,"xmax":2782.0,"ymax":1322.0},{"id":9,"contenttext":"第三、","xmin":2667.0,"ymin":615.0,"xmax":2709.0,"ymax":707.0},{"id":10,"contenttext":"皇室の慈愛","xmin":2663.0,"ymin":717.0,"xmax":2709.0,"ymax":897.0},{"id":11,"contenttext":"基督〓などでは能く神の愛と云ふことを申しますが、","xmin":2594.0,"ymin":615.0,"xmax":2639.0,"ymax":1426.0},{"id":12,"contenttext":"我が國にはさう云ふ風なものがないと申して居ります。","xmin":2582.0,"ymin":1436.0,"xmax":2636.0,"ymax":2281.0},{"id":13,"contenttext":"併しそれは間違ひで、","xmin":2525.0,"ymin":581.0,"xmax":2573.0,"ymax":911.0},{"id":14,"contenttext":"我が傳統の精神には慈愛の精神には富んで、","xmin":2520.0,"ymin":923.0,"xmax":2572.0,"ymax":1599.0},{"id":15,"contenttext":"上代から其範が示されて居ります。","xmin":2515.0,"ymin":1607.0,"xmax":2566.0,"ymax":2147.0},{"id":16,"contenttext":"卽ち皇室","xmin":2515.0,"ymin":2157.0,"xmax":2559.0,"ymax":2300.0},{"id":17,"contenttext":"に於かれましては、","xmin":2459.0,"ymin":583.0,"xmax":2505.0,"ymax":876.0},{"id":18,"contenttext":"非常に國民を愛護せられて居るのであります。","xmin":2453.0,"ymin":887.0,"xmax":2501.0,"ymax":1599.0},{"id":19,"contenttext":"例へば伊邪那岐命が黄泉の國にお出でになり","xmin":2445.0,"ymin":1605.0,"xmax":2509.0,"ymax":2299.0},{"id":20,"contenttext":"まして惡魔の爲に非常にお苦しみになり、","xmin":2386.0,"ymin":579.0,"xmax":2438.0,"ymax":1216.0},{"id":21,"contenttext":"黄泉比良坂といふところに逃げてお出でになつたが惡魔が益々追つ","xmin":2378.0,"ymin":1230.0,"xmax":2433.0,"ymax":2297.0},{"id":22,"contenttext":"て來ます、","xmin":2325.0,"ymin":583.0,"xmax":2369.0,"ymax":737.0},{"id":23,"contenttext":"その時に株の賞があつて伊邪那數命をお助けしたといふことになる","xmin":2314.0,"ymin":751.0,"xmax":2366.0,"ymax":1797.0},{"id":24,"contenttext":"桃の實が惡魔を退治するといふ","xmin":2309.0,"ymin":1812.0,"xmax":2358.0,"ymax":2299.0},{"id":25,"contenttext":"ことは支那でもあるのでありますが、","xmin":2252.0,"ymin":581.0,"xmax":2300.0,"ymax":1149.0},{"id":26,"contenttext":"我國の昔にもあつたのであります。","xmin":2246.0,"ymin":1159.0,"xmax":2294.0,"ymax":1696.0},{"id":27,"contenttext":"これは桃の實と言うても、","xmin":2241.0,"ymin":1711.0,"xmax":2289.0,"ymax":2105.0},{"id":28,"contenttext":"實は實際の","xmin":2242.0,"ymin":2118.0,"xmax":2288.0,"ymax":2295.0},{"id":29,"contenttext":"神樣であらうと思はれます。","xmin":2184.0,"ymin":578.0,"xmax":2233.0,"ymax":1012.0},{"id":30,"contenttext":"今日でも人の名に動物や植物の名前があつて、","xmin":2178.0,"ymin":1022.0,"xmax":2230.0,"ymax":1731.0},{"id":31,"contenttext":"お梅さんとか、","xmin":2174.0,"ymin":1744.0,"xmax":2223.0,"ymax":1971.0},{"id":32,"contenttext":"お虎さんとかいふ名","xmin":2173.0,"ymin":1985.0,"xmax":2218.0,"ymax":2298.0},{"id":33,"contenttext":"前が女にあるでせう。","xmin":2111.0,"ymin":577.0,"xmax":2167.0,"ymax":909.0},{"id":34,"contenttext":"「この使には梅をやれとか、","xmin":2109.0,"ymin":934.0,"xmax":2162.0,"ymax":1354.0},{"id":35,"contenttext":"この使はトラに限る」とか、","xmin":2102.0,"ymin":1371.0,"xmax":2157.0,"ymax":1797.0},{"id":36,"contenttext":"かう言ふと本當の虎かと思ふが","xmin":2101.0,"ymin":1812.0,"xmax":2151.0,"ymax":2297.0},{"id":37,"contenttext":"矢張り梅干でも虎でもない。","xmin":2045.0,"ymin":578.0,"xmax":2093.0,"ymax":1010.0},{"id":38,"contenttext":"お梅といふ人間、","xmin":2042.0,"ymin":1022.0,"xmax":2089.0,"ymax":1285.0},{"id":39,"contenttext":"或は梅太郞といふ人間である。","xmin":2036.0,"ymin":1292.0,"xmax":2087.0,"ymax":1763.0},{"id":40,"contenttext":"(笑聲)","xmin":2036.0,"ymin":1773.0,"xmax":2082.0,"ymax":1887.0},{"id":41,"contenttext":"或はお虎さんである。","xmin":2030.0,"ymin":1909.0,"xmax":2080.0,"ymax":2244.0},{"id":42,"contenttext":"或","xmin":2032.0,"ymin":2252.0,"xmax":2076.0,"ymax":2297.0},{"id":43,"contenttext":"は寅吉である。","xmin":1978.0,"ymin":578.0,"xmax":2022.0,"ymax":804.0},{"id":44,"contenttext":"さういふ譯で動物、","xmin":1974.0,"ymin":818.0,"xmax":2019.0,"ymax":1114.0},{"id":45,"contenttext":"植物の名前は今日でも人の名前に付けますが、","xmin":1966.0,"ymin":1122.0,"xmax":2020.0,"ymax":1832.0},{"id":46,"contenttext":"上代でも神樣の名前に付いて","xmin":1961.0,"ymin":1845.0,"xmax":2012.0,"ymax":2295.0},{"id":47,"contenttext":"在","xmin":1932.0,"ymin":2219.0,"xmax":1958.0,"ymax":2247.0},{"id":48,"contenttext":"〓","xmin":1935.0,"ymin":2254.0,"xmax":1955.0,"ymax":2276.0},{"id":49,"contenttext":"そこで伊邪那彼","xmin":1900.0,"ymin":2048.0,"xmax":1958.0,"ymax":2297.0},{"id":50,"contenttext":"居つたのであります。","xmin":1912.0,"ymin":576.0,"xmax":1960.0,"ymax":908.0},{"id":51,"contenttext":"その桃の神樣が伊邪那岐命をお助けして、","xmin":1905.0,"ymin":918.0,"xmax":1958.0,"ymax":1557.0},{"id":52,"contenttext":"命は虎口をお逃がれになつた。","xmin":1901.0,"ymin":1568.0,"xmax":1950.0,"ymax":2038.0},{"id":53,"contenttext":"命は","xmin":1852.0,"ymin":575.0,"xmax":1888.0,"ymax":649.0},{"id":54,"contenttext":"いまし吾を助けしがごと、","xmin":1602.0,"ymin":649.0,"xmax":1648.0,"ymax":1043.0},{"id":55,"contenttext":"葦原の中つ國にあらゆる現しき靑人草の、","xmin":1597.0,"ymin":1054.0,"xmax":1647.0,"ymax":1694.0},{"id":56,"contenttext":"苦瀨に落ちて苦しまん時に助けてよ","xmin":1591.0,"ymin":1706.0,"xmax":1642.0,"ymax":2262.0},{"id":57,"contenttext":"と仰せられた。","xmin":1532.0,"ymin":576.0,"xmax":1581.0,"ymax":804.0},{"id":58,"contenttext":"今お前が私を助けて呉れた如く、","xmin":1531.0,"ymin":814.0,"xmax":1578.0,"ymax":1317.0},{"id":59,"contenttext":"この葦原中つ國の現しき靑人草、","xmin":1527.0,"ymin":1332.0,"xmax":1576.0,"ymax":1831.0},{"id":60,"contenttext":"卽ち多くの人民が困難に際會","xmin":1525.0,"ymin":1842.0,"xmax":1567.0,"ymax":2293.0},{"id":61,"contenttext":"した時にはかういふ具合に直ぐ助けてやつて吳れと、","xmin":1464.0,"ymin":576.0,"xmax":1517.0,"ymax":1387.0},{"id":62,"contenttext":"自分のことを忘れて直ぐ人民のことをお考へになる。","xmin":1458.0,"ymin":1396.0,"xmax":1510.0,"ymax":2208.0},{"id":63,"contenttext":"その","xmin":1459.0,"ymin":2219.0,"xmax":1500.0,"ymax":2289.0},{"id":64,"contenttext":"厚き慈愛の御心を知るべきであります。","xmin":1394.0,"ymin":572.0,"xmax":1448.0,"ymax":1178.0},{"id":65,"contenttext":"或は穀物の神樣が御殺されになつた時","xmin":1329.0,"ymin":608.0,"xmax":1379.0,"ymax":1197.0},{"id":66,"contenttext":"五穀が出來ましたら、","xmin":1326.0,"ymin":1255.0,"xmax":1374.0,"ymax":1590.0},{"id":67,"contenttext":"天照大御神樣は、","xmin":1323.0,"ymin":1598.0,"xmax":1371.0,"ymax":1862.0},{"id":68,"contenttext":",","xmin":1303.0,"ymin":911.0,"xmax":1319.0,"ymax":939.0},{"id":69,"contenttext":"是の物どもは則ち顯見蒼生の食ひて活くべきものなり","xmin":1258.0,"ymin":640.0,"xmax":1305.0,"ymax":1497.0},{"id":70,"contenttext":"と言つて非常に御喜びになつた。","xmin":1194.0,"ymin":573.0,"xmax":1243.0,"ymax":1076.0},{"id":71,"contenttext":"卽ちこの五穀といふものは人民が皆食べて生活するところのもので、","xmin":1183.0,"ymin":1084.0,"xmax":1236.0,"ymax":2136.0},{"id":72,"contenttext":"このもの","xmin":1184.0,"ymin":2152.0,"xmax":1225.0,"ymax":2289.0},{"id":73,"contenttext":"がこゝに出來たことは、","xmin":1128.0,"ymin":574.0,"xmax":1175.0,"ymax":936.0},{"id":74,"contenttext":"實に有難いことだと言うて御喜びになつた。","xmin":1120.0,"ymin":946.0,"xmax":1173.0,"ymax":1624.0},{"id":75,"contenttext":"何でも事ある每に人民のことを御考へにな","xmin":1115.0,"ymin":1634.0,"xmax":1163.0,"ymax":2288.0},{"id":76,"contenttext":"る。","xmin":1065.0,"ymin":575.0,"xmax":1102.0,"ymax":626.0},{"id":77,"contenttext":"詰り人民を公","xmin":1058.0,"ymin":638.0,"xmax":1104.0,"ymax":853.0},{"id":78,"contenttext":"民卽も大御賞しとこれを御參護送ばすといふのな皇室の御結神であ","xmin":1047.0,"ymin":879.0,"xmax":1104.0,"ymax":2068.0},{"id":79,"contenttext":"第四、","xmin":990.0,"ymin":603.0,"xmax":1033.0,"ymax":694.0},{"id":80,"contenttext":"事實の尊重","xmin":987.0,"ymin":705.0,"xmax":1031.0,"ymax":881.0},{"id":81,"contenttext":"以上のやうな傳統の精神につれて、","xmin":916.0,"ymin":604.0,"xmax":966.0,"ymax":1141.0},{"id":82,"contenttext":"我國では事實を尊重するのであります。","xmin":911.0,"ymin":1152.0,"xmax":959.0,"ymax":1756.0},{"id":83,"contenttext":"支那などでは、","xmin":911.0,"ymin":1767.0,"xmax":955.0,"ymax":1999.0},{"id":84,"contenttext":"昔から理論的〓究","xmin":908.0,"ymin":2007.0,"xmax":954.0,"ymax":2288.0},{"id":85,"contenttext":"が發達したのでありますが、","xmin":847.0,"ymin":571.0,"xmax":898.0,"ymax":1001.0},{"id":86,"contenttext":"我國は神ながら言擧せぬ國と云ひ、","xmin":843.0,"ymin":1013.0,"xmax":893.0,"ymax":1551.0},{"id":87,"contenttext":"事實を尊重し、","xmin":843.0,"ymin":1558.0,"xmax":887.0,"ymax":1792.0},{"id":88,"contenttext":"實行を尊ぶのであります。","xmin":840.0,"ymin":1800.0,"xmax":885.0,"ymax":2201.0},{"id":89,"contenttext":"です","xmin":840.0,"ymin":2214.0,"xmax":885.0,"ymax":2286.0},{"id":90,"contenttext":"から學校のやうなものも中々發達しませぬ。","xmin":780.0,"ymin":571.0,"xmax":827.0,"ymax":1241.0},{"id":91,"contenttext":"國民の〓化も全く事實に基いて、","xmin":775.0,"ymin":1253.0,"xmax":822.0,"ymax":1756.0},{"id":92,"contenttext":"實際の事柄で行はれました。","xmin":774.0,"ymin":1764.0,"xmax":818.0,"ymax":2201.0},{"id":93,"contenttext":"右に","xmin":772.0,"ymin":2210.0,"xmax":816.0,"ymax":2286.0},{"id":94,"contenttext":"述べました敬神崇祖といふやうなことも、","xmin":708.0,"ymin":567.0,"xmax":763.0,"ymax":1204.0},{"id":95,"contenttext":"例へば神武天皇の御卽位の四年に","xmin":705.0,"ymin":1216.0,"xmax":757.0,"ymax":1742.0},{"id":96,"contenttext":"「島見山といふ山に齋場を設けて、","xmin":703.0,"ymin":1741.0,"xmax":751.0,"ymax":2270.0},{"id":97,"contenttext":"天の神を御祭りになつたのでありますが、その天つ神を御祭りになるその事柄で以て、","xmin":634.0,"ymin":567.0,"xmax":693.0,"ymax":1876.0},{"id":98,"contenttext":"かういふ風に神樣を崇敬し","xmin":634.0,"ymin":1868.0,"xmax":680.0,"ymax":2286.0},{"id":99,"contenttext":"なくてはいかんぞといふことを御示しになるのであります。","xmin":570.0,"ymin":569.0,"xmax":621.0,"ymax":1479.0},{"id":100,"contenttext":"さうしてかう云ふ風なお祭りには、","xmin":566.0,"ymin":1493.0,"xmax":613.0,"ymax":2027.0},{"id":101,"contenttext":"必ず祝詞といふ","xmin":562.0,"ymin":2037.0,"xmax":612.0,"ymax":2287.0},{"id":102,"contenttext":"皇國傳統の精神","xmin":509.0,"ymin":747.0,"xmax":549.0,"ymax":963.0},{"id":103,"contenttext":"元","xmin":501.0,"ymin":2187.0,"xmax":536.0,"ymax":2226.0},{"id":104,"contenttext":"天照大御神樣は、","xmin":1323.0,"ymin":1598.0,"xmax":1371.0,"ymax":1862.0}]