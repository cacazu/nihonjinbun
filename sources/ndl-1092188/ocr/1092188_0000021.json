[{"id":0,"contenttext":"皇國傳統の精神","xmin":2924.0,"ymin":751.0,"xmax":2963.0,"ymax":966.0},{"id":1,"contenttext":"〓","xmin":2928.0,"ymin":2194.0,"xmax":2963.0,"ymax":2231.0},{"id":2,"contenttext":"るからといふので臨機應變の孝行を說かれたのであります。","xmin":2853.0,"ymin":574.0,"xmax":2901.0,"ymax":1484.0},{"id":3,"contenttext":"ところが根本はどういふところにあるかといふとこ","xmin":2855.0,"ymin":1498.0,"xmax":2898.0,"ymax":2289.0},{"id":4,"contenttext":"ゝです。","xmin":2790.0,"ymin":575.0,"xmax":2831.0,"ymax":696.0},{"id":5,"contenttext":"これは","xmin":2788.0,"ymin":710.0,"xmax":2831.0,"ymax":816.0},{"id":6,"contenttext":"『詩經』","xmin":2788.0,"ymin":823.0,"xmax":2832.0,"ymax":941.0},{"id":7,"contenttext":"などにも擧つて居ります。","xmin":2788.0,"ymin":948.0,"xmax":2831.0,"ymax":1347.0},{"id":8,"contenttext":"その「大雅」","xmin":2788.0,"ymin":1359.0,"xmax":2831.0,"ymax":1558.0},{"id":9,"contenttext":"の中に、","xmin":2789.0,"ymin":1566.0,"xmax":2833.0,"ymax":1689.0},{"id":10,"contenttext":"事脩共德。","xmin":2716.0,"ymin":858.0,"xmax":2779.0,"ymax":1041.0},{"id":11,"contenttext":"亡念","xmin":2721.0,"ymin":640.0,"xmax":2760.0,"ymax":749.0},{"id":12,"contenttext":"爾祖、","xmin":2720.0,"ymin":755.0,"xmax":2765.0,"ymax":853.0},{"id":13,"contenttext":"といふことがありますが、","xmin":2651.0,"ymin":571.0,"xmax":2693.0,"ymax":968.0},{"id":14,"contenttext":"矢張りこの趣意であります。","xmin":2649.0,"ymin":982.0,"xmax":2692.0,"ymax":1414.0},{"id":15,"contenttext":"かういふやうな具合で、","xmin":2649.0,"ymin":1428.0,"xmax":2692.0,"ymax":1791.0},{"id":16,"contenttext":"この儒〓といふものが神道、","xmin":2649.0,"ymin":1806.0,"xmax":2696.0,"ymax":2242.0},{"id":17,"contenttext":"或","xmin":2651.0,"ymin":2249.0,"xmax":2695.0,"ymax":2295.0},{"id":18,"contenttext":"は皇道の根本精神、","xmin":2582.0,"ymin":571.0,"xmax":2626.0,"ymax":865.0},{"id":19,"contenttext":"卽ち皇國傳統の精神を說明するのに、","xmin":2580.0,"ymin":878.0,"xmax":2628.0,"ymax":1452.0},{"id":20,"contenttext":"非常に都合が好い。","xmin":2579.0,"ymin":1461.0,"xmax":2630.0,"ymax":1763.0},{"id":21,"contenttext":"そこで和魂漢才で儒〓は我國に盛","xmin":2582.0,"ymin":1771.0,"xmax":2626.0,"ymax":2293.0},{"id":22,"contenttext":"んに行はれて來たのであります。","xmin":2513.0,"ymin":571.0,"xmax":2556.0,"ymax":1070.0},{"id":23,"contenttext":"それから儒〓が傳はつて來まして後に、","xmin":2445.0,"ymin":605.0,"xmax":2490.0,"ymax":1209.0},{"id":24,"contenttext":"欽明天皇十三年に佛〓が傳はつて參りましたが、","xmin":2443.0,"ymin":1221.0,"xmax":2489.0,"ymax":1965.0},{"id":25,"contenttext":"佛〓は佛樣を拜む。","xmin":2445.0,"ymin":1976.0,"xmax":2489.0,"ymax":2274.0},{"id":26,"contenttext":"我國は神樣を拜む。","xmin":2376.0,"ymin":569.0,"xmax":2422.0,"ymax":865.0},{"id":27,"contenttext":"そこが一致しないところがあります。","xmin":2376.0,"ymin":878.0,"xmax":2418.0,"ymax":1449.0},{"id":28,"contenttext":"それでありますからして、","xmin":2374.0,"ymin":1461.0,"xmax":2417.0,"ymax":1861.0},{"id":29,"contenttext":"佛〓が傳はりまして、","xmin":2376.0,"ymin":1874.0,"xmax":2418.0,"ymax":2205.0},{"id":30,"contenttext":"それ","xmin":2378.0,"ymin":2217.0,"xmax":2420.0,"ymax":2293.0},{"id":31,"contenttext":"を更に政權を掌握するに利用して、","xmin":2303.0,"ymin":569.0,"xmax":2352.0,"ymax":1107.0},{"id":32,"contenttext":"蘇我氏と物部氏との爭ひになりました。","xmin":2304.0,"ymin":1117.0,"xmax":2349.0,"ymax":1727.0},{"id":33,"contenttext":"併し後には所謂神佛習合、","xmin":2305.0,"ymin":1736.0,"xmax":2351.0,"ymax":2140.0},{"id":34,"contenttext":"本地垂跡","xmin":2305.0,"ymin":2147.0,"xmax":2351.0,"ymax":2293.0},{"id":35,"contenttext":"といふやうな說が出まして、","xmin":2234.0,"ymin":571.0,"xmax":2281.0,"ymax":1001.0},{"id":36,"contenttext":"神道と佛〓と同一である、","xmin":2237.0,"ymin":1013.0,"xmax":2279.0,"ymax":1411.0},{"id":37,"contenttext":"詰り佛〓が日本化された。","xmin":2235.0,"ymin":1426.0,"xmax":2281.0,"ymax":1826.0},{"id":38,"contenttext":"儒〓も日本化して、","xmin":2235.0,"ymin":1838.0,"xmax":2279.0,"ymax":2134.0},{"id":39,"contenttext":"禪讓放伐","xmin":2237.0,"ymin":2148.0,"xmax":2280.0,"ymax":2293.0},{"id":40,"contenttext":"などゝいふやうなことは、","xmin":2168.0,"ymin":569.0,"xmax":2208.0,"ymax":968.0},{"id":41,"contenttext":"日本の儒〓には斷じて取らぬ。","xmin":2168.0,"ymin":983.0,"xmax":2212.0,"ymax":1449.0},{"id":42,"contenttext":"佛〓も本來印度の佛〓は、","xmin":2168.0,"ymin":1459.0,"xmax":2212.0,"ymax":1863.0},{"id":43,"contenttext":"未來といふことを盛んに說","xmin":2167.0,"ymin":1875.0,"xmax":2213.0,"ymax":2291.0},{"id":44,"contenttext":"くし戒律といふことを喧しく言ふ。","xmin":2098.0,"ymin":567.0,"xmax":2144.0,"ymax":1105.0},{"id":45,"contenttext":"ところが日本の佛〓は大乘佛〓と言ひまして、","xmin":2097.0,"ymin":1117.0,"xmax":2141.0,"ymax":1824.0},{"id":46,"contenttext":"大乘佛〓といふものは所謂現","xmin":2099.0,"ymin":1838.0,"xmax":2145.0,"ymax":2290.0},{"id":47,"contenttext":"象卽實在、","xmin":2030.0,"ymin":568.0,"xmax":2074.0,"ymax":728.0},{"id":48,"contenttext":"娑婆卽寂光土と言ふ。","xmin":2030.0,"ymin":738.0,"xmax":2074.0,"ymax":1072.0},{"id":49,"contenttext":"婆婆と申しますとこの婆婆世界、","xmin":2027.0,"ymin":1080.0,"xmax":2075.0,"ymax":1585.0},{"id":50,"contenttext":"娑婆世界が卽ち寂光の阿彌陀樣の世界だ。","xmin":2030.0,"ymin":1599.0,"xmax":2074.0,"ymax":2238.0},{"id":51,"contenttext":"詰","xmin":2030.0,"ymin":2247.0,"xmax":2074.0,"ymax":2291.0},{"id":52,"contenttext":"り現象卽實在、","xmin":1960.0,"ymin":568.0,"xmax":2006.0,"ymax":796.0},{"id":53,"contenttext":"さういふ哲學であります。","xmin":1960.0,"ymin":811.0,"xmax":2003.0,"ymax":1207.0},{"id":54,"contenttext":"現象卽實在、","xmin":1960.0,"ymin":1220.0,"xmax":2006.0,"ymax":1415.0},{"id":55,"contenttext":"或は煩惱卽菩提、","xmin":1958.0,"ymin":1422.0,"xmax":2006.0,"ymax":1688.0},{"id":56,"contenttext":"煩惱が直ちに菩提だといふのです。","xmin":1958.0,"ymin":1699.0,"xmax":2008.0,"ymax":2240.0},{"id":57,"contenttext":"菩","xmin":1960.0,"ymin":2244.0,"xmax":2007.0,"ymax":2289.0},{"id":58,"contenttext":"提といふのは佛道を體得したところのものであります。","xmin":1889.0,"ymin":569.0,"xmax":1932.0,"ymax":1414.0},{"id":59,"contenttext":"さういふ具合に言ふのです。","xmin":1888.0,"ymin":1428.0,"xmax":1933.0,"ymax":1863.0},{"id":60,"contenttext":"それでありますからして、","xmin":1888.0,"ymin":1872.0,"xmax":1931.0,"ymax":2270.0},{"id":61,"contenttext":"日本の大乘佛〓は印度邊りに盛んに行はれる小乘佛〓とはまるで違ふ。","xmin":1818.0,"ymin":569.0,"xmax":1865.0,"ymax":1651.0},{"id":62,"contenttext":"佛〓では結婚などをしない。","xmin":1817.0,"ymin":1661.0,"xmax":1865.0,"ymax":2099.0},{"id":63,"contenttext":"小乘の方で","xmin":1821.0,"ymin":2110.0,"xmax":1865.0,"ymax":2288.0},{"id":64,"contenttext":"はそれを戒律として非常に喧しく言ふのですけれども、","xmin":1598.0,"ymin":580.0,"xmax":1648.0,"ymax":1424.0},{"id":65,"contenttext":"日本の佛〓は結婚する。","xmin":1600.0,"ymin":1438.0,"xmax":1644.0,"ymax":1801.0},{"id":66,"contenttext":"殊に眞宗などでは盛んに結婚致","xmin":1599.0,"ymin":1811.0,"xmax":1644.0,"ymax":2302.0},{"id":67,"contenttext":"します。","xmin":1533.0,"ymin":582.0,"xmax":1574.0,"ymax":704.0},{"id":68,"contenttext":"又印度では魚を食べることは出來ないのですけれども、","xmin":1530.0,"ymin":716.0,"xmax":1575.0,"ymax":1561.0},{"id":69,"contenttext":"日本では盛んに食べる。","xmin":1530.0,"ymin":1574.0,"xmax":1575.0,"ymax":1935.0},{"id":70,"contenttext":"總て佛〓が皇國傳統の","xmin":1530.0,"ymin":1951.0,"xmax":1574.0,"ymax":2298.0},{"id":71,"contenttext":"精神によつて改造せられて居ります。","xmin":1460.0,"ymin":578.0,"xmax":1510.0,"ymax":1149.0},{"id":72,"contenttext":"だから等しく佛〓と申しましても、","xmin":1463.0,"ymin":1161.0,"xmax":1505.0,"ymax":1696.0},{"id":73,"contenttext":"日本の佛〓は印度の佛〓とはまるきり","xmin":1459.0,"ymin":1711.0,"xmax":1503.0,"ymax":2298.0},{"id":74,"contenttext":"樣子の變はつた佛〓が出來て居るのであります。","xmin":1390.0,"ymin":578.0,"xmax":1440.0,"ymax":1322.0},{"id":75,"contenttext":"之れがやはり和魂漢才でありまして、","xmin":1391.0,"ymin":1332.0,"xmax":1436.0,"ymax":1904.0},{"id":76,"contenttext":"かうした佛〓が日本の文","xmin":1389.0,"ymin":1918.0,"xmax":1434.0,"ymax":2300.0},{"id":77,"contenttext":"化に貢獻して居る點は大なるものがありまして、","xmin":1322.0,"ymin":578.0,"xmax":1370.0,"ymax":1319.0},{"id":78,"contenttext":"何人も之れは否定することは出來まいと思ひます。","xmin":1320.0,"ymin":1332.0,"xmax":1365.0,"ymax":2106.0},{"id":79,"contenttext":"要するに和魂漢才と申しまする根本主義は、","xmin":1255.0,"ymin":611.0,"xmax":1301.0,"ymax":1283.0},{"id":80,"contenttext":"日本の國家を基にして、","xmin":1255.0,"ymin":1299.0,"xmax":1297.0,"ymax":1660.0},{"id":81,"contenttext":"世界のあらゆる文化を我國に取入れるの","xmin":1253.0,"ymin":1674.0,"xmax":1299.0,"ymax":2297.0},{"id":82,"contenttext":"であります。","xmin":1191.0,"ymin":580.0,"xmax":1230.0,"ymax":771.0},{"id":83,"contenttext":"だから今日でも西洋の思想が盛んに這入りますが、","xmin":1186.0,"ymin":782.0,"xmax":1233.0,"ymax":1558.0},{"id":84,"contenttext":"それをどうしても我國にみな取入れて、","xmin":1184.0,"ymin":1572.0,"xmax":1230.0,"ymax":2177.0},{"id":85,"contenttext":"皇國傳","xmin":1184.0,"ymin":2189.0,"xmax":1228.0,"ymax":2298.0},{"id":86,"contenttext":"統の精神に依つて日本の文化の發展するやうにしなければなりませぬ。","xmin":1113.0,"ymin":576.0,"xmax":1166.0,"ymax":1660.0},{"id":87,"contenttext":"この頃問題となつて居ります天皇機關說","xmin":1114.0,"ymin":1678.0,"xmax":1162.0,"ymax":2298.0},{"id":88,"contenttext":"といふやうなのはみな西洋のを丸呑みにした結果であります。","xmin":1049.0,"ymin":578.0,"xmax":1093.0,"ymax":1525.0},{"id":89,"contenttext":"何でも丸呑みにするのは宜しくありません。","xmin":1044.0,"ymin":1536.0,"xmax":1091.0,"ymax":2209.0},{"id":90,"contenttext":"儒〓","xmin":1047.0,"ymin":2221.0,"xmax":1089.0,"ymax":2298.0},{"id":91,"contenttext":"でも、","xmin":985.0,"ymin":578.0,"xmax":1024.0,"ymax":666.0},{"id":92,"contenttext":"佛〓でも、","xmin":979.0,"ymin":676.0,"xmax":1028.0,"ymax":836.0},{"id":93,"contenttext":"西洋の思想でも、","xmin":981.0,"ymin":850.0,"xmax":1026.0,"ymax":1112.0},{"id":94,"contenttext":"丸呑みにしたら日本には當篏らない。","xmin":980.0,"ymin":1123.0,"xmax":1024.0,"ymax":1696.0},{"id":95,"contenttext":"それを皇國傳統の精神に依つて改造し","xmin":976.0,"ymin":1708.0,"xmax":1021.0,"ymax":2297.0},{"id":96,"contenttext":"なければならぬ。","xmin":912.0,"ymin":576.0,"xmax":957.0,"ymax":834.0},{"id":97,"contenttext":"その改造せられたものは更にこの傳統の精神を發展する材料になります。","xmin":908.0,"ymin":851.0,"xmax":956.0,"ymax":1967.0},{"id":98,"contenttext":"丁度吾々が魚を食べ","xmin":908.0,"ymin":1981.0,"xmax":953.0,"ymax":2291.0},{"id":99,"contenttext":"ますやうに、","xmin":844.0,"ymin":576.0,"xmax":888.0,"ymax":767.0},{"id":100,"contenttext":"鯛なら鯛といふもの、","xmin":846.0,"ymin":780.0,"xmax":888.0,"ymax":1110.0},{"id":101,"contenttext":"日本人は鯛を喜んで食べますが、","xmin":842.0,"ymin":1123.0,"xmax":888.0,"ymax":1626.0},{"id":102,"contenttext":"イギリス邊りでは鯛なんぞは、","xmin":840.0,"ymin":1639.0,"xmax":885.0,"ymax":2105.0},{"id":103,"contenttext":"人間の食べ","xmin":841.0,"ymin":2117.0,"xmax":885.0,"ymax":2291.0},{"id":104,"contenttext":"るものではない、","xmin":776.0,"ymin":576.0,"xmax":820.0,"ymax":834.0},{"id":105,"contenttext":"鯛は猫に食べさすものだといふので、","xmin":771.0,"ymin":848.0,"xmax":820.0,"ymax":1421.0},{"id":106,"contenttext":"魚の中でも最も安い魚だと云ふのであります。","xmin":769.0,"ymin":1431.0,"xmax":819.0,"ymax":2140.0},{"id":107,"contenttext":"あの旨い","xmin":770.0,"ymin":2154.0,"xmax":814.0,"ymax":2293.0},{"id":108,"contenttext":"ものを、","xmin":707.0,"ymin":576.0,"xmax":747.0,"ymax":700.0},{"id":109,"contenttext":"どうして食べないのだらうと思つて不思議に思ひますけれども、","xmin":701.0,"ymin":712.0,"xmax":750.0,"ymax":1692.0},{"id":110,"contenttext":"西洋の鯛は不味いかも知れませぬ。(笑","xmin":700.0,"ymin":1706.0,"xmax":748.0,"ymax":2297.0},{"id":111,"contenttext":"聲)","xmin":640.0,"ymin":575.0,"xmax":682.0,"ymax":638.0},{"id":112,"contenttext":"どういふ譯だかイギリス邊りでは鯛はあまり食べない。","xmin":636.0,"ymin":643.0,"xmax":680.0,"ymax":1488.0},{"id":113,"contenttext":"我國では腐つても鯛といふので、","xmin":634.0,"ymin":1500.0,"xmax":676.0,"ymax":2000.0},{"id":114,"contenttext":"非常に鯛を尊重す","xmin":634.0,"ymin":2015.0,"xmax":676.0,"ymax":2293.0},{"id":115,"contenttext":"る。","xmin":578.0,"ymin":578.0,"xmax":613.0,"ymax":629.0},{"id":116,"contenttext":"併しその鯛を煮て食べる爲めに頭からがり〓〓食べたら、","xmin":568.0,"ymin":641.0,"xmax":615.0,"ymax":1521.0},{"id":117,"contenttext":"鯛の骨は鰯の骨と違つて堅いものですから、","xmin":567.0,"ymin":1533.0,"xmax":613.0,"ymax":2207.0},{"id":118,"contenttext":"咽に","xmin":569.0,"ymin":2221.0,"xmax":608.0,"ymax":2291.0},{"id":119,"contenttext":"皇國傳統の精神","xmin":504.0,"ymin":754.0,"xmax":547.0,"ymax":970.0},{"id":120,"contenttext":"是","xmin":504.0,"ymin":2198.0,"xmax":541.0,"ymax":2235.0}]