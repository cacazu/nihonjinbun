[{"id":0,"contenttext":"皇國傳統の精神","xmin":2899.0,"ymin":749.0,"xmax":2938.0,"ymax":963.0},{"id":1,"contenttext":"言","xmin":2905.0,"ymin":2191.0,"xmax":2935.0,"ymax":2228.0},{"id":2,"contenttext":"も鉤を返さうとなさるのだけれども今言ふ通り鉤を取らて御終ひになつて返されませぬ。","xmin":2830.0,"ymin":571.0,"xmax":2875.0,"ymax":1924.0},{"id":3,"contenttext":"矢張りさういふ時代で","xmin":2831.0,"ymin":1937.0,"xmax":2873.0,"ymax":2286.0},{"id":4,"contenttext":"もチヤンと鉤を作る製造人なんかは澤山居つたものと見えます、","xmin":2762.0,"ymin":569.0,"xmax":2806.0,"ymax":1549.0},{"id":5,"contenttext":"そこで火遠理命は御使ひになる刀を一本毀して","xmin":2761.0,"ymin":1561.0,"xmax":2808.0,"ymax":2284.0},{"id":6,"contenttext":"鉤を御作らせになつた。","xmin":2693.0,"ymin":566.0,"xmax":2738.0,"ymax":932.0},{"id":7,"contenttext":"さうして","xmin":2698.0,"ymin":946.0,"xmax":2735.0,"ymax":1086.0},{"id":8,"contenttext":"「あなたの鉤をなくして濟みませんが、","xmin":2693.0,"ymin":1091.0,"xmax":2738.0,"ymax":1687.0},{"id":9,"contenttext":"どうかこれで勘辨して戴きたい」とい","xmin":2691.0,"ymin":1695.0,"xmax":2739.0,"ymax":2281.0},{"id":10,"contenttext":"ふので五百本の鉤を作つて御返しになつた。","xmin":2624.0,"ymin":568.0,"xmax":2669.0,"ymax":1239.0},{"id":11,"contenttext":"ところが「いけない」","xmin":2624.0,"ymin":1253.0,"xmax":2668.0,"ymax":1588.0},{"id":12,"contenttext":"と仰しやる。","xmin":2626.0,"ymin":1592.0,"xmax":2668.0,"ymax":1784.0},{"id":13,"contenttext":"それではもつと作りませうとい","xmin":2624.0,"ymin":1798.0,"xmax":2668.0,"ymax":2279.0},{"id":14,"contenttext":"ふので一千本作つて、「どうかこれだけ作つたから、","xmin":2556.0,"ymin":566.0,"xmax":2601.0,"ymax":1339.0},{"id":15,"contenttext":"これで勘辨して戴きたい」。","xmin":2556.0,"ymin":1355.0,"xmax":2601.0,"ymax":1770.0},{"id":16,"contenttext":"ところが「いけない、","xmin":2552.0,"ymin":1797.0,"xmax":2602.0,"ymax":2124.0},{"id":17,"contenttext":"元のを返","xmin":2552.0,"ymin":2137.0,"xmax":2600.0,"ymax":2285.0},{"id":18,"contenttext":"せ」","xmin":2487.0,"ymin":566.0,"xmax":2530.0,"ymax":627.0},{"id":19,"contenttext":"かう難題を仰しやる。","xmin":2487.0,"ymin":631.0,"xmax":2530.0,"ymax":961.0},{"id":20,"contenttext":"それで困つたことになつたと思はれて、","xmin":2487.0,"ymin":975.0,"xmax":2532.0,"ymax":1577.0},{"id":21,"contenttext":"火遠理命が海岸を心配して御歩きになつた。","xmin":2487.0,"ymin":1590.0,"xmax":2532.0,"ymax":2261.0},{"id":22,"contenttext":"そこへ鹽椎の神といふ神樣がお出でになつた。","xmin":2420.0,"ymin":562.0,"xmax":2465.0,"ymax":1273.0},{"id":23,"contenttext":"鹽は海の潮でありますから、","xmin":2420.0,"ymin":1278.0,"xmax":2462.0,"ymax":1713.0},{"id":24,"contenttext":"鹽椎の神は矢張り海に關した神樣","xmin":2418.0,"ymin":1725.0,"xmax":2464.0,"ymax":2282.0},{"id":25,"contenttext":"で、","xmin":2353.0,"ymin":564.0,"xmax":2395.0,"ymax":619.0},{"id":26,"contenttext":"何でも能く知つて居られる神樣です。","xmin":2351.0,"ymin":627.0,"xmax":2397.0,"ymax":1200.0},{"id":27,"contenttext":"この神樣がそこへ御現れになつて","xmin":2349.0,"ymin":1216.0,"xmax":2393.0,"ymax":1731.0},{"id":28,"contenttext":"「皇太子樣にはどうしてそんなに御","xmin":2351.0,"ymin":1738.0,"xmax":2393.0,"ymax":2282.0},{"id":29,"contenttext":"悲みになりますか」「いや實はかうかういふ次第だ」。","xmin":2282.0,"ymin":560.0,"xmax":2331.0,"ymax":1375.0},{"id":30,"contenttext":"それならこれから此の船に乘つてお出でになると味御路と","xmin":2282.0,"ymin":1384.0,"xmax":2326.0,"ymax":2279.0},{"id":31,"contenttext":"as","xmin":2247.0,"ymin":1775.0,"xmax":2274.0,"ymax":1819.0},{"id":32,"contenttext":"いふのがあつて、","xmin":2214.0,"ymin":564.0,"xmax":2261.0,"ymax":823.0},{"id":33,"contenttext":"れて船を乗つてくんくお出でになると絶津見の神-經理見の神は語","xmin":2211.0,"ymin":835.0,"xmax":2259.0,"ymax":2089.0},{"id":34,"contenttext":"航海を司る","xmin":2214.0,"ymin":2103.0,"xmax":2258.0,"ymax":2281.0},{"id":35,"contenttext":"神で、今日の歷史家などはそれが福岡縣邊りにあつたのだらうといふことを申しますが、それは太古のことである","xmin":2143.0,"ymin":557.0,"xmax":2189.0,"ymax":2281.0},{"id":36,"contenttext":"たちら","xmin":2108.0,"ymin":1103.0,"xmax":2136.0,"ymax":1167.0},{"id":37,"contenttext":"から吾々に分りませぬが、","xmin":2074.0,"ymin":560.0,"xmax":2120.0,"ymax":959.0},{"id":38,"contenttext":"兎に角、","xmin":2076.0,"ymin":969.0,"xmax":2120.0,"ymax":1096.0},{"id":39,"contenttext":"綿津見の神の宮殿のところにお出でになると、","xmin":2074.0,"ymin":1107.0,"xmax":2120.0,"ymax":1817.0},{"id":40,"contenttext":"前に井戶があつて、","xmin":2074.0,"ymin":1828.0,"xmax":2120.0,"ymax":2126.0},{"id":41,"contenttext":"その井戶","xmin":2073.0,"ymin":2138.0,"xmax":2119.0,"ymax":2279.0},{"id":42,"contenttext":"しほつも","xmin":2036.0,"ymin":2101.0,"xmax":2065.0,"ymax":2175.0},{"id":43,"contenttext":"のところに湯津香木の樹があるから、","xmin":2006.0,"ymin":562.0,"xmax":2052.0,"ymax":1128.0},{"id":44,"contenttext":"そのところへお出でになると何とか良い方法がありませう、","xmin":2006.0,"ymin":1140.0,"xmax":2052.0,"ymax":2055.0},{"id":45,"contenttext":"と鹽椎の神が","xmin":2004.0,"ymin":2069.0,"xmax":2050.0,"ymax":2281.0},{"id":46,"contenttext":"〓へて吳れた。","xmin":1934.0,"ymin":557.0,"xmax":1983.0,"ymax":786.0},{"id":47,"contenttext":"そこで火遠理命はその方へお出でになつた。","xmin":1937.0,"ymin":797.0,"xmax":1983.0,"ymax":1472.0},{"id":48,"contenttext":"さうするとそこへ海神の御むすめ豊玉昆賣の從婢が","xmin":1934.0,"ymin":1486.0,"xmax":1978.0,"ymax":2277.0},{"id":49,"contenttext":"水をくみに來たので、","xmin":1872.0,"ymin":559.0,"xmax":1916.0,"ymax":889.0},{"id":50,"contenttext":"火還理命が「水を一杯飮まして貰ひたい」","xmin":1872.0,"ymin":899.0,"xmax":1916.0,"ymax":1546.0},{"id":51,"contenttext":"と仰しやつた。","xmin":1870.0,"ymin":1551.0,"xmax":1916.0,"ymax":1780.0},{"id":52,"contenttext":"そこで從婢がその容器に入れて","xmin":1870.0,"ymin":1792.0,"xmax":1914.0,"ymax":2275.0},{"id":53,"contenttext":"$","xmin":1837.0,"ymin":1273.0,"xmax":1863.0,"ymax":1334.0},{"id":54,"contenttext":"上げたが、","xmin":1803.0,"ymin":557.0,"xmax":1849.0,"ymax":717.0},{"id":55,"contenttext":"火遠理命は水を御飮みにならんで、","xmin":1803.0,"ymin":725.0,"xmax":1849.0,"ymax":1267.0},{"id":56,"contenttext":"御頸の飾の玉をその中に御入れになつた。","xmin":1800.0,"ymin":1276.0,"xmax":1846.0,"ymax":1918.0},{"id":57,"contenttext":"さうすると從婢がその","xmin":1800.0,"ymin":1929.0,"xmax":1844.0,"ymax":2278.0},{"id":58,"contenttext":"玉を取らうとしてもくつ付いて取れない。","xmin":1589.0,"ymin":576.0,"xmax":1636.0,"ymax":1213.0},{"id":59,"contenttext":"そこでそれを持つて歸つて豐玉昆賣に申上げた。","xmin":1592.0,"ymin":1225.0,"xmax":1636.0,"ymax":1970.0},{"id":60,"contenttext":"するとお姫様がお父","xmin":1592.0,"ymin":1978.0,"xmax":1636.0,"ymax":2293.0},{"id":61,"contenttext":"わたつふ","xmin":1555.0,"ymin":673.0,"xmax":1583.0,"ymax":753.0},{"id":62,"contenttext":"さんの縮津見の神に申上げた。","xmin":1523.0,"ymin":575.0,"xmax":1569.0,"ymax":1042.0},{"id":63,"contenttext":"お父さんはそれを御覽になつて「オヽこれは皇太子樣だ」","xmin":1525.0,"ymin":1054.0,"xmax":1569.0,"ymax":1938.0},{"id":64,"contenttext":"かう仰せになつた。","xmin":1523.0,"ymin":1946.0,"xmax":1569.0,"ymax":2244.0},{"id":65,"contenttext":"そ","xmin":1528.0,"ymin":2251.0,"xmax":1563.0,"ymax":2291.0},{"id":66,"contenttext":"れから直ぐ中にお入れになつて非常に款待遊ばした。","xmin":1454.0,"ymin":573.0,"xmax":1503.0,"ymax":1385.0},{"id":67,"contenttext":"さうして一人のお姫様の重玉昆賣を妃殿下になさつた。","xmin":1454.0,"ymin":1398.0,"xmax":1502.0,"ymax":2244.0},{"id":68,"contenttext":"そ","xmin":1458.0,"ymin":2251.0,"xmax":1493.0,"ymax":2291.0},{"id":69,"contenttext":"れから三年ばかりそこに御住ひになつた。","xmin":1385.0,"ymin":573.0,"xmax":1427.0,"ymax":1211.0},{"id":70,"contenttext":"さうすると火遠理命が一日長大息をなさつた。","xmin":1384.0,"ymin":1225.0,"xmax":1431.0,"ymax":1931.0},{"id":71,"contenttext":"お姫様がそれをお聞き","xmin":1385.0,"ymin":1946.0,"xmax":1427.0,"ymax":2291.0},{"id":72,"contenttext":"になつて、","xmin":1317.0,"ymin":575.0,"xmax":1361.0,"ymax":730.0},{"id":73,"contenttext":"お父さんの綿津見の神に仰しやつた。","xmin":1315.0,"ymin":747.0,"xmax":1364.0,"ymax":1317.0},{"id":74,"contenttext":"「今迄歎息をなさつたことがないのに今日は御心配があると見","xmin":1313.0,"ymin":1341.0,"xmax":1362.0,"ymax":2291.0},{"id":75,"contenttext":"えて歎息をなさつたが、","xmin":1245.0,"ymin":576.0,"xmax":1294.0,"ymax":938.0},{"id":76,"contenttext":"如何なものでありませう」","xmin":1248.0,"ymin":948.0,"xmax":1292.0,"ymax":1355.0},{"id":77,"contenttext":"と仰しやつたから、","xmin":1248.0,"ymin":1359.0,"xmax":1294.0,"ymax":1657.0},{"id":78,"contenttext":"お父さんが","xmin":1248.0,"ymin":1673.0,"xmax":1292.0,"ymax":1850.0},{"id":79,"contenttext":"「皇太子樣は非常に歎息をな","xmin":1246.0,"ymin":1851.0,"xmax":1292.0,"ymax":2292.0},{"id":80,"contenttext":"さつたといふことですが、","xmin":1175.0,"ymin":574.0,"xmax":1222.0,"ymax":972.0},{"id":81,"contenttext":"何か御心配事がありますか」とお聞きになつた。","xmin":1176.0,"ymin":983.0,"xmax":1223.0,"ymax":1727.0},{"id":82,"contenttext":"そこで","xmin":1177.0,"ymin":1738.0,"xmax":1220.0,"ymax":1846.0},{"id":83,"contenttext":"「魚に鉤を取られて困つて居","xmin":1176.0,"ymin":1850.0,"xmax":1221.0,"ymax":2292.0},{"id":84,"contenttext":"るのだ」とお話しになつたので、","xmin":1104.0,"ymin":574.0,"xmax":1154.0,"ymax":1074.0},{"id":85,"contenttext":"綿津見の神は海の神樣でありますから、","xmin":1107.0,"ymin":1086.0,"xmax":1153.0,"ymax":1692.0},{"id":86,"contenttext":"魚の全部をお集めになつて","xmin":1107.0,"ymin":1704.0,"xmax":1149.0,"ymax":2122.0},{"id":87,"contenttext":"「お前達の","xmin":1105.0,"ymin":2124.0,"xmax":1151.0,"ymax":2291.0},{"id":88,"contenttext":"中に鉤を取つた者はないか」とお聞きになつた所が、","xmin":1040.0,"ymin":575.0,"xmax":1086.0,"ymax":1381.0},{"id":89,"contenttext":"諸の魚がこのごろ赤鯛が咽を痛めて居りますが、","xmin":1040.0,"ymin":1394.0,"xmax":1084.0,"ymax":2138.0},{"id":90,"contenttext":"あれが取","xmin":1040.0,"ymin":2150.0,"xmax":1084.0,"ymax":2293.0},{"id":91,"contenttext":"つたのでせう」と答へました。","xmin":969.0,"ymin":578.0,"xmax":1016.0,"ymax":1042.0},{"id":92,"contenttext":"「ではそれを連れて來い」といふやうな譯で、","xmin":969.0,"ymin":1066.0,"xmax":1016.0,"ymax":1759.0},{"id":93,"contenttext":"それからそれへと探すと鉤が果し","xmin":968.0,"ymin":1770.0,"xmax":1019.0,"ymax":2291.0},{"id":94,"contenttext":"て出て來ました。","xmin":902.0,"ymin":576.0,"xmax":946.0,"ymax":835.0},{"id":95,"contenttext":"それをよく洗ひ〓めて、","xmin":902.0,"ymin":845.0,"xmax":944.0,"ymax":1209.0},{"id":96,"contenttext":"差上げて、「これです、","xmin":900.0,"ymin":1223.0,"xmax":950.0,"ymax":1555.0},{"id":97,"contenttext":"これを持つてお歸り遊ばせ」といふやうな譯で","xmin":901.0,"ymin":1569.0,"xmax":946.0,"ymax":2289.0},{"id":98,"contenttext":"あつた。","xmin":834.0,"ymin":575.0,"xmax":878.0,"ymax":700.0},{"id":99,"contenttext":"その時に海神なさつて、","xmin":831.0,"ymin":710.0,"xmax":877.0,"ymax":1213.0},{"id":100,"contenttext":"その不都合な兄御子を今後の爲に十分にお懲らしになることが必要で","xmin":831.0,"ymin":1223.0,"xmax":880.0,"ymax":2290.0},{"id":101,"contenttext":"ありますと、","xmin":767.0,"ymin":575.0,"xmax":807.0,"ymax":763.0},{"id":102,"contenttext":"潮の干く玉と、","xmin":765.0,"ymin":776.0,"xmax":809.0,"ymax":1006.0},{"id":103,"contenttext":"潮の滿つる玉とをお渡しになつた。","xmin":765.0,"ymin":1015.0,"xmax":810.0,"ymax":1556.0},{"id":104,"contenttext":"それを貰つてお歸りになり、","xmin":765.0,"ymin":1565.0,"xmax":807.0,"ymax":1997.0},{"id":105,"contenttext":"その潮の滿つる玉","xmin":763.0,"ymin":2011.0,"xmax":812.0,"ymax":2290.0},{"id":106,"contenttext":"を以て兄御子を溺れさした。","xmin":698.0,"ymin":573.0,"xmax":742.0,"ymax":1006.0},{"id":107,"contenttext":"そこで兄御子が救助を願つて、「皇室の爲に忠實に働きますからどうか勘辨して戴き","xmin":695.0,"ymin":1017.0,"xmax":744.0,"ymax":2290.0},{"id":108,"contenttext":"たい」","xmin":627.0,"ymin":575.0,"xmax":672.0,"ymax":668.0},{"id":109,"contenttext":"かう言はれたから潮の干く玉を以て潮を干さして兄御子をお救ひになつた。","xmin":627.0,"ymin":675.0,"xmax":673.0,"ymax":1828.0},{"id":110,"contenttext":"そこでその兄御子の御子孫は","xmin":629.0,"ymin":1838.0,"xmax":673.0,"ymax":2289.0},{"id":111,"contenttext":"以後忠實に仕へられることになつたといふ傳說でありますが、","xmin":564.0,"ymin":571.0,"xmax":610.0,"ymax":1521.0},{"id":112,"contenttext":"それが既に鹽椎の神といふ神様がお現れになると","xmin":564.0,"ymin":1531.0,"xmax":610.0,"ymax":2290.0},{"id":113,"contenttext":"皇國傳統の精神","xmin":499.0,"ymin":751.0,"xmax":538.0,"ymax":963.0},{"id":114,"contenttext":"三","xmin":504.0,"ymin":2193.0,"xmax":538.0,"ymax":2230.0}]