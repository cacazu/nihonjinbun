[{"id":0,"contenttext":"皇國傳統の精神","xmin":2957.0,"ymin":774.0,"xmax":2996.0,"ymax":991.0},{"id":1,"contenttext":"三","xmin":2947.0,"ymin":2217.0,"xmax":2977.0,"ymax":2256.0},{"id":2,"contenttext":"さういふ日本人が澤山居りましたならば、","xmin":2885.0,"ymin":595.0,"xmax":2934.0,"ymax":1234.0},{"id":3,"contenttext":"日本は到底持つことが出來ない。","xmin":2878.0,"ymin":1246.0,"xmax":2929.0,"ymax":1749.0},{"id":4,"contenttext":"さういふ譯でありますから吾々はこ","xmin":2871.0,"ymin":1762.0,"xmax":2919.0,"ymax":2313.0},{"id":5,"contenttext":"の天壤無窮の國家をどこ迄も發展することに努めなければならぬ。","xmin":2809.0,"ymin":597.0,"xmax":2868.0,"ymax":1610.0},{"id":6,"contenttext":"一體この人間の世の中で、","xmin":2746.0,"ymin":636.0,"xmax":2796.0,"ymax":1026.0},{"id":7,"contenttext":"一番貴いものは何でありませうか。","xmin":2738.0,"ymin":1046.0,"xmax":2792.0,"ymax":1574.0},{"id":8,"contenttext":"人に依りますと、","xmin":2739.0,"ymin":1586.0,"xmax":2781.0,"ymax":1847.0},{"id":9,"contenttext":"此の問題に對してこの世の中","xmin":2729.0,"ymin":1861.0,"xmax":2782.0,"ymax":2313.0},{"id":10,"contenttext":"で最も貴いものはお金であると申します。「マネー·イズ·パワー」お金は權力である、お金は總べてものを作り","xmin":2660.0,"ymin":595.0,"xmax":2726.0,"ymax":2311.0},{"id":11,"contenttext":"出すものである。","xmin":2610.0,"ymin":592.0,"xmax":2657.0,"ymax":852.0},{"id":12,"contenttext":"立派な家が欲しいと思ふならば、","xmin":2606.0,"ymin":865.0,"xmax":2656.0,"ymax":1370.0},{"id":13,"contenttext":"直ぐお金さへあれば立派な家が出來る。","xmin":2597.0,"ymin":1376.0,"xmax":2649.0,"ymax":1985.0},{"id":14,"contenttext":"立派な自動車を作つ","xmin":2594.0,"ymin":1995.0,"xmax":2640.0,"ymax":2311.0},{"id":15,"contenttext":"て乘つて見たいと思へば立派な自動車を作ることが出來る。","xmin":2533.0,"ymin":594.0,"xmax":2589.0,"ymax":1506.0},{"id":16,"contenttext":"お金があれば何でも出來る、","xmin":2528.0,"ymin":1519.0,"xmax":2579.0,"ymax":1950.0},{"id":17,"contenttext":"慶應義塾を創められた","xmin":2522.0,"ymin":1959.0,"xmax":2573.0,"ymax":2313.0},{"id":18,"contenttext":"福澤先生は盛んにこの黄金萬能を唱へられたと云ふことであります。","xmin":2462.0,"ymin":590.0,"xmax":2523.0,"ymax":1641.0},{"id":19,"contenttext":"二人の生徒が或る時先生のところへ訪問し","xmin":2453.0,"ymin":1653.0,"xmax":2509.0,"ymax":2311.0},{"id":20,"contenttext":"たら、","xmin":2408.0,"ymin":589.0,"xmax":2452.0,"ymax":680.0},{"id":21,"contenttext":"先生がその二人の生徒に對してお前には財產があるかと聞かれ、","xmin":2393.0,"ymin":692.0,"xmax":2453.0,"ymax":1676.0},{"id":22,"contenttext":"財產のある方の生徒を上座に就かしめら","xmin":2382.0,"ymin":1684.0,"xmax":2440.0,"ymax":2309.0},{"id":23,"contenttext":"れたといふ話があります。","xmin":2333.0,"ymin":588.0,"xmax":2383.0,"ymax":989.0},{"id":24,"contenttext":"(笑聲)","xmin":2332.0,"ymin":996.0,"xmax":2378.0,"ymax":1112.0},{"id":25,"contenttext":"果してさうであつたかは明確でありませんが、","xmin":2322.0,"ymin":1135.0,"xmax":2377.0,"ymax":1843.0},{"id":26,"contenttext":"儲に慶應の學風はお金を重じ","xmin":2315.0,"ymin":1851.0,"xmax":2367.0,"ymax":2308.0},{"id":27,"contenttext":"た事だけは否定出來ないのであります。","xmin":2262.0,"ymin":587.0,"xmax":2314.0,"ymax":1192.0},{"id":28,"contenttext":"それですから今日でも慶應の出身者は經濟社會に非常に進出しまして、","xmin":2247.0,"ymin":1203.0,"xmax":2307.0,"ymax":2288.0},{"id":29,"contenttext":"日本の實業の方面には非常な潜勢力を有して居るのであります。","xmin":2189.0,"ymin":587.0,"xmax":2246.0,"ymax":1571.0},{"id":30,"contenttext":"とに角人生に一番大事なものはお金であると。","xmin":2177.0,"ymin":1580.0,"xmax":2235.0,"ymax":2286.0},{"id":31,"contenttext":"さう云ふものが大變多數にあることは疑ふ餘地はありませぬ。","xmin":2119.0,"ymin":587.0,"xmax":2176.0,"ymax":1530.0},{"id":32,"contenttext":"併し又或る人々はお金などは駄目である。","xmin":2053.0,"ymin":618.0,"xmax":2107.0,"ymax":1257.0},{"id":33,"contenttext":"お金などを彼れ此れ云ふのは極めて野卑なものである。","xmin":2043.0,"ymin":1270.0,"xmax":2099.0,"ymax":2115.0},{"id":34,"contenttext":"人間は名譽","xmin":2039.0,"ymin":2125.0,"xmax":2086.0,"ymax":2306.0},{"id":35,"contenttext":"といふものを尊ばなければならぬ。","xmin":1985.0,"ymin":583.0,"xmax":2036.0,"ymax":1121.0},{"id":36,"contenttext":"名譽は人生最も貴重なのもので、","xmin":1980.0,"ymin":1129.0,"xmax":2031.0,"ymax":1634.0},{"id":37,"contenttext":"昔から人は一生、","xmin":1973.0,"ymin":1642.0,"xmax":2025.0,"ymax":1907.0},{"id":38,"contenttext":"名は末代と云ひ、","xmin":1970.0,"ymin":1917.0,"xmax":2021.0,"ymax":2183.0},{"id":39,"contenttext":"名譽と","xmin":1967.0,"ymin":2191.0,"xmax":2016.0,"ymax":2305.0},{"id":40,"contenttext":"いふものが大切なのである。","xmin":1917.0,"ymin":586.0,"xmax":1972.0,"ymax":1016.0},{"id":41,"contenttext":"かういふ風に申すのであります。","xmin":1914.0,"ymin":1025.0,"xmax":1963.0,"ymax":1530.0},{"id":42,"contenttext":"成る程、","xmin":1910.0,"ymin":1538.0,"xmax":1958.0,"ymax":1666.0},{"id":43,"contenttext":"名譽といふものも大切なものでありま","xmin":1900.0,"ymin":1676.0,"xmax":1956.0,"ymax":2299.0},{"id":44,"contenttext":"す。","xmin":1856.0,"ymin":580.0,"xmax":1900.0,"ymax":640.0},{"id":45,"contenttext":"併し又或る人々はいや名譽がいくらあつたつて貴い解位の榮譽を辱うしても、","xmin":1840.0,"ymin":646.0,"xmax":1902.0,"ymax":1835.0},{"id":46,"contenttext":"貴い動位を戴いても、","xmin":1835.0,"ymin":1843.0,"xmax":1885.0,"ymax":2179.0},{"id":47,"contenttext":"生命が","xmin":1832.0,"ymin":2187.0,"xmax":1881.0,"ymax":2298.0},{"id":48,"contenttext":"三","xmin":2947.0,"ymin":2217.0,"xmax":2977.0,"ymax":2256.0},{"id":49,"contenttext":"さういふ譯でありますから吾々はこ","xmin":2871.0,"ymin":1762.0,"xmax":2919.0,"ymax":2313.0},{"id":50,"contenttext":"なくてはその有難さを感ずる譯には行かぬ。","xmin":1622.0,"ymin":583.0,"xmax":1680.0,"ymax":1256.0},{"id":51,"contenttext":"「命あつてのもの種」","xmin":1635.0,"ymin":1279.0,"xmax":1686.0,"ymax":1604.0},{"id":52,"contenttext":"生命が大切である。","xmin":1643.0,"ymin":1609.0,"xmax":1687.0,"ymax":1905.0},{"id":53,"contenttext":"かう言ふのであります。","xmin":1645.0,"ymin":1919.0,"xmax":1695.0,"ymax":2281.0},{"id":54,"contenttext":"成る程生命も大切であります。","xmin":1555.0,"ymin":581.0,"xmax":1604.0,"ymax":1051.0},{"id":55,"contenttext":"百萬圓やるからお前の生命を吳れと言ひましても、","xmin":1564.0,"ymin":1061.0,"xmax":1618.0,"ymax":1837.0},{"id":56,"contenttext":"百萬圓貰つて生命を上げて終","xmin":1576.0,"ymin":1850.0,"xmax":1629.0,"ymax":2304.0},{"id":57,"contenttext":"つたら何にもなりません。","xmin":1486.0,"ymin":587.0,"xmax":1536.0,"ymax":982.0},{"id":58,"contenttext":"さういふ譯で生命が大切だといふと、","xmin":1495.0,"ymin":995.0,"xmax":1549.0,"ymax":1564.0},{"id":59,"contenttext":"これも一理あると云ふことになります。","xmin":1503.0,"ymin":1579.0,"xmax":1557.0,"ymax":2181.0},{"id":60,"contenttext":"右の次第で世の中に大切なものはいろ〓〓ありますが、","xmin":1416.0,"ymin":618.0,"xmax":1479.0,"ymax":1464.0},{"id":61,"contenttext":"併し私をして人生最も大切なものは何かと云はしめま","xmin":1431.0,"ymin":1473.0,"xmax":1493.0,"ymax":2306.0},{"id":62,"contenttext":"すれば、","xmin":1348.0,"ymin":585.0,"xmax":1392.0,"ymax":712.0},{"id":63,"contenttext":"私は國家であると斷言致します。","xmin":1350.0,"ymin":720.0,"xmax":1402.0,"ymax":1225.0},{"id":64,"contenttext":"國家が若し混亂の狀態に陷りましたならば、","xmin":1357.0,"ymin":1235.0,"xmax":1414.0,"ymax":1913.0},{"id":65,"contenttext":"如何にお金がありました","xmin":1369.0,"ymin":1922.0,"xmax":1421.0,"ymax":2308.0},{"id":66,"contenttext":"ところが何にもなりませぬ。","xmin":1277.0,"ymin":588.0,"xmax":1328.0,"ymax":1019.0},{"id":67,"contenttext":"國家が外國の爲に占領されたり何かしましたならば、","xmin":1284.0,"ymin":1031.0,"xmax":1343.0,"ymax":1843.0},{"id":68,"contenttext":"財產の保護なんかはとても期","xmin":1297.0,"ymin":1854.0,"xmax":1351.0,"ymax":2308.0},{"id":69,"contenttext":"待できませぬ。","xmin":1207.0,"ymin":587.0,"xmax":1255.0,"ymax":818.0},{"id":70,"contenttext":"今日印度邊りの狀態を見ても分ります。","xmin":1211.0,"ymin":828.0,"xmax":1267.0,"ymax":1434.0},{"id":71,"contenttext":"又名譽と言ひましても、","xmin":1221.0,"ymin":1444.0,"xmax":1273.0,"ymax":1812.0},{"id":72,"contenttext":"その國家が滅びましたならば、","xmin":1226.0,"ymin":1822.0,"xmax":1284.0,"ymax":2290.0},{"id":73,"contenttext":"名譽も何にもなりませぬ。","xmin":1138.0,"ymin":588.0,"xmax":1187.0,"ymax":989.0},{"id":74,"contenttext":"ロシヤ邊りへ行くと、","xmin":1147.0,"ymin":1008.0,"xmax":1190.0,"ymax":1331.0},{"id":75,"contenttext":"帝政時代の公爵や何かゞ荷車を引つ張つて居る。","xmin":1149.0,"ymin":1341.0,"xmax":1208.0,"ymax":2089.0},{"id":76,"contenttext":"荷車を引つ張","xmin":1162.0,"ymin":2097.0,"xmax":1212.0,"ymax":2313.0},{"id":77,"contenttext":"つて居て私は帝政時代にはこれでも公爵だと威張つたところが何にもなりませぬ。","xmin":1069.0,"ymin":595.0,"xmax":1136.0,"ymax":1848.0},{"id":78,"contenttext":"國家が滅びたならば如何なる","xmin":1090.0,"ymin":1859.0,"xmax":1146.0,"ymax":2313.0},{"id":79,"contenttext":"名譽も丸きり價値がなくなります。","xmin":1000.0,"ymin":590.0,"xmax":1052.0,"ymax":1127.0},{"id":80,"contenttext":"或は又生命と言ひましたところが、","xmin":1008.0,"ymin":1140.0,"xmax":1063.0,"ymax":1677.0},{"id":81,"contenttext":"我が國家などはかういふ風にキチンとし","xmin":1018.0,"ymin":1688.0,"xmax":1072.0,"ymax":2311.0},{"id":82,"contenttext":"て居りますから、","xmin":933.0,"ymin":596.0,"xmax":976.0,"ymax":853.0},{"id":83,"contenttext":"吾々は平穩に暮して行くことが出來るのであります。","xmin":936.0,"ymin":865.0,"xmax":991.0,"ymax":1677.0},{"id":84,"contenttext":"若しこれが外國から侵略を受けるといふ","xmin":947.0,"ymin":1689.0,"xmax":1006.0,"ymax":2311.0},{"id":85,"contenttext":"やうな狀態であつたら吾々は、","xmin":862.0,"ymin":599.0,"xmax":917.0,"ymax":1065.0},{"id":86,"contenttext":"ヂツとしては居られませぬ。","xmin":870.0,"ymin":1075.0,"xmax":922.0,"ymax":1507.0},{"id":87,"contenttext":"でありますから詰り人生の總べての價値の根源は國","xmin":876.0,"ymin":1522.0,"xmax":939.0,"ymax":2317.0},{"id":88,"contenttext":"家にありまして、","xmin":794.0,"ymin":595.0,"xmax":840.0,"ymax":857.0},{"id":89,"contenttext":"國家が堅實であつて初めてこれ等の價値は生じて來るのであります。","xmin":797.0,"ymin":870.0,"xmax":860.0,"ymax":1923.0},{"id":90,"contenttext":"あらゆるものゝ價値は國","xmin":814.0,"ymin":1933.0,"xmax":868.0,"ymax":2317.0},{"id":91,"contenttext":"家が基になつて來るのでありますから、","xmin":722.0,"ymin":599.0,"xmax":781.0,"ymax":1204.0},{"id":92,"contenttext":"吾々はこの國家をどこ迄も發展して行かなければなりませぬ。","xmin":734.0,"ymin":1214.0,"xmax":796.0,"ymax":2165.0},{"id":93,"contenttext":"將來は國","xmin":753.0,"ymin":2175.0,"xmax":797.0,"ymax":2319.0},{"id":94,"contenttext":"際關係が益々複雜になつて來まして、","xmin":651.0,"ymin":599.0,"xmax":712.0,"ymax":1171.0},{"id":95,"contenttext":"我國なども動もすれば弧立の狀態に陷らんとするやうな形勢でありますが","xmin":660.0,"ymin":1180.0,"xmax":730.0,"ymax":2320.0},{"id":96,"contenttext":"たとへ張立になつても、","xmin":582.0,"ymin":602.0,"xmax":639.0,"ymax":967.0},{"id":97,"contenttext":"吾々がこの傳統の精神を翳して進んで行きましたならば、","xmin":591.0,"ymin":976.0,"xmax":653.0,"ymax":1859.0},{"id":98,"contenttext":"世界が東になつて我國を攻め","xmin":605.0,"ymin":1869.0,"xmax":661.0,"ymax":2322.0},{"id":99,"contenttext":"豐","xmin":550.0,"ymin":2224.0,"xmax":583.0,"ymax":2263.0},{"id":100,"contenttext":"皇國傳統の精神","xmin":527.0,"ymin":784.0,"xmax":564.0,"ymax":998.0}]