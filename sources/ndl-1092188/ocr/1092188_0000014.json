[{"id":0,"contenttext":"三","xmin":2931.0,"ymin":2189.0,"xmax":2963.0,"ymax":2228.0},{"id":1,"contenttext":"皇國傳統の精神","xmin":2928.0,"ymin":749.0,"xmax":2965.0,"ymax":962.0},{"id":2,"contenttext":"來たので、","xmin":2855.0,"ymin":568.0,"xmax":2901.0,"ymax":727.0},{"id":3,"contenttext":"これは何でも人間が住んで居るといふことを御考へになつて、","xmin":2855.0,"ymin":741.0,"xmax":2905.0,"ymax":1685.0},{"id":4,"contenttext":"益々上流にお出でになると、","xmin":2857.0,"ymin":1696.0,"xmax":2903.0,"ymax":2133.0},{"id":5,"contenttext":"人の泣き","xmin":2857.0,"ymin":2143.0,"xmax":2901.0,"ymax":2286.0},{"id":6,"contenttext":"聲が聞える。","xmin":2787.0,"ymin":568.0,"xmax":2831.0,"ymax":763.0},{"id":7,"contenttext":"そこでその泣き聲をたどつてお出でになると、","xmin":2787.0,"ymin":774.0,"xmax":2832.0,"ymax":1480.0},{"id":8,"contenttext":"そこに歲とつた夫婦が娘を中に置いて頭を撫で手を","xmin":2786.0,"ymin":1493.0,"xmax":2835.0,"ymax":2290.0},{"id":9,"contenttext":"撫でゝ泣いて居る。","xmin":2720.0,"ymin":568.0,"xmax":2762.0,"ymax":860.0},{"id":10,"contenttext":"須佐之男命が","xmin":2716.0,"ymin":874.0,"xmax":2766.0,"ymax":1092.0},{"id":11,"contenttext":"「どうしてお前達はそんなに泣いて居るのか」","xmin":2720.0,"ymin":1095.0,"xmax":2762.0,"ymax":1794.0},{"id":12,"contenttext":"と聞かれました。","xmin":2720.0,"ymin":1800.0,"xmax":2762.0,"ymax":2062.0},{"id":13,"contenttext":"ところがその","xmin":2720.0,"ymin":2074.0,"xmax":2762.0,"ymax":2284.0},{"id":14,"contenttext":"老夫婦卽ち足名椎、","xmin":2651.0,"ymin":568.0,"xmax":2697.0,"ymax":864.0},{"id":15,"contenttext":"ス","xmin":2684.0,"ymin":805.0,"xmax":2711.0,"ymax":850.0},{"id":16,"contenttext":"手名椎といふのが申しますのに、","xmin":2651.0,"ymin":876.0,"xmax":2695.0,"ymax":1377.0},{"id":17,"contenttext":"な","xmin":2684.0,"ymin":908.0,"xmax":2711.0,"ymax":937.0},{"id":18,"contenttext":"","xmin":2683.0,"ymin":943.0,"xmax":2711.0,"ymax":985.0},{"id":19,"contenttext":"實は私に女の子が八人ありましたが、","xmin":2651.0,"ymin":1387.0,"xmax":2697.0,"ymax":1960.0},{"id":20,"contenttext":"年々八俣大蛇が來て","xmin":2651.0,"ymin":1970.0,"xmax":2697.0,"ymax":2286.0},{"id":21,"contenttext":"その子供を一人づゝ取つて行きまして、","xmin":2584.0,"ymin":568.0,"xmax":2626.0,"ymax":1170.0},{"id":22,"contenttext":"愈々最後のこの娘を近い中に又來て取つて行かれることになります。","xmin":2581.0,"ymin":1183.0,"xmax":2628.0,"ymax":2235.0},{"id":23,"contenttext":"私","xmin":2584.0,"ymin":2244.0,"xmax":2626.0,"ymax":2288.0},{"id":24,"contenttext":"共はそれを非常に悲しんで泣いて居ります」","xmin":2513.0,"ymin":566.0,"xmax":2558.0,"ymax":1248.0},{"id":25,"contenttext":"かう申しました。","xmin":2513.0,"ymin":1251.0,"xmax":2557.0,"ymax":1512.0},{"id":26,"contenttext":"「さうか、","xmin":2515.0,"ymin":1542.0,"xmax":2555.0,"ymax":1683.0},{"id":27,"contenttext":"それは氣の毒なことであるな、","xmin":2513.0,"ymin":1697.0,"xmax":2556.0,"ymax":2164.0},{"id":28,"contenttext":"就ては","xmin":2513.0,"ymin":2177.0,"xmax":2557.0,"ymax":2286.0},{"id":29,"contenttext":"その娘を私の妃に呉れないか」","xmin":2443.0,"ymin":569.0,"xmax":2490.0,"ymax":1045.0},{"id":30,"contenttext":"と仰せられた。","xmin":2443.0,"ymin":1043.0,"xmax":2488.0,"ymax":1276.0},{"id":31,"contenttext":"足名椎、","xmin":2445.0,"ymin":1287.0,"xmax":2489.0,"ymax":1414.0},{"id":32,"contenttext":"手名椎は「場合に依つては上げても宜しうございますが","xmin":2445.0,"ymin":1422.0,"xmax":2490.0,"ymax":2286.0},{"id":33,"contenttext":"あなた樣がどういふ御方であるかといふことを伺ひませんでは御返事が申上げられません···」","xmin":2374.0,"ymin":571.0,"xmax":2418.0,"ymax":1996.0},{"id":34,"contenttext":"「成程、","xmin":2374.0,"ymin":2019.0,"xmax":2418.0,"ymax":2133.0},{"id":35,"contenttext":"それはさ","xmin":2374.0,"ymin":2143.0,"xmax":2416.0,"ymax":2284.0},{"id":36,"contenttext":"うだ、","xmin":2309.0,"ymin":568.0,"xmax":2353.0,"ymax":659.0},{"id":37,"contenttext":"わしは天照大御神のいろせである」","xmin":2305.0,"ymin":669.0,"xmax":2353.0,"ymax":1212.0},{"id":38,"contenttext":"と仰せられた。","xmin":2305.0,"ymin":1218.0,"xmax":2351.0,"ymax":1447.0},{"id":39,"contenttext":"いろせのいろといふことは、","xmin":2305.0,"ymin":1463.0,"xmax":2355.0,"ymax":1893.0},{"id":40,"contenttext":"例へばいろととも申しま","xmin":2305.0,"ymin":1898.0,"xmax":2351.0,"ymax":2286.0},{"id":41,"contenttext":"して、","xmin":2240.0,"ymin":568.0,"xmax":2282.0,"ymax":661.0},{"id":42,"contenttext":"せといふのは兄、","xmin":2234.0,"ymin":669.0,"xmax":2284.0,"ymax":933.0},{"id":43,"contenttext":"とといふのは弟、","xmin":2235.0,"ymin":945.0,"xmax":2281.0,"ymax":1207.0},{"id":44,"contenttext":"いろといふのを付けますと同母兄弟といふことになる。","xmin":2237.0,"ymin":1220.0,"xmax":2282.0,"ymax":2064.0},{"id":45,"contenttext":"總て血の續い","xmin":2237.0,"ymin":2073.0,"xmax":2282.0,"ymax":2282.0},{"id":46,"contenttext":"た者にはいろといふ字を付ける。","xmin":2168.0,"ymin":569.0,"xmax":2217.0,"ymax":1068.0},{"id":47,"contenttext":"昔は總ての男子からは總ての女子をいも","xmin":2168.0,"ymin":1080.0,"xmax":2214.0,"ymax":1706.0},{"id":48,"contenttext":"(株)","xmin":2170.0,"ymin":1711.0,"xmax":2212.0,"ymax":1794.0},{"id":49,"contenttext":"と云ひ、","xmin":2170.0,"ymin":1800.0,"xmax":2214.0,"ymax":1927.0},{"id":50,"contenttext":"又總ての女子からは總","xmin":2170.0,"ymin":1937.0,"xmax":2214.0,"ymax":2286.0},{"id":51,"contenttext":"須佐之男命は天照大御神の","xmin":2097.0,"ymin":1865.0,"xmax":2162.0,"ymax":2284.0},{"id":52,"contenttext":"ての男子をせ(兄)と云つたのであります。それで兄弟の、弟でも矢張りせと申します。","xmin":2095.0,"ymin":569.0,"xmax":2151.0,"ymax":1858.0},{"id":53,"contenttext":"C","xmin":2064.0,"ymin":1833.0,"xmax":2092.0,"ymax":1893.0},{"id":54,"contenttext":"て","xmin":2067.0,"ymin":1970.0,"xmax":2090.0,"ymax":2000.0},{"id":55,"contenttext":"手名椎は大いに驚き","xmin":2024.0,"ymin":1971.0,"xmax":2094.0,"ymax":2289.0},{"id":56,"contenttext":"な","xmin":2064.0,"ymin":1999.0,"xmax":2092.0,"ymax":2032.0},{"id":57,"contenttext":"御弟であらせられるので、","xmin":2031.0,"ymin":566.0,"xmax":2079.0,"ymax":963.0},{"id":58,"contenttext":"同母兄弟であるから、","xmin":2032.0,"ymin":976.0,"xmax":2076.0,"ymax":1308.0},{"id":59,"contenttext":"同母兄と仰せられた。","xmin":2032.0,"ymin":1320.0,"xmax":2079.0,"ymax":1651.0},{"id":60,"contenttext":"さうすると足名椎、","xmin":2032.0,"ymin":1664.0,"xmax":2074.0,"ymax":1956.0},{"id":61,"contenttext":"ました。","xmin":1969.0,"ymin":568.0,"xmax":2011.0,"ymax":692.0},{"id":62,"contenttext":"「さういふ尊い御方であらせられましたか、","xmin":1964.0,"ymin":717.0,"xmax":2009.0,"ymax":1373.0},{"id":63,"contenttext":"實に失禮申上げました、","xmin":1964.0,"ymin":1385.0,"xmax":2007.0,"ymax":1752.0},{"id":64,"contenttext":"私の娘は直ちに差上げます」","xmin":1964.0,"ymin":1764.0,"xmax":2009.0,"ymax":2212.0},{"id":65,"contenttext":"かう","xmin":1964.0,"ymin":2210.0,"xmax":2004.0,"ymax":2284.0},{"id":66,"contenttext":"言つたといふ。","xmin":1897.0,"ymin":566.0,"xmax":1943.0,"ymax":795.0},{"id":67,"contenttext":"さういふ具合で、","xmin":1896.0,"ymin":807.0,"xmax":1942.0,"ymax":1066.0},{"id":68,"contenttext":"出雲の極く山の中に住んで居る足名椎、","xmin":1896.0,"ymin":1079.0,"xmax":1942.0,"ymax":1687.0},{"id":69,"contenttext":"手名椎でも、","xmin":1896.0,"ymin":1697.0,"xmax":1941.0,"ymax":1888.0},{"id":70,"contenttext":"天照大御神と同母兄だと","xmin":1895.0,"ymin":1902.0,"xmax":1940.0,"ymax":2286.0},{"id":71,"contenttext":"仰しやると直ぐやんごとなき御方であると云ふことが分る。","xmin":1827.0,"ymin":564.0,"xmax":1873.0,"ymax":1481.0},{"id":72,"contenttext":"新聞もなければ雜誌もない時代に、","xmin":1827.0,"ymin":1486.0,"xmax":1872.0,"ymax":2027.0},{"id":73,"contenttext":"天照大御神の神","xmin":1826.0,"ymin":2039.0,"xmax":1872.0,"ymax":2288.0},{"id":74,"contenttext":"聖でゐらせられることは、","xmin":1612.0,"ymin":562.0,"xmax":1661.0,"ymax":963.0},{"id":75,"contenttext":"かくも津々浦々に響いて居つたのであります。","xmin":1608.0,"ymin":974.0,"xmax":1658.0,"ymax":1682.0},{"id":76,"contenttext":"それが卽ち皇室の尊嚴の一つの證據な","xmin":1604.0,"ymin":1693.0,"xmax":1655.0,"ymax":2283.0},{"id":77,"contenttext":"のであります。","xmin":1553.0,"ymin":569.0,"xmax":1593.0,"ymax":790.0},{"id":78,"contenttext":"それから曩に申しましたやうに、","xmin":1478.0,"ymin":597.0,"xmax":1525.0,"ymax":1098.0},{"id":79,"contenttext":"天孫降臨の時に發田毘古神が天の八衞に御迎へせられたといふのですが、","xmin":1467.0,"ymin":1110.0,"xmax":1524.0,"ymax":2232.0},{"id":80,"contenttext":"今","xmin":1472.0,"ymin":2240.0,"xmax":1512.0,"ymax":2282.0},{"id":81,"contenttext":"日なら天孫が降臨遊ばすといふことが、","xmin":1409.0,"ymin":566.0,"xmax":1458.0,"ymax":1167.0},{"id":82,"contenttext":"新聞や雜誌に出るのですけれども、","xmin":1404.0,"ymin":1177.0,"xmax":1454.0,"ymax":1714.0},{"id":83,"contenttext":"その時代にはさういふものは一切な","xmin":1399.0,"ymin":1729.0,"xmax":1448.0,"ymax":2281.0},{"id":84,"contenttext":"い。","xmin":1348.0,"ymin":568.0,"xmax":1385.0,"ymax":615.0},{"id":85,"contenttext":"然るに天孫が降臨遊ばすといふので、","xmin":1339.0,"ymin":629.0,"xmax":1390.0,"ymax":1201.0},{"id":86,"contenttext":"發田毘古神は伊勢に居られたのでありますが、","xmin":1331.0,"ymin":1210.0,"xmax":1384.0,"ymax":1920.0},{"id":87,"contenttext":"伊勢からずつと御迎へ","xmin":1332.0,"ymin":1932.0,"xmax":1378.0,"ymax":2277.0},{"id":88,"contenttext":"に出て、","xmin":1278.0,"ymin":566.0,"xmax":1318.0,"ymax":686.0},{"id":89,"contenttext":"九州に御案内せられたといふ。","xmin":1270.0,"ymin":701.0,"xmax":1322.0,"ymax":1166.0},{"id":90,"contenttext":"かゝる事實は、","xmin":1271.0,"ymin":1181.0,"xmax":1313.0,"ymax":1406.0},{"id":91,"contenttext":"又、","xmin":1269.0,"ymin":1417.0,"xmax":1313.0,"ymax":1473.0},{"id":92,"contenttext":"皇室の尊嚴といふことが、","xmin":1265.0,"ymin":1486.0,"xmax":1313.0,"ymax":1886.0},{"id":93,"contenttext":"全國に徹底して居ること","xmin":1265.0,"ymin":1898.0,"xmax":1308.0,"ymax":2281.0},{"id":94,"contenttext":"を示すのであります。","xmin":1202.0,"ymin":562.0,"xmax":1253.0,"ymax":892.0},{"id":95,"contenttext":"尙又海幸、","xmin":1206.0,"ymin":904.0,"xmax":1250.0,"ymax":1063.0},{"id":96,"contenttext":"山幸と申す傳があります。","xmin":1200.0,"ymin":1077.0,"xmax":1247.0,"ymax":1474.0},{"id":97,"contenttext":"これは水產業で生活の根柢を得るのを海の幸と申し","xmin":1191.0,"ymin":1489.0,"xmax":1245.0,"ymax":2281.0},{"id":98,"contenttext":"ます。","xmin":1144.0,"ymin":557.0,"xmax":1183.0,"ymax":652.0},{"id":99,"contenttext":"それから山の幸といふのは狩獵で生活の根柢を得るのを言ふのであります。","xmin":1128.0,"ymin":664.0,"xmax":1185.0,"ymax":1817.0},{"id":100,"contenttext":"ところがその火遠理命は天孫","xmin":1122.0,"ymin":1829.0,"xmax":1175.0,"ymax":2283.0},{"id":101,"contenttext":"ㄷ","xmin":1107.0,"ymin":560.0,"xmax":1129.0,"ymax":589.0},{"id":102,"contenttext":"通々藝命の御末の御子であります。","xmin":1060.0,"ymin":561.0,"xmax":1132.0,"ymax":1095.0},{"id":103,"contenttext":"仁","xmin":1103.0,"ymin":592.0,"xmax":1132.0,"ymax":624.0},{"id":104,"contenttext":"運々藝命の跡を御嗣ぎになる御方であります。","xmin":1060.0,"ymin":1108.0,"xmax":1109.0,"ymax":1816.0},{"id":105,"contenttext":"昔は末子相續と申しまして、","xmin":1054.0,"ymin":1826.0,"xmax":1103.0,"ymax":2260.0},{"id":106,"contenttext":"必ずしも長子が相續しない。","xmin":999.0,"ymin":560.0,"xmax":1049.0,"ymax":994.0},{"id":107,"contenttext":"今日では長子相續といふことに決つて居りますけれども、","xmin":989.0,"ymin":1004.0,"xmax":1043.0,"ymax":1883.0},{"id":108,"contenttext":"昔は末子で相續する場合","xmin":987.0,"ymin":1894.0,"xmax":1036.0,"ymax":2281.0},{"id":109,"contenttext":"ま","xmin":953.0,"ymin":2187.0,"xmax":977.0,"ymax":2231.0},{"id":110,"contenttext":"B","xmin":953.0,"ymin":2238.0,"xmax":974.0,"ymax":2279.0},{"id":111,"contenttext":"が多いのであります。","xmin":930.0,"ymin":562.0,"xmax":979.0,"ymax":892.0},{"id":112,"contenttext":"その火遠理命といふのは、","xmin":926.0,"ymin":902.0,"xmax":974.0,"ymax":1303.0},{"id":113,"contenttext":"末子であらせられて、","xmin":923.0,"ymin":1313.0,"xmax":972.0,"ymax":1645.0},{"id":114,"contenttext":"皇太子に御なりになつたが或時、","xmin":918.0,"ymin":1655.0,"xmax":968.0,"ymax":2159.0},{"id":115,"contenttext":"海佐知","xmin":918.0,"ymin":2168.0,"xmax":962.0,"ymax":2281.0},{"id":116,"contenttext":"昆古にあらせられるその兄御子大照命と、","xmin":857.0,"ymin":560.0,"xmax":907.0,"ymax":1197.0},{"id":117,"contenttext":"火達理命の山の幸とを一つ取代へて見ようではないかといふ議が御","xmin":848.0,"ymin":1209.0,"xmax":901.0,"ymax":2279.0},{"id":118,"contenttext":"っぱり","xmin":819.0,"ymin":1075.0,"xmax":850.0,"ymax":1148.0},{"id":119,"contenttext":"弟の間で起つた。","xmin":797.0,"ymin":559.0,"xmax":842.0,"ymax":823.0},{"id":120,"contenttext":"そこで海の幸は鉤","xmin":795.0,"ymin":834.0,"xmax":836.0,"ymax":1116.0},{"id":121,"contenttext":"山の幸は弓をお取代へになつた。","xmin":785.0,"ymin":1142.0,"xmax":838.0,"ymax":1646.0},{"id":122,"contenttext":"ところがその火遠理命は海の幸でやらう","xmin":781.0,"ymin":1656.0,"xmax":829.0,"ymax":2275.0},{"id":123,"contenttext":"と思召して、","xmin":729.0,"ymin":560.0,"xmax":773.0,"ymax":751.0},{"id":124,"contenttext":"兄御子の鉤を御借りになつてやつて御覽になつたのですけれども、","xmin":716.0,"ymin":764.0,"xmax":774.0,"ymax":1779.0},{"id":125,"contenttext":"どうも餘り御償れにならぬので","xmin":713.0,"ymin":1790.0,"xmax":762.0,"ymax":2276.0},{"id":126,"contenttext":"その鉤を魚に御取られになつて終つた。","xmin":653.0,"ymin":560.0,"xmax":706.0,"ymax":1165.0},{"id":127,"contenttext":"兄御子の方も山の幸に餘り慣れて居らぬから一向狩りが出來ませぬ。","xmin":642.0,"ymin":1175.0,"xmax":699.0,"ymax":2228.0},{"id":128,"contenttext":"そ","xmin":649.0,"ymin":2237.0,"xmax":684.0,"ymax":2277.0},{"id":129,"contenttext":"こで今度はお互に元の通りにやらうといふことになつて、","xmin":583.0,"ymin":562.0,"xmax":637.0,"ymax":1438.0},{"id":130,"contenttext":"兄御子が弓矢を御返しになつた。","xmin":578.0,"ymin":1450.0,"xmax":629.0,"ymax":1955.0},{"id":131,"contenttext":"さうすると火遠理命","xmin":576.0,"ymin":1965.0,"xmax":621.0,"ymax":2277.0},{"id":132,"contenttext":"皇國傳統の精神","xmin":522.0,"ymin":738.0,"xmax":560.0,"ymax":954.0},{"id":133,"contenttext":"三","xmin":515.0,"ymin":2180.0,"xmax":546.0,"ymax":2219.0},{"id":134,"contenttext":"かくも津々浦々に響いて居つたのであります。","xmin":1608.0,"ymin":974.0,"xmax":1658.0,"ymax":1682.0},{"id":135,"contenttext":"それが卽ち皇室の尊嚴の一つの證據な","xmin":1604.0,"ymin":1693.0,"xmax":1655.0,"ymax":2283.0}]