[{"id":0,"contenttext":"皇國傳統の精神","xmin":2938.0,"ymin":749.0,"xmax":2977.0,"ymax":961.0},{"id":1,"contenttext":"元","xmin":2938.0,"ymin":2191.0,"xmax":2975.0,"ymax":2228.0},{"id":2,"contenttext":"ものを奏上する。","xmin":2869.0,"ymin":571.0,"xmax":2915.0,"ymax":832.0},{"id":3,"contenttext":"今日もお宮でお祭りのある時には、","xmin":2867.0,"ymin":842.0,"xmax":2916.0,"ymax":1379.0},{"id":4,"contenttext":"之れを申上げますが、","xmin":2868.0,"ymin":1391.0,"xmax":2913.0,"ymax":1725.0},{"id":5,"contenttext":"その祝詞の言葉には、","xmin":2864.0,"ymin":1729.0,"xmax":2915.0,"ymax":2066.0},{"id":6,"contenttext":"何時でも天孫","xmin":2868.0,"ymin":2074.0,"xmax":2912.0,"ymax":2288.0},{"id":7,"contenttext":"が高天ケ原から天の警座を放ち、","xmin":2801.0,"ymin":569.0,"xmax":2861.0,"ymax":1072.0},{"id":8,"contenttext":"§","xmin":2836.0,"ymin":911.0,"xmax":2859.0,"ymax":952.0},{"id":9,"contenttext":"天の八重雲をいつのち別きにち別きて天降し依さしまつりき」","xmin":2797.0,"ymin":1082.0,"xmax":2846.0,"ymax":2038.0},{"id":10,"contenttext":"と云ふやうに傳","xmin":2799.0,"ymin":2041.0,"xmax":2844.0,"ymax":2288.0},{"id":11,"contenttext":"こゝに常盤に堅盤にすめら大御國を御建てになつたといふ風な事實の說明が","xmin":2723.0,"ymin":1119.0,"xmax":2796.0,"ymax":2288.0},{"id":12,"contenttext":",","xmin":2769.0,"ymin":1340.0,"xmax":2788.0,"ymax":1361.0},{"id":13,"contenttext":"へて天孫がこの國に御降りになり、","xmin":2734.0,"ymin":578.0,"xmax":2776.0,"ymax":1103.0},{"id":14,"contenttext":"あるのであります。","xmin":2662.0,"ymin":567.0,"xmax":2711.0,"ymax":864.0},{"id":15,"contenttext":"さういふ祝詞をお祭りの度每、","xmin":2663.0,"ymin":876.0,"xmax":2707.0,"ymax":1345.0},{"id":16,"contenttext":"多くの人が集つて居る度每に讀上げられる。","xmin":2659.0,"ymin":1353.0,"xmax":2709.0,"ymax":2029.0},{"id":17,"contenttext":"それであります","xmin":2661.0,"ymin":2041.0,"xmax":2705.0,"ymax":2286.0},{"id":18,"contenttext":"からして皇室の尊嚴であるといふことがもう事實によつて〓育されて來るのであります。","xmin":2592.0,"ymin":567.0,"xmax":2639.0,"ymax":1925.0},{"id":19,"contenttext":"かう云ふ風で、","xmin":2593.0,"ymin":1939.0,"xmax":2637.0,"ymax":2166.0},{"id":20,"contenttext":"我國で","xmin":2594.0,"ymin":2177.0,"xmax":2637.0,"ymax":2284.0},{"id":21,"contenttext":"はすべて事實を尊重しまするので、","xmin":2524.0,"ymin":567.0,"xmax":2574.0,"ymax":1104.0},{"id":22,"contenttext":"先例舊規と云ふことがいつでも大切となつて居ります。","xmin":2526.0,"ymin":1116.0,"xmax":2570.0,"ymax":1956.0},{"id":23,"contenttext":"第五、","xmin":2457.0,"ymin":597.0,"xmax":2503.0,"ymax":693.0},{"id":24,"contenttext":"皇室中心","xmin":2459.0,"ymin":703.0,"xmax":2505.0,"ymax":848.0},{"id":25,"contenttext":"道德上如何なる事が善で、","xmin":2390.0,"ymin":599.0,"xmax":2435.0,"ymax":1001.0},{"id":26,"contenttext":"如何なる事が惡か、","xmin":2390.0,"ymin":1012.0,"xmax":2434.0,"ymax":1308.0},{"id":27,"contenttext":"卽ち善惡の標準は何れにあるかと云ふことは、","xmin":2388.0,"ymin":1318.0,"xmax":2433.0,"ymax":2029.0},{"id":28,"contenttext":"大問題でありま","xmin":2386.0,"ymin":2039.0,"xmax":2429.0,"ymax":2284.0},{"id":29,"contenttext":"す。","xmin":2326.0,"ymin":568.0,"xmax":2367.0,"ymax":624.0},{"id":30,"contenttext":"卽ち世の中の善惡といふものを何に依つて定めますか、","xmin":2319.0,"ymin":633.0,"xmax":2368.0,"ymax":1480.0},{"id":31,"contenttext":"どういふことが一體善い行であるか、","xmin":2318.0,"ymin":1491.0,"xmax":2367.0,"ymax":2061.0},{"id":32,"contenttext":"どういふこと","xmin":2319.0,"ymin":2073.0,"xmax":2358.0,"ymax":2284.0},{"id":33,"contenttext":"が惡い行ひであるかといふことは、","xmin":2252.0,"ymin":569.0,"xmax":2298.0,"ymax":1105.0},{"id":34,"contenttext":"何を標準にして言ひますか。","xmin":2250.0,"ymin":1114.0,"xmax":2299.0,"ymax":1548.0},{"id":35,"contenttext":"西洋などに於きましては倫理學といふものを〓","xmin":2248.0,"ymin":1560.0,"xmax":2295.0,"ymax":2284.0},{"id":36,"contenttext":"究致しまして、","xmin":2185.0,"ymin":566.0,"xmax":2231.0,"ymax":794.0},{"id":37,"contenttext":"人生の理想といふものを立てゝ、","xmin":2184.0,"ymin":805.0,"xmax":2228.0,"ymax":1304.0},{"id":38,"contenttext":"その理想に叶ふのが善であつて、理想に叶はないのが惡である。","xmin":2179.0,"ymin":1318.0,"xmax":2231.0,"ymax":2283.0},{"id":39,"contenttext":"或は良心といふものを立て、良心の是認するものが善であつて、良心の否認するものが惡である、","xmin":2111.0,"ymin":566.0,"xmax":2161.0,"ymax":2024.0},{"id":40,"contenttext":"といふ具合に言","xmin":2108.0,"ymin":2039.0,"xmax":2160.0,"ymax":2285.0},{"id":41,"contenttext":"ho","xmin":2048.0,"ymin":568.0,"xmax":2090.0,"ymax":624.0},{"id":42,"contenttext":"ヘルバルトなどは直覺的判斷といふものを立てゝ、","xmin":2042.0,"ymin":641.0,"xmax":2091.0,"ymax":1408.0},{"id":43,"contenttext":"直覺的判斷の是認するものが善であつて、","xmin":2040.0,"ymin":1419.0,"xmax":2090.0,"ymax":2061.0},{"id":44,"contenttext":"それが是認し","xmin":2041.0,"ymin":2073.0,"xmax":2087.0,"ymax":2282.0},{"id":45,"contenttext":"ないものが惡であるといふことを言ひました。","xmin":1975.0,"ymin":567.0,"xmax":2021.0,"ymax":1273.0},{"id":46,"contenttext":"かう云ふ風に善惡の標準といふことはいろ〓〓に立てられて居り","xmin":1971.0,"ymin":1287.0,"xmax":2019.0,"ymax":2283.0},{"id":47,"contenttext":"ます。","xmin":1911.0,"ymin":566.0,"xmax":1950.0,"ymax":656.0},{"id":48,"contenttext":"併し我國に於ては善惡の標準はどこにあるか、","xmin":1907.0,"ymin":668.0,"xmax":1951.0,"ymax":1373.0},{"id":49,"contenttext":"どういふ行ひが善でどういふ行ひが惡であるか、","xmin":1905.0,"ymin":1385.0,"xmax":1949.0,"ymax":2127.0},{"id":50,"contenttext":"かう言ひ","xmin":1905.0,"ymin":2141.0,"xmax":1946.0,"ymax":2281.0},{"id":51,"contenttext":"ますとそれは直ぐ分ります。","xmin":1842.0,"ymin":566.0,"xmax":1884.0,"ymax":998.0},{"id":52,"contenttext":"我國に於きましては前に申しました皇室の尊嚴、","xmin":1840.0,"ymin":1012.0,"xmax":1882.0,"ymax":1750.0},{"id":53,"contenttext":"皇室中心といふことに依つて確立","xmin":1838.0,"ymin":1764.0,"xmax":1881.0,"ymax":2282.0},{"id":54,"contenttext":"せられて居ります。","xmin":1573.0,"ymin":554.0,"xmax":1626.0,"ymax":852.0},{"id":55,"contenttext":"卽ち之れに因つて、","xmin":1576.0,"ymin":860.0,"xmax":1626.0,"ymax":1160.0},{"id":56,"contenttext":"我國の道德は立てられて居るのでありますから、","xmin":1579.0,"ymin":1170.0,"xmax":1625.0,"ymax":1915.0},{"id":57,"contenttext":"この皇室中心の思想、","xmin":1581.0,"ymin":1930.0,"xmax":1627.0,"ymax":2256.0},{"id":58,"contenttext":"をのふこと","xmin":1544.0,"ymin":1962.0,"xmax":1572.0,"ymax":2060.0},{"id":59,"contenttext":"これに反するものは惡である。","xmin":1508.0,"ymin":555.0,"xmax":1554.0,"ymax":1021.0},{"id":60,"contenttext":"それに合致するものは善である。","xmin":1510.0,"ymin":1033.0,"xmax":1556.0,"ymax":1539.0},{"id":61,"contenttext":"昔に於きましても、","xmin":1512.0,"ymin":1547.0,"xmax":1555.0,"ymax":1845.0},{"id":62,"contenttext":"須佐之男命といふ神樣は天","xmin":1514.0,"ymin":1856.0,"xmax":1560.0,"ymax":2275.0},{"id":63,"contenttext":"照大御神樣の御弟であらせられるのでありますけれども、","xmin":1441.0,"ymin":553.0,"xmax":1488.0,"ymax":1429.0},{"id":64,"contenttext":"高天ケ原に於て罪惡を犯せられますと、","xmin":1447.0,"ymin":1443.0,"xmax":1489.0,"ymax":2050.0},{"id":65,"contenttext":"さういふ尊い","xmin":1449.0,"ymin":2066.0,"xmax":1489.0,"ymax":2270.0},{"id":66,"contenttext":"PEE","xmin":1410.0,"ymin":2131.0,"xmax":1438.0,"ymax":2191.0},{"id":67,"contenttext":"御方でも皇室に對して、","xmin":1375.0,"ymin":552.0,"xmax":1421.0,"ymax":916.0},{"id":68,"contenttext":"天照大御神様に對して失禮なことがありますと、","xmin":1377.0,"ymin":928.0,"xmax":1422.0,"ymax":1673.0},{"id":69,"contenttext":"大勢の神が須佐之男命に千位置戶と申","xmin":1376.0,"ymin":1683.0,"xmax":1426.0,"ymax":2277.0},{"id":70,"contenttext":"しまして、","xmin":1306.0,"ymin":553.0,"xmax":1347.0,"ymax":710.0},{"id":71,"contenttext":"今日で申しますと澤山の罸金であります。","xmin":1306.0,"ymin":723.0,"xmax":1352.0,"ymax":1364.0},{"id":72,"contenttext":"それから髪を拔き手足の爪を拔いたとありますが、","xmin":1306.0,"ymin":1375.0,"xmax":1357.0,"ymax":2154.0},{"id":73,"contenttext":"實際髪","xmin":1310.0,"ymin":2163.0,"xmax":1354.0,"ymax":2275.0},{"id":74,"contenttext":"須佐之男命の口毛などが木になつた","xmin":1227.0,"ymin":1715.0,"xmax":1300.0,"ymax":2276.0},{"id":75,"contenttext":"をのみこと","xmin":1271.0,"ymin":1819.0,"xmax":1299.0,"ymax":1914.0},{"id":76,"contenttext":"を御拔きになつたのか爪を御拔きになつたのか傳說ですから分りませぬが、","xmin":1236.0,"ymin":553.0,"xmax":1285.0,"ymax":1708.0},{"id":77,"contenttext":"といふことが書いてありますから、","xmin":1166.0,"ymin":555.0,"xmax":1213.0,"ymax":1091.0},{"id":78,"contenttext":"或は須彼之男命の山林などの桶末をみな淺收されたのかも知れませ","xmin":1170.0,"ymin":1103.0,"xmax":1216.0,"ymax":2191.0},{"id":79,"contenttext":"兎に","xmin":1172.0,"ymin":2200.0,"xmax":1216.0,"ymax":2274.0},{"id":80,"contenttext":"角さういふ具合にしてその罪を曠はしめるといふことがあります。","xmin":1099.0,"ymin":553.0,"xmax":1146.0,"ymax":1570.0},{"id":81,"contenttext":"それから又天若日子といふのが高天ケ原から","xmin":1103.0,"ymin":1584.0,"xmax":1146.0,"ymax":2272.0},{"id":82,"contenttext":"おほくにぬしのみこさ","xmin":1064.0,"ymin":551.0,"xmax":1094.0,"ymax":730.0},{"id":83,"contenttext":"大国主命に對してこの國を天孫に獻げよといふ使ひに降りました。","xmin":1032.0,"ymin":553.0,"xmax":1079.0,"ymax":1572.0},{"id":84,"contenttext":"ところが天若日子は大國主命のお姫さんを奧","xmin":1036.0,"ymin":1584.0,"xmax":1079.0,"ymax":2274.0},{"id":85,"contenttext":"さんに貰つて大國主命の養子になり、","xmin":964.0,"ymin":555.0,"xmax":1010.0,"ymax":1124.0},{"id":86,"contenttext":"さうして自分が葦原中つ國を支配しようと考へたが、","xmin":966.0,"ymin":1139.0,"xmax":1012.0,"ymax":1948.0},{"id":87,"contenttext":"さういふことが高天","xmin":968.0,"ymin":1960.0,"xmax":1010.0,"ymax":2274.0},{"id":88,"contenttext":"原に聞えますと、","xmin":894.0,"ymin":552.0,"xmax":937.0,"ymax":813.0},{"id":89,"contenttext":"直ちに高天原からの神兵に誅せられて終ひました。","xmin":897.0,"ymin":827.0,"xmax":940.0,"ymax":1606.0},{"id":90,"contenttext":"所謂朝敵といふものが如何に恐るべきもの","xmin":899.0,"ymin":1614.0,"xmax":940.0,"ymax":2270.0},{"id":91,"contenttext":"であるかといふことが既に上代に於てかゝる事實で示されて居ります。","xmin":828.0,"ymin":555.0,"xmax":876.0,"ymax":1637.0},{"id":92,"contenttext":"或は又已に述べました發田毘古神といふ","xmin":830.0,"ymin":1651.0,"xmax":876.0,"ymax":2272.0},{"id":93,"contenttext":"のが天孫を御導きして九州にお出でになつて、","xmin":761.0,"ymin":557.0,"xmax":804.0,"ymax":1262.0},{"id":94,"contenttext":"今度は御自分の伊勢に御歸りになる時に、","xmin":760.0,"ymin":1274.0,"xmax":808.0,"ymax":1912.0},{"id":95,"contenttext":"天宇受賣命といふのが","xmin":763.0,"ymin":1925.0,"xmax":804.0,"ymax":2272.0},{"id":96,"contenttext":"あめのうずののみこと","xmin":727.0,"ymin":1172.0,"xmax":756.0,"ymax":1350.0},{"id":97,"contenttext":"お供をして伊勢の方にお出でになつた。","xmin":694.0,"ymin":555.0,"xmax":740.0,"ymax":1160.0},{"id":98,"contenttext":"天宇受賣命は御用が濟んで、","xmin":696.0,"ymin":1169.0,"xmax":737.0,"ymax":1606.0},{"id":99,"contenttext":"志摩の方にお出でになつた。","xmin":693.0,"ymin":1614.0,"xmax":742.0,"ymax":2050.0},{"id":100,"contenttext":"志摩と申しま","xmin":696.0,"ymin":2060.0,"xmax":740.0,"ymax":2271.0},{"id":101,"contenttext":"すと、","xmin":627.0,"ymin":553.0,"xmax":670.0,"ymax":645.0},{"id":102,"contenttext":"今日は志摩の國と申しますが、","xmin":625.0,"ymin":666.0,"xmax":674.0,"ymax":1133.0},{"id":103,"contenttext":"昔は伊勢の一部でありました。","xmin":626.0,"ymin":1151.0,"xmax":672.0,"ymax":1622.0},{"id":104,"contenttext":"その志摩といふところへ","xmin":626.0,"ymin":1643.0,"xmax":673.0,"ymax":2023.0},{"id":105,"contenttext":"お出でになつた","xmin":627.0,"ymin":2028.0,"xmax":673.0,"ymax":2275.0},{"id":106,"contenttext":"「汝たちは天つ神の御子に仕へ奉らんや否や」とお聞きに","xmin":542.0,"ymin":1386.0,"xmax":618.0,"ymax":2273.0},{"id":107,"contenttext":"800","xmin":590.0,"ymin":555.0,"xmax":613.0,"ymax":608.0},{"id":108,"contenttext":"&","xmin":590.0,"ymin":620.0,"xmax":615.0,"ymax":660.0},{"id":109,"contenttext":"天宇受賣命が、","xmin":554.0,"ymin":553.0,"xmax":601.0,"ymax":778.0},{"id":110,"contenttext":"澤山の魚をお集めになつて、","xmin":555.0,"ymin":791.0,"xmax":601.0,"ymax":1228.0},{"id":111,"contenttext":"その魚に","xmin":555.0,"ymin":1237.0,"xmax":599.0,"ymax":1382.0},{"id":112,"contenttext":"皇國傳統の精神","xmin":494.0,"ymin":732.0,"xmax":531.0,"ymax":945.0},{"id":113,"contenttext":"元","xmin":494.0,"ymin":2175.0,"xmax":532.0,"ymax":2215.0}]