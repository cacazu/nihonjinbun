[{"id":0,"contenttext":"皇國傳統の精神","xmin":1449.0,"ymin":740.0,"xmax":1525.0,"ymax":1357.0},{"id":1,"contenttext":"文","xmin":1313.0,"ymin":1398.0,"xmax":1353.0,"ymax":1444.0},{"id":2,"contenttext":"東洋大學講師","xmin":1347.0,"ymin":1398.0,"xmax":1389.0,"ymax":1613.0},{"id":3,"contenttext":"學","xmin":1315.0,"ymin":1454.0,"xmax":1354.0,"ymax":1502.0},{"id":4,"contenttext":"博","xmin":1315.0,"ymin":1510.0,"xmax":1355.0,"ymax":1560.0},{"id":5,"contenttext":"士","xmin":1317.0,"ymin":1572.0,"xmax":1355.0,"ymax":1613.0},{"id":6,"contenttext":"田","xmin":1329.0,"ymin":1653.0,"xmax":1375.0,"ymax":1701.0},{"id":7,"contenttext":"中","xmin":1329.0,"ymin":1787.0,"xmax":1377.0,"ymax":1842.0},{"id":8,"contenttext":"義","xmin":1325.0,"ymin":1925.0,"xmax":1382.0,"ymax":1983.0},{"id":9,"contenttext":"能","xmin":1325.0,"ymin":2062.0,"xmax":1382.0,"ymax":2119.0},{"id":10,"contenttext":"この度この講習會に私にもお伺ひして何かお話を申上げるやうにといふ御依賴に基きまして本日お伺ひ致しま","xmin":1202.0,"ymin":571.0,"xmax":1255.0,"ymax":2251.0},{"id":11,"contenttext":"題は只今御紹介下さいました通り","xmin":1135.0,"ymin":633.0,"xmax":1177.0,"ymax":1153.0},{"id":12,"contenttext":"「皇國傳統の精神」といふ題に依つて今日午前中御〓聽をお願ひしたい","xmin":1135.0,"ymin":1161.0,"xmax":1182.0,"ymax":2249.0},{"id":13,"contenttext":"した。","xmin":1135.0,"ymin":534.0,"xmax":1179.0,"ymax":622.0},{"id":14,"contenttext":"題は只今御紹介下さいました通り","xmin":1135.0,"ymin":633.0,"xmax":1177.0,"ymax":1153.0},{"id":15,"contenttext":"と考へて居る次第であります。","xmin":1066.0,"ymin":532.0,"xmax":1110.0,"ymax":998.0},{"id":16,"contenttext":"生きて居る者が皆精神を持つて居りますことは言ふ迄もないことであります。","xmin":999.0,"ymin":567.0,"xmax":1045.0,"ymax":1754.0},{"id":17,"contenttext":"殊に人間は昔から萬物の靈長と","xmin":1000.0,"ymin":1766.0,"xmax":1047.0,"ymax":2252.0},{"id":18,"contenttext":"も申しまして、","xmin":932.0,"ymin":532.0,"xmax":975.0,"ymax":755.0},{"id":19,"contenttext":"總ての生きたものゝ中で最も優れた最も高尙なものでございますので、","xmin":930.0,"ymin":770.0,"xmax":977.0,"ymax":1854.0},{"id":20,"contenttext":"その精神も亦他のものに","xmin":932.0,"ymin":1868.0,"xmax":975.0,"ymax":2247.0},{"id":21,"contenttext":"比較することの出來ない特性、","xmin":864.0,"ymin":531.0,"xmax":906.0,"ymax":998.0},{"id":22,"contenttext":"優れたところの精神を持つて居るのであります。","xmin":864.0,"ymin":1008.0,"xmax":908.0,"ymax":1747.0},{"id":23,"contenttext":"ところがその人間の精神は各々","xmin":864.0,"ymin":1764.0,"xmax":908.0,"ymax":2244.0},{"id":24,"contenttext":"人々の遺傳と申しまして、","xmin":795.0,"ymin":531.0,"xmax":837.0,"ymax":927.0},{"id":25,"contenttext":"昔から代々傳つて來た血統といふやうなものに因つていろ〓〓違つて參るのです。","xmin":795.0,"ymin":939.0,"xmax":839.0,"ymax":2196.0},{"id":26,"contenttext":"殊","xmin":795.0,"ymin":2205.0,"xmax":841.0,"ymax":2249.0},{"id":27,"contenttext":"に兩親があつて生れて來るのでありますが、","xmin":724.0,"ymin":532.0,"xmax":770.0,"ymax":1202.0},{"id":28,"contenttext":"その兩親から身體を遺傳致しますと同じやうに、","xmin":726.0,"ymin":1213.0,"xmax":770.0,"ymax":1955.0},{"id":29,"contenttext":"精神を遺傳して來","xmin":725.0,"ymin":1967.0,"xmax":774.0,"ymax":2249.0},{"id":30,"contenttext":"る。","xmin":661.0,"ymin":532.0,"xmax":696.0,"ymax":580.0},{"id":31,"contenttext":"身體から見ましても母に似た子供、","xmin":655.0,"ymin":596.0,"xmax":703.0,"ymax":1135.0},{"id":32,"contenttext":"極く微細な點迄或は母に似、","xmin":657.0,"ymin":1144.0,"xmax":701.0,"ymax":1579.0},{"id":33,"contenttext":"或は父に似る。","xmin":655.0,"ymin":1588.0,"xmax":704.0,"ymax":1817.0},{"id":34,"contenttext":"同に兄弟であつてもその似","xmin":657.0,"ymin":1829.0,"xmax":700.0,"ymax":2247.0},{"id":35,"contenttext":"方に因つて違ひが生じて來る。","xmin":589.0,"ymin":529.0,"xmax":634.0,"ymax":995.0},{"id":36,"contenttext":"背が高いのがあるし低いのがある。","xmin":587.0,"ymin":1005.0,"xmax":635.0,"ymax":1541.0},{"id":37,"contenttext":"目などが一番能く分る。","xmin":589.0,"ymin":1556.0,"xmax":631.0,"ymax":1919.0},{"id":38,"contenttext":"目は一皮目、","xmin":590.0,"ymin":1933.0,"xmax":631.0,"ymax":2126.0},{"id":39,"contenttext":"二皮目","xmin":590.0,"ymin":2138.0,"xmax":633.0,"ymax":2247.0},{"id":40,"contenttext":"と瞼に付て言ひますが、","xmin":521.0,"ymin":530.0,"xmax":566.0,"ymax":891.0},{"id":41,"contenttext":"それが兩親の一方が一皮目であり一方が二皮目であると、","xmin":522.0,"ymin":904.0,"xmax":564.0,"ymax":1782.0},{"id":42,"contenttext":"その子供は片一方の目が一皮","xmin":520.0,"ymin":1796.0,"xmax":566.0,"ymax":2247.0},{"id":43,"contenttext":"皇國傳統の精神","xmin":460.0,"ymin":709.0,"xmax":496.0,"ymax":922.0}]