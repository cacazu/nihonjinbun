[{"id":0,"contenttext":"皇國傳統の精神","xmin":2943.0,"ymin":778.0,"xmax":2989.0,"ymax":992.0},{"id":1,"contenttext":"10","xmin":2924.0,"ymin":2226.0,"xmax":2956.0,"ymax":2260.0},{"id":2,"contenttext":"を〓潔にする。","xmin":2881.0,"ymin":600.0,"xmax":2927.0,"ymax":825.0},{"id":3,"contenttext":"而して精神も〓潔にする。","xmin":2872.0,"ymin":837.0,"xmax":2921.0,"ymax":1239.0},{"id":4,"contenttext":"そこに秩序の觀念を見る事が出來ます。","xmin":2859.0,"ymin":1247.0,"xmax":2916.0,"ymax":1855.0},{"id":5,"contenttext":"この何でもキチンとするといふ觀念から、","xmin":2803.0,"ymin":636.0,"xmax":2859.0,"ymax":1271.0},{"id":6,"contenttext":"今度家に於きましても家長といふものを立て、","xmin":2787.0,"ymin":1282.0,"xmax":2846.0,"ymax":1989.0},{"id":7,"contenttext":"家の秩序をキチンと","xmin":2779.0,"ymin":1998.0,"xmax":2833.0,"ymax":2315.0},{"id":8,"contenttext":"させる。","xmin":2750.0,"ymin":599.0,"xmax":2790.0,"ymax":719.0},{"id":9,"contenttext":"西洋などの家は新たに夫婦が結婚して家を作ります。","xmin":2727.0,"ymin":732.0,"xmax":2791.0,"ymax":1543.0},{"id":10,"contenttext":"家長はありませぬ。","xmin":2722.0,"ymin":1552.0,"xmax":2772.0,"ymax":1849.0},{"id":11,"contenttext":"子供が出來て、","xmin":2721.0,"ymin":1861.0,"xmax":2765.0,"ymax":2090.0},{"id":12,"contenttext":"その子供が大","xmin":2714.0,"ymin":2102.0,"xmax":2763.0,"ymax":2315.0},{"id":13,"contenttext":"きくなりますと各々別に結婚して家を作る。","xmin":2669.0,"ymin":595.0,"xmax":2724.0,"ymax":1268.0},{"id":14,"contenttext":"自分の兩親の家を何處迄も維持して行かうといふ考がない。","xmin":2649.0,"ymin":1279.0,"xmax":2712.0,"ymax":2191.0},{"id":15,"contenttext":"これを","xmin":2649.0,"ymin":2205.0,"xmax":2690.0,"ymax":2312.0},{"id":16,"contenttext":"動物に例へては具合が惡いのですけれども、","xmin":2597.0,"ymin":591.0,"xmax":2661.0,"ymax":1266.0},{"id":17,"contenttext":"チヨツト例へて見ますと、","xmin":2592.0,"ymin":1281.0,"xmax":2642.0,"ymax":1677.0},{"id":18,"contenttext":"雀などが春先きになると屋根の裏に巢を","xmin":2577.0,"ymin":1688.0,"xmax":2637.0,"ymax":2313.0},{"id":19,"contenttext":"懸けませう、","xmin":2538.0,"ymin":589.0,"xmax":2588.0,"ymax":784.0},{"id":20,"contenttext":"が巢の中で卵を生んで子供を育てます。","xmin":2526.0,"ymin":796.0,"xmax":2586.0,"ymax":1404.0},{"id":21,"contenttext":"物を持つて來て喰はして子供を育てる。","xmin":2513.0,"ymin":1411.0,"xmax":2573.0,"ymax":2019.0},{"id":22,"contenttext":"ずつとその子供が","xmin":2509.0,"ymin":2028.0,"xmax":2559.0,"ymax":2311.0},{"id":23,"contenttext":"大きくなり、","xmin":2471.0,"ymin":588.0,"xmax":2517.0,"ymax":781.0},{"id":24,"contenttext":"唇に黃色いのが着いて居りますが、","xmin":2459.0,"ymin":792.0,"xmax":2516.0,"ymax":1333.0},{"id":25,"contenttext":"親に付いて飛んで步きます。","xmin":2449.0,"ymin":1340.0,"xmax":2505.0,"ymax":1778.0},{"id":26,"contenttext":"黃色いのが取れる頃にはどれが親","xmin":2437.0,"ymin":1786.0,"xmax":2495.0,"ymax":2310.0},{"id":27,"contenttext":"だか子だか分りませぬ。","xmin":2397.0,"ymin":588.0,"xmax":2452.0,"ymax":951.0},{"id":28,"contenttext":"西洋邊りの生活をそれに比較してはチヨツト申譯けないのですが、","xmin":2378.0,"ymin":963.0,"xmax":2444.0,"ymax":1982.0},{"id":29,"contenttext":"詰り雀の生活が西洋","xmin":2374.0,"ymin":1991.0,"xmax":2422.0,"ymax":2309.0},{"id":30,"contenttext":"人の生活に似て居る。","xmin":2330.0,"ymin":586.0,"xmax":2383.0,"ymax":917.0},{"id":31,"contenttext":"かう言へば宜いでせう。","xmin":2322.0,"ymin":930.0,"xmax":2376.0,"ymax":1293.0},{"id":32,"contenttext":"(笑聲)","xmin":2321.0,"ymin":1302.0,"xmax":2367.0,"ymax":1417.0},{"id":33,"contenttext":"雀の方が似てゐるのです。","xmin":2312.0,"ymin":1441.0,"xmax":2367.0,"ymax":1843.0},{"id":34,"contenttext":"ですからその家といふものは","xmin":2303.0,"ymin":1853.0,"xmax":2358.0,"ymax":2306.0},{"id":35,"contenttext":"それで一代切りです。","xmin":2263.0,"ymin":585.0,"xmax":2314.0,"ymax":917.0},{"id":36,"contenttext":"一代切りでなくなつて來る。","xmin":2255.0,"ymin":935.0,"xmax":2305.0,"ymax":1359.0},{"id":37,"contenttext":"ところが我國に於きましては自然に、","xmin":2244.0,"ymin":1372.0,"xmax":2297.0,"ymax":1943.0},{"id":38,"contenttext":"昔からずつと一軒の家","xmin":2235.0,"ymin":1952.0,"xmax":2290.0,"ymax":2304.0},{"id":39,"contenttext":"には家長といふものを立てる。","xmin":2190.0,"ymin":584.0,"xmax":2248.0,"ymax":1051.0},{"id":40,"contenttext":"その家長といふものは祖先からずつと承け繼いで來る。","xmin":2174.0,"ymin":1060.0,"xmax":2237.0,"ymax":1908.0},{"id":41,"contenttext":"さうして子孫に傳へて行","xmin":2167.0,"ymin":1920.0,"xmax":2220.0,"ymax":2303.0},{"id":42,"contenttext":"く","xmin":2138.0,"ymin":583.0,"xmax":2164.0,"ymax":629.0},{"id":43,"contenttext":"かういふ家といふものが直線的です。","xmin":2116.0,"ymin":650.0,"xmax":2174.0,"ymax":1225.0},{"id":44,"contenttext":"その秩序を立てゝ行く。","xmin":2109.0,"ymin":1226.0,"xmax":2162.0,"ymax":1592.0},{"id":45,"contenttext":"そこで今度子孫といふものが出來て來ます。","xmin":2097.0,"ymin":1606.0,"xmax":2157.0,"ymax":2277.0},{"id":46,"contenttext":"澤山の家族がありますと同じ血統の者が殖えて來ますから、","xmin":2042.0,"ymin":577.0,"xmax":2108.0,"ymax":1493.0},{"id":47,"contenttext":"澤山の家はありますけれども、","xmin":2033.0,"ymin":1501.0,"xmax":2088.0,"ymax":1971.0},{"id":48,"contenttext":"それが同一の血統で","xmin":2029.0,"ymin":1984.0,"xmax":2079.0,"ymax":2297.0},{"id":49,"contenttext":"あるといふことになる。","xmin":1986.0,"ymin":579.0,"xmax":2035.0,"ymax":941.0},{"id":50,"contenttext":"それを氏族と言ひます。","xmin":1976.0,"ymin":953.0,"xmax":2030.0,"ymax":1319.0},{"id":51,"contenttext":"この氏族といふものには氏の上といふものがある。","xmin":1959.0,"ymin":1334.0,"xmax":2022.0,"ymax":2107.0},{"id":52,"contenttext":"或は氏の長","xmin":1954.0,"ymin":2116.0,"xmax":2007.0,"ymax":2297.0},{"id":53,"contenttext":"者と言ひます。","xmin":1921.0,"ymin":576.0,"xmax":1967.0,"ymax":804.0},{"id":54,"contenttext":"あつちにもこつちにも氏の上がありまして、","xmin":1904.0,"ymin":815.0,"xmax":1962.0,"ymax":1488.0},{"id":55,"contenttext":"その一族を統一致します。","xmin":1896.0,"ymin":1501.0,"xmax":1949.0,"ymax":1899.0},{"id":56,"contenttext":"それが天皇陛下に奉仕す","xmin":1891.0,"ymin":1912.0,"xmax":1944.0,"ymax":2295.0},{"id":57,"contenttext":"るといふことになる。","xmin":1853.0,"ymin":576.0,"xmax":1898.0,"ymax":905.0},{"id":58,"contenttext":"氏の上として最も大切なことは、","xmin":1841.0,"ymin":915.0,"xmax":1894.0,"ymax":1418.0},{"id":59,"contenttext":"その祖先の神靈を祭るといふことである。","xmin":1828.0,"ymin":1431.0,"xmax":1883.0,"ymax":2068.0},{"id":60,"contenttext":"さういふ具合","xmin":1826.0,"ymin":2083.0,"xmax":1868.0,"ymax":2293.0},{"id":61,"contenttext":"10","xmin":2924.0,"ymin":2226.0,"xmax":2956.0,"ymax":2260.0},{"id":62,"contenttext":"にしてキチンと秩序立つて居る。","xmin":1618.0,"ymin":571.0,"xmax":1660.0,"ymax":1068.0},{"id":63,"contenttext":"一軒の家には一軒の家で妻子一族がその家長に依つて統一されて居る。","xmin":1608.0,"ymin":1091.0,"xmax":1661.0,"ymax":2166.0},{"id":64,"contenttext":"その澤","xmin":1609.0,"ymin":2178.0,"xmax":1650.0,"ymax":2286.0},{"id":65,"contenttext":"山の家長が氏の上に依つてずつと統一されて居る。","xmin":1545.0,"ymin":567.0,"xmax":1599.0,"ymax":1343.0},{"id":66,"contenttext":"かういふやうな秩序の観念といふものを日本國民は潜在的に","xmin":1537.0,"ymin":1355.0,"xmax":1592.0,"ymax":2288.0},{"id":67,"contenttext":"持つて居つた。","xmin":1478.0,"ymin":564.0,"xmax":1529.0,"ymax":795.0},{"id":68,"contenttext":"第三には義氣の旺盛であります。","xmin":1406.0,"ymin":599.0,"xmax":1460.0,"ymax":1104.0},{"id":69,"contenttext":"義に依つて行動してどんなことがあつても後へ引かぬ。","xmin":1400.0,"ymin":1112.0,"xmax":1455.0,"ymax":1960.0},{"id":70,"contenttext":"正しい道に立つては","xmin":1401.0,"ymin":1972.0,"xmax":1447.0,"ymax":2284.0},{"id":71,"contenttext":"後へ引かないといふ精神に日本國民は富んで居る。","xmin":1338.0,"ymin":562.0,"xmax":1389.0,"ymax":1341.0},{"id":72,"contenttext":"天照大御神のやうな女性の神樣であらせられても、","xmin":1331.0,"ymin":1353.0,"xmax":1381.0,"ymax":2131.0},{"id":73,"contenttext":"須佐之男","xmin":1332.0,"ymin":2140.0,"xmax":1377.0,"ymax":2286.0},{"id":74,"contenttext":"命が高天原にお出でになります時に於ては、","xmin":1268.0,"ymin":562.0,"xmax":1317.0,"ymax":1236.0},{"id":75,"contenttext":"必ずこれは異心を懷いて來るに相違ないといふので、","xmin":1263.0,"ymin":1248.0,"xmax":1314.0,"ymax":2061.0},{"id":76,"contenttext":"千入の靱、","xmin":1264.0,"ymin":2073.0,"xmax":1309.0,"ymax":2231.0},{"id":77,"contenttext":"百","xmin":1267.0,"ymin":2244.0,"xmax":1308.0,"ymax":2282.0},{"id":78,"contenttext":"さうして弓を突いて非常な","xmin":1197.0,"ymin":1868.0,"xmax":1239.0,"ymax":2282.0},{"id":79,"contenttext":"百入りの靱と申しまして、","xmin":1204.0,"ymin":564.0,"xmax":1246.0,"ymax":961.0},{"id":80,"contenttext":"澤山の矢を背中に御背負ひになりまして武裝をなさつた。","xmin":1197.0,"ymin":971.0,"xmax":1249.0,"ymax":1854.0},{"id":81,"contenttext":"勢を以て須佐之男命がお出でになる時に、「お前は何故に上つて來たのだ」","xmin":1126.0,"ymin":558.0,"xmax":1188.0,"ymax":1691.0},{"id":82,"contenttext":"と大きな聲で仰せになつたといふこと","xmin":1125.0,"ymin":1690.0,"xmax":1174.0,"ymax":2281.0},{"id":83,"contenttext":"である。","xmin":1073.0,"ymin":564.0,"xmax":1116.0,"ymax":687.0},{"id":84,"contenttext":"又天字受賣命といふのがあります。","xmin":1064.0,"ymin":698.0,"xmax":1115.0,"ymax":1234.0},{"id":85,"contenttext":"天宇受賣命といふのは、","xmin":1061.0,"ymin":1248.0,"xmax":1107.0,"ymax":1613.0},{"id":86,"contenttext":"天孫が降臨遊ばす時に天の八衝といふ道の","xmin":1059.0,"ymin":1623.0,"xmax":1100.0,"ymax":2281.0},{"id":87,"contenttext":"te","xmin":1026.0,"ymin":2067.0,"xmax":1049.0,"ymax":2111.0},{"id":88,"contenttext":"分れる所へお出でになつた。","xmin":996.0,"ymin":558.0,"xmax":1046.0,"ymax":993.0},{"id":89,"contenttext":"さうすると發田民古神がそこへ出てお出でになる。","xmin":988.0,"ymin":1008.0,"xmax":1040.0,"ymax":1782.0},{"id":90,"contenttext":"び","xmin":1028.0,"ymin":1243.0,"xmax":1058.0,"ymax":1274.0},{"id":91,"contenttext":"「上は高天ケ原を光し、","xmin":986.0,"ymin":1808.0,"xmax":1038.0,"ymax":2159.0},{"id":92,"contenttext":"下は葦","xmin":988.0,"ymin":2171.0,"xmax":1033.0,"ymax":2282.0},{"id":93,"contenttext":"I","xmin":966.0,"ymin":765.0,"xmax":987.0,"ymax":804.0},{"id":94,"contenttext":"原の中つ國を光す」と書いてありますが、","xmin":925.0,"ymin":558.0,"xmax":977.0,"ymax":1201.0},{"id":95,"contenttext":"それは實に眼の光がするどく、","xmin":921.0,"ymin":1213.0,"xmax":966.0,"ymax":1675.0},{"id":96,"contenttext":"所謂眼光烱々人を射るといふ程の大き","xmin":916.0,"ymin":1690.0,"xmax":966.0,"ymax":2281.0},{"id":97,"contenttext":"な御方で非常に勇敢な御方であつた。","xmin":857.0,"ymin":558.0,"xmax":909.0,"ymax":1132.0},{"id":98,"contenttext":"あゝいふ者があそこに立つて居るが何だらう、","xmin":849.0,"ymin":1142.0,"xmax":900.0,"ymax":1849.0},{"id":99,"contenttext":"チョット行つて聞いて見よ","xmin":848.0,"ymin":1864.0,"xmax":896.0,"ymax":2279.0},{"id":100,"contenttext":"といふのでありますけれども、","xmin":790.0,"ymin":558.0,"xmax":837.0,"ymax":1026.0},{"id":101,"contenttext":"どの神樣も聊か躊躇の色が見えます。","xmin":783.0,"ymin":1038.0,"xmax":836.0,"ymax":1612.0},{"id":102,"contenttext":"そこでこの天字受賣命といふ女性の神樣-","xmin":779.0,"ymin":1621.0,"xmax":827.0,"ymax":2279.0},{"id":103,"contenttext":"女性の神樣でも中々御强い、","xmin":724.0,"ymin":557.0,"xmax":770.0,"ymax":991.0},{"id":104,"contenttext":"その天宇受賣命を御遣はしになると、","xmin":714.0,"ymin":1004.0,"xmax":767.0,"ymax":1574.0},{"id":105,"contenttext":"天字受賣命は今天の神の御子が御降りになら","xmin":708.0,"ymin":1584.0,"xmax":765.0,"ymax":2279.0},{"id":106,"contenttext":"うとする際に、","xmin":657.0,"ymin":559.0,"xmax":700.0,"ymax":784.0},{"id":107,"contenttext":"その道に立つて居る者は何者だ」","xmin":650.0,"ymin":798.0,"xmax":703.0,"ymax":1308.0},{"id":108,"contenttext":"かういふ具合に御叫びになると、「自分は國つ神で猿田毘古神と","xmin":644.0,"ymin":1311.0,"xmax":697.0,"ymax":2279.0},{"id":109,"contenttext":"いふのであるが、","xmin":587.0,"ymin":562.0,"xmax":631.0,"ymax":818.0},{"id":110,"contenttext":"天孫が御降りになるといふので御迎へに來たのである」","xmin":576.0,"ymin":830.0,"xmax":630.0,"ymax":1684.0},{"id":111,"contenttext":"かう言ふ次第で大變都合が好かつたの","xmin":572.0,"ymin":1688.0,"xmax":623.0,"ymax":2276.0},{"id":112,"contenttext":"二","xmin":515.0,"ymin":2184.0,"xmax":543.0,"ymax":2214.0},{"id":113,"contenttext":"皇國傳統の精神","xmin":521.0,"ymin":736.0,"xmax":560.0,"ymax":952.0}]