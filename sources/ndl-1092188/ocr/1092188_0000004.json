[{"id":0,"contenttext":"皇國傳統の精神","xmin":2891.0,"ymin":720.0,"xmax":2931.0,"ymax":933.0},{"id":1,"contenttext":"ニ","xmin":2906.0,"ymin":2171.0,"xmax":2938.0,"ymax":2201.0},{"id":2,"contenttext":"目で片一方の目が二皮目といふやうな場合が多い。","xmin":2821.0,"ymin":539.0,"xmax":2869.0,"ymax":1313.0},{"id":3,"contenttext":"そんな瞼の一皮とか二皮位のことはどうでも宜ささうなもの","xmin":2826.0,"ymin":1327.0,"xmax":2876.0,"ymax":2253.0},{"id":4,"contenttext":"ですが、","xmin":2752.0,"ymin":540.0,"xmax":2801.0,"ymax":663.0},{"id":5,"contenttext":"さういふところ迄細かく違つて來る。","xmin":2753.0,"ymin":677.0,"xmax":2802.0,"ymax":1245.0},{"id":6,"contenttext":"さういふ風に遺傳で、","xmin":2760.0,"ymin":1260.0,"xmax":2802.0,"ymax":1588.0},{"id":7,"contenttext":"さういふ違ひがありますやうに精神の上に","xmin":2759.0,"ymin":1604.0,"xmax":2808.0,"ymax":2254.0},{"id":8,"contenttext":"も亦違ひがある。","xmin":2684.0,"ymin":539.0,"xmax":2728.0,"ymax":800.0},{"id":9,"contenttext":"父の精神をどれだけ承け繼いで居るか、","xmin":2685.0,"ymin":812.0,"xmax":2735.0,"ymax":1419.0},{"id":10,"contenttext":"母の精神をどれだけ承け繼いで居るか、","xmin":2689.0,"ymin":1429.0,"xmax":2739.0,"ymax":2036.0},{"id":11,"contenttext":"その方は眼に","xmin":2693.0,"ymin":2048.0,"xmax":2738.0,"ymax":2256.0},{"id":12,"contenttext":"見えませぬ。","xmin":2613.0,"ymin":539.0,"xmax":2659.0,"ymax":734.0},{"id":13,"contenttext":"見えませぬけれども確かに承け繼ぎ方が違ふ。","xmin":2614.0,"ymin":743.0,"xmax":2666.0,"ymax":1454.0},{"id":14,"contenttext":"それが代々重なつて來ますから、","xmin":2618.0,"ymin":1464.0,"xmax":2670.0,"ymax":1967.0},{"id":15,"contenttext":"遺傳に因つて人々","xmin":2624.0,"ymin":1978.0,"xmax":2668.0,"ymax":2254.0},{"id":16,"contenttext":"の精神がいろ〓〓に變つて來る。","xmin":2544.0,"ymin":544.0,"xmax":2592.0,"ymax":1040.0},{"id":17,"contenttext":"百人居れば百人、","xmin":2549.0,"ymin":1054.0,"xmax":2592.0,"ymax":1317.0},{"id":18,"contenttext":"千人居れば千人、","xmin":2547.0,"ymin":1326.0,"xmax":2599.0,"ymax":1591.0},{"id":19,"contenttext":"全く同一の精神を持つて居るといふことが","xmin":2551.0,"ymin":1599.0,"xmax":2599.0,"ymax":2256.0},{"id":20,"contenttext":"なくなつて來る。","xmin":2478.0,"ymin":543.0,"xmax":2519.0,"ymax":802.0},{"id":21,"contenttext":"それから境遇と申しまして、","xmin":2409.0,"ymin":576.0,"xmax":2454.0,"ymax":1007.0},{"id":22,"contenttext":"その人の生活して居る外界の境遇でありますが、","xmin":2412.0,"ymin":1020.0,"xmax":2463.0,"ymax":1763.0},{"id":23,"contenttext":"境遇と申しますと、","xmin":2418.0,"ymin":1773.0,"xmax":2460.0,"ymax":2069.0},{"id":24,"contenttext":"或は氣候の","xmin":2420.0,"ymin":2083.0,"xmax":2464.0,"ymax":2260.0},{"id":25,"contenttext":"非常に良いところ、","xmin":2339.0,"ymin":541.0,"xmax":2381.0,"ymax":837.0},{"id":26,"contenttext":"山水の風光明媚なところ、","xmin":2339.0,"ymin":849.0,"xmax":2390.0,"ymax":1248.0},{"id":27,"contenttext":"或は砂漠みたいなところが澤山あるやうなところ、","xmin":2344.0,"ymin":1260.0,"xmax":2392.0,"ymax":2035.0},{"id":28,"contenttext":"さういふ風な","xmin":2349.0,"ymin":2052.0,"xmax":2392.0,"ymax":2260.0},{"id":29,"contenttext":"みな外界の狀況であります。","xmin":2269.0,"ymin":541.0,"xmax":2320.0,"ymax":973.0},{"id":30,"contenttext":"或は又都會に生れるとか、","xmin":2275.0,"ymin":984.0,"xmax":2323.0,"ymax":1386.0},{"id":31,"contenttext":"村落に生れるとかいふやうなことに因つても亦違つて來","xmin":2277.0,"ymin":1396.0,"xmax":2325.0,"ymax":2260.0},{"id":32,"contenttext":"ます。","xmin":2205.0,"ymin":543.0,"xmax":2245.0,"ymax":631.0},{"id":33,"contenttext":"それ等はみな境遇であります。","xmin":2202.0,"ymin":643.0,"xmax":2251.0,"ymax":1114.0},{"id":34,"contenttext":"それから又〓育であります。","xmin":2132.0,"ymin":578.0,"xmax":2179.0,"ymax":1008.0},{"id":35,"contenttext":"昔でも今日でも〓育といふものはある。","xmin":2138.0,"ymin":1020.0,"xmax":2180.0,"ymax":1625.0},{"id":36,"contenttext":"今日は西洋流に學校が澤山出來て居りま","xmin":2141.0,"ymin":1639.0,"xmax":2184.0,"ymax":2260.0},{"id":37,"contenttext":"すから〓育も亦普及致しますが、","xmin":2064.0,"ymin":543.0,"xmax":2112.0,"ymax":1045.0},{"id":38,"contenttext":"昔に於てもそれ相當の〓育は矢張り行はれて居つた。","xmin":2069.0,"ymin":1056.0,"xmax":2118.0,"ymax":1868.0},{"id":39,"contenttext":"その〓育の仕方、","xmin":2071.0,"ymin":1879.0,"xmax":2119.0,"ymax":2142.0},{"id":40,"contenttext":"〓師の","xmin":2074.0,"ymin":2152.0,"xmax":2117.0,"ymax":2260.0},{"id":41,"contenttext":"人物の如何、","xmin":1999.0,"ymin":543.0,"xmax":2043.0,"ymax":737.0},{"id":42,"contenttext":"〓育の場所の設備等によつてその結果色々となり、","xmin":1998.0,"ymin":746.0,"xmax":2048.0,"ymax":1524.0},{"id":43,"contenttext":"人の精神が相違して來ます。","xmin":2004.0,"ymin":1537.0,"xmax":2050.0,"ymax":1969.0},{"id":44,"contenttext":"さういふ具合で遺傳や境過や〓育といふやうなものに因つて人々の精神がいろ〓〓に違つて來ます。","xmin":1929.0,"ymin":581.0,"xmax":1982.0,"ymax":2106.0},{"id":45,"contenttext":"ところが","xmin":1939.0,"ymin":2120.0,"xmax":1979.0,"ymax":2261.0},{"id":46,"contenttext":"その人々が唯一人で生活しない。","xmin":1860.0,"ymin":544.0,"xmax":1908.0,"ymax":1045.0},{"id":47,"contenttext":"人間は離群索居と云ふ風に、","xmin":1864.0,"ymin":1059.0,"xmax":1913.0,"ymax":1491.0},{"id":48,"contenttext":"一人で他の者から離れて生活することは出來な","xmin":1867.0,"ymin":1512.0,"xmax":1911.0,"ymax":2263.0},{"id":49,"contenttext":"い","xmin":1798.0,"ymin":550.0,"xmax":1835.0,"ymax":597.0},{"id":50,"contenttext":"必ず集團生活する。","xmin":1795.0,"ymin":610.0,"xmax":1837.0,"ymax":908.0},{"id":51,"contenttext":"その集團の第一步は家族であります。","xmin":1795.0,"ymin":920.0,"xmax":1844.0,"ymax":1491.0},{"id":52,"contenttext":"それから段々とその家が集りまして町村といふも","xmin":1799.0,"ymin":1503.0,"xmax":1846.0,"ymax":2263.0},{"id":53,"contenttext":"のになる。","xmin":1599.0,"ymin":560.0,"xmax":1638.0,"ymax":714.0},{"id":54,"contenttext":"さういふやうな團體の生活をしますとその國體で又一つの精神が違つて來る。","xmin":1592.0,"ymin":730.0,"xmax":1641.0,"ymax":1912.0},{"id":55,"contenttext":"一軒の家がありますと","xmin":1590.0,"ymin":1935.0,"xmax":1634.0,"ymax":2273.0},{"id":56,"contenttext":"その家の精神-昔はよく家風と申しました。新たに嫁に行きましたり養子に行きましたりしましたならば、その家","xmin":1519.0,"ymin":557.0,"xmax":1573.0,"ymax":2274.0},{"id":57,"contenttext":"の家風に従はなければならぬ。","xmin":1458.0,"ymin":560.0,"xmax":1503.0,"ymax":1021.0},{"id":58,"contenttext":"家風に反するといふので離緣といふやうな不祥なことが起るやうなことがあつた","xmin":1450.0,"ymin":1033.0,"xmax":1500.0,"ymax":2274.0},{"id":59,"contenttext":"ものであります。","xmin":1392.0,"ymin":555.0,"xmax":1433.0,"ymax":816.0},{"id":60,"contenttext":"この家風といふのは卽ち家族の精神であります。","xmin":1386.0,"ymin":834.0,"xmax":1435.0,"ymax":1570.0},{"id":61,"contenttext":"その家の精神であります。","xmin":1385.0,"ymin":1583.0,"xmax":1429.0,"ymax":1981.0},{"id":62,"contenttext":"それから今度町村","xmin":1384.0,"ymin":1993.0,"xmax":1428.0,"ymax":2275.0},{"id":63,"contenttext":"といふ具合になりますと、","xmin":1324.0,"ymin":557.0,"xmax":1366.0,"ymax":952.0},{"id":64,"contenttext":"又町村の精神といふものがあります。","xmin":1317.0,"ymin":966.0,"xmax":1365.0,"ymax":1534.0},{"id":65,"contenttext":"町村全體の人の働き方であります。","xmin":1317.0,"ymin":1547.0,"xmax":1362.0,"ymax":2085.0},{"id":66,"contenttext":"それでその","xmin":1315.0,"ymin":2096.0,"xmax":1359.0,"ymax":2272.0},{"id":67,"contenttext":"土地に這入りましたならば、","xmin":1254.0,"ymin":557.0,"xmax":1300.0,"ymax":989.0},{"id":68,"contenttext":"その土地の風に從はなければならぬ。","xmin":1248.0,"ymin":1000.0,"xmax":1299.0,"ymax":1569.0},{"id":69,"contenttext":"詰りその土地の精神を尊重しなければならぬ","xmin":1248.0,"ymin":1583.0,"xmax":1294.0,"ymax":2274.0},{"id":70,"contenttext":"といふことであります。","xmin":1186.0,"ymin":557.0,"xmax":1228.0,"ymax":918.0},{"id":71,"contenttext":"それは昔から","xmin":1183.0,"ymin":932.0,"xmax":1228.0,"ymax":1146.0},{"id":72,"contenttext":"「〓に入つては〓に從へ」といふことであります。","xmin":1177.0,"ymin":1147.0,"xmax":1229.0,"ymax":1914.0},{"id":73,"contenttext":"「〓」といふのは詰り","xmin":1175.0,"ymin":1937.0,"xmax":1225.0,"ymax":2274.0},{"id":74,"contenttext":"今日の町村といふやうなものであります。","xmin":1113.0,"ymin":553.0,"xmax":1159.0,"ymax":1192.0},{"id":75,"contenttext":"それからさういふ團體が更に大きくなりますと一つの國になります、","xmin":1107.0,"ymin":1205.0,"xmax":1156.0,"ymax":2261.0},{"id":76,"contenttext":"大日本帝國、","xmin":1050.0,"ymin":553.0,"xmax":1095.0,"ymax":746.0},{"id":77,"contenttext":"或はアメリカ、","xmin":1047.0,"ymin":759.0,"xmax":1093.0,"ymax":988.0},{"id":78,"contenttext":"イギリス、","xmin":1054.0,"ymin":1000.0,"xmax":1089.0,"ymax":1156.0},{"id":79,"contenttext":"フランスといふやうな一つの國になります。","xmin":1045.0,"ymin":1176.0,"xmax":1087.0,"ymax":1842.0},{"id":80,"contenttext":"その一つの國になると又そ","xmin":1043.0,"ymin":1853.0,"xmax":1087.0,"ymax":2272.0},{"id":81,"contenttext":"の國の精神といふものが違つて來る。","xmin":978.0,"ymin":559.0,"xmax":1024.0,"ymax":1124.0},{"id":82,"contenttext":"アメリカなどになりますと「自由、","xmin":974.0,"ymin":1139.0,"xmax":1016.0,"ymax":1669.0},{"id":83,"contenttext":"平等、","xmin":973.0,"ymin":1681.0,"xmax":1019.0,"ymax":1776.0},{"id":84,"contenttext":"博愛」といふやうなことを尊重","xmin":969.0,"ymin":1782.0,"xmax":1015.0,"ymax":2270.0},{"id":85,"contenttext":"する。","xmin":915.0,"ymin":553.0,"xmax":955.0,"ymax":642.0},{"id":86,"contenttext":"「我れに自由を與へよ、","xmin":909.0,"ymin":669.0,"xmax":956.0,"ymax":1021.0},{"id":87,"contenttext":"然らずんば死を與へよ」","xmin":907.0,"ymin":1032.0,"xmax":954.0,"ymax":1403.0},{"id":88,"contenttext":"といふやうなことを申します。","xmin":907.0,"ymin":1408.0,"xmax":948.0,"ymax":1875.0},{"id":89,"contenttext":"それをアメリカの建國以","xmin":902.0,"ymin":1889.0,"xmax":946.0,"ymax":2270.0},{"id":90,"contenttext":"來の傳統の精神とするのであります。","xmin":838.0,"ymin":551.0,"xmax":891.0,"ymax":1125.0},{"id":91,"contenttext":"さう云ふ風に一つの國家を成しますと、","xmin":835.0,"ymin":1137.0,"xmax":884.0,"ymax":1738.0},{"id":92,"contenttext":"その國家に固有の精神といふもの","xmin":833.0,"ymin":1750.0,"xmax":882.0,"ymax":2270.0},{"id":93,"contenttext":"が出來る。","xmin":776.0,"ymin":555.0,"xmax":818.0,"ymax":714.0},{"id":94,"contenttext":"その精神は丁度吾々個人の間の精神が違ひますやうに、","xmin":767.0,"ymin":724.0,"xmax":818.0,"ymax":1567.0},{"id":95,"contenttext":"一の國家の精神と他の國家の精神とを較べま","xmin":763.0,"ymin":1590.0,"xmax":813.0,"ymax":2270.0},{"id":96,"contenttext":"すとそれが違ふ。","xmin":703.0,"ymin":553.0,"xmax":749.0,"ymax":815.0},{"id":97,"contenttext":"それはその國民全體の遺傳、","xmin":701.0,"ymin":827.0,"xmax":747.0,"ymax":1258.0},{"id":98,"contenttext":"國民全體の境遇、國民全體の〓育と云ふものによるのであります。","xmin":694.0,"ymin":1271.0,"xmax":746.0,"ymax":2270.0},{"id":99,"contenttext":"さういふやうな意味でありまして、","xmin":633.0,"ymin":589.0,"xmax":677.0,"ymax":1120.0},{"id":100,"contenttext":"我が皇國に於きましては、","xmin":627.0,"ymin":1133.0,"xmax":678.0,"ymax":1532.0},{"id":101,"contenttext":"昔から固有傳統の精神が出來て居るのでありま","xmin":623.0,"ymin":1542.0,"xmax":674.0,"ymax":2270.0},{"id":102,"contenttext":"す。","xmin":571.0,"ymin":552.0,"xmax":610.0,"ymax":612.0},{"id":103,"contenttext":"それが丁度吾々個人の精神が常に發展しつゝあると同じやうにその皇國の精神がグン〓〓と發展して參りつ","xmin":556.0,"ymin":620.0,"xmax":609.0,"ymax":2265.0},{"id":104,"contenttext":"皇國傳統の精神","xmin":504.0,"ymin":731.0,"xmax":541.0,"ymax":945.0},{"id":105,"contenttext":"三","xmin":494.0,"ymin":2184.0,"xmax":531.0,"ymax":2214.0}]