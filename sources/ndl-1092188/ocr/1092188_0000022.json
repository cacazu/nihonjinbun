[{"id":0,"contenttext":"天","xmin":2929.0,"ymin":2207.0,"xmax":2966.0,"ymax":2247.0},{"id":1,"contenttext":"皇國傳統の精神","xmin":2930.0,"ymin":763.0,"xmax":2975.0,"ymax":981.0},{"id":2,"contenttext":"立ちましたら大變です。","xmin":2864.0,"ymin":585.0,"xmax":2910.0,"ymax":950.0},{"id":3,"contenttext":"骨ぐるみ食べる譯に行きませぬ。","xmin":2861.0,"ymin":959.0,"xmax":2912.0,"ymax":1467.0},{"id":4,"contenttext":"ところが儒〓でも、","xmin":2862.0,"ymin":1477.0,"xmax":2905.0,"ymax":1771.0},{"id":5,"contenttext":"佛〓でも、","xmin":2862.0,"ymin":1782.0,"xmax":2906.0,"ymax":1944.0},{"id":6,"contenttext":"西洋の思想でも、","xmin":2857.0,"ymin":1954.0,"xmax":2907.0,"ymax":2221.0},{"id":7,"contenttext":"これ","xmin":2857.0,"ymin":2231.0,"xmax":2901.0,"ymax":2307.0},{"id":8,"contenttext":"を骨ぐるみ食べましたら非常に害になる。","xmin":2793.0,"ymin":583.0,"xmax":2840.0,"ymax":1222.0},{"id":9,"contenttext":"だから吾々はその骨を取り、","xmin":2791.0,"ymin":1234.0,"xmax":2840.0,"ymax":1669.0},{"id":10,"contenttext":"榮養にならぬところのもの、","xmin":2789.0,"ymin":1678.0,"xmax":2836.0,"ymax":2113.0},{"id":11,"contenttext":"害になると","xmin":2790.0,"ymin":2124.0,"xmax":2832.0,"ymax":2304.0},{"id":12,"contenttext":"ころのものを取つて食べなければなりませぬ。","xmin":2727.0,"ymin":587.0,"xmax":2771.0,"ymax":1288.0},{"id":13,"contenttext":"殊に鯛の刺身などは持つて來いであります。","xmin":2722.0,"ymin":1304.0,"xmax":2771.0,"ymax":1978.0},{"id":14,"contenttext":"鯛の刺身は骨を取つ","xmin":2720.0,"ymin":1986.0,"xmax":2765.0,"ymax":2302.0},{"id":15,"contenttext":"てありますから小さい子供でも食べられるやうになる。","xmin":2654.0,"ymin":585.0,"xmax":2705.0,"ymax":1423.0},{"id":16,"contenttext":"さういふ具合に外國の思想をみな取つて來て刺身のやう","xmin":2651.0,"ymin":1440.0,"xmax":2702.0,"ymax":2302.0},{"id":17,"contenttext":"にして食べますと、","xmin":2593.0,"ymin":583.0,"xmax":2635.0,"ymax":877.0},{"id":18,"contenttext":"そこで皇國傳統の精神の培養になつて、","xmin":2587.0,"ymin":890.0,"xmax":2636.0,"ymax":1496.0},{"id":19,"contenttext":"ずつとこれを發展させることが出來るのでありま","xmin":2583.0,"ymin":1507.0,"xmax":2632.0,"ymax":2298.0},{"id":20,"contenttext":"す。","xmin":2527.0,"ymin":578.0,"xmax":2570.0,"ymax":638.0},{"id":21,"contenttext":"かういふ具合で吾々は外來思想をみな取入れるのであります。","xmin":2450.0,"ymin":615.0,"xmax":2500.0,"ymax":1564.0},{"id":22,"contenttext":"さうして我傳統の精神を發展して來る。","xmin":2446.0,"ymin":1576.0,"xmax":2493.0,"ymax":2179.0},{"id":23,"contenttext":"我傳統","xmin":2448.0,"ymin":2191.0,"xmax":2490.0,"ymax":2302.0},{"id":24,"contenttext":"の精神はさういふ偉大なものでありますけれども、","xmin":2382.0,"ymin":583.0,"xmax":2434.0,"ymax":1356.0},{"id":25,"contenttext":"それを說明してそれを發表する上に於て、","xmin":2379.0,"ymin":1367.0,"xmax":2429.0,"ymax":2006.0},{"id":26,"contenttext":"丁度例へて見ます","xmin":2378.0,"ymin":2018.0,"xmax":2423.0,"ymax":2298.0},{"id":27,"contenttext":"と吾々の體のやうなものでありまして、","xmin":2315.0,"ymin":580.0,"xmax":2363.0,"ymax":1181.0},{"id":28,"contenttext":"吾々の體はこれ大和民族といふので、","xmin":2311.0,"ymin":1193.0,"xmax":2360.0,"ymax":1766.0},{"id":29,"contenttext":"この體は西洋などから見ると、","xmin":2308.0,"ymin":1780.0,"xmax":2355.0,"ymax":2247.0},{"id":30,"contenttext":"黃","xmin":2307.0,"ymin":2252.0,"xmax":2353.0,"ymax":2300.0},{"id":31,"contenttext":"色人種などゝ言つて賤みますけれども、","xmin":2248.0,"ymin":576.0,"xmax":2296.0,"ymax":1181.0},{"id":32,"contenttext":"併しこの體は吾々が祖先から承け權いだところの立派な體です。","xmin":2241.0,"ymin":1193.0,"xmax":2294.0,"ymax":2179.0},{"id":33,"contenttext":"有難い","xmin":2242.0,"ymin":2186.0,"xmax":2286.0,"ymax":2295.0},{"id":34,"contenttext":"體です。","xmin":2184.0,"ymin":575.0,"xmax":2228.0,"ymax":702.0},{"id":35,"contenttext":"殊に日本國民は優秀な身體を持つて居る。","xmin":2176.0,"ymin":712.0,"xmax":2228.0,"ymax":1350.0},{"id":36,"contenttext":"一體人間の偉いといふのは何が偉いのですか、","xmin":2173.0,"ymin":1373.0,"xmax":2223.0,"ymax":2071.0},{"id":37,"contenttext":"體力が强いこ","xmin":2173.0,"ymin":2082.0,"xmax":2217.0,"ymax":2295.0},{"id":38,"contenttext":"とが偉いのではありますまい。","xmin":2113.0,"ymin":578.0,"xmax":2157.0,"ymax":1043.0},{"id":39,"contenttext":"重い物を持上げるのが偉いのではありますまい。","xmin":2104.0,"ymin":1054.0,"xmax":2157.0,"ymax":1795.0},{"id":40,"contenttext":"若し力が强いのが偉いならお角","xmin":2103.0,"ymin":1808.0,"xmax":2151.0,"ymax":2298.0},{"id":41,"contenttext":"力さん、","xmin":2046.0,"ymin":575.0,"xmax":2089.0,"ymax":701.0},{"id":42,"contenttext":"横綱などは日本では偉い人になる。","xmin":2040.0,"ymin":710.0,"xmax":2089.0,"ymax":1248.0},{"id":43,"contenttext":"横綱を大先生として、","xmin":2039.0,"ymin":1258.0,"xmax":2085.0,"ymax":1592.0},{"id":44,"contenttext":"大動位、","xmin":2036.0,"ymin":1602.0,"xmax":2083.0,"ymax":1729.0},{"id":45,"contenttext":"公爵にでもなさらなければならぬ。","xmin":2030.0,"ymin":1739.0,"xmax":2080.0,"ymax":2274.0},{"id":46,"contenttext":"(笑聲)","xmin":1978.0,"ymin":571.0,"xmax":2020.0,"ymax":687.0},{"id":47,"contenttext":"ところが體の强い丈けでは何にもなりませぬ······ならぬのではない。","xmin":1965.0,"ymin":712.0,"xmax":2020.0,"ymax":1761.0},{"id":48,"contenttext":"横綱にはなれますけれども、","xmin":1966.0,"ymin":1775.0,"xmax":2008.0,"ymax":2208.0},{"id":49,"contenttext":"吾々","xmin":1966.0,"ymin":2219.0,"xmax":2005.0,"ymax":2289.0},{"id":50,"contenttext":"國民がそれを崇敬する譯には行かない。","xmin":1904.0,"ymin":574.0,"xmax":1954.0,"ymax":1179.0},{"id":51,"contenttext":"さうして見ると人間の偉いのは體ではなくして精神であります。","xmin":1897.0,"ymin":1193.0,"xmax":1947.0,"ymax":2175.0},{"id":52,"contenttext":"精神の","xmin":1895.0,"ymin":2184.0,"xmax":1940.0,"ymax":2293.0},{"id":53,"contenttext":"偉いのは體の生理的に言ふと何に因るのかといふと、","xmin":1835.0,"ymin":574.0,"xmax":1888.0,"ymax":1386.0},{"id":54,"contenttext":"腦髓に因ると申されて居ります。","xmin":1831.0,"ymin":1394.0,"xmax":1878.0,"ymax":1897.0},{"id":55,"contenttext":"今日の生理學では、","xmin":1829.0,"ymin":1910.0,"xmax":1875.0,"ymax":2210.0},{"id":56,"contenttext":"髓髓","xmin":1831.0,"ymin":2219.0,"xmax":1872.0,"ymax":2295.0},{"id":57,"contenttext":"に因るといふことになつて居ります。","xmin":1614.0,"ymin":559.0,"xmax":1658.0,"ymax":1126.0},{"id":58,"contenttext":"處が日本では解剖といふことは極く最近、","xmin":1608.0,"ymin":1135.0,"xmax":1658.0,"ymax":1779.0},{"id":59,"contenttext":"四.","xmin":1611.0,"ymin":1791.0,"xmax":1651.0,"ymax":1848.0},{"id":60,"contenttext":"五十年來でありますが、","xmin":1607.0,"ymin":1856.0,"xmax":1650.0,"ymax":2221.0},{"id":61,"contenttext":"西","xmin":1606.0,"ymin":2231.0,"xmax":1650.0,"ymax":2275.0},{"id":62,"contenttext":"洋では何百年と解剖して居りますから、","xmin":1543.0,"ymin":553.0,"xmax":1594.0,"ymax":1158.0},{"id":63,"contenttext":"昔の偉い人の腦髓がみな取つてあります。","xmin":1538.0,"ymin":1170.0,"xmax":1590.0,"ymax":1812.0},{"id":64,"contenttext":"我國でも近來腦髓がみな取つ","xmin":1536.0,"ymin":1822.0,"xmax":1585.0,"ymax":2272.0},{"id":65,"contenttext":"てありまして、","xmin":1482.0,"ymin":557.0,"xmax":1525.0,"ymax":779.0},{"id":66,"contenttext":"桂公爵の腦髓だとか、","xmin":1475.0,"ymin":793.0,"xmax":1525.0,"ymax":1125.0},{"id":67,"contenttext":"夏目漱石先生の腦髓だとか、","xmin":1472.0,"ymin":1133.0,"xmax":1522.0,"ymax":1569.0},{"id":68,"contenttext":"あゝいふやうな腦髓が帝大の病院の中に保存","xmin":1470.0,"ymin":1584.0,"xmax":1516.0,"ymax":2274.0},{"id":69,"contenttext":"して居ります。","xmin":1412.0,"ymin":555.0,"xmax":1458.0,"ymax":781.0},{"id":70,"contenttext":"この間亡くなつた杉山とかいふ方の腦髓も保存することになつたとかいふことであります。","xmin":1398.0,"ymin":795.0,"xmax":1455.0,"ymax":2189.0},{"id":71,"contenttext":"西洋","xmin":1398.0,"ymin":2196.0,"xmax":1445.0,"ymax":2275.0},{"id":72,"contenttext":"ではそれで昔から腦髓が保存して統計が取られてあると云ふことでありますが、","xmin":1330.0,"ymin":555.0,"xmax":1387.0,"ymax":1775.0},{"id":73,"contenttext":"その腦髓の目方の重いのが偉い","xmin":1331.0,"ymin":1787.0,"xmax":1377.0,"ymax":2270.0},{"id":74,"contenttext":"といふことである。","xmin":1273.0,"ymin":553.0,"xmax":1313.0,"ymax":847.0},{"id":75,"contenttext":"この間なくなつた杉山さんのは餘程重かつたといふことでありますが、","xmin":1259.0,"ymin":863.0,"xmax":1311.0,"ymax":1943.0},{"id":76,"contenttext":"日本でも桂公爵、","xmin":1259.0,"ymin":1958.0,"xmax":1307.0,"ymax":2221.0},{"id":77,"contenttext":"夏","xmin":1260.0,"ymin":2230.0,"xmax":1306.0,"ymax":2272.0},{"id":78,"contenttext":"目漱石先生の腦髓は非常に重いといふことであります。","xmin":1196.0,"ymin":553.0,"xmax":1247.0,"ymax":1396.0},{"id":79,"contenttext":"平凡な人の腦髓は輕くて偉人の腦髓は重い。","xmin":1192.0,"ymin":1406.0,"xmax":1241.0,"ymax":2080.0},{"id":80,"contenttext":"西洋でもビ","xmin":1193.0,"ymin":2094.0,"xmax":1236.0,"ymax":2267.0},{"id":81,"contenttext":"スマークといふ人の腦髓は特別に重い。","xmin":1130.0,"ymin":557.0,"xmax":1179.0,"ymax":1156.0},{"id":82,"contenttext":"よくビスマークの頭が「毒滅」","xmin":1128.0,"ymin":1170.0,"xmax":1171.0,"ymax":1644.0},{"id":83,"contenttext":"といふ梅毒の薬の看板に使はれて居りま","xmin":1122.0,"ymin":1646.0,"xmax":1173.0,"ymax":2270.0},{"id":84,"contenttext":"したが、","xmin":1066.0,"ymin":552.0,"xmax":1110.0,"ymax":675.0},{"id":85,"contenttext":"ドイツの大使館から外務省に、","xmin":1063.0,"ymin":689.0,"xmax":1107.0,"ymax":1153.0},{"id":86,"contenttext":"早速撤去して貰ひたいと抗議を申込んで來たさうであります。","xmin":1055.0,"ymin":1165.0,"xmax":1106.0,"ymax":2117.0},{"id":87,"contenttext":"(笑聲)","xmin":1056.0,"ymin":2122.0,"xmax":1100.0,"ymax":2240.0},{"id":88,"contenttext":"そこで外務省から內務省に通牒して內務省からあれを禁ずることになつた。","xmin":987.0,"ymin":550.0,"xmax":1044.0,"ymax":1703.0},{"id":89,"contenttext":"あれで梅毒の","xmin":987.0,"ymin":1715.0,"xmax":1035.0,"ymax":1928.0},{"id":90,"contenttext":"「毒滅」","xmin":987.0,"ymin":1930.0,"xmax":1033.0,"ymax":2053.0},{"id":91,"contenttext":"のビスマーク","xmin":989.0,"ymin":2062.0,"xmax":1028.0,"ymax":2265.0},{"id":92,"contenttext":"は止すことになつたと云ふことであります。","xmin":921.0,"ymin":551.0,"xmax":972.0,"ymax":1222.0},{"id":93,"contenttext":"(笑聲)","xmin":920.0,"ymin":1230.0,"xmax":971.0,"ymax":1348.0},{"id":94,"contenttext":"さういふ具合で腦髓の重量に因つて智愚賢不肖がきまるの","xmin":916.0,"ymin":1375.0,"xmax":965.0,"ymax":2267.0},{"id":95,"contenttext":"です。","xmin":861.0,"ymin":552.0,"xmax":904.0,"ymax":640.0},{"id":96,"contenttext":"ところがどうでせう、","xmin":855.0,"ymin":652.0,"xmax":901.0,"ymax":980.0},{"id":97,"contenttext":"西洋人の平均の腦髓と日本人の平均の腦髓と較べて見ますと、","xmin":847.0,"ymin":991.0,"xmax":901.0,"ymax":1943.0},{"id":98,"contenttext":"日本人の方が少し輕","xmin":850.0,"ymin":1956.0,"xmax":893.0,"ymax":2268.0},{"id":99,"contenttext":"いといふのです。","xmin":790.0,"ymin":553.0,"xmax":833.0,"ymax":811.0},{"id":100,"contenttext":"さうして見ると日本人の方が西洋人に劣つて居るかといふ具合に感ぜられますが、","xmin":778.0,"ymin":823.0,"xmax":834.0,"ymax":2078.0},{"id":101,"contenttext":"腦髓の重量","xmin":779.0,"ymin":2088.0,"xmax":827.0,"ymax":2269.0},{"id":102,"contenttext":"といふものは、","xmin":721.0,"ymin":550.0,"xmax":765.0,"ymax":775.0},{"id":103,"contenttext":"決して絕對の重量が重いのでは駄目です。","xmin":715.0,"ymin":785.0,"xmax":766.0,"ymax":1427.0},{"id":104,"contenttext":"詰り體に比例するのですから、","xmin":711.0,"ymin":1436.0,"xmax":761.0,"ymax":1906.0},{"id":105,"contenttext":"若し體ごなしにして腦","xmin":712.0,"ymin":1918.0,"xmax":758.0,"ymax":2267.0},{"id":106,"contenttext":"髓の重さだけで言つて見ると、","xmin":650.0,"ymin":546.0,"xmax":696.0,"ymax":1015.0},{"id":107,"contenttext":"象だの、","xmin":647.0,"ymin":1023.0,"xmax":694.0,"ymax":1152.0},{"id":108,"contenttext":"鯨だのといふのは一番偉くなつて終ふ。","xmin":642.0,"ymin":1163.0,"xmax":693.0,"ymax":1768.0},{"id":109,"contenttext":"(笑聲)","xmin":641.0,"ymin":1777.0,"xmax":691.0,"ymax":1896.0},{"id":110,"contenttext":"象や鯨はあらゆる生物","xmin":641.0,"ymin":1917.0,"xmax":688.0,"ymax":2270.0},{"id":111,"contenttext":"の中で一番重い腦髓を持つて居るけれども、","xmin":578.0,"ymin":550.0,"xmax":632.0,"ymax":1220.0},{"id":112,"contenttext":"どんなに重い腦髓を持つて居つてもあの大きな體にするとポツチリ","xmin":572.0,"ymin":1230.0,"xmax":623.0,"ymax":2263.0},{"id":113,"contenttext":"〓","xmin":509.0,"ymin":2168.0,"xmax":546.0,"ymax":2208.0},{"id":114,"contenttext":"皇國傳統の精神","xmin":516.0,"ymin":726.0,"xmax":555.0,"ymax":938.0}]