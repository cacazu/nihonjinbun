[{"id":0,"contenttext":"皇國傳統の精神","xmin":2906.0,"ymin":694.0,"xmax":2945.0,"ymax":911.0},{"id":1,"contenttext":"八","xmin":2919.0,"ymin":2152.0,"xmax":2947.0,"ymax":2175.0},{"id":2,"contenttext":"その皮を乾かして火を燃して燒きますと骨に裂目が出來ます、","xmin":2835.0,"ymin":518.0,"xmax":2884.0,"ymax":1461.0},{"id":3,"contenttext":"その裂目がかういふ裂目が出來たらかういふ御趣","xmin":2840.0,"ymin":1475.0,"xmax":2886.0,"ymax":2233.0},{"id":4,"contenttext":"意だ、","xmin":2771.0,"ymin":515.0,"xmax":2813.0,"ymax":606.0},{"id":5,"contenttext":"かういふ裂目が出來たらかういふのだ、","xmin":2768.0,"ymin":620.0,"xmax":2815.0,"ymax":1222.0},{"id":6,"contenttext":"といふことがチヤンと傳へてある。","xmin":2772.0,"ymin":1237.0,"xmax":2817.0,"ymax":1772.0},{"id":7,"contenttext":"「古語拾遺」","xmin":2776.0,"ymin":1796.0,"xmax":2820.0,"ymax":1983.0},{"id":8,"contenttext":"といふ本に","xmin":2776.0,"ymin":1990.0,"xmax":2818.0,"ymax":2168.0},{"id":9,"contenttext":"「上","xmin":2778.0,"ymin":2170.0,"xmax":2819.0,"ymax":2235.0},{"id":10,"contenttext":"み","xmin":2737.0,"ymin":1369.0,"xmax":2765.0,"ymax":1410.0},{"id":11,"contenttext":"古之世。","xmin":2704.0,"ymin":516.0,"xmax":2746.0,"ymax":640.0},{"id":12,"contenttext":"未有文字。","xmin":2704.0,"ymin":652.0,"xmax":2750.0,"ymax":850.0},{"id":13,"contenttext":"貴賤老少。","xmin":2703.0,"ymin":856.0,"xmax":2750.0,"ymax":1018.0},{"id":14,"contenttext":"口口相傳。","xmin":2705.0,"ymin":1031.0,"xmax":2747.0,"ymax":1186.0},{"id":15,"contenttext":"前言往行。","xmin":2704.0,"ymin":1197.0,"xmax":2750.0,"ymax":1359.0},{"id":16,"contenttext":"存而不忘。」","xmin":2707.0,"ymin":1371.0,"xmax":2749.0,"ymax":1572.0},{"id":17,"contenttext":"と書いてありますが、","xmin":2707.0,"ymin":1576.0,"xmax":2749.0,"ymax":1907.0},{"id":18,"contenttext":"どんな言葉でも貴踐","xmin":2709.0,"ymin":1919.0,"xmax":2751.0,"ymax":2233.0},{"id":19,"contenttext":"老少ロ々に相傳へて忘れないといふのであります。","xmin":2635.0,"ymin":515.0,"xmax":2681.0,"ymax":1292.0},{"id":20,"contenttext":"さういふ譯で、","xmin":2638.0,"ymin":1304.0,"xmax":2681.0,"ymax":1528.0},{"id":21,"contenttext":"かういふことがあつたからかう、","xmin":2638.0,"ymin":1543.0,"xmax":2683.0,"ymax":2042.0},{"id":22,"contenttext":"かうあつた","xmin":2640.0,"ymin":2059.0,"xmax":2684.0,"ymax":2235.0},{"id":23,"contenttext":"からかうといふいろ〓〓の場合がありますけれども、","xmin":2568.0,"ymin":516.0,"xmax":2614.0,"ymax":1321.0},{"id":24,"contenttext":"それは皆チヤンと傳つて居る。","xmin":2570.0,"ymin":1336.0,"xmax":2616.0,"ymax":1803.0},{"id":25,"contenttext":"それに依つて神樣の御心を","xmin":2571.0,"ymin":1817.0,"xmax":2617.0,"ymax":2235.0},{"id":26,"contenttext":"判斷する。","xmin":2497.0,"ymin":513.0,"xmax":2542.0,"ymax":673.0},{"id":27,"contenttext":"後になりますと鹿といふものは餘り居りませぬ。","xmin":2497.0,"ymin":682.0,"xmax":2542.0,"ymax":1422.0},{"id":28,"contenttext":"奥山に紅葉ふみわけ鳴く鹿の聲きく時ぞ秋はかなしき","xmin":2429.0,"ymin":617.0,"xmax":2471.0,"ymax":1442.0},{"id":29,"contenttext":"といふやうな歌があります。","xmin":2357.0,"ymin":518.0,"xmax":2404.0,"ymax":948.0},{"id":30,"contenttext":"今日はどこへ行つても奧山で鹿が鳴きませぬ。","xmin":2360.0,"ymin":959.0,"xmax":2404.0,"ymax":1666.0},{"id":31,"contenttext":"居ないのですから鳴きやうがありま","xmin":2362.0,"ymin":1680.0,"xmax":2406.0,"ymax":2231.0},{"id":32,"contenttext":"せぬ。","xmin":2288.0,"ymin":517.0,"xmax":2336.0,"ymax":609.0},{"id":33,"contenttext":"昔はそれが方々に澤山居つた。","xmin":2289.0,"ymin":617.0,"xmax":2335.0,"ymax":1086.0},{"id":34,"contenttext":"だから鹿を射つ弓矢を鹿兒弓、","xmin":2291.0,"ymin":1098.0,"xmax":2338.0,"ymax":1563.0},{"id":35,"contenttext":"鹿兒矢と言つて、","xmin":2293.0,"ymin":1576.0,"xmax":2337.0,"ymax":1837.0},{"id":36,"contenttext":"餘程大きな武器のやうに","xmin":2293.0,"ymin":1851.0,"xmax":2337.0,"ymax":2233.0},{"id":37,"contenttext":"傳へられて居ります。","xmin":2219.0,"ymin":514.0,"xmax":2266.0,"ymax":846.0},{"id":38,"contenttext":"兎に角後世になると鹿は少くなりました。","xmin":2223.0,"ymin":858.0,"xmax":2267.0,"ymax":1496.0},{"id":39,"contenttext":"そこで支那から龜トと言ひまして龜の甲で占ひ","xmin":2223.0,"ymin":1510.0,"xmax":2269.0,"ymax":2231.0},{"id":40,"contenttext":"をする法が傳つて來て、","xmin":2152.0,"ymin":516.0,"xmax":2198.0,"ymax":879.0},{"id":41,"contenttext":"神祇官のト部で使はれるやうになつた。","xmin":2152.0,"ymin":892.0,"xmax":2198.0,"ymax":1497.0},{"id":42,"contenttext":"それで神樣の御心を占ふやうになつた。","xmin":2153.0,"ymin":1509.0,"xmax":2202.0,"ymax":2119.0},{"id":43,"contenttext":"だから","xmin":2157.0,"ymin":2126.0,"xmax":2201.0,"ymax":2235.0},{"id":44,"contenttext":"神樣の御心を伺つてするのですから國民は實に正直です。","xmin":2081.0,"ymin":513.0,"xmax":2130.0,"ymax":1398.0},{"id":45,"contenttext":"今日は惡いことをする人間が往々ありますけれども、","xmin":2087.0,"ymin":1408.0,"xmax":2129.0,"ymax":2215.0},{"id":46,"contenttext":"昔はさういふ人間はない。","xmin":2013.0,"ymin":515.0,"xmax":2059.0,"ymax":916.0},{"id":47,"contenttext":"昔は泥棒をしたり、","xmin":2015.0,"ymin":925.0,"xmax":2060.0,"ymax":1223.0},{"id":48,"contenttext":"詐欺したり、","xmin":2015.0,"ymin":1234.0,"xmax":2060.0,"ymax":1431.0},{"id":49,"contenttext":"人を誤魔化したりするやうな者はない。","xmin":2016.0,"ymin":1442.0,"xmax":2062.0,"ymax":2048.0},{"id":50,"contenttext":"何となれば","xmin":2015.0,"ymin":2058.0,"xmax":2064.0,"ymax":2235.0},{"id":51,"contenttext":"始終神樣がそこらにお出でになつて照鑑あらせられるからであります。","xmin":1944.0,"ymin":516.0,"xmax":1990.0,"ymax":1600.0},{"id":52,"contenttext":"さう云ふ具合に敬虔の感情と云ふものが","xmin":1947.0,"ymin":1616.0,"xmax":1992.0,"ymax":2238.0},{"id":53,"contenttext":"上代國民に潜在的に滿ちて居つたのであります。","xmin":1875.0,"ymin":518.0,"xmax":1922.0,"ymax":1256.0},{"id":54,"contenttext":"第二には秩序の觀念でありますが、","xmin":1808.0,"ymin":550.0,"xmax":1854.0,"ymax":1087.0},{"id":55,"contenttext":"秩序の觀念と申しますと、","xmin":1810.0,"ymin":1100.0,"xmax":1856.0,"ymax":1502.0},{"id":56,"contenttext":"ものをキチンとする觀念です。","xmin":1812.0,"ymin":1512.0,"xmax":1857.0,"ymax":1981.0},{"id":57,"contenttext":"これが本來日本","xmin":1811.0,"ymin":1994.0,"xmax":1863.0,"ymax":2238.0},{"id":58,"contenttext":"ものをキチンとする觀念です。","xmin":1812.0,"ymin":1512.0,"xmax":1857.0,"ymax":1981.0},{"id":59,"contenttext":"これが本來日本","xmin":1811.0,"ymin":1994.0,"xmax":1863.0,"ymax":2238.0},{"id":60,"contenttext":"國民には非常に强い。","xmin":1586.0,"ymin":534.0,"xmax":1630.0,"ymax":865.0},{"id":61,"contenttext":"日々仕事をしましても仕事を終へた時には風呂に這入りませう。","xmin":1586.0,"ymin":879.0,"xmax":1630.0,"ymax":1857.0},{"id":62,"contenttext":"この風呂へ這入るといふ","xmin":1588.0,"ymin":1875.0,"xmax":1632.0,"ymax":2251.0},{"id":63,"contenttext":"いざなぎのみこさ","xmin":1553.0,"ymin":1768.0,"xmax":1581.0,"ymax":1909.0},{"id":64,"contenttext":"やうなことが日本國民の一つの特色であります。","xmin":1519.0,"ymin":536.0,"xmax":1563.0,"ymax":1274.0},{"id":65,"contenttext":"このことが上代からある。","xmin":1521.0,"ymin":1292.0,"xmax":1563.0,"ymax":1687.0},{"id":66,"contenttext":"昔、","xmin":1523.0,"ymin":1699.0,"xmax":1565.0,"ymax":1757.0},{"id":67,"contenttext":"伊邪那岐命が黃泉の國の穢れを","xmin":1521.0,"ymin":1765.0,"xmax":1567.0,"ymax":2254.0},{"id":68,"contenttext":"筑紫の小門の阿波岐原に於て譲ぎ遊ばしたといふことが傳つて居ります。","xmin":1443.0,"ymin":532.0,"xmax":1512.0,"ymax":1653.0},{"id":69,"contenttext":"これは詰り上代にさういふ風があつた","xmin":1450.0,"ymin":1669.0,"xmax":1499.0,"ymax":2256.0},{"id":70,"contenttext":"ことを示されて居るのであります。","xmin":1380.0,"ymin":539.0,"xmax":1424.0,"ymax":1068.0},{"id":71,"contenttext":"上代人は右のように正直でありましたから、體も綺麗にしますと同時に、精神","xmin":1380.0,"ymin":1082.0,"xmax":1426.0,"ymax":2256.0},{"id":72,"contenttext":"も綺麗にしました。","xmin":1315.0,"ymin":536.0,"xmax":1357.0,"ymax":830.0},{"id":73,"contenttext":"ですから我國には溫泉といふものが古代から非常に發達して居る。","xmin":1315.0,"ymin":844.0,"xmax":1357.0,"ymax":1861.0},{"id":74,"contenttext":"私昨年伊豫の道後の溫泉","xmin":1313.0,"ymin":1869.0,"xmax":1359.0,"ymax":2254.0},{"id":75,"contenttext":"す","xmin":1278.0,"ymin":1525.0,"xmax":1306.0,"ymax":1588.0},{"id":76,"contenttext":"ひ","xmin":1280.0,"ymin":1595.0,"xmax":1306.0,"ymax":1625.0},{"id":77,"contenttext":"なのかみ","xmin":1278.0,"ymin":1660.0,"xmax":1306.0,"ymax":1740.0},{"id":78,"contenttext":"に這入つて參りましたが、","xmin":1244.0,"ymin":538.0,"xmax":1290.0,"ymax":934.0},{"id":79,"contenttext":"傳へるところに依ると、","xmin":1244.0,"ymin":944.0,"xmax":1288.0,"ymax":1309.0},{"id":80,"contenttext":"道後の溫泉は少名民古那神が御創めになつたといふことであ","xmin":1243.0,"ymin":1320.0,"xmax":1293.0,"ymax":2254.0},{"id":81,"contenttext":"び","xmin":1207.0,"ymin":737.0,"xmax":1237.0,"ymax":768.0},{"id":82,"contenttext":"おほくにぬしのかみ","xmin":1207.0,"ymin":1394.0,"xmax":1235.0,"ymax":1560.0},{"id":83,"contenttext":"ります。","xmin":1177.0,"ymin":536.0,"xmax":1216.0,"ymax":659.0},{"id":84,"contenttext":"少名毘古那神といふのは出雲大社に祭つてある大國主神と御兄弟に御なり遊ばして、","xmin":1173.0,"ymin":670.0,"xmax":1223.0,"ymax":1962.0},{"id":85,"contenttext":"この大八洲を御經","xmin":1176.0,"ymin":1976.0,"xmax":1221.0,"ymax":2252.0},{"id":86,"contenttext":"營なさつた御方です。","xmin":1102.0,"ymin":534.0,"xmax":1151.0,"ymax":866.0},{"id":87,"contenttext":"勿論神代でありますが、","xmin":1105.0,"ymin":876.0,"xmax":1151.0,"ymax":1243.0},{"id":88,"contenttext":"その頃旣に伊豫の道後の溫泉を御開きになつたといふのでありま","xmin":1105.0,"ymin":1251.0,"xmax":1151.0,"ymax":2252.0},{"id":89,"contenttext":"す。","xmin":1036.0,"ymin":536.0,"xmax":1077.0,"ymax":592.0},{"id":90,"contenttext":"さう云ふ風に、","xmin":1033.0,"ymin":605.0,"xmax":1079.0,"ymax":830.0},{"id":91,"contenttext":"我國には溫泉といふものが非常に大昔から發達して居ることはいろ〓〓な事實に依つて、","xmin":1031.0,"ymin":841.0,"xmax":1082.0,"ymax":2203.0},{"id":92,"contenttext":"認","xmin":1033.0,"ymin":2210.0,"xmax":1079.0,"ymax":2254.0},{"id":93,"contenttext":"めることが出來ます。","xmin":961.0,"ymin":534.0,"xmax":1003.0,"ymax":863.0},{"id":94,"contenttext":"この前でありましたが、","xmin":960.0,"ymin":878.0,"xmax":1006.0,"ymax":1239.0},{"id":95,"contenttext":"私が但馬の方へ行きましたら、","xmin":961.0,"ymin":1251.0,"xmax":1005.0,"ymax":1720.0},{"id":96,"contenttext":"三朝溫泉といふのはラジウムも餘","xmin":961.0,"ymin":1732.0,"xmax":1005.0,"ymax":2251.0},{"id":97,"contenttext":"程出るといふ話でありましたが、","xmin":890.0,"ymin":534.0,"xmax":937.0,"ymax":1035.0},{"id":98,"contenttext":"その附近の講習會に行きましたので、","xmin":892.0,"ymin":1047.0,"xmax":938.0,"ymax":1616.0},{"id":99,"contenttext":"その溫泉に一度這入つて置きたいと申し","xmin":894.0,"ymin":1629.0,"xmax":938.0,"ymax":2251.0},{"id":100,"contenttext":"まして、","xmin":823.0,"ymin":532.0,"xmax":863.0,"ymax":656.0},{"id":101,"contenttext":"そこへ連れて行つて貰ひました。","xmin":823.0,"ymin":668.0,"xmax":869.0,"ymax":1172.0},{"id":102,"contenttext":"そこへ行きますと、","xmin":823.0,"ymin":1183.0,"xmax":865.0,"ymax":1475.0},{"id":103,"contenttext":"溫泉宿は相當ありますが、","xmin":825.0,"ymin":1489.0,"xmax":867.0,"ymax":1889.0},{"id":104,"contenttext":"そこに川がありまして","xmin":825.0,"ymin":1900.0,"xmax":867.0,"ymax":2245.0},{"id":105,"contenttext":"その川の中で溫泉が出る。","xmin":755.0,"ymin":534.0,"xmax":803.0,"ymax":933.0},{"id":106,"contenttext":"それを附近の人は皆川の中で溫泉に這入つて居る。","xmin":757.0,"ymin":944.0,"xmax":804.0,"ymax":1719.0},{"id":107,"contenttext":"屋根も何にもない、","xmin":760.0,"ymin":1729.0,"xmax":800.0,"ymax":2025.0},{"id":108,"contenttext":"私はそれを見","xmin":760.0,"ymin":2037.0,"xmax":802.0,"ymax":2249.0},{"id":109,"contenttext":"てこれは太古の風があるなと思ひました。","xmin":687.0,"ymin":536.0,"xmax":735.0,"ymax":1172.0},{"id":110,"contenttext":"熱海などゝといふところは、","xmin":691.0,"ymin":1179.0,"xmax":733.0,"ymax":1613.0},{"id":111,"contenttext":"海の中に湯の出る所がある。","xmin":688.0,"ymin":1625.0,"xmax":738.0,"ymax":2062.0},{"id":112,"contenttext":"それで熱海","xmin":691.0,"ymin":2071.0,"xmax":735.0,"ymax":2251.0},{"id":113,"contenttext":"といふ名が出たといふのでありますが、","xmin":619.0,"ymin":532.0,"xmax":664.0,"ymax":1135.0},{"id":114,"contenttext":"さういふのは矢張り大昔の風習から海岸へ行つて砂で風呂を拵へて這入","xmin":618.0,"ymin":1147.0,"xmax":668.0,"ymax":2249.0},{"id":115,"contenttext":"る。","xmin":555.0,"ymin":534.0,"xmax":594.0,"ymax":589.0},{"id":116,"contenttext":"これは極めて簡單なのです。","xmin":548.0,"ymin":601.0,"xmax":598.0,"ymax":1037.0},{"id":117,"contenttext":"どんな人でも出來る。","xmin":552.0,"ymin":1042.0,"xmax":594.0,"ymax":1373.0},{"id":118,"contenttext":"子供でも出來る譯です。","xmin":553.0,"ymin":1385.0,"xmax":597.0,"ymax":1752.0},{"id":119,"contenttext":"さういふ具合に入浴しまして體","xmin":552.0,"ymin":1764.0,"xmax":596.0,"ymax":2247.0},{"id":120,"contenttext":"皇國傳統の精神","xmin":486.0,"ymin":709.0,"xmax":525.0,"ymax":925.0},{"id":121,"contenttext":"九","xmin":492.0,"ymin":2164.0,"xmax":523.0,"ymax":2191.0}]