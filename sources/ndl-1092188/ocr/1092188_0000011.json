[{"id":0,"contenttext":"六","xmin":2905.0,"ymin":2224.0,"xmax":2940.0,"ymax":2260.0},{"id":1,"contenttext":"皇國傳統の精神","xmin":2907.0,"ymin":777.0,"xmax":2949.0,"ymax":993.0},{"id":2,"contenttext":"實現しなければならぬ。","xmin":2841.0,"ymin":596.0,"xmax":2887.0,"ymax":964.0},{"id":3,"contenttext":"さういふことを考へて食べない人が多いのですから、","xmin":2837.0,"ymin":974.0,"xmax":2888.0,"ymax":1786.0},{"id":4,"contenttext":"我が日本邊りには胃病患者が非常","xmin":2833.0,"ymin":1796.0,"xmax":2882.0,"ymax":2318.0},{"id":5,"contenttext":"に多いといふのです。","xmin":2771.0,"ymin":599.0,"xmax":2816.0,"ymax":925.0},{"id":6,"contenttext":"(笑聲)","xmin":2772.0,"ymin":934.0,"xmax":2816.0,"ymax":1050.0},{"id":7,"contenttext":"胃病患者が世界第一だといふことでありますが、","xmin":2767.0,"ymin":1075.0,"xmax":2818.0,"ymax":1817.0},{"id":8,"contenttext":"これは矢張り生きんが爲に食ふ","xmin":2763.0,"ymin":1833.0,"xmax":2812.0,"ymax":2316.0},{"id":9,"contenttext":"のだといふことを忘れて居るからでせう。","xmin":2702.0,"ymin":599.0,"xmax":2746.0,"ymax":1236.0},{"id":10,"contenttext":"さういふ譯で食べるといふことを自覺して食べると食べないとは大變","xmin":2694.0,"ymin":1248.0,"xmax":2746.0,"ymax":2316.0},{"id":11,"contenttext":"違ひます。","xmin":2637.0,"ymin":594.0,"xmax":2677.0,"ymax":753.0},{"id":12,"contenttext":"殊に食べるのにはどういふものが榮養になつて、","xmin":2631.0,"ymin":766.0,"xmax":2680.0,"ymax":1509.0},{"id":13,"contenttext":"どういふものが不消化物であるといふやうなこと、","xmin":2625.0,"ymin":1519.0,"xmax":2678.0,"ymax":2295.0},{"id":14,"contenttext":"例へば體飩一杯は牛乳一合よりも餘計の榮養があるといふことを若し知つて居りますならば、","xmin":2562.0,"ymin":594.0,"xmax":2611.0,"ymax":2020.0},{"id":15,"contenttext":"牛乳一合飮むより","xmin":2561.0,"ymin":2034.0,"xmax":2603.0,"ymax":2312.0},{"id":16,"contenttext":"かも饂飩一杯食べる。","xmin":2497.0,"ymin":595.0,"xmax":2544.0,"ymax":922.0},{"id":17,"contenttext":"牛乳二合飮むよりも體飩二杯食べる。","xmin":2497.0,"ymin":935.0,"xmax":2542.0,"ymax":1506.0},{"id":18,"contenttext":"お晝の代りになる。","xmin":2496.0,"ymin":1521.0,"xmax":2540.0,"ymax":1815.0},{"id":19,"contenttext":"牛乳二合飮んでもお腹に應へな","xmin":2493.0,"ymin":1826.0,"xmax":2537.0,"ymax":2313.0},{"id":20,"contenttext":"い。","xmin":2434.0,"ymin":599.0,"xmax":2471.0,"ymax":649.0},{"id":21,"contenttext":"さういふやうに知つて食べると食べないでは一生の間に大變違ひがある。","xmin":2425.0,"ymin":663.0,"xmax":2478.0,"ymax":1782.0},{"id":22,"contenttext":"今申した如く、","xmin":2362.0,"ymin":627.0,"xmax":2403.0,"ymax":852.0},{"id":23,"contenttext":"日本國民がこの皇國傳統の精神を以てずつと進んで行くのでありますけれども、","xmin":2352.0,"ymin":867.0,"xmax":2408.0,"ymax":2091.0},{"id":24,"contenttext":"この精神の如","xmin":2353.0,"ymin":2106.0,"xmax":2397.0,"ymax":2312.0},{"id":25,"contenttext":"何なるものであるかといふことを自覺して居るのと、","xmin":2289.0,"ymin":592.0,"xmax":2337.0,"ymax":1400.0},{"id":26,"contenttext":"自覺して居ないのとは一生の中に非常な相違がある。","xmin":2284.0,"ymin":1415.0,"xmax":2333.0,"ymax":2228.0},{"id":27,"contenttext":"それ","xmin":2284.0,"ymin":2240.0,"xmax":2328.0,"ymax":2314.0},{"id":28,"contenttext":"を自覺しない爲に邪路に迷つて一生を誤るといふ人間がある。","xmin":2218.0,"ymin":594.0,"xmax":2272.0,"ymax":1540.0},{"id":29,"contenttext":"併し人間には潜在的にその傳統の精神によつて進","xmin":2215.0,"ymin":1551.0,"xmax":2266.0,"ymax":2314.0},{"id":30,"contenttext":"んで行かうといふ考があるのです。","xmin":2156.0,"ymin":592.0,"xmax":2200.0,"ymax":1126.0},{"id":31,"contenttext":"ところがその道が分らない。","xmin":2152.0,"ymin":1139.0,"xmax":2196.0,"ymax":1569.0},{"id":32,"contenttext":"一體世の中には先生といふものがある。","xmin":2147.0,"ymin":1595.0,"xmax":2195.0,"ymax":2188.0},{"id":33,"contenttext":"學問は","xmin":2145.0,"ymin":2202.0,"xmax":2190.0,"ymax":2311.0},{"id":34,"contenttext":"勿論のこと、碁を打つても、將棋を指しても、擊劍をやつても、柔道をやつても、","xmin":2082.0,"ymin":590.0,"xmax":2134.0,"ymax":1779.0},{"id":35,"contenttext":"皆先生といふものがあります。","xmin":2078.0,"ymin":1789.0,"xmax":2126.0,"ymax":2261.0},{"id":36,"contenttext":"吾","xmin":2080.0,"ymin":2268.0,"xmax":2122.0,"ymax":2312.0},{"id":37,"contenttext":"々はその先生を尊敬してその先生の〓へに從つてやりましたならば、その道に上達するのであります。","xmin":2009.0,"ymin":596.0,"xmax":2066.0,"ymax":2140.0},{"id":38,"contenttext":"ところで、","xmin":2011.0,"ymin":2152.0,"xmax":2052.0,"ymax":2311.0},{"id":39,"contenttext":"かういふ將棋といふやうなものは、","xmin":1949.0,"ymin":594.0,"xmax":1995.0,"ymax":1126.0},{"id":40,"contenttext":"それをする人だけ、","xmin":1949.0,"ymin":1140.0,"xmax":1992.0,"ymax":1435.0},{"id":41,"contenttext":"擊劍、","xmin":1949.0,"ymin":1447.0,"xmax":1992.0,"ymax":1538.0},{"id":42,"contenttext":"柔道といふやうなものは、","xmin":1944.0,"ymin":1549.0,"xmax":1990.0,"ymax":1951.0},{"id":43,"contenttext":"それをする人だけがそ","xmin":1941.0,"ymin":1963.0,"xmax":1987.0,"ymax":2311.0},{"id":44,"contenttext":"の先生を尊重する。","xmin":1882.0,"ymin":594.0,"xmax":1926.0,"ymax":882.0},{"id":45,"contenttext":"碁を打たない人は基の大先生を見ても、「あれが本因坊か」","xmin":1874.0,"ymin":895.0,"xmax":1925.0,"ymax":1784.0},{"id":46,"contenttext":"と言つても一向尊敬の念は起らな","xmin":1870.0,"ymin":1790.0,"xmax":1920.0,"ymax":2311.0},{"id":47,"contenttext":"い、「あれは本因坊か、","xmin":1808.0,"ymin":593.0,"xmax":1859.0,"ymax":918.0},{"id":48,"contenttext":"何だか肺病のやうぢやないか」なんといふやうな失敬なことをも云ふ。","xmin":1802.0,"ymin":930.0,"xmax":1853.0,"ymax":2017.0},{"id":49,"contenttext":"(笑聲)","xmin":1803.0,"ymin":2027.0,"xmax":1847.0,"ymax":2143.0},{"id":50,"contenttext":"で、","xmin":1801.0,"ymin":2168.0,"xmax":1844.0,"ymax":2224.0},{"id":51,"contenttext":"一向","xmin":1803.0,"ymin":2238.0,"xmax":1842.0,"ymax":2309.0},{"id":52,"contenttext":"尊敬の念が起らないが、","xmin":1593.0,"ymin":618.0,"xmax":1643.0,"ymax":983.0},{"id":53,"contenttext":"恭を打つ人には實に神樣のやうになる。","xmin":1593.0,"ymin":992.0,"xmax":1640.0,"ymax":1599.0},{"id":54,"contenttext":"ところがこの皇國傳統の精神、","xmin":1593.0,"ymin":1613.0,"xmax":1636.0,"ymax":2078.0},{"id":55,"contenttext":"かういふもの","xmin":1593.0,"ymin":2092.0,"xmax":1634.0,"ymax":2300.0},{"id":56,"contenttext":"は日本國民の悉く體現しようといふ精神でありますから、","xmin":1526.0,"ymin":585.0,"xmax":1573.0,"ymax":1461.0},{"id":57,"contenttext":"その精神の偉大なる御方は、","xmin":1524.0,"ymin":1473.0,"xmax":1572.0,"ymax":1909.0},{"id":58,"contenttext":"日本國民が悉くこれを崇","xmin":1525.0,"ymin":1921.0,"xmax":1569.0,"ymax":2305.0},{"id":59,"contenttext":"敬することになる。","xmin":1461.0,"ymin":582.0,"xmax":1503.0,"ymax":878.0},{"id":60,"contenttext":"日本國民が一人殘らず尊敬するさう云ふ御方はどういふ御方であるかといふと、","xmin":1455.0,"ymin":892.0,"xmax":1503.0,"ymax":2112.0},{"id":61,"contenttext":"それは神樣","xmin":1456.0,"ymin":2126.0,"xmax":1502.0,"ymax":2304.0},{"id":62,"contenttext":"として祭らるゝ御方であります。","xmin":1392.0,"ymin":583.0,"xmax":1435.0,"ymax":1082.0},{"id":63,"contenttext":"伊勢に御祭りしてあります天照大御神樣、","xmin":1389.0,"ymin":1093.0,"xmax":1431.0,"ymax":1732.0},{"id":64,"contenttext":"或は橿原神宮の神武天皇樣、","xmin":1386.0,"ymin":1745.0,"xmax":1433.0,"ymax":2182.0},{"id":65,"contenttext":"或は八","xmin":1387.0,"ymin":2193.0,"xmax":1431.0,"ymax":2300.0},{"id":66,"contenttext":"幡宮の應神天皇樣、","xmin":1322.0,"ymin":579.0,"xmax":1371.0,"ymax":878.0},{"id":67,"contenttext":"かういふやうな歷代の天皇樣、","xmin":1322.0,"ymin":890.0,"xmax":1368.0,"ymax":1357.0},{"id":68,"contenttext":"或は談山神社に御祭りしてある藤原鎌足公、","xmin":1318.0,"ymin":1371.0,"xmax":1366.0,"ymax":2045.0},{"id":69,"contenttext":"或は護王神社に","xmin":1318.0,"ymin":2053.0,"xmax":1364.0,"ymax":2298.0},{"id":70,"contenttext":"御祭りしてある和氣〓麿公、","xmin":1253.0,"ymin":581.0,"xmax":1302.0,"ymax":1014.0},{"id":71,"contenttext":"或は天滿宮に御祭りしてある菅原道實公、","xmin":1248.0,"ymin":1024.0,"xmax":1299.0,"ymax":1664.0},{"id":72,"contenttext":"或は湊川神社に御祭りしてある楠木正成","xmin":1248.0,"ymin":1678.0,"xmax":1296.0,"ymax":2302.0},{"id":73,"contenttext":"소、","xmin":1186.0,"ymin":578.0,"xmax":1228.0,"ymax":634.0},{"id":74,"contenttext":"かういふ御方は皇國精神の偉大なる體現者であらせられるのであります。","xmin":1180.0,"ymin":648.0,"xmax":1229.0,"ymax":1765.0},{"id":75,"contenttext":"吾々國民は悉くそれを崇敬して、","xmin":1179.0,"ymin":1778.0,"xmax":1225.0,"ymax":2282.0},{"id":76,"contenttext":"その偉大なる大精神を吾々が體現して實踐して行かうといふのであります。","xmin":1111.0,"ymin":581.0,"xmax":1161.0,"ymax":1734.0},{"id":77,"contenttext":"日本國民の神樣として祭りますのは","xmin":1108.0,"ymin":1745.0,"xmax":1157.0,"ymax":2299.0},{"id":78,"contenttext":"さういふ御方であります。","xmin":1049.0,"ymin":578.0,"xmax":1091.0,"ymax":975.0},{"id":79,"contenttext":"さういふ御方を皆神社に御祭りする。","xmin":1045.0,"ymin":991.0,"xmax":1089.0,"ymax":1558.0},{"id":80,"contenttext":"その神樣は詰り祖先の神樣で、","xmin":1042.0,"ymin":1570.0,"xmax":1090.0,"ymax":2039.0},{"id":81,"contenttext":"その祖先の神樣","xmin":1042.0,"ymin":2052.0,"xmax":1087.0,"ymax":2298.0},{"id":82,"contenttext":"が我國に於いては總てのものゝ主宰神としてお祭りしてあるのであります。","xmin":975.0,"ymin":578.0,"xmax":1025.0,"ymax":1727.0},{"id":83,"contenttext":"山があれば山に山の神樣、","xmin":975.0,"ymin":1740.0,"xmax":1019.0,"ymax":2143.0},{"id":84,"contenttext":"或は川が","xmin":975.0,"ymin":2151.0,"xmax":1021.0,"ymax":2297.0},{"id":85,"contenttext":"あれば川に川の神樣、","xmin":915.0,"ymin":578.0,"xmax":959.0,"ymax":906.0},{"id":86,"contenttext":"總てのものにさういふ神靈がお出でになる。","xmin":911.0,"ymin":916.0,"xmax":955.0,"ymax":1588.0},{"id":87,"contenttext":"さういふ神靈を御祭りするのに、","xmin":908.0,"ymin":1604.0,"xmax":955.0,"ymax":2105.0},{"id":88,"contenttext":"上代には、","xmin":908.0,"ymin":2117.0,"xmax":953.0,"ymax":2279.0},{"id":89,"contenttext":"神籬、","xmin":846.0,"ymin":573.0,"xmax":889.0,"ymax":668.0},{"id":90,"contenttext":"む骨","xmin":878.0,"ymin":590.0,"xmax":904.0,"ymax":650.0},{"id":91,"contenttext":"繁境と申すものを用ひます。","xmin":842.0,"ymin":676.0,"xmax":905.0,"ymax":1113.0},{"id":92,"contenttext":"神籬といふのはいろ〓〓說がございますけれども、","xmin":837.0,"ymin":1119.0,"xmax":889.0,"ymax":1897.0},{"id":93,"contenttext":"兎に角、","xmin":839.0,"ymin":1911.0,"xmax":885.0,"ymax":2036.0},{"id":94,"contenttext":"ヒとミとは通ず","xmin":835.0,"ymin":2053.0,"xmax":884.0,"ymax":2296.0},{"id":95,"contenttext":"るのであります。","xmin":776.0,"ymin":576.0,"xmax":818.0,"ymax":834.0},{"id":96,"contenttext":"Bre","xmin":807.0,"ymin":846.0,"xmax":834.0,"ymax":908.0},{"id":97,"contenttext":"神室或は御室、","xmin":772.0,"ymin":845.0,"xmax":821.0,"ymax":1076.0},{"id":98,"contenttext":"詰り室であります。","xmin":774.0,"ymin":1087.0,"xmax":816.0,"ymax":1384.0},{"id":99,"contenttext":"堂といふのは今日では望と申します。","xmin":759.0,"ymin":1395.0,"xmax":831.0,"ymax":1968.0},{"id":100,"contenttext":"昔神樣のお出でにな","xmin":768.0,"ymin":1978.0,"xmax":814.0,"ymax":2295.0},{"id":101,"contenttext":"つたところは奥まつたところでありますから室であります。","xmin":702.0,"ymin":578.0,"xmax":749.0,"ymax":1486.0},{"id":102,"contenttext":"須佐之男命が八田間大宝にお出でになつたといふこ","xmin":696.0,"ymin":1496.0,"xmax":763.0,"ymax":2293.0},{"id":103,"contenttext":"u","xmin":672.0,"ymin":1018.0,"xmax":694.0,"ymax":1042.0},{"id":104,"contenttext":"とが書いてありますが、","xmin":638.0,"ymin":575.0,"xmax":680.0,"ymax":938.0},{"id":105,"contenttext":"その室は或は森であります。","xmin":636.0,"ymin":948.0,"xmax":679.0,"ymax":1380.0},{"id":106,"contenttext":"これは皆通ずるのであります。","xmin":633.0,"ymin":1398.0,"xmax":675.0,"ymax":1863.0},{"id":107,"contenttext":"森といふのは今日でも鎮守","xmin":630.0,"ymin":1872.0,"xmax":673.0,"ymax":2289.0},{"id":108,"contenttext":":","xmin":594.0,"ymin":2163.0,"xmax":618.0,"ymax":2206.0},{"id":109,"contenttext":"の森と申しますが、","xmin":569.0,"ymin":574.0,"xmax":614.0,"ymax":864.0},{"id":110,"contenttext":"總て樹のこんもりしたところです。","xmin":566.0,"ymin":878.0,"xmax":612.0,"ymax":1415.0},{"id":111,"contenttext":"一本の樹でも之を神離と申しました。","xmin":564.0,"ymin":1435.0,"xmax":609.0,"ymax":1997.0},{"id":112,"contenttext":"その樹は榮樹と申","xmin":562.0,"ymin":2011.0,"xmax":605.0,"ymax":2289.0},{"id":113,"contenttext":"皇國傳統の精神","xmin":504.0,"ymin":749.0,"xmax":543.0,"ymax":964.0},{"id":114,"contenttext":"モ","xmin":497.0,"ymin":2198.0,"xmax":532.0,"ymax":2233.0}]