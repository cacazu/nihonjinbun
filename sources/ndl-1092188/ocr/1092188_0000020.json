[{"id":0,"contenttext":"皇國傳統の精神","xmin":2938.0,"ymin":753.0,"xmax":2977.0,"ymax":969.0},{"id":1,"contenttext":"ニ","xmin":2933.0,"ymin":2198.0,"xmax":2963.0,"ymax":2235.0},{"id":2,"contenttext":"テ","xmin":2900.0,"ymin":1261.0,"xmax":2927.0,"ymax":1318.0},{"id":3,"contenttext":":","xmin":2901.0,"ymin":1830.0,"xmax":2917.0,"ymax":1867.0},{"id":4,"contenttext":"子游問孝","xmin":2873.0,"ymin":642.0,"xmax":2917.0,"ymax":807.0},{"id":5,"contenttext":"',","xmin":2887.0,"ymin":793.0,"xmax":2923.0,"ymax":822.0},{"id":6,"contenttext":"子日、","xmin":2869.0,"ymin":830.0,"xmax":2913.0,"ymax":921.0},{"id":7,"contenttext":"今之孝者是謂能養。","xmin":2866.0,"ymin":932.0,"xmax":2914.0,"ymax":1252.0},{"id":8,"contenttext":"至於","xmin":2868.0,"ymin":1257.0,"xmax":2908.0,"ymax":1368.0},{"id":9,"contenttext":"犬馬、","xmin":2866.0,"ymin":1377.0,"xmax":2912.0,"ymax":1472.0},{"id":10,"contenttext":"皆能有養。","xmin":2864.0,"ymin":1480.0,"xmax":2910.0,"ymax":1662.0},{"id":11,"contenttext":"不敬何以別乎。","xmin":2862.0,"ymin":1667.0,"xmax":2908.0,"ymax":1915.0},{"id":12,"contenttext":"孝行といふことは大事であるが、","xmin":2800.0,"ymin":606.0,"xmax":2849.0,"ymax":1106.0},{"id":13,"contenttext":"その孝行といふのはどういふのであるかと子游が聞きましたら、","xmin":2794.0,"ymin":1119.0,"xmax":2844.0,"ymax":2101.0},{"id":14,"contenttext":"今の孝は能","xmin":2794.0,"ymin":2113.0,"xmax":2836.0,"ymax":2291.0},{"id":15,"contenttext":"くお父さんやお母さんを養つて上げるのを孝と謂ふが、","xmin":2731.0,"ymin":571.0,"xmax":2782.0,"ymax":1416.0},{"id":16,"contenttext":"犬馬に至る迄能く養ふのである。","xmin":2727.0,"ymin":1427.0,"xmax":2777.0,"ymax":1932.0},{"id":17,"contenttext":"尊敬しなければ人間の","xmin":2723.0,"ymin":1940.0,"xmax":2773.0,"ymax":2291.0},{"id":18,"contenttext":"孝行にならぬではないか。","xmin":2666.0,"ymin":569.0,"xmax":2713.0,"ymax":970.0},{"id":19,"contenttext":"に","xmin":2628.0,"ymin":1013.0,"xmax":2656.0,"ymax":1056.0},{"id":20,"contenttext":"一八","xmin":2626.0,"ymin":1324.0,"xmax":2653.0,"ymax":1364.0},{"id":21,"contenttext":"子夏問孝。","xmin":2601.0,"ymin":638.0,"xmax":2646.0,"ymax":815.0},{"id":22,"contenttext":"子曰色難。","xmin":2596.0,"ymin":826.0,"xmax":2644.0,"ymax":989.0},{"id":23,"contenttext":"有事弟子服其勞、","xmin":2594.0,"ymin":998.0,"xmax":2640.0,"ymax":1301.0},{"id":24,"contenttext":"有酒色先生饌、","xmin":2593.0,"ymin":1304.0,"xmax":2638.0,"ymax":1570.0},{"id":25,"contenttext":"會是以爲孝乎。","xmin":2591.0,"ymin":1581.0,"xmax":2635.0,"ymax":1826.0},{"id":26,"contenttext":"子夏といふのが孝を聞いたら、","xmin":2528.0,"ymin":602.0,"xmax":2579.0,"ymax":1072.0},{"id":27,"contenttext":"色が難し、","xmin":2529.0,"ymin":1084.0,"xmax":2573.0,"ymax":1243.0},{"id":28,"contenttext":"詰り父母に對して色を和げるといふことが困難だ。","xmin":2519.0,"ymin":1255.0,"xmax":2571.0,"ymax":2032.0},{"id":29,"contenttext":"子夏といふ人は","xmin":2519.0,"ymin":2042.0,"xmax":2564.0,"ymax":2288.0},{"id":30,"contenttext":"怒りつぼい人だ。","xmin":2460.0,"ymin":571.0,"xmax":2510.0,"ymax":835.0},{"id":31,"contenttext":"それで孔子がさう言つて〓へられた。","xmin":2454.0,"ymin":846.0,"xmax":2508.0,"ymax":1417.0},{"id":32,"contenttext":"どうも父母に對して始終色を和げて置かなければなら","xmin":2445.0,"ymin":1427.0,"xmax":2502.0,"ymax":2290.0},{"id":33,"contenttext":"ぬ","xmin":2397.0,"ymin":573.0,"xmax":2438.0,"ymax":624.0},{"id":34,"contenttext":"何か仕事があるからというてお父さんやお母さんに孝行する。","xmin":2383.0,"ymin":638.0,"xmax":2440.0,"ymax":1588.0},{"id":35,"contenttext":"御馳走があるからというてそれをお父さんや","xmin":2377.0,"ymin":1596.0,"xmax":2431.0,"ymax":2292.0},{"id":36,"contenttext":"お母さんに上げる。","xmin":2322.0,"ymin":569.0,"xmax":2372.0,"ymax":864.0},{"id":37,"contenttext":"それだけで孝行と言へるか、","xmin":2316.0,"ymin":877.0,"xmax":2368.0,"ymax":1312.0},{"id":38,"contenttext":"色が困難だ。","xmin":2318.0,"ymin":1320.0,"xmax":2362.0,"ymax":1516.0},{"id":39,"contenttext":"それから又孝のところに、","xmin":2309.0,"ymin":1528.0,"xmax":2359.0,"ymax":1925.0},{"id":40,"contenttext":"孟武伯間孝。","xmin":2253.0,"ymin":636.0,"xmax":2300.0,"ymax":843.0},{"id":41,"contenttext":"子曰、","xmin":2252.0,"ymin":855.0,"xmax":2311.0,"ymax":954.0},{"id":42,"contenttext":"父母唯其疾之愛。","xmin":2247.0,"ymin":957.0,"xmax":2310.0,"ymax":1241.0},{"id":43,"contenttext":"かういふやうなお言葉がある。","xmin":2185.0,"ymin":567.0,"xmax":2230.0,"ymax":1033.0},{"id":44,"contenttext":"或は又、","xmin":2184.0,"ymin":1045.0,"xmax":2228.0,"ymax":1170.0},{"id":45,"contenttext":";","xmin":2147.0,"ymin":1266.0,"xmax":2173.0,"ymax":1309.0},{"id":46,"contenttext":"バ","xmin":2143.0,"ymin":2106.0,"xmax":2163.0,"ymax":2148.0},{"id":47,"contenttext":"孟懿子問孝。","xmin":2119.0,"ymin":636.0,"xmax":2168.0,"ymax":847.0},{"id":48,"contenttext":"子日、","xmin":2119.0,"ymin":858.0,"xmax":2163.0,"ymax":949.0},{"id":49,"contenttext":"無違。","xmin":2119.0,"ymin":962.0,"xmax":2161.0,"ymax":1072.0},{"id":50,"contenttext":"樊遲御。","xmin":2117.0,"ymin":1080.0,"xmax":2161.0,"ymax":1207.0},{"id":51,"contenttext":"子〓之曰、","xmin":2115.0,"ymin":1218.0,"xmax":2159.0,"ymax":1396.0},{"id":52,"contenttext":"孟孫問孝於我。","xmin":2113.0,"ymin":1406.0,"xmax":2157.0,"ymax":1659.0},{"id":53,"contenttext":"我對曰。","xmin":2111.0,"ymin":1662.0,"xmax":2156.0,"ymax":1792.0},{"id":54,"contenttext":"無違。","xmin":2110.0,"ymin":1801.0,"xmax":2152.0,"ymax":1905.0},{"id":55,"contenttext":"樊遲日、","xmin":2110.0,"ymin":1918.0,"xmax":2154.0,"ymax":2046.0},{"id":56,"contenttext":"何謂也。","xmin":2110.0,"ymin":2059.0,"xmax":2152.0,"ymax":2187.0},{"id":57,"contenttext":"子日。","xmin":2103.0,"ymin":2190.0,"xmax":2152.0,"ymax":2289.0},{"id":58,"contenttext":"1","xmin":2085.0,"ymin":701.0,"xmax":2113.0,"ymax":760.0},{"id":59,"contenttext":"a","xmin":2087.0,"ymin":770.0,"xmax":2108.0,"ymax":811.0},{"id":60,"contenttext":"ニ","xmin":2087.0,"ymin":894.0,"xmax":2108.0,"ymax":931.0},{"id":61,"contenttext":",","xmin":2087.0,"ymin":985.0,"xmax":2106.0,"ymax":1008.0},{"id":62,"contenttext":";","xmin":2085.0,"ymin":1010.0,"xmax":2106.0,"ymax":1052.0},{"id":63,"contenttext":"ご","xmin":2082.0,"ymin":1220.0,"xmax":2106.0,"ymax":1258.0},{"id":64,"contenttext":"生事之以禮、","xmin":2053.0,"ymin":634.0,"xmax":2096.0,"ymax":860.0},{"id":65,"contenttext":"死葬之以禮、","xmin":2048.0,"ymin":874.0,"xmax":2096.0,"ymax":1102.0},{"id":66,"contenttext":"祭之以禮。","xmin":2050.0,"ymin":1112.0,"xmax":2092.0,"ymax":1308.0},{"id":67,"contenttext":"孟懿子といふのが孝行のことを聞いたら、","xmin":1977.0,"ymin":601.0,"xmax":2031.0,"ymax":1240.0},{"id":68,"contenttext":"孔子の言ふのには違ふことなかれ、","xmin":1973.0,"ymin":1251.0,"xmax":2024.0,"ymax":1789.0},{"id":69,"contenttext":"孟懿子といふのは直ぐそれで下","xmin":1967.0,"ymin":1801.0,"xmax":2019.0,"ymax":2286.0},{"id":70,"contenttext":"つて終つたところが孔夫子はもつと說明してやらうと思ひましたけれども、","xmin":1904.0,"ymin":571.0,"xmax":1962.0,"ymax":1720.0},{"id":71,"contenttext":"下つて終つたから仕方がない。","xmin":1900.0,"ymin":1729.0,"xmax":1951.0,"ymax":2209.0},{"id":72,"contenttext":"外へ","xmin":1902.0,"ymin":2208.0,"xmax":1946.0,"ymax":2282.0},{"id":73,"contenttext":"お出でになると、","xmin":1845.0,"ymin":569.0,"xmax":1888.0,"ymax":828.0},{"id":74,"contenttext":"葵遲といふ門人が取者になつて孔子を乘せて行つた。","xmin":1834.0,"ymin":839.0,"xmax":1890.0,"ymax":1652.0},{"id":75,"contenttext":"そこで孔子が車の中から、","xmin":1830.0,"ymin":1663.0,"xmax":1885.0,"ymax":2065.0},{"id":76,"contenttext":"樊遲に向つて","xmin":1832.0,"ymin":2074.0,"xmax":1877.0,"ymax":2284.0},{"id":77,"contenttext":"ニ","xmin":2933.0,"ymin":2198.0,"xmax":2963.0,"ymax":2235.0},{"id":78,"contenttext":"バ","xmin":2143.0,"ymin":2106.0,"xmax":2163.0,"ymax":2148.0},{"id":79,"contenttext":"何謂也。","xmin":2110.0,"ymin":2059.0,"xmax":2152.0,"ymax":2187.0},{"id":80,"contenttext":"子日。","xmin":2103.0,"ymin":2190.0,"xmax":2152.0,"ymax":2289.0},{"id":81,"contenttext":"孟孫問孝於我。","xmin":2113.0,"ymin":1406.0,"xmax":2157.0,"ymax":1659.0},{"id":82,"contenttext":"我對曰。","xmin":2111.0,"ymin":1662.0,"xmax":2156.0,"ymax":1792.0},{"id":83,"contenttext":"無違。","xmin":2110.0,"ymin":1801.0,"xmax":2152.0,"ymax":1905.0},{"id":84,"contenttext":"樊遲日、","xmin":2110.0,"ymin":1918.0,"xmax":2154.0,"ymax":2046.0},{"id":85,"contenttext":"仰しやるには、","xmin":1614.0,"ymin":567.0,"xmax":1661.0,"ymax":796.0},{"id":86,"contenttext":"孟露子が私に孝行といふことを聞いた。","xmin":1605.0,"ymin":807.0,"xmax":1659.0,"ymax":1416.0},{"id":87,"contenttext":"そこで私が","xmin":1602.0,"ymin":1425.0,"xmax":1650.0,"ymax":1605.0},{"id":88,"contenttext":"「違ふことなかれ」と答へてやつた。","xmin":1594.0,"ymin":1607.0,"xmax":1649.0,"ymax":2168.0},{"id":89,"contenttext":"ところ","xmin":1595.0,"ymin":2178.0,"xmax":1634.0,"ymax":2288.0},{"id":90,"contenttext":"が英遲といふのは學問が進んで居りましたから、「それは何の謂ぞや」","xmin":1531.0,"ymin":569.0,"xmax":1593.0,"ymax":1625.0},{"id":91,"contenttext":"と聞き返へしたのであります、","xmin":1524.0,"ymin":1628.0,"xmax":1577.0,"ymax":2098.0},{"id":92,"contenttext":"孔夫子はそ","xmin":1525.0,"ymin":2108.0,"xmax":1570.0,"ymax":2286.0},{"id":93,"contenttext":"こだと云はぬばかりに、「孝行には禮といふものが大切だ」","xmin":1464.0,"ymin":569.0,"xmax":1523.0,"ymax":1451.0},{"id":94,"contenttext":"と言はれた。","xmin":1463.0,"ymin":1458.0,"xmax":1509.0,"ymax":1651.0},{"id":95,"contenttext":"こゝに書いてありますやうに、","xmin":1456.0,"ymin":1667.0,"xmax":1505.0,"ymax":2133.0},{"id":96,"contenttext":"徴すると","xmin":1456.0,"ymin":2140.0,"xmax":1502.0,"ymax":2286.0},{"id":97,"contenttext":"いふこと、","xmin":1406.0,"ymin":571.0,"xmax":1449.0,"ymax":723.0},{"id":98,"contenttext":"色難しといふこと、","xmin":1401.0,"ymin":735.0,"xmax":1448.0,"ymax":1031.0},{"id":99,"contenttext":"或は禮を以て接するといふこと、","xmin":1394.0,"ymin":1043.0,"xmax":1448.0,"ymax":1548.0},{"id":100,"contenttext":"さういふやうなことをいろ〓〓孔子が言はれて","xmin":1383.0,"ymin":1559.0,"xmax":1439.0,"ymax":2281.0},{"id":101,"contenttext":"居りますが、","xmin":1339.0,"ymin":564.0,"xmax":1382.0,"ymax":758.0},{"id":102,"contenttext":"併し今申したやうなことは孝行の枝葉末節でありまして、","xmin":1324.0,"ymin":768.0,"xmax":1379.0,"ymax":1647.0},{"id":103,"contenttext":"その根本はどういふところにあるか、","xmin":1318.0,"ymin":1658.0,"xmax":1368.0,"ymax":2230.0},{"id":104,"contenttext":"か","xmin":1317.0,"ymin":2244.0,"xmax":1356.0,"ymax":2281.0},{"id":105,"contenttext":"ういふことになりますと、どうしても孝行の根本は親の志を繼ぐといふところにある、親の志に反きましたならば","xmin":1244.0,"ymin":564.0,"xmax":1318.0,"ymax":2281.0},{"id":106,"contenttext":"どんなに親に御馳走をしても、","xmin":1197.0,"ymin":562.0,"xmax":1247.0,"ymax":1031.0},{"id":107,"contenttext":"どんなに親に禮儀を以て接しても、","xmin":1188.0,"ymin":1039.0,"xmax":1240.0,"ymax":1576.0},{"id":108,"contenttext":"どんなに親を尊敬してもこれは孝となりませ","xmin":1177.0,"ymin":1591.0,"xmax":1233.0,"ymax":2279.0},{"id":109,"contenttext":"2.","xmin":1139.0,"ymin":566.0,"xmax":1174.0,"ymax":619.0},{"id":110,"contenttext":"難波大助のやうなのが、","xmin":1126.0,"ymin":629.0,"xmax":1179.0,"ymax":995.0},{"id":111,"contenttext":"どんなに親に御馳走しても、","xmin":1121.0,"ymin":1006.0,"xmax":1171.0,"ymax":1439.0},{"id":112,"contenttext":"それは孝行になりませぬ。","xmin":1117.0,"ymin":1452.0,"xmax":1164.0,"ymax":1853.0},{"id":113,"contenttext":"親は有難いと思ひませぬ。","xmin":1108.0,"ymin":1861.0,"xmax":1160.0,"ymax":2264.0},{"id":114,"contenttext":"親の志を繼ぐといふことが孝行の大切なところであります。","xmin":1051.0,"ymin":560.0,"xmax":1110.0,"ymax":1474.0},{"id":115,"contenttext":"我が傳統の精神では、","xmin":1047.0,"ymin":1485.0,"xmax":1099.0,"ymax":1817.0},{"id":116,"contenttext":"孝行の極致は此の點にあるの","xmin":1040.0,"ymin":1825.0,"xmax":1093.0,"ymax":2279.0},{"id":117,"contenttext":"であります。","xmin":998.0,"ymin":562.0,"xmax":1037.0,"ymax":753.0},{"id":118,"contenttext":"それが又儒〓に於てチヤンと示してあります、","xmin":984.0,"ymin":764.0,"xmax":1037.0,"ymax":1472.0},{"id":119,"contenttext":"我國の皇道に於ける孝行の大切なことが儒〓に於て","xmin":972.0,"ymin":1485.0,"xmax":1031.0,"ymax":2278.0},{"id":120,"contenttext":"示してあります。","xmin":923.0,"ymin":558.0,"xmax":974.0,"ymax":822.0},{"id":121,"contenttext":",","xmin":888.0,"ymin":1017.0,"xmax":918.0,"ymax":1047.0},{"id":122,"contenttext":"之事者也。","xmin":854.0,"ymin":1069.0,"xmax":912.0,"ymax":1248.0},{"id":123,"contenttext":"t","xmin":890.0,"ymin":1174.0,"xmax":909.0,"ymax":1213.0},{"id":124,"contenttext":"夫孝者善繼人之志、","xmin":857.0,"ymin":625.0,"xmax":909.0,"ymax":944.0},{"id":125,"contenttext":"善述人","xmin":856.0,"ymin":948.0,"xmax":903.0,"ymax":1069.0},{"id":126,"contenttext":"これは","xmin":793.0,"ymin":594.0,"xmax":834.0,"ymax":698.0},{"id":127,"contenttext":"『中庸』第十九章に載つて居りますが、","xmin":782.0,"ymin":706.0,"xmax":838.0,"ymax":1301.0},{"id":128,"contenttext":"これが孝行の根本なのです。","xmin":776.0,"ymin":1314.0,"xmax":827.0,"ymax":1745.0},{"id":129,"contenttext":"「人」といふのは親であります。","xmin":768.0,"ymin":1771.0,"xmax":820.0,"ymax":2258.0},{"id":130,"contenttext":"或は祖先であります。","xmin":723.0,"ymin":555.0,"xmax":768.0,"ymax":887.0},{"id":131,"contenttext":"親の志を繼ぎ、","xmin":714.0,"ymin":895.0,"xmax":766.0,"ymax":1127.0},{"id":132,"contenttext":"親の事業、","xmin":713.0,"ymin":1136.0,"xmax":761.0,"ymax":1296.0},{"id":133,"contenttext":"精神を承け繼いで行く。","xmin":709.0,"ymin":1307.0,"xmax":758.0,"ymax":1673.0},{"id":134,"contenttext":"「述ぶる」といふことはそれを承け繼","xmin":699.0,"ymin":1700.0,"xmax":752.0,"ymax":2276.0},{"id":135,"contenttext":"いで行くことであります。","xmin":656.0,"ymin":559.0,"xmax":698.0,"ymax":952.0},{"id":136,"contenttext":"孝行といふものゝ根本はこゝにある。","xmin":642.0,"ymin":964.0,"xmax":696.0,"ymax":1536.0},{"id":137,"contenttext":"「色難し」","xmin":641.0,"ymin":1562.0,"xmax":690.0,"ymax":1718.0},{"id":138,"contenttext":"とか「犬馬に至る迄養ふこと有り」","xmin":630.0,"ymin":1718.0,"xmax":687.0,"ymax":2260.0},{"id":139,"contenttext":"といふのは、","xmin":587.0,"ymin":555.0,"xmax":631.0,"ymax":747.0},{"id":140,"contenttext":"孔夫子がこの人は禮儀がないからかう言つてやらう、","xmin":571.0,"ymin":758.0,"xmax":631.0,"ymax":1570.0},{"id":141,"contenttext":"この人は短氣であるから、","xmin":568.0,"ymin":1586.0,"xmax":616.0,"ymax":1980.0},{"id":142,"contenttext":"この人は忠臣であ","xmin":565.0,"ymin":1996.0,"xmax":611.0,"ymax":2272.0},{"id":143,"contenttext":"皇國傳統の精神","xmin":522.0,"ymin":733.0,"xmax":559.0,"ymax":946.0},{"id":144,"contenttext":"量","xmin":507.0,"ymin":2175.0,"xmax":538.0,"ymax":2212.0}]