[{"id":0,"contenttext":"六","xmin":2926.0,"ymin":2200.0,"xmax":2954.0,"ymax":2223.0},{"id":1,"contenttext":"六","xmin":2926.0,"ymin":2200.0,"xmax":2954.0,"ymax":2223.0},{"id":2,"contenttext":"皇國傳統の精神","xmin":2917.0,"ymin":742.0,"xmax":2954.0,"ymax":955.0},{"id":3,"contenttext":"來の發展を潜在精神として有して居た。","xmin":2848.0,"ymin":562.0,"xmax":2892.0,"ymax":1169.0},{"id":4,"contenttext":"その潜在精神は本來どういふのであるかと言ふと、","xmin":2848.0,"ymin":1181.0,"xmax":2892.0,"ymax":1953.0},{"id":5,"contenttext":"第一には敬虔の感情といふのであります。","xmin":2781.0,"ymin":596.0,"xmax":2824.0,"ymax":1234.0},{"id":6,"contenttext":"敬虔といふことは總て愼しむといふことであります。","xmin":2780.0,"ymin":1246.0,"xmax":2827.0,"ymax":2057.0},{"id":7,"contenttext":"日本國民は殊","xmin":2783.0,"ymin":2073.0,"xmax":2825.0,"ymax":2281.0},{"id":8,"contenttext":"に神樣などに對して愼しむところの精神がある。","xmin":2714.0,"ymin":566.0,"xmax":2758.0,"ymax":1301.0},{"id":9,"contenttext":"どこに出ても愼しな精神を本來持つて居る。","xmin":2716.0,"ymin":1317.0,"xmax":2760.0,"ymax":1987.0},{"id":10,"contenttext":"敢て〓育や何かを","xmin":2716.0,"ymin":1999.0,"xmax":2760.0,"ymax":2281.0},{"id":11,"contenttext":"受けないでもさういふ精神がある。","xmin":2649.0,"ymin":564.0,"xmax":2691.0,"ymax":1098.0},{"id":12,"contenttext":"それでありますから、","xmin":2647.0,"ymin":1110.0,"xmax":2691.0,"ymax":1440.0},{"id":13,"contenttext":"我國の昔は神代と申しまして、","xmin":2649.0,"ymin":1452.0,"xmax":2691.0,"ymax":1919.0},{"id":14,"contenttext":"その時にはいろ〓〓の","xmin":2647.0,"ymin":1933.0,"xmax":2691.0,"ymax":2277.0},{"id":15,"contenttext":"神樣が活動遊ばす。","xmin":2579.0,"ymin":562.0,"xmax":2624.0,"ymax":858.0},{"id":16,"contenttext":"至るところに神樣が居られ、","xmin":2576.0,"ymin":869.0,"xmax":2628.0,"ymax":1305.0},{"id":17,"contenttext":"蒼生を支配なさる。","xmin":2579.0,"ymin":1313.0,"xmax":2624.0,"ymax":1613.0},{"id":18,"contenttext":"今日で言ふならば政治家或は〓育家、","xmin":2579.0,"ymin":1625.0,"xmax":2624.0,"ymax":2194.0},{"id":19,"contenttext":"或は","xmin":2579.0,"ymin":2205.0,"xmax":2624.0,"ymax":2281.0},{"id":20,"contenttext":"宗〓家、","xmin":2510.0,"ymin":562.0,"xmax":2554.0,"ymax":687.0},{"id":21,"contenttext":"さういふやうな方が昔は皆神樣なのです。","xmin":2510.0,"ymin":701.0,"xmax":2552.0,"ymax":1338.0},{"id":22,"contenttext":"それで國民が神樣に對するのでありますから、","xmin":2508.0,"ymin":1350.0,"xmax":2554.0,"ymax":2057.0},{"id":23,"contenttext":"無作法なこと","xmin":2510.0,"ymin":2069.0,"xmax":2552.0,"ymax":2279.0},{"id":24,"contenttext":"は出來ませぬ。","xmin":2443.0,"ymin":564.0,"xmax":2487.0,"ymax":791.0},{"id":25,"contenttext":"神樣の御支配を受ける。","xmin":2443.0,"ymin":800.0,"xmax":2487.0,"ymax":1167.0},{"id":26,"contenttext":"朝から晩迄、","xmin":2441.0,"ymin":1176.0,"xmax":2487.0,"ymax":1368.0},{"id":27,"contenttext":"晩から朝迄常に神樣が照臨遊ばしておいでになる。","xmin":2441.0,"ymin":1379.0,"xmax":2488.0,"ymax":2159.0},{"id":28,"contenttext":"さうい","xmin":2446.0,"ymin":2175.0,"xmax":2482.0,"ymax":2275.0},{"id":29,"contenttext":"ふ上代の風でありますからして、","xmin":2374.0,"ymin":564.0,"xmax":2416.0,"ymax":1061.0},{"id":30,"contenttext":"國民が極めて一言一句おろそかにしませぬ。","xmin":2374.0,"ymin":1073.0,"xmax":2418.0,"ymax":1748.0},{"id":31,"contenttext":"『古事記』","xmin":2372.0,"ymin":1775.0,"xmax":2416.0,"ymax":1925.0},{"id":32,"contenttext":"とか『日本書紀』","xmin":2372.0,"ymin":1932.0,"xmax":2416.0,"ymax":2196.0},{"id":33,"contenttext":"とか","xmin":2372.0,"ymin":2205.0,"xmax":2413.0,"ymax":2279.0},{"id":34,"contenttext":"いふやうな昔の事の書いてある本を讀んで","xmin":2304.0,"ymin":566.0,"xmax":2353.0,"ymax":1227.0},{"id":35,"contenttext":"御覽になりますと、","xmin":2307.0,"ymin":1230.0,"xmax":2348.0,"ymax":1525.0},{"id":36,"contenttext":"如何に言葉が一つ一つ尊敬の言葉から成つて居","xmin":2304.0,"ymin":1537.0,"xmax":2353.0,"ymax":2281.0},{"id":37,"contenttext":"るかに御注意なることでありませう。","xmin":2238.0,"ymin":562.0,"xmax":2281.0,"ymax":1130.0},{"id":38,"contenttext":"何の神宣り給はく、","xmin":2237.0,"ymin":1142.0,"xmax":2281.0,"ymax":1440.0},{"id":39,"contenttext":"申し給はく、","xmin":2238.0,"ymin":1451.0,"xmax":2279.0,"ymax":1643.0},{"id":40,"contenttext":"皆さういふ具合になつて居ります。","xmin":2237.0,"ymin":1655.0,"xmax":2282.0,"ymax":2194.0},{"id":41,"contenttext":"それ","xmin":2235.0,"ymin":2201.0,"xmax":2281.0,"ymax":2281.0},{"id":42,"contenttext":"は詰り本來の日本國民が知らず識らずに敬虔の精神に滿ちて居るといふことが分ります。","xmin":2168.0,"ymin":562.0,"xmax":2214.0,"ymax":1919.0},{"id":43,"contenttext":"それから我が上代に於","xmin":2166.0,"ymin":1928.0,"xmax":2214.0,"ymax":2281.0},{"id":44,"contenttext":"きましては、","xmin":2103.0,"ymin":560.0,"xmax":2143.0,"ymax":753.0},{"id":45,"contenttext":"何を致しましても神樣の御心に依つてことをするといふことになつて居ります。","xmin":2097.0,"ymin":765.0,"xmax":2145.0,"ymax":1986.0},{"id":46,"contenttext":"今日でも神樣や佛","xmin":2099.0,"ymin":1997.0,"xmax":2143.0,"ymax":2281.0},{"id":47,"contenttext":"樣にいろ〓〓の物を上げますが、","xmin":2030.0,"ymin":559.0,"xmax":2074.0,"ymax":1059.0},{"id":48,"contenttext":"昔からものを上げたのであります。","xmin":2030.0,"ymin":1073.0,"xmax":2073.0,"ymax":1609.0},{"id":49,"contenttext":"それを供饌と申しまして、","xmin":2030.0,"ymin":1622.0,"xmax":2073.0,"ymax":2020.0},{"id":50,"contenttext":"何でも物が出來","xmin":2028.0,"ymin":2030.0,"xmax":2076.0,"ymax":2279.0},{"id":51,"contenttext":"ましたならば、","xmin":1967.0,"ymin":560.0,"xmax":2007.0,"ymax":785.0},{"id":52,"contenttext":"それを上げる。","xmin":1965.0,"ymin":800.0,"xmax":2007.0,"ymax":1023.0},{"id":53,"contenttext":"かういふやうな精神に富んで居るのであります。","xmin":1963.0,"ymin":1038.0,"xmax":2006.0,"ymax":1780.0},{"id":54,"contenttext":"詰り神樣に物を差上げて、","xmin":1963.0,"ymin":1791.0,"xmax":2006.0,"ymax":2189.0},{"id":55,"contenttext":"さう","xmin":1969.0,"ymin":2207.0,"xmax":1997.0,"ymax":2275.0},{"id":56,"contenttext":"して差上げた物を戴く。","xmin":1898.0,"ymin":562.0,"xmax":1941.0,"ymax":922.0},{"id":57,"contenttext":"そこで所謂神人交通と申しまして、","xmin":1896.0,"ymin":936.0,"xmax":1938.0,"ymax":1468.0},{"id":58,"contenttext":"神樣に差上げた物を戴くといふことに依つて、","xmin":1895.0,"ymin":1484.0,"xmax":1940.0,"ymax":2193.0},{"id":59,"contenttext":"神威","xmin":1893.0,"ymin":2200.0,"xmax":1938.0,"ymax":2279.0},{"id":60,"contenttext":"に基いて自分の行動を神聖にする。","xmin":1827.0,"ymin":562.0,"xmax":1873.0,"ymax":1095.0},{"id":61,"contenttext":"神樣の物を戴いて生活するのでありますから惡い生活は出來ませぬ。","xmin":1825.0,"ymin":1105.0,"xmax":1871.0,"ymax":2157.0},{"id":62,"contenttext":"或は又","xmin":1823.0,"ymin":2165.0,"xmax":1872.0,"ymax":2280.0},{"id":63,"contenttext":"その神樣を中心としてその差上げた物を一つの部落なら部落の者が戴きまして、","xmin":1606.0,"ymin":534.0,"xmax":1667.0,"ymax":1752.0},{"id":64,"contenttext":"共同一致の精神を進めて行くと","xmin":1603.0,"ymin":1764.0,"xmax":1649.0,"ymax":2249.0},{"id":65,"contenttext":"いふ風が上代にございます。","xmin":1550.0,"ymin":535.0,"xmax":1602.0,"ymax":966.0},{"id":66,"contenttext":"それから昔からタブー","xmin":1484.0,"ymin":568.0,"xmax":1528.0,"ymax":909.0},{"id":67,"contenttext":"(Taboo)","xmin":1483.0,"ymin":922.0,"xmax":1522.0,"ymax":1060.0},{"id":68,"contenttext":"の精神があります。","xmin":1477.0,"ymin":1082.0,"xmax":1523.0,"ymax":1375.0},{"id":69,"contenttext":"これは南洋の方の言葉でありますが、","xmin":1466.0,"ymin":1388.0,"xmax":1520.0,"ymax":1959.0},{"id":70,"contenttext":"我が國の言葉で申","xmin":1463.0,"ymin":1968.0,"xmax":1513.0,"ymax":2249.0},{"id":71,"contenttext":"しますと禁忌などゝいふ言葉に當りませう。","xmin":1408.0,"ymin":532.0,"xmax":1460.0,"ymax":1202.0},{"id":72,"contenttext":"總て神樣は穢れをお嫌ひになる。","xmin":1399.0,"ymin":1214.0,"xmax":1452.0,"ymax":1721.0},{"id":73,"contenttext":"神樣に仕へるところの者は齋み〓","xmin":1393.0,"ymin":1727.0,"xmax":1446.0,"ymax":2251.0},{"id":74,"contenttext":"めて仕へなければならぬ、","xmin":1341.0,"ymin":528.0,"xmax":1392.0,"ymax":928.0},{"id":75,"contenttext":"又神樣に關した物に矢欝に觸つたり觸れたりすることが出來ない、","xmin":1325.0,"ymin":939.0,"xmax":1387.0,"ymax":1957.0},{"id":76,"contenttext":"といふやうなタブ","xmin":1327.0,"ymin":1969.0,"xmax":1369.0,"ymax":2242.0},{"id":77,"contenttext":"ーの觀念です。","xmin":1274.0,"ymin":532.0,"xmax":1325.0,"ymax":757.0},{"id":78,"contenttext":"それ等は皆敬虔の感情といふものゝ現れであります。","xmin":1262.0,"ymin":767.0,"xmax":1319.0,"ymax":1578.0},{"id":79,"contenttext":"殊に何か事件を致しますと神樣の御意思を","xmin":1257.0,"ymin":1589.0,"xmax":1309.0,"ymax":2251.0},{"id":80,"contenttext":"フ","xmin":1243.0,"ymin":1114.0,"xmax":1258.0,"ymax":1149.0},{"id":81,"contenttext":"伺つてする。","xmin":1213.0,"ymin":527.0,"xmax":1257.0,"ymax":721.0},{"id":82,"contenttext":"これを太占と申します。","xmin":1209.0,"ymin":737.0,"xmax":1251.0,"ymax":1096.0},{"id":83,"contenttext":"太といふのは稱","xmin":1199.0,"ymin":1108.0,"xmax":1252.0,"ymax":1360.0},{"id":84,"contenttext":"辭と言ひまして、","xmin":1197.0,"ymin":1383.0,"xmax":1242.0,"ymax":1645.0},{"id":85,"contenttext":"今日で言ひますと「大日本帝國」","xmin":1192.0,"ymin":1657.0,"xmax":1240.0,"ymax":2168.0},{"id":86,"contenttext":"の大","xmin":1188.0,"ymin":2171.0,"xmax":1237.0,"ymax":2247.0},{"id":87,"contenttext":"の字に當る。","xmin":1144.0,"ymin":531.0,"xmax":1190.0,"ymax":723.0},{"id":88,"contenttext":"ぶといふことは「まに〓〓」といふ意味で神樣の御心がどういふのであるか、","xmin":1113.0,"ymin":732.0,"xmax":1199.0,"ymax":1920.0},{"id":89,"contenttext":"この事をどうすれば","xmin":1120.0,"ymin":1936.0,"xmax":1171.0,"ymax":2246.0},{"id":90,"contenttext":"宜しいのであるか、","xmin":1068.0,"ymin":525.0,"xmax":1120.0,"ymax":824.0},{"id":91,"contenttext":"といふことを皆神樣の御心に伺ふ。","xmin":1062.0,"ymin":835.0,"xmax":1116.0,"ymax":1373.0},{"id":92,"contenttext":"それは今日では占ひと言ひます。","xmin":1056.0,"ymin":1381.0,"xmax":1108.0,"ymax":1885.0},{"id":93,"contenttext":"占ひといふことはどう","xmin":1052.0,"ymin":1896.0,"xmax":1099.0,"ymax":2244.0},{"id":94,"contenttext":"〃","xmin":1026.0,"ymin":1689.0,"xmax":1045.0,"ymax":1710.0},{"id":95,"contenttext":",","xmin":1026.0,"ymin":1708.0,"xmax":1045.0,"ymax":1727.0},{"id":96,"contenttext":"いふことであるかと申しますと、","xmin":998.0,"ymin":528.0,"xmax":1048.0,"ymax":1026.0},{"id":97,"contenttext":"心を合はすといふことで、","xmin":990.0,"ymin":1039.0,"xmax":1043.0,"ymax":1438.0},{"id":98,"contenttext":"心のことを昔は裏と言ひました。","xmin":985.0,"ymin":1452.0,"xmax":1037.0,"ymax":1953.0},{"id":99,"contenttext":"何故心のことを裏","xmin":981.0,"ymin":1965.0,"xmax":1032.0,"ymax":2246.0},{"id":100,"contenttext":"と言つたかといふと、","xmin":931.0,"ymin":525.0,"xmax":977.0,"ymax":855.0},{"id":101,"contenttext":"顏のことを面と云ふと同じ關係です。","xmin":922.0,"ymin":864.0,"xmax":976.0,"ymax":1438.0},{"id":102,"contenttext":"顏は誰にでも分ります。","xmin":915.0,"ymin":1446.0,"xmax":968.0,"ymax":1814.0},{"id":103,"contenttext":"顏付を見ればあの人は喜ん","xmin":911.0,"ymin":1822.0,"xmax":963.0,"ymax":2244.0},{"id":104,"contenttext":"で居るなと云ふのが直ぐ分る。","xmin":857.0,"ymin":526.0,"xmax":911.0,"ymax":989.0},{"id":105,"contenttext":"あの人は悲觀して居るなといふのが直ぐ分る。","xmin":850.0,"ymin":1004.0,"xmax":903.0,"ymax":1710.0},{"id":106,"contenttext":"それは表ですからこればかりは隱","xmin":844.0,"ymin":1723.0,"xmax":894.0,"ymax":2242.0},{"id":107,"contenttext":"す譯に行かない。","xmin":795.0,"ymin":521.0,"xmax":845.0,"ymax":783.0},{"id":108,"contenttext":"嬉しい···見られてはいかんといふので扇子で隱して歩く譯には行かない。","xmin":779.0,"ymin":793.0,"xmax":840.0,"ymax":1915.0},{"id":109,"contenttext":"(笑聲)","xmin":781.0,"ymin":1923.0,"xmax":825.0,"ymax":2039.0},{"id":110,"contenttext":"これだけは","xmin":777.0,"ymin":2067.0,"xmax":822.0,"ymax":2241.0},{"id":111,"contenttext":"どんな時でも出して歩かなけれはならぬ。","xmin":722.0,"ymin":521.0,"xmax":775.0,"ymax":1160.0},{"id":112,"contenttext":"人に直ぐ見られて終ふ。","xmin":716.0,"ymin":1173.0,"xmax":768.0,"ymax":1539.0},{"id":113,"contenttext":"どんなに喜怒色に現さずと努めたところが駄","xmin":709.0,"ymin":1549.0,"xmax":761.0,"ymax":2240.0},{"id":114,"contenttext":"目です。","xmin":664.0,"ymin":522.0,"xmax":709.0,"ymax":649.0},{"id":115,"contenttext":"ところが心の方は包んで居るものですから人に見えない、","xmin":646.0,"ymin":659.0,"xmax":706.0,"ymax":1539.0},{"id":116,"contenttext":"それで心の方を裏と言つた。","xmin":643.0,"ymin":1549.0,"xmax":693.0,"ymax":1982.0},{"id":117,"contenttext":"神樣の御心はそ","xmin":642.0,"ymin":1993.0,"xmax":687.0,"ymax":2240.0},{"id":118,"contenttext":"れ以上分らない。","xmin":589.0,"ymin":519.0,"xmax":638.0,"ymax":783.0},{"id":119,"contenttext":"そこで鹿の肩の骨を取つて適當の大きさに切つて、","xmin":576.0,"ymin":794.0,"xmax":635.0,"ymax":1571.0},{"id":120,"contenttext":"これを樺櫻といふ一種の櫻の種類ですが、","xmin":571.0,"ymin":1584.0,"xmax":621.0,"ymax":2221.0},{"id":121,"contenttext":"皇國傳統の精神","xmin":529.0,"ymin":701.0,"xmax":564.0,"ymax":915.0},{"id":122,"contenttext":"七","xmin":511.0,"ymin":2152.0,"xmax":546.0,"ymax":2180.0},{"id":123,"contenttext":"共同一致の精神を進めて行くと","xmin":1603.0,"ymin":1764.0,"xmax":1649.0,"ymax":2249.0}]