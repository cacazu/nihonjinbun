[{"id":0,"contenttext":"皇國傳統の精神","xmin":2889.0,"ymin":742.0,"xmax":2928.0,"ymax":959.0},{"id":1,"contenttext":"ゝあるのであります。吾々一個人の精神が生きて居ります通りに皇國の精神そのものが生きて居るのであります。","xmin":2821.0,"ymin":571.0,"xmax":2868.0,"ymax":2281.0},{"id":2,"contenttext":"人生五十年と言ひますが、","xmin":2755.0,"ymin":566.0,"xmax":2797.0,"ymax":964.0},{"id":3,"contenttext":"吾々一個人のは五十年か八十年か、","xmin":2755.0,"ymin":973.0,"xmax":2800.0,"ymax":1510.0},{"id":4,"contenttext":"長くても大抵百年位、","xmin":2757.0,"ymin":1521.0,"xmax":2799.0,"ymax":1852.0},{"id":5,"contenttext":"それ位で吾々の一身は失く","xmin":2757.0,"ymin":1868.0,"xmax":2802.0,"ymax":2284.0},{"id":6,"contenttext":"なつて終ひますが、","xmin":2681.0,"ymin":565.0,"xmax":2730.0,"ymax":860.0},{"id":7,"contenttext":"皇國の精神となりますと不朽の生命、","xmin":2684.0,"ymin":871.0,"xmax":2733.0,"ymax":1444.0},{"id":8,"contenttext":"天壤無窮の生命を持つて居ります。","xmin":2686.0,"ymin":1454.0,"xmax":2732.0,"ymax":1992.0},{"id":9,"contenttext":"天壤無窮の生命を","xmin":2686.0,"ymin":2002.0,"xmax":2735.0,"ymax":2285.0},{"id":10,"contenttext":"持つて天壤無窮に發展しつゝあります。","xmin":2614.0,"ymin":566.0,"xmax":2659.0,"ymax":1169.0},{"id":11,"contenttext":"ところがその皇國の精神といふものがどういふ風なものであらうか、","xmin":2616.0,"ymin":1183.0,"xmax":2660.0,"ymax":2231.0},{"id":12,"contenttext":"か","xmin":2619.0,"ymin":2245.0,"xmax":2658.0,"ymax":2282.0},{"id":13,"contenttext":"う考へますと、極く太古にはそれが未だハツキリして居らぬ。どういふものだといふことを明確に斷言することは","xmin":2544.0,"ymin":566.0,"xmax":2591.0,"ymax":2283.0},{"id":14,"contenttext":"出來ませぬ。それでありますから、それを潜在精神と名付ける。","xmin":2478.0,"ymin":566.0,"xmax":2522.0,"ymax":1510.0},{"id":15,"contenttext":"潜在精神或は潜在意識とよく申します。","xmin":2482.0,"ymin":1523.0,"xmax":2524.0,"ymax":2127.0},{"id":16,"contenttext":"この頃は","xmin":2482.0,"ymin":2145.0,"xmax":2526.0,"ymax":2282.0},{"id":17,"contenttext":"よく學問の方で潜在意識と言ひますが、","xmin":2408.0,"ymin":567.0,"xmax":2455.0,"ymax":1169.0},{"id":18,"contenttext":"この意識といふには精神の活動狀態と申しまして、","xmin":2410.0,"ymin":1184.0,"xmax":2456.0,"ymax":1957.0},{"id":19,"contenttext":"意識といふ言葉の中","xmin":2411.0,"ymin":1967.0,"xmax":2460.0,"ymax":2285.0},{"id":20,"contenttext":"には常に活動して居るといふ意味があるのです。","xmin":2340.0,"ymin":567.0,"xmax":2390.0,"ymax":1309.0},{"id":21,"contenttext":"ドイツのヘツケルといふ人は、","xmin":2344.0,"ymin":1318.0,"xmax":2386.0,"ymax":1785.0},{"id":22,"contenttext":"生れたての赤ん坊は意識がない","xmin":2346.0,"ymin":1800.0,"xmax":2391.0,"ymax":2282.0},{"id":23,"contenttext":"といふことを言つて居ります。","xmin":2274.0,"ymin":568.0,"xmax":2316.0,"ymax":1033.0},{"id":24,"contenttext":"まあさう言はれて見るとさうも見られる。","xmin":2274.0,"ymin":1045.0,"xmax":2318.0,"ymax":1681.0},{"id":25,"contenttext":"赤ん坊は無意識に活動して居る。","xmin":2277.0,"ymin":1696.0,"xmax":2323.0,"ymax":2198.0},{"id":26,"contenttext":"これ","xmin":2279.0,"ymin":2214.0,"xmax":2323.0,"ymax":2286.0},{"id":27,"contenttext":"は赤ん坊ばかりではない、","xmin":2203.0,"ymin":568.0,"xmax":2249.0,"ymax":965.0},{"id":28,"contenttext":"吾々のやうに大きくなつた者でも無意識に活動することは度々あります。","xmin":2203.0,"ymin":973.0,"xmax":2252.0,"ymax":2094.0},{"id":29,"contenttext":"詰り夢中で","xmin":2208.0,"ymin":2104.0,"xmax":2254.0,"ymax":2284.0},{"id":30,"contenttext":"するのです。","xmin":2131.0,"ymin":566.0,"xmax":2177.0,"ymax":759.0},{"id":31,"contenttext":"「ウツカリした」といふやうなことがよくありますが、","xmin":2131.0,"ymin":784.0,"xmax":2179.0,"ymax":1612.0},{"id":32,"contenttext":"あれは無意識ですることです。","xmin":2132.0,"ymin":1628.0,"xmax":2185.0,"ymax":2096.0},{"id":33,"contenttext":"無自覺で","xmin":2138.0,"ymin":2117.0,"xmax":2182.0,"ymax":2282.0},{"id":34,"contenttext":"す。","xmin":2066.0,"ymin":566.0,"xmax":2106.0,"ymax":624.0},{"id":35,"contenttext":"意識といふことは自分ですることを自分で知つて居なければならない。","xmin":2061.0,"ymin":633.0,"xmax":2108.0,"ymax":1715.0},{"id":36,"contenttext":"それが意識的活動といふのです。","xmin":2065.0,"ymin":1729.0,"xmax":2112.0,"ymax":2235.0},{"id":37,"contenttext":"で","xmin":2071.0,"ymin":2242.0,"xmax":2110.0,"ymax":2282.0},{"id":38,"contenttext":"ありますから意識といふ言葉は少し範圍が狹いのです。","xmin":1995.0,"ymin":568.0,"xmax":2040.0,"ymax":1412.0},{"id":39,"contenttext":"私はこゝに精神といふ字を使つた。","xmin":1996.0,"ymin":1420.0,"xmax":2043.0,"ymax":1960.0},{"id":40,"contenttext":"精神と言へばどんな","xmin":1999.0,"ymin":1969.0,"xmax":2044.0,"ymax":2284.0},{"id":41,"contenttext":"時でもある。","xmin":1926.0,"ymin":566.0,"xmax":1969.0,"ymax":756.0},{"id":42,"contenttext":"眠つて居る時には意識はないことになる。","xmin":1926.0,"ymin":770.0,"xmax":1970.0,"ymax":1412.0},{"id":43,"contenttext":"昔、","xmin":1932.0,"ymin":1421.0,"xmax":1972.0,"ymax":1480.0},{"id":44,"contenttext":"後漢の光武皇帝といふ皇帝がありましたが、","xmin":1927.0,"ymin":1484.0,"xmax":1977.0,"ymax":2165.0},{"id":45,"contenttext":"支那で","xmin":1932.0,"ymin":2173.0,"xmax":1976.0,"ymax":2282.0},{"id":46,"contenttext":"は皇帝と言つても昔は書生だつたり、","xmin":1857.0,"ymin":567.0,"xmax":1902.0,"ymax":1133.0},{"id":47,"contenttext":"何かする者が皇帝になるのですから、","xmin":1859.0,"ymin":1146.0,"xmax":1905.0,"ymax":1718.0},{"id":48,"contenttext":"その光武皇帝の書生時代のお友達に","xmin":1859.0,"ymin":1729.0,"xmax":1910.0,"ymax":2283.0},{"id":49,"contenttext":"嚴といふ男が居つた。","xmin":1792.0,"ymin":564.0,"xmax":1837.0,"ymax":895.0},{"id":50,"contenttext":"ところが光武皇帝が一朝風雲に乘じて皇帝になりました。","xmin":1792.0,"ymin":906.0,"xmax":1837.0,"ymax":1783.0},{"id":51,"contenttext":"そこで昔の友達の嚴といふのも","xmin":1794.0,"ymin":1798.0,"xmax":1838.0,"ymax":2282.0},{"id":52,"contenttext":"引上げて偉い役人にしようと言つたのですが、","xmin":1581.0,"ymin":568.0,"xmax":1626.0,"ymax":1276.0},{"id":53,"contenttext":"その嚴といふのは一風變つた人間で、","xmin":1579.0,"ymin":1283.0,"xmax":1624.0,"ymax":1858.0},{"id":54,"contenttext":"役人になつて鹿爪らしくや","xmin":1577.0,"ymin":1865.0,"xmax":1623.0,"ymax":2284.0},{"id":55,"contenttext":"つて居るのは嫌だ、","xmin":1512.0,"ymin":573.0,"xmax":1558.0,"ymax":862.0},{"id":56,"contenttext":"矢張り無冠の大夫が宜いといふのでどうしてもならぬ。","xmin":1507.0,"ymin":876.0,"xmax":1557.0,"ymax":1719.0},{"id":57,"contenttext":"それならばお前の自由にさして置く","xmin":1506.0,"ymin":1731.0,"xmax":1553.0,"ymax":2284.0},{"id":58,"contenttext":"といふことであつた。","xmin":1445.0,"ymin":568.0,"xmax":1488.0,"ymax":897.0},{"id":59,"contenttext":"一日嚴が光武皇帝を訪問に來ました。","xmin":1443.0,"ymin":916.0,"xmax":1485.0,"ymax":1477.0},{"id":60,"contenttext":"いろ〓〓と臣下のものどもを遠ざけて話をした。","xmin":1440.0,"ymin":1495.0,"xmax":1482.0,"ymax":2231.0},{"id":61,"contenttext":"夜","xmin":1436.0,"ymin":2242.0,"xmax":1482.0,"ymax":2288.0},{"id":62,"contenttext":"になつて","xmin":1377.0,"ymin":569.0,"xmax":1419.0,"ymax":709.0},{"id":63,"contenttext":"「今晩泊つて行け」","xmin":1375.0,"ymin":713.0,"xmax":1423.0,"ymax":1008.0},{"id":64,"contenttext":"「ウン泊らう」といふ風で、","xmin":1372.0,"ymin":1093.0,"xmax":1418.0,"ymax":1511.0},{"id":65,"contenttext":"まるで皇帝だけれどもヴエールを剝して終つて、","xmin":1369.0,"ymin":1526.0,"xmax":1416.0,"ymax":2265.0},{"id":66,"contenttext":"昔のお友達の通りにやつて、「一〓に寢よう」···「お前のところに寢よう」といふので皇帝の傍へ寢たです。","xmin":1302.0,"ymin":566.0,"xmax":1354.0,"ymax":2196.0},{"id":67,"contenttext":"とこ","xmin":1305.0,"ymin":2211.0,"xmax":1341.0,"ymax":2284.0},{"id":68,"contenttext":"ろが嚴といふ男は寢相が惡いものですから、","xmin":1239.0,"ymin":567.0,"xmax":1285.0,"ymax":1237.0},{"id":69,"contenttext":"大の字になつて大きな足を皇帝のお腹の上に載せて居る。","xmin":1235.0,"ymin":1249.0,"xmax":1284.0,"ymax":2129.0},{"id":70,"contenttext":"皇帝も疲","xmin":1236.0,"ymin":2138.0,"xmax":1277.0,"ymax":2282.0},{"id":71,"contenttext":"れて居るのでそれを覺えて居ない。","xmin":1172.0,"ymin":566.0,"xmax":1218.0,"ymax":1102.0},{"id":72,"contenttext":"ところが天文學者が一生懸命天文を〓究して居ると、","xmin":1166.0,"ymin":1114.0,"xmax":1217.0,"ymax":1925.0},{"id":73,"contenttext":"皇帝の星に何か迫害を","xmin":1165.0,"ymin":1933.0,"xmax":1211.0,"ymax":2282.0},{"id":74,"contenttext":"與へて居る。","xmin":1103.0,"ymin":564.0,"xmax":1147.0,"ymax":755.0},{"id":75,"contenttext":"これは大變だといふので、","xmin":1102.0,"ymin":774.0,"xmax":1147.0,"ymax":1170.0},{"id":76,"contenttext":"急いで宮中に出仕してそのことを申上げた。","xmin":1096.0,"ymin":1181.0,"xmax":1146.0,"ymax":1853.0},{"id":77,"contenttext":"さうすると宮中の役人が驚","xmin":1095.0,"ymin":1865.0,"xmax":1139.0,"ymax":2282.0},{"id":78,"contenttext":"いて皇帝のお休みになつて居るところへ行つて見ると嚴が大きな足を載せて居る。","xmin":1030.0,"ymin":569.0,"xmax":1079.0,"ymax":1817.0},{"id":79,"contenttext":"(笑聲)","xmin":1029.0,"ymin":1826.0,"xmax":1073.0,"ymax":1942.0},{"id":80,"contenttext":"これだなといふので","xmin":1028.0,"ymin":1970.0,"xmax":1069.0,"ymax":2279.0},{"id":81,"contenttext":"眼を醒さないやうに足を取つて脇の方へ引張つて寢かして置いた。","xmin":963.0,"ymin":562.0,"xmax":1015.0,"ymax":1581.0},{"id":82,"contenttext":"それで天文の方の異常が取れたといふ話があ","xmin":958.0,"ymin":1589.0,"xmax":1007.0,"ymax":2281.0},{"id":83,"contenttext":"ります。","xmin":902.0,"ymin":562.0,"xmax":941.0,"ymax":686.0},{"id":84,"contenttext":"そんなことが本當にあつたかどうですか分りませぬけれども、","xmin":895.0,"ymin":699.0,"xmax":944.0,"ymax":1645.0},{"id":85,"contenttext":"まあさういふ譯で、","xmin":894.0,"ymin":1659.0,"xmax":935.0,"ymax":1951.0},{"id":86,"contenttext":"寢て居る時に皇帝の","xmin":891.0,"ymin":1965.0,"xmax":935.0,"ymax":2279.0},{"id":87,"contenttext":"上に足をやつてもこれは無意識であります。","xmin":830.0,"ymin":562.0,"xmax":876.0,"ymax":1232.0},{"id":88,"contenttext":"だからして法律上の罪にならぬ。","xmin":826.0,"ymin":1244.0,"xmax":874.0,"ymax":1747.0},{"id":89,"contenttext":"總てかう云ふ具合に無意識でした","xmin":822.0,"ymin":1756.0,"xmax":871.0,"ymax":2281.0},{"id":90,"contenttext":"ことは、","xmin":765.0,"ymin":564.0,"xmax":804.0,"ymax":684.0},{"id":91,"contenttext":"法律上からも道德上からもこれを罪と認めない。","xmin":763.0,"ymin":695.0,"xmax":805.0,"ymax":1438.0},{"id":92,"contenttext":"知らないでしたことであります。","xmin":759.0,"ymin":1450.0,"xmax":804.0,"ymax":1951.0},{"id":93,"contenttext":"吾々の精神といふも","xmin":758.0,"ymin":1962.0,"xmax":800.0,"ymax":2277.0},{"id":94,"contenttext":"のは眠つて居りましても何時でもある。","xmin":694.0,"ymin":564.0,"xmax":739.0,"ymax":1162.0},{"id":95,"contenttext":"それでこれはどうしても潜在精神といふ意味に取つた方が宜しい。","xmin":688.0,"ymin":1175.0,"xmax":739.0,"ymax":2191.0},{"id":96,"contenttext":"かう","xmin":689.0,"ymin":2205.0,"xmax":730.0,"ymax":2277.0},{"id":97,"contenttext":"考へまして私は潜在精神としたのであります。","xmin":624.0,"ymin":557.0,"xmax":671.0,"ymax":1262.0},{"id":98,"contenttext":"日本國民、","xmin":559.0,"ymin":594.0,"xmax":601.0,"ymax":749.0},{"id":99,"contenttext":"卽ち皇國の國民が未だ何等の學術も持たず、","xmin":554.0,"ymin":760.0,"xmax":603.0,"ymax":1434.0},{"id":100,"contenttext":"何等の〓究と云ふ風なものも行はない時代に、","xmin":552.0,"ymin":1443.0,"xmax":597.0,"ymax":2154.0},{"id":101,"contenttext":"己に將","xmin":552.0,"ymin":2168.0,"xmax":590.0,"ymax":2275.0},{"id":102,"contenttext":"皇國傳統の精神","xmin":495.0,"ymin":737.0,"xmax":531.0,"ymax":947.0},{"id":103,"contenttext":"五","xmin":492.0,"ymin":2193.0,"xmax":522.0,"ymax":2215.0},{"id":104,"contenttext":"何等の〓究と云ふ風なものも行はない時代に、","xmin":552.0,"ymin":1443.0,"xmax":597.0,"ymax":2154.0},{"id":105,"contenttext":"己に將","xmin":552.0,"ymin":2168.0,"xmax":590.0,"ymax":2275.0},{"id":106,"contenttext":"五","xmin":492.0,"ymin":2193.0,"xmax":522.0,"ymax":2215.0}]