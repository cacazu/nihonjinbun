[{"id":0,"contenttext":"皇國傳統の精神","xmin":2906.0,"ymin":760.0,"xmax":2942.0,"ymax":975.0},{"id":1,"contenttext":"八","xmin":2899.0,"ymin":2207.0,"xmax":2935.0,"ymax":2242.0},{"id":2,"contenttext":"十","xmin":2864.0,"ymin":2260.0,"xmax":2885.0,"ymax":2298.0},{"id":3,"contenttext":"します。","xmin":2838.0,"ymin":582.0,"xmax":2878.0,"ymax":705.0},{"id":4,"contenttext":"榮樹は今日は榊と書きますけれども、","xmin":2828.0,"ymin":713.0,"xmax":2880.0,"ymax":1284.0},{"id":5,"contenttext":"これは我が國で作つた字であります。","xmin":2827.0,"ymin":1304.0,"xmax":2878.0,"ymax":1870.0},{"id":6,"contenttext":"さういふ樹に御神靈が御宿","xmin":2829.0,"ymin":1884.0,"xmax":2875.0,"ymax":2300.0},{"id":7,"contenttext":"りになるのであります。","xmin":2767.0,"ymin":578.0,"xmax":2808.0,"ymax":943.0},{"id":8,"contenttext":"それが社の義であります。社といふのは屋代、卽ち家の代りであります。","xmin":2760.0,"ymin":955.0,"xmax":2810.0,"ymax":2041.0},{"id":9,"contenttext":"家の代りに社と","xmin":2760.0,"ymin":2052.0,"xmax":2806.0,"ymax":2300.0},{"id":10,"contenttext":"いふものを建てるのです。","xmin":2700.0,"ymin":582.0,"xmax":2742.0,"ymax":976.0},{"id":11,"contenttext":"それに神樣が御宿りになる。","xmin":2698.0,"ymin":987.0,"xmax":2741.0,"ymax":1421.0},{"id":12,"contenttext":"それが神籠といふのであります。","xmin":2694.0,"ymin":1434.0,"xmax":2739.0,"ymax":1936.0},{"id":13,"contenttext":"大和に官幣大社大神神","xmin":2693.0,"ymin":1946.0,"xmax":2739.0,"ymax":2298.0},{"id":14,"contenttext":"社といふのがおありでありますが、","xmin":2631.0,"ymin":576.0,"xmax":2674.0,"ymax":1112.0},{"id":15,"contenttext":"こゝなぞは神殿はないのであります、神靈は山に御宿りになつて居られます。","xmin":2625.0,"ymin":1128.0,"xmax":2673.0,"ymax":2297.0},{"id":16,"contenttext":"山が神殿であります。","xmin":2564.0,"ymin":576.0,"xmax":2607.0,"ymax":904.0},{"id":17,"contenttext":"御家は拜むところしか拵へてありませぬ。","xmin":2559.0,"ymin":920.0,"xmax":2607.0,"ymax":1555.0},{"id":18,"contenttext":"關東では、","xmin":2561.0,"ymin":1567.0,"xmax":2605.0,"ymax":1726.0},{"id":19,"contenttext":"筑波山の神社も、","xmin":2556.0,"ymin":1741.0,"xmax":2605.0,"ymax":2006.0},{"id":20,"contenttext":"之れと同樣と考へ","xmin":2557.0,"ymin":2015.0,"xmax":2601.0,"ymax":2293.0},{"id":21,"contenttext":"られます。","xmin":2496.0,"ymin":576.0,"xmax":2540.0,"ymax":735.0},{"id":22,"contenttext":"山が神殿になる。","xmin":2496.0,"ymin":747.0,"xmax":2540.0,"ymax":1010.0},{"id":23,"contenttext":"今筑波山の山の上に奥の院といふ理窟で御家が出來て居りますが、","xmin":2489.0,"ymin":1020.0,"xmax":2540.0,"ymax":2039.0},{"id":24,"contenttext":"本來は山そのも","xmin":2488.0,"ymin":2049.0,"xmax":2532.0,"ymax":2297.0},{"id":25,"contenttext":"のを拜んだものと申されて居ります。","xmin":2429.0,"ymin":580.0,"xmax":2477.0,"ymax":1146.0},{"id":26,"contenttext":"卽ち山そのものが社であります。","xmin":2429.0,"ymin":1158.0,"xmax":2471.0,"ymax":1660.0},{"id":27,"contenttext":"屋の代りであります。","xmin":2429.0,"ymin":1673.0,"xmax":2471.0,"ymax":2007.0},{"id":28,"contenttext":"それが卽ち神籬で","xmin":2425.0,"ymin":2014.0,"xmax":2469.0,"ymax":2295.0},{"id":29,"contenttext":";","xmin":2395.0,"ymin":1073.0,"xmax":2422.0,"ymax":1132.0},{"id":30,"contenttext":"あります。","xmin":2365.0,"ymin":578.0,"xmax":2406.0,"ymax":735.0},{"id":31,"contenttext":"それでありますから神經といふのはいろ〓〓の場合があります。","xmin":2357.0,"ymin":745.0,"xmax":2408.0,"ymax":1727.0},{"id":32,"contenttext":"崇神天皇樣が天照大御神樣の御魂の御鏡と御劍とを、","xmin":2288.0,"ymin":606.0,"xmax":2338.0,"ymax":1421.0},{"id":33,"contenttext":"大和の笠縫邑に磯城、","xmin":2286.0,"ymin":1429.0,"xmax":2332.0,"ymax":1781.0},{"id":34,"contenttext":"神籬を立てゝ祭りたまふといふこ","xmin":2282.0,"ymin":1772.0,"xmax":2329.0,"ymax":2293.0},{"id":35,"contenttext":"とが書いてありますが、","xmin":2224.0,"ymin":576.0,"xmax":2269.0,"ymax":939.0},{"id":36,"contenttext":"その時の神籬といふのは詰り社殿があつたのであります。","xmin":2219.0,"ymin":952.0,"xmax":2269.0,"ymax":1833.0},{"id":37,"contenttext":"その中に鏡と御劍を御納めに","xmin":2217.0,"ymin":1844.0,"xmax":2263.0,"ymax":2295.0},{"id":38,"contenttext":"+","xmin":2193.0,"ymin":1110.0,"xmax":2208.0,"ymax":1146.0},{"id":39,"contenttext":"なつたものと思はれます。そして豊鉏入比賣命をして御仕へせしめられました。","xmin":2150.0,"ymin":574.0,"xmax":2193.0,"ymax":1798.0},{"id":40,"contenttext":"それが伊勢の大神宮の起りであ","xmin":2145.0,"ymin":1808.0,"xmax":2196.0,"ymax":2293.0},{"id":41,"contenttext":"ります。","xmin":2094.0,"ymin":575.0,"xmax":2133.0,"ymax":697.0},{"id":42,"contenttext":"大神宮の御宮の造り方を御覽になりますと、","xmin":2087.0,"ymin":708.0,"xmax":2133.0,"ymax":1384.0},{"id":43,"contenttext":"あれは神明造と申します。","xmin":2087.0,"ymin":1398.0,"xmax":2129.0,"ymax":1794.0},{"id":44,"contenttext":"大神宮は日本の總氏神であらせ","xmin":2081.0,"ymin":1806.0,"xmax":2127.0,"ymax":2291.0},{"id":45,"contenttext":"られ、","xmin":2023.0,"ymin":575.0,"xmax":2067.0,"ymax":664.0},{"id":46,"contenttext":"皇室の御祖先の偉大なる神樣でありますから、","xmin":2020.0,"ymin":677.0,"xmax":2068.0,"ymax":1386.0},{"id":47,"contenttext":"その社殿といふものは大きなーそれこそ大きなものが出來","xmin":2013.0,"ymin":1396.0,"xmax":2063.0,"ymax":2291.0},{"id":48,"contenttext":"て宜い筈でありますけれども、","xmin":1952.0,"ymin":576.0,"xmax":1998.0,"ymax":1038.0},{"id":49,"contenttext":"併しそれがさうでなくて、矢張り御神殿は森嚴で、極く小さいお屋代であります。","xmin":1946.0,"ymin":1050.0,"xmax":1996.0,"ymax":2272.0},{"id":50,"contenttext":"それが上代の神籬であります。","xmin":1884.0,"ymin":606.0,"xmax":1930.0,"ymax":1075.0},{"id":51,"contenttext":"盤","xmin":1807.0,"ymin":2177.0,"xmax":1868.0,"ymax":2247.0},{"id":52,"contenttext":"'","xmin":1845.0,"ymin":2238.0,"xmax":1861.0,"ymax":2256.0},{"id":53,"contenttext":"§","xmin":1851.0,"ymin":1019.0,"xmax":1866.0,"ymax":1056.0},{"id":54,"contenttext":"倉","xmin":1807.0,"ymin":2247.0,"xmax":1851.0,"ymax":2293.0},{"id":55,"contenttext":"それから磐境といふことは磐は座といふことであります。","xmin":1811.0,"ymin":608.0,"xmax":1858.0,"ymax":1485.0},{"id":56,"contenttext":"今日でもいろ〓〓のものをくらと申します。","xmin":1807.0,"ymin":1496.0,"xmax":1851.0,"ymax":2173.0},{"id":57,"contenttext":"盤","xmin":1807.0,"ymin":2177.0,"xmax":1868.0,"ymax":2247.0},{"id":58,"contenttext":"'","xmin":1845.0,"ymin":2238.0,"xmax":1861.0,"ymax":2256.0},{"id":59,"contenttext":"倉","xmin":1807.0,"ymin":2247.0,"xmax":1851.0,"ymax":2293.0},{"id":60,"contenttext":"今日でもいろ〓〓のものをくらと申します。","xmin":1807.0,"ymin":1496.0,"xmax":1851.0,"ymax":2173.0},{"id":61,"contenttext":"庫の倉、","xmin":1623.0,"ymin":555.0,"xmax":1671.0,"ymax":684.0},{"id":62,"contenttext":"馬の鞍などそれであります。","xmin":1618.0,"ymin":694.0,"xmax":1667.0,"ymax":1130.0},{"id":63,"contenttext":"總てくらといふのは物を置くところであります。","xmin":1610.0,"ymin":1140.0,"xmax":1662.0,"ymax":1884.0},{"id":64,"contenttext":"こゝに机がございますが","xmin":1605.0,"ymin":1898.0,"xmax":1651.0,"ymax":2277.0},{"id":65,"contenttext":"蠶といふのは天岩屋戸だの何だのと言つて、","xmin":1527.0,"ymin":1273.0,"xmax":1609.0,"ymax":1952.0},{"id":66,"contenttext":"これなども國語で言ひますとくらであります。","xmin":1552.0,"ymin":560.0,"xmax":1600.0,"ymax":1266.0},{"id":67,"contenttext":"堅固の意味に盛んに","xmin":1536.0,"ymin":1961.0,"xmax":1586.0,"ymax":2277.0},{"id":68,"contenttext":"堅盤は堅い〓といふ意味であります。","xmin":1468.0,"ymin":1479.0,"xmax":1537.0,"ymax":2054.0},{"id":69,"contenttext":"〓塲と言ひま","xmin":1466.0,"ymin":2060.0,"xmax":1530.0,"ymax":2276.0},{"id":70,"contenttext":"a","xmin":1521.0,"ymin":881.0,"xmax":1540.0,"ymax":918.0},{"id":71,"contenttext":"常盤は常盤、","xmin":1480.0,"ymin":1274.0,"xmax":1537.0,"ymax":1473.0},{"id":72,"contenttext":"t","xmin":1518.0,"ymin":1382.0,"xmax":1533.0,"ymax":1400.0},{"id":73,"contenttext":"は","xmin":1512.0,"ymin":1498.0,"xmax":1533.0,"ymax":1537.0},{"id":74,"contenttext":"使ひます。","xmin":1491.0,"ymin":555.0,"xmax":1532.0,"ymax":712.0},{"id":75,"contenttext":"「常盤に堅盤に」","xmin":1485.0,"ymin":739.0,"xmax":1530.0,"ymax":993.0},{"id":76,"contenttext":"とも言ひますが、","xmin":1480.0,"ymin":1001.0,"xmax":1528.0,"ymax":1262.0},{"id":77,"contenttext":"(","xmin":1456.0,"ymin":1001.0,"xmax":1472.0,"ymax":1040.0},{"id":78,"contenttext":"すと堅固な動かないところの境といふ意味であります。","xmin":1410.0,"ymin":555.0,"xmax":1467.0,"ymax":1402.0},{"id":79,"contenttext":"動かないところの座であります。","xmin":1401.0,"ymin":1409.0,"xmax":1456.0,"ymax":1915.0},{"id":80,"contenttext":"それは神樣がそこに御","xmin":1399.0,"ymin":1926.0,"xmax":1447.0,"ymax":2277.0},{"id":81,"contenttext":"かういふ譯で整境","xmin":1334.0,"ymin":1686.0,"xmax":1395.0,"ymax":1963.0},{"id":82,"contenttext":"鎭座なさるゝところでありますから、","xmin":1345.0,"ymin":553.0,"xmax":1396.0,"ymax":1125.0},{"id":83,"contenttext":"動かない實に堅固な座であります。","xmin":1337.0,"ymin":1135.0,"xmax":1388.0,"ymax":1673.0},{"id":84,"contenttext":"は神籬の座になるの","xmin":1330.0,"ymin":1962.0,"xmax":1377.0,"ymax":2272.0},{"id":85,"contenttext":"神籠盤境といふのは今日の神社であります。","xmin":1272.0,"ymin":791.0,"xmax":1341.0,"ymax":1469.0},{"id":86,"contenttext":"Pay","xmin":1314.0,"ymin":792.0,"xmax":1340.0,"ymax":851.0},{"id":87,"contenttext":"(","xmin":1318.0,"ymin":897.0,"xmax":1334.0,"ymax":936.0},{"id":88,"contenttext":"でありまして、","xmin":1283.0,"ymin":555.0,"xmax":1326.0,"ymax":779.0},{"id":89,"contenttext":"天孫が降臨遊ばす時に高御產巢日神が天兒屋命、","xmin":1260.0,"ymin":1476.0,"xmax":1317.0,"ymax":2255.0},{"id":90,"contenttext":"布刀王命といふ神樣に仰せになりました。","xmin":1205.0,"ymin":549.0,"xmax":1261.0,"ymax":1191.0},{"id":91,"contenttext":"汝天兒屋命、","xmin":1138.0,"ymin":583.0,"xmax":1204.0,"ymax":780.0},{"id":92,"contenttext":"亦吾孫の爲に齋き奉れ","xmin":1124.0,"ymin":1648.0,"xmax":1185.0,"ymax":1999.0},{"id":93,"contenttext":"太玉命、","xmin":1142.0,"ymin":791.0,"xmax":1186.0,"ymax":916.0},{"id":94,"contenttext":"宜しく天の神籬を持ちて葦原中つ國に降りて、","xmin":1128.0,"ymin":927.0,"xmax":1185.0,"ymax":1636.0},{"id":95,"contenttext":"かういふことを仰せになつて居ります。","xmin":1067.0,"ymin":587.0,"xmax":1117.0,"ymax":1187.0},{"id":96,"contenttext":"これが右の次第で神社を立てゝ祭れと仰せになつたのであります。","xmin":1053.0,"ymin":1202.0,"xmax":1113.0,"ymax":2218.0},{"id":97,"contenttext":"か","xmin":1054.0,"ymin":2230.0,"xmax":1093.0,"ymax":2267.0},{"id":98,"contenttext":"くて敬神崇祖は最も重要な皇國傳統の精神となつたのであります。","xmin":993.0,"ymin":550.0,"xmax":1050.0,"ymax":1566.0},{"id":99,"contenttext":"尙.","xmin":939.0,"ymin":582.0,"xmax":982.0,"ymax":640.0},{"id":100,"contenttext":"今日は神社といふのを宮と申します。","xmin":930.0,"ymin":648.0,"xmax":980.0,"ymax":1220.0},{"id":101,"contenttext":"宮は今社でありますが、","xmin":925.0,"ymin":1230.0,"xmax":974.0,"ymax":1597.0},{"id":102,"contenttext":"宮は御屋といふことであります。","xmin":920.0,"ymin":1607.0,"xmax":967.0,"ymax":2113.0},{"id":103,"contenttext":"宮といふ","xmin":917.0,"ymin":2122.0,"xmax":958.0,"ymax":2265.0},{"id":104,"contenttext":"のは家がある場合であります。","xmin":862.0,"ymin":549.0,"xmax":916.0,"ymax":1017.0},{"id":105,"contenttext":"社は榮樹一本でも社になります。","xmin":854.0,"ymin":1025.0,"xmax":910.0,"ymax":1530.0},{"id":106,"contenttext":"宮といふのは御殿といふ意味であります。","xmin":848.0,"ymin":1538.0,"xmax":899.0,"ymax":2182.0},{"id":107,"contenttext":"それ","xmin":846.0,"ymin":2191.0,"xmax":889.0,"ymax":2267.0},{"id":108,"contenttext":"でこの宮といふのは、","xmin":793.0,"ymin":549.0,"xmax":843.0,"ymax":880.0},{"id":109,"contenttext":"昔は現人神と申しまして、","xmin":791.0,"ymin":885.0,"xmax":838.0,"ymax":1288.0},{"id":110,"contenttext":"人格を持つておいでになる神樣のお住みになるところで、","xmin":775.0,"ymin":1302.0,"xmax":834.0,"ymax":2181.0},{"id":111,"contenttext":"今日","xmin":777.0,"ymin":2191.0,"xmax":818.0,"ymax":2263.0},{"id":112,"contenttext":"모든","xmin":754.0,"ymin":1161.0,"xmax":781.0,"ymax":1221.0},{"id":113,"contenttext":"の出雲大社は昔は日隅と申しました。","xmin":724.0,"ymin":548.0,"xmax":773.0,"ymax":1151.0},{"id":114,"contenttext":"日〓宮といふのは日はひもうぎのひがみと通ずると申しましたが、","xmin":707.0,"ymin":1163.0,"xmax":766.0,"ymax":2179.0},{"id":115,"contenttext":"やは","xmin":709.0,"ymin":2189.0,"xmax":751.0,"ymax":2267.0},{"id":116,"contenttext":"りみですみといふのは、","xmin":655.0,"ymin":544.0,"xmax":707.0,"ymax":910.0},{"id":117,"contenttext":"すにマ行の變化を付けて活用することにしたのであります。","xmin":644.0,"ymin":918.0,"xmax":703.0,"ymax":1839.0},{"id":118,"contenttext":"本來はすといふのでありま","xmin":639.0,"ymin":1848.0,"xmax":689.0,"ymax":2263.0},{"id":119,"contenttext":"す。すといふのは今日の住すといふことであります。","xmin":578.0,"ymin":544.0,"xmax":640.0,"ymax":1354.0},{"id":120,"contenttext":"で、","xmin":582.0,"ymin":1364.0,"xmax":626.0,"ymax":1424.0},{"id":121,"contenttext":"ひすのみやは「御住ひの宮」といふことであります。","xmin":572.0,"ymin":1433.0,"xmax":625.0,"ymax":2244.0},{"id":122,"contenttext":"皇國傳統の精神","xmin":528.0,"ymin":724.0,"xmax":568.0,"ymax":938.0},{"id":123,"contenttext":"元","xmin":513.0,"ymin":2168.0,"xmax":548.0,"ymax":2205.0},{"id":124,"contenttext":"か","xmin":1054.0,"ymin":2230.0,"xmax":1093.0,"ymax":2267.0}]