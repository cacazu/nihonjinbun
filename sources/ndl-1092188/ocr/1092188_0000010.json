[{"id":0,"contenttext":"云","xmin":2933.0,"ymin":2193.0,"xmax":2965.0,"ymax":2228.0},{"id":1,"contenttext":"皇國傳統の精神","xmin":2935.0,"ymin":749.0,"xmax":2972.0,"ymax":962.0},{"id":2,"contenttext":"人に踏まれて終ふ。","xmin":2863.0,"ymin":569.0,"xmax":2913.0,"ymax":864.0},{"id":3,"contenttext":"こゝに人が轉つて居るから踏んではいけないぞ、","xmin":2862.0,"ymin":878.0,"xmax":2906.0,"ymax":1615.0},{"id":4,"contenttext":"と言つたところが、","xmin":2861.0,"ymin":1629.0,"xmax":2906.0,"ymax":1925.0},{"id":5,"contenttext":"徹底しませぬ。","xmin":2860.0,"ymin":1936.0,"xmax":2907.0,"ymax":2166.0},{"id":6,"contenttext":"足の下","xmin":2859.0,"ymin":2177.0,"xmax":2905.0,"ymax":2284.0},{"id":7,"contenttext":"に踏まれて蹂躪されて、","xmin":2794.0,"ymin":569.0,"xmax":2845.0,"ymax":932.0},{"id":8,"contenttext":"臟腑も何も出て終つて動きが取れませぬ。","xmin":2794.0,"ymin":940.0,"xmax":2841.0,"ymax":1583.0},{"id":9,"contenttext":"日本國民が過去幾千年來今日の發展を遂げま","xmin":2790.0,"ymin":1597.0,"xmax":2841.0,"ymax":2286.0},{"id":10,"contenttext":"すのには矢張りこの傳統の精神で日本國民がずつと來て居るのです。","xmin":2725.0,"ymin":567.0,"xmax":2774.0,"ymax":1618.0},{"id":11,"contenttext":"今日でも日々現在旣に一分間、","xmin":2725.0,"ymin":1627.0,"xmax":2767.0,"ymax":2094.0},{"id":12,"contenttext":"一分間歷史","xmin":2725.0,"ymin":2119.0,"xmax":2769.0,"ymax":2288.0},{"id":13,"contenttext":"を作り出しつゝある。","xmin":2661.0,"ymin":569.0,"xmax":2704.0,"ymax":895.0},{"id":14,"contenttext":"その間に矢張りこの日本精神、","xmin":2660.0,"ymin":911.0,"xmax":2704.0,"ymax":1375.0},{"id":15,"contenttext":"傳統の精神がずつと生きつゝある。","xmin":2658.0,"ymin":1389.0,"xmax":2702.0,"ymax":1923.0},{"id":16,"contenttext":"その中の一人が反對の","xmin":2655.0,"ymin":1938.0,"xmax":2702.0,"ymax":2286.0},{"id":17,"contenttext":"方向へ行かうと思つても行かれやしませぬ。","xmin":2589.0,"ymin":567.0,"xmax":2638.0,"ymax":1243.0},{"id":18,"contenttext":"難波大助の如き幸德秋水の如き、","xmin":2589.0,"ymin":1251.0,"xmax":2634.0,"ymax":1754.0},{"id":19,"contenttext":"あゝいふ者がこの傳統の精神に反","xmin":2589.0,"ymin":1768.0,"xmax":2633.0,"ymax":2284.0},{"id":20,"contenttext":"抗して行かうと思つたものですから今申した如く踏み潰されて終ふ。","xmin":2521.0,"ymin":567.0,"xmax":2570.0,"ymax":1615.0},{"id":21,"contenttext":"生存出來ませぬ。","xmin":2522.0,"ymin":1629.0,"xmax":2566.0,"ymax":1891.0},{"id":22,"contenttext":"ですからして日本國民は","xmin":2522.0,"ymin":1903.0,"xmax":2563.0,"ymax":2284.0},{"id":23,"contenttext":"何んでもこの傳統の精神で以て進んで行くのであります。","xmin":2452.0,"ymin":567.0,"xmax":2503.0,"ymax":1447.0},{"id":24,"contenttext":"ところが多くの人はそれを知らないでやつて居る。","xmin":2452.0,"ymin":1458.0,"xmax":2497.0,"ymax":2235.0},{"id":25,"contenttext":"體人間は知つてすると知らないでするといふことは、","xmin":2384.0,"ymin":567.0,"xmax":2433.0,"ymax":1378.0},{"id":26,"contenttext":"そこに非常な差があります。","xmin":2383.0,"ymin":1391.0,"xmax":2425.0,"ymax":1822.0},{"id":27,"contenttext":"例へばあなた方は御飯を召上","xmin":2381.0,"ymin":1831.0,"xmax":2426.0,"ymax":2288.0},{"id":28,"contenttext":"る。","xmin":2325.0,"ymin":569.0,"xmax":2359.0,"ymax":622.0},{"id":29,"contenttext":"私も食べます。","xmin":2319.0,"ymin":634.0,"xmax":2362.0,"ymax":864.0},{"id":30,"contenttext":"苛くも人間である以上は「私は御飯を食べません」といふ人間はありませぬ。","xmin":2313.0,"ymin":872.0,"xmax":2361.0,"ymax":2062.0},{"id":31,"contenttext":"それは御飯を","xmin":2314.0,"ymin":2074.0,"xmax":2356.0,"ymax":2286.0},{"id":32,"contenttext":"食べなければパンを食べる。","xmin":2249.0,"ymin":567.0,"xmax":2299.0,"ymax":1001.0},{"id":33,"contenttext":"パンを食べなければ果物を食べる。","xmin":2249.0,"ymin":1011.0,"xmax":2295.0,"ymax":1546.0},{"id":34,"contenttext":"何か食べます。","xmin":2249.0,"ymin":1560.0,"xmax":2293.0,"ymax":1787.0},{"id":35,"contenttext":"だからそれを總稱して御飯と言","xmin":2247.0,"ymin":1798.0,"xmax":2292.0,"ymax":2286.0},{"id":36,"contenttext":"ひます。","xmin":2183.0,"ymin":569.0,"xmax":2225.0,"ymax":692.0},{"id":37,"contenttext":"御飯を食べない人はないでせう。","xmin":2182.0,"ymin":704.0,"xmax":2228.0,"ymax":1204.0},{"id":38,"contenttext":"ところが御飯を食べるに、","xmin":2178.0,"ymin":1218.0,"xmax":2223.0,"ymax":1614.0},{"id":39,"contenttext":"今日は榮養〓究といふものがよく發達して","xmin":2177.0,"ymin":1627.0,"xmax":2221.0,"ymax":2282.0},{"id":40,"contenttext":"參りましたが、","xmin":2115.0,"ymin":566.0,"xmax":2156.0,"ymax":793.0},{"id":41,"contenttext":"その榮養の〓究、","xmin":2113.0,"ymin":805.0,"xmax":2158.0,"ymax":1070.0},{"id":42,"contenttext":"その他御飯を食べる目的です。","xmin":2111.0,"ymin":1080.0,"xmax":2158.0,"ymax":1549.0},{"id":43,"contenttext":"さういふことを自覺して食べると食べないとは","xmin":2109.0,"ymin":1560.0,"xmax":2155.0,"ymax":2284.0},{"id":44,"contenttext":"大變な違ひがある。","xmin":2046.0,"ymin":566.0,"xmax":2092.0,"ymax":862.0},{"id":45,"contenttext":"唯無茶苦茶に食べる。","xmin":2046.0,"ymin":874.0,"xmax":2092.0,"ymax":1204.0},{"id":46,"contenttext":"一體御飯を何の爲に食べるか。","xmin":2043.0,"ymin":1225.0,"xmax":2089.0,"ymax":1683.0},{"id":47,"contenttext":"さういふことを考へて居る人がありま","xmin":2043.0,"ymin":1697.0,"xmax":2087.0,"ymax":2284.0},{"id":48,"contenttext":"すかどうですか。","xmin":1976.0,"ymin":566.0,"xmax":2020.0,"ymax":827.0},{"id":49,"contenttext":"昔ギリシヤのソクラテスといふ人は","xmin":1974.0,"ymin":837.0,"xmax":2018.0,"ymax":1394.0},{"id":50,"contenttext":"「吾々は食はんが爲に生きるのでなくして、","xmin":1970.0,"ymin":1398.0,"xmax":2017.0,"ymax":2060.0},{"id":51,"contenttext":"生きんが爲に","xmin":1972.0,"ymin":2071.0,"xmax":2015.0,"ymax":2282.0},{"id":52,"contenttext":"食ふのだ」","xmin":1909.0,"ymin":564.0,"xmax":1953.0,"ymax":733.0},{"id":53,"contenttext":"かういふことを言ひました。","xmin":1909.0,"ymin":735.0,"xmax":1951.0,"ymax":1169.0},{"id":54,"contenttext":"簡單なことですけれども、","xmin":1903.0,"ymin":1180.0,"xmax":1951.0,"ymax":1580.0},{"id":55,"contenttext":"それがチョット多くの人に分らない。","xmin":1903.0,"ymin":1592.0,"xmax":1948.0,"ymax":2163.0},{"id":56,"contenttext":"食はん","xmin":1905.0,"ymin":2173.0,"xmax":1948.0,"ymax":2284.0},{"id":57,"contenttext":"が爲に生きて居る人が澤山ある。","xmin":1840.0,"ymin":566.0,"xmax":1884.0,"ymax":1065.0},{"id":58,"contenttext":"嘗て茨城縣の土浦で靑年が集りまして、","xmin":1836.0,"ymin":1075.0,"xmax":1882.0,"ymax":1683.0},{"id":59,"contenttext":"汁粉の食べ合ひをやらうといふことを","xmin":1835.0,"ymin":1692.0,"xmax":1879.0,"ymax":2286.0},{"id":60,"contenttext":"發議したところ直に賛成がありました、","xmin":1599.0,"ymin":585.0,"xmax":1649.0,"ymax":1192.0},{"id":61,"contenttext":"二十杯食べた者には一等賞をやると云ふのであつたさうです。","xmin":1589.0,"ymin":1205.0,"xmax":1643.0,"ymax":2152.0},{"id":62,"contenttext":"それで寄","xmin":1590.0,"ymin":2163.0,"xmax":1632.0,"ymax":2305.0},{"id":63,"contenttext":"附などで一等賞品が澤山集まりました。","xmin":1534.0,"ymin":585.0,"xmax":1581.0,"ymax":1192.0},{"id":64,"contenttext":"愈々汁粉の食べ合ひの豫定した日が來ました。","xmin":1527.0,"ymin":1202.0,"xmax":1578.0,"ymax":1913.0},{"id":65,"contenttext":"我れと思はん者は來い、","xmin":1525.0,"ymin":1923.0,"xmax":1570.0,"ymax":2289.0},{"id":66,"contenttext":"といふので靑年が集りまして食べる。","xmin":1468.0,"ymin":587.0,"xmax":1517.0,"ymax":1158.0},{"id":67,"contenttext":"中には八杯食べる、","xmin":1465.0,"ymin":1169.0,"xmax":1509.0,"ymax":1466.0},{"id":68,"contenttext":"九杯食べる、","xmin":1460.0,"ymin":1478.0,"xmax":1510.0,"ymax":1672.0},{"id":69,"contenttext":"中々汁粉といふものは餘計食べられない","xmin":1454.0,"ymin":1681.0,"xmax":1505.0,"ymax":2302.0},{"id":70,"contenttext":"ものです。","xmin":1405.0,"ymin":585.0,"xmax":1445.0,"ymax":744.0},{"id":71,"contenttext":"東京の銀座では以前に十二杯以上食べた人にはお錢は戴きません、","xmin":1392.0,"ymin":756.0,"xmax":1448.0,"ymax":1772.0},{"id":72,"contenttext":"かういふことをやつたといふので","xmin":1387.0,"ymin":1785.0,"xmax":1434.0,"ymax":2302.0},{"id":73,"contenttext":"す。","xmin":1340.0,"ymin":585.0,"xmax":1378.0,"ymax":642.0},{"id":74,"contenttext":"一杯十錢とすれば十二杯で一圓二十錢、","xmin":1329.0,"ymin":658.0,"xmax":1380.0,"ymax":1259.0},{"id":75,"contenttext":"一圓二十錢只で宜しいと云ふのであります。","xmin":1322.0,"ymin":1279.0,"xmax":1373.0,"ymax":1944.0},{"id":76,"contenttext":"若い者が","xmin":1318.0,"ymin":1951.0,"xmax":1366.0,"ymax":2099.0},{"id":77,"contenttext":"「俺は行つて","xmin":1317.0,"ymin":2102.0,"xmax":1365.0,"ymax":2301.0},{"id":78,"contenttext":"十二杯食べてやらう」といふので行くさうでありますが、","xmin":1257.0,"ymin":585.0,"xmax":1311.0,"ymax":1461.0},{"id":79,"contenttext":"大抵七杯か八杯、","xmin":1255.0,"ymin":1473.0,"xmax":1303.0,"ymax":1736.0},{"id":80,"contenttext":"十杯位で閉ロして終ふ。","xmin":1250.0,"ymin":1748.0,"xmax":1301.0,"ymax":2116.0},{"id":81,"contenttext":"さうすると","xmin":1255.0,"ymin":2129.0,"xmax":1292.0,"ymax":2300.0},{"id":82,"contenttext":"一圓位出さなければならぬ。","xmin":1193.0,"ymin":594.0,"xmax":1242.0,"ymax":1024.0},{"id":83,"contenttext":"(笑聲)","xmin":1195.0,"ymin":1020.0,"xmax":1239.0,"ymax":1140.0},{"id":84,"contenttext":"普通ならば一杯か二杯ですから十錢か二十錢で濟むのでせうが、","xmin":1182.0,"ymin":1165.0,"xmax":1239.0,"ymax":2149.0},{"id":85,"contenttext":"それを無","xmin":1181.0,"ymin":2157.0,"xmax":1222.0,"ymax":2301.0},{"id":86,"contenttext":"理に食べるのですから十杯位食べても十二杯食べられないものですから一圓出さなければならぬ。","xmin":1114.0,"ymin":583.0,"xmax":1173.0,"ymax":2076.0},{"id":87,"contenttext":"大變その汁粉","xmin":1112.0,"ymin":2086.0,"xmax":1160.0,"ymax":2302.0},{"id":88,"contenttext":"屋は儲けたといふことです。","xmin":1057.0,"ymin":581.0,"xmax":1108.0,"ymax":1015.0},{"id":89,"contenttext":"その茨城縣の土浦では靑年が集つて食べたが、","xmin":1051.0,"ymin":1025.0,"xmax":1103.0,"ymax":1734.0},{"id":90,"contenttext":"ところが中々食べられない。","xmin":1046.0,"ymin":1746.0,"xmax":1093.0,"ymax":2177.0},{"id":91,"contenttext":"豪傑で","xmin":1044.0,"ymin":2190.0,"xmax":1091.0,"ymax":2299.0},{"id":92,"contenttext":"も十二三杯で閉口して終う。","xmin":990.0,"ymin":581.0,"xmax":1037.0,"ymax":1011.0},{"id":93,"contenttext":"ところが一人の者は「なにやり切れないことはない」といふので終ひには箸で咽へ","xmin":973.0,"ymin":1027.0,"xmax":1034.0,"ymax":2293.0},{"id":94,"contenttext":"おし込むやうにして到頭ニ一十杯やつたといふのです。","xmin":913.0,"ymin":581.0,"xmax":971.0,"ymax":1391.0},{"id":95,"contenttext":"(笑聲)","xmin":911.0,"ymin":1394.0,"xmax":962.0,"ymax":1516.0},{"id":96,"contenttext":"それで一等賞を貰つたといふ。","xmin":907.0,"ymin":1537.0,"xmax":959.0,"ymax":2008.0},{"id":97,"contenttext":"一等賞貰つたとい","xmin":905.0,"ymin":2029.0,"xmax":953.0,"ymax":2297.0},{"id":98,"contenttext":"のは宜いのですけれども、","xmin":847.0,"ymin":583.0,"xmax":899.0,"ymax":977.0},{"id":99,"contenttext":"一時間ばかり經ちますと眼の色が變つて來た。","xmin":841.0,"ymin":999.0,"xmax":895.0,"ymax":1699.0},{"id":100,"contenttext":"何だか樣子が變だといふので、","xmin":835.0,"ymin":1709.0,"xmax":887.0,"ymax":2179.0},{"id":101,"contenttext":"それか","xmin":835.0,"ymin":2189.0,"xmax":879.0,"ymax":2298.0},{"id":102,"contenttext":"ら早速お醫者さんに驅け付けるやら大騷ぎ致しましたところが、","xmin":773.0,"ymin":579.0,"xmax":829.0,"ymax":1558.0},{"id":103,"contenttext":"お醫者さんが來ていろ〓〓診斷致しますと急性","xmin":766.0,"ymin":1574.0,"xmax":817.0,"ymax":2299.0},{"id":104,"contenttext":"腹膜炎だといふのです。","xmin":710.0,"ymin":578.0,"xmax":763.0,"ymax":945.0},{"id":105,"contenttext":"それで間もなく死んで終つたといふ。","xmin":704.0,"ymin":953.0,"xmax":758.0,"ymax":1525.0},{"id":106,"contenttext":"詰りその靑年はこの世に二十杯の汁粉を食べに生","xmin":699.0,"ymin":1535.0,"xmax":748.0,"ymax":2297.0},{"id":107,"contenttext":"れて來たやうなものです。","xmin":644.0,"ymin":578.0,"xmax":693.0,"ymax":975.0},{"id":108,"contenttext":"(笑聲)","xmin":645.0,"ymin":983.0,"xmax":689.0,"ymax":1100.0},{"id":109,"contenttext":"さういふ人が往々にして世にあります。","xmin":637.0,"ymin":1126.0,"xmax":686.0,"ymax":1729.0},{"id":110,"contenttext":"ソクラテスの言ひました通り、","xmin":634.0,"ymin":1743.0,"xmax":677.0,"ymax":2207.0},{"id":111,"contenttext":"吾は","xmin":633.0,"ymin":2219.0,"xmax":675.0,"ymax":2297.0},{"id":112,"contenttext":"食はんが爲に生きるのでなしに、","xmin":575.0,"ymin":574.0,"xmax":626.0,"ymax":1077.0},{"id":113,"contenttext":"生きんが爲に食ふのである。","xmin":570.0,"ymin":1087.0,"xmax":621.0,"ymax":1521.0},{"id":114,"contenttext":"生きて何をするかと言へば、","xmin":566.0,"ymin":1531.0,"xmax":617.0,"ymax":1969.0},{"id":115,"contenttext":"生きて人生の理想を","xmin":563.0,"ymin":1979.0,"xmax":608.0,"ymax":2295.0},{"id":116,"contenttext":"皇國傳統の精神","xmin":509.0,"ymin":754.0,"xmax":555.0,"ymax":968.0},{"id":117,"contenttext":"三","xmin":497.0,"ymin":2198.0,"xmax":534.0,"ymax":2235.0}]