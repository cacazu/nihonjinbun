[{"id":0,"contenttext":"皇國傳統の精神","xmin":2934.0,"ymin":770.0,"xmax":2979.0,"ymax":986.0},{"id":1,"contenttext":"畳","xmin":2924.0,"ymin":2214.0,"xmax":2957.0,"ymax":2252.0},{"id":2,"contenttext":"ます。","xmin":2875.0,"ymin":590.0,"xmax":2913.0,"ymax":681.0},{"id":3,"contenttext":"王道といふのは詰り儒〓の理想の道であります、","xmin":2861.0,"ymin":692.0,"xmax":2917.0,"ymax":1435.0},{"id":4,"contenttext":"その王道といふのはどういふのであるかと申しますと、","xmin":2850.0,"ymin":1445.0,"xmax":2906.0,"ymax":2290.0},{"id":5,"contenttext":"『書經」","xmin":2801.0,"ymin":600.0,"xmax":2848.0,"ymax":720.0},{"id":6,"contenttext":"の洪範といふところに書いてあります。","xmin":2795.0,"ymin":728.0,"xmax":2843.0,"ymax":1329.0},{"id":7,"contenttext":"王道蕩々。","xmin":2732.0,"ymin":656.0,"xmax":2778.0,"ymax":813.0},{"id":8,"contenttext":"無偏無黨。","xmin":2728.0,"ymin":826.0,"xmax":2775.0,"ymax":989.0},{"id":9,"contenttext":"王道平々。","xmin":2728.0,"ymin":998.0,"xmax":2772.0,"ymax":1158.0},{"id":10,"contenttext":"無反無側。","xmin":2727.0,"ymin":1170.0,"xmax":2771.0,"ymax":1327.0},{"id":11,"contenttext":"王道正直。","xmin":2722.0,"ymin":1339.0,"xmax":2769.0,"ymax":1500.0},{"id":12,"contenttext":"會其有極。","xmin":2720.0,"ymin":1510.0,"xmax":2768.0,"ymax":1671.0},{"id":13,"contenttext":"歸其有極。","xmin":2718.0,"ymin":1683.0,"xmax":2766.0,"ymax":1844.0},{"id":14,"contenttext":"王道といふのはいろ〓〓の說明がありますけれども、","xmin":2653.0,"ymin":616.0,"xmax":2708.0,"ymax":1426.0},{"id":15,"contenttext":"この言葉が一番良く明かに說明せられて居ります。","xmin":2645.0,"ymin":1441.0,"xmax":2698.0,"ymax":2218.0},{"id":16,"contenttext":"「王","xmin":2647.0,"ymin":2244.0,"xmax":2686.0,"ymax":2301.0},{"id":17,"contenttext":"道蕩々」といふのは、","xmin":2587.0,"ymin":583.0,"xmax":2639.0,"ymax":919.0},{"id":18,"contenttext":"極く廣く廣々として居りまして極く簡易といふ意味であります。","xmin":2576.0,"ymin":924.0,"xmax":2634.0,"ymax":1911.0},{"id":19,"contenttext":"「無偏無黨」といふのは","xmin":2572.0,"ymin":1936.0,"xmax":2621.0,"ymax":2304.0},{"id":20,"contenttext":"一方に偏しない、","xmin":2524.0,"ymin":592.0,"xmax":2566.0,"ymax":846.0},{"id":21,"contenttext":"黨を立てない、","xmin":2520.0,"ymin":855.0,"xmax":2566.0,"ymax":1087.0},{"id":22,"contenttext":"それを一言に言へば私がない。","xmin":2514.0,"ymin":1096.0,"xmax":2564.0,"ymax":1567.0},{"id":23,"contenttext":"私がないのはどういふことであるかといふと、","xmin":2504.0,"ymin":1577.0,"xmax":2555.0,"ymax":2285.0},{"id":24,"contenttext":"公であります。","xmin":2453.0,"ymin":582.0,"xmax":2496.0,"ymax":809.0},{"id":25,"contenttext":"公のハの字は背くといふ字で、","xmin":2443.0,"ymin":821.0,"xmax":2501.0,"ymax":1291.0},{"id":26,"contenttext":"下のムの字は私といふ字、","xmin":2443.0,"ymin":1302.0,"xmax":2490.0,"ymax":1703.0},{"id":27,"contenttext":"私に背くといふのが公であります。","xmin":2435.0,"ymin":1713.0,"xmax":2486.0,"ymax":2254.0},{"id":28,"contenttext":"私","xmin":2434.0,"ymin":2260.0,"xmax":2478.0,"ymax":2305.0},{"id":29,"contenttext":"に沒頭するのは利己主義、","xmin":2380.0,"ymin":583.0,"xmax":2429.0,"ymax":979.0},{"id":30,"contenttext":"個人主義であつて公ではない。","xmin":2376.0,"ymin":992.0,"xmax":2425.0,"ymax":1460.0},{"id":31,"contenttext":"それで「一旦緩急アレハ義勇公ニ奉シ、","xmin":2369.0,"ymin":1471.0,"xmax":2418.0,"ymax":2078.0},{"id":32,"contenttext":"天壤無窮ノ皇","xmin":2369.0,"ymin":2087.0,"xmax":2413.0,"ymax":2304.0},{"id":33,"contenttext":"運ヲ扶翼スヘシ」と仰せられてあります。","xmin":2316.0,"ymin":580.0,"xmax":2367.0,"ymax":1220.0},{"id":34,"contenttext":"その公といふのと右の意味が同じであります。","xmin":2306.0,"ymin":1232.0,"xmax":2359.0,"ymax":1939.0},{"id":35,"contenttext":"「王道平々」といふの","xmin":2302.0,"ymin":1966.0,"xmax":2351.0,"ymax":2299.0},{"id":36,"contenttext":"は王道といふのは困難ではない、","xmin":2249.0,"ymin":581.0,"xmax":2299.0,"ymax":1082.0},{"id":37,"contenttext":"容易しいものだといふのであります。","xmin":2241.0,"ymin":1092.0,"xmax":2292.0,"ymax":1666.0},{"id":38,"contenttext":"我國の皇道が亦それであります。","xmin":2236.0,"ymin":1676.0,"xmax":2288.0,"ymax":2182.0},{"id":39,"contenttext":"容易し","xmin":2237.0,"ymin":2191.0,"xmax":2281.0,"ymax":2300.0},{"id":40,"contenttext":"いのであります。","xmin":2186.0,"ymin":583.0,"xmax":2227.0,"ymax":841.0},{"id":41,"contenttext":"日本國民は何人でもこれを行ふことが出來ます。","xmin":2175.0,"ymin":853.0,"xmax":2226.0,"ymax":1595.0},{"id":42,"contenttext":"むづかしい試驗などを受けねばならぬと云ふ","xmin":2165.0,"ymin":1609.0,"xmax":2220.0,"ymax":2301.0},{"id":43,"contenttext":"ことはないのです。","xmin":2113.0,"ymin":581.0,"xmax":2162.0,"ymax":875.0},{"id":44,"contenttext":"そこらの無〓育のおばさんでもチヤンと實行出來る。","xmin":2104.0,"ymin":884.0,"xmax":2158.0,"ymax":1696.0},{"id":45,"contenttext":"王道平々です。","xmin":2104.0,"ymin":1707.0,"xmax":2150.0,"ymax":1939.0},{"id":46,"contenttext":"「無反無側」といふ","xmin":2096.0,"ymin":1963.0,"xmax":2146.0,"ymax":2297.0},{"id":47,"contenttext":"のは偏しないことで、","xmin":2043.0,"ymin":580.0,"xmax":2092.0,"ymax":906.0},{"id":48,"contenttext":"矢張り","xmin":2043.0,"ymin":917.0,"xmax":2087.0,"ymax":1029.0},{"id":49,"contenttext":"「無黨無偏」","xmin":2039.0,"ymin":1031.0,"xmax":2088.0,"ymax":1259.0},{"id":50,"contenttext":"と同じであります。","xmin":2039.0,"ymin":1262.0,"xmax":2082.0,"ymax":1555.0},{"id":51,"contenttext":"中正を執つて行く。","xmin":2031.0,"ymin":1570.0,"xmax":2083.0,"ymax":1867.0},{"id":52,"contenttext":"「王道正直會其有極歸其有","xmin":2025.0,"ymin":1896.0,"xmax":2078.0,"ymax":2301.0},{"id":53,"contenttext":"極」","xmin":1977.0,"ymin":575.0,"xmax":2021.0,"ymax":640.0},{"id":54,"contenttext":"正直は正しくして直で、","xmin":1973.0,"ymin":642.0,"xmax":2019.0,"ymax":1006.0},{"id":55,"contenttext":"眞直ぐで曲らない。","xmin":1970.0,"ymin":1018.0,"xmax":2016.0,"ymax":1319.0},{"id":56,"contenttext":"一體我國の皇道又は神道といふものは正直を尊重する。","xmin":1958.0,"ymin":1339.0,"xmax":2016.0,"ymax":2175.0},{"id":57,"contenttext":"儒〓は","xmin":1957.0,"ymin":2185.0,"xmax":2003.0,"ymax":2297.0},{"id":58,"contenttext":"仁","xmin":1909.0,"ymin":575.0,"xmax":1953.0,"ymax":629.0},{"id":59,"contenttext":"佛〓は慈悲、","xmin":1904.0,"ymin":639.0,"xmax":1955.0,"ymax":836.0},{"id":60,"contenttext":"キリスト〓は愛、","xmin":1904.0,"ymin":850.0,"xmax":1946.0,"ymax":1109.0},{"id":61,"contenttext":"かういふやうな區別をして見ると、","xmin":1898.0,"ymin":1123.0,"xmax":1944.0,"ymax":1659.0},{"id":62,"contenttext":"神道では正直を尊重する。","xmin":1888.0,"ymin":1670.0,"xmax":1940.0,"ymax":2073.0},{"id":63,"contenttext":"鏡といふもの","xmin":1888.0,"ymin":2082.0,"xmax":1934.0,"ymax":2295.0},{"id":64,"contenttext":"を尊重する。","xmin":1837.0,"ymin":572.0,"xmax":1883.0,"ymax":767.0},{"id":65,"contenttext":"神社の大前には一般に鏡が置いてある。","xmin":1830.0,"ymin":777.0,"xmax":1880.0,"ymax":1384.0},{"id":66,"contenttext":"鏡といふものは正直の象徵なのである。","xmin":1823.0,"ymin":1394.0,"xmax":1873.0,"ymax":2004.0},{"id":67,"contenttext":"三種の神器の第一","xmin":1820.0,"ymin":2014.0,"xmax":1867.0,"ymax":2286.0},{"id":68,"contenttext":"畳","xmin":2924.0,"ymin":2214.0,"xmax":2957.0,"ymax":2252.0},{"id":69,"contenttext":"その王道といふのはどういふのであるかと申しますと、","xmin":2850.0,"ymin":1445.0,"xmax":2906.0,"ymax":2290.0},{"id":70,"contenttext":"に鏡が擧げてありますが、","xmin":1594.0,"ymin":574.0,"xmax":1643.0,"ymax":971.0},{"id":71,"contenttext":"鏡といふものは所謂偏なく黨なく私がない。","xmin":1597.0,"ymin":978.0,"xmax":1643.0,"ymax":1655.0},{"id":72,"contenttext":"非常に美しいものが行くと、","xmin":1599.0,"ymin":1667.0,"xmax":1644.0,"ymax":2101.0},{"id":73,"contenttext":"これは長く","xmin":1596.0,"ymin":2114.0,"xmax":1644.0,"ymax":2290.0},{"id":74,"contenttext":"寫して置かうといふことはない。","xmin":1525.0,"ymin":571.0,"xmax":1567.0,"ymax":1072.0},{"id":75,"contenttext":"美しいものが來ても嫌やなものが來てもチヤンとそれを正直に寫す。","xmin":1525.0,"ymin":1084.0,"xmax":1574.0,"ymax":2140.0},{"id":76,"contenttext":"嫌やなも","xmin":1528.0,"ymin":2147.0,"xmax":1570.0,"ymax":2289.0},{"id":77,"contenttext":"のだから半分程寫してやらうといふやうなことはない。","xmin":1452.0,"ymin":574.0,"xmax":1501.0,"ymax":1414.0},{"id":78,"contenttext":"さういふ具合に神道は正直を尊重する。","xmin":1453.0,"ymin":1427.0,"xmax":1503.0,"ymax":2036.0},{"id":79,"contenttext":"王道もそれであ","xmin":1456.0,"ymin":2044.0,"xmax":1502.0,"ymax":2291.0},{"id":80,"contenttext":"ります。","xmin":1391.0,"ymin":573.0,"xmax":1428.0,"ymax":693.0},{"id":81,"contenttext":"「正道正直會其有極歸其有極」-「有」といふのは添へた言葉でありまして、","xmin":1387.0,"ymin":723.0,"xmax":1431.0,"ymax":1895.0},{"id":82,"contenttext":"極といふのはどういふの","xmin":1387.0,"ymin":1904.0,"xmax":1431.0,"ymax":2287.0},{"id":83,"contenttext":"であるか、","xmin":1316.0,"ymin":576.0,"xmax":1363.0,"ymax":731.0},{"id":84,"contenttext":"極といふのは極端と言ひまして、","xmin":1318.0,"ymin":742.0,"xmax":1364.0,"ymax":1246.0},{"id":85,"contenttext":"電氣なら電氣は積極と消極と言ひませう。","xmin":1318.0,"ymin":1258.0,"xmax":1364.0,"ymax":1896.0},{"id":86,"contenttext":"これ極端です。","xmin":1320.0,"ymin":1912.0,"xmax":1364.0,"ymax":2136.0},{"id":87,"contenttext":"極端です","xmin":1319.0,"ymin":2146.0,"xmax":1366.0,"ymax":2292.0},{"id":88,"contenttext":"けれども、","xmin":1250.0,"ymin":573.0,"xmax":1290.0,"ymax":730.0},{"id":89,"contenttext":"吾々はこの極端の中に更に中極といふものを認めることが出來る。","xmin":1250.0,"ymin":744.0,"xmax":1292.0,"ymax":1757.0},{"id":90,"contenttext":"電氣なら積極でも消極でもないと","xmin":1251.0,"ymin":1771.0,"xmax":1294.0,"ymax":2291.0},{"id":91,"contenttext":"ころであります。","xmin":1178.0,"ymin":576.0,"xmax":1224.0,"ymax":836.0},{"id":92,"contenttext":"神道では中極といふことを度會延佳といふ人が言つて居りますが、","xmin":1181.0,"ymin":844.0,"xmax":1227.0,"ymax":1861.0},{"id":93,"contenttext":"王道は矢張りそれです。","xmin":1180.0,"ymin":1875.0,"xmax":1229.0,"ymax":2242.0},{"id":94,"contenttext":"こ","xmin":1188.0,"ymin":2256.0,"xmax":1218.0,"ymax":2289.0},{"id":95,"contenttext":"れを中道とも言ひます。","xmin":1110.0,"ymin":573.0,"xmax":1153.0,"ymax":936.0},{"id":96,"contenttext":"佛〓では中道實相といふことを言ひますが、","xmin":1110.0,"ymin":946.0,"xmax":1156.0,"ymax":1624.0},{"id":97,"contenttext":"その中道は少し意味が遠ひますけれども、","xmin":1110.0,"ymin":1636.0,"xmax":1156.0,"ymax":2277.0},{"id":98,"contenttext":"先づ大體さういふ風であります。","xmin":1042.0,"ymin":573.0,"xmax":1084.0,"ymax":1075.0},{"id":99,"contenttext":"王道はそこであります。","xmin":1042.0,"ymin":1089.0,"xmax":1084.0,"ymax":1452.0},{"id":100,"contenttext":"その中道、","xmin":1040.0,"ymin":1464.0,"xmax":1089.0,"ymax":1626.0},{"id":101,"contenttext":"それを有極に會し、","xmin":1041.0,"ymin":1637.0,"xmax":1089.0,"ymax":1934.0},{"id":102,"contenttext":"有極に歸すと云ふので","xmin":1043.0,"ymin":1944.0,"xmax":1087.0,"ymax":2291.0},{"id":103,"contenttext":"あります。","xmin":972.0,"ymin":572.0,"xmax":1014.0,"ymax":730.0},{"id":104,"contenttext":"王道と云ふのはかう云ふ風で、","xmin":970.0,"ymin":742.0,"xmax":1020.0,"ymax":1211.0},{"id":105,"contenttext":"我國の傳統の精神と一致して居ります。","xmin":973.0,"ymin":1221.0,"xmax":1019.0,"ymax":1831.0},{"id":106,"contenttext":"曩に申しました禪讓放伐の如","xmin":973.0,"ymin":1840.0,"xmax":1019.0,"ymax":2293.0},{"id":107,"contenttext":"きは我國には斷じて容れられませぬけれども、","xmin":901.0,"ymin":575.0,"xmax":946.0,"ymax":1281.0},{"id":108,"contenttext":"それは儒〓の根本義ではないのであります。","xmin":902.0,"ymin":1294.0,"xmax":948.0,"ymax":1969.0},{"id":109,"contenttext":"されば儒〓の理想、","xmin":902.0,"ymin":1981.0,"xmax":948.0,"ymax":2274.0},{"id":110,"contenttext":"儒〓の根本義は皇國傳統の精神を示すのに適切であるのであります。","xmin":832.0,"ymin":571.0,"xmax":878.0,"ymax":1627.0},{"id":111,"contenttext":"そこで儒〓が盛んに入れられて來たのであ","xmin":834.0,"ymin":1638.0,"xmax":879.0,"ymax":2295.0},{"id":112,"contenttext":"ります。","xmin":767.0,"ymin":573.0,"xmax":807.0,"ymax":696.0},{"id":113,"contenttext":"尙この機會に儒〓の忠孝の精神に就いて論及します。","xmin":763.0,"ymin":709.0,"xmax":809.0,"ymax":1521.0},{"id":114,"contenttext":"この講習會の目次で見ますと、","xmin":765.0,"ymin":1535.0,"xmax":811.0,"ymax":2000.0},{"id":115,"contenttext":"昨日","xmin":767.0,"ymin":2013.0,"xmax":807.0,"ymax":2085.0},{"id":116,"contenttext":"『論語』","xmin":767.0,"ymin":2094.0,"xmax":811.0,"ymax":2212.0},{"id":117,"contenttext":"のお","xmin":767.0,"ymin":2221.0,"xmax":809.0,"ymax":2291.0},{"id":118,"contenttext":"話があつたやうでありますが、","xmin":696.0,"ymin":571.0,"xmax":742.0,"ymax":1040.0},{"id":119,"contenttext":"この","xmin":698.0,"ymin":1054.0,"xmax":738.0,"ymax":1123.0},{"id":120,"contenttext":"「論語』","xmin":696.0,"ymin":1133.0,"xmax":740.0,"ymax":1250.0},{"id":121,"contenttext":"を御覽になると孝行といふことが盛んに說いてございます。","xmin":698.0,"ymin":1257.0,"xmax":740.0,"ymax":2173.0},{"id":122,"contenttext":"儒〓で","xmin":698.0,"ymin":2182.0,"xmax":742.0,"ymax":2291.0},{"id":123,"contenttext":"は「孝は百行の本」","xmin":627.0,"ymin":574.0,"xmax":676.0,"ymax":876.0},{"id":124,"contenttext":"と申しますが、","xmin":629.0,"ymin":881.0,"xmax":672.0,"ymax":1110.0},{"id":125,"contenttext":"亦こゝに書いてございます通り","xmin":629.0,"ymin":1117.0,"xmax":672.0,"ymax":1606.0},{"id":126,"contenttext":"「孝は德の本」","xmin":629.0,"ymin":1613.0,"xmax":673.0,"ymax":1837.0},{"id":127,"contenttext":"と申します。","xmin":633.0,"ymin":1840.0,"xmax":672.0,"ymax":2034.0},{"id":128,"contenttext":"孝は德の基本、","xmin":631.0,"ymin":2044.0,"xmax":675.0,"ymax":2275.0},{"id":129,"contenttext":"あらゆる道德の根本であるのであります。","xmin":560.0,"ymin":575.0,"xmax":605.0,"ymax":1207.0},{"id":130,"contenttext":"そこでこゝに書いてあります。","xmin":562.0,"ymin":1221.0,"xmax":605.0,"ymax":1690.0},{"id":131,"contenttext":"皇國傳統の精神","xmin":494.0,"ymin":752.0,"xmax":533.0,"ymax":965.0},{"id":132,"contenttext":"臺","xmin":498.0,"ymin":2196.0,"xmax":530.0,"ymax":2233.0},{"id":133,"contenttext":"臺","xmin":498.0,"ymin":2196.0,"xmax":530.0,"ymax":2233.0}]