[{"id":1,"contenttext":"と、日佛同盟も出來て來るであらうし、永い中には米國とも同盟をするやう","xmin":3058.0,"ymin":702.0,"xmax":3113.0,"ymax":2177.0},{"id":2,"contenttext":"になつて來るであらう。","xmin":2990.0,"ymin":702.0,"xmax":3035.0,"ymax":1159.0},{"id":3,"contenttext":"さうして之れが進んで行くと茲に世界の聯邦····","xmin":2988.0,"ymin":1224.0,"xmax":3037.0,"ymax":2177.0},{"id":4,"contenttext":"世界の同盟が出來て、一切の戰爭などは跡を絕つてしまふことになるであ","xmin":2916.0,"ymin":700.0,"xmax":2968.0,"ymax":2177.0},{"id":5,"contenttext":"らうと思はれる。","xmin":2851.0,"ymin":702.0,"xmax":2894.0,"ymax":1022.0},{"id":6,"contenttext":"此の時に方つて聯邦の盟主たるべきものは誰れである","xmin":2851.0,"ymin":1084.0,"xmax":2896.0,"ymax":2175.0},{"id":7,"contenttext":"か.","xmin":2780.0,"ymin":702.0,"xmax":2827.0,"ymax":746.0},{"id":8,"contenttext":"それは系統も勝れて居り、國力も强く、人格も勝れた者でなければなる","xmin":2775.0,"ymin":796.0,"xmax":2829.0,"ymax":2177.0},{"id":9,"contenttext":"まいと思ふ。","xmin":2704.0,"ymin":704.0,"xmax":2749.0,"ymax":929.0},{"id":10,"contenttext":"さう云ふ資格を有せらるる者は、世界に國多しと雖も、我が天","xmin":2699.0,"ymin":990.0,"xmax":2756.0,"ymax":2179.0},{"id":11,"contenttext":"皇陛下我が大日本帝國の外にはなからうと思ふ。","xmin":2624.0,"ymin":704.0,"xmax":2678.0,"ymax":1678.0},{"id":12,"contenttext":"我が陛下が世界の盟主","xmin":2628.0,"ymin":1752.0,"xmax":2679.0,"ymax":2183.0},{"id":13,"contenttext":"となられる事は、必ずしも空想ではなからうと思ふ。","xmin":2549.0,"ymin":706.0,"xmax":2603.0,"ymax":1726.0},{"id":14,"contenttext":"何時かは實現されて","xmin":2553.0,"ymin":1802.0,"xmax":2606.0,"ymax":2181.0},{"id":15,"contenttext":"來るのであるに相違ない。","xmin":2472.0,"ymin":706.0,"xmax":2525.0,"ymax":1216.0},{"id":16,"contenttext":"其の塲合に神道は即ち全然世界に行はれる大","xmin":2472.0,"ymin":1278.0,"xmax":2530.0,"ymax":2183.0},{"id":17,"contenttext":"道となつて來る。","xmin":2399.0,"ymin":706.0,"xmax":2448.0,"ymax":1030.0},{"id":18,"contenttext":"即ち神道は日本國の發展と共に益々發展して、遂に世界","xmin":2397.0,"ymin":1091.0,"xmax":2453.0,"ymax":2185.0},{"id":19,"contenttext":"至る處に行はれる所の大道となるのである。","xmin":2322.0,"ymin":709.0,"xmax":2373.0,"ymax":1588.0},{"id":20,"contenttext":"此の意味に於ても神道は普","xmin":2322.0,"ymin":1660.0,"xmax":2374.0,"ymax":2183.0},{"id":21,"contenttext":"遍的であると言ふのである。","xmin":2245.0,"ymin":709.0,"xmax":2297.0,"ymax":1265.0},{"id":22,"contenttext":"我が帝國國民は旦に夕に常にかゝる大道を","xmin":2245.0,"ymin":1328.0,"xmax":2301.0,"ymax":2185.0},{"id":23,"contenttext":"體認躬行し、益々之れを宣揚し、我が國運の發展を計らなくつてはならない","xmin":2170.0,"ymin":709.0,"xmax":2222.0,"ymax":2179.0},{"id":24,"contenttext":"のである。","xmin":1797.0,"ymin":713.0,"xmax":1843.0,"ymax":893.0},{"id":25,"contenttext":"我が國民は華やかなメリンスのやうな外の道に迷はないで、我","xmin":1797.0,"ymin":951.0,"xmax":1858.0,"ymax":2187.0},{"id":26,"contenttext":"が立派なる黑縮緬の樣な固有の大道を身體に着けなくてはならぬと思ふ。","xmin":1722.0,"ymin":713.0,"xmax":1783.0,"ymax":2199.0},{"id":27,"contenttext":"詰り華やかなメリンスの樣なものが幾らあつても其の方に眼を移さず、我","xmin":1650.0,"ymin":713.0,"xmax":1709.0,"ymax":2189.0},{"id":28,"contenttext":"が固有の大道を守つて、日々理想の實現に向つて一歩々々進んで行くべき","xmin":1574.0,"ymin":713.0,"xmax":1635.0,"ymax":2187.0},{"id":29,"contenttext":"である。","xmin":1506.0,"ymin":717.0,"xmax":1547.0,"ymax":848.0},{"id":30,"contenttext":"是れが我が大日本帝國々民の天職である。","xmin":1502.0,"ymin":903.0,"xmax":1561.0,"ymax":1737.0},{"id":31,"contenttext":"義務である。","xmin":1508.0,"ymin":1806.0,"xmax":1556.0,"ymax":2015.0},{"id":32,"contenttext":"吾々の","xmin":1510.0,"ymin":2092.0,"xmax":1561.0,"ymax":2189.0},{"id":33,"contenttext":"本務である。","xmin":1427.0,"ymin":713.0,"xmax":1476.0,"ymax":940.0},{"id":34,"contenttext":"斯う云ふのであります。","xmin":1429.0,"ymin":999.0,"xmax":1480.0,"ymax":1455.0},{"id":35,"contenttext":"で、若し人あつて此の大道を誤解し","xmin":1434.0,"ymin":1526.0,"xmax":1492.0,"ymax":2191.0},{"id":36,"contenttext":"て、唯〓是れは手を拍く道である、或はトひをする道であるなどゝ云ひ、或は日","xmin":1356.0,"ymin":717.0,"xmax":1413.0,"ymax":2191.0},{"id":37,"contenttext":"本の道は偏僻姑息なり、頑迷なる最も卑しむべき道であるなどヽ云ひ、不都","xmin":1286.0,"ymin":715.0,"xmax":1343.0,"ymax":2191.0},{"id":38,"contenttext":"合な主義思想に捉はるゝ者があるならば其の者が吾々の敵であると云ふ","xmin":1214.0,"ymin":715.0,"xmax":1270.0,"ymax":2189.0},{"id":39,"contenttext":"のであります。","xmin":1136.0,"ymin":719.0,"xmax":1186.0,"ymax":988.0},{"id":40,"contenttext":"吾々日本國民の最も恐るべき敵は獨逸ではないのであり","xmin":1135.0,"ymin":1048.0,"xmax":1192.0,"ymax":2189.0},{"id":41,"contenttext":"ます。","xmin":1067.0,"ymin":719.0,"xmax":1112.0,"ymax":805.0},{"id":42,"contenttext":"米國ではないのであります。","xmin":1064.0,"ymin":860.0,"xmax":1114.0,"ymax":1412.0},{"id":43,"contenttext":"實にかゝる輩であります。","xmin":1065.0,"ymin":1476.0,"xmax":1116.0,"ymax":1970.0},{"id":44,"contenttext":"即ち獅子","xmin":1069.0,"ymin":2047.0,"xmax":1118.0,"ymax":2189.0},{"id":45,"contenttext":"身中の蟲とは此の輩の事であります。","xmin":989.0,"ymin":717.0,"xmax":1038.0,"ymax":1459.0},{"id":46,"contenttext":"若し我が國民にして益々我が大道","xmin":990.0,"ymin":1524.0,"xmax":1045.0,"ymax":2193.0},{"id":47,"contenttext":"を體認して此の煌々たる國光を八紘に輝やかしたならば、米國も吾々の親","xmin":912.0,"ymin":715.0,"xmax":975.0,"ymax":2193.0},{"id":50,"contenttext":"大意","xmin":848.0,"ymin":969.0,"xmax":888.0,"ymax":1046.0}]