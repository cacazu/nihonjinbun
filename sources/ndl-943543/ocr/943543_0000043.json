[{"id":0,"contenttext":"『靑年及靑年團』(第三卷第五號)評","xmin":3133.0,"ymin":817.0,"xmax":3186.0,"ymax":1384.0},{"id":1,"contenttext":"アリストートルとか、","xmin":3092.0,"ymin":898.0,"xmax":3131.0,"ymax":1245.0},{"id":2,"contenttext":"カントとか、","xmin":3092.0,"ymin":1266.0,"xmax":3135.0,"ymax":1469.0},{"id":3,"contenttext":"大思想家の思想や學說を知りたいと思ふ","xmin":3088.0,"ymin":1483.0,"xmax":3141.0,"ymax":2156.0},{"id":4,"contenttext":"に、","xmin":3043.0,"ymin":896.0,"xmax":3082.0,"ymax":952.0},{"id":5,"contenttext":"今日のやうに忙しい時代には、","xmin":3039.0,"ymin":965.0,"xmax":3091.0,"ymax":1476.0},{"id":6,"contenttext":"とてもこんな大思想家の浩瀚な著書を一","xmin":3043.0,"ymin":1485.0,"xmax":3090.0,"ymax":2150.0},{"id":7,"contenttext":"そこで西洋には、以前からこんな大思想家の評傳が、","xmin":2993.0,"ymin":1297.0,"xmax":3046.0,"ymax":2152.0},{"id":8,"contenttext":"々讀む譯には行かない。","xmin":2992.0,"ymin":894.0,"xmax":3041.0,"ymax":1275.0},{"id":9,"contenttext":"色々出來て居て、","xmin":2947.0,"ymin":890.0,"xmax":2994.0,"ymax":1175.0},{"id":10,"contenttext":"容易にその思想學說を知ることが出來る。","xmin":2951.0,"ymin":1188.0,"xmax":2996.0,"ymax":1878.0},{"id":11,"contenttext":"けれど我が國に","xmin":2949.0,"ymin":1889.0,"xmax":2996.0,"ymax":2154.0},{"id":12,"contenttext":"は此の種のものが甚だ乏しい","xmin":2906.0,"ymin":894.0,"xmax":2949.0,"ymax":1385.0},{"id":13,"contenttext":"近來漸く文運の進步に伴ひ、","xmin":2904.0,"ymin":1407.0,"xmax":2951.0,"ymax":1878.0},{"id":14,"contenttext":"多少かゝる種類","xmin":2906.0,"ymin":1892.0,"xmax":2951.0,"ymax":2157.0},{"id":15,"contenttext":"のものも出て、","xmin":2863.0,"ymin":894.0,"xmax":2904.0,"ymax":1138.0},{"id":16,"contenttext":"學界に貢献せる所が少くない","xmin":2859.0,"ymin":1150.0,"xmax":2908.0,"ymax":1645.0},{"id":17,"contenttext":"只憾むらくは主として儒〓の","xmin":2863.0,"ymin":1669.0,"xmax":2910.0,"ymax":2158.0},{"id":18,"contenttext":"思想家に限らるゝの觀あることである","xmin":2816.0,"ymin":894.0,"xmax":2860.0,"ymax":1533.0},{"id":19,"contenttext":"處が、","xmin":2816.0,"ymin":1558.0,"xmax":2860.0,"ymax":1651.0},{"id":20,"contenttext":"國學院大學講師文學士田中義","xmin":2816.0,"ymin":1667.0,"xmax":2863.0,"ymax":2160.0},{"id":21,"contenttext":"能氏、","xmin":2769.0,"ymin":892.0,"xmax":2816.0,"ymax":989.0},{"id":22,"contenttext":"〓心〓育の學理を研究しその實際に從事すると同時に、","xmin":2766.0,"ymin":1002.0,"xmax":2820.0,"ymax":1913.0},{"id":23,"contenttext":"我が國固有の","xmin":2769.0,"ymin":1930.0,"xmax":2821.0,"ymax":2159.0},{"id":24,"contenttext":"學の思想家の研究に從事し、","xmin":2720.0,"ymin":892.0,"xmax":2769.0,"ymax":1359.0},{"id":25,"contenttext":"曩に已に『平田篤胤之哲學』を公にし、","xmin":2719.0,"ymin":1370.0,"xmax":2773.0,"ymax":1991.0},{"id":26,"contenttext":"今又茲に","xmin":2724.0,"ymin":2002.0,"xmax":2773.0,"ymax":2158.0},{"id":27,"contenttext":"新に、","xmin":2675.0,"ymin":890.0,"xmax":2722.0,"ymax":986.0},{"id":28,"contenttext":"尨然たる『本居宣長之哲學』を大成した。","xmin":2672.0,"ymin":1000.0,"xmax":2725.0,"ymax":1658.0},{"id":29,"contenttext":"就て此の書を見るに、","xmin":2675.0,"ymin":1671.0,"xmax":2724.0,"ymax":2027.0},{"id":30,"contenttext":"宣長の","xmin":2677.0,"ymin":2041.0,"xmax":2726.0,"ymax":2160.0},{"id":31,"contenttext":"思想を中心とし、","xmin":2628.0,"ymin":894.0,"xmax":2673.0,"ymax":1175.0},{"id":32,"contenttext":"春滿眞淵及び大平內遠等、","xmin":2626.0,"ymin":1188.0,"xmax":2675.0,"ymax":1623.0},{"id":33,"contenttext":"その學統に關する學者の學說を","xmin":2630.0,"ymin":1634.0,"xmax":2677.0,"ymax":2160.0},{"id":34,"contenttext":"も","xmin":2598.0,"ymin":894.0,"xmax":2632.0,"ymax":939.0},{"id":35,"contenttext":"系統的組織的に論述し","xmin":2583.0,"ymin":967.0,"xmax":2642.0,"ymax":1348.0},{"id":36,"contenttext":"能く復古神道派の學說を紹介して至れり盡せり","xmin":2587.0,"ymin":1372.0,"xmax":2644.0,"ymax":2158.0},{"id":37,"contenttext":"と謂ふべきである","xmin":2555.0,"ymin":896.0,"xmax":2597.0,"ymax":1196.0},{"id":38,"contenttext":"而して之れを論述するに","xmin":2549.0,"ymin":1229.0,"xmax":2604.0,"ymax":1642.0},{"id":39,"contenttext":"著者得意の明快なる文章を以","xmin":2552.0,"ymin":1670.0,"xmax":2605.0,"ymax":2161.0},{"id":40,"contenttext":"ある","xmin":2483.0,"ymin":896.0,"xmax":2518.0,"ymax":971.0},{"id":41,"contenttext":"は、","xmin":2448.0,"ymin":896.0,"xmax":2487.0,"ymax":946.0},{"id":42,"contenttext":"つてして居る","xmin":2518.0,"ymin":898.0,"xmax":2560.0,"ymax":1122.0},{"id":43,"contenttext":"風〓の爲に大に賀すべきである。","xmin":2443.0,"ymin":968.0,"xmax":2489.0,"ymax":1512.0},{"id":44,"contenttext":"我が思想界の混亂益々甚しからんとするに當り","xmin":2477.0,"ymin":1002.0,"xmax":2526.0,"ymax":1788.0},{"id":45,"contenttext":"引證は該博で","xmin":2516.0,"ymin":1150.0,"xmax":2563.0,"ymax":1382.0},{"id":46,"contenttext":"議論は痛切","xmin":2514.0,"ymin":1411.0,"xmax":2561.0,"ymax":1608.0},{"id":47,"contenttext":"吾人は敢へて此の書を讀君に推薦する","xmin":2444.0,"ymin":1521.0,"xmax":2493.0,"ymax":2156.0},{"id":48,"contenttext":"慥に近來の好著述と謂ふべきで","xmin":2514.0,"ymin":1632.0,"xmax":2563.0,"ymax":2156.0},{"id":49,"contenttext":"本書の公刊を見たる","xmin":2483.0,"ymin":1820.0,"xmax":2526.0,"ymax":2158.0},{"id":50,"contenttext":"ものである","xmin":2414.0,"ymin":896.0,"xmax":2450.0,"ymax":1085.0},{"id":51,"contenttext":"『東京每日新聞』(一三二七五號)評","xmin":2363.0,"ymin":817.0,"xmax":2412.0,"ymax":1382.0},{"id":52,"contenttext":"吾國に固有なる哲學あり、","xmin":2322.0,"ymin":894.0,"xmax":2365.0,"ymax":1320.0},{"id":53,"contenttext":"之れを和道哲學と云ひ、","xmin":2317.0,"ymin":1335.0,"xmax":2367.0,"ymax":1731.0},{"id":54,"contenttext":"鈴之屋大人は方にこれが","xmin":2317.0,"ymin":1742.0,"xmax":2371.0,"ymax":2154.0},{"id":55,"contenttext":"研究に一生を捧げたる人。","xmin":2281.0,"ymin":894.0,"xmax":2328.0,"ymax":1314.0},{"id":56,"contenttext":"の著者として","xmin":2248.0,"ymin":894.0,"xmax":2291.0,"ymax":1120.0},{"id":57,"contenttext":"疾くに著者に此の著なかるべからざりしなり","xmin":2247.0,"ymin":1152.0,"xmax":2294.0,"ymax":1899.0},{"id":58,"contenttext":"和道哲學の研究者として、","xmin":2285.0,"ymin":1336.0,"xmax":2328.0,"ymax":1772.0},{"id":59,"contenttext":"兼ねて平田篤胤之哲學","xmin":2283.0,"ymin":1781.0,"xmax":2330.0,"ymax":2158.0},{"id":60,"contenttext":"宣長の著書五","xmin":2248.0,"ymin":1928.0,"xmax":2293.0,"ymax":2157.0},{"id":61,"contenttext":"十部百三十餘卷","xmin":2209.0,"ymin":892.0,"xmax":2257.0,"ymax":1163.0},{"id":62,"contenttext":"此の中より著者の所謂和道哲學の眞髓を抽出せるの勞は、","xmin":2209.0,"ymin":1188.0,"xmax":2256.0,"ymax":2138.0},{"id":63,"contenttext":"之を多とせざるべからず","xmin":2175.0,"ymin":894.0,"xmax":2220.0,"ymax":1314.0},{"id":64,"contenttext":"學哲之長宣居本","xmin":2290.0,"ymin":614.0,"xmax":3050.0,"ymax":746.0},{"id":65,"contenttext":"『二六新報』(四八九六號)評","xmin":1902.0,"ymin":811.0,"xmax":1973.0,"ymax":1267.0},{"id":66,"contenttext":"吾國の神道なるものが佛教の輸入と共に、","xmin":1860.0,"ymin":879.0,"xmax":1907.0,"ymax":1406.0},{"id":67,"contenttext":"一種の變態を來して終に佛教的神道となり、","xmin":1848.0,"ymin":1419.0,"xmax":1900.0,"ymax":1969.0},{"id":68,"contenttext":"盛に佛教諸家","xmin":1847.0,"ymin":1977.0,"xmax":1891.0,"ymax":2153.0},{"id":69,"contenttext":"に利用された事は歷史の明かに示す所である。","xmin":1821.0,"ymin":879.0,"xmax":1868.0,"ymax":1457.0},{"id":70,"contenttext":"是は後に唯一神道となりて稍々面目を改めたけれども、","xmin":1784.0,"ymin":877.0,"xmax":1831.0,"ymax":1572.0},{"id":71,"contenttext":"尙ほ本來の面目を發揮する能はずして、","xmin":1774.0,"ymin":1580.0,"xmax":1820.0,"ymax":2078.0},{"id":72,"contenttext":"唐宋","xmin":1772.0,"ymin":2086.0,"xmax":1811.0,"ymax":2152.0},{"id":73,"contenttext":"諸儒の精粕、","xmin":1755.0,"ymin":877.0,"xmax":1796.0,"ymax":1037.0},{"id":74,"contenttext":"胎金兩部の餘瀝を殘さない譯に行かなかつた。","xmin":1744.0,"ymin":1045.0,"xmax":1794.0,"ymax":1625.0},{"id":75,"contenttext":"此の間にありて系脉を直に古代に取り、我が固有の神道を主張し得た者は實に復古神道の諸家である。","xmin":1700.0,"ymin":875.0,"xmax":1760.0,"ymax":2143.0},{"id":76,"contenttext":"復古神道の學父とも云ふべき人は加茂眞淵で、","xmin":1674.0,"ymin":873.0,"xmax":1722.0,"ymax":1456.0},{"id":77,"contenttext":"眞淵の正脈を受け繼いで復古神道を大成するに至つた","xmin":1659.0,"ymin":1464.0,"xmax":1715.0,"ymax":2151.0},{"id":78,"contenttext":"人は實に本居宣長である。","xmin":1643.0,"ymin":875.0,"xmax":1685.0,"ymax":1204.0},{"id":79,"contenttext":"或人は神道を稱して宗〓と云ふ程の價値はないと云ふ。","xmin":1598.0,"ymin":873.0,"xmax":1649.0,"ymax":1565.0},{"id":80,"contenttext":"成程日本の神道にはバイプルやコーランや諸","xmin":1585.0,"ymin":1576.0,"xmax":1638.0,"ymax":2147.0},{"id":81,"contenttext":"種の佛典のやうな、","xmin":1569.0,"ymin":873.0,"xmax":1610.0,"ymax":1115.0},{"id":82,"contenttext":"完備した經典はないかも知れぬが、","xmin":1561.0,"ymin":1123.0,"xmax":1606.0,"ymax":1564.0},{"id":83,"contenttext":"然し復古神道家の宇宙說、","xmin":1551.0,"ymin":1574.0,"xmax":1601.0,"ymax":1905.0},{"id":84,"contenttext":"創世說、","xmin":1551.0,"ymin":1912.0,"xmax":1590.0,"ymax":2019.0},{"id":85,"contenttext":"神祇說に","xmin":1549.0,"ymin":2024.0,"xmax":1588.0,"ymax":2144.0},{"id":86,"contenttext":"宗〓的將た哲學的價値がないと云ふことが出來やうか。","xmin":1523.0,"ymin":871.0,"xmax":1573.0,"ymax":1564.0},{"id":87,"contenttext":"復古神道に於て發見する諸種の哲學は實に外來文明の影響を受けぬ純粹なる日本民族の宇宙觀、","xmin":1472.0,"ymin":871.0,"xmax":1538.0,"ymax":2075.0},{"id":88,"contenttext":"神靈","xmin":1474.0,"ymin":2084.0,"xmax":1512.0,"ymax":2148.0},{"id":89,"contenttext":"觀である。","xmin":1459.0,"ymin":870.0,"xmax":1496.0,"ymax":999.0},{"id":90,"contenttext":"若し之を何等研究の價値なしとして一笑に附し去るものがあるならば、","xmin":1437.0,"ymin":1010.0,"xmax":1495.0,"ymax":1902.0},{"id":91,"contenttext":"其の人は實に自分","xmin":1433.0,"ymin":1913.0,"xmax":1477.0,"ymax":2149.0},{"id":92,"contenttext":"自身の屬して居る民族的思想の發展を無視した人と云ふて好からうと思ふ。","xmin":1403.0,"ymin":869.0,"xmax":1459.0,"ymax":1821.0},{"id":93,"contenttext":"吾人の曾て有した、","xmin":1381.0,"ymin":867.0,"xmax":1420.0,"ymax":1114.0},{"id":94,"contenttext":"物質的文明が決して世界の他の國の文明に劣つて居なかつたやうに、","xmin":1363.0,"ymin":1123.0,"xmax":1417.0,"ymax":1987.0},{"id":95,"contenttext":"吾人の祖先","xmin":1360.0,"ymin":1995.0,"xmax":1400.0,"ymax":2144.0},{"id":96,"contenttext":"が有した宗〓的哲學的、","xmin":1345.0,"ymin":869.0,"xmax":1386.0,"ymax":1167.0},{"id":97,"contenttext":"將道德的思想は決して","xmin":1339.0,"ymin":1178.0,"xmax":1379.0,"ymax":1474.0},{"id":98,"contenttext":"基督教の其れにも","xmin":1335.0,"ymin":1472.0,"xmax":1376.0,"ymax":1707.0},{"id":99,"contenttext":"佛教の其れにも劣つては居なかつ","xmin":1325.0,"ymin":1705.0,"xmax":1370.0,"ymax":2140.0},{"id":100,"contenttext":"な","xmin":1320.0,"ymin":870.0,"xmax":1349.0,"ymax":912.0},{"id":101,"contenttext":"人類思想發展の徑路は何れの國人も皆な一樣な筈である。","xmin":1303.0,"ymin":922.0,"xmax":1350.0,"ymax":1644.0},{"id":102,"contenttext":"宣長の『古事記傳』に現はれた世界論原理論の學說が今日の學說と比較して果して何れだけの優劣があ","xmin":1254.0,"ymin":865.0,"xmax":1320.0,"ymax":2140.0},{"id":103,"contenttext":"るか其れは知らぬ。","xmin":1240.0,"ymin":867.0,"xmax":1281.0,"ymax":1108.0},{"id":104,"contenttext":"唯吾人は宣長を透して日本民族の思想が何の邊まで發展したかを知れば其れで好","xmin":1217.0,"ymin":1118.0,"xmax":1278.0,"ymax":2144.0},{"id":105,"contenttext":"いのである。","xmin":1208.0,"ymin":870.0,"xmax":1243.0,"ymax":1026.0},{"id":106,"contenttext":"宣長の有した政治論、","xmin":1166.0,"ymin":861.0,"xmax":1210.0,"ymax":1139.0},{"id":107,"contenttext":"宗〓論其は今日より見れば陳腐なものであつたかもしれぬが、","xmin":1151.0,"ymin":1147.0,"xmax":1204.0,"ymax":1926.0},{"id":108,"contenttext":"けれども吾人は","xmin":1146.0,"ymin":1934.0,"xmax":1187.0,"ymax":2138.0},{"id":109,"contenttext":"其の陳腐なるものの中に、","xmin":1128.0,"ymin":865.0,"xmax":1170.0,"ymax":1192.0},{"id":110,"contenttext":"何れ程の眞理を含むで居たかを檢して、","xmin":1117.0,"ymin":1200.0,"xmax":1164.0,"ymax":1701.0},{"id":111,"contenttext":"國民の思想の今日に至る迄には何","xmin":1106.0,"ymin":1707.0,"xmax":1157.0,"ymax":2140.0},{"id":112,"contenttext":"の程度の發展的徑路を辿つて來たかを〓究すればそれで好い。","xmin":1078.0,"ymin":865.0,"xmax":1136.0,"ymax":1640.0},{"id":113,"contenttext":"著者は有名なる神道哲學專攻の士であるから、","xmin":1043.0,"ymin":861.0,"xmax":1097.0,"ymax":1445.0},{"id":114,"contenttext":"讀者は宣長の著書五十部百三十餘卷の書を讀破せずと","xmin":1028.0,"ymin":1451.0,"xmax":1084.0,"ymax":2134.0},{"id":115,"contenttext":"も本書を一讀すれば宣長の哲學-否復古神道諸家の哲學を遺憾なく知ることは出來やう。","xmin":994.0,"ymin":863.0,"xmax":1054.0,"ymax":2005.0},{"id":116,"contenttext":"先年著者","xmin":993.0,"ymin":2014.0,"xmax":1030.0,"ymax":2134.0},{"id":117,"contenttext":"が公にした『平田篤胤の哲學』","xmin":972.0,"ymin":865.0,"xmax":1017.0,"ymax":1237.0},{"id":118,"contenttext":"が識者間に重ぜられた一事に徵するも亦本書の價値を知に充分と思ふ。","xmin":953.0,"ymin":1243.0,"xmax":1010.0,"ymax":2132.0},{"id":119,"contenttext":"値價の書本","xmin":1176.0,"ymin":566.0,"xmax":1767.0,"ymax":696.0}]