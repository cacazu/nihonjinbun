[{"id":1,"contenttext":"友であります。","xmin":3111.0,"ymin":717.0,"xmax":3160.0,"ymax":995.0},{"id":2,"contenttext":"獨逸も吾々に畏服して來るのであります。","xmin":3111.0,"ymin":1051.0,"xmax":3160.0,"ymax":1878.0},{"id":3,"contenttext":"吾々は決して","xmin":3106.0,"ymin":1953.0,"xmax":3154.0,"ymax":2191.0},{"id":4,"contenttext":"此れ等を恐るゝの必要は全くないのであります。","xmin":3037.0,"ymin":717.0,"xmax":3088.0,"ymax":1692.0},{"id":5,"contenttext":"唯、獨り恐るべきものは","xmin":3035.0,"ymin":1765.0,"xmax":3081.0,"ymax":2191.0},{"id":6,"contenttext":"今申した所の獅子身中の蟲であります。","xmin":2965.0,"ymin":716.0,"xmax":3015.0,"ymax":1506.0},{"id":7,"contenttext":"獅子は最も强い動物である。","xmin":2960.0,"ymin":1572.0,"xmax":3012.0,"ymax":2111.0},{"id":8,"contenttext":"獅","xmin":2959.0,"ymin":2190.0,"xmax":3008.0,"ymax":2195.0},{"id":9,"contenttext":"子一度び吼ゆれば百獸の腦が裂けると云ふ事であります。","xmin":2893.0,"ymin":716.0,"xmax":2948.0,"ymax":1878.0},{"id":10,"contenttext":"其の位强い獅","xmin":2887.0,"ymin":1953.0,"xmax":2942.0,"ymax":2197.0},{"id":11,"contenttext":"子でもお腹の中に入つて來た眞田蟲或は蛔蟲などのやうな譯もない蟲に","xmin":2816.0,"ymin":717.0,"xmax":2874.0,"ymax":2193.0},{"id":12,"contenttext":"は閉口する。","xmin":2751.0,"ymin":717.0,"xmax":2798.0,"ymax":944.0},{"id":13,"contenttext":"さう云ふ蟲の爲には病氣を惹起して殺されて仕舞ふ。","xmin":2742.0,"ymin":1003.0,"xmax":2801.0,"ymax":2068.0},{"id":14,"contenttext":"あれ","xmin":2743.0,"ymin":2144.0,"xmax":2792.0,"ymax":2193.0},{"id":15,"contenttext":"程の獅子見た樣な强い動物でも小さい蟲の爲には殺されて仕舞ふのであ","xmin":2664.0,"ymin":717.0,"xmax":2727.0,"ymax":2193.0},{"id":16,"contenttext":"ります。","xmin":2600.0,"ymin":717.0,"xmax":2643.0,"ymax":852.0},{"id":17,"contenttext":"我が國民は實に强き陸海軍を持つて居る。","xmin":2591.0,"ymin":905.0,"xmax":2647.0,"ymax":1741.0},{"id":18,"contenttext":"世界無敵とも云ふべ","xmin":2589.0,"ymin":1809.0,"xmax":2642.0,"ymax":2185.0},{"id":19,"contenttext":"き陸海軍を持つて居る。","xmin":2520.0,"ymin":716.0,"xmax":2571.0,"ymax":1177.0},{"id":20,"contenttext":"實に我が國民の元氣は他に當るべきものは無い","xmin":2518.0,"ymin":1237.0,"xmax":2569.0,"ymax":2189.0},{"id":21,"contenttext":"のであります。","xmin":2455.0,"ymin":717.0,"xmax":2497.0,"ymax":991.0},{"id":22,"contenttext":"けれども此の獅子身中の蟲の爲には害を受けないとは限","xmin":2443.0,"ymin":1049.0,"xmax":2498.0,"ymax":2190.0},{"id":23,"contenttext":"りませぬ。","xmin":2383.0,"ymin":717.0,"xmax":2426.0,"ymax":895.0},{"id":24,"contenttext":"それで吾々は此の獅子身中の蟲は何うしても撲滅しなければ","xmin":2372.0,"ymin":953.0,"xmax":2427.0,"ymax":2189.0},{"id":25,"contenttext":"ならぬ。","xmin":2305.0,"ymin":716.0,"xmax":2350.0,"ymax":850.0},{"id":26,"contenttext":"之れを撲滅して、我が大道を宣揚し、我が皇威を八紘に輝かし、我が","xmin":2292.0,"ymin":905.0,"xmax":2355.0,"ymax":2189.0},{"id":27,"contenttext":"國光を宇內に遍からしむるは、我が國民の天職で、我が國民の努めざるべか","xmin":2211.0,"ymin":716.0,"xmax":2279.0,"ymax":2189.0},{"id":28,"contenttext":"6.","xmin":2992.0,"ymin":2290.0,"xmax":3037.0,"ymax":2295.0},{"id":29,"contenttext":"e","xmin":2961.0,"ymin":2342.0,"xmax":2994.0,"ymax":2344.0},{"id":30,"contenttext":"13.","xmin":2863.0,"ymin":2270.0,"xmax":2927.0,"ymax":2275.0},{"id":31,"contenttext":"らざる本務であると思ひます。","xmin":1817.0,"ymin":709.0,"xmax":1870.0,"ymax":1312.0},{"id":32,"contenttext":"述べて茲に來り、讀者は略〓我が國固有の大道即ち神道なるものゝ意味を","xmin":1744.0,"ymin":760.0,"xmax":1807.0,"ymax":2189.0},{"id":33,"contenttext":"了解せられたであらうと思ひます。","xmin":1670.0,"ymin":711.0,"xmax":1725.0,"ymax":1412.0},{"id":34,"contenttext":"神道は決して同じ宗〓內にてさへも、","xmin":1677.0,"ymin":1476.0,"xmax":1734.0,"ymax":2203.0},{"id":35,"contenttext":"派を立て、黨を結び、相容れないやうな佛〓や基督〓などゝ肩をならべる如","xmin":1594.0,"ymin":714.0,"xmax":1659.0,"ymax":2191.0},{"id":36,"contenttext":"き狹少な道でなく、かゝるものに超然とした大道で、我が國民、進んでは世界","xmin":1521.0,"ymin":716.0,"xmax":1585.0,"ymax":2191.0},{"id":37,"contenttext":"人類も、遵奉すべき高大な道であることが大體了解せられたであらうと思","xmin":1445.0,"ymin":717.0,"xmax":1511.0,"ymax":2190.0},{"id":38,"contenttext":"ひます。","xmin":1377.0,"ymin":717.0,"xmax":1423.0,"ymax":853.0},{"id":39,"contenttext":"神","xmin":928.0,"ymin":714.0,"xmax":1059.0,"ymax":834.0},{"id":40,"contenttext":"道","xmin":928.0,"ymin":912.0,"xmax":1059.0,"ymax":1028.0},{"id":41,"contenttext":"道大意","xmin":877.0,"ymin":915.0,"xmax":917.0,"ymax":1050.0},{"id":42,"contenttext":"大","xmin":926.0,"ymin":1109.0,"xmax":1061.0,"ymax":1216.0},{"id":43,"contenttext":"意","xmin":932.0,"ymin":1305.0,"xmax":1057.0,"ymax":1410.0},{"id":44,"contenttext":"終","xmin":981.0,"ymin":1488.0,"xmax":1057.0,"ymax":1533.0},{"id":46,"contenttext":"七三","xmin":887.0,"ymin":1931.0,"xmax":918.0,"ymax":1937.0}]