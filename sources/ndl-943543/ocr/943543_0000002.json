[{"id":0,"contenttext":"324-454","xmin":1687.0,"ymin":248.0,"xmax":1981.0,"ymax":340.0},{"id":1,"contenttext":"神","xmin":1768.0,"ymin":659.0,"xmax":1903.0,"ymax":793.0},{"id":2,"contenttext":"らんと努むるやうなものであります。","xmin":1008.0,"ymin":654.0,"xmax":1067.0,"ymax":1409.0},{"id":3,"contenttext":"假まで出來る丈け西洋人をまねんとして、遂に精神までも西洋人にならん","xmin":1135.0,"ymin":652.0,"xmax":1218.0,"ymax":2138.0},{"id":4,"contenttext":"洋化した結果に外ならないのであります。","xmin":1217.0,"ymin":656.0,"xmax":1289.0,"ymax":1505.0},{"id":5,"contenttext":"となつては、なさけないではありませんか。","xmin":930.0,"ymin":656.0,"xmax":993.0,"ymax":1499.0},{"id":6,"contenttext":"とした結果に外ならないのであります。","xmin":1075.0,"ymin":658.0,"xmax":1144.0,"ymax":1456.0},{"id":7,"contenttext":"しました本能主義、自然主義のやうなものも、皆西洋の文明に心醉し、所謂西","xmin":1280.0,"ymin":658.0,"xmax":1359.0,"ymax":2147.0},{"id":8,"contenttext":"時世を騷がしました、社會主義のやうなものも、多くの靑年男女を盡毒","xmin":1354.0,"ymin":752.0,"xmax":1430.0,"ymax":2146.0},{"id":11,"contenttext":"大","xmin":879.0,"ymin":896.0,"xmax":918.0,"ymax":940.0},{"id":13,"contenttext":"牛乳を飮むからとて精神までも牛","xmin":995.0,"ymin":1444.0,"xmax":1052.0,"ymax":2136.0},{"id":14,"contenttext":"恰も牛乳を飮んで、そして牛にな","xmin":1067.0,"ymin":1490.0,"xmax":1126.0,"ymax":2138.0},{"id":15,"contenttext":"西洋文明が如何によいからと","xmin":919.0,"ymin":1535.0,"xmax":980.0,"ymax":2134.0},{"id":16,"contenttext":"洋服を着、靴を穿ち、手眞似口眞","xmin":1212.0,"ymin":1540.0,"xmax":1270.0,"ymax":2144.0},{"id":17,"contenttext":"道","xmin":1764.0,"ymin":853.0,"xmax":1899.0,"ymax":995.0},{"id":18,"contenttext":"大","xmin":1756.0,"ymin":1043.0,"xmax":1895.0,"ymax":1185.0},{"id":19,"contenttext":"文學士","xmin":1574.0,"ymin":1242.0,"xmax":1639.0,"ymax":1449.0},{"id":20,"contenttext":"意","xmin":1758.0,"ymin":1238.0,"xmax":1884.0,"ymax":1371.0},{"id":21,"contenttext":"田","xmin":1563.0,"ymin":1505.0,"xmax":1635.0,"ymax":1578.0},{"id":22,"contenttext":"中","xmin":1566.0,"ymin":1638.0,"xmax":1629.0,"ymax":1709.0},{"id":23,"contenttext":"義","xmin":1559.0,"ymin":1763.0,"xmax":1633.0,"ymax":1841.0},{"id":24,"contenttext":"能著","xmin":15