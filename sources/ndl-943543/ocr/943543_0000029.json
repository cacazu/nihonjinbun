[{"id":1,"contenttext":"の結果として最も神聖なる〓育に從事する者でも、矢張り其の風潮に促さ","xmin":3082.0,"ymin":667.0,"xmax":3147.0,"ymax":2132.0},{"id":2,"contenttext":"れて來た。","xmin":3023.0,"ymin":665.0,"xmax":3072.0,"ymax":852.0},{"id":3,"contenttext":"將來の日本國民を作る〓育家が徒に輕兆浮薄に流れ西洋心醉","xmin":3007.0,"ymin":899.0,"xmax":3073.0,"ymax":2134.0},{"id":4,"contenttext":"主義ともいふべきものを以つて〓育に從事するやうになつて來た。","xmin":2932.0,"ymin":665.0,"xmax":2997.0,"ymax":2007.0},{"id":5,"contenttext":"其の","xmin":2935.0,"ymin":2068.0,"xmax":2983.0,"ymax":2134.0},{"id":6,"contenttext":"結果たるや實に智者を待たずして明かなる狀態になつて來た。","xmin":2863.0,"ymin":663.0,"xmax":2925.0,"ymax":1917.0},{"id":7,"contenttext":"さう云ふ","xmin":2863.0,"ymin":1979.0,"xmax":2910.0,"ymax":2132.0},{"id":8,"contenttext":"有樣で實に當時の日本の社會の狀態は甚だ寒心すべき現象を呈して來た。","xmin":2785.0,"ymin":663.0,"xmax":2850.0,"ymax":2136.0},{"id":9,"contenttext":"それをば九重の上より御覽遊ばして、","xmin":2719.0,"ymin":663.0,"xmax":2772.0,"ymax":1408.0},{"id":10,"contenttext":"先帝陛下は大いに宸襟を惱まさせ","xmin":2714.0,"ymin":1461.0,"xmax":2769.0,"ymax":2130.0},{"id":11,"contenttext":"れて斯ういふ風な〓育を施して居つたならば、將來の國民はどうなるだら","xmin":2645.0,"ymin":665.0,"xmax":2701.0,"ymax":2130.0},{"id":12,"contenttext":"うか。","xmin":2581.0,"ymin":665.0,"xmax":2625.0,"ymax":760.0},{"id":13,"contenttext":"斯ういふ事を大いに御軫稔遊ばして.それで今より廿五年前即ち明","xmin":2567.0,"ymin":802.0,"xmax":2629.0,"ymax":2132.0},{"id":14,"contenttext":"治二十三年の十月三十日に彼の〓育勅語を御發布になつた次第である。","xmin":2493.0,"ymin":663.0,"xmax":2559.0,"ymax":2097.0},{"id":15,"contenttext":"彼の〓育勅語が一たび出て今まで百鬼晝行の此の社會の混亂は一大燈明","xmin":2413.0,"ymin":663.0,"xmax":2484.0,"ymax":2134.0},{"id":16,"contenttext":"臺を得たのである。","xmin":2356.0,"ymin":663.0,"xmax":2405.0,"ymax":1036.0},{"id":17,"contenttext":"今まで混亂して居つた〓育界は玆に一大指南車を得","xmin":2341.0,"ymin":1083.0,"xmax":2403.0,"ymax":2130.0},{"id":18,"contenttext":"たのである。","xmin":2283.0,"ymin":663.0,"xmax":2328.0,"ymax":895.0},{"id":19,"contenttext":"即ち此の〓育に關する勅語は燈明臺となり指南車となて〓","xmin":2268.0,"ymin":940.0,"xmax":2331.0,"ymax":2130.0},{"id":20,"contenttext":"育界を指導して行くやうになつて來たのであります。","xmin":2199.0,"ymin":661.0,"xmax":2257.0,"ymax":1727.0},{"id":21,"contenttext":"今日の樣な種々の思想信仰の行はれます社會と時代には、已に申しまし","xmin":1819.0,"ymin":677.0,"xmax":1873.0,"ymax":2121.0},{"id":22,"contenttext":"た樣な我が國の大道即ち神道を從來のやうな發表の仕方で依然發表して","xmin":1743.0,"ymin":643.0,"xmax":1796.0,"ymax":2121.0},{"id":23,"contenttext":"居ましては、とても十分に國民に徹底せしむることは、むづかしいのであり","xmin":1676.0,"ymin":643.0,"xmax":1723.0,"ymax":2121.0},{"id":24,"contenttext":"ます。","xmin":1610.0,"ymin":643.0,"xmax":1654.0,"ymax":736.0},{"id":25,"contenttext":"要するに歷史的の事實や、斷片的の言葉のみを擧げて、是れが神道で","xmin":1608.0,"ymin":783.0,"xmax":1657.0,"ymax":2119.0},{"id":26,"contenttext":"あると云つた所で之れに因つて國民に鞏固なる思想信仰を作り、國民をし","xmin":1535.0,"ymin":643.0,"xmax":1584.0,"ymax":2121.0},{"id":27,"contenttext":"て種々危險なる思想信仰に抵抗せしむることは困難であります。","xmin":1461.0,"ymin":645.0,"xmax":1510.0,"ymax":1948.0},{"id":28,"contenttext":"畏れ多","xmin":1461.0,"ymin":2006.0,"xmax":1510.0,"ymax":2123.0},{"id":29,"contenttext":"くも現人神にまし〓〓た先帝陛下は深く此事を御軫念遊ばして、此の勅語","xmin":1386.0,"ymin":643.0,"xmax":1440.0,"ymax":2119.0},{"id":30,"contenttext":"を賜はり、神道を示されたのであります。","xmin":1314.0,"ymin":643.0,"xmax":1365.0,"ymax":1433.0},{"id":31,"contenttext":"併し斯う申しますると云ふと、儒","xmin":1313.0,"ymin":1486.0,"xmax":1364.0,"ymax":2122.0},{"id":32,"contenttext":"〓を信じまする人は〓育勅語は神道の本旨を示されたものであると云ふ","xmin":1238.0,"ymin":645.0,"xmax":1295.0,"ymax":2121.0},{"id":33,"contenttext":"けれども、それは大なる誤解である。","xmin":1167.0,"ymin":643.0,"xmax":1218.0,"ymax":1343.0},{"id":34,"contenttext":"是れは儒〓の要旨を示されたもので","xmin":1167.0,"ymin":1396.0,"xmax":1216.0,"ymax":2119.0},{"id":35,"contenttext":"ある。","xmin":1102.0,"ymin":645.0,"xmax":1140.0,"ymax":735.0},{"id":36,"contenttext":"斯う云ふでありませう。","xmin":1097.0,"ymin":783.0,"xmax":1144.0,"ymax":1249.0},{"id":37,"contenttext":"それも尤もであるのです。","xmin":1094.0,"ymin":1297.0,"xmax":1145.0,"ymax":1811.0},{"id":38,"contenttext":"又或る人は、い","xmin":1095.0,"ymin":1867.0,"xmax":1142.0,"ymax":2117.0},{"id":39,"contenttext":"やさうではない、佛〓の意味を說かれたのである。","xmin":1026.0,"ymin":643.0,"xmax":1075.0,"ymax":1623.0},{"id":40,"contenttext":"いやさうぢやない、基督","xmin":1024.0,"ymin":1683.0,"xmax":1073.0,"ymax":2123.0},{"id":41,"contenttext":"〓の〓を說かれたものだと.","xmin":950.0,"ymin":642.0,"xmax":1006.0,"ymax":1206.0},{"id":42,"contenttext":"各々自分の信じて居る方面に引いて解釋を","xmin":947.0,"ymin":1254.0,"xmax":999.0,"ymax":2121.0},{"id":45,"contenttext":"大","xmin":885.0,"ymin":887.0,"xmax":924.0,"ymax":918.0},{"id":46,"contenttext":"意","xmin":882.0,"ymin":938.0,"xmax":924.0,"ymax":969.0}]