[{"id":0,"contenttext":"るには文明〓を奉ぜねばならぬ。","xmin":3059.0,"ymin":659.0,"xmax":3109.0,"ymax":1318.0},{"id":1,"contenttext":"そんなことを盛に言出して來た。","xmin":3057.0,"ymin":1352.0,"xmax":3106.0,"ymax":2011.0},{"id":3,"contenttext":"でもカンでも基督〓でなくてはならぬ。","xmin":2984.0,"ymin":659.0,"xmax":3033.0,"ymax":1453.0},{"id":4,"contenttext":"又基督〓を信ずるものは偶像を","xmin":2982.0,"ymin":1489.0,"xmax":3031.0,"ymax":2136.0},{"id":5,"contenttext":"崇拜する事は出來ない。","xmin":2909.0,"ymin":657.0,"xmax":2961.0,"ymax":1130.0},{"id":6,"contenttext":"寫眞に向つて御辭儀は出來ないといふやうな不","xmin":2906.0,"ymin":1168.0,"xmax":2960.0,"ymax":2134.0},{"id":7,"contenttext":"都合な奴輩を出す樣になつて來た。","xmin":2836.0,"ymin":657.0,"xmax":2888.0,"ymax":1363.0},{"id":8,"contenttext":"是れは御誓文の上の方ばかり採つて","xmin":2837.0,"ymin":1397.0,"xmax":2886.0,"ymax":2133.0},{"id":9,"contenttext":"來た弊害である。","xmin":2765.0,"ymin":657.0,"xmax":2814.0,"ymax":991.0},{"id":10,"contenttext":"それから又道德の方面はどうかといふと、道德は快樂主","xmin":2763.0,"ymin":1029.0,"xmax":2812.0,"ymax":2136.0},{"id":11,"contenttext":"義に限る。","xmin":2696.0,"ymin":657.0,"xmax":2741.0,"ymax":854.0},{"id":12,"contenttext":"人生快樂是れに越したことはないなんと云つて、快樂主義とか、","xmin":2689.0,"ymin":890.0,"xmax":2743.0,"ymax":2136.0},{"id":13,"contenttext":"幸福主義とかいふ方面ばかり主として實に大變な事になつて來た。","xmin":2618.0,"ymin":657.0,"xmax":2674.0,"ymax":2009.0},{"id":14,"contenttext":"所謂","xmin":2620.0,"ymin":2043.0,"xmax":2670.0,"ymax":2136.0},{"id":15,"contenttext":"風俗頽敗道義地を拂うて、紳士も墮落し、靑年も墮落し、社會も墮落し、ドーも","xmin":2541.0,"ymin":657.0,"xmax":2600.0,"ymax":2134.0},{"id":16,"contenttext":"不都合の狀態を呈して來た、","xmin":2475.0,"ymin":657.0,"xmax":2528.0,"ymax":1222.0},{"id":17,"contenttext":"それがどういふ譯かといふと、詰り此の五ヶ","xmin":2469.0,"ymin":1260.0,"xmax":2523.0,"ymax":2130.0},{"id":18,"contenttext":"條の御誓文に舊來の陋習を破り天地の公道に基くべしと云ふことを考へ","xmin":2394.0,"ymin":657.0,"xmax":2454.0,"ymax":2130.0},{"id":19,"contenttext":"て居らぬ.","xmin":2328.0,"ymin":659.0,"xmax":2375.0,"ymax":850.0},{"id":20,"contenttext":"天地の公道といふのは古今に通じて謬らない、中外に施して悖","xmin":2323.0,"ymin":886.0,"xmax":2377.0,"ymax":2134.0},{"id":21,"contenttext":"らない大道でなくてはならぬ。","xmin":2260.0,"ymin":659.0,"xmax":2305.0,"ymax":1269.0},{"id":22,"contenttext":"是れ以上の天地の公道はない。","xmin":2254.0,"ymin":1303.0,"xmax":2303.0,"ymax":1915.0},{"id":23,"contenttext":"是れ以上","xmin":2252.0,"ymin":1951.0,"xmax":2299.0,"ymax":2134.0},{"id":24,"contenttext":"の天地の公道はないのだ.","xmin":2185.0,"ymin":659.0,"xmax":2234.0,"ymax":1173.0},{"id":25,"contenttext":"けれどもそこに氣が付かないで徒らに外國の","xmin":2180.0,"ymin":1209.0,"xmax":2231.0,"ymax":2128.0},{"id":26,"contenttext":"方に眼を走せて居るからさういふ狀態を呈して來る。","xmin":1845.0,"ymin":646.0,"xmax":1907.0,"ymax":1715.0},{"id":27,"contenttext":"大に皇基を振起す","xmin":1845.0,"ymin":1753.0,"xmax":1895.0,"ymax":2119.0},{"id":28,"contenttext":"べし、即ち知識を世界に求むるのは此の皇基を振起するのが目的である。","xmin":1763.0,"ymin":650.0,"xmax":1832.0,"ymax":2085.0},{"id":29,"contenttext":"徒らに外國の知識を求むるばかりでない。","xmin":1698.0,"ymin":644.0,"xmax":1756.0,"ymax":1484.0},{"id":30,"contenttext":"知識ばかり求めても何もなら","xmin":1697.0,"ymin":1523.0,"xmax":1746.0,"ymax":2121.0},{"id":31,"contenttext":"ぬ.","xmin":1637.0,"ymin":647.0,"xmax":1680.0,"ymax":699.0},{"id":32,"contenttext":"乾燥無味な人世ではない。","xmin":1629.0,"ymin":737.0,"xmax":1682.0,"ymax":1253.0},{"id":33,"contenttext":"そんな知識ばかりで人間は生活が出來る","xmin":1620.0,"ymin":1290.0,"xmax":1678.0,"ymax":2116.0},{"id":34,"contenttext":"ものではない。","xmin":1566.0,"ymin":647.0,"xmax":1606.0,"ymax":930.0},{"id":35,"contenttext":"其の知識を求むる所以のものは更に其の奧に大に皇基を","xmin":1549.0,"ymin":967.0,"xmax":1608.0,"ymax":2120.0},{"id":36,"contenttext":"振起して國民の眞生活を味はなくてはならないからである。","xmin":1476.0,"ymin":640.0,"xmax":1540.0,"ymax":1854.0},{"id":37,"contenttext":"其の事は忘","xmin":1475.0,"ymin":1891.0,"xmax":1531.0,"ymax":2120.0},{"id":38,"contenttext":"れて仕舞つて居る.","xmin":1409.0,"ymin":642.0,"xmax":1463.0,"ymax":1023.0},{"id":39,"contenttext":"肝腎なことを忘れて居る。","xmin":1407.0,"ymin":1059.0,"xmax":1459.0,"ymax":1578.0},{"id":40,"contenttext":"さういふ譯で一にも西洋、","xmin":1406.0,"ymin":1617.0,"xmax":1455.0,"ymax":2120.0},{"id":41,"contenttext":"二にも西洋。","xmin":1343.0,"ymin":645.0,"xmax":1390.0,"ymax":880.0},{"id":42,"contenttext":"政治でござれ、宗〓でござれ、道德でござれ、悉く西洋主義でな","xmin":1333.0,"ymin":918.0,"xmax":1392.0,"ymax":2118.0},{"id":43,"contenttext":"ければならぬと云ふ事になつて來た。","xmin":1261.0,"ymin":640.0,"xmax":1319.0,"ymax":1392.0},{"id":44,"contenttext":"西洋の文明に心醉してそれを殆ん","xmin":1259.0,"ymin":1429.0,"xmax":1311.0,"ymax":2120.0},{"id":45,"contenttext":"ど丸呑にした結果として實に日本國民は非常な混亂な狀態を呈して來た。","xmin":1184.0,"ymin":642.0,"xmax":1246.0,"ymax":2124.0},{"id":46,"contenttext":"學者であらうが、政治家であらうが、實に名狀すべからざる狀態になつて來","xmin":1111.0,"ymin":640.0,"xmax":1172.0,"ymax":2118.0},{"id":47,"contenttext":"た。","xmin":1055.0,"ymin":643.0,"xmax":1102.0,"ymax":699.0},{"id":48,"contenttext":"即ち今申した風俗頽敗道義地を拂うて、墮落に重ぬるに墮落を以つて","xmin":1041.0,"ymin":734.0,"xmax":1101.0,"ymax":2118.0},{"id":49,"contenttext":"し、かの百鬼晝行といふ有樣を現出した、","xmin":971.0,"ymin":640.0,"xmax":1029.0,"ymax":1434.0},{"id":50,"contenttext":"斯ういふ狀態を現出したので其","xmin":968.0,"ymin":1470.0,"xmax":1021.0,"ymax":2120.0},{"id":51,"contenttext":"神","xmin":918.0,"ymin":774.0,"xmax":959.0,"ymax":814.0},{"id":52,"contenttext":"道","xmin":920.0,"ymin":829.0,"xmax":961.0,"ymax":869.0},{"id":53,"contenttext":"大","xmin":918.0,"ymin":886.0,"xmax":959.0,"ymax":926.0}]