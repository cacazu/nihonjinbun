[{"id":1,"contenttext":"思ひます。","xmin":3109.0,"ymin":692.0,"xmax":3159.0,"ymax":879.0},{"id":2,"contenttext":"實に我が國に大道の存在する事は恰も天に日輪の懸かつて居","xmin":3100.0,"ymin":926.0,"xmax":3160.0,"ymax":2160.0},{"id":3,"contenttext":"るが如きもので、斯くの如く明らかで、斯くの如く明〓々たる大道が存在し","xmin":3026.0,"ymin":693.0,"xmax":3082.0,"ymax":2156.0},{"id":4,"contenttext":"て居るのに、是れには一向氣が附かずして徒らに外に求めると云ふのは、猶","xmin":2957.0,"ymin":694.0,"xmax":3009.0,"ymax":2158.0},{"id":5,"contenttext":"自分の頭が無くなつたと云つて騷いで居るのと同じ事だらうと思ふので","xmin":2883.0,"ymin":691.0,"xmax":2940.0,"ymax":2156.0},{"id":6,"contenttext":"す.","xmin":2816.0,"ymin":692.0,"xmax":2862.0,"ymax":740.0},{"id":7,"contenttext":"平田篤胤翁の父上は篤胤翁に向つて、若し孔子が日本の國に生れたな","xmin":2807.0,"ymin":784.0,"xmax":2865.0,"ymax":2158.0},{"id":8,"contenttext":"らば決して儒〓は說かないで我が神道を說いたに違ひない。","xmin":2734.0,"ymin":691.0,"xmax":2790.0,"ymax":1893.0},{"id":9,"contenttext":"我が國固有","xmin":2737.0,"ymin":1962.0,"xmax":2788.0,"ymax":2162.0},{"id":10,"contenttext":"の大道を說いたに違ひない。","xmin":2663.0,"ymin":694.0,"xmax":2714.0,"ymax":1245.0},{"id":11,"contenttext":"それ故に。其の方も此の方面に向つて研究し","xmin":2659.0,"ymin":1302.0,"xmax":2715.0,"ymax":2158.0},{"id":12,"contenttext":"ろと云ふ事を〓へられたと云ふ事である。","xmin":2583.0,"ymin":691.0,"xmax":2639.0,"ymax":1523.0},{"id":13,"contenttext":"成る程さうであらうと思ふ。","xmin":2587.0,"ymin":1587.0,"xmax":2631.0,"ymax":2123.0},{"id":14,"contenttext":"若し孟子が-支那の孟子が我が國に來て見ましたならば、村田春海一流の","xmin":2505.0,"ymin":691.0,"xmax":2561.0,"ymax":2154.0},{"id":15,"contenttext":"人物を評して所謂喬木を下つて幽谷に入る者とは是れ等の事であるかと","xmin":2432.0,"ymin":693.0,"xmax":2487.0,"ymax":2151.0},{"id":16,"contenttext":"云ふであらうと思ふ。","xmin":2365.0,"ymin":694.0,"xmax":2413.0,"ymax":1106.0},{"id":17,"contenttext":"高い所の地位を下つて態々薄暗い谷底に入る者と","xmin":2363.0,"ymin":1161.0,"xmax":2411.0,"ymax":2154.0},{"id":18,"contenttext":"は是れ等の事だらうと孟子は笑つたに相違ない。","xmin":2290.0,"ymin":693.0,"xmax":2344.0,"ymax":1659.0},{"id":19,"contenttext":"けれども吾々日本民族","xmin":2289.0,"ymin":1724.0,"xmax":2338.0,"ymax":2156.0},{"id":20,"contenttext":"に於いては斯くの如き輩を默過して笑つて濟ます譯には行かぬ。","xmin":2210.0,"ymin":693.0,"xmax":2271.0,"ymax":1983.0},{"id":21,"contenttext":"何うし","xmin":2215.0,"ymin":2055.0,"xmax":2262.0,"ymax":2152.0},{"id":22,"contenttext":"ても斯う云ふ連中から先づ以つて我が帝國の大道の存在を明らかにさせ","xmin":1794.0,"ymin":673.0,"xmax":1859.0,"ymax":2132.0},{"id":23,"contenttext":"ないと我が將來の國家を如何せんと斯う私は信ずるのであります。","xmin":1721.0,"ymin":669.0,"xmax":1780.0,"ymax":2009.0},{"id":24,"contenttext":"斯う述べて來ますると云ふと、讀者諸君の中には、そんな大道と云ふもの","xmin":1642.0,"ymin":716.0,"xmax":1704.0,"ymax":2134.0},{"id":25,"contenttext":"があると云ふ事は未だ克く聞かないが一體其の大道と云ふのは何んなも","xmin":1570.0,"ymin":671.0,"xmax":1629.0,"ymax":2136.0},{"id":26,"contenttext":"のであるか、我が帝國の大道とは何んなものであるか。","xmin":1495.0,"ymin":673.0,"xmax":1553.0,"ymax":1733.0},{"id":27,"contenttext":"斯う云ふ質問が出","xmin":1501.0,"ymin":1799.0,"xmax":1554.0,"ymax":2138.0},{"id":28,"contenttext":"て來ます。","xmin":1425.0,"ymin":675.0,"xmax":1474.0,"ymax":856.0},{"id":29,"contenttext":"私は此の質問に對しては神の道である。","xmin":1428.0,"ymin":907.0,"xmax":1477.0,"ymax":1687.0},{"id":30,"contenttext":"と斯う答へる。","xmin":1432.0,"ymin":1758.0,"xmax":1482.0,"ymax":2014.0},{"id":31,"contenttext":"世に","xmin":1437.0,"ymin":2087.0,"xmax":1478.0,"ymax":2136.0},{"id":32,"contenttext":"神道と申して居る神の道である。","xmin":1352.0,"ymin":671.0,"xmax":1409.0,"ymax":1318.0},{"id":33,"contenttext":"神の道である。","xmin":1359.0,"ymin":1377.0,"xmax":1408.0,"ymax":1643.0},{"id":34,"contenttext":"私が斯樣に申しまする","xmin":1359.0,"ymin":1708.0,"xmax":1408.0,"ymax":2136.0},{"id":35,"contenttext":"と、或は諸君の中に斯う云ふ考を抱かれる方があるかも知れない。","xmin":1280.0,"ymin":675.0,"xmax":1336.0,"ymax":1968.0},{"id":36,"contenttext":"日本の","xmin":1286.0,"ymin":2041.0,"xmax":1333.0,"ymax":2138.0},{"id":37,"contenttext":"固有の大道は神の道である。","xmin":1206.0,"ymin":675.0,"xmax":1257.0,"ymax":1227.0},{"id":38,"contenttext":"神道であると云つたが、それならば例の神社","xmin":1208.0,"ymin":1284.0,"xmax":1261.0,"ymax":2142.0},{"id":39,"contenttext":"の前で手を拍いたり或は祝詞を讀んだり玉串を上げたりするのが大道で","xmin":1134.0,"ymin":679.0,"xmax":1185.0,"ymax":2138.0},{"id":40,"contenttext":"あるか。","xmin":1059.0,"ymin":677.0,"xmax":1106.0,"ymax":812.0},{"id":41,"contenttext":"そんな大道なればとつくに知つて居る。","xmin":1056.0,"ymin":864.0,"xmax":1112.0,"ymax":1645.0},{"id":42,"contenttext":"そんな大道なれば信仰","xmin":1059.0,"ymin":1708.0,"xmax":1114.0,"ymax":2142.0},{"id":43,"contenttext":"しなくとも宜い。","xmin":987.0,"ymin":679.0,"xmax":1032.0,"ymax":999.0},{"id":44,"contenttext":"又そんな事のために態々勿體らしく下らぬ話をして貰","xmin":983.0,"ymin":1049.0,"xmax":1034.0,"ymax":2142.0},{"id":45,"contenttext":"はぬでも宜い。","xmin":914.0,"ymin":679.0,"xmax":959.0,"ymax":954.0},{"id":46,"contenttext":"そんな事なら止して貰はふと。","xmin":907.0,"ymin":1007.0,"xmax":961.0,"ymax":1598.0},{"id":47,"contenttext":"斯う云ふ樣な御考を持た","xmin":912.0,"ymin":1663.0,"xmax":961.0,"ymax":2140.0},{"id":48,"contenttext":"神","xmin":852.0,"ymin":824.0,"xmax":893.0,"ymax":851.0},{"id":49,"contenttext":"道","xmin":852.0,"ymin":876.0,"xmax":893.0,"ymax":905.0},{"id":50,"contenttext":"大","xmin":852.0,"ymin":935.0,"xmax":893.0,"ymax":963.0},{"id":51,"contenttext":"意","xmin":854.0,"ymin":993.0,"xmax":895.0,"ymax":1016.0}]