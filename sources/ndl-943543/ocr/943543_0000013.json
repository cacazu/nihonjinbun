[{"id":1,"contenttext":"云ふのは成程事實かも知れない。","xmin":3041.0,"ymin":664.0,"xmax":3098.0,"ymax":1314.0},{"id":2,"contenttext":"けれども外國にもさう云ふ例は幾らも","xmin":3045.0,"ymin":1365.0,"xmax":3099.0,"ymax":2126.0},{"id":3,"contenttext":"ある。","xmin":2972.0,"ymin":668.0,"xmax":3012.0,"ymax":756.0},{"id":4,"contenttext":"伯夷叔齊の如きは武王の紂を討つに臨んで馬を叩いて諫めて臣と","xmin":2966.0,"ymin":804.0,"xmax":3026.0,"ymax":2124.0},{"id":5,"contenttext":"して君を伐つ忠と云ふべきかと、かう云つて諫めた。","xmin":2892.0,"ymin":664.0,"xmax":2947.0,"ymax":1677.0},{"id":6,"contenttext":"又遂に周が天下を取","xmin":2896.0,"ymin":1743.0,"xmax":2956.0,"ymax":2130.0},{"id":7,"contenttext":"つて仕舞つてからは首陽山に隱れ周の粟を食はずと云つて蕨を食つて居","xmin":2814.0,"ymin":668.0,"xmax":2882.0,"ymax":2130.0},{"id":8,"contenttext":"つたが遂に餓死して仕舞つた。","xmin":2741.0,"ymin":668.0,"xmax":2799.0,"ymax":1265.0},{"id":9,"contenttext":"或は又レオニダス、是れはスパルタの王で","xmin":2746.0,"ymin":1319.0,"xmax":2800.0,"ymax":2126.0},{"id":10,"contenttext":"あるが僅に三千計りの兵を率ゐてペルシヤ二百萬の侵入軍を支へて、遂に","xmin":2668.0,"ymin":664.0,"xmax":2727.0,"ymax":2124.0},{"id":11,"contenttext":"スパルタ雅典の國家を全うしたではないか。","xmin":2597.0,"ymin":670.0,"xmax":2649.0,"ymax":1539.0},{"id":12,"contenttext":"さうして自分の身體は國家","xmin":2597.0,"ymin":1601.0,"xmax":2653.0,"ymax":2128.0},{"id":13,"contenttext":"のために犠牲にしたではないか。","xmin":2518.0,"ymin":666.0,"xmax":2576.0,"ymax":1309.0},{"id":14,"contenttext":"是れ等は皆君の云ふ神道と同じではな","xmin":2523.0,"ymin":1365.0,"xmax":2578.0,"ymax":2124.0},{"id":15,"contenttext":"いか。","xmin":2444.0,"ymin":668.0,"xmax":2492.0,"ymax":760.0},{"id":16,"contenttext":"又ネルソンと云ふ人は何うであるか。","xmin":2442.0,"ymin":806.0,"xmax":2500.0,"ymax":1540.0},{"id":17,"contenttext":"ナポレオンが彼の隆々たる","xmin":2448.0,"ymin":1605.0,"xmax":2503.0,"ymax":2124.0},{"id":18,"contenttext":"勢ひを以つて佛蘭西の主權者となり、佛蘭西·西班牙の聯合艦隊を以つて英","xmin":2366.0,"ymin":666.0,"xmax":2428.0,"ymax":2130.0},{"id":19,"contenttext":"吉利を一擧に取ひしがうと掛つた時に、ネルソンは之れをトラフアルガー","xmin":2302.0,"ymin":666.0,"xmax":2355.0,"ymax":2126.0},{"id":20,"contenttext":"の一戰で打破つた.","xmin":2232.0,"ymin":668.0,"xmax":2283.0,"ymax":1034.0},{"id":21,"contenttext":"其の破り方が一樣でない。","xmin":2232.0,"ymin":1086.0,"xmax":2283.0,"ymax":1584.0},{"id":22,"contenttext":"彼れは先づ戰の初に當つ","xmin":2233.0,"ymin":1647.0,"xmax":2290.0,"ymax":2122.0},{"id":23,"contenttext":"て將士に訓令して何と云つたか即ち英吉利の軍艦は······英吉利の海軍は如","xmin":2150.0,"ymin":666.0,"xmax":2216.0,"ymax":2128.0},{"id":24,"contenttext":"何なる場合に於いても人道を重んじなければならぬ。","xmin":1817.0,"ymin":670.0,"xmax":1865.0,"ymax":1731.0},{"id":25,"contenttext":"一度び敵が白旗を","xmin":1817.0,"ymin":1807.0,"xmax":1865.0,"ymax":2134.0},{"id":26,"contenttext":"揭げたならば之れに發砲しては可かぬと云ふ事を嚴命した。","xmin":1742.0,"ymin":668.0,"xmax":1795.0,"ymax":1868.0},{"id":27,"contenttext":"而して其の","xmin":1743.0,"ymin":1936.0,"xmax":1790.0,"ymax":2130.0},{"id":28,"contenttext":"例を自ら示さんが爲に敵の旗艦が白旗を揭げて進んで來たので、其の發砲","xmin":1670.0,"ymin":668.0,"xmax":1723.0,"ymax":2136.0},{"id":29,"contenttext":"を止めた所が、豈に圖らんや敵はネルソンを狙擊したのである。","xmin":1598.0,"ymin":668.0,"xmax":1647.0,"ymax":1917.0},{"id":30,"contenttext":"其の狙擊","xmin":1596.0,"ymin":1987.0,"xmax":1647.0,"ymax":2136.0},{"id":31,"contenttext":"の一彈にネルソンは斃れたのである。","xmin":1525.0,"ymin":672.0,"xmax":1574.0,"ymax":1408.0},{"id":32,"contenttext":"詰り彼れの所謂人道を重んじて彼","xmin":1523.0,"ymin":1469.0,"xmax":1572.0,"ymax":2134.0},{"id":33,"contenttext":"れの所謂人道の犧牲になつたのであります。","xmin":1451.0,"ymin":670.0,"xmax":1500.0,"ymax":1547.0},{"id":34,"contenttext":"外國にも斯う云ふ立派な人","xmin":1446.0,"ymin":1610.0,"xmax":1499.0,"ymax":2134.0},{"id":35,"contenttext":"を見出す事が出來るではないかと云ふ問題が起る。","xmin":1377.0,"ymin":670.0,"xmax":1427.0,"ymax":1684.0},{"id":36,"contenttext":"それは成程立派であ","xmin":1375.0,"ymin":1752.0,"xmax":1424.0,"ymax":2134.0},{"id":37,"contenttext":"る.","xmin":1316.0,"ymin":674.0,"xmax":1349.0,"ymax":713.0},{"id":38,"contenttext":"立派ではあるけれども私は此の行ひの精神、行ひの根本と云ふものが","xmin":1303.0,"ymin":764.0,"xmax":1358.0,"ymax":2132.0},{"id":39,"contenttext":"我が國の人の行つた根本の精神とは大變に違つて居ると思ふのである。","xmin":1230.0,"ymin":670.0,"xmax":1285.0,"ymax":2101.0},{"id":40,"contenttext":"又、我が國にも隨分惡い者が少なくなかつた。","xmin":1156.0,"ymin":670.0,"xmax":1212.0,"ymax":1549.0},{"id":41,"contenttext":"けれども支那の樣に萬乘の","xmin":1152.0,"ymin":1608.0,"xmax":1208.0,"ymax":2132.0},{"id":42,"contenttext":"君主を放伐して自ら君主となると云ふ樣な、所謂湯武の放伐と云ふ樣な事","xmin":1080.0,"ymin":670.0,"xmax":1141.0,"ymax":2136.0},{"id":43,"contenttext":"は無いのである。","xmin":1009.0,"ymin":672.0,"xmax":1059.0,"ymax":992.0},{"id":44,"contenttext":"王莽が漢の皇位を奪ひ、或は魏の曹孫が後漢の皇位を脅","xmin":1005.0,"ymin":1046.0,"xmax":1062.0,"ymax":2136.0},{"id":45,"contenttext":"し、或は又西洋で云へばピピンがフランク國を奪つてフランクの王位に即","xmin":934.0,"ymin":672.0,"xmax":988.0,"ymax":2132.0},{"id":46,"contenttext":"紳","xmin":875.0,"ymin":824.0,"xmax":914.0,"ymax":848.0},{"id":47,"contenttext":"大","xmin":875.0,"ymin":939.0,"xmax":916.0,"ymax":963.0}]