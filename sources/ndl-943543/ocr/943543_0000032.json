[{"id":1,"contenttext":"九","xmin":3059.0,"ymin":1002.0,"xmax":3130.0,"ymax":1044.0},{"id":2,"contenttext":"斯く申しますると又或る論者は斯う申しませう。","xmin":2959.0,"ymin":747.0,"xmax":3012.0,"ymax":1705.0},{"id":3,"contenttext":"君の云ふのは少し違","xmin":2954.0,"ymin":1794.0,"xmax":3009.0,"ymax":2156.0},{"id":4,"contenttext":"ふ.","xmin":2884.0,"ymin":705.0,"xmax":2931.0,"ymax":738.0},{"id":5,"contenttext":"君は〓育勅語を以つて神道の根本を示されたものだ。","xmin":2882.0,"ymin":796.0,"xmax":2935.0,"ymax":1843.0},{"id":6,"contenttext":"我が國固有の","xmin":2876.0,"ymin":1937.0,"xmax":2932.0,"ymax":2153.0},{"id":7,"contenttext":"大道を示されたものだと、斯う云ふけれども、〓育勅語は神道勅語ではない。","xmin":2804.0,"ymin":701.0,"xmax":2857.0,"ymax":2156.0},{"id":8,"contenttext":"〓育勅語ではないか。","xmin":2729.0,"ymin":702.0,"xmax":2783.0,"ymax":1104.0},{"id":9,"contenttext":"それは君の曲解であると斯う申しませう。","xmin":2729.0,"ymin":1176.0,"xmax":2783.0,"ymax":1983.0},{"id":10,"contenttext":"是れに","xmin":2728.0,"ymin":2080.0,"xmax":2773.0,"ymax":2152.0},{"id":11,"contenttext":"對しては私は辯ずる所がある。","xmin":2661.0,"ymin":701.0,"xmax":2708.0,"ymax":1288.0},{"id":12,"contenttext":"少なくとも三點の辯ずる所があるのです。","xmin":2657.0,"ymin":1364.0,"xmax":2705.0,"ymax":2158.0},{"id":13,"contenttext":"で、其の第一に於きましては、我が國に於いては昔から始終其の當時々々","xmin":2586.0,"ymin":751.0,"xmax":2640.0,"ymax":2152.0},{"id":14,"contenttext":"の天皇陛下があらびど神として即ち神樣として尊崇せられて居るのであ","xmin":2511.0,"ymin":705.0,"xmax":2567.0,"ymax":2154.0},{"id":15,"contenttext":"る.","xmin":2448.0,"ymin":707.0,"xmax":2485.0,"ymax":736.0},{"id":16,"contenttext":"吾々は神樣であると尊敬して居るのであります。","xmin":2439.0,"ymin":797.0,"xmax":2491.0,"ymax":1752.0},{"id":17,"contenttext":"吾が國民は皆然り","xmin":2438.0,"ymin":1840.0,"xmax":2488.0,"ymax":2154.0},{"id":18,"contenttext":"である。","xmin":2371.0,"ymin":705.0,"xmax":2416.0,"ymax":830.0},{"id":19,"contenttext":"〓育勅語は其の神樣の御〓である。","xmin":2365.0,"ymin":892.0,"xmax":2420.0,"ymax":1568.0},{"id":20,"contenttext":"神樣の御言葉である以上は、","xmin":2365.0,"ymin":1650.0,"xmax":2418.0,"ymax":2158.0},{"id":21,"contenttext":"其の示されてある所の道は神の道でありませう。","xmin":2292.0,"ymin":705.0,"xmax":2344.0,"ymax":1660.0},{"id":22,"contenttext":"第二には、勅語には斯道","xmin":2291.0,"ymin":1745.0,"xmax":2342.0,"ymax":2156.0},{"id":23,"contenttext":"は皇祖皇宗の遺訓と申されてあります。","xmin":2215.0,"ymin":705.0,"xmax":2266.0,"ymax":1474.0},{"id":24,"contenttext":"皇祖皇宗と申すのは何う云ふ御","xmin":2215.0,"ymin":1558.0,"xmax":2269.0,"ymax":2156.0},{"id":25,"contenttext":"方であるか。","xmin":1798.0,"ymin":699.0,"xmax":1848.0,"ymax":917.0},{"id":26,"contenttext":"即ち是れは天照大神を初として御歷代の天皇方である。","xmin":1785.0,"ymin":984.0,"xmax":1848.0,"ymax":2077.0},{"id":27,"contenttext":"而","xmin":1786.0,"ymin":2154.0,"xmax":1833.0,"ymax":2173.0},{"id":28,"contenttext":"して御歷代の天皇方は吾々の謂ふ所の神である.","xmin":1719.0,"ymin":696.0,"xmax":1774.0,"ymax":1657.0},{"id":29,"contenttext":"吾々は皆之れを神と祀","xmin":1711.0,"ymin":1745.0,"xmax":1767.0,"ymax":2155.0},{"id":30,"contenttext":"つて居るのであります。","xmin":1645.0,"ymin":701.0,"xmax":1694.0,"ymax":1149.0},{"id":31,"contenttext":"故に皇祖皇宗の遺訓は即ち神の御訓である。","xmin":1638.0,"ymin":1217.0,"xmax":1697.0,"ymax":2075.0},{"id":32,"contenttext":"即","xmin":1639.0,"ymin":2150.0,"xmax":1686.0,"ymax":2173.0},{"id":33,"contenttext":"ち神の道である。","xmin":1576.0,"ymin":696.0,"xmax":1623.0,"ymax":1010.0},{"id":34,"contenttext":"即ち皇祖皇宗の遺訓と申されたのは神の道と云ふのと","xmin":1567.0,"ymin":1080.0,"xmax":1622.0,"ymax":2150.0},{"id":35,"contenttext":"同義異語である。","xmin":1508.0,"ymin":694.0,"xmax":1553.0,"ymax":1010.0},{"id":36,"contenttext":"故に神の道と云ふのに決して差支はないのであります。","xmin":1502.0,"ymin":1075.0,"xmax":1551.0,"ymax":2156.0},{"id":37,"contenttext":"それから第三に〓育と云ふものに就いて見ます。","xmin":1428.0,"ymin":696.0,"xmax":1484.0,"ymax":1656.0},{"id":38,"contenttext":"〓育と申しますものは、","xmin":1425.0,"ymin":1743.0,"xmax":1478.0,"ymax":2154.0},{"id":39,"contenttext":"或る特殊の人間に施す所のものではないのでございます。","xmin":1352.0,"ymin":696.0,"xmax":1407.0,"ymax":1842.0},{"id":40,"contenttext":"勿論今日〓育","xmin":1347.0,"ymin":1935.0,"xmax":1403.0,"ymax":2157.0},{"id":41,"contenttext":"と云ふものを工業〓育とか商業〓育とか農業〓育とか色々な部に別けて","xmin":1272.0,"ymin":696.0,"xmax":1333.0,"ymax":2148.0},{"id":42,"contenttext":"居りますけれども、是れは學術の上の區別である。","xmin":1205.0,"ymin":694.0,"xmax":1258.0,"ymax":1656.0},{"id":43,"contenttext":"〓育其の物の區別では","xmin":1198.0,"ymin":1743.0,"xmax":1252.0,"ymax":2150.0},{"id":44,"contenttext":"ないのであります。","xmin":1136.0,"ymin":694.0,"xmax":1183.0,"ymax":1055.0},{"id":45,"contenttext":"でありまするからして勅語を下さるに就いても、工業","xmin":1127.0,"ymin":1124.0,"xmax":1181.0,"ymax":2152.0},{"id":46,"contenttext":"〓育勅語、商業〓育勅語、農業〓育勅語と云ふ樣に斯樣な澤山な勅語を下さ","xmin":1053.0,"ymin":694.0,"xmax":1114.0,"ymax":2148.0},{"id":47,"contenttext":"る必要は無いのであります。","xmin":994.0,"ymin":696.0,"xmax":1042.0,"ymax":1233.0},{"id":48,"contenttext":"何故かと申すと、物を〓へる場合には農業も","xmin":988.0,"ymin":1311.0,"xmax":1036.0,"ymax":2150.0},{"id":49,"contenttext":"〓へませう、商業も〓へませう、工業も〓へませう、其の智識技藝を授くるに","xmin":911.0,"ymin":694.0,"xmax":975.0,"ymax":2148.0},{"id":50,"contenttext":"神","xmin":862.0,"ymin":822.0,"xmax":897.0,"ymax":832.0},{"id":51,"contenttext":"道","xmin":862.0,"ymin":876.0,"xmax":899.0,"ymax":890.0},{"id":52,"contenttext":"大","xmin":860.0,"ymin":936.0,"xmax":901.0,"ymax":950.0},{"id":53,"contenttext":"意","xmin":865.0,"ymin":1000.0,"xmax":895.0,"ymax":1001.0}]