[{"id":1,"contenttext":"ありますけれども、前から申述べました樣に、家康公とか正成公とか道眞公","xmin":3061.0,"ymin":662.0,"xmax":3120.0,"ymax":2122.0},{"id":2,"contenttext":"とか、〓麿公とか、或は又人麿公とか云ふ樣な人々が示した所の一言一行、是","xmin":2988.0,"ymin":660.0,"xmax":3049.0,"ymax":2124.0},{"id":3,"contenttext":"れが悉く神道の典籍となつて居るのでございます。","xmin":2921.0,"ymin":658.0,"xmax":2971.0,"ymax":1672.0},{"id":4,"contenttext":"昔の學者は神道は天","xmin":2916.0,"ymin":1736.0,"xmax":2970.0,"ymax":2121.0},{"id":5,"contenttext":"地を以つて書籍と爲し日月を以つて證明と爲す。","xmin":2842.0,"ymin":658.0,"xmax":2901.0,"ymax":1628.0},{"id":6,"contenttext":"と云ひましたが、その言","xmin":2839.0,"ymin":1692.0,"xmax":2892.0,"ymax":2120.0},{"id":7,"contenttext":"葉の出所は暫らく置き實に立派な言葉である。","xmin":2769.0,"ymin":658.0,"xmax":2825.0,"ymax":1578.0},{"id":8,"contenttext":"是れが即ち神道である。","xmin":2765.0,"ymin":1644.0,"xmax":2819.0,"ymax":2085.0},{"id":9,"contenttext":"我が固有の大道であるのであります。","xmin":2694.0,"ymin":656.0,"xmax":2754.0,"ymax":1393.0},{"id":10,"contenttext":"詰り事實即ち大道である。","xmin":2696.0,"ymin":1457.0,"xmax":2745.0,"ymax":1948.0},{"id":11,"contenttext":"事實が","xmin":2694.0,"ymin":2019.0,"xmax":2745.0,"ymax":2117.0},{"id":12,"contenttext":"大道を證明して居るのであります。","xmin":2617.0,"ymin":654.0,"xmax":2680.0,"ymax":1347.0},{"id":13,"contenttext":"平田篤胤翁は斯う云つて居る。","xmin":2617.0,"ymin":1406.0,"xmax":2675.0,"ymax":1994.0},{"id":14,"contenttext":"一體","xmin":2620.0,"ymin":2074.0,"xmax":2666.0,"ymax":2119.0},{"id":15,"contenttext":"誠の道と申すものは事實の上にちやんと備はつて居るのである。","xmin":2541.0,"ymin":656.0,"xmax":2600.0,"ymax":1943.0},{"id":16,"contenttext":"世の學","xmin":2542.0,"ymin":2019.0,"xmax":2594.0,"ymax":2119.0},{"id":17,"contenttext":"者等は兎角〓の書でなければ道は得られぬ事のやうに心得て居りまする","xmin":2465.0,"ymin":654.0,"xmax":2525.0,"ymax":2115.0},{"id":18,"contenttext":"けれども、それは大變間違つて居る。","xmin":2396.0,"ymin":654.0,"xmax":2451.0,"ymax":1343.0},{"id":19,"contenttext":"事實がちやんとあるならば〓は必ず","xmin":2395.0,"ymin":1402.0,"xmax":2446.0,"ymax":2117.0},{"id":20,"contenttext":"しも要らないのである。","xmin":2325.0,"ymin":654.0,"xmax":2381.0,"ymax":1110.0},{"id":21,"contenttext":"道の實事がないから〓は起るのである。","xmin":2322.0,"ymin":1168.0,"xmax":2378.0,"ymax":1944.0},{"id":22,"contenttext":"是れは","xmin":2322.0,"ymin":2019.0,"xmax":2373.0,"ymax":2119.0},{"id":23,"contenttext":"篤胤翁の說であるが實に其の通りであると思ひます。","xmin":2247.0,"ymin":654.0,"xmax":2306.0,"ymax":1719.0},{"id":24,"contenttext":"さて、曩に私は神に上下があると云ふ事を申して置ました。","xmin":2170.0,"ymin":705.0,"xmax":2231.0,"ymax":1854.0},{"id":25,"contenttext":"一軒の家の","xmin":2173.0,"ymin":1933.0,"xmax":2226.0,"ymax":2117.0},{"id":26,"contenttext":"一軒の家の","xmin":2173.0,"ymin":1933.0,"xmax":2226.0,"ymax":2117.0},{"id":27,"contenttext":"御上さんも神であれば、一國の君主も神樣である。","xmin":1815.0,"ymin":638.0,"xmax":1861.0,"ymax":1600.0},{"id":28,"contenttext":"それで東照宮とか、湊川","xmin":1817.0,"ymin":1670.0,"xmax":1866.0,"ymax":2097.0},{"id":29,"contenttext":"神社とか、天滿宮とか云ふ樣な神樣は尊い神である。","xmin":1743.0,"ymin":636.0,"xmax":1792.0,"ymax":1648.0},{"id":30,"contenttext":"尊い神であるけれど","xmin":1747.0,"ymin":1717.0,"xmax":1797.0,"ymax":2097.0},{"id":31,"contenttext":"も、併し其の最も尊いのは天祖天照大神を初として此の御歷代の皇統の方","xmin":1668.0,"ymin":640.0,"xmax":1726.0,"ymax":2099.0},{"id":32,"contenttext":"々の神樣であります。","xmin":1593.0,"ymin":640.0,"xmax":1648.0,"ymax":1051.0},{"id":33,"contenttext":"それで此の天祖天照大神を初として御歷代の神々","xmin":1597.0,"ymin":1107.0,"xmax":1657.0,"ymax":2097.0},{"id":34,"contenttext":"の示されたものが即ち神道のブリンシバルパートになつて居る。","xmin":1523.0,"ymin":640.0,"xmax":1576.0,"ymax":1927.0},{"id":35,"contenttext":"其の要","xmin":1529.0,"ymin":2003.0,"xmax":1580.0,"ymax":2103.0},{"id":36,"contenttext":"部となつて居るのである。","xmin":1449.0,"ymin":636.0,"xmax":1496.0,"ymax":1142.0},{"id":37,"contenttext":"然らば其の一斑は何う云ふものであるかと云","xmin":1451.0,"ymin":1201.0,"xmax":1505.0,"ymax":2103.0},{"id":38,"contenttext":"ふと、天照大神が皇孫を此の國に降さるる時に三種の神器を下さつて、其の","xmin":1373.0,"ymin":640.0,"xmax":1433.0,"ymax":2099.0},{"id":39,"contenttext":"時に天壤無窮の神勅を授けられたのであるが、是れが神道の根本となつて","xmin":1298.0,"ymin":638.0,"xmax":1358.0,"ymax":2105.0},{"id":40,"contenttext":"居る。","xmin":1228.0,"ymin":638.0,"xmax":1275.0,"ymax":727.0},{"id":41,"contenttext":"それから後に崇神天皇が即位の四年に、惟れ我が皇祖諸〓の天皇だち","xmin":1225.0,"ymin":780.0,"xmax":1287.0,"ymax":2107.0},{"id":42,"contenttext":"宸極に光臨せられたのは豈に一身の爲で在うか、さうではない。","xmin":1148.0,"ymin":638.0,"xmax":1212.0,"ymax":1886.0},{"id":43,"contenttext":"蓋し人神","xmin":1158.0,"ymin":1959.0,"xmax":1213.0,"ymax":2108.0},{"id":44,"contenttext":"ヒ","xmin":1126.0,"ymin":1867.0,"xmax":1153.0,"ymax":1876.0},{"id":45,"contenttext":"を司牧し天下を經綸せられん爲である。","xmin":1074.0,"ymin":638.0,"xmax":1133.0,"ymax":1423.0},{"id":46,"contenttext":"故に能く世〓玄功を闡め時に至德","xmin":1082.0,"ymin":1486.0,"xmax":1135.0,"ymax":2105.0},{"id":47,"contenttext":"を流かれたのである。","xmin":1000.0,"ymin":638.0,"xmax":1056.0,"ymax":1053.0},{"id":48,"contenttext":"今朕大道を奉承して萬民を愛育し、如何にしてか皇","xmin":1003.0,"ymin":1109.0,"xmax":1067.0,"ymax":2107.0},{"id":49,"contenttext":"祖の跡に遵ひ、永く無窮の祚を保たん。","xmin":925.0,"ymin":640.0,"xmax":985.0,"ymax":1380.0},{"id":50,"contenttext":"其れ群卿百僚爾の忠貞を竭して並","xmin":930.0,"ymin":1436.0,"xmax":990.0,"ymax":2109.0},{"id":52,"contenttext":"道","xmin":871.0,"ymin":847.0,"xmax":914.0,"ymax":877.0},{"id":53,"contenttext":"大","xmin":871.0,"ymin":903.0,"xmax":914.0,"ymax":932.0},{"id":54,"contenttext":"意","xmin":871.0,"ymin":961.0,"xmax":914.0,"ymax":985.0}]