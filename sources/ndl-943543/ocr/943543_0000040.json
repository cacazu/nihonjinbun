":1662.0,"xmax":1766.0,"ymax":1731.0},{"id":24,"contenttext":"十","xmin":1704.0,"ymin":1746.0,"xmax":1764.0,"ymax":1813.0},{"id":25,"contenttext":"二","xmin":1707.0,"ymin":1833.0,"xmax":1758.0,"ymax":1899.0},{"id":26,"contenttext":"錢","xmin":1704.0,"ymin":1917.0,"xmax":1766.0,"ymax":1980.0},{"id":27,"contenttext":"萬朝報」評","xmin":1637.0,"ymin":662.0,"xmax":1686.0,"ymax":837.0},{"id":28,"contenttext":"家庭教育以て學校教育社會教育などゝ共に一個の特立したる教育學たらしめんとして、","xmin":1659.0,"ymin":870.0,"xmax":1703.0,"ymax":1962.0},{"id":29,"contenttext":"之","xmin":1670.0,"ymin":1972.0,"xmax":1703.0,"ymax":2007.0},{"id":30,"contenttext":"を系統的に論述したるものそがて此家庭教育學なり、","xmin":1635.0,"ymin":872.0,"xmax":1670.0,"ymax":1539.0},{"id":31,"contenttext":"篇を分つこと八更に之を二十九章八","xmin":1639.0,"ymin":1549.0,"xmax":1675.0,"ymax":2005.0},{"id":32,"contenttext":"十九節に分ち家庭教育の意義由來目的より始めて","xmin":1604.0,"ymin":695.0,"xmax":1642.0,"ymax":1325.0},{"id":33,"contenttext":"結婚住居姙娠胎〓出產哺乳子守疾病看病智育情育意","xmin":1605.0,"ymin":1348.0,"xmax":1648.0,"ymax":2005.0},{"id":34,"contenttext":"育母の任務家庭教師などに至るまで","xmin":1578.0,"ymin":697.0,"xmax":1610.0,"ymax":1153.0},{"id":35,"contenttext":"極めて微に入り細に亘りて詳述し擧げられたる項目の數のみにて","xmin":1577.0,"ymin":1178.0,"xmax":1618.0,"ymax":2005.0},{"id":36,"contenttext":"も實に四百數十の多きに及び、","xmin":1549.0,"ymin":698.0,"xmax":1582.0,"ymax":1081.0},{"id":37,"contenttext":"述論整然として頗る要を得系統的に論述されたる此種の著書として蓋","xmin":1548.0,"ymin":1093.0,"xmax":1590.0,"ymax":1979.0},{"id":38,"contenttext":"し","xmin":1559.0,"ymin":1974.0,"xmax":1590.0,"ymax":2005.0},{"id":39,"contenttext":"オーソリチーたるに足らん","xmin":1520.0,"ymin":698.0,"xmax":1556.0,"ymax":1043.0},{"id":40,"contenttext":"加ふるに口語調を採りて平易なる記述を試みたるは双手を擧げて吾人の最","xmin":1518.0,"ymin":1062.0,"xmax":1564.0,"ymax":2007.0},{"id":41,"contenttext":"も歡ぶ所、","xmin":1490.0,"ymin":698.0,"xmax":1527.0,"ymax":826.0},{"id":42,"contenttext":"評者は此書を一般家庭の珍として推奨するに吝かなるものにあらざるなり","xmin":1493.0,"ymin":838.0,"xmax":1533.0,"ymax":1778.0},{"id":43,"contenttext":"「東京日日新聞」許","xmin":1441.0,"ymin":643.0,"xmax":1490.0,"ymax":952.0},{"id":44,"contenttext":"兒童の成長後如何なる人物となるかは兒童の遺傳、","xmin":1465.0,"ymin":979.0,"xmax":1502.0,"ymax":1621.0},{"id":45,"contenttext":"性癖、","xmin":1469.0,"ymin":1627.0,"xmax":1502.0,"ymax":1702.0},{"id":46,"contenttext":"境遇等に基くと雖も亦","xmin":1470.0,"ymin":1713.0,"xmax":1506.0,"ymax":2002.0},{"id":47,"contenttext":"家庭の〓養如何に關係する所多し自ら一世に卓越せる顯官を帶び高位にあるも","xmin":1436.0,"ymin":981.0,"xmax":1477.0,"ymax":1975.0},{"id":48,"contenttext":"の","xmin":1445.0,"ymin":1974.0,"xmax":1475.0,"ymax":2003.0},{"id":49,"contenttext":"と雖も其子にして往々不良低能の子を養ひ自ら憂慮と不快とに捕はれつゝあるは現世幾多の實例あり是","xmin":1407.0,"ymin":698.0,"xmax":1450.0,"ymax":2005.0},{"id":50,"contenttext":"に於てか家庭教育の問題は實際問題として蓋し痛切ならずんばあらず本書は著者か之を救濟せんとて公","xmin":1381.0,"ymin":698.0,"xmax":1423.0,"ymax":2003.0},{"id":51,"contenttext":"にしたるもの家庭〓育の意義並に目的より說き起して根柢論たる結婚住居姙娠胎〓に及び養護論に入り","xmin":1352.0,"ymin":697.0,"xmax":1395.0,"ymax":2005.0},{"id":52,"contenttext":"ては出產飮食衣服睡眠入浴子守を論じ疾病傳染病看病法を說き智育論に入りて初歩の〓育家庭〓育社會","xmin":1327.0,"ymin":697.0,"xmax":1368.0,"ymax":2002.0},{"id":53,"contenttext":"資金杯信息は予以後に其所命にしています","xmin":1303.0,"ymin":697.0,"xmax":1341.0,"ymax":2005.0},{"id":54,"contenttext":"家庭教育の印象を論じ尙餘論として母の任務家庭教師等の事を論ず子を持つ父母たるものゝ","xmin":1272.0,"ymin":695.0,"xmax":1316.0,"ymax":1862.0},{"id":55,"contenttext":"一讀す","xmin":1286.0,"ymin":1864.0,"xmax":1316.0,"ymax":1948.0},{"id":56,"contenttext":"べき","xmin":1286.0,"ymin":1948.0,"xmax":1314.0,"ymax":2005.0},{"id":57,"contenttext":"良書たり","xmin":1245.0,"ymin":695.0,"xmax":1278.0,"ymax":813.0},{"id":58,"contenttext":"「國民新聞」評","xmin":1196.0,"ymin":646.0,"xmax":1246.0,"ymax":879.0},{"id":59,"contenttext":"從來の教育學の家庭〓育に關する注意尠なきのみか家庭教育も學校教育も極めて雜〓な","xmin":1215.0,"ymin":890.0,"xmax":1261.0,"ymax":2001.0},{"id":60,"contenttext":"る〓究の裡に委せらるゝ","xmin":1187.0,"ymin":894.0,"xmax":1226.0,"ymax":1202.0},{"id":61,"contenttext":"を憾み教育の始期を母胎教育に始まるとして家庭〓育に於ける","xmin":1188.0,"ymin":1200.0,"xmax":1230.0,"ymax":2001.0},{"id":62,"contenttext":"切の後なおかんとでも思いと","xmin":1158.0,"ymin":704.0,"xmax":1201.0,"ymax":2003.0},{"id":63,"contenttext":"の興味を旨とし言文一致體を採れるまで注意到れり家庭何人も讀んで益を得ること多し","xmin":1127.0,"ymin":698.0,"xmax":1172.0,"ymax":1805.0},{"id":64,"contenttext":"「靑年及靑年團」評","xmin":1081.0,"ymin":646.0,"xmax":1128.0,"ymax":952.0},{"id":65,"contenttext":"いのは遠郷である何これれ數會の基礎は家隆にあるのであるから此","xmin":1077.0,"ymin":982.0,"xmax":1115.0,"ymax":2001.0},{"id":66,"contenttext":"學校教育としての教育學の書は乏しからざるも家庭教育を科學的に〓究した者の","xmin":1103.0,"ymin":984.0,"xmax":1146.0,"ymax":1999.0},{"id":67,"contenttext":"が完全に行はれなければ學校教育も充分なるを得ない","xmin":1043.0,"ymin":697.0,"xmax":1085.0,"ymax":1374.0},{"id":68,"contenttext":"0","xmin":1044.0,"ymin":1368.0,"xmax":1075.0,"ymax":1402.0},{"id":69,"contenttext":"らである、文學士田中義能君は篤學の士である、","xmin":1046.0,"ymin":1397.0,"xmax":1088.0,"ymax":1997.0},{"id":70,"contenttext":"其の大學院にある頃より期道に關する歐米大學の著書は勿論","xmin":1013.0,"ymin":698.0,"xmax":1056.0,"ymax":1463.0},{"id":71,"contenttext":"和漢古今の斷片零墨まで","xmin":1020.0,"ymin":1486.0,"xmax":1055.0,"ymax":1801.0},{"id":72,"contenttext":"も渉獵せられ、","xmin":1023.0,"ymin":1806.0,"xmax":1059.0,"ymax":1987.0},{"id":73,"contenttext":"且之を自己愛兒養育の實驗に徵し本書を大成せら","xmin":988.0,"ymin":698.0,"xmax":1028.0,"ymax":1320.0},{"id":74,"contenttext":"る","xmin":993.0,"ymin":1315.0,"xmax":1021.0,"ymax":1348.0},{"id":75,"contenttext":"叙述序あり說明懇切を極し","xmin":991.0,"ymin":1371.0,"xmax":1026.0,"ymax":1719.0},{"id":76,"contenttext":"實に我國に於ける此","xmin":994.0,"ymin":1741.0,"xmax":1031.0,"ymax":1999.0},{"id":77,"contenttext":"種の著書の白眉と","xmin":961.0,"ymin":700.0,"xmax":996.0,"ymax":928.0},{"id":78,"contenttext":"い","xmin":962.0,"ymin":927.0,"xmax":993.0,"ymax":954.0},{"id":79,"contenttext":"ふべきである","xmin":965.0,"ymin":951.0,"xmax":995.0,"ymax":1126.0},{"id":80,"contenttext":"故に愛兒の","xmin":968.0,"ymin":1144.0,"xmax":997.0,"ymax":1294.0},{"id":81,"contenttext":"〓育に苦心せらるゝ父母及將來賢夫良妻たらんとせらる","xmin":962.0,"ymin":1288.0,"xmax":1004.0,"ymax":1997.0},{"id":82,"contenttext":"る兄姉及教育家は之を熱讀せられなば多大なる","xmin":932.0,"ymin":700.0,"xmax":967.0,"ymax":1294.0},{"id":83,"contenttext":"利益を得らるゝことは疑ありませぬ","xmin":934.0,"ymin":1290.0,"xmax":972.0,"ymax":1744.0},{"id":84,"contenttext":"文學士","xmin":1893.0,"ymin":1014.0,"xmax":1960.0,"ymax":1173.0},{"id":85,"contenttext":"田神京東","xmin":1698.0,"ymin":2054.0,"xmax":1935.0,"ymax":2113.0},{"id":86,"contenttext":"家","xmin":1729.0,"ymin":789.0,"xmax":1852.0,"ymax":914.0},{"id":87,"contenttext":"會株","xmin":1578.0,"ymin":2034.0,"xmax":1666.0,"ymax":2084.0},{"id":88,"contenttext":"社式","xmin":1578.0,"ymin":2084.0,"xmax":1668.0,"ymax":2132.0},{"id":89,"contenttext":"同","xmin":1467.0,"ymin":2038.0,"xmax":1556.0,"ymax":2130.0},{"id":90,"contenttext":"館文","xmin":1249.0,"ymin":2036.0,"xmax":1452.0,"ymax":2133.0},{"id":91,"contenttext":"町保神表","xmin":976.0,"ymin":2050.0,"xmax":1219.0,"ymax":2109.0}]