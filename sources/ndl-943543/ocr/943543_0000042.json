[{"id":0,"contenttext":"『東京朝日新聞』(九二三八號)評","xmin":3106.0,"ymin":787.0,"xmax":3164.0,"ymax":1319.0},{"id":1,"contenttext":"本居宣長の世界、","xmin":3047.0,"ymin":861.0,"xmax":3098.0,"ymax":1149.0},{"id":2,"contenttext":"人生に關する一代の學說を系統的組織的に述べたる書にし","xmin":3036.0,"ymin":1157.0,"xmax":3096.0,"ymax":2128.0},{"id":3,"contenttext":"故に一面より見れば我","xmin":2968.0,"ymin":1748.0,"xmax":3023.0,"ymax":2130.0},{"id":4,"contenttext":"て、","xmin":2986.0,"ymin":866.0,"xmax":3026.0,"ymax":922.0},{"id":5,"contenttext":"併せて其學統に屬する學者の學說をも叙述せり。","xmin":2973.0,"ymin":933.0,"xmax":3032.0,"ymax":1740.0},{"id":6,"contenttext":"邦に於ける復古神道派の哲學を綜說せるものと謂ふべく、","xmin":2909.0,"ymin":859.0,"xmax":2965.0,"ymax":1809.0},{"id":7,"contenttext":"祖宗の遺訓を闡發","xmin":2904.0,"ymin":1822.0,"xmax":2957.0,"ymax":2128.0},{"id":8,"contenttext":"せる皇道即ち神道派の世道人心の上に及ばせる功績は此書出でたるがために","xmin":2841.0,"ymin":859.0,"xmax":2902.0,"ymax":2124.0},{"id":9,"contenttext":"いよ〓〓顯著なるべし。","xmin":2790.0,"ymin":866.0,"xmax":2835.0,"ymax":1257.0},{"id":10,"contenttext":"『讀賣新聞』(一二五八二號)評","xmin":2718.0,"ymin":779.0,"xmax":2777.0,"ymax":1274.0},{"id":11,"contenttext":"田中義能氏さきに「平田篤胤之哲學」を著はす、本居は即ち平田の師事せし所、","xmin":2646.0,"ymin":855.0,"xmax":2710.0,"ymax":2124.0},{"id":12,"contenttext":"著者の近業ある所以なり、","xmin":2605.0,"ymin":855.0,"xmax":2656.0,"ymax":1288.0},{"id":13,"contenttext":"思ふに著者が復古神道派の哲學に忠ならんとする","xmin":2595.0,"ymin":1300.0,"xmax":2652.0,"ymax":2122.0},{"id":14,"contenttext":"精神は、","xmin":2553.0,"ymin":855.0,"xmax":2604.0,"ymax":991.0},{"id":15,"contenttext":"此の二書によりて十二分に江湖に知られたりと謂ふ可し。","xmin":2541.0,"ymin":1002.0,"xmax":2600.0,"ymax":1958.0},{"id":16,"contenttext":"『萬朝報』(六七三六號)評","xmin":2485.0,"ymin":777.0,"xmax":2539.0,"ymax":1200.0},{"id":17,"contenttext":"本居宣長が神道哲學の鼓吹者として將た國學者として、","xmin":2424.0,"ymin":853.0,"xmax":2483.0,"ymax":1770.0},{"id":18,"contenttext":"我國思想史上の大立","xmin":2417.0,"ymin":1780.0,"xmax":2476.0,"ymax":2126.0},{"id":19,"contenttext":"物たるは言はずもがな。","xmin":2375.0,"ymin":853.0,"xmax":2426.0,"ymax":1249.0},{"id":20,"contenttext":"其熱誠をこめたる忠君愛國說の、","xmin":2368.0,"ymin":1262.0,"xmax":2423.0,"ymax":1803.0},{"id":21,"contenttext":"やがて維新の鴻業","xmin":2363.0,"ymin":1817.0,"xmax":2419.0,"ymax":2122.0},{"id":22,"contenttext":"に及ぼせる影響も亦甚だ大ならずんばあらず。","xmin":2316.0,"ymin":855.0,"xmax":2372.0,"ymax":1619.0},{"id":23,"contenttext":"著者曩に平田篤胤之哲學を著","xmin":2309.0,"ymin":1629.0,"xmax":2363.0,"ymax":2122.0},{"id":24,"contenttext":"して、","xmin":2275.0,"ymin":855.0,"xmax":2314.0,"ymax":952.0},{"id":25,"contenttext":"今又此偉人を說き、","xmin":2266.0,"ymin":961.0,"xmax":2316.0,"ymax":1285.0},{"id":26,"contenttext":"學說は勿論進んでその學統に屬する多數學者の諸","xmin":2262.0,"ymin":1299.0,"xmax":2314.0,"ymax":2120.0},{"id":27,"contenttext":"說をも叙し、","xmin":2217.0,"ymin":853.0,"xmax":2267.0,"ymax":1063.0},{"id":28,"contenttext":"所謂復古神道學派の哲學を明にせんとしたり。","xmin":2209.0,"ymin":1072.0,"xmax":2265.0,"ymax":1842.0},{"id":29,"contenttext":"考證頗る之を努","xmin":2206.0,"ymin":1850.0,"xmax":2259.0,"ymax":2122.0},{"id":30,"contenttext":"め所論穩健。","xmin":2160.0,"ymin":855.0,"xmax":2211.0,"ymax":1067.0},{"id":31,"contenttext":"大體に於て能く其時代と人との面影を說き得たるを見る。","xmin":2150.0,"ymin":1074.0,"xmax":2210.0,"ymax":2026.0},{"id":32,"contenttext":"學哲之長宣居本","xmin":2280.0,"ymin":577.0,"xmax":3044.0,"ymax":713.0},{"id":33,"contenttext":"『神風』(一二三號)評","xmin":1897.0,"ymin":806.0,"xmax":1951.0,"ymax":1153.0},{"id":34,"contenttext":"我が神道學者として造詣深き文學士田中義能氏は、","xmin":1849.0,"ymin":880.0,"xmax":1901.0,"ymax":1723.0},{"id":35,"contenttext":"前に平田篤胤之哲學を刊","xmin":1846.0,"ymin":1738.0,"xmax":1902.0,"ymax":2157.0},{"id":36,"contenttext":"行せられ斯道界に一大貢獻を與へられたる事は遍く世人の敬慕する處なるが","xmin":1809.0,"ymin":884.0,"xmax":1857.0,"ymax":2152.0},{"id":37,"contenttext":"今囘更に本居宣長之哲學てふ一書を公にせられたり","xmin":1764.0,"ymin":880.0,"xmax":1816.0,"ymax":1751.0},{"id":38,"contenttext":"天明寬政の交該博なる學、","xmin":1721.0,"ymin":884.0,"xmax":1771.0,"ymax":1318.0},{"id":39,"contenttext":"卓拔なる識を以て我が神道哲學を攻究し、","xmin":1721.0,"ymin":1327.0,"xmax":1769.0,"ymax":2026.0},{"id":40,"contenttext":"復古神","xmin":1718.0,"ymin":2031.0,"xmax":1772.0,"ymax":2157.0},{"id":41,"contenttext":"道を天下に唱へ、","xmin":1678.0,"ymin":882.0,"xmax":1727.0,"ymax":1165.0},{"id":42,"contenttext":"以て固有の大道を喚起し、","xmin":1676.0,"ymin":1180.0,"xmax":1725.0,"ymax":1613.0},{"id":43,"contenttext":"奮然として思想界に一大革新を","xmin":1673.0,"ymin":1625.0,"xmax":1727.0,"ymax":2154.0},{"id":44,"contenttext":"大成せしめられたる我思想史上の大偉人本居大人は、","xmin":1626.0,"ymin":882.0,"xmax":1681.0,"ymax":1758.0},{"id":45,"contenttext":"愈氏によりて完全なる","xmin":1627.0,"ymin":1771.0,"xmax":1676.0,"ymax":2150.0},{"id":46,"contenttext":"哲學的研究を試みられたり。","xmin":1582.0,"ymin":882.0,"xmax":1634.0,"ymax":1345.0},{"id":47,"contenttext":"而も熱誠にして朴直なる著者が、","xmin":1582.0,"ymin":1364.0,"xmax":1628.0,"ymax":1908.0},{"id":48,"contenttext":"非凡の研鑽は","xmin":1580.0,"ymin":1920.0,"xmax":1629.0,"ymax":2150.0},{"id":49,"contenttext":"史家の本領たる公平を旨として、","xmin":1535.0,"ymin":882.0,"xmax":1589.0,"ymax":1423.0},{"id":50,"contenttext":"終始一貫し、","xmin":1535.0,"ymin":1438.0,"xmax":1588.0,"ymax":1650.0},{"id":51,"contenttext":"史材蘊奧、","xmin":1535.0,"ymin":1661.0,"xmax":1586.0,"ymax":1835.0},{"id":52,"contenttext":"文彩燦然として、","xmin":1530.0,"ymin":1848.0,"xmax":1585.0,"ymax":2132.0},{"id":53,"contenttext":"通讀百遍敢て倦まず、","xmin":1492.0,"ymin":882.0,"xmax":1539.0,"ymax":1241.0},{"id":54,"contenttext":"讀者をして自ら襟を正さしむる者あり。","xmin":1491.0,"ymin":1254.0,"xmax":1539.0,"ymax":1909.0},{"id":55,"contenttext":"蓋し之大人の","xmin":1488.0,"ymin":1920.0,"xmax":1535.0,"ymax":2150.0},{"id":56,"contenttext":"遺德なると共に、","xmin":1453.0,"ymin":882.0,"xmax":1496.0,"ymax":1165.0},{"id":57,"contenttext":"著者が常に我が學界の重鎭として、","xmin":1451.0,"ymin":1180.0,"xmax":1494.0,"ymax":1758.0},{"id":58,"contenttext":"夙に我が國民〓育の學","xmin":1445.0,"ymin":1771.0,"xmax":1492.0,"ymax":2152.0},{"id":59,"contenttext":"理と實際との上に貢獻せらるゝの深きによるなるべし。","xmin":1398.0,"ymin":882.0,"xmax":1454.0,"ymax":1791.0},{"id":60,"contenttext":"吾人は茲に一言して氏の研究を社會に紹介し、","xmin":1355.0,"ymin":880.0,"xmax":1404.0,"ymax":1651.0},{"id":61,"contenttext":"國民垂〓の勞を多とする所以","xmin":1353.0,"ymin":1659.0,"xmax":1402.0,"ymax":2154.0},{"id":62,"contenttext":"也","xmin":1318.0,"ymin":884.0,"xmax":1357.0,"ymax":930.0},{"id":63,"contenttext":"『神社協會雜誌』(第十一年第五號)評","xmin":1266.0,"ymin":804.0,"xmax":1322.0,"ymax":1415.0},{"id":64,"contenttext":"その精神を","xmin":1218.0,"ymin":1959.0,"xmax":1264.0,"ymax":2150.0},{"id":65,"contenttext":"<實にや鈴の舍一代の偉業は今更之を呶々するの要を見ずと雖も、","xmin":1217.0,"ymin":849.0,"xmax":1273.0,"ymax":1944.0},{"id":66,"contenttext":"研究し、","xmin":1177.0,"ymin":882.0,"xmax":1224.0,"ymax":1018.0},{"id":67,"contenttext":"その遺業を祖述せんは、","xmin":1173.0,"ymin":1027.0,"xmax":1225.0,"ymax":1426.0},{"id":68,"contenttext":"また容易の業にあらず。","xmin":1170.0,"ymin":1439.0,"xmax":1225.0,"ymax":1832.0},{"id":69,"contenttext":"著者專ら我國固有","xmin":1171.0,"ymin":1849.0,"xmax":1220.0,"ymax":2154.0},{"id":70,"contenttext":"の、","xmin":1134.0,"ymin":884.0,"xmax":1174.0,"ymax":938.0},{"id":71,"contenttext":"大道を正し、","xmin":1127.0,"ymin":953.0,"xmax":1180.0,"ymax":1165.0},{"id":72,"contenttext":"我國民〓育の學理と實際との上に貢献する所あらんことを","xmin":1121.0,"ymin":1176.0,"xmax":1180.0,"ymax":2152.0},{"id":73,"contenttext":"期し之を哲學の見地よりして評論するものなり。","xmin":1079.0,"ymin":884.0,"xmax":1133.0,"ymax":1682.0},{"id":74,"contenttext":"先きの「平田篤胤之哲學」と","xmin":1077.0,"ymin":1695.0,"xmax":1126.0,"ymax":2148.0},{"id":75,"contenttext":"併せ見るあらば、","xmin":1042.0,"ymin":882.0,"xmax":1085.0,"ymax":1161.0},{"id":76,"contenttext":"自ら「實踐哲學に於ける忠君愛國の說、","xmin":1035.0,"ymin":1176.0,"xmax":1085.0,"ymax":1813.0},{"id":77,"contenttext":"綱常彝倫の〓」は闡","xmin":1032.0,"ymin":1826.0,"xmax":1081.0,"ymax":2152.0},{"id":78,"contenttext":"明にせられむ。","xmin":995.0,"ymin":880.0,"xmax":1042.0,"ymax":1117.0},{"id":79,"contenttext":"その研究の飽まで眞面目にして、","xmin":993.0,"ymin":1141.0,"xmax":1040.0,"ymax":1684.0},{"id":80,"contenttext":"偉人宣長を系統的に解釋せ","xmin":989.0,"ymin":1695.0,"xmax":1040.0,"ymax":2150.0},{"id":81,"contenttext":"んことを努められたる、","xmin":950.0,"ymin":884.0,"xmax":995.0,"ymax":1273.0},{"id":82,"contenttext":"眞に著者を俟つて初めて得たるものといふべし。","xmin":942.0,"ymin":1287.0,"xmax":993.0,"ymax":2089.0},{"id":83,"contenttext":"五","xmin":893.0,"ymin":1867.0,"xmax":922.0,"ymax":1889.0},{"id":84,"contenttext":"反の論世","xmin":1281.0,"ymin":581.0,"xmax":1748.0,"ymax":697.0},{"id":85,"contenttext":"響","xmin":1161.0,"ymin":573.0,"xmax":1292.0,"ymax":705.0}]