[{"id":1,"contenttext":"夫婦相和しと云ふ事は儒〓ばかりでなく佛〓でも基督〓でも申しませう。","xmin":3080.0,"ymin":650.0,"xmax":3128.0,"ymax":2109.0},{"id":2,"contenttext":"併し帝國憲法と外國憲法と同じであると云ふが、字は同じであるかも知れ","xmin":3005.0,"ymin":647.0,"xmax":3058.0,"ymax":2105.0},{"id":3,"contenttext":"ぬが精密なる眼を持つて居るもの、精密なる觀察眼を持つて居るものは日","xmin":2933.0,"ymin":652.0,"xmax":2984.0,"ymax":2103.0},{"id":4,"contenttext":"本帝國憲法と外國憲法とは一番重要な劈頭第一に於いて既に違つて居る","xmin":2857.0,"ymin":650.0,"xmax":2910.0,"ymax":2107.0},{"id":5,"contenttext":"ことに氣が附くのである。","xmin":2782.0,"ymin":652.0,"xmax":2831.0,"ymax":1153.0},{"id":6,"contenttext":"即ち其の第一條には何と書いてあるか、大日本","xmin":2780.0,"ymin":1216.0,"xmax":2833.0,"ymax":2109.0},{"id":7,"contenttext":"帝國は萬世一系の天皇之れを統治す」と規定されてある。","xmin":2708.0,"ymin":650.0,"xmax":2759.0,"ymax":1751.0},{"id":8,"contenttext":"世界に國は澤山","xmin":2712.0,"ymin":1830.0,"xmax":2758.0,"ymax":2111.0},{"id":9,"contenttext":"あるけれども、世界に澤山憲法は布いてあるけれども、其の澤山の國、澤山の","xmin":2638.0,"ymin":652.0,"xmax":2688.0,"ymax":2109.0},{"id":10,"contenttext":"憲法中何處の憲法と雖も斯くの如き事を規定して居る事がありませうか。","xmin":2564.0,"ymin":652.0,"xmax":2618.0,"ymax":2111.0},{"id":11,"contenttext":"我が憲法は我が帝國統治の洪範、神道それ自身の一の發表で、かゝる憲法は","xmin":2493.0,"ymin":649.0,"xmax":2551.0,"ymax":2118.0},{"id":12,"contenttext":"何れの國に就いても見ることは出來ないのである。","xmin":2418.0,"ymin":652.0,"xmax":2469.0,"ymax":1662.0},{"id":13,"contenttext":"是れが抑〓我が憲法と","xmin":2413.0,"ymin":1735.0,"xmax":2471.0,"ymax":2111.0},{"id":14,"contenttext":"外國憲法と根本的に違つて居る所である。","xmin":2341.0,"ymin":652.0,"xmax":2396.0,"ymax":1477.0},{"id":15,"contenttext":"それと同じ樣に〓育勅語に於","xmin":2338.0,"ymin":1547.0,"xmax":2394.0,"ymax":2111.0},{"id":16,"contenttext":"いても其の言葉には多少似た所があるかも知れないが、其の精神の根本に","xmin":2261.0,"ymin":656.0,"xmax":2324.0,"ymax":2107.0},{"id":17,"contenttext":"於いては大變に違つて居る。","xmin":2193.0,"ymin":651.0,"xmax":2252.0,"ymax":1201.0},{"id":18,"contenttext":"世の近眼者流は此の根本の精神を見拔く事","xmin":2188.0,"ymin":1264.0,"xmax":2248.0,"ymax":2113.0},{"id":19,"contenttext":"が出來ない。","xmin":1791.0,"ymin":652.0,"xmax":1840.0,"ymax":875.0},{"id":20,"contenttext":"若し精密なる眼を以つて見たならば〓育勅語に於いても必","xmin":1786.0,"ymin":934.0,"xmax":1842.0,"ymax":2109.0},{"id":21,"contenttext":"ず其の根本の異つて居る事を見抜く事が出來るであらうと思ふ。","xmin":1712.0,"ymin":647.0,"xmax":1769.0,"ymax":1936.0},{"id":22,"contenttext":"此の根","xmin":1707.0,"ymin":2016.0,"xmax":1762.0,"ymax":2113.0},{"id":23,"contenttext":"本が即ち我が帝國の大道であるのであります。","xmin":1635.0,"ymin":645.0,"xmax":1696.0,"ymax":1568.0},{"id":24,"contenttext":"彼の神社の前に行つて手を拍いたり、祝詞を唱へたりするのは、此の我が","xmin":1560.0,"ymin":693.0,"xmax":1619.0,"ymax":2105.0},{"id":25,"contenttext":"帝國の大道が胸中一杯になつて、其の溢れた一部分が手を拍いたり祝詞を","xmin":1490.0,"ymin":643.0,"xmax":1548.0,"ymax":2107.0},{"id":26,"contenttext":"唱へたりする事になるのであります。","xmin":1426.0,"ymin":645.0,"xmax":1476.0,"ymax":1378.0},{"id":27,"contenttext":"唯〓手を拍いたり祝詞を讀む事が神","xmin":1412.0,"ymin":1436.0,"xmax":1473.0,"ymax":2108.0},{"id":28,"contenttext":"道であると云ふならばそれは大變な誤解であるのでございます。","xmin":1347.0,"ymin":643.0,"xmax":1402.0,"ymax":1936.0},{"id":29,"contenttext":"夫れ故","xmin":1339.0,"ymin":2016.0,"xmax":1394.0,"ymax":2107.0},{"id":30,"contenttext":"に我が國民は此の〓育勅語に示された所の根本の精神を體認して之れを","xmin":1266.0,"ymin":643.0,"xmax":1333.0,"ymax":2107.0},{"id":31,"contenttext":"實際に行つて參りましたならば、外の道は何も要らないのであります。","xmin":1193.0,"ymin":637.0,"xmax":1254.0,"ymax":2027.0},{"id":32,"contenttext":"外","xmin":1192.0,"ymin":2105.0,"xmax":1239.0,"ymax":2112.0},{"id":33,"contenttext":"に信ずる所は要らないのであります。","xmin":1124.0,"ymin":643.0,"xmax":1181.0,"ymax":1376.0},{"id":34,"contenttext":"我が先帝陛下は此の我が國の思想","xmin":1115.0,"ymin":1444.0,"xmax":1180.0,"ymax":2106.0},{"id":35,"contenttext":"界の混亂して居るのを大變に御心配なさつて此の〓育勅語を降し賜はつ","xmin":1042.0,"ymin":641.0,"xmax":1107.0,"ymax":2099.0},{"id":36,"contenttext":"て我が帝國の大道の根柢を示されたのであります。","xmin":977.0,"ymin":645.0,"xmax":1034.0,"ymax":1654.0}]