[{"id":1,"contenttext":"れる方もあるかも知れぬ。","xmin":3118.0,"ymin":688.0,"xmax":3171.0,"ymax":1196.0},{"id":2,"contenttext":"併し是れは大變な誤解で、毫釐の差之れを千里","xmin":3116.0,"ymin":1248.0,"xmax":3174.0,"ymax":2152.0},{"id":3,"contenttext":"に失すと昔から云つて居ります。","xmin":3049.0,"ymin":690.0,"xmax":3096.0,"ymax":1332.0},{"id":4,"contenttext":"譬へて見ればかの停車場に於いて少し","xmin":3045.0,"ymin":1389.0,"xmax":3100.0,"ymax":2152.0},{"id":5,"contenttext":"も東西南北を知らない所の老爺さん老婆さんが滊車に乘るとする。","xmin":2972.0,"ymin":688.0,"xmax":3027.0,"ymax":2027.0},{"id":6,"contenttext":"若し","xmin":2972.0,"ymin":2091.0,"xmax":3019.0,"ymax":2150.0},{"id":7,"contenttext":"東へ行く積りで一步過つて西行線の列車に乘つたら何うでありませうか。","xmin":2894.0,"ymin":688.0,"xmax":2948.0,"ymax":2156.0},{"id":8,"contenttext":"唯、乘る時の一步の誤りである。","xmin":2818.0,"ymin":688.0,"xmax":2869.0,"ymax":1286.0},{"id":9,"contenttext":"然るに其の翌日に於いては何うであるか","xmin":2818.0,"ymin":1340.0,"xmax":2869.0,"ymax":2150.0},{"id":10,"contenttext":"と云ふと自分の目的地とはまるで反對な、自分の目的地とは數百里を隔つ","xmin":2743.0,"ymin":688.0,"xmax":2798.0,"ymax":2150.0},{"id":11,"contenttext":"た方角に行く樣になつて居る。","xmin":2667.0,"ymin":688.0,"xmax":2718.0,"ymax":1290.0},{"id":12,"contenttext":"唯、初の一步の違ひから、初の少しの考へ違","xmin":2664.0,"ymin":1344.0,"xmax":2722.0,"ymax":2158.0},{"id":13,"contenttext":"ひで斯くの如き差が出來るのである。","xmin":2589.0,"ymin":688.0,"xmax":2641.0,"ymax":1424.0},{"id":14,"contenttext":"毫釐の差之れを千里に失すとは此","xmin":2589.0,"ymin":1483.0,"xmax":2645.0,"ymax":2156.0},{"id":15,"contenttext":"處である。","xmin":2520.0,"ymin":688.0,"xmax":2567.0,"ymax":873.0},{"id":16,"contenttext":"私は此の問題に就いてはいつでもいつでも度會延佳氏の管見","xmin":2516.0,"ymin":920.0,"xmax":2567.0,"ymax":2154.0},{"id":17,"contenttext":"の說を反復したいのであります。","xmin":2442.0,"ymin":690.0,"xmax":2493.0,"ymax":1335.0},{"id":18,"contenttext":"即ち延佳氏は玉串を持ち神語を唱へた","xmin":2439.0,"ymin":1389.0,"xmax":2496.0,"ymax":2154.0},{"id":19,"contenttext":"りする事などは、祭庭-祭りの庭の儀式であるが、是れも亦神道の一事にし","xmin":2365.0,"ymin":688.0,"xmax":2416.0,"ymax":2150.0},{"id":20,"contenttext":"て最も重しとする所である。","xmin":2290.0,"ymin":690.0,"xmax":2343.0,"ymax":1241.0},{"id":21,"contenttext":"即ち神道の最も重大なる一部である。","xmin":2288.0,"ymin":1294.0,"xmax":2345.0,"ymax":2028.0},{"id":22,"contenttext":"けれ","xmin":2293.0,"ymin":2093.0,"xmax":2340.0,"ymax":2150.0},{"id":23,"contenttext":"ども此の事ばかりを神道と思ふのは天を管から覗いて見た樣なものであ","xmin":2216.0,"ymin":690.0,"xmax":2273.0,"ymax":2152.0},{"id":24,"contenttext":"ると云ふ說を主張するのであります。","xmin":1804.0,"ymin":677.0,"xmax":1858.0,"ymax":1415.0},{"id":25,"contenttext":"一體世間には佛道だの、儒道だの、其","xmin":1809.0,"ymin":1487.0,"xmax":1864.0,"ymax":2152.0},{"id":26,"contenttext":"他、ナンの道、カンの道など申して、種々樣々の道を說くのですが此れ等は神","xmin":1732.0,"ymin":673.0,"xmax":1790.0,"ymax":2150.0},{"id":27,"contenttext":"道に比べて見ると極めて、狹小なもので、とても比較にならない樣なもので","xmin":1656.0,"ymin":673.0,"xmax":1713.0,"ymax":2148.0},{"id":28,"contenttext":"あります。","xmin":1592.0,"ymin":677.0,"xmax":1635.0,"ymax":861.0},{"id":29,"contenttext":"さう云ふ工合に神道と云ふ者は極めて宏大なものであります。","xmin":1583.0,"ymin":912.0,"xmax":1639.0,"ymax":2164.0},{"id":30,"contenttext":"それでは其の神道は何んなものであるか。","xmin":1510.0,"ymin":675.0,"xmax":1563.0,"ymax":1514.0},{"id":31,"contenttext":"もう少し十分な說明をして貰","xmin":1511.0,"ymin":1576.0,"xmax":1566.0,"ymax":2165.0},{"id":32,"contenttext":"ひたい。","xmin":1439.0,"ymin":675.0,"xmax":1484.0,"ymax":813.0},{"id":33,"contenttext":"斯う云ふ問題が起るでありませう。","xmin":1437.0,"ymin":862.0,"xmax":1486.0,"ymax":1558.0},{"id":34,"contenttext":"そこで神道は神の道である。","xmin":1439.0,"ymin":1620.0,"xmax":1490.0,"ymax":2162.0},{"id":35,"contenttext":"それでありますからして之れを十分に說くには先づ神と道との兩方面か","xmin":1360.0,"ymin":675.0,"xmax":1419.0,"ymax":2150.0},{"id":36,"contenttext":"ら說いて行かなければならぬ。","xmin":1290.0,"ymin":673.0,"xmax":1341.0,"ymax":1281.0},{"id":37,"contenttext":"でありますけれども之れを十分に說くに","xmin":1287.0,"ymin":1338.0,"xmax":1345.0,"ymax":2150.0},{"id":38,"contenttext":"は大變な問題になつて來ますから、茲では簡單に申します。","xmin":1216.0,"ymin":673.0,"xmax":1266.0,"ymax":1838.0},{"id":39,"contenttext":"此の神と云ふ","xmin":1220.0,"ymin":1904.0,"xmax":1271.0,"ymax":2154.0},{"id":40,"contenttext":"ものに就いて、神とは何ぞや、神の觀念は如何と云ふ。","xmin":1142.0,"ymin":675.0,"xmax":1196.0,"ymax":1700.0},{"id":41,"contenttext":"此の問題は昔から色","xmin":1144.0,"ymin":1761.0,"xmax":1198.0,"ymax":2156.0},{"id":42,"contenttext":"々の學者が色々に頭を惱めて居るのでございます。","xmin":1067.0,"ymin":675.0,"xmax":1116.0,"ymax":1701.0}]