[{"id":0,"contenttext":"10","xmin":3174.0,"ymin":1849.0,"xmax":3205.0,"ymax":1886.0},{"id":1,"contenttext":"文學士","xmin":3068.0,"ymin":584.0,"xmax":3174.0,"ymax":865.0},{"id":2,"contenttext":"田中義能著","xmin":3060.0,"ymin":915.0,"xmax":3173.0,"ymax":1379.0},{"id":3,"contenttext":"平田篤胤之哲學","xmin":2724.0,"ymin":600.0,"xmax":3055.0,"ymax":2026.0},{"id":4,"contenttext":"菊判洋裝上製全一册","xmin":2659.0,"ymin":1033.0,"xmax":2710.0,"ymax":1377.0},{"id":5,"contenttext":"紙數五八二頁","xmin":2652.0,"ymin":1400.0,"xmax":2712.0,"ymax":1636.0},{"id":6,"contenttext":"定價金貳圓","xmin":2649.0,"ymin":1662.0,"xmax":2705.0,"ymax":1858.0},{"id":7,"contenttext":"覽天賜","xmin":2180.0,"ymin":672.0,"xmax":2661.0,"ymax":878.0},{"id":8,"contenttext":"本書は畏くも","xmin":2583.0,"ymin":1018.0,"xmax":2653.0,"ymax":1376.0},{"id":9,"contenttext":"天","xmin":2479.0,"ymin":939.0,"xmax":2547.0,"ymax":1001.0},{"id":10,"contenttext":"皇","xmin":2479.0,"ymin":1037.0,"xmax":2542.0,"ymax":1102.0},{"id":11,"contenttext":"陛","xmin":2481.0,"ymin":1133.0,"xmax":2544.0,"ymax":1198.0},{"id":12,"contenttext":"下","xmin":2483.0,"ymin":1233.0,"xmax":2539.0,"ymax":1292.0},{"id":13,"contenttext":"皇","xmin":2379.0,"ymin":937.0,"xmax":2442.0,"ymax":1006.0},{"id":14,"contenttext":"后","xmin":2375.0,"ymin":1035.0,"xmax":2444.0,"ymax":1104.0},{"id":15,"contenttext":"陛","xmin":2377.0,"ymin":1133.0,"xmax":2442.0,"ymax":1198.0},{"id":16,"contenttext":"下","xmin":2377.0,"ymin":1229.0,"xmax":2438.0,"ymax":1292.0},{"id":17,"contenttext":"の叡覽を忝うし奉る","xmin":2260.0,"ymin":1018.0,"xmax":2339.0,"ymax":1552.0},{"id":18,"contenttext":"發行所","xmin":2180.0,"ymin":938.0,"xmax":2235.0,"ymax":1096.0},{"id":19,"contenttext":"東京市神田區錦町一ノ十九","xmin":2169.0,"ymin":1161.0,"xmax":2231.0,"ymax":1616.0},{"id":20,"contenttext":"覽天賜","xmin":2180.0,"ymin":672.0,"xmax":2661.0,"ymax":878.0},{"id":21,"contenttext":"天","xmin":2479.0,"ymin":939.0,"xmax":2547.0,"ymax":1001.0},{"id":22,"contenttext":"皇","xmin":2379.0,"ymin":937.0,"xmax":2442.0,"ymax":1006.0},{"id":23,"contenttext":"下","xmin":2483.0,"ymin":1233.0,"xmax":2539.0,"ymax":1292.0},{"id":24,"contenttext":"日本學術研究會","xmin":2162.0,"ymin":1703.0,"xmax":2221.0,"ymax":2083.0},{"id":25,"contenttext":"『萬朝報』(五八三一號)評","xmin":1799.0,"ymin":818.0,"xmax":1862.0,"ymax":1237.0},{"id":26,"contenttext":"平田篤胤は本居宣長の學說を承けて神道の正義を鼓吹し、","xmin":1729.0,"ymin":895.0,"xmax":1804.0,"ymax":1850.0},{"id":27,"contenttext":"我邦國民的特性の","xmin":1753.0,"ymin":1856.0,"xmax":1803.0,"ymax":2161.0},{"id":28,"contenttext":"發揮は即ち神道の體得にありとなし、","xmin":1658.0,"ymin":899.0,"xmax":1722.0,"ymax":1515.0},{"id":29,"contenttext":"盛に儒佛の二道を罵倒して自己學說の","xmin":1672.0,"ymin":1525.0,"xmax":1732.0,"ymax":2161.0},{"id":30,"contenttext":"主張に其全生涯を傾注したる熱誠の國學者なり。","xmin":1588.0,"ymin":902.0,"xmax":1652.0,"ymax":1703.0},{"id":31,"contenttext":"著者今國民〓育に資する所","xmin":1605.0,"ymin":1713.0,"xmax":1662.0,"ymax":2165.0},{"id":32,"contenttext":"あらんとして此書を著はし、","xmin":1509.0,"ymin":906.0,"xmax":1569.0,"ymax":1372.0},{"id":33,"contenttext":"四編十六章に分ちて學說を論じ、","xmin":1516.0,"ymin":1381.0,"xmax":1587.0,"ymax":1927.0},{"id":34,"contenttext":"經歷を傳へ、","xmin":1535.0,"ymin":1936.0,"xmax":1588.0,"ymax":2150.0},{"id":35,"contenttext":"一々典據出所を明にして尨然たる大册をなす。","xmin":1432.0,"ymin":916.0,"xmax":1500.0,"ymax":1671.0},{"id":36,"contenttext":"名は哲學と謂へども要するに","xmin":1451.0,"ymin":1678.0,"xmax":1511.0,"ymax":2167.0},{"id":37,"contenttext":"篤胤の研究なり。","xmin":1361.0,"ymin":906.0,"xmax":1409.0,"ymax":1189.0},{"id":38,"contenttext":"所論穩健にして而も公平、","xmin":1287.0,"ymin":904.0,"xmax":1345.0,"ymax":1339.0},{"id":39,"contenttext":"加ふるに考證甚努めたるは、","xmin":1295.0,"ymin":1349.0,"xmax":1355.0,"ymax":1820.0},{"id":40,"contenttext":"充分に著者が篤學な","xmin":1306.0,"ymin":1829.0,"xmax":1367.0,"ymax":2172.0},{"id":41,"contenttext":"る研究的態度を認むるに足る。","xmin":1212.0,"ymin":912.0,"xmax":1278.0,"ymax":1416.0},{"id":42,"contenttext":"吾人は双手を擧げて斯の如き眞面目なる研究","xmin":1225.0,"ymin":1423.0,"xmax":1296.0,"ymax":2176.0},{"id":43,"contenttext":"の世に公にせらるゝを歡迎す。","xmin":1140.0,"ymin":914.0,"xmax":1201.0,"ymax":1417.0},{"id":44,"contenttext":"『報知新聞』(一一七三四號)評","xmin":1063.0,"ymin":836.0,"xmax":1126.0,"ymax":1329.0},{"id":45,"contenttext":"讀過良く先生の先生たる處を窺ふを得べし。","xmin":990.0,"ymin":914.0,"xmax":1061.0,"ymax":1646.0},{"id":46,"contenttext":"是非一讀すべき好著也","xmin":1005.0,"ymin":1649.0,"xmax":1066.0,"ymax":2029.0},{"id":47,"contenttext":"々嘖評好","xmin":1175.0,"ymin":602.0,"xmax":1680.0,"ymax":729.0}]