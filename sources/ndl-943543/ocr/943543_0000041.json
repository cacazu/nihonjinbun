1813.0,"ymax":2119.0},{"id":46,"contenttext":"するに至つた。","xmin":1688.0,"ymin":847.0,"xmax":1735.0,"ymax":1097.0},{"id":47,"contenttext":"內容は總叙に於て經歷を揭げ、","xmin":1684.0,"ymin":1105.0,"xmax":1741.0,"ymax":1617.0},{"id":48,"contenttext":"性行を叙し、","xmin":1686.0,"ymin":1624.0,"xmax":1737.0,"ymax":1836.0},{"id":49,"contenttext":"其學風より著書","xmin":1686.0,"ymin":1852.0,"xmax":1735.0,"ymax":2117.0},{"id":50,"contenttext":"のことに及び、","xmin":1613.0,"ymin":849.0,"xmax":1662.0,"ymax":1093.0},{"id":51,"contenttext":"更に學統を詮索しては、","xmin":1613.0,"ymin":1107.0,"xmax":1662.0,"ymax":1502.0},{"id":52,"contenttext":"復古神道の發展、","xmin":1613.0,"ymin":1514.0,"xmax":1664.0,"ymax":1801.0},{"id":53,"contenttext":"學祖春滿、","xmin":1613.0,"ymin":1815.0,"xmax":1664.0,"ymax":1991.0},{"id":54,"contenttext":"學父眞","xmin":1610.0,"ymin":1997.0,"xmax":1664.0,"ymax":2119.0},{"id":55,"contenttext":"淵をあげ、","xmin":1539.0,"ymin":847.0,"xmax":1586.0,"ymax":1022.0},{"id":56,"contenttext":"本論に入りて世界論、","xmin":1537.0,"ymin":1034.0,"xmax":1584.0,"ymax":1392.0},{"id":57,"contenttext":"原理論、","xmin":1535.0,"ymin":1403.0,"xmax":1589.0,"ymax":1544.0},{"id":58,"contenttext":"政治論、","xmin":1539.0,"ymin":1555.0,"xmax":1588.0,"ymax":1690.0},{"id":59,"contenttext":"宗〓論、","xmin":1539.0,"ymin":1702.0,"xmax":1588.0,"ymax":1836.0},{"id":60,"contenttext":"學問論、","xmin":1539.0,"ymin":1852.0,"xmax":1588.0,"ymax":1987.0},{"id":61,"contenttext":"異端論","xmin":1539.0,"ymin":1997.0,"xmax":1588.0,"ymax":2117.0},{"id":62,"contenttext":"等を詳にし、","xmin":1463.0,"ymin":849.0,"xmax":1510.0,"ymax":1059.0},{"id":63,"contenttext":"其學派を論じては、","xmin":1463.0,"ymin":1073.0,"xmax":1510.0,"ymax":1394.0},{"id":64,"contenttext":"本居春庭、","xmin":1463.0,"ymin":1407.0,"xmax":1514.0,"ymax":1584.0},{"id":65,"contenttext":"本居大平、服部中庸、齋藤彥麿、","xmin":1463.0,"ymin":1592.0,"xmax":1514.0,"ymax":2095.0},{"id":66,"contenttext":"門派の巨擘、","xmin":1392.0,"ymin":847.0,"xmax":1447.0,"ymax":1061.0},{"id":67,"contenttext":"歿後の門人等に言及し、","xmin":1394.0,"ymin":1073.0,"xmax":1445.0,"ymax":1468.0},{"id":68,"contenttext":"尙ほ統括には宣長學の反動、","xmin":1396.0,"ymin":1481.0,"xmax":1445.0,"ymax":1948.0},{"id":69,"contenttext":"諸家との","xmin":1396.0,"ymin":1960.0,"xmax":1443.0,"ymax":2113.0},{"id":70,"contenttext":"比較、","xmin":1333.0,"ymin":853.0,"xmax":1382.0,"ymax":952.0},{"id":71,"contenttext":"批評等を紹介す。","xmin":1330.0,"ymin":964.0,"xmax":1384.0,"ymax":1252.0},{"id":72,"contenttext":"引證該博、","xmin":1333.0,"ymin":1259.0,"xmax":1384.0,"ymax":1435.0},{"id":73,"contenttext":"細叙精記、","xmin":1333.0,"ymin":1444.0,"xmax":1384.0,"ymax":1617.0},{"id":74,"contenttext":"讀む者をして肯ぜしめずんば","xmin":1335.0,"ymin":1629.0,"xmax":1382.0,"ymax":2115.0},{"id":75,"contenttext":"竭まざらんとす。","xmin":1262.0,"ymin":847.0,"xmax":1313.0,"ymax":1135.0},{"id":76,"contenttext":"『大阪每日新聞』(一〇三一〇號)評","xmin":1202.0,"ymin":773.0,"xmax":1254.0,"ymax":1343.0},{"id":77,"contenttext":"公平なる哲學的見地より古事記傳其他の著書に著はれたる本居宣長が世界人","xmin":1138.0,"ymin":849.0,"xmax":1187.0,"ymax":2117.0},{"id":78,"contenttext":"世に關する一代の學說を批評紹介するが本書の目的にして所謂復古神道なる","xmin":1071.0,"ymin":851.0,"xmax":1129.0,"ymax":2117.0},{"id":79,"contenttext":"ものゝ內容を闡明するに委曲を盡せる著者の努力は我が學界の爲に大に多と","xmin":1005.0,"ymin":853.0,"xmax":1063.0,"ymax":2117.0},{"id":80,"contenttext":"せざるを得ず。","xmin":942.0,"ymin":853.0,"xmax":991.0,"ymax":1100.0},{"id":81,"contenttext":"々噴評好","xmin":1222.0,"ymin":545.0,"xmax":1690.0,"ymax":668.0}]