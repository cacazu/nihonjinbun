[{"id":1,"contenttext":"兒が斜子の黑紋附を棄てヽメリンスの華やかなるを取るのは止むを得ぬ","xmin":3083.0,"ymin":638.0,"xmax":3157.0,"ymax":2112.0},{"id":2,"contenttext":"止むを得ぬけれども堂々たる有髯の男子。","xmin":3009.0,"ymin":640.0,"xmax":3072.0,"ymax":1474.0},{"id":3,"contenttext":"堂々たる大丈夫が少なくとも","xmin":3022.0,"ymin":1538.0,"xmax":3082.0,"ymax":2114.0},{"id":4,"contenttext":"事理を解し得る所の人々が、斜子の黑紋附が其處にあるに、それを棄てヽメ","xmin":2939.0,"ymin":640.0,"xmax":3006.0,"ymax":2110.0},{"id":5,"contenttext":"リンスの着物を喜んで着ると云ふのは實に憐れな話ではありませぬか。","xmin":2864.0,"ymin":650.0,"xmax":2936.0,"ymax":2089.0},{"id":6,"contenttext":"先に述べました村田春海等は此の一流であると思ふ。","xmin":2795.0,"ymin":640.0,"xmax":2856.0,"ymax":1709.0},{"id":7,"contenttext":"西洋文明の潮流は","xmin":2808.0,"ymin":1780.0,"xmax":2864.0,"ymax":2116.0},{"id":8,"contenttext":"社會主義とか、本能主義とか、自然主義とか、誤れる基督〓などを益々輸入し","xmin":2719.0,"ymin":640.0,"xmax":2789.0,"ymax":2118.0},{"id":9,"contenttext":"來つて春海等よりは一層惡人物を愈々多く作ると思ふ。","xmin":2645.0,"ymin":640.0,"xmax":2709.0,"ymax":1756.0},{"id":10,"contenttext":"勿論憲法第二十","xmin":2663.0,"ymin":1827.0,"xmax":2716.0,"ymax":2117.0},{"id":11,"contenttext":"八條は條件附でありますから、極端になれば、制裁は加へられませうが、何れ","xmin":2565.0,"ymin":642.0,"xmax":2640.0,"ymax":2116.0},{"id":12,"contenttext":"にしても實に〓嘆に堪えない次第であります。","xmin":2495.0,"ymin":644.0,"xmax":2557.0,"ymax":1572.0},{"id":13,"contenttext":"だんだんと述べ來まして、ほゞ神道なるものを大體明かにしたと思ひま","xmin":2420.0,"ymin":690.0,"xmax":2493.0,"ymax":2118.0},{"id":14,"contenttext":"す。","xmin":2350.0,"ymin":646.0,"xmax":2399.0,"ymax":691.0},{"id":15,"contenttext":"今眼を放つて社界の狀態を見ますと、學術は時々刻々に發達し、文明は","xmin":2347.0,"ymin":736.0,"xmax":2420.0,"ymax":2114.0},{"id":16,"contenttext":"年に月に進步して、社會の思想も色々に變遷して來るのであります。","xmin":2271.0,"ymin":640.0,"xmax":2342.0,"ymax":1991.0},{"id":17,"contenttext":"此の","xmin":2292.0,"ymin":2064.0,"xmax":2346.0,"ymax":2119.0},{"id":18,"contenttext":"時に當つて世の輕跳俘薄の輩は、此の如く徒らに西洋の文明に心醉し、意氣","xmin":2199.0,"ymin":644.0,"xmax":2271.0,"ymax":2122.0},{"id":19,"contenttext":"揚々として得意の色をあらはし、顧みて神道を嘲り、神道は古陋なものであ","xmin":1830.0,"ymin":634.0,"xmax":1894.0,"ymax":2109.0},{"id":20,"contenttext":"る.","xmin":1774.0,"ymin":640.0,"xmax":1809.0,"ymax":681.0},{"id":21,"contenttext":"神道は卑屈なものである。","xmin":1764.0,"ymin":728.0,"xmax":1813.0,"ymax":1236.0},{"id":22,"contenttext":"神道は陳腐なものである。","xmin":1759.0,"ymin":1294.0,"xmax":1811.0,"ymax":1797.0},{"id":23,"contenttext":"神道は淺薄な","xmin":1758.0,"ymin":1865.0,"xmax":1809.0,"ymax":2109.0},{"id":24,"contenttext":"ものであると言ひ、而してその禮典儀式を蔑視するのである。","xmin":1684.0,"ymin":636.0,"xmax":1741.0,"ymax":1840.0},{"id":25,"contenttext":"勿論神道家","xmin":1684.0,"ymin":1913.0,"xmax":1735.0,"ymax":2107.0},{"id":26,"contenttext":"电","xmin":1651.0,"ymin":1946.0,"xmax":1690.0,"ymax":1954.0},{"id":27,"contenttext":"なる者も實に多數あるのであるから、其の多數の神道家の中には、或は古陋","xmin":1608.0,"ymin":634.0,"xmax":1670.0,"ymax":2105.0},{"id":28,"contenttext":"な說を有する人もあるかも知れぬ。","xmin":1542.0,"ymin":634.0,"xmax":1598.0,"ymax":1329.0},{"id":29,"contenttext":"或は卑屈な說を唱へる者もあるかも","xmin":1537.0,"ymin":1390.0,"xmax":1592.0,"ymax":2105.0},{"id":30,"contenttext":"知れぬ。","xmin":1472.0,"ymin":631.0,"xmax":1530.0,"ymax":769.0},{"id":31,"contenttext":"或は陳腐な說を以つて金科玉條として居る者もあるかも知れぬ。","xmin":1463.0,"ymin":820.0,"xmax":1526.0,"ymax":2120.0},{"id":32,"contenttext":"或は淺薄なる頭腦を以つて社會に立つ者もないとも限らない。","xmin":1391.0,"ymin":630.0,"xmax":1453.0,"ymax":1889.0},{"id":33,"contenttext":"けれども","xmin":1396.0,"ymin":1956.0,"xmax":1443.0,"ymax":2105.0},{"id":34,"contenttext":"之れを以つて直に神道がさう云ふものであると言つたならば是れは詰り","xmin":1319.0,"ymin":628.0,"xmax":1378.0,"ymax":2103.0},{"id":35,"contenttext":"一羽の鳥の頭の白いのを見付けて、鳥の頭は白いものであると斷定を下す","xmin":1246.0,"ymin":640.0,"xmax":1310.0,"ymax":2105.0},{"id":36,"contenttext":"のと同一で、何人も其の非論理の言を笑はざるを得ないだろうと思ふ。","xmin":1172.0,"ymin":630.0,"xmax":1234.0,"ymax":2023.0},{"id":37,"contenttext":"神","xmin":1173.0,"ymin":2096.0,"xmax":1222.0,"ymax":2103.0},{"id":38,"contenttext":"道は古來神々の云爲行動に基く所の事實の道であるのである。","xmin":1099.0,"ymin":628.0,"xmax":1161.0,"ymax":1886.0},{"id":39,"contenttext":"而して古","xmin":1102.0,"ymin":1956.0,"xmax":1149.0,"ymax":2103.0},{"id":40,"contenttext":"來の神々は、最も偉大なる神聖にましませば、神道なるものも一部の論者の","xmin":1026.0,"ymin":626.0,"xmax":1086.0,"ymax":2101.0},{"id":41,"contenttext":"言ふやうに、極めて狹い所の道でなく、已に述べたやうに、天地の公道であつ","xmin":957.0,"ymin":628.0,"xmax":1013.0,"ymax":2097.0},{"id":42,"contenttext":"神","xmin":899.0,"ymin":759.0,"xmax":938.0,"ymax":784.0},{"id":44,"contenttext":"大","xmin":896.0,"ymin":871.0,"xmax":938.0,"ymax":898.0},{"id":45,"contenttext":"意","xmin":899.0,"ymin":929.0,"xmax":938.0,"ymax":949.0}]