[{"id":1,"contenttext":"『古語拾遺』に、蓋し聞く、上古の世、未だ文字あらず、貴賤老少口々に相傳へ、前","xmin":3064.0,"ymin":720.0,"xmax":3137.0,"ymax":2193.0},{"id":2,"contenttext":"言往行存して忘れずとあります通り、忘れない我が國民が、實に記億力に最","xmin":2985.0,"ymin":722.0,"xmax":3062.0,"ymax":2191.0},{"id":3,"contenttext":"も富んで居る我が國民が、忘れないで傳へて來た傳說でございます。","xmin":2916.0,"ymin":722.0,"xmax":2985.0,"ymax":2061.0},{"id":4,"contenttext":"其の","xmin":2918.0,"ymin":2126.0,"xmax":2968.0,"ymax":2189.0},{"id":5,"contenttext":"傳說は『古事記』とか『日本書紀』とかいふ本になりまして確實に傳はつて來","xmin":2840.0,"ymin":718.0,"xmax":2914.0,"ymax":2187.0},{"id":6,"contenttext":"たので、勿論斯ういふ傳說は外國ではミス(3355)又はミソロヂー(mythology)と","xmin":2770.0,"ymin":722.0,"xmax":2839.0,"ymax":2183.0},{"id":7,"contenttext":"いふ言葉で以つて示して繁簡精粗はありますが、大抵の國には之れが存在","xmin":2694.0,"ymin":722.0,"xmax":2767.0,"ymax":2187.0},{"id":8,"contenttext":"して居ります。","xmin":2636.0,"ymin":718.0,"xmax":2688.0,"ymax":995.0},{"id":9,"contenttext":"此の傳說は當時のあらゆる文化の精華を集めたものであ","xmin":2620.0,"ymin":1045.0,"xmax":2690.0,"ymax":2187.0},{"id":10,"contenttext":"ります。","xmin":2569.0,"ymin":718.0,"xmax":2614.0,"ymax":856.0},{"id":11,"contenttext":"即ち其の當時のシビリゼーシヨンの要點を悉くミスの中に包含","xmin":2544.0,"ymin":902.0,"xmax":2614.0,"ymax":2185.0},{"id":12,"contenttext":"して居つたものと云はるゝのであります。","xmin":2481.0,"ymin":713.0,"xmax":2541.0,"ymax":1550.0},{"id":13,"contenttext":"で、今日の心理學者の說に依つ","xmin":2469.0,"ymin":1605.0,"xmax":2531.0,"ymax":2183.0},{"id":14,"contenttext":"て見ますと人間の精神活動には知識·感情·意志といふものがあります。","xmin":2398.0,"ymin":715.0,"xmax":2466.0,"ymax":2105.0},{"id":15,"contenttext":"此","xmin":2397.0,"ymin":2165.0,"xmax":2446.0,"ymax":2185.0},{"id":16,"contenttext":"の三者は別々にあるのではなくて、詰り精神活動が智的·情的·意志的の三方","xmin":2319.0,"ymin":715.0,"xmax":2395.0,"ymax":2185.0},{"id":17,"contenttext":"面を有して居るのであります。","xmin":2253.0,"ymin":711.0,"xmax":2313.0,"ymax":1316.0},{"id":18,"contenttext":"從つて世の文化なるものは亦此の三大方","xmin":2242.0,"ymin":1369.0,"xmax":2309.0,"ymax":2183.0},{"id":19,"contenttext":"面に別つことが出來ます。","xmin":2181.0,"ymin":711.0,"xmax":2235.0,"ymax":1220.0},{"id":20,"contenttext":"されば傳說の中にある上古の文化を知的系統","xmin":2170.0,"ymin":1275.0,"xmax":2230.0,"ymax":2181.0},{"id":21,"contenttext":"情的系統·意志的系統、斯ういふ風の三つに別つ事が出來ます。","xmin":1822.0,"ymin":700.0,"xmax":1887.0,"ymax":1905.0},{"id":22,"contenttext":"それで知的","xmin":1827.0,"ymin":1966.0,"xmax":1874.0,"ymax":2170.0},{"id":23,"contenttext":"方面は何であるかと云へば政治的系統であります。","xmin":1751.0,"ymin":698.0,"xmax":1813.0,"ymax":1719.0},{"id":24,"contenttext":"情的方面は宗〓的系","xmin":1754.0,"ymin":1778.0,"xmax":1801.0,"ymax":2168.0},{"id":25,"contenttext":"統であります。","xmin":1690.0,"ymin":698.0,"xmax":1742.0,"ymax":976.0},{"id":26,"contenttext":"意志的方面は道德的系統でございます。","xmin":1684.0,"ymin":1029.0,"xmax":1737.0,"ymax":1813.0},{"id":27,"contenttext":"從つて當時の文","xmin":1679.0,"ymin":1870.0,"xmax":1733.0,"ymax":2171.0},{"id":28,"contenttext":"化の精華を包含して居る所の傳說には此の三大系統が皆含まれて居るの","xmin":1600.0,"ymin":696.0,"xmax":1669.0,"ymax":2167.0},{"id":29,"contenttext":"であります。","xmin":1545.0,"ymin":700.0,"xmax":1593.0,"ymax":933.0},{"id":30,"contenttext":"然るに外國では民族が始終集つたり散つたり所謂集散離合","xmin":1530.0,"ymin":978.0,"xmax":1592.0,"ymax":2171.0},{"id":31,"contenttext":"をやりまして、國家が興つたり亡びたり所謂興亡存滅を常にやつて居りま","xmin":1452.0,"ymin":696.0,"xmax":1521.0,"ymax":2167.0},{"id":32,"contenttext":"す。","xmin":1398.0,"ymin":697.0,"xmax":1443.0,"ymax":748.0},{"id":33,"contenttext":"其の他種々の事情がありましたる爲に傳說は殆んど消えて仕舞つて、","xmin":1381.0,"ymin":792.0,"xmax":1443.0,"ymax":2171.0},{"id":34,"contenttext":"後の學者が考へた政治道德·宗〓といふものが、すつかり之れに代つて今日","xmin":1302.0,"ymin":694.0,"xmax":1374.0,"ymax":2165.0},{"id":35,"contenttext":"廣く行はれる樣になつて來ました。","xmin":1239.0,"ymin":694.0,"xmax":1296.0,"ymax":1392.0},{"id":36,"contenttext":"所が我が國は外國とは其の趣が違つ","xmin":1231.0,"ymin":1444.0,"xmax":1293.0,"ymax":2165.0},{"id":37,"contenttext":"て、當時の大政治家で、大宗〓家で、大道德家でありました所の神々の子孫は、","xmin":1156.0,"ymin":698.0,"xmax":1225.0,"ymax":2171.0},{"id":38,"contenttext":"君主として長へに此の國に臨まれ、其の神々の支族或は末族のものは長へ","xmin":1080.0,"ymin":696.0,"xmax":1149.0,"ymax":2163.0},{"id":39,"contenttext":"に臣民として君主に仕へる。","xmin":1017.0,"ymin":698.0,"xmax":1073.0,"ymax":1255.0},{"id":40,"contenttext":"斯ういふ國體であります。","xmin":1015.0,"ymin":1305.0,"xmax":1065.0,"ymax":1806.0},{"id":41,"contenttext":"ですから人種が","xmin":1012.0,"ymin":1869.0,"xmax":1059.0,"ymax":2160.0},{"id":42,"contenttext":"變はりませぬ。","xmin":954.0,"ymin":699.0,"xmax":1000.0,"ymax":975.0},{"id":43,"contenttext":"國體が變りませぬ。","xmin":946.0,"ymin":1022.0,"xmax":998.0,"ymax":1390.0},{"id":44,"contenttext":"外國のやうに人種が集散離合し、國家","xmin":938.0,"ymin":1444.0,"xmax":996.0,"ymax":2165.0},{"id":47,"contenttext":"大","xmin":885.0,"ymin":935.0,"xmax":928.0,"ymax":965.0},{"id":48,"contenttext":"意","xmin":887.0,"ymin":993.0,"xmax":928.0,"ymax":1018.0}]