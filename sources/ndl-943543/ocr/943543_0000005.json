[{"id":1,"contenttext":"國家が斯く盛衰興亡して來て居るのは何う云ふ譯であるか。","xmin":3090.0,"ymin":669.0,"xmax":3152.0,"ymax":1872.0},{"id":2,"contenttext":"凡そ生きて居る物は何でも生存競爭して居るのであります。","xmin":3013.0,"ymin":716.0,"xmax":3078.0,"ymax":1912.0},{"id":3,"contenttext":"例へば其","xmin":3029.0,"ymin":1987.0,"xmax":3086.0,"ymax":2136.0},{"id":4,"contenttext":"處に蟬が一匹啼いて居るとしますと、それを雀が行つて取らうとして居る、","xmin":2938.0,"ymin":669.0,"xmax":3006.0,"ymax":2136.0},{"id":5,"contenttext":"其の蟬を取らうとして居る雀を鷹が取らうとして居る。","xmin":2863.0,"ymin":671.0,"xmax":2924.0,"ymax":1775.0},{"id":6,"contenttext":"すると又其の雀","xmin":2876.0,"ymin":1848.0,"xmax":2931.0,"ymax":2134.0},{"id":7,"contenttext":"を取らうとして居る鷹を獵師が取らうとして居る。","xmin":2786.0,"ymin":671.0,"xmax":2850.0,"ymax":1685.0},{"id":8,"contenttext":"斯う云ふ樣な工合に","xmin":2802.0,"ymin":1755.0,"xmax":2858.0,"ymax":2134.0},{"id":9,"contenttext":"此の世に生きとし生ける物は總べて生存競爭をして居る。","xmin":2713.0,"ymin":669.0,"xmax":2778.0,"ymax":1821.0},{"id":10,"contenttext":"且つ此の生存","xmin":2729.0,"ymin":1896.0,"xmax":2786.0,"ymax":2137.0},{"id":11,"contenttext":"競爭は生きとし生ける物の中に最も高等なる所の人類に於いても絕えな","xmin":2645.0,"ymin":671.0,"xmax":2713.0,"ymax":2134.0},{"id":12,"contenttext":"いのである。","xmin":2575.0,"ymin":675.0,"xmax":2622.0,"ymax":897.0},{"id":13,"contenttext":"けれども此の人類の生存競爭と云ふものは上に國家と云ふ","xmin":2576.0,"ymin":953.0,"xmax":2642.0,"ymax":2134.0},{"id":14,"contenttext":"ものがありますからして、其の生存競爭は太古の野蠻的の如く、或は下等動","xmin":2497.0,"ymin":673.0,"xmax":2565.0,"ymax":2138.0},{"id":15,"contenttext":"物の樣な野蠻的の競爭はしない。","xmin":2423.0,"ymin":671.0,"xmax":2483.0,"ymax":1315.0},{"id":16,"contenttext":"極めて高等なる競爭をして居るのであ","xmin":2432.0,"ymin":1378.0,"xmax":2490.0,"ymax":2136.0},{"id":17,"contenttext":"る.","xmin":2361.0,"ymin":677.0,"xmax":2397.0,"ymax":715.0},{"id":18,"contenttext":"併し此の國家其のものになつて來ると云ふと、上に制するものが無い","xmin":2350.0,"ymin":767.0,"xmax":2419.0,"ymax":2134.0},{"id":19,"contenttext":"ので萬國公法などと云ふものがあつても其の勢力は極めて微弱である。","xmin":2273.0,"ymin":675.0,"xmax":2342.0,"ymax":2103.0},{"id":20,"contenttext":"一度權力の平均を失したらなば其の勢力は極めて微弱である。","xmin":2198.0,"ymin":683.0,"xmax":2267.0,"ymax":1920.0},{"id":21,"contenttext":"さう云ふ","xmin":2211.0,"ymin":1997.0,"xmax":2262.0,"ymax":2134.0},{"id":22,"contenttext":"工合であるからして國家と國家との生存競爭と云ふものは極めて激烈で","xmin":1811.0,"ymin":685.0,"xmax":1875.0,"ymax":2146.0},{"id":23,"contenttext":"ある。","xmin":1739.0,"ymin":687.0,"xmax":1784.0,"ymax":777.0},{"id":24,"contenttext":"極めて慘酷である。","xmin":1737.0,"ymin":825.0,"xmax":1785.0,"ymax":1189.0},{"id":25,"contenttext":"昔から斯う云ふ風に國家と國家とは互ひに生","xmin":1737.0,"ymin":1248.0,"xmax":1800.0,"ymax":2148.0},{"id":26,"contenttext":"存競爭をして居つた。","xmin":1664.0,"ymin":685.0,"xmax":1713.0,"ymax":1097.0},{"id":27,"contenttext":"而かも極めて慘酷なる極めて劇烈なる生存競爭を","xmin":1663.0,"ymin":1157.0,"xmax":1722.0,"ymax":2146.0},{"id":28,"contenttext":"やつて來たのであります。","xmin":1592.0,"ymin":685.0,"xmax":1641.0,"ymax":1189.0},{"id":29,"contenttext":"それでありまするからして世界の各國が興亡","xmin":1592.0,"ymin":1250.0,"xmax":1647.0,"ymax":2146.0},{"id":30,"contenttext":"實に限りが無いのである。","xmin":1519.0,"ymin":685.0,"xmax":1568.0,"ymax":1187.0},{"id":31,"contenttext":"實に修羅的の競爭と云つて宜い。","xmin":1519.0,"ymin":1248.0,"xmax":1572.0,"ymax":1880.0},{"id":32,"contenttext":"斯う云ふ樣","xmin":1521.0,"ymin":1951.0,"xmax":1576.0,"ymax":2150.0},{"id":33,"contenttext":"な修羅的の劇烈なる競爭をやつて來て居る所の國家の中に介在して我が","xmin":1445.0,"ymin":685.0,"xmax":1500.0,"ymax":2146.0},{"id":34,"contenttext":"此の大日本帝國は、幾千年の間少しも土地を外國に奪はれもしない、所謂金","xmin":1369.0,"ymin":685.0,"xmax":1429.0,"ymax":2148.0},{"id":35,"contenttext":"〓無缺の帝國を維持して來たと云ふのは何う云ふ譯でありませうか。","xmin":1294.0,"ymin":685.0,"xmax":1348.0,"ymax":2070.0},{"id":36,"contenttext":"是","xmin":1298.0,"ymin":2147.0,"xmax":1349.0,"ymax":2152.0},{"id":37,"contenttext":"れが一大疑問である。","xmin":1220.0,"ymin":687.0,"xmax":1273.0,"ymax":1100.0},{"id":38,"contenttext":"私が此の疑問を解決するには是れは詰り我が國に","xmin":1217.0,"ymin":1157.0,"xmax":1278.0,"ymax":2146.0},{"id":39,"contenttext":"は古來我が國固有の大道が行はれて居るからである。","xmin":1147.0,"ymin":687.0,"xmax":1196.0,"ymax":1744.0},{"id":40,"contenttext":"此の一言を以つて","xmin":1149.0,"ymin":1818.0,"xmax":1198.0,"ymax":2146.0},{"id":41,"contenttext":"するのであります。","xmin":1074.0,"ymin":689.0,"xmax":1122.0,"ymax":1053.0},{"id":42,"contenttext":"勿論地理的關係や、その他種々の關係もありましたで","xmin":1073.0,"ymin":1110.0,"xmax":1122.0,"ymax":2146.0},{"id":43,"contenttext":"しやうけれどその歸する所は詰り世界の各國に於いて絕えて見る事の出","xmin":995.0,"ymin":687.0,"xmax":1046.0,"ymax":2148.0},{"id":44,"contenttext":"來ない所の固有の大道が行はれて居るからして、それで世界の各國に絕え","xmin":924.0,"ymin":687.0,"xmax":975.0,"ymax":2148.0},{"id":45,"contenttext":"神","xmin":877.0,"ymin":827.0,"xmax":913.0,"ymax":850.0},{"id":46,"contenttext":"道","xmin":877.0,"ymin":882.0,"xmax":913.0,"ymax":907.0},{"id":47,"contenttext":"大","xmin":877.0,"ymin":938.0,"xmax":913.0,"ymax":961.0},{"id":48,"contenttext":"意","xmin":879.0,"ymin":998.0,"xmax":913.0,"ymax":1014.0}]