[{"id":0,"contenttext":"西","xmin":3201.0,"ymin":1857.0,"xmax":3229.0,"ymax":1895.0},{"id":1,"contenttext":"『東亞之光』(五卷一號)","xmin":3115.0,"ymin":808.0,"xmax":3168.0,"ymax":1189.0},{"id":2,"contenttext":"著者の苦心-著者は篤胤の哲學を叙述せんとして、","xmin":3068.0,"ymin":886.0,"xmax":3104.0,"ymax":1547.0},{"id":3,"contenttext":"先づ其學說と親密の關係ある篤鼠の性格に注目","xmin":3070.0,"ymin":1556.0,"xmax":3106.0,"ymax":2152.0},{"id":4,"contenttext":"してゐる。","xmin":3017.0,"ymin":885.0,"xmax":3058.0,"ymax":1018.0},{"id":5,"contenttext":"而して篤胤の性格を合理的に叙述するの目的を以て著者は先づ筆を家庭の歴史より起し、","xmin":3018.0,"ymin":1025.0,"xmax":3063.0,"ymax":2136.0},{"id":6,"contenttext":"篤胤の幼時に於ける家庭教育を攻察し、","xmin":2972.0,"ymin":884.0,"xmax":3011.0,"ymax":1382.0},{"id":7,"contenttext":"彼か一家の擧げて淺見流の學風を奉ぜることを注意し、","xmin":2971.0,"ymin":1389.0,"xmax":3014.0,"ymax":2081.0},{"id":8,"contenttext":"淺見","xmin":2976.0,"ymin":2088.0,"xmax":3015.0,"ymax":2154.0},{"id":9,"contenttext":"流の〓育主義は闇齋の學を承けて、","xmin":2924.0,"ymin":886.0,"xmax":2968.0,"ymax":1327.0},{"id":10,"contenttext":"更に尊王盡忠の義を發揮せんとするものなるを說いて彼が後年の","xmin":2925.0,"ymin":1333.0,"xmax":2968.0,"ymax":2150.0},{"id":11,"contenttext":"生命たる復古神道に趨いた所以を明かならしめて居る。","xmin":2878.0,"ymin":888.0,"xmax":2916.0,"ymax":1580.0},{"id":12,"contenttext":"著者は此等の經歷境過に就て叙すると共に、","xmin":2880.0,"ymin":1589.0,"xmax":2918.0,"ymax":2138.0},{"id":13,"contenttext":"又篤胤の性行を說いて精に入つて居る。","xmin":2831.0,"ymin":886.0,"xmax":2871.0,"ymax":1386.0},{"id":14,"contenttext":"即ち篤胤の豪悍不屈獨立獨行の精神、","xmin":2833.0,"ymin":1391.0,"xmax":2874.0,"ymax":1862.0},{"id":15,"contenttext":"精力の絕倫なること、","xmin":2835.0,"ymin":1869.0,"xmax":2871.0,"ymax":2138.0},{"id":16,"contenttext":"信心の深きこと、","xmin":2784.0,"ymin":888.0,"xmax":2822.0,"ymax":1102.0},{"id":17,"contenttext":"及其交友を說き又元和偃武の際に於ける文運復興の當時勢を論じて、","xmin":2783.0,"ymin":1111.0,"xmax":2825.0,"ymax":1970.0},{"id":18,"contenttext":"其哲學及學風","xmin":2788.0,"ymin":1981.0,"xmax":2827.0,"ymax":2158.0},{"id":19,"contenttext":"の由つて起る所以の徑路を明かにして居る。","xmin":2739.0,"ymin":886.0,"xmax":2778.0,"ymax":1441.0},{"id":20,"contenttext":"平田の治聞博識-で其學問の複雜多面なることは類ひまれである。","xmin":2693.0,"ymin":888.0,"xmax":2735.0,"ymax":1745.0},{"id":21,"contenttext":"國學儒學に通じて居るは言ふま","xmin":2698.0,"ymin":1757.0,"xmax":2735.0,"ymax":2156.0},{"id":22,"contenttext":"でもなく、","xmin":2651.0,"ymin":888.0,"xmax":2685.0,"ymax":1018.0},{"id":23,"contenttext":"神道を說き、","xmin":2649.0,"ymin":1027.0,"xmax":2688.0,"ymax":1189.0},{"id":24,"contenttext":"易を論じ、","xmin":2649.0,"ymin":1197.0,"xmax":2688.0,"ymax":1328.0},{"id":25,"contenttext":"又釋迦を論じ、","xmin":2649.0,"ymin":1336.0,"xmax":2688.0,"ymax":1525.0},{"id":26,"contenttext":"佛說經文を批評し、","xmin":2649.0,"ymin":1532.0,"xmax":2690.0,"ymax":1778.0},{"id":27,"contenttext":"禪を述べ、","xmin":2651.0,"ymin":1785.0,"xmax":2690.0,"ymax":1919.0},{"id":28,"contenttext":"老子を講じ······","xmin":2655.0,"ymin":1926.0,"xmax":2690.0,"ymax":2121.0},{"id":29,"contenttext":"書甚だ多くして說く所日本支那印度に亘り、","xmin":2600.0,"ymin":890.0,"xmax":2641.0,"ymax":1441.0},{"id":30,"contenttext":"又蘭學のことに及んで居る。","xmin":2601.0,"ymin":1450.0,"xmax":2643.0,"ymax":1805.0},{"id":31,"contenttext":"著者は此の如く多方面なる","xmin":2604.0,"ymin":1812.0,"xmax":2643.0,"ymax":2154.0},{"id":32,"contenttext":"篤胤の思想學說を組織するに、","xmin":2553.0,"ymin":890.0,"xmax":2591.0,"ymax":1275.0},{"id":33,"contenttext":"世界論、","xmin":2555.0,"ymin":1282.0,"xmax":2589.0,"ymax":1384.0},{"id":34,"contenttext":"原理論、","xmin":2555.0,"ymin":1395.0,"xmax":2594.0,"ymax":1500.0},{"id":35,"contenttext":"宗教論及倫理說、","xmin":2552.0,"ymin":1507.0,"xmax":2596.0,"ymax":1723.0},{"id":36,"contenttext":"教育論の五段を以つてし、","xmin":2555.0,"ymin":1730.0,"xmax":2594.0,"ymax":2058.0},{"id":37,"contenttext":"先づ創","xmin":2557.0,"ymin":2067.0,"xmax":2596.0,"ymax":2160.0},{"id":38,"contenttext":"世說國土の發展に關する傳說より說き起して、","xmin":2506.0,"ymin":892.0,"xmax":2544.0,"ymax":1467.0},{"id":39,"contenttext":"日本眞神道の解說に移つて居る。","xmin":2508.0,"ymin":1477.0,"xmax":2547.0,"ymax":1890.0},{"id":40,"contenttext":"而して著者が就中其","xmin":2508.0,"ymin":1898.0,"xmax":2547.0,"ymax":2156.0},{"id":41,"contenttext":"宗〓論に重きを置いたのは神道神學者としての篤胤をあらはすに甚だ利ろしい點である。","xmin":2456.0,"ymin":890.0,"xmax":2502.0,"ymax":2005.0},{"id":42,"contenttext":"本書の價値-近世神道は、","xmin":2410.0,"ymin":890.0,"xmax":2448.0,"ymax":1243.0},{"id":43,"contenttext":"神道史上最も光彩ある部分である。","xmin":2410.0,"ymin":1254.0,"xmax":2451.0,"ymax":1694.0},{"id":44,"contenttext":"然るに篤胤の哲學は、","xmin":2414.0,"ymin":1701.0,"xmax":2450.0,"ymax":1972.0},{"id":45,"contenttext":"近世神道を〓","xmin":2412.0,"ymin":1983.0,"xmax":2455.0,"ymax":2161.0},{"id":46,"contenttext":"究するに就て先づ人の知らんと欲する所である。","xmin":2361.0,"ymin":892.0,"xmax":2401.0,"ymax":1498.0},{"id":47,"contenttext":"本書は篤胤の哲學を說いて、","xmin":2365.0,"ymin":1505.0,"xmax":2405.0,"ymax":1862.0},{"id":48,"contenttext":"其學風神道哲學史上に","xmin":2365.0,"ymin":1873.0,"xmax":2405.0,"ymax":2158.0},{"id":49,"contenttext":"占むべき地位、","xmin":2313.0,"ymin":892.0,"xmax":2355.0,"ymax":1082.0},{"id":50,"contenttext":"並に古道に對する篤胤の考を表はし","xmin":2316.0,"ymin":1088.0,"xmax":2353.0,"ymax":1541.0},{"id":51,"contenttext":"「何事も神代の傳へと事實とに考へて理あること","xmin":2318.0,"ymin":1548.0,"xmax":2355.0,"ymax":2156.0},{"id":52,"contenttext":"は得默せず考の及ばん限りは云はん」","xmin":2267.0,"ymin":894.0,"xmax":2310.0,"ymax":1365.0},{"id":53,"contenttext":"とする篤胤の學說と精神とを善く顯はして居る。","xmin":2270.0,"ymin":1368.0,"xmax":2310.0,"ymax":1973.0},{"id":54,"contenttext":"本書は著者が","xmin":2273.0,"ymin":1983.0,"xmax":2309.0,"ymax":2156.0},{"id":55,"contenttext":"多年の心血を注ぐの餘り成れるもので一時的に起る射利的發作の仕事でない。","xmin":2221.0,"ymin":894.0,"xmax":2264.0,"ymax":1864.0},{"id":56,"contenttext":"故に本書に著者の學殖","xmin":2224.0,"ymin":1871.0,"xmax":2265.0,"ymax":2158.0},{"id":57,"contenttext":"と共に善く其眞面目なる著者の人格をあらはして居る。","xmin":2176.0,"ymin":894.0,"xmax":2220.0,"ymax":1582.0},{"id":58,"contenttext":"學哲之胤篤田平","xmin":2286.0,"ymin":612.0,"xmax":3054.0,"ymax":749.0},{"id":59,"contenttext":"『神社協會雜誌』(八年十一號)","xmin":1880.0,"ymin":800.0,"xmax":1940.0,"ymax":1294.0},{"id":60,"contenttext":"本書は神道哲學の研鑽を以て夙に噴々の聞えある田中文學士が、","xmin":1816.0,"ymin":877.0,"xmax":1883.0,"ymax":1942.0},{"id":61,"contenttext":"一代の碩學","xmin":1827.0,"ymin":1961.0,"xmax":1880.0,"ymax":2148.0},{"id":62,"contenttext":"平田篤胤の學說について、","xmin":1751.0,"ymin":879.0,"xmax":1808.0,"ymax":1313.0},{"id":63,"contenttext":"公平なる史的烱眼と明確なる哲學的論定とによつ","xmin":1757.0,"ymin":1323.0,"xmax":1815.0,"ymax":2144.0},{"id":64,"contenttext":"て而も系統的組織的に叙述せられたるもの、","xmin":1688.0,"ymin":881.0,"xmax":1748.0,"ymax":1607.0},{"id":65,"contenttext":"解說極めて精緻、議論頗る明快、","xmin":1698.0,"ymin":1621.0,"xmax":1750.0,"ymax":2148.0},{"id":66,"contenttext":"確に卓拔なる平田翁の學說を紹介し得て餘す所なし。","xmin":1622.0,"ymin":881.0,"xmax":1685.0,"ymax":1760.0},{"id":67,"contenttext":"今や歐西哲學と相須つて國民思想研究の要ある時に此著あり。","xmin":1560.0,"ymin":880.0,"xmax":1618.0,"ymax":1907.0},{"id":68,"contenttext":"前古無比の我","xmin":1569.0,"ymin":1918.0,"xmax":1622.0,"ymax":2153.0},{"id":69,"contenttext":"が國體の精華を發揮すると共に國家の根底を固くし、","xmin":1495.0,"ymin":883.0,"xmax":1556.0,"ymax":1762.0},{"id":70,"contenttext":"大に學界を稗益するも","xmin":1505.0,"ymin":1771.0,"xmax":1557.0,"ymax":2150.0},{"id":71,"contenttext":"のあらむ。","xmin":1437.0,"ymin":886.0,"xmax":1482.0,"ymax":1055.0},{"id":72,"contenttext":"『東京日々新聞』(一一八一七號)評","xmin":1367.0,"ymin":806.0,"xmax":1423.0,"ymax":1374.0},{"id":73,"contenttext":"平田篤胤は我神道史上の偉人として德川時代の思想界に一大異彩を放てるも","xmin":1301.0,"ymin":883.0,"xmax":1367.0,"ymax":2155.0},{"id":74,"contenttext":"のなり、","xmin":1243.0,"ymin":890.0,"xmax":1286.0,"ymax":1019.0},{"id":75,"contenttext":"本書は其世界人生に關する學說を系統的組織に論述せるものにして","xmin":1238.0,"ymin":1033.0,"xmax":1302.0,"ymax":2150.0},{"id":76,"contenttext":"或意味より云へば、","xmin":1173.0,"ymin":887.0,"xmax":1227.0,"ymax":1211.0},{"id":77,"contenttext":"神道哲學と西洋哲學との比較研究とも見るを得べく、","xmin":1175.0,"ymin":1217.0,"xmax":1237.0,"ymax":2099.0},{"id":78,"contenttext":"全","xmin":1187.0,"ymin":2106.0,"xmax":1236.0,"ymax":2154.0},{"id":79,"contenttext":"卷を總叙·學說·對異·統括の四編に分つ。","xmin":1109.0,"ymin":888.0,"xmax":1168.0,"ymax":1564.0},{"id":80,"contenttext":"行文明快にして論理の整然たる事、","xmin":1116.0,"ymin":1572.0,"xmax":1172.0,"ymax":2155.0},{"id":81,"contenttext":"著者の態度の敬虔にして且公平なる事、","xmin":1043.0,"ymin":888.0,"xmax":1100.0,"ymax":1541.0},{"id":82,"contenttext":"引證該博而も著者特創の識見にも乏","xmin":1050.0,"ymin":1552.0,"xmax":1104.0,"ymax":2152.0},{"id":83,"contenttext":"しからざる事等は最も著しき點なり。","xmin":983.0,"ymin":890.0,"xmax":1032.0,"ymax":1508.0},{"id":84,"contenttext":"近來に於ける大著として之を世人に推薦するに憚からざるなり。","xmin":917.0,"ymin":888.0,"xmax":984.0,"ymax":1946.0},{"id":85,"contenttext":"三五","xmin":867.0,"ymin":1849.0,"xmax":896.0,"ymax":1893.0},{"id":86,"contenttext":"値價の書本","xmin":1129.0,"ymin":585.0,"xmax":1722.0,"ymax":712.0}]