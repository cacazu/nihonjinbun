[{"id":1,"contenttext":"が如き勢を以つて西洋の文明が這入つて來ました。","xmin":3104.0,"ymin":695.0,"xmax":3175.0,"ymax":1713.0},{"id":2,"contenttext":"で、維新の當時朝廷に","xmin":3098.0,"ymin":1774.0,"xmax":3159.0,"ymax":2159.0},{"id":3,"contenttext":"於かれてはどうかと申しますと。","xmin":3045.0,"ymin":694.0,"xmax":3098.0,"ymax":1340.0},{"id":4,"contenttext":"天皇は南殿に出御せられて五ヶ條の御","xmin":3028.0,"ymin":1396.0,"xmax":3091.0,"ymax":2159.0},{"id":5,"contenttext":"誓文を宣せられた。","xmin":2975.0,"ymin":691.0,"xmax":3028.0,"ymax":1063.0},{"id":6,"contenttext":"其の五ヶ條の御誓文中第四條には舊來の陋習を破り","xmin":2954.0,"ymin":1116.0,"xmax":3022.0,"ymax":2155.0},{"id":7,"contenttext":"天地の公道に基くべしと、斯う宣はせられて居る。","xmin":2888.0,"ymin":693.0,"xmax":2954.0,"ymax":1661.0},{"id":8,"contenttext":"第五條には知識を世界","xmin":2877.0,"ymin":1722.0,"xmax":2940.0,"ymax":2163.0},{"id":9,"contenttext":"に求め大に皇基を振起すべしと、斯う宣はせられて居る。","xmin":2809.0,"ymin":693.0,"xmax":2879.0,"ymax":1798.0},{"id":10,"contenttext":"所がどうも之れ","xmin":2805.0,"ymin":1861.0,"xmax":2857.0,"ymax":2154.0},{"id":11,"contenttext":"を誤解した。","xmin":2753.0,"ymin":692.0,"xmax":2804.0,"ymax":923.0},{"id":12,"contenttext":"第四條の舊來の陋習を破り之れは誠に結構な事である。","xmin":2729.0,"ymin":973.0,"xmax":2800.0,"ymax":2077.0},{"id":13,"contenttext":"從","xmin":2732.0,"ymin":2143.0,"xmax":2780.0,"ymax":2160.0},{"id":14,"contenttext":"來幕府の政策、鎻國的の政策の結果として國民が非常に保守的になり退嬰","xmin":2654.0,"ymin":689.0,"xmax":2731.0,"ymax":2159.0},{"id":15,"contenttext":"的になり因循姑息的になつて居る。","xmin":2594.0,"ymin":687.0,"xmax":2657.0,"ymax":1384.0},{"id":16,"contenttext":"此の陋習を破り天地の公道に基いて","xmin":2579.0,"ymin":1440.0,"xmax":2648.0,"ymax":2157.0},{"id":17,"contenttext":"行ふべきを示されて居る。","xmin":2522.0,"ymin":687.0,"xmax":2580.0,"ymax":1200.0},{"id":18,"contenttext":"斯ういふ譯である.","xmin":2514.0,"ymin":1251.0,"xmax":2572.0,"ymax":1617.0},{"id":19,"contenttext":"又、知識を世界に求める、ど","xmin":2504.0,"ymin":1673.0,"xmax":2566.0,"ymax":2155.0},{"id":20,"contenttext":"うしても今日は世界最新の知識を持つて居らなくてはならぬ。","xmin":2432.0,"ymin":687.0,"xmax":2506.0,"ymax":1935.0},{"id":21,"contenttext":"知識はど","xmin":2432.0,"ymin":2002.0,"xmax":2483.0,"ymax":2154.0},{"id":22,"contenttext":"うしても古くては駄目である。","xmin":2374.0,"ymin":691.0,"xmax":2432.0,"ymax":1290.0},{"id":23,"contenttext":"それゆゑに知識を世界に求め大に日本の","xmin":2356.0,"ymin":1346.0,"xmax":2418.0,"ymax":2153.0},{"id":24,"contenttext":"皇基を振起しなくてはならぬ。","xmin":2297.0,"ymin":687.0,"xmax":2356.0,"ymax":1291.0},{"id":25,"contenttext":"斯ういふ仰せなんです。","xmin":2289.0,"ymin":1342.0,"xmax":2345.0,"ymax":1797.0},{"id":26,"contenttext":"實に和魂漢才の","xmin":2282.0,"ymin":1859.0,"xmax":2335.0,"ymax":2151.0},{"id":27,"contenttext":"趣旨を示されて居る仰せである。","xmin":2222.0,"ymin":689.0,"xmax":2284.0,"ymax":1335.0},{"id":28,"contenttext":"それを維新以來一般世人が誤解して仕","xmin":2207.0,"ymin":1390.0,"xmax":2272.0,"ymax":2155.0},{"id":29,"contenttext":"舞つて皆上の方の舊來の陋習を破ることだけを考へて後の方は拔きにし","xmin":1853.0,"ymin":669.0,"xmax":1926.0,"ymax":2132.0},{"id":30,"contenttext":"て仕舞つた。","xmin":1797.0,"ymin":670.0,"xmax":1854.0,"ymax":904.0},{"id":31,"contenttext":"又知識を世界に求めといふ方ばかりを主として、何でもかで","xmin":1778.0,"ymin":946.0,"xmax":1847.0,"ymax":2132.0},{"id":32,"contenttext":"も西洋の文明を學んだ。","xmin":1717.0,"ymin":668.0,"xmax":1779.0,"ymax":1133.0},{"id":33,"contenttext":"即ち西洋心醉といふ狀態を呈して來たのである。","xmin":1704.0,"ymin":1180.0,"xmax":1766.0,"ymax":2134.0},{"id":34,"contenttext":"それで舊來の陋習を破るのであるから昔の風は何でもイカぬ。","xmin":1634.0,"ymin":666.0,"xmax":1704.0,"ymax":1911.0},{"id":35,"contenttext":"斯ういふ","xmin":1637.0,"ymin":1978.0,"xmax":1684.0,"ymax":2130.0},{"id":36,"contenttext":"風になつて來ましたから政治も昔の政治ではイカぬ。","xmin":1564.0,"ymin":662.0,"xmax":1631.0,"ymax":1727.0},{"id":37,"contenttext":"之れから民主政に","xmin":1561.0,"ymin":1786.0,"xmax":1613.0,"ymax":2126.0},{"id":38,"contenttext":"しなくてはならぬなどゝ飛んでもないことを言出して主權は何れにある","xmin":1492.0,"ymin":664.0,"xmax":1556.0,"ymax":2126.0},{"id":39,"contenttext":"か.","xmin":1437.0,"ymin":664.0,"xmax":1484.0,"ymax":711.0},{"id":40,"contenttext":"つまり國民にあるのであると云ふやうな事を云ひ出して來た。","xmin":1417.0,"ymin":758.0,"xmax":1481.0,"ymax":2002.0},{"id":41,"contenttext":"それ","xmin":1416.0,"ymin":2069.0,"xmax":1465.0,"ymax":2128.0},{"id":42,"contenttext":"から又人間には天賦人權と云ふものがある。","xmin":1344.0,"ymin":662.0,"xmax":1411.0,"ymax":1539.0},{"id":43,"contenttext":"外から侵すことの出來ぬ天","xmin":1338.0,"ymin":1595.0,"xmax":1399.0,"ymax":2128.0},{"id":44,"contenttext":"賦人權と云ふものがあると云ひ出した。","xmin":1271.0,"ymin":658.0,"xmax":1337.0,"ymax":1446.0},{"id":45,"contenttext":"天賦人權は宜いですけれどもそ","xmin":1268.0,"ymin":1503.0,"xmax":1321.0,"ymax":2126.0},{"id":46,"contenttext":"れを矢鱈に振廻して生半可の自由呼はりをし、何でもかでも自由ぢやなん","xmin":1192.0,"ymin":658.0,"xmax":1264.0,"ymax":2124.0},{"id":47,"contenttext":"と云つて却つて安寧秩序を害し、往々にして甚だ不自由な結果を生ずるや","xmin":1119.0,"ymin":656.0,"xmax":1193.0,"ymax":2122.0},{"id":48,"contenttext":"うなことをして居る。","xmin":1066.0,"ymin":659.0,"xmax":1114.0,"ymax":1071.0},{"id":49,"contenttext":"政治の方もさういふ工合であるが、更に宗〓の方面","xmin":1047.0,"ymin":1124.0,"xmax":1110.0,"ymax":2124.0},{"id":50,"contenttext":"を見ると基督〓は文明國民の奉ずる文明〓だから今日文明國民と交通す","xmin":971.0,"ymin":654.0,"xmax":1043.0,"ymax":2120.0},{"id":54,"contenttext":"意","xmin":932.0,"ymin":946.0,"xmax":969.0,"ymax":973.0}]