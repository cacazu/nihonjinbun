[{"id":1,"contenttext":"のみ接し、未だ曾て一回も明瞭なる答に接したことはない。」斯ういふ事を","xmin":3066.0,"ymin":643.0,"xmax":3151.0,"ymax":2118.0},{"id":2,"contenttext":"從來","xmin":3025.0,"ymin":2063.0,"xmax":3082.0,"ymax":2121.0},{"id":3,"contenttext":"ダルヴィエルラ伯が書いて居らるゝが其の通りであらうと思ひます。","xmin":2992.0,"ymin":645.0,"xmax":3071.0,"ymax":1990.0},{"id":4,"contenttext":"さういふ傾があるのであります。","xmin":2924.0,"ymin":649.0,"xmax":2986.0,"ymax":1296.0},{"id":5,"contenttext":"神道といふものに就いて一體に無智で","xmin":2933.0,"ymin":1356.0,"xmax":3006.0,"ymax":2120.0},{"id":6,"contenttext":"そこで忠孝ランプ論","xmin":2871.0,"ymin":1736.0,"xmax":2935.0,"ymax":2123.0},{"id":7,"contenttext":"ある。","xmin":2851.0,"ymin":649.0,"xmax":2895.0,"ymax":740.0},{"id":8,"contenttext":"實際自分が實行して居ながらも無智である。","xmin":2851.0,"ymin":789.0,"xmax":2921.0,"ymax":1668.0},{"id":9,"contenttext":"だの、祭祀祈禱反對論だの、間違つた考を懷くものも多く出てくるのであり","xmin":2770.0,"ymin":649.0,"xmax":2856.0,"ymax":2122.0},{"id":10,"contenttext":"ます。","xmin":2700.0,"ymin":653.0,"xmax":2743.0,"ymax":742.0},{"id":11,"contenttext":"では一體神道といふのはどういふものかと云ふ一大問題が起つて","xmin":2692.0,"ymin":793.0,"xmax":2783.0,"ymax":2123.0},{"id":12,"contenttext":"是に於いて私は神道の大意を說いて之れが解決を試","xmin":2624.0,"ymin":1078.0,"xmax":2709.0,"ymax":2129.0},{"id":13,"contenttext":"來るのであります。","xmin":2619.0,"ymin":651.0,"xmax":2677.0,"ymax":1025.0},{"id":14,"contenttext":"みて見やうと思ひます。","xmin":2550.0,"ymin":653.0,"xmax":2610.0,"ymax":1117.0},{"id":15,"contenttext":"抑も我が國が上下幾千年東海の表に國を爲して寸土も外國の爲に侵さ","xmin":2327.0,"ymin":703.0,"xmax":2409.0,"ymax":2130.0},{"id":16,"contenttext":"れず實に正確なる意味に於けるところの金甌無缺の帝國を維持し來り、國","xmin":2245.0,"ymin":657.0,"xmax":2335.0,"ymax":2133.0},{"id":17,"contenttext":"威日に揚り、月に盛に、國運年と共に益々發展して行くと云ふ所以は何處に","xmin":2173.0,"ymin":657.0,"xmax":2257.0,"ymax":2128.0},{"id":18,"contenttext":"ありますでせうか。","xmin":1831.0,"ymin":693.0,"xmax":1881.0,"ymax":1059.0},{"id":19,"contenttext":"試みに地球儀に就いて見ます。","xmin":1817.0,"ymin":1115.0,"xmax":1879.0,"ymax":1709.0},{"id":20,"contenttext":"試みに世界の地圖に","xmin":1814.0,"ymin":1771.0,"xmax":1867.0,"ymax":2152.0},{"id":21,"contenttext":"就いて見ます。","xmin":1753.0,"ymin":687.0,"xmax":1811.0,"ymax":967.0},{"id":22,"contenttext":"世界に多くの國の羅列して居る事と云ふものは實に數ふ","xmin":1736.0,"ymin":1017.0,"xmax":1802.0,"ymax":2153.0},{"id":23,"contenttext":"るに遑なき程であります。","xmin":1682.0,"ymin":689.0,"xmax":1731.0,"ymax":1193.0},{"id":24,"contenttext":"斯う云ふ世界の各國がです。","xmin":1666.0,"ymin":1251.0,"xmax":1723.0,"ymax":1797.0},{"id":25,"contenttext":"太古からして今","xmin":1665.0,"ymin":1863.0,"xmax":1715.0,"ymax":2152.0},{"id":26,"contenttext":"日に至る迄果して同じ現今の狀態を維持して來たものでありませうか。","xmin":1591.0,"ymin":687.0,"xmax":1661.0,"ymax":2118.0},{"id":27,"contenttext":"是れが維持して來たものでない事は誰れにでも解りませう。","xmin":1520.0,"ymin":683.0,"xmax":1590.0,"ymax":1887.0},{"id":28,"contenttext":"若し是れが","xmin":1521.0,"ymin":1954.0,"xmax":1574.0,"ymax":2150.0},{"id":29,"contenttext":"太古から此の儘遺つて來て居るものであると云ふものでありましたなら","xmin":1440.0,"ymin":683.0,"xmax":1515.0,"ymax":2149.0},{"id":30,"contenttext":"ば、少し其の者に反問して見れば分ります。","xmin":1378.0,"ymin":679.0,"xmax":1444.0,"ymax":1515.0},{"id":31,"contenttext":"昔、彼斯の二百萬の軍隊を引受","xmin":1370.0,"ymin":1576.0,"xmax":1432.0,"ymax":2151.0},{"id":32,"contenttext":"けて戰爭した所の雅典、スパルタの國は今日は何處に在るか。","xmin":1298.0,"ymin":677.0,"xmax":1364.0,"ymax":1885.0},{"id":33,"contenttext":"或は又世界","xmin":1293.0,"ymin":1949.0,"xmax":1352.0,"ymax":2149.0},{"id":34,"contenttext":"を征服せんとした所のアレキサンドル大王の領圖は今日何處にあるか。","xmin":1221.0,"ymin":677.0,"xmax":1288.0,"ymax":2114.0},{"id":35,"contenttext":"或は又地中海を自分の家の如くに考へて居つた所の羅馬帝國は今日何處","xmin":1145.0,"ymin":675.0,"xmax":1218.0,"ymax":2148.0},{"id":36,"contenttext":"にあるかと。","xmin":1091.0,"ymin":677.0,"xmax":1134.0,"ymax":902.0},{"id":37,"contenttext":"勿論斯う云ふ國家の占めて居つた所の土地は依然として遺","xmin":1074.0,"ymin":956.0,"xmax":1133.0,"ymax":2144.0},{"id":38,"contenttext":"つて居るけれども、其の國家其のものは既に亡びて二千年。","xmin":996.0,"ymin":675.0,"xmax":1066.0,"ymax":1834.0},{"id":39,"contenttext":"昔の夢となつ","xmin":1001.0,"ymin":1900.0,"xmax":1050.0,"ymax":2138.0},{"id":40,"contenttext":"て居るではありませぬか。","xmin":930.0,"ymin":673.0,"xmax":990.0,"ymax":1182.0},{"id":41,"contenttext":"斯くの如く國家は常に盛衰興亡して來て居る。","xmin":918.0,"ymin":1235.0,"xmax":982.0,"ymax":2142.0},{"id":42,"contenttext":"神","xmin":883.0,"ymin":832.0,"xmax":922.0,"ymax":856.0},{"id":43,"contenttext":"道","xmin":885.0,"ymin":884.0,"xmax":921.0,"ymax":912.0},{"id":44,"contenttext":"大","xmin":883.0,"ymin":944.0,"xmax":920.0,"ymax":969.0},{"id":45,"contenttext":"意","xmin":883.0,"ymin":1000.0,"xmax":920.0,"ymax":1022.0}]