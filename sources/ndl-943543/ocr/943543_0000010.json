[{"id":1,"contenttext":"是れに就いては玉木葦齋と云ふ人の說がある。","xmin":3084.0,"ymin":716.0,"xmax":3138.0,"ymax":1638.0},{"id":2,"contenttext":"是れは山崎闇齋先生の","xmin":3081.0,"ymin":1701.0,"xmax":3139.0,"ymax":2134.0},{"id":3,"contenttext":"所謂神道を說いたのでありますけれども、其の神に就いての說は極めて穩","xmin":3012.0,"ymin":669.0,"xmax":3064.0,"ymax":2134.0},{"id":4,"contenttext":"健であると思ふ。","xmin":2937.0,"ymin":671.0,"xmax":2989.0,"ymax":993.0},{"id":5,"contenttext":"是れは新井白石とか伊勢貞丈とか云ふ人々と同じ意見","xmin":2937.0,"ymin":1048.0,"xmax":2995.0,"ymax":2138.0},{"id":6,"contenttext":"である。","xmin":2867.0,"ymin":673.0,"xmax":2906.0,"ymax":807.0},{"id":7,"contenttext":"それは何う云ふ意見かと申しますると、神の訓即ち讀み方を鏡の","xmin":2863.0,"ymin":860.0,"xmax":2912.0,"ymax":2134.0},{"id":8,"contenttext":"訓かゞみのがを取つてかみとしたのであるとも云ひ、或はかんが見るをつ","xmin":2800.0,"ymin":669.0,"xmax":2847.0,"ymax":2132.0},{"id":9,"contenttext":"ゞめてかみとしたのであるとも云ひ、或はあかきみゆると云ふのがつゞま","xmin":2722.0,"ymin":675.0,"xmax":2777.0,"ymax":2136.0},{"id":10,"contenttext":"つてかみとなつたのであるとも云ひ、言語の方面から解釋を付ける人があ","xmin":2644.0,"ymin":673.0,"xmax":2701.0,"ymax":2134.0},{"id":11,"contenttext":"るけれども是れは何うも面白くない。","xmin":2571.0,"ymin":671.0,"xmax":2620.0,"ymax":1406.0},{"id":12,"contenttext":"詰り神と云ふのは神の尊くおはし","xmin":2573.0,"ymin":1470.0,"xmax":2622.0,"ymax":2134.0},{"id":13,"contenttext":"て何とも名け奉るものがないのである。","xmin":2494.0,"ymin":673.0,"xmax":2550.0,"ymax":1453.0},{"id":14,"contenttext":"たゞ戴き尙めて上と云ふかみで","xmin":2496.0,"ymin":1518.0,"xmax":2553.0,"ymax":2134.0},{"id":15,"contenttext":"ある。","xmin":2424.0,"ymin":673.0,"xmax":2463.0,"ymax":760.0},{"id":16,"contenttext":"上が即ち神で上と神とは同一である。","xmin":2418.0,"ymin":810.0,"xmax":2471.0,"ymax":1545.0},{"id":17,"contenttext":"斯う云ふ風な見解である。","xmin":2420.0,"ymin":1607.0,"xmax":2471.0,"ymax":2099.0},{"id":18,"contenttext":"何うも此の神と云ふ言葉が上と云ふ言葉から來たと云ふのが多くの學者","xmin":2354.0,"ymin":673.0,"xmax":2399.0,"ymax":2134.0},{"id":19,"contenttext":"の唱ふる所である。","xmin":2277.0,"ymin":671.0,"xmax":2325.0,"ymax":1038.0},{"id":20,"contenttext":"併し純粹に上と云ふばかりでなくして、それともう一","xmin":2277.0,"ymin":1091.0,"xmax":2328.0,"ymax":2121.0},{"id":21,"contenttext":"つ尋常でない一種靈妙であると云ふ考へが其の中に入つて居るのである。","xmin":2199.0,"ymin":675.0,"xmax":2258.0,"ymax":2138.0},{"id":22,"contenttext":"是れに就いては本居宣長翁の言葉に、凡べて神とは古への御文等に見えた","xmin":1827.0,"ymin":689.0,"xmax":1903.0,"ymax":2153.0},{"id":23,"contenttext":"る大地の諸々の神達を始めて、それを祠れる社にまします御靈をも申し、又","xmin":1756.0,"ymin":689.0,"xmax":1830.0,"ymax":2151.0},{"id":24,"contenttext":"人は更にも云はず、鳥でも獸でも草でも木でも海でも山でも何でもかでも","xmin":1682.0,"ymin":685.0,"xmax":1759.0,"ymax":2149.0},{"id":25,"contenttext":"尋常でない優れた德のある所のものは皆神である。","xmin":1615.0,"ymin":685.0,"xmax":1686.0,"ymax":1697.0},{"id":26,"contenttext":"本居宣長翁は斯う云","xmin":1608.0,"ymin":1764.0,"xmax":1668.0,"ymax":2151.0},{"id":27,"contenttext":"つて居る.","xmin":1557.0,"ymin":687.0,"xmax":1606.0,"ymax":865.0},{"id":28,"contenttext":"それから又平田篤胤翁は、神はかびと同じ事である、かびのかは","xmin":1534.0,"ymin":918.0,"xmax":1607.0,"ymax":2147.0},{"id":29,"contenttext":"彼の意にて物をそれと指て云ふことで、びは靈妙なるものを云ふ語である。","xmin":1458.0,"ymin":681.0,"xmax":1538.0,"ymax":2147.0},{"id":30,"contenttext":"即ち神は尊くして侵すべからさる一種靈妙なるものである。","xmin":1389.0,"ymin":681.0,"xmax":1465.0,"ymax":1879.0},{"id":31,"contenttext":"是れが平田","xmin":1388.0,"ymin":1948.0,"xmax":1439.0,"ymax":2146.0},{"id":32,"contenttext":"翁の說である。","xmin":1339.0,"ymin":679.0,"xmax":1388.0,"ymax":954.0},{"id":33,"contenttext":"其の門人の鈴木重胤翁此の人も同じやうな說を唱へて居","xmin":1307.0,"ymin":1007.0,"xmax":1387.0,"ymax":2145.0},{"id":34,"contenttext":"る.","xmin":1271.0,"ymin":681.0,"xmax":1310.0,"ymax":721.0},{"id":35,"contenttext":"斯う云ふ樣な說は凡べて神道學者の間に信ぜられて居るのでござい","xmin":1236.0,"ymin":770.0,"xmax":1317.0,"ymax":2141.0},{"id":36,"contenttext":"ます。","xmin":1192.0,"ymin":675.0,"xmax":1235.0,"ymax":766.0},{"id":37,"contenttext":"兎に角神と云ふものは、吾々が唯之れを〓括して云へば、神と云ふの","xmin":1159.0,"ymin":815.0,"xmax":1240.0,"ymax":2141.0},{"id":38,"contenttext":"は上と云ふかみの觀念と、靈妙と云ふ觀念と、それからして優れて居るシュビ","xmin":1088.0,"ymin":673.0,"xmax":1166.0,"ymax":2134.0},{"id":39,"contenttext":"ーリオルと云ふ觀念、照臨と云ふ觀念、斯う云ふ特性、斯う云ふアツトリゼユ","xmin":1013.0,"ymin":675.0,"xmax":1095.0,"ymax":2130.0},{"id":40,"contenttext":"ートを持つて居る所のものが神であると、かう私ほ信ずるのである。","xmin":938.0,"ymin":674.0,"xmax":1019.0,"ymax":2008.0}]