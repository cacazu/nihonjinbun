[{"id":1,"contenttext":"いた事、或は又ナポレオンが一法律學者の息子を以つて佛蘭西全國の帝王","xmin":3074.0,"ymin":685.0,"xmax":3133.0,"ymax":2142.0},{"id":2,"contenttext":"となつた事、斯う云ふ樣な事は日本には無いのである。","xmin":3006.0,"ymin":678.0,"xmax":3055.0,"ymax":1737.0},{"id":3,"contenttext":"殊にです、最も甚だ","xmin":3006.0,"ymin":1803.0,"xmax":3053.0,"ymax":2135.0},{"id":4,"contenttext":"しいのは西紀一千七百九十二年に於ける佛蘭西の國會の態度であるので","xmin":2933.0,"ymin":676.0,"xmax":2984.0,"ymax":2138.0},{"id":5,"contenttext":"す.","xmin":2865.0,"ymin":676.0,"xmax":2912.0,"ymax":726.0},{"id":6,"contenttext":"此の西紀一千七百九十二年の佛蘭西國會に於いては何うでありまし","xmin":2861.0,"ymin":768.0,"xmax":2916.0,"ymax":2138.0},{"id":7,"contenttext":"たか。","xmin":2790.0,"ymin":678.0,"xmax":2837.0,"ymax":770.0},{"id":8,"contenttext":"國王を數ヶ月間も牢獄の中へ入れて置いて、さうして遂に之れを國","xmin":2786.0,"ymin":816.0,"xmax":2839.0,"ymax":2140.0},{"id":9,"contenttext":"會の前に引出して來て是より此の國王が有罪であるか無罪であるかを決","xmin":2712.0,"ymin":676.0,"xmax":2764.0,"ymax":2138.0},{"id":10,"contenttext":"し、有罪であるとしたならば其の所罸を國民に諮るべきや否やを決し、而し","xmin":2637.0,"ymin":676.0,"xmax":2692.0,"ymax":2138.0},{"id":11,"contenttext":"て其の所罸法は如何なる刑罸を之れに加ふべきかを議會に於いて諮つた","xmin":2563.0,"ymin":678.0,"xmax":2619.0,"ymax":2140.0},{"id":12,"contenttext":"のであります。","xmin":2489.0,"ymin":678.0,"xmax":2539.0,"ymax":955.0},{"id":13,"contenttext":"所が其の議會に於いては······佛蘭西の國會に於いては、國王","xmin":2487.0,"ymin":1005.0,"xmax":2541.0,"ymax":2138.0},{"id":14,"contenttext":"は有罪であると決定したのであります。","xmin":2416.0,"ymin":678.0,"xmax":2463.0,"ymax":1460.0},{"id":15,"contenttext":"國民に諮るの必要は無いと決定","xmin":2414.0,"ymin":1520.0,"xmax":2463.0,"ymax":2138.0},{"id":16,"contenttext":"したのであります。","xmin":2344.0,"ymin":676.0,"xmax":2389.0,"ymax":1046.0},{"id":17,"contenttext":"國王を死刑に處すべしと決定したのでありまず。","xmin":2340.0,"ymin":1098.0,"xmax":2391.0,"ymax":2064.0},{"id":18,"contenttext":"其","xmin":2342.0,"ymin":2131.0,"xmax":2389.0,"ymax":2140.0},{"id":19,"contenttext":"の國王を死刑に處すると云ふ投票、其の投票は實に佛蘭西國民の勤王心の","xmin":2263.0,"ymin":678.0,"xmax":2318.0,"ymax":2136.0},{"id":20,"contenttext":"何の位の程度にあるかと云ふ事を試驗する所の投票である。","xmin":2189.0,"ymin":678.0,"xmax":2243.0,"ymax":1874.0},{"id":21,"contenttext":"盤根錯節に","xmin":2191.0,"ymin":1943.0,"xmax":2240.0,"ymax":2138.0},{"id":22,"contenttext":"は遇ずんば何を以つて利器を別たんと云ふ事がありますが、其の點から云","xmin":1828.0,"ymin":672.0,"xmax":1885.0,"ymax":2135.0},{"id":23,"contenttext":"ふと此の投票は實に勤王心を試驗する所の大いなる機會であつたのであ","xmin":1755.0,"ymin":674.0,"xmax":1811.0,"ymax":2134.0},{"id":24,"contenttext":"ります。","xmin":1694.0,"ymin":674.0,"xmax":1737.0,"ymax":807.0},{"id":25,"contenttext":"此の投票の結果總數七百二十一票の中で二十六票の多數を以つ","xmin":1681.0,"ymin":860.0,"xmax":1740.0,"ymax":2134.0},{"id":26,"contenttext":"て國王を死刑にしろと云ふ事に決定したのであります。","xmin":1610.0,"ymin":674.0,"xmax":1662.0,"ymax":1778.0},{"id":27,"contenttext":"我が國民であつ","xmin":1610.0,"ymin":1845.0,"xmax":1664.0,"ymax":2132.0},{"id":28,"contenttext":"たならば斯くの如き事は夢想する事も出來ないのであります。","xmin":1533.0,"ymin":674.0,"xmax":1588.0,"ymax":1918.0},{"id":29,"contenttext":"此の點が","xmin":1539.0,"ymin":1986.0,"xmax":1588.0,"ymax":2136.0},{"id":30,"contenttext":"即ち根本の違つて居る所以であります。","xmin":1463.0,"ymin":672.0,"xmax":1517.0,"ymax":1452.0},{"id":31,"contenttext":"勿論此の多數の內には暴徒から","xmin":1462.0,"ymin":1517.0,"xmax":1518.0,"ymax":2134.0},{"id":32,"contenttext":"迫害を受けて國王を死刑に處すべしと投票しなければ殺すぞと强迫せら","xmin":1389.0,"ymin":672.0,"xmax":1445.0,"ymax":2134.0},{"id":33,"contenttext":"れた者もありませう。","xmin":1326.0,"ymin":674.0,"xmax":1371.0,"ymax":1085.0},{"id":34,"contenttext":"殺すと云はれたつて構はないではありませぬか。","xmin":1320.0,"ymin":1142.0,"xmax":1372.0,"ymax":2101.0},{"id":35,"contenttext":"和氣の〓麿公は何うでありましたか。","xmin":1247.0,"ymin":672.0,"xmax":1298.0,"ymax":1410.0},{"id":36,"contenttext":"惡僧道鏡の爲に既に殺されやうと","xmin":1245.0,"ymin":1469.0,"xmax":1294.0,"ymax":2130.0},{"id":37,"contenttext":"したではありませぬか。","xmin":1175.0,"ymin":672.0,"xmax":1222.0,"ymax":1130.0},{"id":38,"contenttext":"殺されたつて構はない。","xmin":1172.0,"ymin":1188.0,"xmax":1223.0,"ymax":1638.0},{"id":39,"contenttext":"我が君國の爲には一身","xmin":1167.0,"ymin":1703.0,"xmax":1221.0,"ymax":2138.0},{"id":40,"contenttext":"を犠牲にすると云ふのが日本國民の特徵である。","xmin":1100.0,"ymin":672.0,"xmax":1153.0,"ymax":1641.0},{"id":41,"contenttext":"佛蘭西國民はさうでは","xmin":1100.0,"ymin":1703.0,"xmax":1149.0,"ymax":2134.0},{"id":42,"contenttext":"ない。","xmin":1030.0,"ymin":672.0,"xmax":1075.0,"ymax":762.0},{"id":43,"contenttext":"君國よりも一身の方が大事なのである。","xmin":1026.0,"ymin":814.0,"xmax":1079.0,"ymax":1591.0},{"id":44,"contenttext":"君國の存亡よりも自分が","xmin":1024.0,"ymin":1657.0,"xmax":1074.0,"ymax":2132.0},{"id":45,"contenttext":"殺される方が恐いのである。","xmin":952.0,"ymin":672.0,"xmax":1003.0,"ymax":1226.0},{"id":46,"contenttext":"そこで斯樣な亂暴も敢へてするのである。","xmin":950.0,"ymin":1283.0,"xmax":999.0,"ymax":2105.0},{"id":48,"contenttext":"道","xmin":894.0,"ymin":879.0,"xmax":934.0,"ymax":905.0},{"id":49,"contenttext":"大","xmin":893.0,"ymin":937.0,"xmax":934.0,"ymax":963.0},{"id":50,"contenttext":"意","xmin":894.0,"ymin":995.0,"xmax":931.0,"ymax":1016.0}]