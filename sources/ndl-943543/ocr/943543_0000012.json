[{"id":1,"contenttext":"は和氣の〓麿公が忠誠を盡した如く吾々も君國に對して忠誠を盡したい","xmin":3058.0,"ymin":665.0,"xmax":3117.0,"ymax":2120.0},{"id":2,"contenttext":"と思ふ。","xmin":2988.0,"ymin":667.0,"xmax":3035.0,"ymax":797.0},{"id":3,"contenttext":"又天滿宮に詣つては菅原道眞公の如く君國に盡したいと思ひ、湊","xmin":2989.0,"ymin":852.0,"xmax":3048.0,"ymax":2125.0},{"id":4,"contenttext":"川神社に詣つては正成公の如く忠勤を勵みたいと思ふ。","xmin":2911.0,"ymin":662.0,"xmax":2976.0,"ymax":1770.0},{"id":5,"contenttext":"或は又東照宮に","xmin":2925.0,"ymin":1842.0,"xmax":2976.0,"ymax":2123.0},{"id":6,"contenttext":"詣つては徳川家康公の「人の一生は重き荷を負ふて遠き道を行くが如し」と","xmin":2838.0,"ymin":665.0,"xmax":2903.0,"ymax":2122.0},{"id":7,"contenttext":"〓を垂れられた事を思ひ起して其の人を追慕する。","xmin":2763.0,"ymin":665.0,"xmax":2827.0,"ymax":1677.0},{"id":8,"contenttext":"勿論此の遺訓は家康","xmin":2775.0,"ymin":1750.0,"xmax":2827.0,"ymax":2130.0},{"id":9,"contenttext":"公が云つたものか何うかと云ふ事は歷史家の問題であるが、少なくとも德","xmin":2689.0,"ymin":665.0,"xmax":2750.0,"ymax":2128.0},{"id":10,"contenttext":"川家康公は之れを自身に實行した所の人物であると思ふ。","xmin":2616.0,"ymin":665.0,"xmax":2677.0,"ymax":1816.0},{"id":11,"contenttext":"此の實行が即","xmin":2624.0,"ymin":1890.0,"xmax":2675.0,"ymax":2128.0},{"id":12,"contenttext":"ち吾々の摸範になるのである。","xmin":2544.0,"ymin":667.0,"xmax":2596.0,"ymax":1263.0},{"id":13,"contenttext":"是れが爲に吾々は東照宮の東照宮として","xmin":2546.0,"ymin":1324.0,"xmax":2604.0,"ymax":2126.0},{"id":14,"contenttext":"尊き所以を見るのであります。","xmin":2467.0,"ymin":667.0,"xmax":2522.0,"ymax":1263.0},{"id":15,"contenttext":"つまりかう云ふ風な事が皆神道の一部分","xmin":2473.0,"ymin":1328.0,"xmax":2522.0,"ymax":2125.0},{"id":16,"contenttext":"を爲して居るのであります。","xmin":2394.0,"ymin":667.0,"xmax":2449.0,"ymax":1219.0},{"id":17,"contenttext":"それで徳川家康公がさう云ふ樣な事をし、或","xmin":2399.0,"ymin":1278.0,"xmax":2448.0,"ymax":2128.0},{"id":18,"contenttext":"は又楠正成公か湊川に戰死するに當つて七たび生れて君國に報ずると云","xmin":2320.0,"ymin":667.0,"xmax":2380.0,"ymax":2130.0},{"id":19,"contenttext":"つた。","xmin":2250.0,"ymin":671.0,"xmax":2299.0,"ymax":757.0},{"id":20,"contenttext":"さう云ふ樣な事、或は又菅原道眞公か遺訓に國學の要とする所は和","xmin":2247.0,"ymin":811.0,"xmax":2309.0,"ymax":2128.0},{"id":21,"contenttext":"魂漢すにありと云ひ、其の他忠孝一致の造を說いて居る、","xmin":2170.0,"ymin":669.0,"xmax":2225.0,"ymax":1770.0},{"id":22,"contenttext":"此の和魂漢才の","xmin":2173.0,"ymin":1841.0,"xmax":2228.0,"ymax":2126.0},{"id":23,"contenttext":"語も後人の附會と申しますが、とに角道眞公一代の事蹟はかゝる語で能く","xmin":1822.0,"ymin":668.0,"xmax":1892.0,"ymax":2125.0},{"id":24,"contenttext":"示さるゝのであります。","xmin":1769.0,"ymin":671.0,"xmax":1819.0,"ymax":1124.0},{"id":25,"contenttext":"かゝる道眞公の說いたもの、行つた事、是れ等は皆","xmin":1751.0,"ymin":1185.0,"xmax":1815.0,"ymax":2126.0},{"id":26,"contenttext":"吾々の日常行爲の好摸範となる所のものである。","xmin":1685.0,"ymin":665.0,"xmax":1746.0,"ymax":1631.0},{"id":27,"contenttext":"そして是れが又神道の","xmin":1679.0,"ymin":1701.0,"xmax":1738.0,"ymax":2125.0},{"id":28,"contenttext":"一部分を爲すのである.","xmin":1615.0,"ymin":675.0,"xmax":1671.0,"ymax":1122.0},{"id":29,"contenttext":"或は又和氣の〓麿公が彼の勢ひ天皇を凌ぎ奉つ","xmin":1602.0,"ymin":1183.0,"xmax":1666.0,"ymax":2124.0},{"id":30,"contenttext":"た惡僧道鏡の威嚇を恐れず、宇佐八幡宮の神詫なりとて、我が國家は開闢以","xmin":1531.0,"ymin":667.0,"xmax":1595.0,"ymax":2126.0},{"id":31,"contenttext":"來君臣の分が定まつて居つて未だ臣を以つて君とした例しが無い。","xmin":1457.0,"ymin":662.0,"xmax":1524.0,"ymax":1997.0},{"id":32,"contenttext":"天つ","xmin":1461.0,"ymin":2076.0,"xmax":1512.0,"ymax":2119.0},{"id":33,"contenttext":"日嗣は必ず皇緒を立てよ。","xmin":1394.0,"ymin":664.0,"xmax":1456.0,"ymax":1167.0},{"id":34,"contenttext":"若し天位を窺窯する無道の者があつたならば","xmin":1389.0,"ymin":1226.0,"xmax":1448.0,"ymax":2124.0},{"id":35,"contenttext":"速かに之れを除いて處するに嚴罰を以つてせよと、憚る所なく道鏡の前に","xmin":1308.0,"ymin":660.0,"xmax":1378.0,"ymax":2118.0},{"id":36,"contenttext":"直言した事などは最も神道の眞隨で是れ亦其の一部分である。","xmin":1233.0,"ymin":658.0,"xmax":1300.0,"ymax":1901.0},{"id":37,"contenttext":"其の他柿","xmin":1236.0,"ymin":1980.0,"xmax":1288.0,"ymax":2121.0},{"id":38,"contenttext":"本人麿公の歌の能く示せる彼の眞心と云ふ者が神道の根抵となつて居る","xmin":1159.0,"ymin":658.0,"xmax":1231.0,"ymax":2118.0},{"id":39,"contenttext":"のであつて、是れ等は全く神道を事實の上に示した所のものである。","xmin":1088.0,"ymin":660.0,"xmax":1150.0,"ymax":1991.0},{"id":40,"contenttext":"神道","xmin":1088.0,"ymin":2068.0,"xmax":1141.0,"ymax":2123.0},{"id":41,"contenttext":"には別に經典が無い、バイブルが無いけれどもかう云ふ事實が一々存在し","xmin":1009.0,"ymin":658.0,"xmax":1080.0,"ymax":2120.0},{"id":42,"contenttext":"て居るのであります。","xmin":946.0,"ymin":660.0,"xmax":999.0,"ymax":1071.0},{"id":43,"contenttext":"かう云ふと或る人はかう云ふでありませう。","xmin":935.0,"ymin":1131.0,"xmax":992.0,"ymax":1991.0},{"id":44,"contenttext":"君の","xmin":934.0,"ymin":2066.0,"xmax":989.0,"ymax":2115.0},{"id":46,"contenttext":"道","xmin":891.0,"ymin":857.0,"xmax":927.0,"ymax":883.0},{"id":47,"contenttext":"大意","xmin":889.0,"ymin":915.0,"xmax":926.0,"ymax":989.0}]