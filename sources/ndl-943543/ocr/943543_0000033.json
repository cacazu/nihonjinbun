[{"id":1,"contenttext":"當りては大いに異つた點がありませう。","xmin":3127.0,"ymin":684.0,"xmax":3172.0,"ymax":1467.0},{"id":2,"contenttext":"けれども〓育其の物に至つては","xmin":3121.0,"ymin":1530.0,"xmax":3168.0,"ymax":2146.0},{"id":3,"contenttext":"そんな區別はないのである。","xmin":3051.0,"ymin":682.0,"xmax":3098.0,"ymax":1230.0},{"id":4,"contenttext":"〓育は人を人とし、國民を國民として施すべ","xmin":3047.0,"ymin":1291.0,"xmax":3100.0,"ymax":2142.0},{"id":5,"contenttext":"きものである。","xmin":2986.0,"ymin":686.0,"xmax":3029.0,"ymax":954.0},{"id":6,"contenttext":"決して農業〓育、商業〓育、工業〓育と云ふ樣な特別な〓育","xmin":2976.0,"ymin":1009.0,"xmax":3030.0,"ymax":2150.0},{"id":7,"contenttext":"は無い。","xmin":2910.0,"ymin":682.0,"xmax":2961.0,"ymax":820.0},{"id":8,"contenttext":"〓授に於いて區別があるけれども、〓育其の物に區別は無いので","xmin":2903.0,"ymin":870.0,"xmax":2962.0,"ymax":2148.0},{"id":9,"contenttext":"あります。","xmin":2835.0,"ymin":684.0,"xmax":2878.0,"ymax":862.0},{"id":10,"contenttext":"夫れ故に〓育勅語には苟くも我が國民である以上は農業家で","xmin":2823.0,"ymin":917.0,"xmax":2880.0,"ymax":2146.0},{"id":11,"contenttext":"も工業家でも商業家でも、或は又政治家でも、法律家でも學者でも總べて皆","xmin":2748.0,"ymin":682.0,"xmax":2807.0,"ymax":2148.0},{"id":12,"contenttext":"必ず斯の道に依つて行かなくてはならないと云ふ事を示されたのである。","xmin":2678.0,"ymin":682.0,"xmax":2735.0,"ymax":2150.0},{"id":13,"contenttext":"是れが抑〓〓育勅語の御精神であるのです。","xmin":2608.0,"ymin":680.0,"xmax":2664.0,"ymax":1515.0},{"id":14,"contenttext":"所が我が國に於いては我が國民の祖先は神である。","xmin":2530.0,"ymin":726.0,"xmax":2590.0,"ymax":1744.0},{"id":15,"contenttext":"さうして吾々は神","xmin":2532.0,"ymin":1813.0,"xmax":2582.0,"ymax":2148.0},{"id":16,"contenttext":"の遺體を有つて居るのである。","xmin":2456.0,"ymin":682.0,"xmax":2515.0,"ymax":1282.0},{"id":17,"contenttext":"獨り身體のみならず精神も神の精神の分","xmin":2457.0,"ymin":1340.0,"xmax":2510.0,"ymax":2148.0},{"id":18,"contenttext":"靈である。","xmin":2389.0,"ymin":680.0,"xmax":2438.0,"ymax":861.0},{"id":19,"contenttext":"一部分である。","xmin":2387.0,"ymin":924.0,"xmax":2436.0,"ymax":1187.0},{"id":20,"contenttext":"即ち吾々は吾が身其の儘の神である。","xmin":2382.0,"ymin":1247.0,"xmax":2436.0,"ymax":1972.0},{"id":21,"contenttext":"少なく","xmin":2385.0,"ymin":2049.0,"xmax":2432.0,"ymax":2144.0},{"id":22,"contenttext":"ともくにつ神と云ふ言葉のある以上は吾々は神と云ふ事が出來るのであ","xmin":2307.0,"ymin":682.0,"xmax":2364.0,"ymax":2146.0},{"id":23,"contenttext":"る.","xmin":2248.0,"ymin":684.0,"xmax":2287.0,"ymax":726.0},{"id":24,"contenttext":"其のくにつ神なる吾々國民·····神の遺體を有つて居る吾々國民の行ふ","xmin":2233.0,"ymin":772.0,"xmax":2293.0,"ymax":2142.0},{"id":25,"contenttext":"べき道は即ち神の道である。","xmin":1849.0,"ymin":707.0,"xmax":1903.0,"ymax":1249.0},{"id":26,"contenttext":"私は此の點から見ても矢張り〓育勅語は神","xmin":1835.0,"ymin":1309.0,"xmax":1899.0,"ymax":2163.0},{"id":27,"contenttext":"の道を示されたものであると、斯う云ふのであります。","xmin":1762.0,"ymin":700.0,"xmax":1830.0,"ymax":1758.0},{"id":28,"contenttext":"故に神の道は唯〓神","xmin":1755.0,"ymin":1826.0,"xmax":1815.0,"ymax":2165.0},{"id":29,"contenttext":"社の前で手を拍き祝詞を唱へる丈けではない、是れも其の道の一部分を示","xmin":1682.0,"ymin":696.0,"xmax":1753.0,"ymax":2161.0},{"id":30,"contenttext":"すものであると云ふのである。","xmin":1624.0,"ymin":698.0,"xmax":1680.0,"ymax":1294.0},{"id":31,"contenttext":"最も重要なる所の一部分を示すのである","xmin":1608.0,"ymin":1355.0,"xmax":1674.0,"ymax":2159.0},{"id":32,"contenttext":"と云ふのである。","xmin":1555.0,"ymin":696.0,"xmax":1610.0,"ymax":1018.0},{"id":33,"contenttext":"ではあるが全體としての神の道は我が帝國の國民たる","xmin":1539.0,"ymin":1074.0,"xmax":1604.0,"ymax":2159.0},{"id":34,"contenttext":"者の悉く行はなければならぬものである。","xmin":1478.0,"ymin":694.0,"xmax":1538.0,"ymax":1524.0},{"id":35,"contenttext":"つまり世間では神の道を以つ","xmin":1466.0,"ymin":1594.0,"xmax":1528.0,"ymax":2157.0},{"id":36,"contenttext":"てむつかしい祝詞を讀んだりなんどする一種特別の道であるかと考ふる","xmin":1392.0,"ymin":696.0,"xmax":1465.0,"ymax":2156.0},{"id":37,"contenttext":"人が御座いますが前々から申します通り一部分を以つて全體とするので","xmin":1318.0,"ymin":690.0,"xmax":1391.0,"ymax":2157.0},{"id":38,"contenttext":"大變な誤解であるのであります。","xmin":1254.0,"ymin":692.0,"xmax":1319.0,"ymax":1337.0},{"id":39,"contenttext":"で、荷田春滿·····四大人の一人たる所の荷","xmin":1245.0,"ymin":1401.0,"xmax":1309.0,"ymax":2159.0},{"id":40,"contenttext":"田春滿翁も「世の中に神の道とて道あらば、人の外なる人や學ばむ」と詠まれ","xmin":1171.0,"ymin":692.0,"xmax":1245.0,"ymax":2157.0},{"id":41,"contenttext":"たのであります。","xmin":1113.0,"ymin":692.0,"xmax":1164.0,"ymax":1012.0},{"id":42,"contenttext":"世の中に眞正なる人の道があつたならばそれは神の道","xmin":1096.0,"ymin":1068.0,"xmax":1159.0,"ymax":2155.0},{"id":43,"contenttext":"である。","xmin":1042.0,"ymin":691.0,"xmax":1087.0,"ymax":826.0},{"id":44,"contenttext":"此の神の道の外に人の行ふべき道はあるものではない。","xmin":1019.0,"ymin":876.0,"xmax":1088.0,"ymax":1982.0},{"id":45,"contenttext":"神の道","xmin":1020.0,"ymin":2055.0,"xmax":1071.0,"ymax":2156.0},{"id":46,"contenttext":"は即ち人の道で、人の道は即ち神の道。","xmin":952.0,"ymin":690.0,"xmax":1018.0,"ymax":1427.0},{"id":47,"contenttext":"即ち斯道は人の行ふべき嵩高なも","xmin":943.0,"ymin":1490.0,"xmax":1002.0,"ymax":2153.0},{"id":49,"contenttext":"道","xmin":901.0,"ymin":866.0,"xmax":942.0,"ymax":892.0},{"id":50,"contenttext":"大","xmin":901.0,"ymin":924.0,"xmax":944.0,"ymax":948.0},{"id":51,"contenttext":"意","xmin":907.0,"ymin":987.0,"xmax":938.0,"ymax":998.0}]