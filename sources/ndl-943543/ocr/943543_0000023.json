[{"id":1,"contenttext":"が興亡存滅することは曾て無いのであります。","xmin":3037.0,"ymin":682.0,"xmax":3107.0,"ymax":1609.0},{"id":2,"contenttext":"それでありますからして、","xmin":3057.0,"ymin":1675.0,"xmax":3118.0,"ymax":2153.0},{"id":3,"contenttext":"傳說、それが生きて居りまして長へに民族の上に勢力を持つて居るのであ","xmin":2967.0,"ymin":684.0,"xmax":3037.0,"ymax":2151.0},{"id":4,"contenttext":"ります。","xmin":2896.0,"ymin":686.0,"xmax":2935.0,"ymax":818.0},{"id":5,"contenttext":"で、此の民族といふものゝ固有の道徳でも政治でも宗〓でも悉く","xmin":2892.0,"ymin":873.0,"xmax":2965.0,"ymax":2151.0},{"id":6,"contenttext":"此の傳說から發達して來たのでございます。","xmin":2814.0,"ymin":684.0,"xmax":2884.0,"ymax":1564.0},{"id":7,"contenttext":"それを名付けて吾々は神道","xmin":2830.0,"ymin":1628.0,"xmax":2894.0,"ymax":2157.0},{"id":8,"contenttext":"と申すのであります。","xmin":2744.0,"ymin":688.0,"xmax":2794.0,"ymax":1102.0},{"id":9,"contenttext":"神道はかゝる性質を持つて居るものであります。","xmin":2748.0,"ymin":1157.0,"xmax":2812.0,"ymax":2120.0},{"id":10,"contenttext":"ですからして政治的思想に富んで居るものが見ますれば神道は政治であ","xmin":2668.0,"ymin":688.0,"xmax":2743.0,"ymax":2149.0},{"id":11,"contenttext":"ると解し、非常に宗〓的感情の熱烈なる人から見ますると神道は宗〓であ","xmin":2596.0,"ymin":688.0,"xmax":2671.0,"ymax":2151.0},{"id":12,"contenttext":"るとし、盛に宗〓として之れを唱道するのであります。","xmin":2521.0,"ymin":690.0,"xmax":2593.0,"ymax":1752.0},{"id":13,"contenttext":"道德的意志に偏し","xmin":2540.0,"ymin":1821.0,"xmax":2600.0,"ymax":2159.0},{"id":14,"contenttext":"た人から見ますれば神道は道德である、何處迄も倫理であるといふのであ","xmin":2450.0,"ymin":692.0,"xmax":2527.0,"ymax":2159.0},{"id":15,"contenttext":"ります。","xmin":2385.0,"ymin":693.0,"xmax":2428.0,"ymax":829.0},{"id":16,"contenttext":"斯ういふ說は皆眞理を含んで居りますが皆、偏見、斯ういふことが","xmin":2379.0,"ymin":880.0,"xmax":2451.0,"ymax":2157.0},{"id":17,"contenttext":"出來るのであります。","xmin":2300.0,"ymin":695.0,"xmax":2355.0,"ymax":1108.0},{"id":18,"contenttext":"七","xmin":2170.0,"ymin":1009.0,"xmax":2244.0,"ymax":1058.0},{"id":19,"contenttext":"で、其の理由を更に深く考へて見ますと、我が國に於きましては國史の示","xmin":1797.0,"ymin":746.0,"xmax":1872.0,"ymax":2159.0},{"id":20,"contenttext":"します通り上古には「神居帝座其の殿を與にし、君と神と一體にして、祭祀國","xmin":1725.0,"ymin":699.0,"xmax":1797.0,"ymax":2161.0},{"id":21,"contenttext":"政相分れず」と云ふ有樣でありまして、神と君と一體、祭と政と不二なのであ","xmin":1653.0,"ymin":699.0,"xmax":1725.0,"ymax":2161.0},{"id":22,"contenttext":"りました。","xmin":1586.0,"ymin":700.0,"xmax":1634.0,"ymax":881.0},{"id":23,"contenttext":"そこで親房卿が神道を神國政治の要道であると解釋されたも","xmin":1585.0,"ymin":936.0,"xmax":1653.0,"ymax":2165.0},{"id":24,"contenttext":"尤もの次第であります。","xmin":1505.0,"ymin":700.0,"xmax":1567.0,"ymax":1159.0},{"id":25,"contenttext":"或は本居翁が道は天皇の天下を治めさせ給ふ正","xmin":1514.0,"ymin":1217.0,"xmax":1579.0,"ymax":2167.0},{"id":26,"contenttext":"大公共の道なるを一己の私のものにして自ら狹く說きなしてたゞ巫覡な","xmin":1426.0,"ymin":700.0,"xmax":1504.0,"ymax":2165.0},{"id":27,"contenttext":"どの業の如く、或は怪しき業を行ひなどして、それを神道となのるのはいと","xmin":1353.0,"ymin":702.0,"xmax":1424.0,"ymax":2165.0},{"id":28,"contenttext":"も〓〓淺ましくかなしきことなりと言つて居られるのは尤もの次第であ","xmin":1278.0,"ymin":704.0,"xmax":1353.0,"ymax":2167.0},{"id":29,"contenttext":"ります。","xmin":1212.0,"ymin":708.0,"xmax":1253.0,"ymax":842.0},{"id":30,"contenttext":"即ち道は天皇が天下を治めさせ給ふ正大公共の道とは先に申し","xmin":1205.0,"ymin":892.0,"xmax":1274.0,"ymax":2169.0},{"id":31,"contenttext":"ました翁の語も歸する所同一で一己の私のものでない。","xmin":1132.0,"ymin":704.0,"xmax":1194.0,"ymax":1811.0},{"id":32,"contenttext":"天下の政道であ","xmin":1145.0,"ymin":1884.0,"xmax":1200.0,"ymax":2169.0},{"id":33,"contenttext":"るといふのが翁の說であります。","xmin":1060.0,"ymin":708.0,"xmax":1120.0,"ymax":1349.0},{"id":34,"contenttext":"翁は即ち神道を政治の道と解せられた","xmin":1065.0,"ymin":1411.0,"xmax":1129.0,"ymax":2169.0},{"id":35,"contenttext":"のであります。","xmin":990.0,"ymin":711.0,"xmax":1039.0,"ymax":980.0},{"id":36,"contenttext":"けれども之れが決して誤りでないのであります。","xmin":989.0,"ymin":1034.0,"xmax":1051.0,"ymax":1999.0},{"id":37,"contenttext":"それか","xmin":1006.0,"ymin":2072.0,"xmax":1053.0,"ymax":2168.0},{"id":38,"contenttext":"ら其の次に我が神典に傳つて居ります通りに、天照大神が寳鏡を授け給ひ","xmin":912.0,"ymin":710.0,"xmax":978.0,"ymax":2171.0},{"id":40,"contenttext":"道","xmin":854.0,"ymin":895.0,"xmax":891.0,"ymax":922.0},{"id":41,"contenttext":"大","xmin":852.0,"ymin":953.0,"xmax":892.0,"ymax":978.0},{"id":42,"contenttext":"意","xmin":850.0,"ymin":1007.0,"xmax":892.0,"ymax":1030.0}]