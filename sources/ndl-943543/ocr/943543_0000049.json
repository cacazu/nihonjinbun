[{"id":0,"contenttext":"元","xmin":3190.0,"ymin":1853.0,"xmax":3231.0,"ymax":1895.0},{"id":1,"contenttext":"田中義能先生著","xmin":3114.0,"ymin":885.0,"xmax":3183.0,"ymax":1446.0},{"id":2,"contenttext":"(目下品切)","xmin":3134.0,"ymin":1523.0,"xmax":3185.0,"ymax":1732.0},{"id":3,"contenttext":"文學士","xmin":3112.0,"ymin":689.0,"xmax":3172.0,"ymax":853.0},{"id":4,"contenttext":"全","xmin":3057.0,"ymin":1777.0,"xmax":3123.0,"ymax":1841.0},{"id":5,"contenttext":"布","xmin":3057.0,"ymin":1609.0,"xmax":3121.0,"ymax":1674.0},{"id":6,"contenttext":"製","xmin":3057.0,"ymin":1691.0,"xmax":3121.0,"ymax":1758.0},{"id":7,"contenttext":"一","xmin":3068.0,"ymin":1877.0,"xmax":3119.0,"ymax":1912.0},{"id":8,"contenttext":"錢圓冊","xmin":2967.0,"ymin":1945.0,"xmax":3126.0,"ymax":2012.0},{"id":9,"contenttext":"系統的西洋〓育史","xmin":2960.0,"ymin":739.0,"xmax":3103.0,"ymax":1525.0},{"id":10,"contenttext":"定","xmin":3012.0,"ymin":1616.0,"xmax":3070.0,"ymax":1676.0},{"id":11,"contenttext":"價","xmin":3015.0,"ymin":1695.0,"xmax":3068.0,"ymax":1758.0},{"id":12,"contenttext":"金","xmin":3015.0,"ymin":1781.0,"xmax":3072.0,"ymax":1846.0},{"id":13,"contenttext":"貳","xmin":3010.0,"ymin":1861.0,"xmax":3076.0,"ymax":1927.0},{"id":14,"contenttext":"郵稅金十二","xmin":2961.0,"ymin":1616.0,"xmax":3023.0,"ymax":1937.0},{"id":15,"contenttext":"萬朝報評","xmin":2879.0,"ymin":693.0,"xmax":2935.0,"ymax":856.0},{"id":16,"contenttext":"西洋各國に於ける、","xmin":2901.0,"ymin":875.0,"xmax":2947.0,"ymax":1117.0},{"id":17,"contenttext":"かて此一系統的西洋教育史」","xmin":2879.0,"ymin":883.0,"xmax":2919.0,"ymax":1239.0},{"id":18,"contenttext":"教育的事實及び運論を歷史的に〓究し、","xmin":2911.0,"ymin":1127.0,"xmax":2954.0,"ymax":1623.0},{"id":19,"contenttext":"也","xmin":2886.0,"ymin":1240.0,"xmax":2921.0,"ymax":1290.0},{"id":20,"contenttext":"邦文教育史としては","xmin":2884.0,"ymin":1295.0,"xmax":2921.0,"ymax":1554.0},{"id":21,"contenttext":"兩三氏の著譯なきに非ざれど、","xmin":2888.0,"ymin":1576.0,"xmax":2929.0,"ymax":1956.0},{"id":22,"contenttext":"之を系統的に記述せるもの、","xmin":2917.0,"ymin":1630.0,"xmax":2958.0,"ymax":1987.0},{"id":23,"contenttext":"或は","xmin":2896.0,"ymin":1969.0,"xmax":2929.0,"ymax":2031.0},{"id":24,"contenttext":"や","xmin":2925.0,"ymin":1998.0,"xmax":2963.0,"ymax":2031.0},{"id":25,"contenttext":"簡約に過ぎ、","xmin":2839.0,"ymin":737.0,"xmax":2882.0,"ymax":895.0},{"id":26,"contenttext":"","xmin":2787.0,"ymin":737.0,"xmax":2875.0,"ymax":1516.0},{"id":27,"contenttext":"用ひ","xmin":2822.0,"ymin":741.0,"xmax":2851.0,"ymax":801.0},{"id":28,"contenttext":"或は晦澁に失して","xmin":2850.0,"ymin":906.0,"xmax":2888.0,"ymax":1137.0},{"id":29,"contenttext":"多少の遺憾なきを得ざりき。","xmin":2857.0,"ymin":1160.0,"xmax":2890.0,"ymax":1510.0},{"id":30,"contenttext":"本書は特に意を這般の缺陷を補足するに","xmin":2856.0,"ymin":1519.0,"xmax":2900.0,"ymax":2030.0},{"id":31,"contenttext":"且つ處々丁寧なる、","xmin":2835.0,"ymin":1526.0,"xmax":2867.0,"ymax":1764.0},{"id":32,"contenttext":"註解を爽むなど、","xmin":2830.0,"ymin":1774.0,"xmax":2872.0,"ymax":1987.0},{"id":33,"contenttext":"讀","xmin":2839.0,"ymin":1998.0,"xmax":2876.0,"ymax":2036.0},{"id":34,"contenttext":"近來の好述作たるを失はざるべし。","xmin":2801.0,"ymin":1190.0,"xmax":2838.0,"ymax":1631.0},{"id":35,"contenttext":"丁曾論倫理講演集評","xmin":2746.0,"ymin":697.0,"xmax":2802.0,"ymax":1012.0},{"id":36,"contenttext":"時代の順序に依つて記載するものゝ、","xmin":2774.0,"ymin":1047.0,"xmax":2810.0,"ymax":1513.0},{"id":37,"contenttext":"年代よりも、","xmin":2782.0,"ymin":1526.0,"xmax":2810.0,"ymax":1680.0},{"id":38,"contenttext":"思想及び事實の連絡に重き","xmin":2776.0,"ymin":1689.0,"xmax":2822.0,"ymax":2034.0},{"id":39,"contenttext":"理","xmin":2741.0,"ymin":700.0,"xmax":2773.0,"ymax":734.0},{"id":40,"contenttext":"會","xmin":2743.0,"ymin":755.0,"xmax":2773.0,"ymax":789.0},{"id":41,"contenttext":"を置けり","xmin":2749.0,"ymin":1049.0,"xmax":2777.0,"ymax":1165.0},{"id":42,"contenttext":"故に之ん發展的に記でし教言學なりと云ふ事を得ん。","xmin":2737.0,"ymin":1188.0,"xmax":2798.0,"ymax":1852.0},{"id":43,"contenttext":"之れ著者の企","xmin":2751.0,"ymin":1858.0,"xmax":2793.0,"ymax":2037.0},{"id":44,"contenttext":"てたる所にして、","xmin":2718.0,"ymin":743.0,"xmax":2751.0,"ymax":954.0},{"id":45,"contenttext":"本書亦能く成功せ","xmin":2720.0,"ymin":963.0,"xmax":2757.0,"ymax":1219.0},{"id":46,"contenttext":"〓育上有用なる參考書たる勿論なり","xmin":2726.0,"ymin":1246.0,"xmax":2760.0,"ymax":1701.0},{"id":47,"contenttext":"文學士","xmin":2659.0,"ymin":698.0,"xmax":2710.0,"ymax":858.0},{"id":48,"contenttext":"田中義能","xmin":2656.0,"ymin":896.0,"xmax":2717.0,"ymax":1206.0},{"id":49,"contenttext":"先","xmin":2659.0,"ymin":1223.0,"xmax":2720.0,"ymax":1294.0},{"id":50,"contenttext":"生","xmin":2661.0,"ymin":1309.0,"xmax":2718.0,"ymax":1373.0},{"id":51,"contenttext":"著","xmin":2659.0,"ymin":1393.0,"xmax":2722.0,"ymax":1459.0},{"id":52,"contenttext":"布","xmin":2602.0,"ymin":1622.0,"xmax":2661.0,"ymax":1682.0},{"id":53,"contenttext":"製","xmin":2600.0,"ymin":1703.0,"xmax":2661.0,"ymax":1768.0},{"id":54,"contenttext":"全","xmin":2604.0,"ymin":1787.0,"xmax":2663.0,"ymax":1852.0},{"id":55,"contenttext":"一","xmin":2612.0,"ymin":1887.0,"xmax":2659.0,"ymax":1920.0},{"id":56,"contenttext":"最","xmin":2559.0,"ymin":747.0,"xmax":2622.0,"ymax":813.0},{"id":57,"contenttext":"科學的〓育學","xmin":2499.0,"ymin":814.0,"xmax":2649.0,"ymax":1536.0},{"id":58,"contenttext":"定價","xmin":2555.0,"ymin":1622.0,"xmax":2609.0,"ymax":1724.0},{"id":59,"contenttext":"金壹圓八拾錢","xmin":2553.0,"ymin":1723.0,"xmax":2613.0,"ymax":2019.0},{"id":60,"contenttext":"新","xmin":2512.0,"ymin":749.0,"xmax":2573.0,"ymax":813.0},{"id":61,"contenttext":"郵稅金十","xmin":2502.0,"ymin":1626.0,"xmax":2563.0,"ymax":1876.0},{"id":62,"contenttext":"二","xmin":2510.0,"ymin":1885.0,"xmax":2558.0,"ymax":1954.0},{"id":63,"contenttext":"錢","xmin":2506.0,"ymin":1955.0,"xmax":2567.0,"ymax":2019.0},{"id":64,"contenttext":"效","xmin":2493.0,"ymin":1565.0,"xmax":2518.0,"ymax":1590.0},{"id":65,"contenttext":"東京朝日新聞評","xmin":2419.0,"ymin":703.0,"xmax":2479.0,"ymax":974.0},{"id":66,"contenttext":"著者は曩に「系統的西洋教育史」を公にせし人なり。","xmin":2447.0,"ymin":996.0,"xmax":2493.0,"ymax":1633.0},{"id":67,"contenttext":"此の書は西洋に發達せる思想と","xmin":2456.0,"ymin":1642.0,"xmax":2498.0,"ymax":2038.0},{"id":68,"contenttext":"教育とを研究し之を骨肉として","xmin":2424.0,"ymin":1000.0,"xmax":2456.0,"ymax":1398.0},{"id":69,"contenttext":"更に東洋殊に日本固有の思想と教育とを研究し之","xmin":2425.0,"ymin":1417.0,"xmax":2468.0,"ymax":2042.0},{"id":70,"contenttext":"を精神として一大系統的教育學を組成せるものにて、","xmin":2386.0,"ymin":749.0,"xmax":2433.0,"ymax":1411.0},{"id":71,"contenttext":"體系の整然たると、","xmin":2397.0,"ymin":1421.0,"xmax":2432.0,"ymax":1662.0},{"id":72,"contenttext":"議論の穩健なるとは此の書の","xmin":2401.0,"ymin":1671.0,"xmax":2438.0,"ymax":2040.0},{"id":73,"contenttext":"特色なり。","xmin":2361.0,"ymin":749.0,"xmax":2395.0,"ymax":871.0},{"id":74,"contenttext":"哲學雜誌評","xmin":2311.0,"ymin":706.0,"xmax":2363.0,"ymax":902.0},{"id":75,"contenttext":"文學士田中義能氏は篤學の教育家にして、","xmin":2332.0,"ymin":941.0,"xmax":2381.0,"ymax":1466.0},{"id":76,"contenttext":"ある","xmin":2311.0,"ymin":947.0,"xmax":2340.0,"ymax":1006.0},{"id":77,"contenttext":"又氏は教育學は純粹に學なりとい","xmin":2309.0,"ymin":1031.0,"xmax":2348.0,"ymax":1451.0},{"id":78,"contenttext":"へ","xmin":2316.0,"ymin":1448.0,"xmax":2346.0,"ymax":1479.0},{"id":79,"contenttext":"ど、","xmin":2318.0,"ymin":1473.0,"xmax":2348.0,"ymax":1523.0},{"id":80,"contenttext":"最も穩當なる學說を持し且つ唱へて居る人で","xmin":2336.0,"ymin":1474.0,"xmax":2385.0,"ymax":2042.0},{"id":81,"contenttext":"歐洲人の教育學が歐洲國民的彩色の基に","xmin":2314.0,"ymin":1531.0,"xmax":2356.0,"ymax":2044.0},{"id":82,"contenttext":"なれる教育學である樣に","xmin":2279.0,"ymin":751.0,"xmax":2316.0,"ymax":1065.0},{"id":83,"contenttext":"本邦に於ける教育學も、","xmin":2282.0,"ymin":1086.0,"xmax":2320.0,"ymax":1383.0},{"id":84,"contenttext":"只西洋輸入でなく、","xmin":2289.0,"ymin":1395.0,"xmax":2322.0,"ymax":1633.0},{"id":85,"contenttext":"其れに國民的精神を着色するこ","xmin":2290.0,"ymin":1646.0,"xmax":2329.0,"ymax":2041.0},{"id":86,"contenttext":"とを忘れてはならぬといふ意見を持つて居る。","xmin":2247.0,"ymin":753.0,"xmax":2291.0,"ymax":1329.0},{"id":87,"contenttext":"是等の意見を本として出來上つたものが則ち本著科學的","xmin":2252.0,"ymin":1335.0,"xmax":2302.0,"ymax":2046.0},{"id":88,"contenttext":"〓育學である。","xmin":2205.0,"ymin":751.0,"xmax":2240.0,"ymax":936.0},{"id":89,"contenttext":"本書は注意の能く行屆いた、","xmin":2203.0,"ymin":947.0,"xmax":2246.0,"ymax":1301.0},{"id":90,"contenttext":"諸方面の問題に普くふれて、","xmin":2211.0,"ymin":1313.0,"xmax":2251.0,"ymax":1668.0},{"id":91,"contenttext":"所謂まめに手際に出來て居る","xmin":2215.0,"ymin":1675.0,"xmax":2253.0,"ymax":2044.0},{"id":92,"contenttext":"本である","xmin":2178.0,"ymin":754.0,"xmax":2214.0,"ymax":872.0},{"id":93,"contenttext":"行文は最も流暢","xmin":2176.0,"ymin":892.0,"xmax":2215.0,"ymax":1096.0},{"id":94,"contenttext":"思想は太だ穩健","xmin":2180.0,"ymin":1117.0,"xmax":2218.0,"ymax":1321.0},{"id":95,"contenttext":"帝先練の女字中に健全の常識が貰いて居るのは氏の特色で","xmin":2167.0,"ymin":1337.0,"xmax":2228.0,"ymax":2044.0},{"id":96,"contenttext":"ある。","xmin":2148.0,"ymin":757.0,"xmax":2181.0,"ymax":828.0},{"id":97,"contenttext":"讀者は必ずや此に由つて教育學の智識を新にし","xmin":2144.0,"ymin":837.0,"xmax":2190.0,"ymax":1429.0},{"id":98,"contenttext":"且つ豐かならしむることあるを思ふ。","xmin":2153.0,"ymin":1450.0,"xmax":2194.0,"ymax":1915.0},{"id":99,"contenttext":"兌發","xmin":2996.0,"ymin":2055.0,"xmax":3186.0,"ymax":2152.0},{"id":100,"contenttext":"田神京東","xmin":2837.0,"ymin":2084.0,"xmax":2994.0,"ymax":2132.0},{"id":101,"contenttext":"舘文同","xmin":2500.0,"ymin":2066.0,"xmax":2811.0,"ymax":2164.0},{"id":102,"contenttext":"番五三一座口替振","xmin":2170.0,"ymin":2095.0,"xmax":2476.0,"ymax":2147.0},{"id":103,"contenttext":"育〓〓","xmin":2801.0,"ymin":596.0,"xmax":3020.0,"ymax":674.0},{"id":104,"contenttext":"著新の讀必家","xmin":2358.0,"ymin":600.0,"xmax":2803.0,"ymax":680.0}]