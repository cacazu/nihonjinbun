[{"id":1,"contenttext":"無いと云ふ事を常に悲んで居つたのでございます。","xmin":3063.0,"ymin":680.0,"xmax":3123.0,"ymax":1693.0},{"id":2,"contenttext":"それに此の病身でご","xmin":3058.0,"ymin":1757.0,"xmax":3112.0,"ymax":2140.0},{"id":3,"contenttext":"ざいまして何時迄永らへて居りました所で仕方がありませぬから、何うか","xmin":2988.0,"ymin":678.0,"xmax":3050.0,"ymax":2138.0},{"id":4,"contenttext":"早速死刑にして戴きたい。","xmin":2919.0,"ymin":678.0,"xmax":2976.0,"ymax":1186.0},{"id":5,"contenttext":"さうすれば殉〓者の仲間入も出來るのであり","xmin":2911.0,"ymin":1243.0,"xmax":2968.0,"ymax":2138.0},{"id":6,"contenttext":"ますから是の位有難い事はございませぬ。","xmin":2841.0,"ymin":678.0,"xmax":2901.0,"ymax":1508.0},{"id":7,"contenttext":"是れがバヂリウスの云つた言","xmin":2840.0,"ymin":1566.0,"xmax":2893.0,"ymax":2140.0},{"id":8,"contenttext":"葉でございます。","xmin":2776.0,"ymin":676.0,"xmax":2827.0,"ymax":1000.0},{"id":9,"contenttext":"而かも此の事は西洋では立派な事だとして傳へられて","xmin":2765.0,"ymin":1051.0,"xmax":2824.0,"ymax":2140.0},{"id":10,"contenttext":"居るのでございます。","xmin":2704.0,"ymin":676.0,"xmax":2753.0,"ymax":1091.0},{"id":11,"contenttext":"何うです日本民族に於いてさう云ふ事が云へませ","xmin":2693.0,"ymin":1145.0,"xmax":2751.0,"ymax":2136.0},{"id":12,"contenttext":"うか.","xmin":2632.0,"ymin":678.0,"xmax":2677.0,"ymax":768.0},{"id":13,"contenttext":"それからして又私はもつと甚だしい例を擧げて見やうと思ふ。","xmin":2544.0,"ymin":723.0,"xmax":2606.0,"ymax":1967.0},{"id":14,"contenttext":"それは","xmin":2547.0,"ymin":2033.0,"xmax":2596.0,"ymax":2136.0},{"id":15,"contenttext":"宗〓界の大立者であり基督〓徒に於いては神樣の樣に崇敬されて居る所","xmin":2465.0,"ymin":676.0,"xmax":2532.0,"ymax":2138.0},{"id":16,"contenttext":"のルーテル、宗〓改革家のルーテルであります。","xmin":2395.0,"ymin":678.0,"xmax":2454.0,"ymax":1594.0},{"id":17,"contenttext":"彼のルーテルは宗〓改革","xmin":2392.0,"ymin":1656.0,"xmax":2443.0,"ymax":2136.0},{"id":18,"contenttext":"を始めまするより以前に羅馬へ行つた事がある。","xmin":2322.0,"ymin":674.0,"xmax":2382.0,"ymax":1644.0},{"id":19,"contenttext":"羅馬へ行つて羅馬の大","xmin":2321.0,"ymin":1704.0,"xmax":2376.0,"ymax":2140.0},{"id":20,"contenttext":"會堂に參詣した。","xmin":2254.0,"ymin":674.0,"xmax":2310.0,"ymax":995.0},{"id":21,"contenttext":"其の時に彼れは何う云つたか。","xmin":2251.0,"ymin":1049.0,"xmax":2305.0,"ymax":1638.0},{"id":22,"contenttext":"あゝ吾れは何うも不幸","xmin":2250.0,"ymin":1704.0,"xmax":2301.0,"ymax":2136.0},{"id":23,"contenttext":"である。","xmin":2189.0,"ymin":676.0,"xmax":2234.0,"ymax":811.0},{"id":24,"contenttext":"未だ己の御父さん御母さんが生きて在らつしやるが實に殘念だ。","xmin":2177.0,"ymin":858.0,"xmax":2234.0,"ymax":2136.0},{"id":25,"contenttext":"死んで居つて吳れゝば宜かつたと云つて悲しんだ。","xmin":1828.0,"ymin":659.0,"xmax":1885.0,"ymax":1675.0},{"id":26,"contenttext":"之れを聞いた人は吃","xmin":1833.0,"ymin":1738.0,"xmax":1887.0,"ymax":2132.0},{"id":27,"contenttext":"驚して一體それは何う云ふ譯かと尋ねると。","xmin":1754.0,"ymin":661.0,"xmax":1811.0,"ymax":1537.0},{"id":28,"contenttext":"ルーテルの云ふには、イヤ此","xmin":1762.0,"ymin":1604.0,"xmax":1809.0,"ymax":2130.0},{"id":29,"contenttext":"の大會堂に詣つて祈禱をすると云ふと兩親が死んで地獄に入つて居るの","xmin":1682.0,"ymin":664.0,"xmax":1737.0,"ymax":2126.0},{"id":30,"contenttext":"を救ふ事が出來るのである。","xmin":1608.0,"ymin":661.0,"xmax":1662.0,"ymax":1218.0},{"id":31,"contenttext":"今兩親が死んで居つて吳れゝば其れを救ふ","xmin":1610.0,"ymin":1268.0,"xmax":1666.0,"ymax":2128.0},{"id":32,"contenttext":"事が出來たのに殘念であると云つて悲しんだ。","xmin":1532.0,"ymin":661.0,"xmax":1587.0,"ymax":1586.0},{"id":33,"contenttext":"先づ第一に兩親が地獄に","xmin":1537.0,"ymin":1646.0,"xmax":1588.0,"ymax":2128.0},{"id":34,"contenttext":"居るものと考ふると云ふ事が大變な間違ひであると思ふ。","xmin":1461.0,"ymin":661.0,"xmax":1518.0,"ymax":1815.0},{"id":35,"contenttext":"が、是れは一步","xmin":1463.0,"ymin":1880.0,"xmax":1516.0,"ymax":2130.0},{"id":36,"contenttext":"讓るとして、父母が死んで居つて吳れゝば宜いと云ふ事を口にすると云ふ","xmin":1390.0,"ymin":661.0,"xmax":1442.0,"ymax":2126.0},{"id":37,"contenttext":"事は實に驚き入つた事であると思ふ。","xmin":1314.0,"ymin":661.0,"xmax":1369.0,"ymax":1402.0},{"id":38,"contenttext":"併し乍らルーテルは親に孝行であ","xmin":1314.0,"ymin":1459.0,"xmax":1365.0,"ymax":2127.0},{"id":39,"contenttext":"ると考へて斯う云つたのである。","xmin":1243.0,"ymin":666.0,"xmax":1291.0,"ymax":1308.0},{"id":40,"contenttext":"親に孝、君に忠、其の忠孝の言葉の中に含","xmin":1241.0,"ymin":1365.0,"xmax":1294.0,"ymax":2130.0},{"id":41,"contenttext":"んで居る內容······形式に於いて假令同じであつても······其の內容、其の根柢に","xmin":1175.0,"ymin":666.0,"xmax":1224.0,"ymax":2128.0},{"id":42,"contenttext":"於いて東西甚しく異なつて居ると云ふのは此の點であると思ふのであり","xmin":1097.0,"ymin":664.0,"xmax":1149.0,"ymax":2127.0},{"id":43,"contenttext":"ます。","xmin":1032.0,"ymin":666.0,"xmax":1074.0,"ymax":758.0},{"id":44,"contenttext":"詰り我が國に於きましては此の神道にさう云ふ風な經典とか御經","xmin":1023.0,"ymin":805.0,"xmax":1077.0,"ymax":2127.0},{"id":45,"contenttext":"とかバイブルとか云ふ物は無いのであります。","xmin":948.0,"ymin":668.0,"xmax":1003.0,"ymax":1586.0},{"id":46,"contenttext":"さう云ふ典籍は無いので","xmin":950.0,"ymin":1650.0,"xmax":1001.0,"ymax":2126.0},{"id":47,"contenttext":"神道大意","xmin":899.0,"ymin":821.0,"xmax":937.0,"ymax":1012.0}]