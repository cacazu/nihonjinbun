[{"id":1,"contenttext":"て、實に普遍的の道であるのである。","xmin":3065.0,"ymin":638.0,"xmax":3122.0,"ymax":1331.0},{"id":2,"contenttext":"勿論神道は天御中主神の御德が天照","xmin":3070.0,"ymin":1398.0,"xmax":3125.0,"ymax":2110.0},{"id":3,"contenttext":"大神と申す偉大なる御神を通して發揮せられて、茲に其の政治、宗〓、道德等","xmin":2995.0,"ymin":636.0,"xmax":3053.0,"ymax":2109.0},{"id":4,"contenttext":"各方面の實踐的大道の淵源を有する所の道である。","xmin":2922.0,"ymin":640.0,"xmax":2983.0,"ymax":1662.0},{"id":5,"contenttext":"從つて天照大神及び","xmin":2931.0,"ymin":1734.0,"xmax":2984.0,"ymax":2113.0},{"id":6,"contenttext":"その以下の神々の道としては、我が國民と特殊の關係を有つて居るけれど","xmin":2852.0,"ymin":640.0,"xmax":2911.0,"ymax":2109.0},{"id":7,"contenttext":"も、天御中主神の道として見る塲合に於いては、世界有ゆる所に行はるゝ所","xmin":2775.0,"ymin":640.0,"xmax":2837.0,"ymax":2113.0},{"id":8,"contenttext":"の道である。","xmin":2702.0,"ymin":642.0,"xmax":2755.0,"ymax":871.0},{"id":9,"contenttext":"宇宙間の森羅萬象悉く之れに包含せらるゝ所の道である。","xmin":2703.0,"ymin":925.0,"xmax":2760.0,"ymax":2079.0},{"id":10,"contenttext":"今暫らく下つて天照大神及びその以下の神々の道として見るに、神道は吾","xmin":2628.0,"ymin":640.0,"xmax":2687.0,"ymax":2110.0},{"id":11,"contenttext":"々の已に色々述べて來たやうに、我が國民固有の道である。","xmin":2558.0,"ymin":640.0,"xmax":2614.0,"ymax":1798.0},{"id":12,"contenttext":"そして其の道","xmin":2560.0,"ymin":1876.0,"xmax":2614.0,"ymax":2112.0},{"id":13,"contenttext":"は勿論種々の神々によりて示され、明治大神とましますべき、先帝陛下によ","xmin":2482.0,"ymin":640.0,"xmax":2542.0,"ymax":2109.0},{"id":14,"contenttext":"りても、軍人に賜はりたる勅諭、戊申詔書等種々の御言によりて示されある","xmin":2410.0,"ymin":640.0,"xmax":2467.0,"ymax":2107.0},{"id":15,"contenttext":"も、最もよくその要旨を示されたるは、〓育勅語であるは、已に詳述したるが","xmin":2340.0,"ymin":642.0,"xmax":2396.0,"ymax":2107.0},{"id":16,"contenttext":"如くである。","xmin":2271.0,"ymin":642.0,"xmax":2316.0,"ymax":869.0},{"id":17,"contenttext":"コー云ふ性質を有する神道は、遂には全く人類社會に普遍た","xmin":2268.0,"ymin":930.0,"xmax":2324.0,"ymax":2109.0},{"id":18,"contenttext":"るべきものであると云ふことがわかるのである。","xmin":2193.0,"ymin":642.0,"xmax":2242.0,"ymax":1608.0},{"id":19,"contenttext":"獨逸國民は獨逸皇帝は","xmin":2194.0,"ymin":1682.0,"xmax":2250.0,"ymax":2107.0},{"id":20,"contenttext":"世界に王たるべき者であると考へて居る。","xmin":1829.0,"ymin":696.0,"xmax":1888.0,"ymax":1527.0},{"id":21,"contenttext":"而して獨逸の世界統一は世界","xmin":1827.0,"ymin":1599.0,"xmax":1878.0,"ymax":2168.0},{"id":22,"contenttext":"の幸福であると彼れ等は主張して居るのである。","xmin":1749.0,"ymin":696.0,"xmax":1814.0,"ymax":1664.0},{"id":23,"contenttext":"彼れ等は斯う云ふやう","xmin":1748.0,"ymin":1740.0,"xmax":1802.0,"ymax":2163.0},{"id":24,"contenttext":"な觀念の下に、今日の戰爭をやつて居るのである。","xmin":1678.0,"ymin":696.0,"xmax":1734.0,"ymax":1664.0},{"id":25,"contenttext":"けれども我が日本は、平","xmin":1676.0,"ymin":1736.0,"xmax":1725.0,"ymax":2160.0},{"id":26,"contenttext":"田翁が言はれた通りに世界の最も勝れた國である。","xmin":1599.0,"ymin":692.0,"xmax":1663.0,"ymax":1715.0},{"id":27,"contenttext":"そして世界の王たる","xmin":1600.0,"ymin":1784.0,"xmax":1650.0,"ymax":2158.0},{"id":28,"contenttext":"べき所の國であると思ふのである。","xmin":1531.0,"ymin":698.0,"xmax":1585.0,"ymax":1384.0},{"id":29,"contenttext":"是れは決して彼れ等獨逸人のやうに","xmin":1526.0,"ymin":1450.0,"xmax":1578.0,"ymax":2158.0},{"id":30,"contenttext":"自負的に言ふのでなく、事實に於いて言ふのである。","xmin":1451.0,"ymin":690.0,"xmax":1512.0,"ymax":1707.0},{"id":31,"contenttext":"一體我が國が維新の","xmin":1453.0,"ymin":1793.0,"xmax":1504.0,"ymax":2158.0},{"id":32,"contenttext":"際には、未だ十分に外國と交通しないものであつたから、我が國情は外國人","xmin":1374.0,"ymin":690.0,"xmax":1438.0,"ymax":2158.0},{"id":33,"contenttext":"に分らない。","xmin":1310.0,"ymin":690.0,"xmax":1361.0,"ymax":920.0},{"id":34,"contenttext":"日本人と云ふものを非常に馬鹿にしたものである。","xmin":1301.0,"ymin":972.0,"xmax":1360.0,"ymax":1985.0},{"id":35,"contenttext":"當時橫","xmin":1302.0,"ymin":2062.0,"xmax":1355.0,"ymax":2158.0},{"id":36,"contenttext":"濱に外人の居留地があつたが、其の公園に建札をして曰はく。","xmin":1227.0,"ymin":685.0,"xmax":1287.0,"ymax":1888.0},{"id":37,"contenttext":"「犬及び日本","xmin":1226.0,"ymin":1953.0,"xmax":1282.0,"ymax":2157.0},{"id":38,"contenttext":"人此の中に入るべからず。」","xmin":1161.0,"ymin":685.0,"xmax":1217.0,"ymax":1206.0},{"id":39,"contenttext":"斯う云ふ工合に日本人を馬鹿にして居つたの","xmin":1153.0,"ymin":1251.0,"xmax":1213.0,"ymax":2152.0},{"id":40,"contenttext":"である。","xmin":1097.0,"ymin":688.0,"xmax":1140.0,"ymax":818.0},{"id":41,"contenttext":"然るに今日に於いては、犬よりも以下と認めて居つた所の日本と、","xmin":1079.0,"ymin":871.0,"xmax":1139.0,"ymax":2163.0},{"id":42,"contenttext":"英吉利とは同盟を結んで居る。","xmin":1016.0,"ymin":677.0,"xmax":1073.0,"ymax":1278.0},{"id":43,"contenttext":"又露西亞に於いては、日露同盟の必要なる","xmin":1007.0,"ymin":1342.0,"xmax":1065.0,"ymax":2140.0},{"id":44,"contenttext":"ことを識者の間に唱へられて居るのである。","xmin":936.0,"ymin":683.0,"xmax":1001.0,"ymax":1560.0},{"id":45,"contenttext":"斯う云ふ工合になつて來る","xmin":934.0,"ymin":1627.0,"xmax":990.0,"ymax":2148.0},{"id":46,"contenttext":"神","xmin":883.0,"ymin":815.0,"xmax":922.0,"ymax":840.0},{"id":47,"contenttext":"道","xmin":881.0,"ymin":867.0,"xmax":923.0,"ymax":897.0},{"id":48,"contenttext":"大意","xmin":883.0,"ymin":928.0,"xmax":922.0,"ymax":1002.0}]