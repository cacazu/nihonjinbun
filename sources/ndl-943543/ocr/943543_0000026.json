[{"id":1,"contenttext":"べて來ましたやうに神道は政治·宗〓·道德を以つて其の主要なる內容を組","xmin":3094.0,"ymin":709.0,"xmax":3175.0,"ymax":2177.0},{"id":2,"contenttext":"織する要素だと考へるのであります。","xmin":3034.0,"ymin":699.0,"xmax":3097.0,"ymax":1444.0},{"id":3,"contenttext":"で、我が帝國が御承知の通り世界無","xmin":3016.0,"ymin":1499.0,"xmax":3088.0,"ymax":2176.0},{"id":4,"contenttext":"比の國體を有し、萬世一系の皇統を戴いて、さうして建國以來國威が益揚り、","xmin":2940.0,"ymin":699.0,"xmax":3025.0,"ymax":2171.0},{"id":5,"contenttext":"國光が益輝いて行く、此の所以はどういふ譯であるかと考へますると、或る","xmin":2866.0,"ymin":695.0,"xmax":2948.0,"ymax":2165.0},{"id":6,"contenttext":"人は斯う言ひます。","xmin":2820.0,"ymin":695.0,"xmax":2869.0,"ymax":1069.0},{"id":7,"contenttext":"それは昔此の國が野蠻未開の時代であつたので極め","xmin":2795.0,"ymin":1119.0,"xmax":2864.0,"ymax":2165.0},{"id":8,"contenttext":"て獸的な行ひをして居つた所が儒〓といふ立派な〓が這入つて、五倫五常","xmin":2723.0,"ymin":695.0,"xmax":2807.0,"ymax":2167.0},{"id":9,"contenttext":"の道を〓へ、さうして無比の國體を有することが出來たのであると申して","xmin":2654.0,"ymin":693.0,"xmax":2728.0,"ymax":2163.0},{"id":10,"contenttext":"居る學者がある。","xmin":2604.0,"ymin":690.0,"xmax":2653.0,"ymax":1014.0},{"id":11,"contenttext":"又、或人は佛〓が傳はつて來たからであると申します。","xmin":2580.0,"ymin":1064.0,"xmax":2649.0,"ymax":2130.0},{"id":12,"contenttext":"で、つまり儒〓や佛〓の御蔭である。","xmin":2518.0,"ymin":691.0,"xmax":2582.0,"ymax":1386.0},{"id":13,"contenttext":"斯ういふ論者がございます。","xmin":2504.0,"ymin":1437.0,"xmax":2568.0,"ymax":1989.0},{"id":14,"contenttext":"併し儒","xmin":2503.0,"ymin":2045.0,"xmax":2554.0,"ymax":2163.0},{"id":15,"contenttext":"〓の本國はどうであるか。","xmin":2452.0,"ymin":687.0,"xmax":2507.0,"ymax":1200.0},{"id":16,"contenttext":"常にダイナスチー","xmin":2451.0,"ymin":1251.0,"xmax":2495.0,"ymax":1601.0},{"id":17,"contenttext":"(Dynasty)","xmin":2448.0,"ymin":1638.0,"xmax":2486.0,"ymax":1777.0},{"id":18,"contenttext":"を變へるではあり","xmin":2438.0,"ymin":1809.0,"xmax":2487.0,"ymax":2157.0},{"id":19,"contenttext":"ませんか。","xmin":2391.0,"ymin":686.0,"xmax":2436.0,"ymax":873.0},{"id":20,"contenttext":"革命の國ではありませんか。","xmin":2377.0,"ymin":919.0,"xmax":2435.0,"ymax":1474.0},{"id":21,"contenttext":"佛〓の本國も其の通りです。","xmin":2365.0,"ymin":1526.0,"xmax":2425.0,"ymax":2075.0},{"id":22,"contenttext":"我","xmin":2365.0,"ymin":2134.0,"xmax":2414.0,"ymax":2156.0},{"id":23,"contenttext":"が日本の國體か世界無比で、我が日本の皇統が萬世一系でありますのは、實","xmin":2287.0,"ymin":685.0,"xmax":2370.0,"ymax":2157.0},{"id":24,"contenttext":"に我が國固有の大道が、單に政道でなく、單に宗〓でなく、單に道德でなく、詰","xmin":2209.0,"ymin":685.0,"xmax":2291.0,"ymax":2151.0},{"id":25,"contenttext":"り神道其ものゝ中には政治も宗〓も道德もあるのでありますからです。","xmin":1827.0,"ymin":679.0,"xmax":1882.0,"ymax":2130.0},{"id":26,"contenttext":"元來神道なるものは實に偉大なる道でありまして、之れを發けば天地六合","xmin":1755.0,"ymin":681.0,"xmax":1807.0,"ymax":2162.0},{"id":27,"contenttext":"に瀰漫し、之を收むれば人道の細微をも穿つ所のものであります。","xmin":1690.0,"ymin":686.0,"xmax":1735.0,"ymax":1991.0},{"id":28,"contenttext":"斯う云","xmin":1683.0,"ymin":2047.0,"xmax":1734.0,"ymax":2163.0},{"id":29,"contenttext":"ふ譯で神道は單に政治でなく、單に宗〓でなく、單に道德でないのでありま","xmin":1619.0,"ymin":681.0,"xmax":1670.0,"ymax":2164.0},{"id":30,"contenttext":"す。","xmin":1549.0,"ymin":683.0,"xmax":1592.0,"ymax":734.0},{"id":31,"contenttext":"それでありますからして儒〓が渡つて來る。","xmin":1545.0,"ymin":770.0,"xmax":1596.0,"ymax":1664.0},{"id":32,"contenttext":"さうすると堯舜の禪讓","xmin":1541.0,"ymin":1723.0,"xmax":1592.0,"ymax":2164.0},{"id":33,"contenttext":"や、或は湯武の放伐の如きを極力排斥し、又佛〓が渡つて來ると、小乘佛〓の","xmin":1469.0,"ymin":683.0,"xmax":1522.0,"ymax":2160.0},{"id":34,"contenttext":"極めて消極的で極めて厭世的であるものは直に其の跡を絕たしめ、能く積","xmin":1394.0,"ymin":683.0,"xmax":1449.0,"ymax":2164.0},{"id":35,"contenttext":"極的で、現世的なる大乘佛〓を利用し之れを同化し去つたのであります。","xmin":1324.0,"ymin":683.0,"xmax":1375.0,"ymax":2132.0},{"id":36,"contenttext":"が併し道は人によつて存するのでありますからしで、かく外〓を利用し、","xmin":1258.0,"ymin":685.0,"xmax":1309.0,"ymax":2162.0},{"id":37,"contenttext":"化するには、我が國民が健全で、我が大道を十分に體認し、如何なものでも利","xmin":1186.0,"ymin":683.0,"xmax":1246.0,"ymax":2165.0},{"id":38,"contenttext":"用し、同化する力を有さなくてはなりません。","xmin":1123.0,"ymin":681.0,"xmax":1177.0,"ymax":1572.0},{"id":39,"contenttext":"八","xmin":1028.0,"ymin":966.0,"xmax":1094.0,"ymax":1020.0},{"id":40,"contenttext":"所が維新以後非常に西洋の文明が這入つて來ました。","xmin":952.0,"ymin":730.0,"xmax":1006.0,"ymax":1805.0},{"id":41,"contenttext":"恰も河を決する","xmin":956.0,"ymin":1864.0,"xmax":1001.0,"ymax":2162.0},{"id":43,"contenttext":"道","xmin":897.0,"ymin":871.0,"xmax":934.0,"ymax":902.0},{"id":44,"contenttext":"大","xmin":897.0,"ymin":928.0,"xmax":934.0,"ymax":958.0},{"id":45,"contenttext":"意","xmin":897.0,"ymin":985.0,"xmax":934.0,"ymax":1012.0},{"id":47,"contenttext":"恰も河を決する","xmin":956.0,"ymin":1864.0,"xmax":1001.0,"ymax":2162.0}]