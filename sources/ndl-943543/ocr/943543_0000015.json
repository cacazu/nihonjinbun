[{"id":1,"contenttext":"私は茲迄述べて來て、我が國民と外國民とは根本の思想に於いて違つて","xmin":3059.0,"ymin":725.0,"xmax":3115.0,"ymax":2140.0},{"id":2,"contenttext":"居ると云ふ事は十分申し明したと思ふのであります。","xmin":2985.0,"ymin":677.0,"xmax":3040.0,"ymax":1737.0},{"id":3,"contenttext":"けれどももう少し","xmin":2984.0,"ymin":1802.0,"xmax":3035.0,"ymax":2138.0},{"id":4,"contenttext":"此の事に就いて述べて見たい。","xmin":2914.0,"ymin":677.0,"xmax":2968.0,"ymax":1279.0},{"id":5,"contenttext":"彼の支那の賢人と云はれて居る孟子は何","xmin":2915.0,"ymin":1334.0,"xmax":2970.0,"ymax":2144.0},{"id":6,"contenttext":"う云ふ事を云つたか、臣として君を伐つ忠と云ふべきかと云ふ問に對して、","xmin":2841.0,"ymin":679.0,"xmax":2892.0,"ymax":2144.0},{"id":7,"contenttext":"仁を賊ふ者之れを賊と云ふのである。","xmin":2765.0,"ymin":677.0,"xmax":2819.0,"ymax":1414.0},{"id":8,"contenttext":"義を賊ふ者之れを殘と云ふのであ","xmin":2767.0,"ymin":1476.0,"xmax":2818.0,"ymax":2140.0},{"id":9,"contenttext":"る.","xmin":2702.0,"ymin":683.0,"xmax":2739.0,"ymax":726.0},{"id":10,"contenttext":"殘賊の人之れを一夫と云ふのである。","xmin":2692.0,"ymin":772.0,"xmax":2747.0,"ymax":1509.0},{"id":11,"contenttext":"一夫の紂を誅することを聞い","xmin":2694.0,"ymin":1578.0,"xmax":2743.0,"ymax":2138.0},{"id":12,"contenttext":"て居るが、未だ君を弑したのを聞かないのである。","xmin":2618.0,"ymin":681.0,"xmax":2672.0,"ymax":1645.0},{"id":13,"contenttext":"斯う云ふ答をして居る。","xmin":2620.0,"ymin":1711.0,"xmax":2669.0,"ymax":2144.0},{"id":14,"contenttext":"克くも斯う云ふ詭辯を弄する事か出來たものである。","xmin":2544.0,"ymin":677.0,"xmax":2598.0,"ymax":1737.0},{"id":15,"contenttext":"晋の桓温は。男子芳","xmin":2545.0,"ymin":1804.0,"xmax":2598.0,"ymax":2144.0},{"id":16,"contenttext":"を百世に流す能はずんば亦當に臭を萬年に遺すべしと云つた。","xmin":2469.0,"ymin":677.0,"xmax":2524.0,"ymax":1929.0},{"id":17,"contenttext":"臭は臭名","xmin":2469.0,"ymin":1992.0,"xmax":2522.0,"ymax":2146.0},{"id":18,"contenttext":"である、惡名である。","xmin":2397.0,"ymin":681.0,"xmax":2443.0,"ymax":1044.0},{"id":19,"contenttext":"斯くの如き言葉は決して我が國民の口に出來ぬ所で","xmin":2393.0,"ymin":1099.0,"xmax":2449.0,"ymax":2140.0},{"id":20,"contenttext":"あります。","xmin":2328.0,"ymin":681.0,"xmax":2373.0,"ymax":861.0},{"id":21,"contenttext":"又、してはならない所であります。","xmin":2324.0,"ymin":912.0,"xmax":2373.0,"ymax":1551.0},{"id":22,"contenttext":"之れを西洋に就いて見ます","xmin":2318.0,"ymin":1616.0,"xmax":2375.0,"ymax":2142.0},{"id":23,"contenttext":"ると云ふと昔羅馬にバヂリウスと云ふ人があつた。","xmin":2250.0,"ymin":681.0,"xmax":2299.0,"ymax":1691.0},{"id":24,"contenttext":"此の人は誠に質朴な","xmin":2250.0,"ymin":1759.0,"xmax":2297.0,"ymax":2140.0},{"id":25,"contenttext":"基督〓信者であつたが、其の人が或る時當時の羅馬皇帝バレンチヤヌス陸","xmin":2177.0,"ymin":681.0,"xmax":2228.0,"ymax":2145.0},{"id":26,"contenttext":"下から使者を受けて、其の皇帝の使者の前に立つことゝなつた。","xmin":1805.0,"ymin":679.0,"xmax":1865.0,"ymax":1919.0},{"id":27,"contenttext":"そして皇","xmin":1815.0,"ymin":1988.0,"xmax":1860.0,"ymax":2134.0},{"id":28,"contenttext":"帝の使者がバヂリウスに云ふには、其の方は帝の信ぜらるゝ所の〓理を信","xmin":1735.0,"ymin":677.0,"xmax":1793.0,"ymax":2136.0},{"id":29,"contenttext":"じなければ罸せられるぞと、斯う云つた。","xmin":1659.0,"ymin":675.0,"xmax":1714.0,"ymax":1457.0},{"id":30,"contenttext":"所がバヂリウスは之れに答へて、","xmin":1660.0,"ymin":1518.0,"xmax":1718.0,"ymax":2148.0},{"id":31,"contenttext":"それはもう罸せられても仕方がございませぬ。","xmin":1586.0,"ymin":675.0,"xmax":1637.0,"ymax":1594.0},{"id":32,"contenttext":"が、併し何う云ふ罸を下さ","xmin":1588.0,"ymin":1661.0,"xmax":1641.0,"ymax":2136.0},{"id":33,"contenttext":"る.","xmin":1519.0,"ymin":681.0,"xmax":1555.0,"ymax":721.0},{"id":34,"contenttext":"使者が云ふには其の罸と云ふのは御前の財產をすつかり沒收せられ","xmin":1509.0,"ymin":767.0,"xmax":1566.0,"ymax":2136.0},{"id":35,"contenttext":"るのである。","xmin":1437.0,"ymin":679.0,"xmax":1484.0,"ymax":905.0},{"id":36,"contenttext":"するとバヂリウスは一向平氣でそれは宜しうございます。","xmin":1431.0,"ymin":956.0,"xmax":1496.0,"ymax":2105.0},{"id":37,"contenttext":"私の財產と申した所が此の着て居る着物一枚限りでございますから、之れ","xmin":1360.0,"ymin":677.0,"xmax":1418.0,"ymax":2138.0},{"id":38,"contenttext":"を取られた所で少しも差支はございません。","xmin":1285.0,"ymin":677.0,"xmax":1343.0,"ymax":1551.0},{"id":39,"contenttext":"使者は、御前そんな事を云ふ","xmin":1292.0,"ymin":1613.0,"xmax":1343.0,"ymax":2138.0},{"id":40,"contenttext":"と國外へ放逐されるぞ。","xmin":1210.0,"ymin":679.0,"xmax":1267.0,"ymax":1139.0},{"id":41,"contenttext":"いやそれも宜しうございます。","xmin":1217.0,"ymin":1197.0,"xmax":1268.0,"ymax":1780.0},{"id":42,"contenttext":"一體神樣と云ふ","xmin":1220.0,"ymin":1859.0,"xmax":1267.0,"ymax":2136.0},{"id":43,"contenttext":"ものは何れの所へ行つても御在でになるものですから、國外へでも何處へ","xmin":1141.0,"ymin":681.0,"xmax":1199.0,"ymax":2134.0},{"id":44,"contenttext":"でも參りませう。","xmin":1071.0,"ymin":683.0,"xmax":1120.0,"ymax":1000.0},{"id":45,"contenttext":"使者もたまり兼ねて御前そんな事を云ふと死刑に處せ","xmin":1069.0,"ymin":1052.0,"xmax":1125.0,"ymax":2138.0},{"id":46,"contenttext":"られるぞ。","xmin":997.0,"ymin":681.0,"xmax":1042.0,"ymax":861.0},{"id":47,"contenttext":"宜しうございます死刑にして戴きませう。","xmin":998.0,"ymin":916.0,"xmax":1047.0,"ymax":1738.0},{"id":48,"contenttext":"私はうまれつき馬","xmin":998.0,"ymin":1807.0,"xmax":1050.0,"ymax":2142.0},{"id":49,"contenttext":"鹿でございまして、殉〓者と云つて〓の爲に身を犠牲にする丈けの知惠が","xmin":924.0,"ymin":681.0,"xmax":979.0,"ymax":2138.0},{"id":50,"contenttext":"神","xmin":867.0,"ymin":834.0,"xmax":907.0,"ymax":857.0},{"id":51,"contenttext":"道","xmin":867.0,"ymin":887.0,"xmax":905.0,"ymax":916.0},{"id":52,"contenttext":"大意","xmin":867.0,"ymin":945.0,"xmax":907.0,"ymax":1022.0}]