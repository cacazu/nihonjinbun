[{"id":1,"contenttext":"ります。","xmin":3059.0,"ymin":632.0,"xmax":3102.0,"ymax":766.0},{"id":2,"contenttext":"此の神道と云ふ文字を平田篤胤翁は解して神を祭り、神を禱り、又","xmin":3055.0,"ymin":818.0,"xmax":3116.0,"ymax":2095.0},{"id":3,"contenttext":"祓などの類凡て神に仕へまつるわざをひろく申したものと解釋されてあ","xmin":2977.0,"ymin":630.0,"xmax":3045.0,"ymax":2097.0},{"id":4,"contenttext":"りますが、誠にその通りで全く神道といふ言葉を宗〓的の意味に使つたも","xmin":2905.0,"ymin":632.0,"xmax":2967.0,"ymax":2097.0},{"id":5,"contenttext":"のと考へられます","xmin":2831.0,"ymin":634.0,"xmax":2882.0,"ymax":987.0},{"id":6,"contenttext":"それから其の後平安朝初期に出でたる最澄が始めて","xmin":2834.0,"ymin":1057.0,"xmax":2898.0,"ymax":2101.0},{"id":7,"contenttext":"唱へたと云ふ山王一實神道、或は空海が創めたといふ兩部習合神道ざうい","xmin":2751.0,"ymin":632.0,"xmax":2823.0,"ymax":2099.0},{"id":8,"contenttext":"ふ風の神道は全く宗〓的であります。","xmin":2677.0,"ymin":636.0,"xmax":2737.0,"ymax":1372.0},{"id":9,"contenttext":"それから後のト部家の唯一神道、是","xmin":2682.0,"ymin":1436.0,"xmax":2743.0,"ymax":2103.0},{"id":10,"contenttext":"れも宗〓的であります、","xmin":2604.0,"ymin":634.0,"xmax":2653.0,"ymax":1095.0},{"id":11,"contenttext":"それから近代の奇傑でありました所の黑住宗忠","xmin":2606.0,"ymin":1153.0,"xmax":2664.0,"ymax":2101.0},{"id":12,"contenttext":"氏、之れも矢張り天照大神を最上神として明かに一派の宗〓を立し、訓誠七","xmin":2527.0,"ymin":634.0,"xmax":2597.0,"ymax":2103.0},{"id":13,"contenttext":"ケ條の第一に於いて、神國の人に生れ常に信心なき事を誠め、千辛萬苦して","xmin":2452.0,"ymin":640.0,"xmax":2518.0,"ymax":2101.0},{"id":14,"contenttext":"熱烈な宗〓的信仰を皷吹されて居ります。","xmin":2379.0,"ymin":634.0,"xmax":2435.0,"ymax":1468.0},{"id":15,"contenttext":"近世大分斯ういふ熱烈な宗〓","xmin":2387.0,"ymin":1532.0,"xmax":2447.0,"ymax":2108.0},{"id":16,"contenttext":"家が出られまして神道といふものは宗〓である。","xmin":2306.0,"ymin":636.0,"xmax":2362.0,"ymax":1607.0},{"id":17,"contenttext":"斯ういふ風に考へる人","xmin":2314.0,"ymin":1674.0,"xmax":2368.0,"ymax":2105.0},{"id":18,"contenttext":"が澤山出來て來ました。","xmin":2232.0,"ymin":638.0,"xmax":2288.0,"ymax":1102.0},{"id":19,"contenttext":"けれども此の神道は全く宗〓である、徹頭徹尾宗","xmin":2235.0,"ymin":1155.0,"xmax":2299.0,"ymax":2106.0},{"id":20,"contenttext":"〓であるといふ考も餘り宜い考ではないと思ひます。","xmin":2160.0,"ymin":640.0,"xmax":2217.0,"ymax":1701.0},{"id":21,"contenttext":"それから第三番目","xmin":2170.0,"ymin":1770.0,"xmax":2219.0,"ymax":2103.0},{"id":22,"contenttext":"はどういふ考かといふと神道は即ち德〓である、倫理である、神道は倫理で","xmin":1848.0,"ymin":643.0,"xmax":1897.0,"ymax":2103.0},{"id":23,"contenttext":"なければならない。","xmin":1774.0,"ymin":643.0,"xmax":1823.0,"ymax":1010.0},{"id":24,"contenttext":"斯ういふ說が大分ございます。","xmin":1772.0,"ymin":1065.0,"xmax":1823.0,"ymax":1655.0},{"id":25,"contenttext":"此の說は今日始つた","xmin":1772.0,"ymin":1724.0,"xmax":1825.0,"ymax":2107.0},{"id":26,"contenttext":"說ではない。","xmin":1700.0,"ymin":643.0,"xmax":1749.0,"ymax":873.0},{"id":27,"contenttext":"倫理とは昔は多く申しませんでしたが、倫理のやうに考へた","xmin":1700.0,"ymin":924.0,"xmax":1747.0,"ymax":2107.0},{"id":28,"contenttext":"のは昔からの說です。","xmin":1623.0,"ymin":644.0,"xmax":1679.0,"ymax":1061.0},{"id":29,"contenttext":"彼の山崎闇齋先生、それから平田篤胤翁、あゝいふ方","xmin":1623.0,"ymin":1113.0,"xmax":1678.0,"ymax":2109.0},{"id":30,"contenttext":"の說の大部分は矢張り此の說に屬するものと思はれます。","xmin":1545.0,"ymin":644.0,"xmax":1601.0,"ymax":1797.0},{"id":31,"contenttext":"といふのは山","xmin":1551.0,"ymin":1867.0,"xmax":1598.0,"ymax":2107.0},{"id":32,"contenttext":"齋崎闇先生は神道は天人唯一にして、道は日神の道、〓は猿田彥神の導き玉","xmin":1476.0,"ymin":640.0,"xmax":1529.0,"ymax":2107.0},{"id":33,"contenttext":"ふ處、土金の〓、天人を貫く、敬みの至りなりなど申され、その說は牽强附會の","xmin":1400.0,"ymin":645.0,"xmax":1453.0,"ymax":2105.0},{"id":34,"contenttext":"やうに思はれます。","xmin":1327.0,"ymin":640.0,"xmax":1379.0,"ymax":1008.0},{"id":35,"contenttext":"勿論牽强附會でも何でも兎に角山崎闇齋先生は神道","xmin":1328.0,"ymin":1065.0,"xmax":1377.0,"ymax":2107.0},{"id":36,"contenttext":"を倫理として、德〓として立てゝ行かうといふ考であるのでありました。","xmin":1255.0,"ymin":640.0,"xmax":1305.0,"ymax":2072.0},{"id":37,"contenttext":"それから平田篤胤翁は斯ういふ說であります。","xmin":1176.0,"ymin":640.0,"xmax":1233.0,"ymax":1566.0},{"id":38,"contenttext":"抑も我が皇神の道の趣き","xmin":1179.0,"ymin":1632.0,"xmax":1231.0,"ymax":2109.0},{"id":39,"contenttext":"は〓淨を本として、汚穢を惡む、君親には忠實に仕へ、妻子を惠みて、子孫を多","xmin":1103.0,"ymin":640.0,"xmax":1161.0,"ymax":2109.0},{"id":40,"contenttext":"く生殖し、親族を睦び和し、朋友には信を專らとし、奴婢を憐れみ、家の榮えん","xmin":1030.0,"ymin":640.0,"xmax":1086.0,"ymax":2107.0},{"id":41,"contenttext":"事を思ふぞ、神ながら御傳へ坐せる眞の道なるといふ事が『玉襷』といふ本","xmin":955.0,"ymin":640.0,"xmax":1014.0,"ymax":2109.0},{"id":43,"contenttext":"道","xmin":905.0,"ymin":835.0,"xmax":948.0,"ymax":865.0},{"id":44,"contenttext":"大","xmin":905.0,"ymin":895.0,"xmax":946.0,"ymax":922.0},{"id":45,"contenttext":"意","xmin":905.0,"ymin":951.0,"xmax":946.0,"ymax":975.0}]