[{"id":1,"contenttext":"し時の神勅及び高皇產靈尊の「あまつひもろぎ」「あまついはさか」の神勅の如","xmin":3066.0,"ymin":703.0,"xmax":3121.0,"ymax":2168.0},{"id":2,"contenttext":"き、其の他祭祀が行はれ、或は禊とか祓とか神樂とか色々昔から行はれた儀","xmin":2988.0,"ymin":701.0,"xmax":3047.0,"ymax":2171.0},{"id":3,"contenttext":"式です。","xmin":2921.0,"ymin":701.0,"xmax":2974.0,"ymax":838.0},{"id":4,"contenttext":"斯ういふ風な儀式を研究して見ますとどうしても宗〓的儀式、即","xmin":2916.0,"ymin":888.0,"xmax":2968.0,"ymax":2166.0},{"id":5,"contenttext":"ち吾々民族の宗〓的感情の發表としか見られない。","xmin":2839.0,"ymin":703.0,"xmax":2897.0,"ymax":1721.0},{"id":6,"contenttext":"それでありますから","xmin":2847.0,"ymin":1789.0,"xmax":2892.0,"ymax":2168.0},{"id":7,"contenttext":"して黑住宗忠氏の如く或は井上正鐵氏の如くあゝいふ風な熱烈な宗〓心","xmin":2769.0,"ymin":703.0,"xmax":2826.0,"ymax":2171.0},{"id":8,"contenttext":"の强い人であると、どうしても神道は宗〓に見えるのであります。","xmin":2694.0,"ymin":699.0,"xmax":2745.0,"ymax":1996.0},{"id":9,"contenttext":"勿論神","xmin":2698.0,"ymin":2072.0,"xmax":2749.0,"ymax":2170.0},{"id":10,"contenttext":"道は佛〓や基督〓の樣な偏狹な宗〓ではなく、此れ等を超越した宗〓なの","xmin":2620.0,"ymin":697.0,"xmax":2670.0,"ymax":2168.0},{"id":11,"contenttext":"であります。","xmin":2553.0,"ymin":701.0,"xmax":2589.0,"ymax":924.0},{"id":12,"contenttext":"が何れにしても神道は宗〓とも見えるのであります。","xmin":2549.0,"ymin":982.0,"xmax":2594.0,"ymax":2044.0},{"id":13,"contenttext":"それ","xmin":2551.0,"ymin":2120.0,"xmax":2598.0,"ymax":2170.0},{"id":14,"contenttext":"から山崎闇齋先生や平田篤胤翁やその他今日でも道德的方面を重んずる","xmin":2473.0,"ymin":703.0,"xmax":2531.0,"ymax":2168.0},{"id":15,"contenttext":"學者は、神道は全く道德であると解するのであります。","xmin":2401.0,"ymin":701.0,"xmax":2452.0,"ymax":1766.0},{"id":16,"contenttext":"成程さういふ眼を","xmin":2401.0,"ymin":1831.0,"xmax":2450.0,"ymax":2166.0},{"id":17,"contenttext":"以つて見ると古傳の傳へまする神々の行爲は一々我々の日常の行爲の規","xmin":2324.0,"ymin":701.0,"xmax":2377.0,"ymax":2170.0},{"id":18,"contenttext":"範を示されたものと解せられ、それから又此の神道に行ひまする崇拜です。","xmin":2250.0,"ymin":701.0,"xmax":2299.0,"ymax":2168.0},{"id":19,"contenttext":"神樣を拜むのです。","xmin":2179.0,"ymin":701.0,"xmax":2230.0,"ymax":1073.0},{"id":20,"contenttext":"之れも道德的方面の人が見ますと、唯々本に報い始に","xmin":2176.0,"ymin":1124.0,"xmax":2229.0,"ymax":2162.0},{"id":21,"contenttext":"反る所以である。","xmin":1817.0,"ymin":693.0,"xmax":1863.0,"ymax":1012.0},{"id":22,"contenttext":"斯ういふ風に神道は道德であると眼に映じて來るので","xmin":1815.0,"ymin":1069.0,"xmax":1866.0,"ymax":2158.0},{"id":23,"contenttext":"ございませう。","xmin":1745.0,"ymin":695.0,"xmax":1788.0,"ymax":971.0},{"id":24,"contenttext":"コー云ふ次第でありますから神道は、道德である、倫理であ","xmin":1741.0,"ymin":1032.0,"xmax":1794.0,"ymax":2158.0},{"id":25,"contenttext":"るといふのは誤りでないのでございます","xmin":1668.0,"ymin":695.0,"xmax":1717.0,"ymax":1514.0},{"id":26,"contenttext":"が併し之れは先に申しますや","xmin":1670.0,"ymin":1595.0,"xmax":1719.0,"ymax":2158.0},{"id":27,"contenttext":"うに象を撫でゝ白のやうなものである、蛇のやうなものである、壁のやうな","xmin":1597.0,"ymin":697.0,"xmax":1650.0,"ymax":2158.0},{"id":28,"contenttext":"ものである。","xmin":1531.0,"ymin":697.0,"xmax":1574.0,"ymax":922.0},{"id":29,"contenttext":"斯う申したのも間違ひでないのと同じでありまして、斯う申","xmin":1529.0,"ymin":978.0,"xmax":1578.0,"ymax":2160.0},{"id":30,"contenttext":"したのが間違ひとは斷言せられないのであります。","xmin":1450.0,"ymin":694.0,"xmax":1505.0,"ymax":1712.0},{"id":31,"contenttext":"實際或る所は蛇のや","xmin":1449.0,"ymin":1780.0,"xmax":1506.0,"ymax":2160.0},{"id":32,"contenttext":"うでありますし、或る所は白のやうでありますし、或る所は壁のやうである","xmin":1374.0,"ymin":695.0,"xmax":1429.0,"ymax":2158.0},{"id":33,"contenttext":"からであります。","xmin":1306.0,"ymin":700.0,"xmax":1353.0,"ymax":1016.0},{"id":34,"contenttext":"決して間違ひではありません。","xmin":1304.0,"ymin":1069.0,"xmax":1353.0,"ymax":1668.0},{"id":35,"contenttext":"けれども其の考はどう","xmin":1306.0,"ymin":1734.0,"xmax":1353.0,"ymax":2160.0},{"id":36,"contenttext":"も部分的であつて偏見と言はなければなりませぬ。","xmin":1226.0,"ymin":697.0,"xmax":1277.0,"ymax":1712.0},{"id":37,"contenttext":"それで大正の昭代、か","xmin":1226.0,"ymin":1780.0,"xmax":1279.0,"ymax":2160.0},{"id":38,"contenttext":"くも盛に發達して來た其の學問を應用してさうして此の神道といふもの","xmin":1153.0,"ymin":697.0,"xmax":1202.0,"ymax":2158.0},{"id":39,"contenttext":"を研究して見ますと、どうしても此の神道といふものは、その起源から見ま","xmin":1087.0,"ymin":699.0,"xmax":1132.0,"ymax":2162.0},{"id":40,"contenttext":"しても、その典據から見ましても神道の性質は政治·宗〓·道德といふ三大系","xmin":1012.0,"ymin":697.0,"xmax":1061.0,"ymax":2158.0},{"id":41,"contenttext":"統が即ち三大要素を成して居るやうに思はるゝのであります。","xmin":936.0,"ymin":697.0,"xmax":986.0,"ymax":1944.0},{"id":42,"contenttext":"勿論斯う","xmin":936.0,"ymin":2017.0,"xmax":989.0,"ymax":2159.0},{"id":46,"contenttext":"意","xmin":869.0,"ymin":1007.0,"xmax":912.0,"ymax":1030.0}]