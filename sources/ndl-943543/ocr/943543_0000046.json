[{"id":1,"contenttext":"『神風』(九〇號)評","xmin":3160.0,"ymin":830.0,"xmax":3209.0,"ymax":1122.0},{"id":2,"contenttext":"其の內容を見るに、","xmin":3101.0,"ymin":902.0,"xmax":3156.0,"ymax":1210.0},{"id":3,"contenttext":"著者たる田中先生は、","xmin":3106.0,"ymin":1241.0,"xmax":3158.0,"ymax":1581.0},{"id":4,"contenttext":"目下國學院大學の講師にして、","xmin":3106.0,"ymin":1619.0,"xmax":3160.0,"ymax":2101.0},{"id":5,"contenttext":"其","xmin":3109.0,"ymin":2147.0,"xmax":3158.0,"ymax":2158.0},{"id":6,"contenttext":"の述ぶる所の本書に執りては、","xmin":3045.0,"ymin":906.0,"xmax":3101.0,"ymax":1394.0},{"id":7,"contenttext":"平田翁の經歷·性行·學統より學說·對異·統括","xmin":3047.0,"ymin":1430.0,"xmax":3104.0,"ymax":2156.0},{"id":8,"contenttext":"の各篇、即ち平田翁の世界·人生等に關する一代の學說を、","xmin":2991.0,"ymin":906.0,"xmax":3043.0,"ymax":1839.0},{"id":9,"contenttext":"系統的組織的に說","xmin":2992.0,"ymin":1883.0,"xmax":3045.0,"ymax":2158.0},{"id":10,"contenttext":"述したるものにして、","xmin":2937.0,"ymin":904.0,"xmax":2984.0,"ymax":1247.0},{"id":11,"contenttext":"平田翁は何人も知る處の我國屈指の熱心なる神道家に","xmin":2939.0,"ymin":1281.0,"xmax":2988.0,"ymax":2154.0},{"id":12,"contenttext":"して、其の熱心なる言論は、自餘のものを燒棄せずんば止まざるの〓あり。","xmin":2882.0,"ymin":904.0,"xmax":2931.0,"ymax":2095.0},{"id":13,"contenttext":"其","xmin":2884.0,"ymin":2145.0,"xmax":2935.0,"ymax":2158.0},{"id":14,"contenttext":"の神道を尊で儒佛を排し有らゆる異學を排して餘力を遺さゞる處は翁として","xmin":2828.0,"ymin":908.0,"xmax":2880.0,"ymax":2156.0},{"id":15,"contenttext":"の特長なり。されば其の見識あり、氣慨あり、毫も他に一步を讓らず、所謂權威","xmin":2775.0,"ymin":906.0,"xmax":2827.0,"ymax":2158.0},{"id":16,"contenttext":"ある學者の說として、又一派の神道家として、之を研究したらんには、","xmin":2718.0,"ymin":908.0,"xmax":2769.0,"ymax":2025.0},{"id":17,"contenttext":"其の得","xmin":2718.0,"ymin":2070.0,"xmax":2773.0,"ymax":2158.0},{"id":18,"contenttext":"る所多大ならんとす。","xmin":2663.0,"ymin":908.0,"xmax":2712.0,"ymax":1253.0},{"id":19,"contenttext":"宜しく神道家たるもの一書を購ふて座右に置かれよ。","xmin":2663.0,"ymin":1281.0,"xmax":2712.0,"ymax":2140.0},{"id":20,"contenttext":"『東京朝日新聞』(八三九一號)評","xmin":2587.0,"ymin":830.0,"xmax":2636.0,"ymax":1345.0},{"id":21,"contenttext":"實にや神道は皇國の大道にして、他の宗〓の如く經典學說あるに非ずと雖も、","xmin":2531.0,"ymin":904.0,"xmax":2587.0,"ymax":2156.0},{"id":22,"contenttext":"建國當時より萬古不滅の大綱として、","xmin":2477.0,"ymin":906.0,"xmax":2528.0,"ymax":1506.0},{"id":23,"contenttext":"國民の精髓を支配し來れるもの也。","xmin":2479.0,"ymin":1543.0,"xmax":2528.0,"ymax":2101.0},{"id":24,"contenttext":"吾","xmin":2479.0,"ymin":2145.0,"xmax":2530.0,"ymax":2160.0},{"id":25,"contenttext":"が平田篤胤の〓は、","xmin":2420.0,"ymin":906.0,"xmax":2472.0,"ymax":1214.0},{"id":26,"contenttext":"本居宣長の學說の後を承け、","xmin":2420.0,"ymin":1243.0,"xmax":2475.0,"ymax":1693.0},{"id":27,"contenttext":"此の大本に據り、","xmin":2424.0,"ymin":1734.0,"xmax":2473.0,"ymax":1990.0},{"id":28,"contenttext":"異端の〓","xmin":2426.0,"ymin":2033.0,"xmax":2477.0,"ymax":2160.0},{"id":29,"contenttext":"を斥け忠君愛國の實踐哲學を皷吹せる者にて、其說往々にして稍極端に走り、","xmin":2369.0,"ymin":906.0,"xmax":2418.0,"ymax":2156.0},{"id":30,"contenttext":"間々牽會の箇所なきに非ずと雖も、","xmin":2314.0,"ymin":908.0,"xmax":2363.0,"ymax":1469.0},{"id":31,"contenttext":"斯道の根本を確立せし點に於て、","xmin":2313.0,"ymin":1507.0,"xmax":2366.0,"ymax":2028.0},{"id":32,"contenttext":"日本神","xmin":2318.0,"ymin":2074.0,"xmax":2365.0,"ymax":2158.0},{"id":33,"contenttext":"道史中の大立物たるに背かず。","xmin":2256.0,"ymin":908.0,"xmax":2307.0,"ymax":1404.0},{"id":34,"contenttext":"又一代の經歷に於ても、","xmin":2258.0,"ymin":1430.0,"xmax":2309.0,"ymax":1804.0},{"id":35,"contenttext":"一世の模範たる可き","xmin":2260.0,"ymin":1858.0,"xmax":2309.0,"ymax":2158.0},{"id":36,"contenttext":"の人なり。","xmin":2201.0,"ymin":914.0,"xmax":2246.0,"ymax":1069.0},{"id":37,"contenttext":"本書は-翁を研究せんとする人には好古の參考書なるべし。","xmin":2199.0,"ymin":1098.0,"xmax":2254.0,"ymax":2105.0},{"id":38,"contenttext":"學哲之胤篤田平","xmin":2323.0,"ymin":624.0,"xmax":3085.0,"ymax":751.0},{"id":39,"contenttext":"『大阪每日新聞』(九四〇一號)評","xmin":1891.0,"ymin":813.0,"xmax":1953.0,"ymax":1330.0},{"id":40,"contenttext":"國學院講師田中義能氏の「平田篤胤之哲學」は、","xmin":1837.0,"ymin":890.0,"xmax":1895.0,"ymax":1643.0},{"id":41,"contenttext":"神道國學の人傑を思想上哲學","xmin":1841.0,"ymin":1681.0,"xmax":1893.0,"ymax":2144.0},{"id":42,"contenttext":"上より評傳した書としては、","xmin":1789.0,"ymin":892.0,"xmax":1840.0,"ymax":1349.0},{"id":43,"contenttext":"殆ど初めて位なものであらう。","xmin":1788.0,"ymin":1376.0,"xmax":1837.0,"ymax":1866.0},{"id":44,"contenttext":"是まで朱子學古","xmin":1792.0,"ymin":1906.0,"xmax":1839.0,"ymax":2148.0},{"id":45,"contenttext":"學等儒家の學說に就いての述作はあるが、","xmin":1737.0,"ymin":892.0,"xmax":1787.0,"ymax":1566.0},{"id":46,"contenttext":"皇學家をこれほどに系統的思想的","xmin":1737.0,"ymin":1607.0,"xmax":1789.0,"ymax":2148.0},{"id":47,"contenttext":"に論じたものは記者は未だ見なかつた。","xmin":1686.0,"ymin":894.0,"xmax":1735.0,"ymax":1533.0},{"id":48,"contenttext":"篤胤は本居の先導者となつて開いた","xmin":1685.0,"ymin":1567.0,"xmax":1739.0,"ymax":2146.0},{"id":49,"contenttext":"獨自的皇學論を一層積極的に批評眼を開き、宗〓觀に至つて殊に生面がある。","xmin":1639.0,"ymin":892.0,"xmax":1688.0,"ymax":2144.0},{"id":50,"contenttext":"「神はわが神なりわれは神の人なり」と言つたのなどは最もその思想の超凡を","xmin":1588.0,"ymin":890.0,"xmax":1639.0,"ymax":2146.0},{"id":51,"contenttext":"證せらる。","xmin":1543.0,"ymin":896.0,"xmax":1590.0,"ymax":1055.0},{"id":52,"contenttext":"田中氏の此書は、","xmin":1484.0,"ymin":894.0,"xmax":1535.0,"ymax":1167.0},{"id":53,"contenttext":"多方面に能く篤胤の思想を解剖してある。","xmin":1482.0,"ymin":1193.0,"xmax":1533.0,"ymax":1868.0},{"id":54,"contenttext":"信仰對象論の如","xmin":1484.0,"ymin":1910.0,"xmax":1535.0,"ymax":2148.0},{"id":55,"contenttext":"き、","xmin":1435.0,"ymin":900.0,"xmax":1472.0,"ymax":940.0},{"id":56,"contenttext":"此書の標榜する所に背かぬ。","xmin":1424.0,"ymin":968.0,"xmax":1475.0,"ymax":1423.0},{"id":57,"contenttext":"但だ國家と宗〓の論、","xmin":1424.0,"ymin":1457.0,"xmax":1478.0,"ymax":1791.0},{"id":58,"contenttext":"其他になほ百尺竿頭","xmin":1427.0,"ymin":1836.0,"xmax":1477.0,"ymax":2150.0},{"id":59,"contenttext":"今一步ありたいと思ふ處があるが-學界思想界の爲に、","xmin":1369.0,"ymin":894.0,"xmax":1420.0,"ymax":1856.0},{"id":60,"contenttext":"此偉大な思想家","xmin":1371.0,"ymin":1899.0,"xmax":1420.0,"ymax":2146.0},{"id":61,"contenttext":"儒佛を超脫して日本的獨自の思想を發揮した-篤胤を活描し來つた著","xmin":1314.0,"ymin":968.0,"xmax":1364.0,"ymax":2148.0},{"id":62,"contenttext":"者の勞を多として、","xmin":1267.0,"ymin":896.0,"xmax":1314.0,"ymax":1206.0},{"id":63,"contenttext":"此書を推薦す。","xmin":1265.0,"ymin":1235.0,"xmax":1312.0,"ymax":1463.0},{"id":64,"contenttext":"『養德』(八卷十二號)評","xmin":1212.0,"ymin":819.0,"xmax":1262.0,"ymax":1189.0},{"id":65,"contenttext":"平田翁の學說を充分批評發揮して餘薀なきのみならず、","xmin":1152.0,"ymin":896.0,"xmax":1207.0,"ymax":1794.0},{"id":66,"contenttext":"且組織的に叙述せら","xmin":1155.0,"ymin":1838.0,"xmax":1208.0,"ymax":2150.0},{"id":67,"contenttext":"れたるは、","xmin":1102.0,"ymin":900.0,"xmax":1149.0,"ymax":1059.0},{"id":68,"contenttext":"近來比類なき著述と云ふべし。","xmin":1100.0,"ymin":1085.0,"xmax":1149.0,"ymax":1580.0},{"id":69,"contenttext":"今や世上一般哲學と云へば歐西傳","xmin":1097.0,"ymin":1611.0,"xmax":1152.0,"ymax":2152.0},{"id":70,"contenttext":"來の學說を祖述するのみにて、","xmin":1046.0,"ymin":900.0,"xmax":1098.0,"ymax":1387.0},{"id":71,"contenttext":"我日本には哲學と稱すべきものなしなどと云","xmin":1050.0,"ymin":1428.0,"xmax":1094.0,"ymax":2148.0},{"id":72,"contenttext":"へるに際し、","xmin":991.0,"ymin":906.0,"xmax":1040.0,"ymax":1095.0},{"id":73,"contenttext":"本書の出づるあり、","xmin":991.0,"ymin":1125.0,"xmax":1040.0,"ymax":1427.0},{"id":74,"contenttext":"我斯道界に一大明燈を得たるのみならず、","xmin":988.0,"ymin":1463.0,"xmax":1044.0,"ymax":2132.0},{"id":75,"contenttext":"我國體の精華を發揮するに於て効補はずんばあらず。","xmin":936.0,"ymin":900.0,"xmax":984.0,"ymax":1764.0},{"id":76,"contenttext":"響反の論世","xmin":1146.0,"ymin":587.0,"xmax":1738.0,"ymax":705.0}]