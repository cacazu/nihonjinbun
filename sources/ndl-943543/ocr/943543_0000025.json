[{"id":1,"contenttext":"いふ風の考は昔にも多少あつたのであります。","xmin":3060.0,"ymin":695.0,"xmax":3118.0,"ymax":1619.0},{"id":2,"contenttext":"彼の外宮の權禰宜でござ","xmin":3063.0,"ymin":1680.0,"xmax":3119.0,"ymax":2154.0},{"id":3,"contenttext":"いました度會延佳神主などもその一人であります。","xmin":2986.0,"ymin":696.0,"xmax":3035.0,"ymax":1704.0},{"id":4,"contenttext":"あの方は後世から非","xmin":2986.0,"ymin":1776.0,"xmax":3037.0,"ymax":2154.0},{"id":5,"contenttext":"常に非難されました。","xmin":2912.0,"ymin":689.0,"xmax":2959.0,"ymax":1104.0},{"id":6,"contenttext":"學說に對しても、人物に對しても、非難されました。","xmin":2911.0,"ymin":1162.0,"xmax":2962.0,"ymax":2119.0},{"id":7,"contenttext":"けれども非難の多い丈け卓見もあります。","xmin":2839.0,"ymin":689.0,"xmax":2888.0,"ymax":1519.0},{"id":8,"contenttext":"氏は前に述べました通り吾々","xmin":2837.0,"ymin":1586.0,"xmax":2891.0,"ymax":2150.0},{"id":9,"contenttext":"と同樣の考を有されて居りました。","xmin":2763.0,"ymin":692.0,"xmax":2814.0,"ymax":1382.0},{"id":10,"contenttext":"その思想を度會〓在と申す學者が『陽","xmin":2765.0,"ymin":1444.0,"xmax":2818.0,"ymax":2154.0},{"id":11,"contenttext":"復記衍義』と云ふ本に說明して居ります。","xmin":2684.0,"ymin":687.0,"xmax":2739.0,"ymax":1474.0},{"id":12,"contenttext":"どういふ說であるかといふと今","xmin":2688.0,"ymin":1540.0,"xmax":2739.0,"ymax":2152.0},{"id":13,"contenttext":"や神道者と云ふ名があるものだから其の人だちも我れこそ神道者なりと","xmin":2616.0,"ymin":687.0,"xmax":2667.0,"ymax":2150.0},{"id":14,"contenttext":"臂を怒らし揚々として騒ぎ廻つて居るけれども、此の位可笑しい事はない。","xmin":2540.0,"ymin":687.0,"xmax":2598.0,"ymax":2156.0},{"id":15,"contenttext":"此の國に生れて此の國の着物を着、此の國の食を喰つて生活をして居りな","xmin":2465.0,"ymin":687.0,"xmax":2518.0,"ymax":2152.0},{"id":16,"contenttext":"がら、上に君や父を頂き下に妻子臣僕を帶びて、父子親を行ひ、君臣義を行ひ、","xmin":2391.0,"ymin":689.0,"xmax":2440.0,"ymax":2154.0},{"id":17,"contenttext":"夫婦別を行ひ、或は序を行ひ、或は信を行ふ。","xmin":2318.0,"ymin":689.0,"xmax":2371.0,"ymax":1520.0},{"id":18,"contenttext":"斯ういふ風に國民が行ふなら","xmin":2320.0,"ymin":1584.0,"xmax":2367.0,"ymax":2150.0},{"id":19,"contenttext":"ば、此の國民は悉く神道者である。","xmin":2242.0,"ymin":689.0,"xmax":2291.0,"ymax":1332.0},{"id":20,"contenttext":"何も神道者といふものが別にあるもの","xmin":2242.0,"ymin":1396.0,"xmax":2291.0,"ymax":2150.0},{"id":21,"contenttext":"でない。","xmin":2173.0,"ymin":692.0,"xmax":2215.0,"ymax":824.0},{"id":22,"contenttext":"此の道を行つて行くなれば國民全體が神主である。","xmin":2168.0,"ymin":874.0,"xmax":2217.0,"ymax":1888.0},{"id":23,"contenttext":"之れが即ち","xmin":2167.0,"ymin":1964.0,"xmax":2219.0,"ymax":2153.0},{"id":24,"contenttext":"左を左とし右を右とするのである。","xmin":1801.0,"ymin":692.0,"xmax":1855.0,"ymax":1382.0},{"id":25,"contenttext":"ちよとこの左左右右とは『神道五部書』","xmin":1802.0,"ymin":1444.0,"xmax":1867.0,"ymax":2159.0},{"id":26,"contenttext":"に書いてあつて、左と右と交換しないやうに、ゴチャ〓〓にしないやうに、正","xmin":1723.0,"ymin":693.0,"xmax":1783.0,"ymax":2152.0},{"id":27,"contenttext":"しくせよと云ふ語であります。","xmin":1654.0,"ymin":693.0,"xmax":1708.0,"ymax":1288.0},{"id":28,"contenttext":"で、かくするのは左を左とし右を右とする","xmin":1654.0,"ymin":1354.0,"xmax":1713.0,"ymax":2150.0},{"id":29,"contenttext":"の道であつて「天御中主尊·天照大神が此の御國を定められてより此の方連","xmin":1577.0,"ymin":695.0,"xmax":1644.0,"ymax":2158.0},{"id":30,"contenttext":"綿と絕えない神道である。","xmin":1504.0,"ymin":694.0,"xmax":1553.0,"ymax":1197.0},{"id":31,"contenttext":"神主が神事を行ふのみを以つて神道であると","xmin":1504.0,"ymin":1256.0,"xmax":1566.0,"ymax":2153.0},{"id":32,"contenttext":"いふからして神道は極めて變てこなものになつて來た。","xmin":1431.0,"ymin":697.0,"xmax":1489.0,"ymax":1799.0},{"id":33,"contenttext":"斯ういふのが度","xmin":1443.0,"ymin":1870.0,"xmax":1493.0,"ymax":2156.0},{"id":34,"contenttext":"會〓在と申す學者の「陽復記衍義』に書いてあるのでございますが、此の外度","xmin":1360.0,"ymin":693.0,"xmax":1427.0,"ymax":2159.0},{"id":35,"contenttext":"會氏の說を能く考へて見ますと、詰り神道は宗〓で、同時に倫理である。","xmin":1283.0,"ymin":693.0,"xmax":1348.0,"ymax":2081.0},{"id":36,"contenttext":"斯","xmin":1296.0,"ymin":2153.0,"xmax":1347.0,"ymax":2158.0},{"id":37,"contenttext":"ういふ風な解釋と思はれますが、併し私は政治に從事して國家の政を行ふ","xmin":1207.0,"ymin":695.0,"xmax":1271.0,"ymax":2152.0},{"id":38,"contenttext":"には勿論道德もなければいかぬ。","xmin":1136.0,"ymin":696.0,"xmax":1189.0,"ymax":1336.0},{"id":39,"contenttext":"政治も道德を離れては政治の價値が無","xmin":1139.0,"ymin":1400.0,"xmax":1197.0,"ymax":2157.0},{"id":40,"contenttext":"い、それで道德と政治は離れることは出來ない。","xmin":1061.0,"ymin":700.0,"xmax":1116.0,"ymax":1612.0},{"id":41,"contenttext":"けれ共私は政治家は政治","xmin":1066.0,"ymin":1682.0,"xmax":1129.0,"ymax":2157.0},{"id":42,"contenttext":"家として別に政治的活動として特殊の活動をなすものとして、人類社會の","xmin":983.0,"ymin":693.0,"xmax":1048.0,"ymax":2154.0},{"id":43,"contenttext":"現象には、宗〓·道徳と相對した政治と云ふものヽ存在を認め、さつきから述","xmin":905.0,"ymin":693.0,"xmax":969.0,"ymax":2157.0},{"id":45,"contenttext":"道","xmin":842.0,"ymin":890.0,"xmax":884.0,"ymax":916.0},{"id":46,"contenttext":"大","xmin":842.0,"ymin":950.0,"xmax":884.0,"ymax":973.0},{"id":47,"contenttext":"意","xmin":846.0,"ymin":1009.0,"xmax":884.0,"ymax":1026.0}]