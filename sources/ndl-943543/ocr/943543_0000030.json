[{"id":1,"contenttext":"下すのであります。","xmin":3120.0,"ymin":659.0,"xmax":3172.0,"ymax":1031.0},{"id":2,"contenttext":"併し斯う云ふ風に〓育勅語を以つて或は儒〓の要旨","xmin":3092.0,"ymin":1075.0,"xmax":3164.0,"ymax":2120.0},{"id":3,"contenttext":"であるとか、佛〓の意味であるとか、或は基督〓の〓を說かれたのであると","xmin":3024.0,"ymin":655.0,"xmax":3106.0,"ymax":2116.0},{"id":4,"contenttext":"か、斯う云ふ樣に勝手な事を云ふのは、我が帝國憲法は、是れは西洋の憲法の","xmin":2949.0,"ymin":653.0,"xmax":3033.0,"ymax":2113.0},{"id":5,"contenttext":"飜譯であると云ふのと同じであるのでありませう。","xmin":2880.0,"ymin":649.0,"xmax":2960.0,"ymax":1667.0},{"id":6,"contenttext":"一體我が帝國憲法が","xmin":2875.0,"ymin":1730.0,"xmax":2935.0,"ymax":2116.0},{"id":7,"contenttext":"西洋の憲法の飜譯物である、同一物であると斯う申すのは日本人も西洋人","xmin":2797.0,"ymin":649.0,"xmax":2883.0,"ymax":2116.0},{"id":8,"contenttext":"も鼻は一つだ、眼は二つ着いて居る。","xmin":2740.0,"ymin":647.0,"xmax":2810.0,"ymax":1342.0},{"id":9,"contenttext":"所が鼻は縱に着いて居る、眼は矢張り","xmin":2724.0,"ymin":1391.0,"xmax":2789.0,"ymax":2110.0},{"id":10,"contenttext":"橫に着いて居る、不思議に日本人も西洋人も同じ事である。","xmin":2659.0,"ymin":643.0,"xmax":2737.0,"ymax":1803.0},{"id":11,"contenttext":"斯う云ふ議論","xmin":2653.0,"ymin":1854.0,"xmax":2706.0,"ymax":2112.0},{"id":12,"contenttext":"と同じ事だと思ふのでございます。","xmin":2596.0,"ymin":643.0,"xmax":2663.0,"ymax":1337.0},{"id":13,"contenttext":"勿論西洋人も日本人も鼻は縱に着い","xmin":2577.0,"ymin":1387.0,"xmax":2643.0,"ymax":2108.0},{"id":14,"contenttext":"て居る。","xmin":2542.0,"ymin":646.0,"xmax":2585.0,"ymax":783.0},{"id":15,"contenttext":"鼻の橫に着いて居る者は見えない。","xmin":2515.0,"ymin":827.0,"xmax":2586.0,"ymax":1524.0},{"id":16,"contenttext":"又眼の縱に着いて居る者は","xmin":2504.0,"ymin":1575.0,"xmax":2565.0,"ymax":2106.0},{"id":17,"contenttext":"無い","xmin":2469.0,"ymin":640.0,"xmax":2516.0,"ymax":719.0},{"id":18,"contenttext":"眼と鼻と比較したら西洋人ばかりではない、支那人も日本人と同一","xmin":2427.0,"ymin":777.0,"xmax":2515.0,"ymax":2096.0},{"id":19,"contenttext":"であると云へませう。","xmin":2380.0,"ymin":639.0,"xmax":2439.0,"ymax":1055.0},{"id":20,"contenttext":"けれども斯くの如く日本人と支那人は同一である。","xmin":2354.0,"ymin":1104.0,"xmax":2427.0,"ymax":2106.0},{"id":21,"contenttext":"日本人と西洋人と同一でありましたならば、明治の二大戰役即ち我が日本","xmin":2277.0,"ymin":636.0,"xmax":2367.0,"ymax":2104.0},{"id":22,"contenttext":"と〓國、我が日本と露國との戰爭に於いて、人口の多い、面積の廣い、國の富ん","xmin":2200.0,"ymin":637.0,"xmax":2294.0,"ymax":2102.0},{"id":23,"contenttext":"だ、兵器の極めて優れて居る、軍隊の數の多い、此の〓國、此の露國が何故に人","xmin":1826.0,"ymin":637.0,"xmax":1903.0,"ymax":2106.0},{"id":24,"contenttext":"口の少ない、面積の狹い、兵隊の數の少ない、金力に乏しい此の日本に負けた","xmin":1753.0,"ymin":637.0,"xmax":1825.0,"ymax":2106.0},{"id":25,"contenttext":"のでありませうか。","xmin":1704.0,"ymin":639.0,"xmax":1753.0,"ymax":1009.0},{"id":26,"contenttext":"同じ鼻が縱に着き眼が橫に着いて居るものならば、即","xmin":1681.0,"ymin":1052.0,"xmax":1747.0,"ymax":2104.0},{"id":27,"contenttext":"ち同一人間であつたならば數學上の法則に從つて數字の多い方が勝たな","xmin":1607.0,"ymin":633.0,"xmax":1684.0,"ymax":2100.0},{"id":28,"contenttext":"ければならぬ譯である。","xmin":1556.0,"ymin":633.0,"xmax":1613.0,"ymax":1100.0},{"id":29,"contenttext":"然るにさう行かないと云ふものは、即ち此の兵器","xmin":1537.0,"ymin":1146.0,"xmax":1603.0,"ymax":2104.0},{"id":30,"contenttext":"或は軍人の數、或は人口、或は面積、さう云ふものゝ外にさう云ふ物とは比較","xmin":1460.0,"ymin":633.0,"xmax":1542.0,"ymax":2104.0},{"id":31,"contenttext":"する事の出來ない一種特別なものがあるからして斯う云ふ結果を生ずる","xmin":1390.0,"ymin":631.0,"xmax":1466.0,"ymax":2097.0},{"id":32,"contenttext":"のであると思ふ。","xmin":1339.0,"ymin":633.0,"xmax":1392.0,"ymax":956.0},{"id":33,"contenttext":"即ち我が固有の大道と云ふものが我が國人の間に行は","xmin":1313.0,"ymin":1003.0,"xmax":1392.0,"ymax":2100.0},{"id":34,"contenttext":"れて居るからして、詰り世界に並びのない所の大道が行はれて居るからし","xmin":1237.0,"ymin":629.0,"xmax":1314.0,"ymax":2098.0},{"id":35,"contenttext":"て斯う云ふ結果を生ずるのである。","xmin":1177.0,"ymin":631.0,"xmax":1242.0,"ymax":1324.0},{"id":36,"contenttext":"如何なる强國と雖も是れに向つては","xmin":1168.0,"ymin":1375.0,"xmax":1225.0,"ymax":2095.0},{"id":37,"contenttext":"辟易せざるを得ないのであります。","xmin":1106.0,"ymin":627.0,"xmax":1169.0,"ymax":1324.0},{"id":38,"contenttext":"〓育勅語は此の大道を示されたもの","xmin":1094.0,"ymin":1375.0,"xmax":1155.0,"ymax":2095.0},{"id":39,"contenttext":"であると私は思ふのであります。","xmin":1036.0,"ymin":629.0,"xmax":1097.0,"ymax":1277.0},{"id":40,"contenttext":"詰り〓育勅語に於いて說かれた意味は","xmin":1020.0,"ymin":1326.0,"xmax":1086.0,"ymax":2095.0},{"id":41,"contenttext":"勿論儒〓に於いても之れに似た所がありませう。","xmin":951.0,"ymin":629.0,"xmax":1021.0,"ymax":1601.0},{"id":42,"contenttext":"父母に孝に兄弟に友に","xmin":945.0,"ymin":1653.0,"xmax":1005.0,"ymax":2096.0},{"id":44,"contenttext":"道","xmin":914.0,"ymin":813.0,"xmax":946.0,"ymax":842.0},{"id":45,"contenttext":"大","xmin":908.0,"ymin":868.0,"xmax":949.0,"ymax":901.0},{"id":46,"contenttext":"意","xmin":911.0,"ymin":929.0,"xmax":945.0,"ymax":953.0}]