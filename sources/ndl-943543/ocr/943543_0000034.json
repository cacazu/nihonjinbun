[{"id":0,"contenttext":"のであると云ふ意味で、殊に此の荷田春滿翁の歌は最も克く神道の本意を","xmin":3051.0,"ymin":683.0,"xmax":3128.0,"ymax":2157.0},{"id":1,"contenttext":"明らかにして居るものである。","xmin":2977.0,"ymin":681.0,"xmax":3036.0,"ymax":1289.0},{"id":2,"contenttext":"斯う云ふ次第で私は〓育勅語は我が國民","xmin":2988.0,"ymin":1325.0,"xmax":3050.0,"ymax":2155.0},{"id":3,"contenttext":"の悉く行はなければならぬ道である。","xmin":2907.0,"ymin":685.0,"xmax":2969.0,"ymax":1431.0},{"id":4,"contenttext":"即ち是れが神の道である。","xmin":2919.0,"ymin":1466.0,"xmax":2975.0,"ymax":1985.0},{"id":5,"contenttext":"我が帝","xmin":2931.0,"ymin":2020.0,"xmax":2976.0,"ymax":2154.0},{"id":6,"contenttext":"國固有の大道である。","xmin":2841.0,"ymin":684.0,"xmax":2894.0,"ymax":1112.0},{"id":7,"contenttext":"と斯う云ふ風に結論したいのであります。","xmin":2846.0,"ymin":1147.0,"xmax":2904.0,"ymax":1987.0},{"id":8,"contenttext":"+","xmin":2722.0,"ymin":1029.0,"xmax":2792.0,"ymax":1095.0},{"id":9,"contenttext":"以上述べて來ました樣な工合で、〓育勅語は即ち神道の要旨を示された","xmin":2616.0,"ymin":732.0,"xmax":2688.0,"ymax":2163.0},{"id":10,"contenttext":"ものである。","xmin":2543.0,"ymin":691.0,"xmax":2597.0,"ymax":929.0},{"id":11,"contenttext":"即ち皇祖皇宗の遺訓を以つて我が國民の守らなければなら","xmin":2548.0,"ymin":963.0,"xmax":2613.0,"ymax":2161.0},{"id":12,"contenttext":"ぬ所の道を示されたものである。","xmin":2465.0,"ymin":691.0,"xmax":2529.0,"ymax":1344.0},{"id":13,"contenttext":"決して〓育勅語に於いては支那の孔子","xmin":2478.0,"ymin":1378.0,"xmax":2539.0,"ymax":2165.0},{"id":14,"contenttext":"の遺訓を守れとか、又是れは孔子の遺訓であるとは〓へられてない。","xmin":2394.0,"ymin":691.0,"xmax":2465.0,"ymax":2038.0},{"id":15,"contenttext":"釋迦","xmin":2416.0,"ymin":2075.0,"xmax":2461.0,"ymax":2164.0},{"id":16,"contenttext":"の遺訓であるとは〓へられてない。","xmin":2327.0,"ymin":696.0,"xmax":2380.0,"ymax":1398.0},{"id":17,"contenttext":"基督の遺訓であるとは〓へられて無","xmin":2335.0,"ymin":1431.0,"xmax":2391.0,"ymax":2165.0},{"id":18,"contenttext":"いのである。","xmin":2251.0,"ymin":697.0,"xmax":2307.0,"ymax":937.0},{"id":19,"contenttext":"勿論吾々が孔子の遺訓釋迦の遺訓を奉じた所で憲法第二十","xmin":2253.0,"ymin":969.0,"xmax":2324.0,"ymax":2167.0},{"id":20,"contenttext":"八條に信〓の自由を許されてありますからして、決して我が法律には觸れ","xmin":2179.0,"ymin":695.0,"xmax":2247.0,"ymax":2165.0},{"id":21,"contenttext":"ないのであります。","xmin":1847.0,"ymin":642.0,"xmax":1900.0,"ymax":1026.0},{"id":22,"contenttext":"けれども我が憲法が之れを許して居るからと云ふて、","xmin":1827.0,"ymin":1059.0,"xmax":1900.0,"ymax":2126.0},{"id":23,"contenttext":"陛下の聖旨に背いて外のものに無中になつて、それで差支へないでありま","xmin":1749.0,"ymin":642.0,"xmax":1828.0,"ymax":2122.0},{"id":24,"contenttext":"せうか。","xmin":1698.0,"ymin":641.0,"xmax":1745.0,"ymax":790.0},{"id":25,"contenttext":"それで我が國民の責務が濟みませうか。","xmin":1684.0,"ymin":826.0,"xmax":1746.0,"ymax":1625.0},{"id":26,"contenttext":"斯う云ふ風な寬大な憲","xmin":1675.0,"ymin":1658.0,"xmax":1731.0,"ymax":2120.0},{"id":27,"contenttext":"法を我が國民に與へられた陛下の聖旨に對して差支へないでありませう","xmin":1608.0,"ymin":640.0,"xmax":1678.0,"ymax":2120.0},{"id":28,"contenttext":"か.","xmin":1557.0,"ymin":643.0,"xmax":1606.0,"ymax":699.0},{"id":29,"contenttext":"此の點は深く考を要すべきであると思ひます。","xmin":1541.0,"ymin":730.0,"xmax":1606.0,"ymax":1668.0},{"id":30,"contenttext":"一體吾が國民には斯","xmin":1532.0,"ymin":1713.0,"xmax":1593.0,"ymax":2120.0},{"id":31,"contenttext":"くの如く立派な帝國の大道が行はれて居るのであります。","xmin":1468.0,"ymin":640.0,"xmax":1535.0,"ymax":1809.0},{"id":32,"contenttext":"吾が固有の大","xmin":1463.0,"ymin":1842.0,"xmax":1517.0,"ymax":2120.0},{"id":33,"contenttext":"道が吾々の祖先からして今日に傳はつて來て居るのであります。","xmin":1389.0,"ymin":638.0,"xmax":1467.0,"ymax":1944.0},{"id":34,"contenttext":"然るに","xmin":1389.0,"ymin":1977.0,"xmax":1440.0,"ymax":2114.0},{"id":35,"contenttext":"です。","xmin":1341.0,"ymin":641.0,"xmax":1386.0,"ymax":742.0},{"id":36,"contenttext":"外國から新に傳はつて來た所の〓に無中になると云ふのは、丁度之","xmin":1312.0,"ymin":775.0,"xmax":1389.0,"ymax":2116.0},{"id":37,"contenttext":"れを例へて見ますると小さい小供が·····小さい二つか三つ位の赤兒に着物","xmin":1242.0,"ymin":636.0,"xmax":1316.0,"ymax":2113.0},{"id":38,"contenttext":"を着せやうと云ふ時に今斜子の黑紋附或は縮緬の黑紋附を着せやうとす","xmin":1168.0,"ymin":636.0,"xmax":1242.0,"ymax":2113.0},{"id":39,"contenttext":"る.","xmin":1128.0,"ymin":641.0,"xmax":1165.0,"ymax":693.0},{"id":40,"contenttext":"所が其の側に唐縮緬の派手な着物があると、小供は其の立派な黑紋附","xmin":1095.0,"ymin":724.0,"xmax":1171.0,"ymax":2116.0},{"id":41,"contenttext":"を棄てゝ派手な唐縮緬を着ると云ふて、何うしても肯かない。","xmin":1028.0,"ymin":634.0,"xmax":1096.0,"ymax":1848.0},{"id":42,"contenttext":"無智なる孩","xmin":1021.0,"ymin":1882.0,"xmax":1076.0,"ymax":2112.0},{"id":43,"contenttext":"提の兒、三歲の童兒、何も知らない、物の道理を辨ずる事の出來ない三歲の童","xmin":950.0,"ymin":632.0,"xmax":1024.0,"ymax":2112.0}]