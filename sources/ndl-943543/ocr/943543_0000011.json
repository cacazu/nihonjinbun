[{"id":1,"contenttext":"で兎に角今日あらびと神などと申しまして今日現存して居る所の人でも","xmin":3041.0,"ymin":665.0,"xmax":3128.0,"ymax":2130.0},{"id":2,"contenttext":"神と云ふ事は出來るのである。","xmin":2975.0,"ymin":665.0,"xmax":3035.0,"ymax":1264.0},{"id":3,"contenttext":"それから過去に於いて吾々の祖先の內今","xmin":2989.0,"ymin":1326.0,"xmax":3052.0,"ymax":2128.0},{"id":4,"contenttext":"云つた樣な特性の內の一つなり二つなり或は悉く持つて居る樣なものを","xmin":2901.0,"ymin":669.0,"xmax":2984.0,"ymax":2132.0},{"id":5,"contenttext":"神と云ふのである。","xmin":2828.0,"ymin":669.0,"xmax":2886.0,"ymax":1043.0},{"id":6,"contenttext":"それであるからして西洋で唯一神と唱へて居るあゝ","xmin":2837.0,"ymin":1095.0,"xmax":2909.0,"ymax":2128.0},{"id":7,"contenttext":"云ふアブストラクトの樣な神でなくして、即ち詩人や哲學者や宗〓家が勝","xmin":2753.0,"ymin":671.0,"xmax":2833.0,"ymax":2134.0},{"id":8,"contenttext":"手に造り出したのでなくして、日本の神は人格を備へて居る所の神である。","xmin":2681.0,"ymin":673.0,"xmax":2759.0,"ymax":2138.0},{"id":9,"contenttext":"餘程西洋とは神の考が違つて居るのであります。","xmin":2604.0,"ymin":673.0,"xmax":2674.0,"ymax":1646.0},{"id":10,"contenttext":"で、斯う云ふ神の行はれ","xmin":2624.0,"ymin":1716.0,"xmax":2688.0,"ymax":2141.0},{"id":11,"contenttext":"た事、云はれた事が道となつて、所謂神の道となるのである。","xmin":2530.0,"ymin":680.0,"xmax":2608.0,"ymax":1834.0},{"id":12,"contenttext":"勿論優勝であ","xmin":2557.0,"ymin":1905.0,"xmax":2610.0,"ymax":2140.0},{"id":13,"contenttext":"る優れて居ると云ふ其の優れ方には程度があります。","xmin":2456.0,"ymin":680.0,"xmax":2525.0,"ymax":1742.0},{"id":14,"contenttext":"デグリーがありま","xmin":2485.0,"ymin":1817.0,"xmax":2528.0,"ymax":2142.0},{"id":15,"contenttext":"す。","xmin":2385.0,"ymin":682.0,"xmax":2432.0,"ymax":729.0},{"id":16,"contenttext":"コンパラチーヴであります。","xmin":2385.0,"ymin":785.0,"xmax":2441.0,"ymax":1325.0},{"id":17,"contenttext":"(神の觀念に就いては拙著『平田篤胤之哲","xmin":2391.0,"ymin":1374.0,"xmax":2463.0,"ymax":2147.0},{"id":18,"contenttext":"學』に詳述せり)","xmin":2307.0,"ymin":682.0,"xmax":2356.0,"ymax":966.0},{"id":19,"contenttext":"四","xmin":2183.0,"ymin":994.0,"xmax":2238.0,"ymax":1028.0},{"id":20,"contenttext":"此の唯〓上と云ふ內にも色々上下がある。","xmin":1850.0,"ymin":712.0,"xmax":1907.0,"ymax":1490.0},{"id":21,"contenttext":"一國の君主もあるし、或は又一","xmin":1846.0,"ymin":1565.0,"xmax":1900.0,"ymax":2112.0},{"id":22,"contenttext":"縣の長官もある。","xmin":1785.0,"ymin":665.0,"xmax":1833.0,"ymax":987.0},{"id":23,"contenttext":"一郡の長もあれば、一市一村の長もある。","xmin":1772.0,"ymin":1048.0,"xmax":1834.0,"ymax":1813.0},{"id":24,"contenttext":"或は又一部落","xmin":1774.0,"ymin":1886.0,"xmax":1828.0,"ymax":2126.0},{"id":25,"contenttext":"の長もある。","xmin":1711.0,"ymin":666.0,"xmax":1759.0,"ymax":889.0},{"id":26,"contenttext":"是れ皆上である。","xmin":1709.0,"ymin":944.0,"xmax":1762.0,"ymax":1259.0},{"id":27,"contenttext":"神である。","xmin":1704.0,"ymin":1319.0,"xmax":1754.0,"ymax":1490.0},{"id":28,"contenttext":"一部落の長でも上であるし一","xmin":1699.0,"ymin":1565.0,"xmax":1751.0,"ymax":2109.0},{"id":29,"contenttext":"軒の家に就いても其の家の主人は上である。","xmin":1629.0,"ymin":663.0,"xmax":1688.0,"ymax":1535.0},{"id":30,"contenttext":"其の又主人の妻は御上さん","xmin":1624.0,"ymin":1603.0,"xmax":1682.0,"ymax":2124.0},{"id":31,"contenttext":"である。","xmin":1568.0,"ymin":666.0,"xmax":1608.0,"ymax":797.0},{"id":32,"contenttext":"お上さんも一つの優れて居る所の神の特性を持つて居る。","xmin":1548.0,"ymin":851.0,"xmax":1613.0,"ymax":1994.0},{"id":33,"contenttext":"唯〓其","xmin":1549.0,"ymin":2061.0,"xmax":1600.0,"ymax":2126.0},{"id":34,"contenttext":"のデグリーが低いのです。","xmin":1484.0,"ymin":663.0,"xmax":1538.0,"ymax":1165.0},{"id":35,"contenttext":"程度が低いのです。","xmin":1484.0,"ymin":1225.0,"xmax":1531.0,"ymax":1582.0},{"id":36,"contenttext":"それであるからしてお上","xmin":1475.0,"ymin":1647.0,"xmax":1528.0,"ymax":2122.0},{"id":37,"contenttext":"さんの言葉、或はお上さんの行つた事は一家の御自分以下の者に影響を及","xmin":1402.0,"ymin":663.0,"xmax":1467.0,"ymax":2122.0},{"id":38,"contenttext":"ぼして行きますけれども、それ以上には中々及ぼさない。","xmin":1332.0,"ymin":659.0,"xmax":1392.0,"ymax":1764.0},{"id":39,"contenttext":"是に反して一國","xmin":1328.0,"ymin":1835.0,"xmax":1380.0,"ymax":2120.0},{"id":40,"contenttext":"の最も豪い者、例へば柿本人麿公とか、和氣の〓魔公、菅原道眞公、楠正成公、德","xmin":1253.0,"ymin":659.0,"xmax":1321.0,"ymax":2122.0},{"id":41,"contenttext":"川家康公だとか云ふ人々になると大變なデグリー、非常な程度の優越なる","xmin":1179.0,"ymin":655.0,"xmax":1247.0,"ymax":2116.0},{"id":42,"contenttext":"地位を持つて居る神である。","xmin":1116.0,"ymin":658.0,"xmax":1174.0,"ymax":1210.0},{"id":43,"contenttext":"かう云ふ神が尊い神であるので、吾々が彼の","xmin":1105.0,"ymin":1270.0,"xmax":1168.0,"ymax":2120.0},{"id":44,"contenttext":"人鷹神社に詣つては人麿公の歌を詠つた樣に、眞のま心の歌を詠つた樣に、","xmin":1030.0,"ymin":655.0,"xmax":1097.0,"ymax":2122.0},{"id":45,"contenttext":"自分もやりたい、あゝ云ふ人になりたいと思ふ。","xmin":961.0,"ymin":657.0,"xmax":1020.0,"ymax":1577.0},{"id":46,"contenttext":"又彼の護王神社へ詣つて","xmin":955.0,"ymin":1641.0,"xmax":1014.0,"ymax":2118.0},{"id":47,"contenttext":"神","xmin":909.0,"ymin":810.0,"xmax":948.0,"ymax":834.0},{"id":48,"contenttext":"道","xmin":911.0,"ymin":864.0,"xmax":948.0,"ymax":887.0},{"id":49,"contenttext":"大","xmin":907.0,"ymin":923.0,"xmax":948.0,"ymax":948.0},{"id":50,"contenttext":"意","xmin":909.0,"ymin":980.0,"xmax":946.0,"ymax":999.0}]