[{"id":1,"contenttext":"も、是れは大江匡房が戯れに云つたので和歌博士が實際あつたのではない。","xmin":3096.0,"ymin":707.0,"xmax":3151.0,"ymax":2168.0},{"id":2,"contenttext":"和學.歌學と云ふものは古へは無いのである。","xmin":3025.0,"ymin":703.0,"xmax":3074.0,"ymax":1576.0},{"id":3,"contenttext":"和學者と云ふ者は何う云ふ","xmin":3025.0,"ymin":1640.0,"xmax":3074.0,"ymax":2160.0},{"id":4,"contenttext":"ものであるかと云ふと、儒者であつて本朝の典故だの言葉だのに達して居","xmin":2949.0,"ymin":705.0,"xmax":3003.0,"ymax":2164.0},{"id":5,"contenttext":"るのが和學者である。","xmin":2876.0,"ymin":705.0,"xmax":2925.0,"ymax":1114.0},{"id":6,"contenttext":"又、歌學者と云ふのは儒者にして歌を作る者である。","xmin":2871.0,"ymin":1170.0,"xmax":2925.0,"ymax":2166.0},{"id":7,"contenttext":"吾が儕ら·····春海自身が云ふのです·····吾が儕ら腐陋と雖も儒者である。","xmin":2794.0,"ymin":701.0,"xmax":2849.0,"ymax":2083.0},{"id":8,"contenttext":"即","xmin":2802.0,"ymin":2159.0,"xmax":2849.0,"ymax":2162.0},{"id":9,"contenttext":"ち儒者にして歌を作つて居るものである。","xmin":2719.0,"ymin":700.0,"xmax":2776.0,"ymax":1529.0},{"id":10,"contenttext":"斯くの如く本朝の制度文物皆","xmin":2720.0,"ymin":1594.0,"xmax":2779.0,"ymax":2167.0},{"id":11,"contenttext":"既に周公孔子の遺法を奉じて居る。","xmin":2643.0,"ymin":702.0,"xmax":2700.0,"ymax":1390.0},{"id":12,"contenttext":"さうして又佛〓を信ずる者が一方に","xmin":2647.0,"ymin":1454.0,"xmax":2701.0,"ymax":2160.0},{"id":13,"contenttext":"多い。","xmin":2577.0,"ymin":699.0,"xmax":2624.0,"ymax":791.0},{"id":14,"contenttext":"一體此の日本に於いては若い時には儒〓を信じ、年を取つては佛〓","xmin":2572.0,"ymin":853.0,"xmax":2628.0,"ymax":2164.0},{"id":15,"contenttext":"を信ずると云ふのが中古以來一般の風習である。","xmin":2500.0,"ymin":701.0,"xmax":2553.0,"ymax":1670.0},{"id":16,"contenttext":"之れに依つて考へて見","xmin":2499.0,"ymin":1734.0,"xmax":2557.0,"ymax":2167.0},{"id":17,"contenttext":"ると云ふと儒にあらざれば即ち佛である。","xmin":2426.0,"ymin":703.0,"xmax":2475.0,"ymax":1527.0},{"id":18,"contenttext":"此の二つの道を除いて道と云","xmin":2424.0,"ymin":1592.0,"xmax":2478.0,"ymax":2164.0},{"id":19,"contenttext":"ふものは無いのである。","xmin":2354.0,"ymin":703.0,"xmax":2401.0,"ymax":1157.0},{"id":20,"contenttext":"此の二つの道を除いて別に道を立てると云ふ事","xmin":2350.0,"ymin":1215.0,"xmax":2405.0,"ymax":2164.0},{"id":21,"contenttext":"は吾れ未だ之れを聽かないのである。","xmin":2279.0,"ymin":701.0,"xmax":2330.0,"ymax":1435.0},{"id":22,"contenttext":"かう云ふのが村田春海の道に對す","xmin":2277.0,"ymin":1500.0,"xmax":2332.0,"ymax":2160.0},{"id":23,"contenttext":"る議論である。","xmin":2211.0,"ymin":705.0,"xmax":2256.0,"ymax":973.0},{"id":24,"contenttext":"彼は眞淵翁門下四天王の一人である。","xmin":2205.0,"ymin":1031.0,"xmax":2254.0,"ymax":1756.0},{"id":25,"contenttext":"さうして其の議論","xmin":2207.0,"ymin":1829.0,"xmax":2256.0,"ymax":2160.0},{"id":26,"contenttext":"は實に斯くの如くであるのです。","xmin":1787.0,"ymin":688.0,"xmax":1843.0,"ymax":1332.0},{"id":27,"contenttext":"詰り村田春海の如きは我が國の大道を","xmin":1796.0,"ymin":1390.0,"xmax":1855.0,"ymax":2148.0},{"id":28,"contenttext":"知るべき地位に在り乍ら徒らに外の方に向つて求めて、內に大道のある事","xmin":1712.0,"ymin":688.0,"xmax":1779.0,"ymax":2150.0},{"id":29,"contenttext":"に氣が附かなかつた人である。","xmin":1637.0,"ymin":688.0,"xmax":1694.0,"ymax":1284.0},{"id":30,"contenttext":"併し獨り是れは春海計りではない。","xmin":1645.0,"ymin":1344.0,"xmax":1703.0,"ymax":2024.0},{"id":31,"contenttext":"昔か","xmin":1655.0,"ymin":2098.0,"xmax":1700.0,"ymax":2148.0},{"id":32,"contenttext":"ら斯う云ふ人が大分あつたのです。","xmin":1568.0,"ymin":688.0,"xmax":1619.0,"ymax":1377.0},{"id":33,"contenttext":"山崎闇齋先生の門下の淺見綱齋とか","xmin":1571.0,"ymin":1440.0,"xmax":1629.0,"ymax":2148.0},{"id":34,"contenttext":"佐藤直方とか云ふ樣な人も矢張山崎闇齋先生が神道を奉じたら去つて仕","xmin":1492.0,"ymin":690.0,"xmax":1560.0,"ymax":2157.0},{"id":35,"contenttext":"舞つたと云ふ事である。","xmin":1420.0,"ymin":690.0,"xmax":1476.0,"ymax":1151.0},{"id":36,"contenttext":"詰り是れなども我が國に固有の大道のあつた事","xmin":1424.0,"ymin":1207.0,"xmax":1482.0,"ymax":2152.0},{"id":37,"contenttext":"を知らなかつた人と云はなければならない。","xmin":1348.0,"ymin":692.0,"xmax":1401.0,"ymax":1566.0},{"id":38,"contenttext":"勿論山崎闇齋先生には多少","xmin":1355.0,"ymin":1634.0,"xmax":1408.0,"ymax":2155.0},{"id":39,"contenttext":"の批難は免れない。","xmin":1275.0,"ymin":695.0,"xmax":1324.0,"ymax":1057.0},{"id":40,"contenttext":"牽强附會な所のないではないけれども、是れは猶克く","xmin":1275.0,"ymin":1115.0,"xmax":1332.0,"ymax":2152.0},{"id":41,"contenttext":"研究すべきである。","xmin":1200.0,"ymin":693.0,"xmax":1249.0,"ymax":1059.0},{"id":42,"contenttext":"然るに彼れ佐藤淺見の輩らは其處に氣が附かないの","xmin":1201.0,"ymin":1115.0,"xmax":1261.0,"ymax":2154.0},{"id":43,"contenttext":"である。","xmin":1128.0,"ymin":696.0,"xmax":1176.0,"ymax":830.0},{"id":44,"contenttext":"徒らに外に向つて道を求めて居るのである。","xmin":1128.0,"ymin":882.0,"xmax":1182.0,"ymax":1754.0},{"id":45,"contenttext":"昔は自分の頭を無","xmin":1131.0,"ymin":1823.0,"xmax":1192.0,"ymax":2159.0},{"id":46,"contenttext":"くして、ハテ頭か無くなつた何處へ行つたらうと大騒をした揚句やう〓〓","xmin":1050.0,"ymin":696.0,"xmax":1109.0,"ymax":2148.0},{"id":47,"contenttext":"頸の上にあつたのに氣が附いたと云ふ狼狽者があつたと云ふ事でありま","xmin":975.0,"ymin":696.0,"xmax":1034.0,"ymax":2156.0},{"id":48,"contenttext":"すが、私は此の譬喻が村田春海一流の人物に最も適切なるものであらうと","xmin":903.0,"ymin":699.0,"xmax":961.0,"ymax":2154.0},{"id":49,"contenttext":"神","xmin":842.0,"ymin":843.0,"xmax":883.0,"ymax":865.0},{"id":50,"contenttext":"道","xmin":842.0,"ymin":895.0,"xmax":885.0,"ymax":920.0},{"id":51,"contenttext":"大","xmin":848.0,"ymin":957.0,"xmax":886.0,"ymax":981.0},{"id":52,"contenttext":"意","xmin":846.0,"ymin":1009.0,"xmax":887.0,"ymax":1032.0}]