[{"id":1,"contenttext":"のだ。","xmin":3051.0,"ymin":613.0,"xmax":3106.0,"ymax":707.0},{"id":2,"contenttext":"腹の方を撫でた者は大變ゴツ〓〓塗り方の下手な壁のやうなもの","xmin":3051.0,"ymin":752.0,"xmax":3122.0,"ymax":2079.0},{"id":3,"contenttext":"だ.","xmin":2980.0,"ymin":613.0,"xmax":3030.0,"ymax":660.0},{"id":4,"contenttext":"と斯ういふ風な解釋をするのであります。","xmin":2978.0,"ymin":708.0,"xmax":3037.0,"ymax":1535.0},{"id":5,"contenttext":"どうも前にも述べた學者","xmin":2988.0,"ymin":1607.0,"xmax":3044.0,"ymax":2081.0},{"id":6,"contenttext":"の說は之れに類似した說ではないかと思はれます。","xmin":2903.0,"ymin":616.0,"xmax":2968.0,"ymax":1631.0},{"id":7,"contenttext":"神道と申すものは儒","xmin":2916.0,"ymin":1695.0,"xmax":2973.0,"ymax":2083.0},{"id":8,"contenttext":"道、佛道その他道と云ふものゝ中で範圍の極めて大きいものであります〓〓","xmin":2830.0,"ymin":614.0,"xmax":2897.0,"ymax":2065.0},{"id":9,"contenttext":"平田篤胤翁が『古道大意』で何の學問がイツチ大きいぞと云ふにチト自分","xmin":2761.0,"ymin":617.0,"xmax":2825.0,"ymax":2083.0},{"id":10,"contenttext":"勝手のやうなれども、御國即ち我が國の學問程大きなものはないでござる","xmin":2683.0,"ymin":616.0,"xmax":2753.0,"ymax":2083.0},{"id":11,"contenttext":"と申され、又『入學問答』といふ本に皇國の學問程高大なるものは無しと言","xmin":2610.0,"ymin":619.0,"xmax":2676.0,"ymax":2085.0},{"id":12,"contenttext":"はれて居ります。","xmin":2535.0,"ymin":619.0,"xmax":2587.0,"ymax":937.0},{"id":13,"contenttext":"其の通りで神道は範圍の大きなもので中々百千萬の象","xmin":2537.0,"ymin":996.0,"xmax":2607.0,"ymax":2087.0},{"id":14,"contenttext":"どころではありません。","xmin":2461.0,"ymin":621.0,"xmax":2511.0,"ymax":1077.0},{"id":15,"contenttext":"で、たとひ一代の大學者でも、時勢、境遇或は時代の","xmin":2464.0,"ymin":1138.0,"xmax":2530.0,"ymax":2085.0},{"id":16,"contenttext":"知識の程度と云ふものを脫することは出來ません。","xmin":2381.0,"ymin":620.0,"xmax":2446.0,"ymax":1633.0},{"id":17,"contenttext":"如何に大學者でも時","xmin":2397.0,"ymin":1706.0,"xmax":2449.0,"ymax":2087.0},{"id":18,"contenttext":"代の知識より抜け出ることは出來ません。","xmin":2305.0,"ymin":621.0,"xmax":2367.0,"ymax":1449.0},{"id":19,"contenttext":"時代の最高の知識を集めた人","xmin":2313.0,"ymin":1515.0,"xmax":2377.0,"ymax":2087.0},{"id":20,"contenttext":"がその時代の大學者で、それより以上に飛出すことは出來ません。","xmin":2230.0,"ymin":621.0,"xmax":2296.0,"ymax":1912.0},{"id":21,"contenttext":"かうい","xmin":2252.0,"ymin":1994.0,"xmax":2295.0,"ymax":2083.0},{"id":22,"contenttext":"ふ時勢、境遇、時代の知識と云ふ雲が掛つて居るものですから、たとひ大學者","xmin":2157.0,"ymin":625.0,"xmax":2225.0,"ymax":2087.0},{"id":23,"contenttext":"でもかくも廣大なる神道はすつかり見ることが出來ないのであります。","xmin":1794.0,"ymin":647.0,"xmax":1877.0,"ymax":2077.0},{"id":24,"contenttext":"所が今日は大正の大御世になりまして文物藥然として發達して來ました","xmin":1718.0,"ymin":645.0,"xmax":1806.0,"ymax":2112.0},{"id":25,"contenttext":"ものですから、時勢、境遇も急速に變化し、時代の知識の程度も非常に進んで","xmin":1648.0,"ymin":649.0,"xmax":1739.0,"ymax":2112.0},{"id":26,"contenttext":"來て參りました。","xmin":1570.0,"ymin":651.0,"xmax":1633.0,"ymax":971.0},{"id":27,"contenttext":"昔の北畠親房·一條兼良山崎〓齋·本居宣長等の大先生だ","xmin":1582.0,"ymin":1027.0,"xmax":1664.0,"ymax":2118.0},{"id":28,"contenttext":"ちの時代とは大變知識の程度が進んで參りました。","xmin":1496.0,"ymin":653.0,"xmax":1578.0,"ymax":1673.0},{"id":29,"contenttext":"普通の人でも其の當","xmin":1523.0,"ymin":1738.0,"xmax":1587.0,"ymax":2121.0},{"id":30,"contenttext":"時の豪らい人位の知識は持つて居ると云ふやうに今日は大變知識の程度","xmin":1419.0,"ymin":655.0,"xmax":1515.0,"ymax":2125.0},{"id":31,"contenttext":"が發達して來ました。","xmin":1346.0,"ymin":657.0,"xmax":1411.0,"ymax":1074.0},{"id":32,"contenttext":"斯ういふ發達して來た所の知識、之れを基礎として","xmin":1359.0,"ymin":1127.0,"xmax":1440.0,"ymax":2124.0},{"id":33,"contenttext":"研究して見ますならば、比較的正確な判斷を得られます。","xmin":1275.0,"ymin":659.0,"xmax":1355.0,"ymax":1767.0},{"id":34,"contenttext":"さう云ふ判斷で","xmin":1304.0,"ymin":1841.0,"xmax":1363.0,"ymax":2125.0},{"id":35,"contenttext":"見ますと神道は政治である、道德である、宗〓であるなどいふ風な一の見解","xmin":1202.0,"ymin":661.0,"xmax":1293.0,"ymax":2128.0},{"id":36,"contenttext":"を與へるのは前世紀の議論と言つて宜からうと思ふのでございます。","xmin":1125.0,"ymin":664.0,"xmax":1217.0,"ymax":2045.0},{"id":37,"contenttext":"六","xmin":1010.0,"ymin":993.0,"xmax":1079.0,"ymax":1036.0},{"id":38,"contenttext":"抑も此の神道の典據は何處にあるかと考へて見ますると神道の典據は","xmin":904.0,"ymin":718.0,"xmax":991.0,"ymax":2133.0},{"id":39,"contenttext":"神","xmin":850.0,"ymin":815.0,"xmax":889.0,"ymax":836.0},{"id":40,"contenttext":"道","xmin":850.0,"ymin":865.0,"xmax":891.0,"ymax":891.0},{"id":41,"contenttext":"大","xmin":854.0,"ymin":927.0,"xmax":891.0,"ymax":954.0},{"id":42,"contenttext":"意","xmin":856.0,"ymin":985.0,"xmax":893.0,"ymax":1003.0}]