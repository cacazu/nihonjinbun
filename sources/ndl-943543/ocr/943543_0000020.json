[{"id":1,"contenttext":"に書いてあります。","xmin":3043.0,"ymin":639.0,"xmax":3090.0,"ymax":1005.0},{"id":2,"contenttext":"此の考も矢張り今日から申せば倫理であります。","xmin":3039.0,"ymin":1062.0,"xmax":3090.0,"ymax":2022.0},{"id":3,"contenttext":"勿","xmin":3043.0,"ymin":2098.0,"xmax":3090.0,"ymax":2107.0},{"id":4,"contenttext":"論山崎先生や、平田翁の說には宗〓的方面も少くないのでありますが、その","xmin":2961.0,"ymin":637.0,"xmax":3017.0,"ymax":2105.0},{"id":5,"contenttext":"主とする所は倫理であります。","xmin":2888.0,"ymin":639.0,"xmax":2939.0,"ymax":1239.0},{"id":6,"contenttext":"德〓であります。","xmin":2888.0,"ymin":1301.0,"xmax":2939.0,"ymax":1610.0},{"id":7,"contenttext":"今日の學者にも國學神","xmin":2890.0,"ymin":1677.0,"xmax":2938.0,"ymax":2105.0},{"id":8,"contenttext":"道を研究する人には神道は宗〓では決してない、神道は倫理である、道德で","xmin":2816.0,"ymin":637.0,"xmax":2865.0,"ymax":2105.0},{"id":9,"contenttext":"あるといふ說が大變行はれて居ります。","xmin":2743.0,"ymin":639.0,"xmax":2796.0,"ymax":1424.0},{"id":10,"contenttext":"其の說はどういふのだと申しま","xmin":2743.0,"ymin":1489.0,"xmax":2794.0,"ymax":2107.0},{"id":11,"contenttext":"すと、神道に說く所は人と人との關係に限られて居る。","xmin":2667.0,"ymin":639.0,"xmax":2721.0,"ymax":1705.0},{"id":12,"contenttext":"元來宗〓は人と神","xmin":2667.0,"ymin":1772.0,"xmax":2720.0,"ymax":2109.0},{"id":13,"contenttext":"との關係より成立し、倫理は人と人との關係より成立するものである。","xmin":2594.0,"ymin":641.0,"xmax":2648.0,"ymax":2028.0},{"id":14,"contenttext":"神","xmin":2596.0,"ymin":2102.0,"xmax":2644.0,"ymax":2109.0},{"id":15,"contenttext":"道は全く人と人との關係を說くのであつて、神道で神といふのは決して吾","xmin":2521.0,"ymin":639.0,"xmax":2575.0,"ymax":2107.0},{"id":16,"contenttext":"々の頭の上に入らせられる神でない。","xmin":2448.0,"ymin":641.0,"xmax":2502.0,"ymax":1382.0},{"id":17,"contenttext":"即ち神といふのは高い所にましま","xmin":2446.0,"ymin":1443.0,"xmax":2500.0,"ymax":2107.0},{"id":18,"contenttext":"す神でない。","xmin":2375.0,"ymin":639.0,"xmax":2424.0,"ymax":869.0},{"id":19,"contenttext":"唯々純粹なる上たる人で、神樣を拜むと云ふも全く倫理的崇","xmin":2370.0,"ymin":922.0,"xmax":2426.0,"ymax":2105.0},{"id":20,"contenttext":"拜である。","xmin":2305.0,"ymin":639.0,"xmax":2352.0,"ymax":824.0},{"id":21,"contenttext":"決して宗〓的の崇拜でない。","xmin":2300.0,"ymin":872.0,"xmax":2355.0,"ymax":1423.0},{"id":22,"contenttext":"斯ういふ解釋であります。","xmin":2300.0,"ymin":1489.0,"xmax":2350.0,"ymax":1981.0},{"id":23,"contenttext":"であ","xmin":2305.0,"ymin":2060.0,"xmax":2346.0,"ymax":2105.0},{"id":24,"contenttext":"りますけれども吾々が菅原道眞といふ一個の歷史的人物に對して倫理的","xmin":2220.0,"ymin":639.0,"xmax":2285.0,"ymax":2107.0},{"id":25,"contenttext":"態度で感謝の意を表し、倫理的御辭儀をするのと、天滿天神として、天滿宮と","xmin":2146.0,"ymin":641.0,"xmax":2206.0,"ymax":2103.0},{"id":26,"contenttext":"して崇拜するのと、其の間が同一でありませうか。","xmin":1835.0,"ymin":649.0,"xmax":1892.0,"ymax":1617.0},{"id":27,"contenttext":"是れは智者を俟たない","xmin":1833.0,"ymin":1685.0,"xmax":1884.0,"ymax":2111.0},{"id":28,"contenttext":"で分ることであります。","xmin":1767.0,"ymin":652.0,"xmax":1816.0,"ymax":1108.0},{"id":29,"contenttext":"さうです、決して同一でないです。","xmin":1757.0,"ymin":1168.0,"xmax":1810.0,"ymax":1801.0},{"id":30,"contenttext":"で、神道は倫理","xmin":1756.0,"ymin":1872.0,"xmax":1807.0,"ymax":2113.0},{"id":31,"contenttext":"であるといふ考は少しく誤つて居る考であらうと思はれます。","xmin":1682.0,"ymin":649.0,"xmax":1740.0,"ymax":1891.0},{"id":32,"contenttext":"五","xmin":1572.0,"ymin":979.0,"xmax":1638.0,"ymax":1022.0},{"id":33,"contenttext":"それで以上述べて來ましたやうな見解で神道の性質を示し、神道の性質","xmin":1453.0,"ymin":691.0,"xmax":1523.0,"ymax":2112.0},{"id":34,"contenttext":"は斯の如きものであるといふのは、たとひ幾多の眞理を含んで居りまして","xmin":1374.0,"ymin":643.0,"xmax":1444.0,"ymax":2106.0},{"id":35,"contenttext":"も、偏見たるは免れません。、て、私は若し人があつて徹頭徹尾神道は宗〓で","xmin":1302.0,"ymin":641.0,"xmax":1382.0,"ymax":2106.0},{"id":36,"contenttext":"ある、神道は倫理である、神道は政治である斯う申したならばどうしても是","xmin":1229.0,"ymin":641.0,"xmax":1293.0,"ymax":2105.0},{"id":37,"contenttext":"れは偏見と言はなければならないのであります。＼彼の象であります。","xmin":1155.0,"ymin":639.0,"xmax":1219.0,"ymax":2026.0},{"id":38,"contenttext":"象","xmin":1157.0,"ymin":2100.0,"xmax":1204.0,"ymax":2107.0},{"id":39,"contenttext":"とは少し變な例で御座いますが昔から能く申す例で申しますが、盲目の者","xmin":1084.0,"ymin":639.0,"xmax":1146.0,"ymax":2103.0},{"id":40,"contenttext":"が集つて象はどういふものであるかといふて撫でる。","xmin":1009.0,"ymin":637.0,"xmax":1075.0,"ymax":1699.0},{"id":41,"contenttext":"足の方を撫でた者","xmin":1011.0,"ymin":1770.0,"xmax":1068.0,"ymax":2105.0},{"id":42,"contenttext":"は象は臼見たやうなものだ。","xmin":943.0,"ymin":637.0,"xmax":998.0,"ymax":1186.0},{"id":43,"contenttext":"鼻を撫でた者は大變大きな蛇見たやうなも","xmin":938.0,"ymin":1247.0,"xmax":993.0,"ymax":2103.0},{"id":44,"contenttext":"神","xmin":879.0,"ymin":778.0,"xmax":920.0,"ymax":805.0},{"id":45,"contenttext":"道","xmin":876.0,"ymin":835.0,"xmax":919.0,"ymax":862.0},{"id":46,"contenttext":"大","xmin":879.0,"ymin":891.0,"xmax":920.0,"ymax":918.0},{"id":47,"contenttext":"意","xmin":879.0,"ymin":951.0,"xmax":918.0,"ymax":971.0}]