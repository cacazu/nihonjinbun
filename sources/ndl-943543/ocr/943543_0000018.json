[{"id":1,"contenttext":"に天下を安ぜん。","xmin":3069.0,"ymin":661.0,"xmax":3133.0,"ymax":992.0},{"id":2,"contenttext":"亦可いではないかと云ふ御詔勅を下された。","xmin":3044.0,"ymin":1034.0,"xmax":3120.0,"ymax":1922.0},{"id":3,"contenttext":"次の代の","xmin":3038.0,"ymin":1974.0,"xmax":3095.0,"ymax":2141.0},{"id":4,"contenttext":"垂仁天皇も先帝を御稱賛遊ばして克く神祇を崇奉されて仁政を布かれた。","xmin":2966.0,"ymin":658.0,"xmax":3056.0,"ymax":2149.0},{"id":5,"contenttext":"茲を以つて人民富み榮え天下太平であつた。","xmin":2906.0,"ymin":654.0,"xmax":2985.0,"ymax":1546.0},{"id":6,"contenttext":"けれども今朕の世に當つて","xmin":2895.0,"ymin":1597.0,"xmax":2959.0,"ymax":2135.0},{"id":7,"contenttext":"神祇を祭祀することに懈る事が在ては濟まないと云ふ事を詔勅の中に宣","xmin":2821.0,"ymin":650.0,"xmax":2910.0,"ymax":2141.0},{"id":8,"contenttext":"はせられたのである。","xmin":2777.0,"ymin":650.0,"xmax":2834.0,"ymax":1074.0},{"id":9,"contenttext":"又文武天皇は、あきらけききよきなほきまことの心","xmin":2752.0,"ymin":1123.0,"xmax":2826.0,"ymax":2133.0},{"id":10,"contenttext":"を以ていやすゝみにすゝみてたゆみおこたる事なくつとめしまりてつか","xmin":2678.0,"ymin":646.0,"xmax":2763.0,"ymax":2126.0},{"id":11,"contenttext":"へまつれ、と云ふ事を百僚有司に對して勅せられたのである。","xmin":2614.0,"ymin":654.0,"xmax":2692.0,"ymax":1862.0},{"id":12,"contenttext":"斯う云ふ事","xmin":2605.0,"ymin":1913.0,"xmax":2660.0,"ymax":2126.0},{"id":13,"contenttext":"は御歷代に擧げ來つて實に遑の無い程澤山あるのでございます。","xmin":2535.0,"ymin":644.0,"xmax":2619.0,"ymax":1957.0},{"id":14,"contenttext":"斯う云","xmin":2529.0,"ymin":2004.0,"xmax":2586.0,"ymax":2125.0},{"id":15,"contenttext":"ふ所が即ち神道其の者を示されたのであります。","xmin":2465.0,"ymin":644.0,"xmax":2547.0,"ymax":1636.0},{"id":16,"contenttext":"斯う云ふ神道は古來或","xmin":2452.0,"ymin":1673.0,"xmax":2519.0,"ymax":2125.0},{"id":17,"contenttext":"は政道であるとか、或は宗〓であるとか、或は道德であるとか、色々に解釋せ","xmin":2382.0,"ymin":642.0,"xmax":2471.0,"ymax":2118.0},{"id":18,"contenttext":"られたのであります。","xmin":2344.0,"ymin":640.0,"xmax":2398.0,"ymax":1059.0},{"id":19,"contenttext":"神道を政道と解されました學者は、北畠親房卿及本","xmin":2313.0,"ymin":1106.0,"xmax":2390.0,"ymax":2120.0},{"id":20,"contenttext":"居宣長翁であります。","xmin":2269.0,"ymin":635.0,"xmax":2332.0,"ymax":1062.0},{"id":21,"contenttext":"親房卿は『神皇實錄』、『神皇系圖」天口事書』など申す","xmin":2240.0,"ymin":1106.0,"xmax":2320.0,"ymax":2118.0},{"id":22,"contenttext":"所謂三部の書などの說を承けまして天照大神が八坂瓊の匈玉の如くにた","xmin":2168.0,"ymin":635.0,"xmax":2260.0,"ymax":2114.0},{"id":23,"contenttext":"へに天の下治しめせ、白銅鏡の如くに分明に山川海原をみそなはせ、この靈","xmin":1819.0,"ymin":634.0,"xmax":1891.0,"ymax":2101.0},{"id":24,"contenttext":"劔をとりひさげて、天の下むけたまへと云ふ三句の要道を示されたとして、","xmin":1747.0,"ymin":626.0,"xmax":1822.0,"ymax":2102.0},{"id":25,"contenttext":"神道には色々複雜な言も事もあるが、外のものは皆枝葉である。","xmin":1679.0,"ymin":624.0,"xmax":1747.0,"ymax":1879.0},{"id":26,"contenttext":"根本は此","xmin":1675.0,"ymin":1933.0,"xmax":1731.0,"ymax":2102.0},{"id":27,"contenttext":"の三句に基いて天皇の天下を治め給ふ政治の道である。","xmin":1610.0,"ymin":626.0,"xmax":1681.0,"ymax":1742.0},{"id":28,"contenttext":"だから此の政治","xmin":1605.0,"ymin":1792.0,"xmax":1660.0,"ymax":2101.0},{"id":29,"contenttext":"の道が即ち神道である。","xmin":1549.0,"ymin":626.0,"xmax":1606.0,"ymax":1090.0},{"id":30,"contenttext":"斯ういふ風の解釋でございます。","xmin":1535.0,"ymin":1136.0,"xmax":1597.0,"ymax":1788.0},{"id":31,"contenttext":"それから本居","xmin":1527.0,"ymin":1836.0,"xmax":1591.0,"ymax":2100.0},{"id":32,"contenttext":"翁の考はどうでかるかと申しますと、親房卿と立脚地が違つて居ります。","xmin":1455.0,"ymin":622.0,"xmax":1532.0,"ymax":2061.0},{"id":33,"contenttext":"けれども其の結論は同じであります。","xmin":1394.0,"ymin":619.0,"xmax":1460.0,"ymax":1366.0},{"id":34,"contenttext":"道を行ふことは君とある人の勤め","xmin":1385.0,"ymin":1413.0,"xmax":1445.0,"ymax":2095.0},{"id":35,"contenttext":"である、物を學ぶ者の業にはあらずと。","xmin":1327.0,"ymin":622.0,"xmax":1386.0,"ymax":1366.0},{"id":36,"contenttext":"斯ういふのが本居翁の說で、道を行","xmin":1310.0,"ymin":1411.0,"xmax":1376.0,"ymax":2096.0},{"id":37,"contenttext":"ふのは國家の君主たる方の勤めである、物を學ぶ學者杯が行ふものでない","xmin":1236.0,"ymin":621.0,"xmax":1317.0,"ymax":2087.0},{"id":38,"contenttext":"と明かに神道といふものを政治道に解釋せられて居ります。","xmin":1163.0,"ymin":619.0,"xmax":1240.0,"ymax":1832.0},{"id":39,"contenttext":"それから其の次にどういふ考があるかといふと、神道は宗〓である、","xmin":1087.0,"ymin":663.0,"xmax":1164.0,"ymax":2011.0},{"id":40,"contenttext":"斯","xmin":1089.0,"ymin":2066.0,"xmax":1138.0,"ymax":2095.0},{"id":41,"contenttext":"ういふ風に考へるのでございます。","xmin":1031.0,"ymin":618.0,"xmax":1091.0,"ymax":1315.0},{"id":42,"contenttext":"是れは先づ古い考でございまして、御","xmin":1015.0,"ymin":1362.0,"xmax":1080.0,"ymax":2091.0},{"id":43,"contenttext":"承知の如く、『日本書紀』に用明天皇の下に、天皇佛法を信じ神道を尊ぶとあ","xmin":936.0,"ymin":613.0,"xmax":1019.0,"ymax":2089.0},{"id":44,"contenttext":"神","xmin":903.0,"ymin":764.0,"xmax":944.0,"ymax":799.0}]