[{"id":0,"contenttext":"六","xmin":3135.0,"ymin":1928.0,"xmax":3170.0,"ymax":1966.0},{"id":1,"contenttext":"を信ぜるに徵するに、","xmin":3051.0,"ymin":659.0,"xmax":3098.0,"ymax":1093.0},{"id":2,"contenttext":"兩部神道の行はれたるの當時己に久しかりしを明","xmin":3052.0,"ymin":1125.0,"xmax":3106.0,"ymax":2138.0},{"id":3,"contenttext":"に認め得べし。","xmin":2978.0,"ymin":661.0,"xmax":3027.0,"ymax":951.0},{"id":4,"contenttext":"此の神道は、","xmin":2978.0,"ymin":984.0,"xmax":3030.0,"ymax":1232.0},{"id":5,"contenttext":"山王神道が、","xmin":2980.0,"ymin":1263.0,"xmax":3036.0,"ymax":1511.0},{"id":6,"contenttext":"天台〓理に基けると同じく、","xmin":2981.0,"ymin":1540.0,"xmax":3034.0,"ymax":2109.0},{"id":7,"contenttext":"全く眞言〓理に基けるもの也。","xmin":2903.0,"ymin":661.0,"xmax":2955.0,"ymax":1278.0},{"id":8,"contenttext":"即ち伊弉諾·伊弉冉二神を金剛界·胎藏界に","xmin":2908.0,"ymin":1309.0,"xmax":2964.0,"ymax":2140.0},{"id":9,"contenttext":"比し、","xmin":2835.0,"ymin":661.0,"xmax":2880.0,"ymax":766.0},{"id":10,"contenttext":"或は內宮を胎藏界外宮を金剛界とするが如くにしてその神道說を","xmin":2831.0,"ymin":800.0,"xmax":2890.0,"ymax":2140.0},{"id":11,"contenttext":"組織せるもの也。","xmin":2759.0,"ymin":661.0,"xmax":2806.0,"ymax":998.0},{"id":12,"contenttext":"以上述べ來りたるが如くにして、","xmin":2677.0,"ymin":708.0,"xmax":2734.0,"ymax":1372.0},{"id":13,"contenttext":"山王神道及び兩部神道は天下を風靡","xmin":2683.0,"ymin":1401.0,"xmax":2742.0,"ymax":2142.0},{"id":14,"contenttext":"せしも、","xmin":2608.0,"ymin":663.0,"xmax":2649.0,"ymax":815.0},{"id":15,"contenttext":"而かも我が國民的精神の熱烈なるもの、","xmin":2606.0,"ymin":847.0,"xmax":2661.0,"ymax":1650.0},{"id":16,"contenttext":"殊に發展的膨脹的性格","xmin":2614.0,"ymin":1683.0,"xmax":2661.0,"ymax":2142.0},{"id":17,"contenttext":"に富めるものは、","xmin":2534.0,"ymin":665.0,"xmax":2581.0,"ymax":1000.0},{"id":18,"contenttext":"かゝる神道を以つては、","xmin":2534.0,"ymin":1033.0,"xmax":2589.0,"ymax":1511.0},{"id":19,"contenttext":"到底自己の精神の要求を滿足","xmin":2538.0,"ymin":1542.0,"xmax":2590.0,"ymax":2140.0},{"id":20,"contenttext":"する能はざる也。","xmin":2461.0,"ymin":661.0,"xmax":2511.0,"ymax":1000.0},{"id":21,"contenttext":"かの唯一神道が、","xmin":2462.0,"ymin":1033.0,"xmax":2517.0,"ymax":1372.0},{"id":22,"contenttext":"吾が神道は一陰一陽不測の元、","xmin":2466.0,"ymin":1401.0,"xmax":2519.0,"ymax":2019.0},{"id":23,"contenttext":"國常","xmin":2471.0,"ymin":2047.0,"xmax":2521.0,"ymax":2141.0},{"id":24,"contenttext":"立尊以降天照大神に至る玄々妙々の相承也。","xmin":2384.0,"ymin":661.0,"xmax":2444.0,"ymax":1560.0},{"id":25,"contenttext":"天照大神天兒屋命に〓へ給","xmin":2393.0,"ymin":1589.0,"xmax":2446.0,"ymax":2144.0},{"id":26,"contenttext":"sho","xmin":2318.0,"ymin":667.0,"xmax":2356.0,"ymax":723.0},{"id":27,"contenttext":"爾してより以來、","xmin":2310.0,"ymin":755.0,"xmax":2363.0,"ymax":1092.0},{"id":28,"contenttext":"濁世末代の今日に至るまで、","xmin":2314.0,"ymin":1123.0,"xmax":2368.0,"ymax":1697.0},{"id":29,"contenttext":"一氣の元水を汲んで、","xmin":2320.0,"ymin":1736.0,"xmax":2369.0,"ymax":2146.0},{"id":30,"contenttext":"遂に三〓の一滴を甞めずと呼號し、","xmin":2240.0,"ymin":661.0,"xmax":2292.0,"ymax":1373.0},{"id":31,"contenttext":"我が固有の神道を高尙なる哲學思想","xmin":2244.0,"ymin":1405.0,"xmax":2298.0,"ymax":2142.0},{"id":32,"contenttext":"を以つて莊嚴せんとして起れる、","xmin":2168.0,"ymin":661.0,"xmax":2222.0,"ymax":1325.0},{"id":33,"contenttext":"實に能くその消息を漏せるものと謂ふ","xmin":2173.0,"ymin":1356.0,"xmax":2225.0,"ymax":2138.0},{"id":34,"contenttext":"唯一神道","xmin":2691.0,"ymin":460.0,"xmax":2734.0,"ymax":585.0},{"id":35,"contenttext":"んじん","xmin":1795.0,"ymin":678.0,"xmax":1839.0,"ymax":779.0},{"id":36,"contenttext":"されど爾かく呼號の大なるにも係らず、","xmin":1784.0,"ymin":808.0,"xmax":1843.0,"ymax":1609.0},{"id":37,"contenttext":"その構成せられたる神道","xmin":1784.0,"ymin":1640.0,"xmax":1833.0,"ymax":2146.0},{"id":38,"contenttext":"は、","xmin":1721.0,"ymin":669.0,"xmax":1768.0,"ymax":732.0},{"id":39,"contenttext":"三〓を嘗むること尠からず。","xmin":1713.0,"ymin":761.0,"xmax":1769.0,"ymax":1331.0},{"id":40,"contenttext":"試にその神道の名を見よ、","xmin":1707.0,"ymin":1358.0,"xmax":1762.0,"ymax":1883.0},{"id":41,"contenttext":"唯一と云ふ","xmin":1709.0,"ymin":1916.0,"xmax":1755.0,"ymax":2142.0},{"id":42,"contenttext":"にあらずや。","xmin":1647.0,"ymin":669.0,"xmax":1692.0,"ymax":914.0},{"id":43,"contenttext":"唯一の語は、","xmin":1641.0,"ymin":945.0,"xmax":1689.0,"ymax":1192.0},{"id":44,"contenttext":"『孝德天皇紀』","xmin":1639.0,"ymin":1195.0,"xmax":1692.0,"ymax":1474.0},{"id":45,"contenttext":"には、","xmin":1639.0,"ymin":1499.0,"xmax":1684.0,"ymax":1606.0},{"id":46,"contenttext":"帝道唯一の語ありと雖も、","xmin":1632.0,"ymin":1636.0,"xmax":1687.0,"ymax":2148.0},{"id":47,"contenttext":"而かも世の學者は、","xmin":1572.0,"ymin":667.0,"xmax":1621.0,"ymax":1053.0},{"id":48,"contenttext":"一般に、","xmin":1572.0,"ymin":1094.0,"xmax":1617.0,"ymax":1239.0},{"id":49,"contenttext":"『法華經』","xmin":1566.0,"ymin":1241.0,"xmax":1620.0,"ymax":1429.0},{"id":50,"contenttext":"に、","xmin":1570.0,"ymin":1454.0,"xmax":1608.0,"ymax":1514.0},{"id":51,"contenttext":"「唯有一乘法、","xmin":1563.0,"ymin":1532.0,"xmax":1613.0,"ymax":1792.0},{"id":52,"contenttext":"無二亦無三」と云","xmin":1561.0,"ymin":1822.0,"xmax":1610.0,"ymax":2144.0},{"id":53,"contenttext":"ひ、『賓積經』","xmin":1493.0,"ymin":669.0,"xmax":1548.0,"ymax":918.0},{"id":54,"contenttext":"に、","xmin":1498.0,"ymin":947.0,"xmax":1539.0,"ymax":1006.0},{"id":55,"contenttext":"「一切諸佛、","xmin":1490.0,"ymin":1017.0,"xmax":1547.0,"ymax":1238.0},{"id":56,"contenttext":"唯是一佛、","xmin":1490.0,"ymin":1268.0,"xmax":1541.0,"ymax":1467.0},{"id":57,"contenttext":"說無量佛、","xmin":1488.0,"ymin":1499.0,"xmax":1539.0,"ymax":1700.0},{"id":58,"contenttext":"是名神變、","xmin":1486.0,"ymin":1728.0,"xmax":1537.0,"ymax":1931.0},{"id":59,"contenttext":"一切佛土、","xmin":1486.0,"ymin":1967.0,"xmax":1535.0,"ymax":2152.0},{"id":60,"contenttext":"唯一佛土、","xmin":1424.0,"ymin":667.0,"xmax":1474.0,"ymax":869.0},{"id":61,"contenttext":"說無量土、","xmin":1422.0,"ymin":896.0,"xmax":1474.0,"ymax":1097.0},{"id":62,"contenttext":"是名神變」と云へるが如きに基くものとす。","xmin":1409.0,"ymin":1129.0,"xmax":1468.0,"ymax":1975.0},{"id":63,"contenttext":"蓋し事","xmin":1409.0,"ymin":2005.0,"xmax":1460.0,"ymax":2143.0},{"id":64,"contenttext":"實なるべし。","xmin":1355.0,"ymin":665.0,"xmax":1403.0,"ymax":914.0},{"id":65,"contenttext":"以つて唯一の語の佛〓に基けるものなるを知るべし。","xmin":1336.0,"ymin":943.0,"xmax":1400.0,"ymax":2023.0},{"id":66,"contenttext":"更に","xmin":1339.0,"ymin":2051.0,"xmax":1390.0,"ymax":2142.0},{"id":67,"contenttext":"この唯一神道の內容を見るに、","xmin":1275.0,"ymin":667.0,"xmax":1331.0,"ymax":1280.0},{"id":68,"contenttext":"「吾が神道は、","xmin":1269.0,"ymin":1298.0,"xmax":1325.0,"ymax":1560.0},{"id":69,"contenttext":"萬物に在りて一物を留めず。","xmin":1266.0,"ymin":1587.0,"xmax":1317.0,"ymax":2150.0},{"id":70,"contenttext":"所謂風波雲霧、","xmin":1210.0,"ymin":663.0,"xmax":1257.0,"ymax":956.0},{"id":71,"contenttext":"動靜進退、","xmin":1206.0,"ymin":988.0,"xmax":1254.0,"ymax":1189.0},{"id":72,"contenttext":"晝夜隱顯、","xmin":1200.0,"ymin":1219.0,"xmax":1253.0,"ymax":1419.0},{"id":73,"contenttext":"冷寒温熱、","xmin":1200.0,"ymin":1450.0,"xmax":1247.0,"ymax":1648.0},{"id":74,"contenttext":"善惡の報、","xmin":1196.0,"ymin":1681.0,"xmax":1244.0,"ymax":1883.0},{"id":75,"contenttext":"邪正の差、","xmin":1196.0,"ymin":1912.0,"xmax":1243.0,"ymax":2115.0},{"id":76,"contenttext":"統べて吾が神明の所爲に非るはなし。","xmin":1124.0,"ymin":665.0,"xmax":1190.0,"ymax":1421.0},{"id":77,"contenttext":"故に天地の心是れ神也。","xmin":1119.0,"ymin":1446.0,"xmax":1179.0,"ymax":1932.0},{"id":78,"contenttext":"諸佛の心","xmin":1120.0,"ymin":1957.0,"xmax":1171.0,"ymax":2144.0},{"id":79,"contenttext":"是れ神也。","xmin":1057.0,"ymin":662.0,"xmax":1115.0,"ymax":865.0},{"id":80,"contenttext":"鬼畜の心是れ神也。","xmin":1051.0,"ymin":892.0,"xmax":1112.0,"ymax":1281.0},{"id":81,"contenttext":"草木の心是れ神也。","xmin":1044.0,"ymin":1308.0,"xmax":1104.0,"ymax":1699.0},{"id":82,"contenttext":"何ぞ況んや人倫に於","xmin":1042.0,"ymin":1726.0,"xmax":1098.0,"ymax":2144.0},{"id":83,"contenttext":"いてをや。","xmin":988.0,"ymin":667.0,"xmax":1034.0,"ymax":865.0},{"id":84,"contenttext":"意を以つて理を成す。","xmin":980.0,"ymin":894.0,"xmax":1033.0,"ymax":1327.0},{"id":85,"contenttext":"意を以つて言を成す。","xmin":977.0,"ymin":1356.0,"xmax":1026.0,"ymax":1786.0},{"id":86,"contenttext":"意を以つて手足","xmin":973.0,"ymin":1818.0,"xmax":1020.0,"ymax":2140.0},{"id":87,"contenttext":"を爲す。","xmin":916.0,"ymin":663.0,"xmax":965.0,"ymax":818.0},{"id":88,"contenttext":"皆是れ心神の所爲也。","xmin":906.0,"ymin":847.0,"xmax":965.0,"ymax":1281.0},{"id":89,"contenttext":"一切の含靈、","xmin":902.0,"ymin":1321.0,"xmax":956.0,"ymax":1560.0},{"id":90,"contenttext":"神に非ずと云ふことなし。","xmin":899.0,"ymin":1587.0,"xmax":952.0,"ymax":2111.0},{"id":91,"contenttext":"神道史綱要","xmin":842.0,"ymin":782.0,"xmax":882.0,"ymax":988.0},{"id":92,"contenttext":"モ","xmin":836.0,"ymin":1922.0,"xmax":869.0,"ymax":1956.0}]