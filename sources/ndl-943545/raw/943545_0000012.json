[{"id":0,"contenttext":"ニ","xmin":3113.0,"ymin":1943.0,"xmax":3143.0,"ymax":1978.0},{"id":1,"contenttext":"地を釋迦·藥師·彌陀の三尊としたりし也。","xmin":3033.0,"ymin":682.0,"xmax":3080.0,"ymax":1484.0},{"id":2,"contenttext":"而して叡山には、『古事記』に、","xmin":3026.0,"ymin":1515.0,"xmax":3077.0,"ymax":2099.0},{"id":3,"contenttext":"御","xmin":3029.0,"ymin":2098.0,"xmax":3072.0,"ymax":2158.0},{"id":4,"contenttext":"未","xmin":2990.0,"ymin":2030.0,"xmax":3021.0,"ymax":2081.0},{"id":5,"contenttext":"줍","xmin":2992.0,"ymin":2077.0,"xmax":3021.0,"ymax":2139.0},{"id":6,"contenttext":"年神、","xmin":2963.0,"ymin":680.0,"xmax":3010.0,"ymax":789.0},{"id":7,"contenttext":"又娶天知迦流美豆比賣生子云","xmin":2957.0,"ymin":818.0,"xmax":3009.0,"ymax":1423.0},{"id":8,"contenttext":"云","xmin":2957.0,"ymin":1430.0,"xmax":2994.0,"ymax":1482.0},{"id":9,"contenttext":"次、","xmin":2957.0,"ymin":1513.0,"xmax":3006.0,"ymax":1576.0},{"id":10,"contenttext":"大山昨神亦名山末之大主神、","xmin":2953.0,"ymin":1609.0,"xmax":3005.0,"ymax":2165.0},{"id":11,"contenttext":"x","xmin":2937.0,"ymin":825.0,"xmax":2951.0,"ymax":856.0},{"id":12,"contenttext":"+","xmin":2929.0,"ymin":1184.0,"xmax":2953.0,"ymax":1245.0},{"id":13,"contenttext":"此神者坐近淡海國之日山","xmin":2890.0,"ymin":680.0,"xmax":2951.0,"ymax":1259.0},{"id":14,"contenttext":"と云ひ、","xmin":2888.0,"ymin":1285.0,"xmax":2935.0,"ymax":1437.0},{"id":15,"contenttext":"己に大山昨神鎭坐しませるも、","xmin":2886.0,"ymin":1468.0,"xmax":2935.0,"ymax":2085.0},{"id":16,"contenttext":"今、","xmin":2886.0,"ymin":2104.0,"xmax":2933.0,"ymax":2166.0},{"id":17,"contenttext":"玆に山王神を祭り、","xmin":2820.0,"ymin":680.0,"xmax":2869.0,"ymax":1063.0},{"id":18,"contenttext":"釋迦の垂跡を大己貴神とし、","xmin":2816.0,"ymin":1098.0,"xmax":2869.0,"ymax":1670.0},{"id":19,"contenttext":"藥師の埀跡を國常立尊","xmin":2814.0,"ymin":1699.0,"xmax":2865.0,"ymax":2162.0},{"id":20,"contenttext":"とし、","xmin":2755.0,"ymin":684.0,"xmax":2794.0,"ymax":785.0},{"id":21,"contenttext":"阿彌陀の埀跡を八幡菩薩とし、","xmin":2744.0,"ymin":818.0,"xmax":2798.0,"ymax":1435.0},{"id":22,"contenttext":"合して山王權現となしぬ。","xmin":2743.0,"ymin":1466.0,"xmax":2790.0,"ymax":1993.0},{"id":23,"contenttext":"斯くて","xmin":2741.0,"ymin":2024.0,"xmax":2788.0,"ymax":2156.0},{"id":24,"contenttext":"此の山王神は、","xmin":2674.0,"ymin":679.0,"xmax":2725.0,"ymax":973.0},{"id":25,"contenttext":"天台の〓義に結び付けられたり。","xmin":2668.0,"ymin":1004.0,"xmax":2725.0,"ymax":1670.0},{"id":26,"contenttext":"『神社考』の錄する所に","xmin":2665.0,"ymin":1687.0,"xmax":2719.0,"ymax":2157.0},{"id":27,"contenttext":"よるに、","xmin":2612.0,"ymin":684.0,"xmax":2647.0,"ymax":828.0},{"id":28,"contenttext":"山王神は行園に之れを示せりとなせり。","xmin":2606.0,"ymin":868.0,"xmax":2651.0,"ymax":1666.0},{"id":29,"contenttext":"即ち明神嘗て行園に〓","xmin":2596.0,"ymin":1699.0,"xmax":2647.0,"ymax":2158.0},{"id":30,"contenttext":"げて曰はく、","xmin":2536.0,"ymin":680.0,"xmax":2581.0,"ymax":928.0},{"id":31,"contenttext":"「我れを山王と名く。","xmin":2530.0,"ymin":941.0,"xmax":2584.0,"ymax":1343.0},{"id":32,"contenttext":"公之れを委すや。","xmin":2530.0,"ymin":1372.0,"xmax":2579.0,"ymax":1715.0},{"id":33,"contenttext":"三諦即一を表する也。","xmin":2526.0,"ymin":1746.0,"xmax":2573.0,"ymax":2168.0},{"id":34,"contenttext":"山王の竪の三〓は空假中也。","xmin":2459.0,"ymin":678.0,"xmax":2512.0,"ymax":1253.0},{"id":35,"contenttext":"橫の一〓は即一也。","xmin":2457.0,"ymin":1282.0,"xmax":2506.0,"ymax":1667.0},{"id":36,"contenttext":"王字の橫の三〓は三諦","xmin":2448.0,"ymin":1699.0,"xmax":2505.0,"ymax":2163.0},{"id":37,"contenttext":"也。","xmin":2387.0,"ymin":682.0,"xmax":2434.0,"ymax":744.0},{"id":38,"contenttext":"竪の一〓又一也。","xmin":2387.0,"ymin":772.0,"xmax":2434.0,"ymax":1114.0},{"id":39,"contenttext":"二字三〓にして一貫の象あり、","xmin":2378.0,"ymin":1141.0,"xmax":2435.0,"ymax":1758.0},{"id":40,"contenttext":"故に我れ立てゝ號","xmin":2379.0,"ymin":1789.0,"xmax":2428.0,"ymax":2160.0},{"id":41,"contenttext":"となす也。","xmin":2314.0,"ymin":680.0,"xmax":2361.0,"ymax":878.0},{"id":42,"contenttext":"一心三觀、","xmin":2309.0,"ymin":920.0,"xmax":2364.0,"ymax":1111.0},{"id":43,"contenttext":"一念三千、","xmin":2311.0,"ymin":1152.0,"xmax":2362.0,"ymax":1346.0},{"id":44,"contenttext":"亦復是の如し。","xmin":2307.0,"ymin":1374.0,"xmax":2362.0,"ymax":1671.0},{"id":45,"contenttext":"是を以つて我れ台〓を","xmin":2304.0,"ymin":1697.0,"xmax":2358.0,"ymax":2163.0},{"id":46,"contenttext":"護持し、","xmin":2240.0,"ymin":675.0,"xmax":2291.0,"ymax":834.0},{"id":47,"contenttext":"國家を鎭護す」と。","xmin":2240.0,"ymin":861.0,"xmax":2287.0,"ymax":1202.0},{"id":48,"contenttext":"かゝる傳に基き、","xmin":2234.0,"ymin":1235.0,"xmax":2285.0,"ymax":1572.0},{"id":49,"contenttext":"山王とは、","xmin":2236.0,"ymin":1605.0,"xmax":2283.0,"ymax":1802.0},{"id":50,"contenttext":"三諦一境の稱也。","xmin":2230.0,"ymin":1836.0,"xmax":2283.0,"ymax":2168.0},{"id":51,"contenttext":"三と雖も而かも一。","xmin":2166.0,"ymin":678.0,"xmax":2213.0,"ymax":1063.0},{"id":52,"contenttext":"斯れを極理となす。","xmin":2160.0,"ymin":1092.0,"xmax":2214.0,"ymax":1481.0},{"id":53,"contenttext":"乃ち一實の謂也と云ひ、","xmin":2158.0,"ymin":1511.0,"xmax":2210.0,"ymax":1991.0},{"id":54,"contenttext":"或は、","xmin":2156.0,"ymin":2022.0,"xmax":2207.0,"ymax":2130.0},{"id":55,"contenttext":"八百萬の神々は、","xmin":1786.0,"ymin":661.0,"xmax":1833.0,"ymax":1000.0},{"id":56,"contenttext":"皆此の三諦一實の妙理に基きて、","xmin":1781.0,"ymin":1031.0,"xmax":1833.0,"ymax":1694.0},{"id":57,"contenttext":"無窮の化道を施し玉","xmin":1782.0,"ymin":1724.0,"xmax":1831.0,"ymax":2136.0},{"id":58,"contenttext":"ふと云ふが如き、","xmin":1715.0,"ymin":663.0,"xmax":1762.0,"ymax":999.0},{"id":59,"contenttext":"神道說を構成せり。","xmin":1713.0,"ymin":1029.0,"xmax":1760.0,"ymax":1411.0},{"id":60,"contenttext":"山王神道に尋いで起りたるものを兩部習合神道となす。","xmin":1636.0,"ymin":706.0,"xmax":1690.0,"ymax":1833.0},{"id":61,"contenttext":"之れを兩部神","xmin":1637.0,"ymin":1863.0,"xmax":1688.0,"ymax":2140.0},{"id":62,"contenttext":"道と云ふ。","xmin":1570.0,"ymin":659.0,"xmax":1619.0,"ymax":858.0},{"id":63,"contenttext":"兩部神道は空海によりて創めらると稱す。","xmin":1562.0,"ymin":890.0,"xmax":1619.0,"ymax":1739.0},{"id":64,"contenttext":"然れども山王神道","xmin":1563.0,"ymin":1769.0,"xmax":1615.0,"ymax":2138.0},{"id":65,"contenttext":"の最澄に於けるが如く、","xmin":1498.0,"ymin":661.0,"xmax":1547.0,"ymax":1134.0},{"id":66,"contenttext":"兩部神道が果して空海によりて創められたるも","xmin":1493.0,"ymin":1166.0,"xmax":1545.0,"ymax":2138.0},{"id":67,"contenttext":"のなりや否やは亦一大疑問也。","xmin":1427.0,"ymin":659.0,"xmax":1475.0,"ymax":1273.0},{"id":68,"contenttext":"かの『麗氣記』の如き、","xmin":1422.0,"ymin":1305.0,"xmax":1472.0,"ymax":1737.0},{"id":69,"contenttext":"空海の作と稱し、","xmin":1419.0,"ymin":1769.0,"xmax":1469.0,"ymax":2109.0},{"id":70,"contenttext":"高野山に秘書として傳はれりとせられたるも、","xmin":1348.0,"ymin":657.0,"xmax":1402.0,"ymax":1598.0},{"id":71,"contenttext":"而かも後人の僞作になれ","xmin":1347.0,"ymin":1630.0,"xmax":1396.0,"ymax":2136.0},{"id":72,"contenttext":"るものたるは、","xmin":1279.0,"ymin":661.0,"xmax":1324.0,"ymax":947.0},{"id":73,"contenttext":"諸家の一致する所也。","xmin":1275.0,"ymin":978.0,"xmax":1324.0,"ymax":1416.0},{"id":74,"contenttext":"されど此の神道は、","xmin":1270.0,"ymin":1444.0,"xmax":1324.0,"ymax":1829.0},{"id":75,"contenttext":"山王神道と同","xmin":1271.0,"ymin":1863.0,"xmax":1320.0,"ymax":2136.0},{"id":76,"contenttext":"じく、","xmin":1216.0,"ymin":659.0,"xmax":1251.0,"ymax":762.0},{"id":77,"contenttext":"神佛一致說の當然に將ち來たすべき結果にして、","xmin":1200.0,"ymin":796.0,"xmax":1254.0,"ymax":1784.0},{"id":78,"contenttext":"空海の如き佛〓","xmin":1202.0,"ymin":1816.0,"xmax":1249.0,"ymax":2136.0},{"id":79,"contenttext":"家によりて、","xmin":1144.0,"ymin":659.0,"xmax":1187.0,"ymax":903.0},{"id":80,"contenttext":"少くともその一端の創めらるべきは、","xmin":1137.0,"ymin":937.0,"xmax":1186.0,"ymax":1689.0},{"id":81,"contenttext":"殆んど疑の容るべき","xmin":1132.0,"ymin":1722.0,"xmax":1181.0,"ymax":2134.0},{"id":82,"contenttext":"なき也。","xmin":1067.0,"ymin":659.0,"xmax":1114.0,"ymax":813.0},{"id":83,"contenttext":"かくて吾人は此の神道も空海によりてその端を發せられ、","xmin":1063.0,"ymin":845.0,"xmax":1114.0,"ymax":2014.0},{"id":84,"contenttext":"以後","xmin":1063.0,"ymin":2047.0,"xmax":1112.0,"ymax":2140.0},{"id":85,"contenttext":"眞言家によりて發展せられたるものとするもの也。","xmin":988.0,"ymin":657.0,"xmax":1043.0,"ymax":1689.0},{"id":86,"contenttext":"而して北畠親房が、","xmin":986.0,"ymin":1724.0,"xmax":1039.0,"ymax":2109.0},{"id":87,"contenttext":"我が國は神代よりの緣起、","xmin":919.0,"ymin":659.0,"xmax":971.0,"ymax":1190.0},{"id":88,"contenttext":"この宗の所說に符合せりと云ひ全く兩部神道","xmin":917.0,"ymin":1215.0,"xmax":969.0,"ymax":2138.0},{"id":89,"contenttext":"神道史綱要","xmin":856.0,"ymin":778.0,"xmax":895.0,"ymax":984.0},{"id":90,"contenttext":"五","xmin":850.0,"ymin":1922.0,"xmax":885.0,"ymax":1958.0},{"id":91,"contenttext":"無窮の化道を施し玉","xmin":1782.0,"ymin":1724.0,"xmax":1831.0,"ymax":2136.0}]