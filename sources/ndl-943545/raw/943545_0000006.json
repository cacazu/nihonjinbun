[{"id":0,"contenttext":"=","xmin":3135.0,"ymin":1910.0,"xmax":3168.0,"ymax":1942.0},{"id":1,"contenttext":"らるゝ天御中主神は無限遍在にましませば、","xmin":3034.0,"ymin":648.0,"xmax":3101.0,"ymax":1540.0},{"id":2,"contenttext":"至る所として、","xmin":3054.0,"ymin":1578.0,"xmax":3105.0,"ymax":1864.0},{"id":3,"contenttext":"此の神のま","xmin":3060.0,"ymin":1901.0,"xmax":3110.0,"ymax":2132.0},{"id":4,"contenttext":"します所ならざるはなし。","xmin":2962.0,"ymin":650.0,"xmax":3022.0,"ymax":1180.0},{"id":5,"contenttext":"從つて平田篤亂は此の大神はしも、","xmin":2973.0,"ymin":1206.0,"xmax":3037.0,"ymax":1912.0},{"id":6,"contenttext":"無始より","xmin":2992.0,"ymin":1949.0,"xmax":3039.0,"ymax":2130.0},{"id":7,"contenttext":"座しませば、","xmin":2890.0,"ymin":650.0,"xmax":2945.0,"ymax":894.0},{"id":8,"contenttext":"最第一の神に座すこと申すも更にて、","xmin":2895.0,"ymin":918.0,"xmax":2958.0,"ymax":1661.0},{"id":9,"contenttext":"其の御功德の廣く大き","xmin":2910.0,"ymin":1688.0,"xmax":2969.0,"ymax":2130.0},{"id":10,"contenttext":"なること、","xmin":2821.0,"ymin":654.0,"xmax":2868.0,"ymax":849.0},{"id":11,"contenttext":"稱へ申すべき詞もなしと知るべしと說ける也。","xmin":2824.0,"ymin":884.0,"xmax":2888.0,"ymax":1827.0},{"id":12,"contenttext":"此の大神の高","xmin":2839.0,"ymin":1858.0,"xmax":2900.0,"ymax":2139.0},{"id":13,"contenttext":"大無邊なる御德は、","xmin":2744.0,"ymin":654.0,"xmax":2799.0,"ymax":1033.0},{"id":14,"contenttext":"高皇產靈神、","xmin":2751.0,"ymin":1071.0,"xmax":2808.0,"ymax":1313.0},{"id":15,"contenttext":"神皇產靈神二神によりて顯現せらる。","xmin":2757.0,"ymin":1347.0,"xmax":2822.0,"ymax":2108.0},{"id":16,"contenttext":"從つて森羅萬象の生々發展、","xmin":2671.0,"ymin":654.0,"xmax":2732.0,"ymax":1221.0},{"id":17,"contenttext":"皆此の二神の恩賴によらざるはなし。","xmin":2683.0,"ymin":1257.0,"xmax":2747.0,"ymax":2018.0},{"id":18,"contenttext":"以上","xmin":2698.0,"ymin":2043.0,"xmax":2754.0,"ymax":2140.0},{"id":19,"contenttext":"三神は、","xmin":2592.0,"ymin":656.0,"xmax":2644.0,"ymax":807.0},{"id":20,"contenttext":"大宇宙、","xmin":2597.0,"ymin":842.0,"xmax":2651.0,"ymax":990.0},{"id":21,"contenttext":"大自然を本體とせらるゝ神にましませば、","xmin":2603.0,"ymin":1028.0,"xmax":2666.0,"ymax":1872.0},{"id":22,"contenttext":"勿論我が國","xmin":2618.0,"ymin":1909.0,"xmax":2676.0,"ymax":2141.0},{"id":23,"contenttext":"のみの神にましまさず。","xmin":2518.0,"ymin":658.0,"xmax":2581.0,"ymax":1137.0},{"id":24,"contenttext":"實に世界的にまします也。","xmin":2530.0,"ymin":1165.0,"xmax":2590.0,"ymax":1693.0},{"id":25,"contenttext":"神道は此の三神を淵","xmin":2544.0,"ymin":1721.0,"xmax":2605.0,"ymax":2141.0},{"id":26,"contenttext":"源とす。","xmin":2450.0,"ymin":660.0,"xmax":2497.0,"ymax":812.0},{"id":27,"contenttext":"以つて神道の本質の普遍的なるを知るべし。","xmin":2452.0,"ymin":842.0,"xmax":2521.0,"ymax":1740.0},{"id":28,"contenttext":"古傳は更に進んで","xmin":2472.0,"ymin":1768.0,"xmax":2529.0,"ymax":2141.0},{"id":29,"contenttext":"アシカビヒコヂノ","xmin":2414.0,"ymin":750.0,"xmax":2450.0,"ymax":937.0},{"id":30,"contenttext":"蓋し現當世界の萬物の最初の神也。","xmin":2393.0,"ymin":1445.0,"xmax":2463.0,"ymax":2161.0},{"id":31,"contenttext":"可美章牙彥勇神のなりませるを傳ふ。","xmin":2372.0,"ymin":660.0,"xmax":2446.0,"ymax":1417.0},{"id":32,"contenttext":"それより種々の神聖を經て天照大神の出現を仰ぐに至る。","xmin":2294.0,"ymin":660.0,"xmax":2377.0,"ymax":1828.0},{"id":33,"contenttext":"天照大神は伊弉諸伊弉冊二神の貴子にましまして、","xmin":2225.0,"ymin":709.0,"xmax":2298.0,"ymax":1740.0},{"id":34,"contenttext":"人身を有し給ひ、","xmin":2251.0,"ymin":1774.0,"xmax":2305.0,"ymax":2108.0},{"id":35,"contenttext":"而して能く天御中主神の高大無邊なる御德を備へ給ふ。","xmin":2147.0,"ymin":664.0,"xmax":2235.0,"ymax":1796.0},{"id":36,"contenttext":"故に古傳は光華","xmin":2180.0,"ymin":1819.0,"xmax":2234.0,"ymax":2142.0},{"id":37,"contenttext":"天照大神","xmin":2224.0,"ymin":469.0,"xmax":2258.0,"ymax":585.0},{"id":38,"contenttext":"明彩六合の內に照徹しましませりと傳ふ。","xmin":1764.0,"ymin":675.0,"xmax":1820.0,"ymax":1507.0},{"id":39,"contenttext":"所謂人道としての神道、","xmin":1761.0,"ymin":1534.0,"xmax":1816.0,"ymax":1994.0},{"id":40,"contenttext":"實に大","xmin":1759.0,"ymin":2020.0,"xmax":1812.0,"ymax":2154.0},{"id":41,"contenttext":"神にま創る。","xmin":1694.0,"ymin":675.0,"xmax":1741.0,"ymax":920.0},{"id":42,"contenttext":"大神は耶蘇基督の如く、","xmin":1687.0,"ymin":945.0,"xmax":1742.0,"ymax":1411.0},{"id":43,"contenttext":"その生、","xmin":1688.0,"ymin":1436.0,"xmax":1737.0,"ymax":1580.0},{"id":44,"contenttext":"その死の悲慘なるなし。","xmin":1688.0,"ymin":1607.0,"xmax":1733.0,"ymax":2078.0},{"id":45,"contenttext":"釋","xmin":1686.0,"ymin":2108.0,"xmax":1734.0,"ymax":2154.0},{"id":46,"contenttext":"迦牟尼の如く六年の苦修練行、","xmin":1613.0,"ymin":671.0,"xmax":1672.0,"ymax":1286.0},{"id":47,"contenttext":"五十年の宣〓說法なし。","xmin":1613.0,"ymin":1321.0,"xmax":1668.0,"ymax":1801.0},{"id":48,"contenttext":"孔子、","xmin":1613.0,"ymin":1828.0,"xmax":1664.0,"ymax":1933.0},{"id":49,"contenttext":"ソクラテ","xmin":1619.0,"ymin":1973.0,"xmax":1657.0,"ymax":2148.0},{"id":50,"contenttext":"ースの如く不過なし。","xmin":1538.0,"ymin":675.0,"xmax":1595.0,"ymax":1104.0},{"id":51,"contenttext":"是れ大神の云爲行動、","xmin":1539.0,"ymin":1133.0,"xmax":1592.0,"ymax":1561.0},{"id":52,"contenttext":"終始一貫、","xmin":1539.0,"ymin":1595.0,"xmax":1590.0,"ymax":1790.0},{"id":53,"contenttext":"理想的の中正に","xmin":1539.0,"ymin":1830.0,"xmax":1588.0,"ymax":2148.0},{"id":54,"contenttext":"あるが故也。","xmin":1472.0,"ymin":671.0,"xmax":1521.0,"ymax":918.0},{"id":55,"contenttext":"實に大神の御德は、","xmin":1469.0,"ymin":949.0,"xmax":1519.0,"ymax":1330.0},{"id":56,"contenttext":"至中至正、","xmin":1469.0,"ymin":1368.0,"xmax":1514.0,"ymax":1560.0},{"id":57,"contenttext":"至大至高、","xmin":1467.0,"ymin":1597.0,"xmax":1516.0,"ymax":1792.0},{"id":58,"contenttext":"孔子の門人は、","xmin":1464.0,"ymin":1826.0,"xmax":1515.0,"ymax":2114.0},{"id":59,"contenttext":"夫子は日月の如しと云へり。","xmin":1397.0,"ymin":669.0,"xmax":1450.0,"ymax":1243.0},{"id":60,"contenttext":"大神の御德は實に天日也。","xmin":1393.0,"ymin":1270.0,"xmax":1444.0,"ymax":1797.0},{"id":61,"contenttext":"天照と云ひ、","xmin":1394.0,"ymin":1826.0,"xmax":1443.0,"ymax":2068.0},{"id":62,"contenttext":"大","xmin":1394.0,"ymin":2104.0,"xmax":1443.0,"ymax":2152.0},{"id":63,"contenttext":"日孁貴と云ふ。","xmin":1325.0,"ymin":669.0,"xmax":1379.0,"ymax":962.0},{"id":64,"contenttext":"偉なる哉。","xmin":1326.0,"ymin":992.0,"xmax":1374.0,"ymax":1195.0},{"id":65,"contenttext":"天照大神の御德は、","xmin":1322.0,"ymin":1225.0,"xmax":1377.0,"ymax":1606.0},{"id":66,"contenttext":"以下諸神聖に傳はり、","xmin":1322.0,"ymin":1642.0,"xmax":1371.0,"ymax":2068.0},{"id":67,"contenttext":"天","xmin":1322.0,"ymin":2102.0,"xmax":1371.0,"ymax":2148.0},{"id":68,"contenttext":"下の百姓に及ぶ。","xmin":1251.0,"ymin":667.0,"xmax":1304.0,"ymax":1011.0},{"id":69,"contenttext":"玆に秩序的統一的思想、","xmin":1247.0,"ymin":1039.0,"xmax":1302.0,"ymax":1512.0},{"id":70,"contenttext":"現世的快活的感情、","xmin":1247.0,"ymin":1548.0,"xmax":1298.0,"ymax":1925.0},{"id":71,"contenttext":"發展的膨","xmin":1245.0,"ymin":1962.0,"xmax":1300.0,"ymax":2148.0},{"id":72,"contenttext":"脹的性格となる。","xmin":1177.0,"ymin":665.0,"xmax":1228.0,"ymax":1008.0},{"id":73,"contenttext":"之れを我が國民的精神と云ふ。","xmin":1171.0,"ymin":1039.0,"xmax":1228.0,"ymax":1661.0},{"id":74,"contenttext":"かゝる思想、","xmin":1100.0,"ymin":712.0,"xmax":1149.0,"ymax":950.0},{"id":75,"contenttext":"かゝる感情、","xmin":1097.0,"ymin":992.0,"xmax":1150.0,"ymax":1229.0},{"id":76,"contenttext":"かゝる性格は、","xmin":1095.0,"ymin":1268.0,"xmax":1147.0,"ymax":1553.0},{"id":77,"contenttext":"天御中主神の御德を蒙れる","xmin":1093.0,"ymin":1591.0,"xmax":1146.0,"ymax":2140.0},{"id":78,"contenttext":"世界人類普く有せざるべからざる所の者たり。","xmin":1019.0,"ymin":663.0,"xmax":1078.0,"ymax":1605.0},{"id":79,"contenttext":"從つて秩序的統一的思想","xmin":1019.0,"ymin":1636.0,"xmax":1073.0,"ymax":2144.0},{"id":80,"contenttext":"の如き、","xmin":956.0,"ymin":663.0,"xmax":1001.0,"ymax":811.0},{"id":81,"contenttext":"支那國民も著しく之れを有せり。","xmin":949.0,"ymin":849.0,"xmax":1002.0,"ymax":1513.0},{"id":82,"contenttext":"而かも彼れにありては、","xmin":952.0,"ymin":1544.0,"xmax":995.0,"ymax":2015.0},{"id":83,"contenttext":"古代","xmin":947.0,"ymin":2050.0,"xmax":999.0,"ymax":2147.0},{"id":84,"contenttext":"に於いて已に禪讓放伐の如き擧によりて、","xmin":883.0,"ymin":661.0,"xmax":931.0,"ymax":1506.0},{"id":85,"contenttext":"殆んどその根本を破壞し畢り","xmin":878.0,"ymin":1542.0,"xmax":929.0,"ymax":2138.0},{"id":86,"contenttext":"神道史綱要","xmin":822.0,"ymin":800.0,"xmax":860.0,"ymax":1003.0},{"id":87,"contenttext":"〓","xmin":824.0,"ymin":1924.0,"xmax":852.0,"ymax":1952.0},{"id":88,"contenttext":"我が國民","xmin":1181.0,"ymin":469.0,"xmax":1218.0,"ymax":589.0},{"id":89,"contenttext":"的精神","xmin":1155.0,"ymin":467.0,"xmax":1189.0,"ymax":558.0}]