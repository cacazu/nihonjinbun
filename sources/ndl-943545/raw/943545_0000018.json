[{"id":0,"contenttext":"云","xmin":3160.0,"ymin":1939.0,"xmax":3192.0,"ymax":1976.0},{"id":1,"contenttext":"謂陰陽五行家の說、","xmin":3096.0,"ymin":682.0,"xmax":3147.0,"ymax":1061.0},{"id":2,"contenttext":"圓頓四〓儀の解、","xmin":3090.0,"ymin":1098.0,"xmax":3148.0,"ymax":1432.0},{"id":3,"contenttext":"唐宋儲儒の糟粕にあらずんば、","xmin":3082.0,"ymin":1470.0,"xmax":3142.0,"ymax":2087.0},{"id":4,"contenttext":"則","xmin":3082.0,"ymin":2120.0,"xmax":3131.0,"ymax":2166.0},{"id":5,"contenttext":"ち胎金兩部の餘瀝、","xmin":3019.0,"ymin":682.0,"xmax":3072.0,"ymax":1061.0},{"id":6,"contenttext":"鑿空鑽穴の妄說にあらずんは、","xmin":3011.0,"ymin":1098.0,"xmax":3072.0,"ymax":1717.0},{"id":7,"contenttext":"則ち無證不稽の私言。","xmin":3003.0,"ymin":1748.0,"xmax":3062.0,"ymax":2179.0},{"id":8,"contenttext":"曰はく秘曰はく訣、","xmin":2945.0,"ymin":682.0,"xmax":2992.0,"ymax":1057.0},{"id":9,"contenttext":"古賢の眞傳何くにかある。","xmin":2933.0,"ymin":1098.0,"xmax":2994.0,"ymax":1619.0},{"id":10,"contenttext":"或は蘊或は奧、","xmin":2933.0,"ymin":1654.0,"xmax":2986.0,"ymax":1942.0},{"id":11,"contenttext":"今人の僞","xmin":2928.0,"ymin":1979.0,"xmax":2983.0,"ymax":2167.0},{"id":12,"contenttext":"造是れ多しとの誹を免れず。","xmin":2871.0,"ymin":679.0,"xmax":2921.0,"ymax":1251.0},{"id":13,"contenttext":"此の間にありて統を直に古代に接し、","xmin":2861.0,"ymin":1280.0,"xmax":2917.0,"ymax":2035.0},{"id":14,"contenttext":"我が","xmin":2860.0,"ymin":2070.0,"xmax":2910.0,"ymax":2162.0},{"id":15,"contenttext":"固有の神道の正脉を承けて起れるものあり。","xmin":2792.0,"ymin":677.0,"xmax":2853.0,"ymax":1572.0},{"id":16,"contenttext":"之を復古神道の一派となす。","xmin":2786.0,"ymin":1605.0,"xmax":2844.0,"ymax":2173.0},{"id":17,"contenttext":"復古神道の起れるは、","xmin":2720.0,"ymin":725.0,"xmax":2773.0,"ymax":1153.0},{"id":18,"contenttext":"正しく古語學の勃興にあり。","xmin":2712.0,"ymin":1186.0,"xmax":2769.0,"ymax":1758.0},{"id":19,"contenttext":"古語學の勃興は、","xmin":2706.0,"ymin":1789.0,"xmax":2765.0,"ymax":2126.0},{"id":20,"contenttext":"近畿の二大古語學者によりてその端を發せらる。","xmin":2638.0,"ymin":675.0,"xmax":2701.0,"ymax":1668.0},{"id":21,"contenttext":"二大古語學者とは即ち","xmin":2632.0,"ymin":1699.0,"xmax":2693.0,"ymax":2161.0},{"id":22,"contenttext":"下河邊長流及び契沖是也。","xmin":2571.0,"ymin":675.0,"xmax":2622.0,"ymax":1204.0},{"id":23,"contenttext":"長流は大和の人、","xmin":2493.0,"ymin":720.0,"xmax":2547.0,"ymax":1055.0},{"id":24,"contenttext":"宇多に生る。","xmin":2490.0,"ymin":1090.0,"xmax":2542.0,"ymax":1339.0},{"id":25,"contenttext":"本姓小崎氏、","xmin":2489.0,"ymin":1368.0,"xmax":2540.0,"ymax":1610.0},{"id":26,"contenttext":"母の姓を冐し下河邊氏を","xmin":2481.0,"ymin":1648.0,"xmax":2537.0,"ymax":2157.0},{"id":27,"contenttext":"稱す。","xmin":2418.0,"ymin":673.0,"xmax":2465.0,"ymax":779.0},{"id":28,"contenttext":"通稱彥六。","xmin":2416.0,"ymin":810.0,"xmax":2467.0,"ymax":1015.0},{"id":29,"contenttext":"名は具平、","xmin":2414.0,"ymin":1041.0,"xmax":2465.0,"ymax":1241.0},{"id":30,"contenttext":"後長流と改む。","xmin":2408.0,"ymin":1274.0,"xmax":2464.0,"ymax":1572.0},{"id":31,"contenttext":"夙に古語を研究し、","xmin":2404.0,"ymin":1597.0,"xmax":2460.0,"ymax":1985.0},{"id":32,"contenttext":"造詣甚","xmin":2403.0,"ymin":2020.0,"xmax":2455.0,"ymax":2156.0},{"id":33,"contenttext":"た深かりき。","xmin":2342.0,"ymin":673.0,"xmax":2389.0,"ymax":917.0},{"id":34,"contenttext":"德川光圀、","xmin":2340.0,"ymin":947.0,"xmax":2391.0,"ymax":1144.0},{"id":35,"contenttext":"招きしも應ぜず。","xmin":2335.0,"ymin":1180.0,"xmax":2387.0,"ymax":1527.0},{"id":36,"contenttext":"乃ち紙筆を與へて「萬葉」の注を","xmin":2327.0,"ymin":1554.0,"xmax":2383.0,"ymax":2154.0},{"id":37,"contenttext":"求む。","xmin":2275.0,"ymin":671.0,"xmax":2318.0,"ymax":777.0},{"id":38,"contenttext":"果さずして貞享三年六月三日歿す。","xmin":2261.0,"ymin":808.0,"xmax":2322.0,"ymax":1521.0},{"id":39,"contenttext":"行年六十三。","xmin":2260.0,"ymin":1550.0,"xmax":2314.0,"ymax":1803.0},{"id":40,"contenttext":"圓珠庵の契沖は浪華の人、","xmin":2193.0,"ymin":714.0,"xmax":2250.0,"ymax":1234.0},{"id":41,"contenttext":"本姓は下川、","xmin":2191.0,"ymin":1272.0,"xmax":2244.0,"ymax":1516.0},{"id":42,"contenttext":"字は空心。","xmin":2189.0,"ymin":1550.0,"xmax":2240.0,"ymax":1756.0},{"id":43,"contenttext":"幼にして出家せり。","xmin":2182.0,"ymin":1783.0,"xmax":2238.0,"ymax":2163.0},{"id":44,"contenttext":"統を古代","xmin":2806.0,"ymin":481.0,"xmax":2845.0,"ymax":603.0},{"id":45,"contenttext":"に接す","xmin":2780.0,"ymin":483.0,"xmax":2812.0,"ymax":570.0},{"id":46,"contenttext":"下河邊長","xmin":2499.0,"ymin":473.0,"xmax":2533.0,"ymax":599.0},{"id":47,"contenttext":"流","xmin":2471.0,"ymin":473.0,"xmax":2499.0,"ymax":513.0},{"id":48,"contenttext":"學儒佛を兼ね、","xmin":1776.0,"ymin":657.0,"xmax":1827.0,"ymax":948.0},{"id":49,"contenttext":"博覽多識、","xmin":1775.0,"ymin":981.0,"xmax":1830.0,"ymax":1176.0},{"id":50,"contenttext":"長流と同じく夙に我が古語を研究し、","xmin":1776.0,"ymin":1213.0,"xmax":1833.0,"ymax":1966.0},{"id":51,"contenttext":"發明せ","xmin":1780.0,"ymin":2000.0,"xmax":1836.0,"ymax":2137.0},{"id":52,"contenttext":"る所多かりき。","xmin":1700.0,"ymin":661.0,"xmax":1749.0,"ymax":950.0},{"id":53,"contenttext":"德川光圀の囑により『萬葉代匠記』を著はし、","xmin":1700.0,"ymin":982.0,"xmax":1752.0,"ymax":1837.0},{"id":54,"contenttext":"其他多くの著","xmin":1704.0,"ymin":1865.0,"xmax":1755.0,"ymax":2138.0},{"id":55,"contenttext":"書をなして斯學に貢献せる所尠からざりき。","xmin":1627.0,"ymin":657.0,"xmax":1676.0,"ymax":1549.0},{"id":56,"contenttext":"元祿十四年歿す。","xmin":1631.0,"ymin":1585.0,"xmax":1681.0,"ymax":1927.0},{"id":57,"contenttext":"年六十二。","xmin":1631.0,"ymin":1957.0,"xmax":1684.0,"ymax":2148.0},{"id":58,"contenttext":"長流契沖の斯學に致せる功大は則ち大なりと雖も而かも、","xmin":1558.0,"ymin":657.0,"xmax":1610.0,"ymax":1825.0},{"id":59,"contenttext":"彼れ等は要す","xmin":1563.0,"ymin":1865.0,"xmax":1610.0,"ymax":2136.0},{"id":60,"contenttext":"るに語學者也。","xmin":1490.0,"ymin":661.0,"xmax":1537.0,"ymax":952.0},{"id":61,"contenttext":"神道學者にはあらず。","xmin":1487.0,"ymin":982.0,"xmax":1540.0,"ymax":1413.0},{"id":62,"contenttext":"所謂古道學者とは謂ふべからざる","xmin":1492.0,"ymin":1444.0,"xmax":1539.0,"ymax":2138.0},{"id":63,"contenttext":"也。","xmin":1416.0,"ymin":661.0,"xmax":1459.0,"ymax":721.0},{"id":64,"contenttext":"初めて古道としての神道を建設したるものは、","xmin":1411.0,"ymin":751.0,"xmax":1468.0,"ymax":1686.0},{"id":65,"contenttext":"荷田春滿その人也。","xmin":1418.0,"ymin":1722.0,"xmax":1467.0,"ymax":2109.0},{"id":66,"contenttext":"春滿、","xmin":1355.0,"ymin":702.0,"xmax":1402.0,"ymax":811.0},{"id":67,"contenttext":"幼名鶴丸。","xmin":1351.0,"ymin":841.0,"xmax":1402.0,"ymax":1044.0},{"id":68,"contenttext":"長じて信盛と云ひ、","xmin":1351.0,"ymin":1074.0,"xmax":1398.0,"ymax":1459.0},{"id":69,"contenttext":"後春滿と改む。","xmin":1349.0,"ymin":1489.0,"xmax":1398.0,"ymax":1781.0},{"id":70,"contenttext":"稻荷山の神官、","xmin":1351.0,"ymin":1812.0,"xmax":1398.0,"ymax":2105.0},{"id":71,"contenttext":"荷田宿禰信詮の嫡子也。","xmin":1279.0,"ymin":655.0,"xmax":1334.0,"ymax":1137.0},{"id":72,"contenttext":"夙に國學に志し、","xmin":1279.0,"ymin":1164.0,"xmax":1326.0,"ymax":1503.0},{"id":73,"contenttext":"社務を弟信名に讓り、","xmin":1279.0,"ymin":1534.0,"xmax":1326.0,"ymax":1964.0},{"id":74,"contenttext":"學者を","xmin":1279.0,"ymin":1996.0,"xmax":1326.0,"ymax":2132.0},{"id":75,"contenttext":"求めて四方に遊學し。","xmin":1206.0,"ymin":657.0,"xmax":1262.0,"ymax":1092.0},{"id":76,"contenttext":"元祿十二年江戶に出で修學十四年。","xmin":1203.0,"ymin":1117.0,"xmax":1261.0,"ymax":1828.0},{"id":77,"contenttext":"遂に京師に歸","xmin":1206.0,"ymin":1857.0,"xmax":1256.0,"ymax":2136.0},{"id":78,"contenttext":"り、","xmin":1147.0,"ymin":653.0,"xmax":1183.0,"ymax":717.0},{"id":79,"contenttext":"盛に復古の學を唱へぬ。","xmin":1134.0,"ymin":747.0,"xmax":1191.0,"ymax":1226.0},{"id":80,"contenttext":"篤胤記して曰はく、","xmin":1134.0,"ymin":1258.0,"xmax":1183.0,"ymax":1641.0},{"id":81,"contenttext":"偖","xmin":1067.0,"ymin":745.0,"xmax":1120.0,"ymax":811.0},{"id":82,"contenttext":"その學業の詳なる趣は、","xmin":1065.0,"ymin":841.0,"xmax":1118.0,"ymax":1320.0},{"id":83,"contenttext":"幼より學を好み、","xmin":1065.0,"ymin":1346.0,"xmax":1115.0,"ymax":1690.0},{"id":84,"contenttext":"篤く皇道復古の學に","xmin":1063.0,"ymin":1718.0,"xmax":1114.0,"ymax":2132.0},{"id":85,"contenttext":"志して、","xmin":995.0,"ymin":700.0,"xmax":1042.0,"ymax":854.0},{"id":86,"contenttext":"國史、","xmin":993.0,"ymin":884.0,"xmax":1042.0,"ymax":995.0},{"id":87,"contenttext":"律令、","xmin":993.0,"ymin":1023.0,"xmax":1044.0,"ymax":1134.0},{"id":88,"contenttext":"古文、","xmin":989.0,"ymin":1160.0,"xmax":1042.0,"ymax":1271.0},{"id":89,"contenttext":"古歌及び諸家の記傳に至るまで、","xmin":990.0,"ymin":1301.0,"xmax":1040.0,"ymax":1966.0},{"id":90,"contenttext":"該博通","xmin":990.0,"ymin":1996.0,"xmax":1041.0,"ymax":2134.0},{"id":91,"contenttext":"ぜざる所なし。","xmin":922.0,"ymin":702.0,"xmax":969.0,"ymax":989.0},{"id":92,"contenttext":"然れども師尙する所なく、","xmin":920.0,"ymin":1023.0,"xmax":969.0,"ymax":1545.0},{"id":93,"contenttext":"而して其自得發明する所極","xmin":920.0,"ymin":1579.0,"xmax":969.0,"ymax":2128.0},{"id":94,"contenttext":"神道史綱要","xmin":854.0,"ymin":774.0,"xmax":893.0,"ymax":979.0},{"id":95,"contenttext":"〓","xmin":852.0,"ymin":1910.0,"xmax":887.0,"ymax":1946.0},{"id":96,"contenttext":"荷田春滿","xmin":1357.0,"ymin":463.0,"xmax":1396.0,"ymax":585.0}]