[{"id":0,"contenttext":"空","xmin":3184.0,"ymin":1983.0,"xmax":3219.0,"ymax":2021.0},{"id":1,"contenttext":"因此て行はるべし。","xmin":3121.0,"ymin":767.0,"xmax":3176.0,"ymax":1161.0},{"id":2,"contenttext":"此ぞ神漏岐神漏美の詔命以て皇御孫命に事依し奉","xmin":3101.0,"ymin":1188.0,"xmax":3173.0,"ymax":2210.0},{"id":3,"contenttext":"給ひし隨に、","xmin":3052.0,"ymin":765.0,"xmax":3103.0,"ymax":1016.0},{"id":4,"contenttext":"古今萬國の差別無く、","xmin":3041.0,"ymin":1047.0,"xmax":3099.0,"ymax":1480.0},{"id":5,"contenttext":"天下公正に自然にして行はるゝ所","xmin":3029.0,"ymin":1513.0,"xmax":3095.0,"ymax":2206.0},{"id":6,"contenttext":"の大道にして、","xmin":2980.0,"ymin":763.0,"xmax":3029.0,"ymax":1063.0},{"id":7,"contenttext":"貴賤尊卑の等差なく天下萬世に當然にして行可き所の","xmin":2954.0,"ymin":1090.0,"xmax":3025.0,"ymax":2202.0},{"id":8,"contenttext":"大道なり。","xmin":2908.0,"ymin":761.0,"xmax":2957.0,"ymax":967.0},{"id":9,"contenttext":"(祝詞講義)","xmin":2900.0,"ymin":985.0,"xmax":2956.0,"ymax":1200.0},{"id":10,"contenttext":"と。","xmin":2849.0,"ymin":716.0,"xmax":2882.0,"ymax":773.0},{"id":11,"contenttext":"以つて彼れが神道とせる所のものゝ規模大にして、","xmin":2819.0,"ymin":806.0,"xmax":2888.0,"ymax":1846.0},{"id":12,"contenttext":"抱括的なるを見","xmin":2816.0,"ymin":1879.0,"xmax":2866.0,"ymax":2200.0},{"id":13,"contenttext":"るべし。","xmin":2771.0,"ymin":710.0,"xmax":2818.0,"ymax":869.0},{"id":14,"contenttext":"蓋し彼れは儒〓そのもの佛〓そのものとしては、","xmin":2747.0,"ymin":898.0,"xmax":2819.0,"ymax":1893.0},{"id":15,"contenttext":"之れを排斥せ","xmin":2742.0,"ymin":1920.0,"xmax":2797.0,"ymax":2200.0},{"id":16,"contenttext":"るも、","xmin":2704.0,"ymin":714.0,"xmax":2737.0,"ymax":813.0},{"id":17,"contenttext":"而かも「普天の下悉く皇御孫命の皇土に非ぬはなく、","xmin":2670.0,"ymin":850.0,"xmax":2744.0,"ymax":1891.0},{"id":18,"contenttext":"萬國の聖哲悉","xmin":2665.0,"ymin":1920.0,"xmax":2721.0,"ymax":2198.0},{"id":19,"contenttext":"く皇御孫命の王臣に非ぬは無ければ、","xmin":2604.0,"ymin":707.0,"xmax":2670.0,"ymax":1468.0},{"id":20,"contenttext":"萬國に行はるゝ道、","xmin":2595.0,"ymin":1498.0,"xmax":2653.0,"ymax":1889.0},{"id":21,"contenttext":"即我が大道な","xmin":2590.0,"ymin":1917.0,"xmax":2647.0,"ymax":2196.0},{"id":22,"contenttext":"れば、","xmin":2547.0,"ymin":706.0,"xmax":2596.0,"ymax":818.0},{"id":23,"contenttext":"惡しきを棄捐て其善を採用むに何でふ事か有む」(祝詞講義)と云ふ主","xmin":2515.0,"ymin":846.0,"xmax":2593.0,"ymax":2194.0},{"id":24,"contenttext":"義に立ち、","xmin":2473.0,"ymin":704.0,"xmax":2520.0,"ymax":909.0},{"id":25,"contenttext":"世界の總べての道に就き長を取り、","xmin":2454.0,"ymin":938.0,"xmax":2520.0,"ymax":1652.0},{"id":26,"contenttext":"短を補ひ以つて神道を說","xmin":2448.0,"ymin":1683.0,"xmax":2504.0,"ymax":2191.0},{"id":27,"contenttext":"かんとせるもの也。","xmin":2400.0,"ymin":706.0,"xmax":2451.0,"ymax":1098.0},{"id":28,"contenttext":"是れ實に篤胤の取りし所の主義也。","xmin":2382.0,"ymin":1126.0,"xmax":2445.0,"ymax":1838.0},{"id":29,"contenttext":"要するに彼れの說は、","xmin":2321.0,"ymin":748.0,"xmax":2383.0,"ymax":1190.0},{"id":30,"contenttext":"高天原を以つて太陽と解し、","xmin":2307.0,"ymin":1216.0,"xmax":2375.0,"ymax":1793.0},{"id":31,"contenttext":"又は天極紫微宮と","xmin":2301.0,"ymin":1817.0,"xmax":2359.0,"ymax":2190.0},{"id":32,"contenttext":"解せるが如き、","xmin":2253.0,"ymin":695.0,"xmax":2308.0,"ymax":996.0},{"id":33,"contenttext":"その他地動說を古傳とせるが如き、","xmin":2235.0,"ymin":1028.0,"xmax":2302.0,"ymax":1739.0},{"id":34,"contenttext":"篤胤の說を蹈襲せる","xmin":2228.0,"ymin":1768.0,"xmax":2283.0,"ymax":2183.0},{"id":35,"contenttext":"所尠からず。","xmin":1819.0,"ymin":682.0,"xmax":1868.0,"ymax":932.0},{"id":36,"contenttext":"從つて彼れはたとひ平田門の門人帳より省かれしと雖も、","xmin":1819.0,"ymin":964.0,"xmax":1868.0,"ymax":2132.0},{"id":37,"contenttext":"而かも事實に於いて篤胤の學派たるを失はざる也。","xmin":1747.0,"ymin":682.0,"xmax":1798.0,"ymax":1719.0},{"id":38,"contenttext":"吾人は彼れが宣長隆","xmin":1749.0,"ymin":1750.0,"xmax":1804.0,"ymax":2169.0},{"id":39,"contenttext":"正の學を學び、","xmin":1676.0,"ymin":682.0,"xmax":1727.0,"ymax":975.0},{"id":40,"contenttext":"而して深く篤胤に私淑し、","xmin":1672.0,"ymin":1008.0,"xmax":1728.0,"ymax":1531.0},{"id":41,"contenttext":"篤胤の學說を取長補短し極め","xmin":1676.0,"ymin":1567.0,"xmax":1729.0,"ymax":2166.0},{"id":42,"contenttext":"て雄大なる學說を構成せんと努めしの功は、","xmin":1602.0,"ymin":684.0,"xmax":1649.0,"ymax":1578.0},{"id":43,"contenttext":"明に認容するもの也。","xmin":1604.0,"ymin":1616.0,"xmax":1651.0,"ymax":2050.0},{"id":44,"contenttext":"以上述べ來れるが如き、","xmin":1525.0,"ymin":731.0,"xmax":1578.0,"ymax":1208.0},{"id":45,"contenttext":"德川時代に於ける復古神道派の運動に對し別","xmin":1525.0,"ymin":1242.0,"xmax":1578.0,"ymax":2168.0},{"id":46,"contenttext":"に方面を異にせる二個の神道あり。","xmin":1453.0,"ymin":684.0,"xmax":1502.0,"ymax":1394.0},{"id":47,"contenttext":"一を水戶流の神道派となし他を黑住、","xmin":1453.0,"ymin":1438.0,"xmax":1502.0,"ymax":2177.0},{"id":48,"contenttext":"井上等宗〓的神道派となす。","xmin":1380.0,"ymin":682.0,"xmax":1429.0,"ymax":1255.0},{"id":49,"contenttext":"水戶流の神道は、","xmin":1302.0,"ymin":729.0,"xmax":1353.0,"ymax":1065.0},{"id":50,"contenttext":"藩祖光圀の主義によりて、","xmin":1302.0,"ymin":1103.0,"xmax":1351.0,"ymax":1621.0},{"id":51,"contenttext":"藤田幽谷、","xmin":1304.0,"ymin":1656.0,"xmax":1355.0,"ymax":1854.0},{"id":52,"contenttext":"其の子東湖、","xmin":1304.0,"ymin":1892.0,"xmax":1355.0,"ymax":2132.0},{"id":53,"contenttext":"幽谷の門人會津正志等によりて盛に唱道せらる。","xmin":1230.0,"ymin":681.0,"xmax":1282.0,"ymax":1674.0},{"id":54,"contenttext":"其の說く所我が神道は","xmin":1232.0,"ymin":1703.0,"xmax":1281.0,"ymax":2162.0},{"id":55,"contenttext":"儒〓と背馳するものにあらずとなし、","xmin":1157.0,"ymin":682.0,"xmax":1206.0,"ymax":1437.0},{"id":56,"contenttext":"宣長等を以て道〓によりて其の說","xmin":1159.0,"ymin":1473.0,"xmax":1208.0,"ymax":2163.0},{"id":57,"contenttext":"を立せるものとなし、","xmin":1081.0,"ymin":680.0,"xmax":1130.0,"ymax":1110.0},{"id":58,"contenttext":"甚しく之れを排斥せり。","xmin":1083.0,"ymin":1146.0,"xmax":1132.0,"ymax":1625.0},{"id":59,"contenttext":"藤田東湖は曰はく、","xmin":1082.0,"ymin":1658.0,"xmax":1135.0,"ymax":2038.0},{"id":60,"contenttext":"近世古學を唱ふるもの、","xmin":1005.0,"ymin":774.0,"xmax":1053.0,"ymax":1251.0},{"id":61,"contenttext":"古言を錯綜し、","xmin":1008.0,"ymin":1287.0,"xmax":1055.0,"ymax":1574.0},{"id":62,"contenttext":"舊事を網羅し、","xmin":1008.0,"ymin":1609.0,"xmax":1057.0,"ymax":1901.0},{"id":63,"contenttext":"考證の力勤","xmin":1008.0,"ymin":1934.0,"xmax":1057.0,"ymax":2166.0},{"id":64,"contenttext":"めたりと謂ふべし。","xmin":938.0,"ymin":731.0,"xmax":981.0,"ymax":1116.0},{"id":65,"contenttext":"而れどもその道を論ずるに至りては、","xmin":934.0,"ymin":1146.0,"xmax":981.0,"ymax":1897.0},{"id":66,"contenttext":"則ち天下の","xmin":934.0,"ymin":1934.0,"xmax":983.0,"ymax":2162.0},{"id":67,"contenttext":"神道史綱要","xmin":882.0,"ymin":785.0,"xmax":922.0,"ymax":992.0},{"id":68,"contenttext":"查","xmin":879.0,"ymin":1928.0,"xmax":909.0,"ymax":1966.0},{"id":69,"contenttext":"水道流の","xmin":1312.0,"ymin":481.0,"xmax":1351.0,"ymax":603.0},{"id":70,"contenttext":"神道","xmin":1286.0,"ymin":481.0,"xmax":1320.0,"ymax":546.0},{"id":71,"contenttext":"藤田東湖","xmin":1083.0,"ymin":481.0,"xmax":1122.0,"ymax":605.0}]