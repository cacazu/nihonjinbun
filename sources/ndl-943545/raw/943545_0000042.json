[{"id":0,"contenttext":"覽天賜","xmin":874.0,"ymin":554.0,"xmax":1056.0,"ymax":628.0},{"id":1,"contenttext":"文學士","xmin":1263.0,"ymin":526.0,"xmax":1341.0,"ymax":713.0},{"id":2,"contenttext":"本居宣長之哲學","xmin":1102.0,"ymin":647.0,"xmax":1228.0,"ymax":1556.0},{"id":3,"contenttext":"田中義能先生著","xmin":1263.0,"ymin":753.0,"xmax":1336.0,"ymax":1330.0},{"id":4,"contenttext":"覽天賜","xmin":1419.0,"ymin":560.0,"xmax":1605.0,"ymax":639.0},{"id":5,"contenttext":"@","xmin":1629.0,"ymin":598.0,"xmax":1653.0,"ymax":621.0},{"id":6,"contenttext":"覽天賜","xmin":1419.0,"ymin":560.0,"xmax":1605.0,"ymax":639.0},{"id":7,"contenttext":"@","xmin":1629.0,"ymin":598.0,"xmax":1653.0,"ymax":621.0},{"id":8,"contenttext":"文學士","xmin":1808.0,"ymin":530.0,"xmax":1888.0,"ymax":719.0},{"id":9,"contenttext":"『大阪毎日新聞評』田中義能氏の「平田篤胤之哲學」は、","xmin":1576.0,"ymin":682.0,"xmax":1617.0,"ymax":1353.0},{"id":10,"contenttext":"平田篤胤之哲學","xmin":1651.0,"ymin":651.0,"xmax":1774.0,"ymax":1558.0},{"id":11,"contenttext":"だ國家と宗教の論","xmin":1414.0,"ymin":684.0,"xmax":1449.0,"ymax":914.0},{"id":12,"contenttext":"の思想の超凡を證せらる","xmin":1467.0,"ymin":684.0,"xmax":1504.0,"ymax":1001.0},{"id":13,"contenttext":"的に批評眼を開き宗教〓に至つて殊に生面がある。","xmin":1496.0,"ymin":684.0,"xmax":1533.0,"ymax":1318.0},{"id":14,"contenttext":"家-儒佛を超脫して日本的獨自の思想を發揮した-篤胤を活描し來つた著者の勞を多として、此書を推薦す。","xmin":1384.0,"ymin":684.0,"xmax":1420.0,"ymax":2097.0},{"id":15,"contenttext":"田中氏の此書は","xmin":1445.0,"ymin":686.0,"xmax":1476.0,"ymax":883.0},{"id":16,"contenttext":"統的思想的に論じたものは記者は未だ見なかつた","xmin":1529.0,"ymin":686.0,"xmax":1561.0,"ymax":1312.0},{"id":17,"contenttext":"殆ど初めて位なものであらう","xmin":1555.0,"ymin":686.0,"xmax":1586.0,"ymax":1055.0},{"id":18,"contenttext":"。","xmin":1627.0,"ymin":810.0,"xmax":1651.0,"ymax":834.0},{"id":19,"contenttext":"田中義能先生著","xmin":1807.0,"ymin":761.0,"xmax":1889.0,"ymax":1335.0},{"id":20,"contenttext":"多方面に能く篤胤の思想を解剖してある。","xmin":1441.0,"ymin":906.0,"xmax":1480.0,"ymax":1433.0},{"id":21,"contenttext":"其他になほ百尺竿頭〓一歩ありたいと思ふ處があるが","xmin":1414.0,"ymin":937.0,"xmax":1449.0,"ymax":1619.0},{"id":22,"contenttext":"是ま","xmin":1553.0,"ymin":1074.0,"xmax":1584.0,"ymax":1142.0},{"id":23,"contenttext":"朱子學古學等議家の學說に就いての述作はあるが、","xmin":1553.0,"ymin":1164.0,"xmax":1589.0,"ymax":1801.0},{"id":24,"contenttext":"@","xmin":1629.0,"ymin":1276.0,"xmax":1650.0,"ymax":1300.0},{"id":25,"contenttext":"信仰對象論の如き、","xmin":1439.0,"ymin":1445.0,"xmax":1482.0,"ymax":1689.0},{"id":26,"contenttext":"「神はわが神なりわれは神の人なり」と言つたのなどは最もそ","xmin":1495.0,"ymin":1327.0,"xmax":1537.0,"ymax":2095.0},{"id":27,"contenttext":"爲胤は本居の先導者さなって開いた獨白的皇學論を一層積極","xmin":1529.0,"ymin":1329.0,"xmax":1563.0,"ymax":2097.0},{"id":28,"contenttext":"神道國學の人傑を思想上哲學上より評傳した書としては、","xmin":1580.0,"ymin":1360.0,"xmax":1617.0,"ymax":2081.0},{"id":29,"contenttext":"?","xmin":1631.0,"ymin":1618.0,"xmax":1651.0,"ymax":1637.0},{"id":30,"contenttext":"-學界思想界の爲に","xmin":1418.0,"ymin":1618.0,"xmax":1449.0,"ymax":1901.0},{"id":31,"contenttext":"郵","xmin":1623.0,"ymin":1656.0,"xmax":1688.0,"ymax":1722.0},{"id":32,"contenttext":"洋裝上製全一冊","xmin":1725.0,"ymin":1660.0,"xmax":1790.0,"ymax":2083.0},{"id":33,"contenttext":"定","xmin":1678.0,"ymin":1661.0,"xmax":1733.0,"ymax":1721.0},{"id":34,"contenttext":"此書の標榜する所に背かぬ。","xmin":1443.0,"ymin":1697.0,"xmax":1478.0,"ymax":2052.0},{"id":35,"contenttext":"稅","xmin":1623.0,"ymin":1740.0,"xmax":1688.0,"ymax":1809.0},{"id":36,"contenttext":"價","xmin":1676.0,"ymin":1742.0,"xmax":1733.0,"ymax":1809.0},{"id":37,"contenttext":"皇學家をこれほどに系","xmin":1553.0,"ymin":1811.0,"xmax":1593.0,"ymax":2097.0},{"id":38,"contenttext":"十","xmin":1627.0,"ymin":1830.0,"xmax":1683.0,"ymax":1889.0},{"id":39,"contenttext":"金","xmin":1676.0,"ymin":1828.0,"xmax":1733.0,"ymax":1890.0},{"id":40,"contenttext":"此偉大な思想","xmin":1416.0,"ymin":1920.0,"xmax":1451.0,"ymax":2097.0},{"id":41,"contenttext":"二","xmin":1633.0,"ymin":1926.0,"xmax":1676.0,"ymax":1984.0},{"id":42,"contenttext":"貳","xmin":1673.0,"ymin":1924.0,"xmax":1737.0,"ymax":1987.0},{"id":43,"contenttext":"錢圓","xmin":1627.0,"ymin":2022.0,"xmax":1735.0,"ymax":2081.0},{"id":44,"contenttext":"但","xmin":1445.0,"ymin":2063.0,"xmax":1478.0,"ymax":2097.0},{"id":45,"contenttext":"道學派の哲學を明にせんとしたり。考證頗る之を努め所論穩健······能く其時代と人との面影を說き得たるを見る。","xmin":875.0,"ymin":675.0,"xmax":914.0,"ymax":2087.0},{"id":46,"contenttext":"『萬朝報評』本居實長が神道哲學の鼓吹者として將た國學者として、","xmin":1012.0,"ymin":680.0,"xmax":1048.0,"ymax":1514.0},{"id":47,"contenttext":"胤之哲學を著して、","xmin":919.0,"ymin":680.0,"xmax":959.0,"ymax":922.0},{"id":48,"contenttext":"其熱誠をこめたる忠君愛國說の、やがて維新の鴻業に及ぼせる影響も亦甚だ大ならずんばあらず。著者置に平田篤","xmin":965.0,"ymin":680.0,"xmax":1003.0,"ymax":2089.0},{"id":49,"contenttext":"今又此偉人を說き、學說は勿論進んでその學統に屬する多數學者の諸說をも叙し、所謂復古神","xmin":919.0,"ymin":929.0,"xmax":955.0,"ymax":2087.0},{"id":50,"contenttext":"我國思想史上の大立物たるは言はずもがな。","xmin":1012.0,"ymin":1524.0,"xmax":1048.0,"ymax":2072.0},{"id":51,"contenttext":"郵","xmin":1077.0,"ymin":1654.0,"xmax":1142.0,"ymax":1719.0},{"id":52,"contenttext":"洋裝上製全一冊","xmin":1176.0,"ymin":1655.0,"xmax":1248.0,"ymax":2080.0},{"id":53,"contenttext":"定價金貳圓拾錢","xmin":1130.0,"ymin":1659.0,"xmax":1189.0,"ymax":2076.0},{"id":54,"contenttext":"稅","xmin":1077.0,"ymin":1738.0,"xmax":1144.0,"ymax":1807.0},{"id":55,"contenttext":"十","xmin":1081.0,"ymin":1822.0,"xmax":1138.0,"ymax":1886.0},{"id":56,"contenttext":"二","xmin":1089.0,"ymin":1920.0,"xmax":1132.0,"ymax":1982.0},{"id":57,"contenttext":"錢","xmin":1081.0,"ymin":2016.0,"xmax":1144.0,"ymax":2081.0},{"id":58,"contenttext":"-","xmin":2395.0,"ymin":980.0,"xmax":2420.0,"ymax":999.0},{"id":59,"contenttext":"一","xmin":2618.0,"ymin":982.0,"xmax":2641.0,"ymax":1001.0},{"id":60,"contenttext":"ー","xmin":2673.0,"ymin":982.0,"xmax":2698.0,"ymax":1001.0},{"id":61,"contenttext":"ー","xmin":2784.0,"ymin":986.0,"xmax":2807.0,"ymax":1006.0},{"id":62,"contenttext":"-","xmin":2837.0,"ymin":984.0,"xmax":2865.0,"ymax":1008.0},{"id":63,"contenttext":"ー","xmin":2892.0,"ymin":988.0,"xmax":2918.0,"ymax":1008.0},{"id":64,"contenttext":"神道史綱要","xmin":2382.0,"ymin":1055.0,"xmax":2420.0,"ymax":1259.0},{"id":65