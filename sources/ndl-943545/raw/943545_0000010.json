[{"id":1,"contenttext":"を見たり。","xmin":3007.0,"ymin":667.0,"xmax":3059.0,"ymax":855.0},{"id":2,"contenttext":"されば、","xmin":3012.0,"ymin":904.0,"xmax":3057.0,"ymax":1038.0},{"id":3,"contenttext":"孝德天皇の朝には、","xmin":3011.0,"ymin":1092.0,"xmax":3066.0,"ymax":1454.0},{"id":4,"contenttext":"蘇我石、川麿は奏して「先祭鎭神祇、","xmin":3018.0,"ymin":1518.0,"xmax":3072.0,"ymax":2130.0},{"id":5,"contenttext":"敬奉神祇、","xmin":2949.0,"ymin":1893.0,"xmax":3003.0,"ymax":2044.0},{"id":6,"contenttext":"竝","xmin":2953.0,"ymin":2130.0,"xmax":3004.0,"ymax":2130.0},{"id":7,"contenttext":"然後應議政事」と云ひ、","xmin":2935.0,"ymin":663.0,"xmax":2989.0,"ymax":1084.0},{"id":8,"contenttext":"天皇は詔して、","xmin":2942.0,"ymin":1138.0,"xmax":2994.0,"ymax":1407.0},{"id":9,"contenttext":"「公卿百官以〓白意、","xmin":2947.0,"ymin":1456.0,"xmax":2996.0,"ymax":1817.0},{"id":10,"contenttext":"ヨ","xmin":2906.0,"ymin":873.0,"xmax":2929.0,"ymax":901.0},{"id":11,"contenttext":"詔して四方に大解除を行","xmin":2873.0,"ymin":1660.0,"xmax":2931.0,"ymax":2130.0},{"id":12,"contenttext":"受休祥、","xmin":2859.0,"ymin":666.0,"xmax":2910.0,"ymax":799.0},{"id":13,"contenttext":"令榮天下」と宣ひ、","xmin":2861.0,"ymin":853.0,"xmax":2920.0,"ymax":1180.0},{"id":14,"contenttext":"天武天皇五年には、","xmin":2869.0,"ymin":1235.0,"xmax":2923.0,"ymax":1591.0},{"id":15,"contenttext":"はしめらる。","xmin":2791.0,"ymin":669.0,"xmax":2839.0,"ymax":898.0},{"id":16,"contenttext":"大解除は神道の一大儀式也。","xmin":2790.0,"ymin":952.0,"xmax":2851.0,"ymax":1503.0},{"id":17,"contenttext":"此れ等の事實に徵して、","xmin":2798.0,"ymin":1565.0,"xmax":2855.0,"ymax":2007.0},{"id":18,"contenttext":"當時","xmin":2808.0,"ymin":2084.0,"xmax":2851.0,"ymax":2128.0},{"id":19,"contenttext":"朝廷の態度の如何に固有の神道を維持發展せんとせらたるにあるかを見","xmin":2712.0,"ymin":668.0,"xmax":2782.0,"ymax":2130.0},{"id":20,"contenttext":"るべし。","xmin":2645.0,"ymin":672.0,"xmax":2688.0,"ymax":805.0},{"id":21,"contenttext":"夫れ此の如く朝廷には盛に固有の神道の維持發展に努められ、","xmin":2567.0,"ymin":716.0,"xmax":2633.0,"ymax":1965.0},{"id":22,"contenttext":"別に『古","xmin":2583.0,"ymin":2039.0,"xmax":2633.0,"ymax":2132.0},{"id":23,"contenttext":"事記』·日日書書』","xmin":2497.0,"ymin":668.0,"xmax":2548.0,"ymax":989.0},{"id":24,"contenttext":"等を編纂せられ、","xmin":2501.0,"ymin":1035.0,"xmax":2552.0,"ymax":1353.0},{"id":25,"contenttext":"神道思想の普及を計られぬ。","xmin":2505.0,"ymin":1416.0,"xmax":2559.0,"ymax":1964.0},{"id":26,"contenttext":"而して","xmin":2516.0,"ymin":2044.0,"xmax":2559.0,"ymax":2132.0},{"id":27,"contenttext":"我が國民の多數亦神道を奉ぜりと雖も、","xmin":2422.0,"ymin":672.0,"xmax":2482.0,"ymax":1452.0},{"id":28,"contenttext":"然かも我が國民には由來新を趨","xmin":2432.0,"ymin":1516.0,"xmax":2488.0,"ymax":2132.0},{"id":29,"contenttext":"ひ奇を好むもの尠からず。","xmin":2348.0,"ymin":674.0,"xmax":2404.0,"ymax":1184.0},{"id":30,"contenttext":"かゝる國民は今や茲に無量無邊の福德果報を","xmin":2351.0,"ymin":1240.0,"xmax":2417.0,"ymax":2136.0},{"id":31,"contenttext":"生ずと云ふ佛を見ては、","xmin":2272.0,"ymin":672.0,"xmax":2333.0,"ymax":1137.0},{"id":32,"contenttext":"之れを信ぜんと欲せざるを得ざる也。","xmin":2278.0,"ymin":1193.0,"xmax":2338.0,"ymax":1922.0},{"id":33,"contenttext":"又我が國","xmin":2288.0,"ymin":1995.0,"xmax":2343.0,"ymax":2137.0},{"id":34,"contenttext":"民には、","xmin":2203.0,"ymin":676.0,"xmax":2250.0,"ymax":823.0},{"id":35,"contenttext":"文明の進歩に伴ひ、","xmin":2205.0,"ymin":862.0,"xmax":2256.0,"ymax":1230.0},{"id":36,"contenttext":"當時己に幽玄なる學說に渴仰せるものも尠","xmin":2207.0,"ymin":1286.0,"xmax":2268.0,"ymax":2136.0},{"id":37,"contenttext":"からず。","xmin":2131.0,"ymin":681.0,"xmax":2176.0,"ymax":816.0},{"id":38,"contenttext":"かゝる國民は亦佛〓によりて慰安を得んとせり。","xmin":2128.0,"ymin":865.0,"xmax":2187.0,"ymax":1828.0},{"id":39,"contenttext":"かく種々の事","xmin":2142.0,"ymin":1904.0,"xmax":2189.0,"ymax":2136.0},{"id":40,"contenttext":"國民の煩","xmin":2581.0,"ymin":469.0,"xmax":2618.0,"ymax":578.0},{"id":41,"contenttext":"悶","xmin":2555.0,"ymin":472.0,"xmax":2585.0,"ymax":493.0},{"id":42,"contenttext":"情よりして漸次佛〓を信ぜんとせるものを生じ來れり。","xmin":1752.0,"ymin":683.0,"xmax":1814.0,"ymax":1788.0},{"id":43,"contenttext":"さたど極めて冷","xmin":1754.0,"ymin":1864.0,"xmax":1801.0,"ymax":2142.0},{"id":44,"contenttext":"靜なる頭腦を有せるものにあらざるよりは、","xmin":1680.0,"ymin":681.0,"xmax":1744.0,"ymax":1558.0},{"id":45,"contenttext":"直に之れに歸し去る能はず。","xmin":1673.0,"ymin":1623.0,"xmax":1735.0,"ymax":2149.0},{"id":46,"contenttext":"即ち多くは神道思想によりて鎔鑄陶冶せられたる强き精神權威の爲に容","xmin":1600.0,"ymin":679.0,"xmax":1673.0,"ymax":2138.0},{"id":47,"contenttext":"易に佛〓に入る能はず。","xmin":1541.0,"ymin":676.0,"xmax":1597.0,"ymax":1141.0},{"id":48,"contenttext":"頗る煩悶の狀に陷れり。","xmin":1533.0,"ymin":1194.0,"xmax":1591.0,"ymax":1644.0},{"id":49,"contenttext":"是に於いてか神佛習合","xmin":1527.0,"ymin":1713.0,"xmax":1586.0,"ymax":2138.0},{"id":50,"contenttext":"の企圖を見るに至れり。","xmin":1472.0,"ymin":679.0,"xmax":1524.0,"ymax":1135.0},{"id":51,"contenttext":"神佛習合は、","xmin":1400.0,"ymin":718.0,"xmax":1452.0,"ymax":950.0},{"id":52,"contenttext":"我が國の諸神を以つて印度の諸佛と元來異るものにあら","xmin":1382.0,"ymin":1002.0,"xmax":1450.0,"ymax":2134.0},{"id":53,"contenttext":"ずとし、","xmin":1330.0,"ymin":668.0,"xmax":1375.0,"ymax":808.0},{"id":54,"contenttext":"神佛の衝突を巧に脫せんとせるにあり。","xmin":1317.0,"ymin":856.0,"xmax":1377.0,"ymax":1640.0},{"id":55,"contenttext":"その濫觴は蓋し聖德太","xmin":1309.0,"ymin":1712.0,"xmax":1362.0,"ymax":2134.0},{"id":56,"contenttext":"子の言にありと云ひ得べし。","xmin":1250.0,"ymin":668.0,"xmax":1304.0,"ymax":1231.0},{"id":57,"contenttext":"『大日本史』","xmin":1244.0,"ymin":1256.0,"xmax":1299.0,"ymax":1460.0},{"id":58,"contenttext":"に曰はく「敏達帝十四年馬子疾あ","xmin":1236.0,"ymin":1518.0,"xmax":1294.0,"ymax":2132.0},{"id":59,"contenttext":"り、","xmin":1196.0,"ymin":668.0,"xmax":1230.0,"ymax":714.0},{"id":60,"contenttext":"奏して佛に禱らん〓とを請ふ。","xmin":1179.0,"ymin":759.0,"xmax":1235.0,"ymax":1317.0},{"id":61,"contenttext":"帝固より佛を好まず。","xmin":1172.0,"ymin":1376.0,"xmax":1225.0,"ymax":1776.0},{"id":62,"contenttext":"太子","xmin":1171.0,"ymin":1852.0,"xmax":1221.0,"ymax":1907.0},{"id":63,"contenttext":"聖","xmin":1192.0,"ymin":1946.0,"xmax":1226.0,"ymax":1948.0},{"id":64,"contenttext":"徳に謂ひ曰","xmin":1164.0,"ymin":1948.0,"xmax":1220.0,"ymax":2131.0},{"id":65,"contenttext":"はく、","xmin":1118.0,"ymin":668.0,"xmax":1157.0,"ymax":757.0},{"id":66,"contenttext":"我が國自ら神あり。","xmin":1105.0,"ymin":807.0,"xmax":1159.0,"ymax":1168.0},{"id":67,"contenttext":"今馬子異域の神を祭らんことを請ふ。","xmin":1095.0,"ymin":1232.0,"xmax":1154.0,"ymax":1961.0},{"id":68,"contenttext":"之れを","xmin":1095.0,"ymin":2038.0,"xmax":1142.0,"ymax":2128.0},{"id":69,"contenttext":"爲す如何。","xmin":1040.0,"ymin":666.0,"xmax":1089.0,"ymax":850.0},{"id":70,"contenttext":"太子曰はく諸佛の道諸神亦敢へて違はす」(皇子列傳)と。","xmin":1023.0,"ymin":902.0,"xmax":1088.0,"ymax":1960.0},{"id":71,"contenttext":"遂に帝","xmin":1023.0,"ymin":2038.0,"xmax":1070.0,"ymax":2128.0},{"id":72,"contenttext":"は馬子の請を允し給ひぬ。","xmin":965.0,"ymin":668.0,"xmax":1017.0,"ymax":1171.0},{"id":73,"contenttext":"已にして行基出で、","xmin":957.0,"ymin":1232.0,"xmax":1011.0,"ymax":1588.0},{"id":74,"contenttext":"盛に神佛を習合し、","xmin":950.0,"ymin":1658.0,"xmax":1006.0,"ymax":2007.0},{"id":75,"contenttext":"聖武","xmin":952.0,"ymin":2086.0,"xmax":998.0,"ymax":2132.0},{"id":76,"contenttext":"天皇を勸めて東大寺の大佛を建て、","xmin":888.0,"ymin":667.0,"xmax":946.0,"ymax":1358.0},{"id":77,"contenttext":"伊勢の太神宮と相對せしめぬ。","xmin":880.0,"ymin":1422.0,"xmax":934.0,"ymax":2002.0},{"id":78,"contenttext":"天皇","xmin":879.0,"ymin":2086.0,"xmax":928.0,"ymax":2130.0},{"id":79,"contenttext":"神道史綱要","xmin":830.0,"ymin":781.0,"xmax":871.0,"ymax":967.0},{"id":81,"contenttext":"神道習合","xmin":1416.0,"ymin":472.0,"xmax":1455.0,"ymax":580.0}]