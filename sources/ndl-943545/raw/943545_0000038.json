[{"id":0,"contenttext":"〓","xmin":3168.0,"ymin":1969.0,"xmax":3207.0,"ymax":2009.0},{"id":1,"contenttext":"以つて萬邦に照臨","xmin":3082.0,"ymin":1832.0,"xmax":3134.0,"ymax":2203.0},{"id":2,"contenttext":"し、","xmin":3111.0,"ymin":767.0,"xmax":3154.0,"ymax":827.0},{"id":3,"contenttext":"天の仁を體し、","xmin":3098.0,"ymin":858.0,"xmax":3158.0,"ymax":1154.0},{"id":4,"contenttext":"天の明に則り、","xmin":3095.0,"ymin":1184.0,"xmax":3148.0,"ymax":1477.0},{"id":5,"contenttext":"天の威を奮ひ、","xmin":3086.0,"ymin":1508.0,"xmax":3144.0,"ymax":1806.0},{"id":6,"contenttext":"以つて萬邦に照臨","xmin":3082.0,"ymin":1832.0,"xmax":3134.0,"ymax":2203.0},{"id":7,"contenttext":"せらる。","xmin":3035.0,"ymin":767.0,"xmax":3078.0,"ymax":917.0},{"id":8,"contenttext":"(新論)","xmin":3031.0,"ymin":935.0,"xmax":3078.0,"ymax":1050.0},{"id":9,"contenttext":"と。","xmin":2972.0,"ymin":722.0,"xmax":3006.0,"ymax":781.0},{"id":10,"contenttext":"而して曰はく、","xmin":2959.0,"ymin":812.0,"xmax":3009.0,"ymax":1104.0},{"id":11,"contenttext":"神聖既に神道を以つて〓を設く。","xmin":2873.0,"ymin":808.0,"xmax":2936.0,"ymax":1476.0},{"id":12,"contenttext":"民心を緝收する所以のもの、","xmin":2861.0,"ymin":1504.0,"xmax":2924.0,"ymax":2079.0},{"id":13,"contenttext":"專ら","xmin":2869.0,"ymin":2108.0,"xmax":2912.0,"ymax":2197.0},{"id":14,"contenttext":"一より出づ。","xmin":2813.0,"ymin":775.0,"xmax":2862.0,"ymax":1012.0},{"id":15,"contenttext":"固より成規あり。","xmin":2806.0,"ymin":1041.0,"xmax":2858.0,"ymax":1380.0},{"id":16,"contenttext":"而して天に事へ先を祀るの意、","xmin":2792.0,"ymin":1409.0,"xmax":2852.0,"ymax":2026.0},{"id":17,"contenttext":"之れを","xmin":2794.0,"ymin":2061.0,"xmax":2843.0,"ymax":2197.0},{"id":18,"contenttext":"後世に傳ふ。","xmin":2737.0,"ymin":759.0,"xmax":2789.0,"ymax":1008.0},{"id":19,"contenttext":"民、","xmin":2737.0,"ymin":1037.0,"xmax":2788.0,"ymax":1097.0},{"id":20,"contenttext":"本に報い、","xmin":2731.0,"ymin":1128.0,"xmax":2783.0,"ymax":1329.0},{"id":21,"contenttext":"始に反るの義を知る。","xmin":2722.0,"ymin":1357.0,"xmax":2780.0,"ymax":1793.0},{"id":22,"contenttext":"(同上)","xmin":2724.0,"ymin":1812.0,"xmax":2773.0,"ymax":1923.0},{"id":23,"contenttext":"x。","xmin":2671.0,"ymin":716.0,"xmax":2712.0,"ymax":772.0},{"id":24,"contenttext":"かくて彼れは、","xmin":2665.0,"ymin":806.0,"xmax":2714.0,"ymax":1100.0},{"id":25,"contenttext":"堯舜周孔の道、","xmin":2655.0,"ymin":1128.0,"xmax":2715.0,"ymax":1425.0},{"id":26,"contenttext":"天祖の葬訓と大いに同じと說けり。","xmin":2644.0,"ymin":1454.0,"xmax":2720.0,"ymax":2165.0},{"id":27,"contenttext":"是に於いてか、","xmin":2594.0,"ymin":710.0,"xmax":2645.0,"ymax":1007.0},{"id":28,"contenttext":"彼れは、","xmin":2589.0,"ymin":1035.0,"xmax":2641.0,"ymax":1192.0},{"id":29,"contenttext":"佛〓を罵りて「神明の邦を變じて、","xmin":2573.0,"ymin":1220.0,"xmax":2636.0,"ymax":1885.0},{"id":30,"contenttext":"以つて身毒の","xmin":2573.0,"ymin":1914.0,"xmax":2620.0,"ymax":2189.0},{"id":31,"contenttext":"國となし、","xmin":2520.0,"ymin":709.0,"xmax":2570.0,"ymax":913.0},{"id":32,"contenttext":"中原の赤子を駈りて、","xmin":2512.0,"ymin":939.0,"xmax":2568.0,"ymax":1374.0},{"id":33,"contenttext":"以つて西戎の徒屬となす」と云ひ、","xmin":2498.0,"ymin":1404.0,"xmax":2561.0,"ymax":2069.0},{"id":34,"contenttext":"儒佛","xmin":2502.0,"ymin":2100.0,"xmax":2551.0,"ymax":2193.0},{"id":35,"contenttext":"的神道を嘲りて、","xmin":2446.0,"ymin":708.0,"xmax":2495.0,"ymax":1048.0},{"id":36,"contenttext":"「儒佛を剽竊してその言を緣飾し、","xmin":2431.0,"ymin":1067.0,"xmax":2492.0,"ymax":1746.0},{"id":37,"contenttext":"以つて口を糊するの","xmin":2430.0,"ymin":1775.0,"xmax":2479.0,"ymax":2187.0},{"id":38,"contenttext":"資となす」と云ひ、","xmin":2375.0,"ymin":708.0,"xmax":2426.0,"ymax":1051.0},{"id":39,"contenttext":"而して我が宣長を攻擊しては、","xmin":2365.0,"ymin":1078.0,"xmax":2423.0,"ymax":1697.0},{"id":40,"contenttext":"曰はく、","xmin":2367.0,"ymin":1728.0,"xmax":2412.0,"ymax":1878.0},{"id":41,"contenttext":"本居の翁、","xmin":2303.0,"ymin":800.0,"xmax":2354.0,"ymax":1001.0},{"id":42,"contenttext":"數千歲の後に生れ、","xmin":2293.0,"ymin":1028.0,"xmax":2354.0,"ymax":1419.0},{"id":43,"contenttext":"開關以來一人も云へることなき無稽","xmin":2285.0,"ymin":1448.0,"xmax":2343.0,"ymax":2187.0},{"id":44,"contenttext":"の妄說を造言し、","xmin":2226.0,"ymin":755.0,"xmax":2282.0,"ymax":1094.0},{"id":45,"contenttext":"數千歲知るものなくして、","xmin":2219.0,"ymin":1121.0,"xmax":2274.0,"ymax":1648.0},{"id":46,"contenttext":"是を知りたるは己一人の","xmin":2213.0,"ymin":1677.0,"xmax":2262.0,"ymax":2181.0},{"id":47,"contenttext":"天の明に則り、","xmin":3095.0,"ymin":1184.0,"xmax":3148.0,"ymax":1477.0},{"id":48,"contenttext":"天の威を奮ひ、","xmin":3086.0,"ymin":1508.0,"xmax":3144.0,"ymax":1806.0},{"id":49,"contenttext":"堯舜の道","xmin":2685.0,"ymin":516.0,"xmax":2723.0,"ymax":635.0},{"id":50,"contenttext":"みなりしと思へるか。","xmin":1782.0,"ymin":749.0,"xmax":1831.0,"ymax":1181.0},{"id":51,"contenttext":"然らば開闢以來天地闇夜にして、","xmin":1777.0,"ymin":1211.0,"xmax":1828.0,"ymax":1874.0},{"id":52,"contenttext":"本居に至て始","xmin":1777.0,"ymin":1906.0,"xmax":1826.0,"ymax":2183.0},{"id":53,"contenttext":"て明なりと云はんか。","xmin":1706.0,"ymin":751.0,"xmax":1758.0,"ymax":1177.0},{"id":54,"contenttext":"數千歲本居の道なしと雖も、","xmin":1701.0,"ymin":1209.0,"xmax":1758.0,"ymax":1780.0},{"id":55,"contenttext":"世道人心に於いて","xmin":1704.0,"ymin":1812.0,"xmax":1758.0,"ymax":2181.0},{"id":56,"contenttext":"一も闕けたることなかりしに、","xmin":1636.0,"ymin":759.0,"xmax":1685.0,"ymax":1365.0},{"id":57,"contenttext":"今新に一箇の道を作り出して何の用を","xmin":1633.0,"ymin":1393.0,"xmax":1682.0,"ymax":2179.0},{"id":58,"contenttext":"かなさんや。","xmin":1564.0,"ymin":748.0,"xmax":1614.0,"ymax":994.0},{"id":59,"contenttext":"上古より人々離れ得ざるは天下の公道也。","xmin":1557.0,"ymin":1023.0,"xmax":1613.0,"ymax":1872.0},{"id":60,"contenttext":"古より知るも","xmin":1561.0,"ymin":1906.0,"xmax":1606.0,"ymax":2179.0},{"id":61,"contenttext":"のなく是を離れ居りて害もなかりしを、","xmin":1487.0,"ymin":749.0,"xmax":1542.0,"ymax":1552.0},{"id":62,"contenttext":"獨、","xmin":1488.0,"ymin":1579.0,"xmax":1537.0,"ymax":1645.0},{"id":63,"contenttext":"智を以つて作り出して、","xmin":1482.0,"ymin":1672.0,"xmax":1535.0,"ymax":2148.0},{"id":64,"contenttext":"數千載の公道と相反するは一己の私言也。","xmin":1411.0,"ymin":744.0,"xmax":1471.0,"ymax":1592.0},{"id":65,"contenttext":"(讀直日靈)","xmin":1414.0,"ymin":1611.0,"xmax":1463.0,"ymax":1817.0},{"id":66,"contenttext":"と。","xmin":1357.0,"ymin":704.0,"xmax":1392.0,"ymax":757.0},{"id":67,"contenttext":"蓋し宣長は力を極めて儒〓を排斥せるもの、","xmin":1340.0,"ymin":790.0,"xmax":1397.0,"ymax":1684.0},{"id":68,"contenttext":"而して正志は神儒一致","xmin":1341.0,"ymin":1714.0,"xmax":1391.0,"ymax":2179.0},{"id":69,"contenttext":"を說き、","xmin":1275.0,"ymin":698.0,"xmax":1322.0,"ymax":850.0},{"id":70,"contenttext":"大いに堯舜周孔を尊敬祖述せるもの。","xmin":1267.0,"ymin":884.0,"xmax":1322.0,"ymax":1639.0},{"id":71,"contenttext":"その說の一致せざる素よ","xmin":1265.0,"ymin":1670.0,"xmax":1319.0,"ymax":2177.0},{"id":72,"contenttext":"りその所也。","xmin":1206.0,"ymin":698.0,"xmax":1251.0,"ymax":944.0},{"id":73,"contenttext":"正志を承けて栗田寬あり。","xmin":1142.0,"ymin":730.0,"xmax":1197.0,"ymax":1252.0},{"id":74,"contenttext":"亦水戶に出づ。","xmin":1142.0,"ymin":1285.0,"xmax":1189.0,"ymax":1582.0},{"id":75,"contenttext":"文科大學授〓文學博士たり。","xmin":1140.0,"ymin":1609.0,"xmax":1187.0,"ymax":2181.0},{"id":76,"contenttext":"明治卅年一月廿六日を以つて逝く。","xmin":1069.0,"ymin":686.0,"xmax":1124.0,"ymax":1402.0},{"id":77,"contenttext":"年六十五。","xmin":1065.0,"ymin":1428.0,"xmax":1120.0,"ymax":1636.0},{"id":78,"contenttext":"その說に曰はく、","xmin":1063.0,"ymin":1662.0,"xmax":1118.0,"ymax":1993.0},{"id":79,"contenttext":"天地開闢の始、","xmin":997.0,"ymin":779.0,"xmax":1051.0,"ymax":1065.0},{"id":80,"contenttext":"未だ文字あらざるの時、","xmin":994.0,"ymin":1103.0,"xmax":1048.0,"ymax":1578.0},{"id":81,"contenttext":"天祖あり、","xmin":993.0,"ymin":1614.0,"xmax":1042.0,"ymax":1809.0},{"id":82,"contenttext":"天神あり、","xmin":991.0,"ymin":1847.0,"xmax":1040.0,"ymax":2040.0},{"id":83,"contenttext":"天祖","xmin":989.0,"ymin":2077.0,"xmax":1040.0,"ymax":2170.0},{"id":84,"contenttext":"の行ふ所、","xmin":925.0,"ymin":732.0,"xmax":978.0,"ymax":926.0},{"id":85,"contenttext":"天神の言ふ所のもの、","xmin":924.0,"ymin":962.0,"xmax":973.0,"ymax":1388.0},{"id":86,"contenttext":"萬民從つて之に經由し、","xmin":920.0,"ymin":1423.0,"xmax":969.0,"ymax":1901.0},{"id":87,"contenttext":"之に遵奉し","xmin":918.0,"ymin":1939.0,"xmax":968.0,"ymax":2170.0},{"id":88,"contenttext":"神道史綱要","xmin":854.0,"ymin":798.0,"xmax":895.0,"ymax":1003.0},{"id":89,"contenttext":"毫","xmin":852.0,"ymin":1926.0,"xmax":887.0,"ymax":1963.0},{"id":90,"contenttext":"栗田寬","xmin":1151.0,"ymin":522.0,"xmax":1188.0,"ymax":615.0}]