[{"id":0,"contenttext":"〓","xmin":3158.0,"ymin":1988.0,"xmax":3192.0,"ymax":2023.0},{"id":1,"contenttext":"ウマシミ","xmin":3129.0,"ymin":1090.0,"xmax":3160.0,"ymax":1175.0},{"id":2,"contenttext":":","xmin":3123.0,"ymin":1552.0,"xmax":3147.0,"ymax":1602.0},{"id":3,"contenttext":"り。『古事記』","xmin":3093.0,"ymin":775.0,"xmax":3152.0,"ymax":1029.0},{"id":4,"contenttext":"に味御路、","xmin":3086.0,"ymin":1054.0,"xmax":3139.0,"ymax":1257.0},{"id":5,"contenttext":"『日本紀』","xmin":3079.0,"ymin":1257.0,"xmax":3140.0,"ymax":1448.0},{"id":6,"contenttext":"に可怜御路とある、","xmin":3070.0,"ymin":1469.0,"xmax":3133.0,"ymax":1859.0},{"id":7,"contenttext":"是れ神代の古言","xmin":3063.0,"ymin":1884.0,"xmax":3125.0,"ymax":2208.0},{"id":8,"contenttext":"なり。","xmin":3027.0,"ymin":778.0,"xmax":3067.0,"ymax":877.0},{"id":9,"contenttext":"されば知と云ふも、","xmin":3009.0,"ymin":914.0,"xmax":3069.0,"ymax":1299.0},{"id":10,"contenttext":"美知と云ふも同じ事にて、","xmin":2997.0,"ymin":1329.0,"xmax":3060.0,"ymax":1857.0},{"id":11,"contenttext":"共に通路の意の","xmin":2988.0,"ymin":1884.0,"xmax":3048.0,"ymax":2206.0},{"id":12,"contenttext":"みにて、","xmin":2947.0,"ymin":774.0,"xmax":2994.0,"ymax":925.0},{"id":13,"contenttext":"其外の義は、","xmin":2937.0,"ymin":956.0,"xmax":2997.0,"ymax":1207.0},{"id":14,"contenttext":"上古は更になかりしなり。","xmin":2927.0,"ymin":1235.0,"xmax":2986.0,"ymax":1754.0},{"id":15,"contenttext":"(私叔言)","xmin":2923.0,"ymin":1777.0,"xmax":2976.0,"ymax":1942.0},{"id":16,"contenttext":"と。","xmin":2884.0,"ymin":731.0,"xmax":2918.0,"ymax":789.0},{"id":17,"contenttext":"誠に宣長の言の如く、","xmin":2863.0,"ymin":816.0,"xmax":2924.0,"ymax":1250.0},{"id":18,"contenttext":"我が上古には凡べての事象に就いて、","xmin":2845.0,"ymin":1279.0,"xmax":2915.0,"ymax":2043.0},{"id":19,"contenttext":"一般に","xmin":2842.0,"ymin":2074.0,"xmax":2895.0,"ymax":2201.0},{"id":20,"contenttext":"理論的研究を行ふの風存せざりしを以つて、","xmin":2780.0,"ymin":724.0,"xmax":2853.0,"ymax":1619.0},{"id":21,"contenttext":"美知なる語に就いても、","xmin":2772.0,"ymin":1646.0,"xmax":2830.0,"ymax":2128.0},{"id":22,"contenttext":"具","xmin":2771.0,"ymin":2157.0,"xmax":2816.0,"ymax":2203.0},{"id":23,"contenttext":"體的なる通路てふ意義の外、","xmin":2722.0,"ymin":720.0,"xmax":2779.0,"ymax":1292.0},{"id":24,"contenttext":"抽象的なる道義の觀念は存せざりし也。","xmin":2707.0,"ymin":1321.0,"xmax":2768.0,"ymax":2128.0},{"id":25,"contenttext":"さ","xmin":2714.0,"ymin":2161.0,"xmax":2743.0,"ymax":2195.0},{"id":26,"contenttext":"れば宣長亦曰はく、","xmin":2655.0,"ymin":719.0,"xmax":2717.0,"ymax":1105.0},{"id":27,"contenttext":"古の大御世には、","xmin":2581.0,"ymin":812.0,"xmax":2640.0,"ymax":1151.0},{"id":28,"contenttext":"道といふ言擧も、","xmin":2570.0,"ymin":1177.0,"xmax":2627.0,"ymax":1516.0},{"id":29,"contenttext":"コトアグ","xmin":2610.0,"ymin":1366.0,"xmax":2643.0,"ymax":1461.0},{"id":30,"contenttext":"さらになかりき。","xmin":2567.0,"ymin":1554.0,"xmax":2612.0,"ymax":1885.0},{"id":31,"contenttext":"(直毘靈)","xmin":2555.0,"ymin":1906.0,"xmax":2612.0,"ymax":2068.0},{"id":32,"contenttext":"ど。","xmin":2522.0,"ymin":722.0,"xmax":2557.0,"ymax":779.0},{"id":33,"contenttext":"然れども人若し宣長がかく道てふ言擧もなかりきと云へるを以つて、","xmin":2478.0,"ymin":807.0,"xmax":2563.0,"ymax":2204.0},{"id":34,"contenttext":"直に彼れが上古に於ける道なるものゝ存在を認めざるものとなさば、","xmin":2405.0,"ymin":715.0,"xmax":2493.0,"ymax":2120.0},{"id":35,"contenttext":"是","xmin":2408.0,"ymin":2147.0,"xmax":2455.0,"ymax":2195.0},{"id":36,"contenttext":"れ宣長を誣ふる","xmin":2361.0,"ymin":716.0,"xmax":2415.0,"ymax":1035.0},{"id":37,"contenttext":"沼田順義字は道意。","xmin":2350.0,"ymin":1126.0,"xmax":2398.0,"ymax":1503.0},{"id":38,"contenttext":"樂水と號す。","xmin":2341.0,"ymin":1547.0,"xmax":2386.0,"ymax":1782.0},{"id":39,"contenttext":"上野の人。","xmin":2335.0,"ymin":1829.0,"xmax":2382.0,"ymax":2018.0},{"id":40,"contenttext":"夙に儘","xmin":2333.0,"ymin":2063.0,"xmax":2371.0,"ymax":2192.0},{"id":41,"contenttext":"もの也。","xmin":2295.0,"ymin":716.0,"xmax":2338.0,"ymax":873.0},{"id":42,"contenttext":"彼の沼","xmin":2291.0,"ymin":898.0,"xmax":2340.0,"ymax":1038.0},{"id":43,"contenttext":"を學び、","xmin":2314.0,"ymin":1082.0,"xmax":2348.0,"ymax":1220.0},{"id":44,"contenttext":"更に醫を修めり。","xmin":2303.0,"ymin":1268.0,"xmax":2346.0,"ymax":1597.0},{"id":45,"contenttext":"壯年明を失ひ、","xmin":2293.0,"ymin":1643.0,"xmax":2339.0,"ymax":1926.0},{"id":46,"contenttext":"檢校となる。","xmin":2291.0,"ymin":1963.0,"xmax":2328.0,"ymax":2187.0},{"id":47,"contenttext":"盛に宣長の說を歌せり。","xmin":2257.0,"ymin":1081.0,"xmax":2308.0,"ymax":1548.0},{"id":48,"contenttext":"嘉永二年十二月十七日歿す。","xmin":2240.0,"ymin":1594.0,"xmax":2297.0,"ymax":2159.0},{"id":49,"contenttext":"田樂水が、","xmin":2213.0,"ymin":711.0,"xmax":2274.0,"ymax":917.0},{"id":50,"contenttext":"右の","xmin":2213.0,"ymin":943.0,"xmax":2260.0,"ymax":1034.0},{"id":51,"contenttext":"年五十八。","xmin":2220.0,"ymin":1080.0,"xmax":2260.0,"ymax":1265.0},{"id":52,"contenttext":"道てふ言","xmin":2606.0,"ymin":522.0,"xmax":2645.0,"ymax":644.0},{"id":53,"contenttext":"論","xmin":2579.0,"ymin":524.0,"xmax":2612.0,"ymax":556.0},{"id":54,"contenttext":"宣長の言を評して、","xmin":1777.0,"ymin":694.0,"xmax":1829.0,"ymax":1081.0},{"id":55,"contenttext":"\"","xmin":1747.0,"ymin":1156.0,"xmax":1776.0,"ymax":1204.0},{"id":56,"contenttext":"こはきたなき震且書ちふからぶみが中にも、","xmin":1707.0,"ymin":788.0,"xmax":1755.0,"ymax":1682.0},{"id":57,"contenttext":"とりわきて鳴乎なるを","xmin":1709.0,"ymin":1716.0,"xmax":1755.0,"ymax":2175.0},{"id":58,"contenttext":"7","xmin":1674.0,"ymin":1669.0,"xmax":1698.0,"ymax":1713.0},{"id":59,"contenttext":"のこどものいひ出づる、『老子』","xmin":1633.0,"ymin":739.0,"xmax":1682.0,"ymax":1361.0},{"id":60,"contenttext":"となむいへる書のことの葉に似かよひ","xmin":1633.0,"ymin":1389.0,"xmax":1680.0,"ymax":2173.0},{"id":61,"contenttext":"て、","xmin":1572.0,"ymin":743.0,"xmax":1606.0,"ymax":800.0},{"id":62,"contenttext":"民をうまれのまゝにおかんとする妄說なり。","xmin":1566.0,"ymin":833.0,"xmax":1610.0,"ymax":1727.0},{"id":63,"contenttext":"それものありてのち","xmin":1565.0,"ymin":1763.0,"xmax":1611.0,"ymax":2175.0},{"id":64,"contenttext":"にこそ名ちふこともあんなれ。","xmin":1494.0,"ymin":745.0,"xmax":1540.0,"ymax":1355.0},{"id":65,"contenttext":"たとひ神代に道ちふ言擧はあらじとも、","xmin":1492.0,"ymin":1391.0,"xmax":1541.0,"ymax":2183.0},{"id":66,"contenttext":"道ちふ事はなからずやは。","xmin":1414.0,"ymin":735.0,"xmax":1468.0,"ymax":1263.0},{"id":67,"contenttext":"(級長戶風)","xmin":1416.0,"ymin":1285.0,"xmax":1467.0,"ymax":1494.0},{"id":68,"contenttext":"と。","xmin":1349.0,"ymin":700.0,"xmax":1386.0,"ymax":754.0},{"id":69,"contenttext":"かく彼れは宣長が道といふ言擧もなかりきと云へるを、","xmin":1340.0,"ymin":788.0,"xmax":1394.0,"ymax":1917.0},{"id":70,"contenttext":"甚しく非難","xmin":1340.0,"ymin":1946.0,"xmax":1390.0,"ymax":2177.0},{"id":71,"contenttext":"せりと雖も、","xmin":1277.0,"ymin":698.0,"xmax":1322.0,"ymax":942.0},{"id":72,"contenttext":"而かも其の結論の同一に歸せるは、","xmin":1271.0,"ymin":976.0,"xmax":1325.0,"ymax":1682.0},{"id":73,"contenttext":"非難の正鵠を失せるも","xmin":1273.0,"ymin":1714.0,"xmax":1322.0,"ymax":2175.0},{"id":74,"contenttext":"のにあらずや。","xmin":1201.0,"ymin":698.0,"xmax":1250.0,"ymax":990.0},{"id":75,"contenttext":"彼の樂水の物ありて然る後名ありとせるは、","xmin":1202.0,"ymin":1019.0,"xmax":1252.0,"ymax":1913.0},{"id":76,"contenttext":"吾人其の理","xmin":1198.0,"ymin":1944.0,"xmax":1253.0,"ymax":2177.0},{"id":77,"contenttext":"たるを認む。","xmin":1130.0,"ymin":698.0,"xmax":1177.0,"ymax":942.0},{"id":78,"contenttext":"而かも是れ決して宣長の論據を動かすに足らず。","xmin":1130.0,"ymin":976.0,"xmax":1179.0,"ymax":1966.0},{"id":79,"contenttext":"蓋し、","xmin":1130.0,"ymin":1994.0,"xmax":1179.0,"ymax":2105.0},{"id":80,"contenttext":"宣","xmin":1130.0,"ymin":2131.0,"xmax":1179.0,"ymax":2179.0},{"id":81,"contenttext":"長が上古に道てふ言擧もなかりきとせるは、","xmin":1057.0,"ymin":696.0,"xmax":1107.0,"ymax":1590.0},{"id":82,"contenttext":"樂水の解せるが如く、","xmin":1057.0,"ymin":1622.0,"xmax":1107.0,"ymax":2056.0},{"id":83,"contenttext":"道な","xmin":1057.0,"ymin":2084.0,"xmax":1107.0,"ymax":2177.0},{"id":84,"contenttext":"しとせるに非れば也。","xmin":985.0,"ymin":696.0,"xmax":1032.0,"ymax":1130.0},{"id":85,"contenttext":"之れを彼れの言に徵せよ。","xmin":985.0,"ymin":1160.0,"xmax":1032.0,"ymax":1684.0},{"id":86,"contenttext":"曰はく、","xmin":987.0,"ymin":1720.0,"xmax":1030.0,"ymax":1870.0},{"id":87,"contenttext":"皇國の古は、","xmin":909.0,"ymin":790.0,"xmax":961.0,"ymax":1038.0},{"id":88,"contenttext":"さる言痛き〓も何もなかりしかど、","xmin":908.0,"ymin":1070.0,"xmax":961.0,"ymax":1775.0},{"id":89,"contenttext":"下が下まで亂るゝ","xmin":909.0,"ymin":1808.0,"xmax":958.0,"ymax":2168.0},{"id":90,"contenttext":"神道史綱要","xmin":842.0,"ymin":800.0,"xmax":883.0,"ymax":1016.0},{"id":91,"contenttext":"〓","xmin":842.0,"ymin":1951.0,"xmax":878.0,"ymax":1989.0}]