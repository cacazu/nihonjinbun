[{"id":0,"contenttext":"ㅎ","xmin":3174.0,"ymin":1965.0,"xmax":3209.0,"ymax":2005.0},{"id":1,"contenttext":"種の神器は、","xmin":3110.0,"ymin":701.0,"xmax":3166.0,"ymax":949.0},{"id":2,"contenttext":"神書の肝心、","xmin":3109.0,"ymin":980.0,"xmax":3160.0,"ymax":1228.0},{"id":3,"contenttext":"王法の樞機也。","xmin":3106.0,"ymin":1258.0,"xmax":3157.0,"ymax":1553.0},{"id":4,"contenttext":"何をか王法と云ふ。","xmin":3099.0,"ymin":1583.0,"xmax":3154.0,"ymax":1971.0},{"id":5,"contenttext":"蓋し儒佛","xmin":3100.0,"ymin":1998.0,"xmax":3151.0,"ymax":2185.0},{"id":6,"contenttext":"二〓一致の道理也。","xmin":3035.0,"ymin":702.0,"xmax":3093.0,"ymax":1090.0},{"id":7,"contenttext":"此れを除くの外、","xmin":3030.0,"ymin":1119.0,"xmax":3087.0,"ymax":1462.0},{"id":8,"contenttext":"豈に異道あらんや。","xmin":3028.0,"ymin":1489.0,"xmax":3081.0,"ymax":1874.0},{"id":9,"contenttext":"一致の理は亦","xmin":3027.0,"ymin":1916.0,"xmax":3078.0,"ymax":2183.0},{"id":10,"contenttext":"一心に起り。","xmin":2965.0,"ymin":710.0,"xmax":3015.0,"ymax":946.0},{"id":11,"contenttext":"心外に法なく、","xmin":2963.0,"ymin":980.0,"xmax":3012.0,"ymax":1267.0},{"id":12,"contenttext":"法外に心なし。","xmin":2954.0,"ymin":1302.0,"xmax":3010.0,"ymax":1597.0},{"id":13,"contenttext":"心は即ち是れ神。","xmin":2954.0,"ymin":1627.0,"xmax":3006.0,"ymax":1966.0},{"id":14,"contenttext":"法は即ち","xmin":2953.0,"ymin":1995.0,"xmax":3003.0,"ymax":2181.0},{"id":15,"contenttext":"是れ道。","xmin":2896.0,"ymin":700.0,"xmax":2945.0,"ymax":858.0},{"id":16,"contenttext":"一にして三、","xmin":2892.0,"ymin":896.0,"xmax":2939.0,"ymax":1134.0},{"id":17,"contenttext":"三にして一。","xmin":2892.0,"ymin":1166.0,"xmax":2937.0,"ymax":1410.0},{"id":18,"contenttext":"故に三器は即ち一心の標幟也」","xmin":2886.0,"ymin":1440.0,"xmax":2935.0,"ymax":2058.0},{"id":19,"contenttext":"(纂疏)","xmin":2884.0,"ymin":2069.0,"xmax":2933.0,"ymax":2183.0},{"id":20,"contenttext":"と云ひ、","xmin":2827.0,"ymin":702.0,"xmax":2871.0,"ymax":854.0},{"id":21,"contenttext":"旦つ曰はく、","xmin":2819.0,"ymin":885.0,"xmax":2873.0,"ymax":1133.0},{"id":22,"contenttext":"「孔丘の言に曰はく、","xmin":2813.0,"ymin":1151.0,"xmax":2870.0,"ymax":1550.0},{"id":23,"contenttext":"仁者は憂へず、","xmin":2813.0,"ymin":1583.0,"xmax":2864.0,"ymax":1876.0},{"id":24,"contenttext":"知者は感はず、","xmin":2812.0,"ymin":1908.0,"xmax":2861.0,"ymax":2187.0},{"id":25,"contenttext":"勇者は懼れず。","xmin":2750.0,"ymin":698.0,"xmax":2802.0,"ymax":996.0},{"id":26,"contenttext":"子思『中庸』の書に、","xmin":2743.0,"ymin":1022.0,"xmax":2803.0,"ymax":1411.0},{"id":27,"contenttext":"之れを三達德と云ふ。","xmin":2739.0,"ymin":1439.0,"xmax":2795.0,"ymax":1875.0},{"id":28,"contenttext":"聖人の道、","xmin":2741.0,"ymin":1906.0,"xmax":2790.0,"ymax":2107.0},{"id":29,"contenttext":"大","xmin":2741.0,"ymin":2137.0,"xmax":2790.0,"ymax":2181.0},{"id":30,"contenttext":"にして博しと雖も、","xmin":2680.0,"ymin":704.0,"xmax":2731.0,"ymax":1084.0},{"id":31,"contenttext":"究めて之れを言へば、","xmin":2671.0,"ymin":1114.0,"xmax":2727.0,"ymax":1550.0},{"id":32,"contenttext":"此の三者に過ぎず、","xmin":2671.0,"ymin":1581.0,"xmax":2722.0,"ymax":1970.0},{"id":33,"contenttext":"鏡の妍娼","xmin":2669.0,"ymin":1994.0,"xmax":2720.0,"ymax":2183.0},{"id":34,"contenttext":"を照すは即ち知の用也。","xmin":2599.0,"ymin":697.0,"xmax":2660.0,"ymax":1180.0},{"id":35,"contenttext":"玉の温潤を含むは、","xmin":2596.0,"ymin":1209.0,"xmax":2652.0,"ymax":1597.0},{"id":36,"contenttext":"即ち仁の德也。","xmin":2594.0,"ymin":1626.0,"xmax":2646.0,"ymax":1921.0},{"id":37,"contenttext":"劍の能く剛","xmin":2594.0,"ymin":1949.0,"xmax":2643.0,"ymax":2181.0},{"id":38,"contenttext":"利なるは即ち勇の義也」(纂疏)","xmin":2524.0,"ymin":700.0,"xmax":2580.0,"ymax":1294.0},{"id":39,"contenttext":"と云ひ、","xmin":2524.0,"ymin":1297.0,"xmax":2571.0,"ymax":1453.0},{"id":40,"contenttext":"更に三種の神器を佛〓に比し、","xmin":2520.0,"ymin":1483.0,"xmax":2569.0,"ymax":2105.0},{"id":41,"contenttext":"鏡","xmin":2520.0,"ymin":2120.0,"xmax":2569.0,"ymax":2181.0},{"id":42,"contenttext":"の能く照すは般若也。","xmin":2456.0,"ymin":700.0,"xmax":2506.0,"ymax":1128.0},{"id":43,"contenttext":"玉の能く潔きは法身也。","xmin":2449.0,"ymin":1161.0,"xmax":2503.0,"ymax":1641.0},{"id":44,"contenttext":"劔の能く斷ずるは解脫也」","xmin":2446.0,"ymin":1671.0,"xmax":2498.0,"ymax":2177.0},{"id":45,"contenttext":"と說き、","xmin":2385.0,"ymin":700.0,"xmax":2434.0,"ymax":852.0},{"id":46,"contenttext":"之れを一心に歸し、","xmin":2377.0,"ymin":881.0,"xmax":2435.0,"ymax":1270.0},{"id":47,"contenttext":"之れを根柢として、","xmin":2377.0,"ymin":1299.0,"xmax":2428.0,"ymax":1686.0},{"id":48,"contenttext":"その神道を構成せり。","xmin":2373.0,"ymin":1716.0,"xmax":2422.0,"ymax":2146.0},{"id":49,"contenttext":"要するに親房、","xmin":2305.0,"ymin":749.0,"xmax":2356.0,"ymax":1028.0},{"id":50,"contenttext":"兼良二卿は皆三種の神器を以つて其の神道說を成せり。","xmin":2292.0,"ymin":1057.0,"xmax":2354.0,"ymax":2171.0},{"id":51,"contenttext":"三種の神器は我が國家の一大事實。","xmin":2226.0,"ymin":714.0,"xmax":2287.0,"ymax":1427.0},{"id":52,"contenttext":"二卿の着眼凡ならざるを見るべし。","xmin":2219.0,"ymin":1452.0,"xmax":2276.0,"ymax":2167.0},{"id":53,"contenttext":"ト部兼倶","xmin":1835.0,"ymin":498.0,"xmax":1871.0,"ymax":617.0},{"id":54,"contenttext":"一條兼良と殆んど同時にト部家には、","xmin":1823.0,"ymin":751.0,"xmax":1876.0,"ymax":1498.0},{"id":55,"contenttext":"兼倶ありて、","xmin":1827.0,"ymin":1532.0,"xmax":1876.0,"ymax":1776.0},{"id":56,"contenttext":"盛に吾人の已に述","xmin":1827.0,"ymin":1808.0,"xmax":1878.0,"ymax":2179.0},{"id":57,"contenttext":"べたるが如き唯一神道の學說を講究組織し、","xmin":1751.0,"ymin":702.0,"xmax":1803.0,"ymax":1590.0},{"id":58,"contenttext":"且つ當時の將軍、","xmin":1750.0,"ymin":1621.0,"xmax":1805.0,"ymax":1962.0},{"id":59,"contenttext":"足利義政","xmin":1754.0,"ymin":1994.0,"xmax":1805.0,"ymax":2179.0},{"id":60,"contenttext":"及びその室富子の爲に信任せられ、","xmin":1676.0,"ymin":694.0,"xmax":1730.0,"ymax":1404.0},{"id":61,"contenttext":"神祇長上たるを公認せられ、","xmin":1678.0,"ymin":1434.0,"xmax":1730.0,"ymax":2009.0},{"id":62,"contenttext":"天下の","xmin":1680.0,"ymin":2039.0,"xmax":1730.0,"ymax":2175.0},{"id":63,"contenttext":"神社を支配するの權を得ぬ。","xmin":1606.0,"ymin":696.0,"xmax":1655.0,"ymax":1265.0},{"id":64,"contenttext":"足利義尙尋いで立つや、","xmin":1608.0,"ymin":1299.0,"xmax":1657.0,"ymax":1776.0},{"id":65,"contenttext":"又之れに神書を進","xmin":1608.0,"ymin":1804.0,"xmax":1660.0,"ymax":2177.0},{"id":66,"contenttext":"講せり。","xmin":1535.0,"ymin":696.0,"xmax":1580.0,"ymax":848.0},{"id":67,"contenttext":"賴襄曰はく、","xmin":1533.0,"ymin":880.0,"xmax":1580.0,"ymax":1126.0},{"id":68,"contenttext":"「吾れ甞て稱す。","xmin":1535.0,"ymin":1146.0,"xmax":1582.0,"ymax":1449.0},{"id":69,"contenttext":"王業衰へて神道興る。","xmin":1533.0,"ymin":1483.0,"xmax":1584.0,"ymax":1915.0},{"id":70,"contenttext":"何となれば","xmin":1533.0,"ymin":1947.0,"xmax":1580.0,"ymax":2177.0},{"id":71,"contenttext":"即ち是れ祖宗の事也。","xmin":1454.0,"ymin":696.0,"xmax":1510.0,"ymax":1126.0},{"id":72,"contenttext":"王政盛なる時に當り、","xmin":1457.0,"ymin":1158.0,"xmax":1506.0,"ymax":1590.0},{"id":73,"contenttext":"誰れか敢へて之れを口舌に","xmin":1455.0,"ymin":1623.0,"xmax":1512.0,"ymax":2179.0},{"id":74,"contenttext":"騰し、","xmin":1386.0,"ymin":694.0,"xmax":1431.0,"ymax":801.0},{"id":75,"contenttext":"以つて私說を樹てんや。","xmin":1386.0,"ymin":833.0,"xmax":1435.0,"ymax":1310.0},{"id":76,"contenttext":"之れを口舌に騰し、","xmin":1386.0,"ymin":1342.0,"xmax":1435.0,"ymax":1731.0},{"id":77,"contenttext":"以つて私說を樹つる","xmin":1386.0,"ymin":1761.0,"xmax":1433.0,"ymax":2173.0},{"id":78,"contenttext":"は、","xmin":1314.0,"ymin":696.0,"xmax":1355.0,"ymax":756.0},{"id":79,"contenttext":"ト部兼倶の足利義尙に〓ふるに始まる」日本政記)と。","xmin":1310.0,"ymin":788.0,"xmax":1359.0,"ymax":1819.0},{"id":80,"contenttext":"蓋しト部家の神","xmin":1310.0,"ymin":1852.0,"xmax":1361.0,"ymax":2177.0},{"id":81,"contenttext":"道は、","xmin":1236.0,"ymin":694.0,"xmax":1286.0,"ymax":801.0},{"id":82,"contenttext":"殆んど兼倶によりて興隆せられたるものと云ひ得べき也。","xmin":1236.0,"ymin":833.0,"xmax":1286.0,"ymax":2007.0},{"id":83,"contenttext":"兼倶の","xmin":1236.0,"ymin":2041.0,"xmax":1286.0,"ymax":2177.0},{"id":84,"contenttext":"歿後、","xmin":1165.0,"ymin":696.0,"xmax":1214.0,"ymax":805.0},{"id":85,"contenttext":"ト部家には又兼倶の如き器なかりしが、","xmin":1167.0,"ymin":835.0,"xmax":1214.0,"ymax":1635.0},{"id":86,"contenttext":"獨り萩原兼從あり。","xmin":1167.0,"ymin":1665.0,"xmax":1214.0,"ymax":2048.0},{"id":87,"contenttext":"ト部","xmin":1169.0,"ymin":2088.0,"xmax":1212.0,"ymax":2175.0},{"id":88,"contenttext":"家の嫡傳を承けりと稱す。","xmin":1091.0,"ymin":694.0,"xmax":1140.0,"ymax":1218.0},{"id":89,"contenttext":"偶〓江戶に吉川惟足出づ。","xmin":1091.0,"ymin":1250.0,"xmax":1141.0,"ymax":1733.0},{"id":90,"contenttext":"深く神道に志し、","xmin":1089.0,"ymin":1759.0,"xmax":1140.0,"ymax":2101.0},{"id":91,"contenttext":"親","xmin":1091.0,"ymin":2131.0,"xmax":1140.0,"ymax":2179.0},{"id":92,"contenttext":"しく萩原兼從に就いて唯一神道の秘奥を傳はれりと云ふ。","xmin":1018.0,"ymin":694.0,"xmax":1067.0,"ymax":1870.0},{"id":93,"contenttext":"惟足は、","xmin":946.0,"ymin":739.0,"xmax":991.0,"ymax":893.0},{"id":94,"contenttext":"從來の唯一神道の說に、","xmin":943.0,"ymin":927.0,"xmax":992.0,"ymax":1406.0},{"id":95,"contenttext":"親房·兼良二卿の說を折衷し、","xmin":943.0,"ymin":1438.0,"xmax":994.0,"ymax":2011.0},{"id":96,"contenttext":"而して","xmin":942.0,"ymin":2037.0,"xmax":989.0,"ymax":2175.0},{"id":97,"contenttext":"神道史綱要","xmin":868.0,"ymin":808.0,"xmax":911.0,"ymax":1014.0},{"id":98,"contenttext":"二","xmin":875.0,"ymin":1949.0,"xmax":906.0,"ymax":1984.0},{"id":99,"contenttext":"吉川流の","xmin":952.0,"ymin":498.0,"xmax":989.0,"ymax":613.0},{"id":100,"contenttext":"神道","xmin":928.0,"ymin":496.0,"xmax":961.0,"ymax":560.0},{"id":101,"contenttext":"而して","xmin":942.0,"ymin":2037.0,"xmax":989.0,"ymax":2175.0}]