[{"id":0,"contenttext":"〓","xmin":3139.0,"ymin":1975.0,"xmax":3174.0,"ymax":2011.0},{"id":1,"contenttext":"天明七年、","xmin":3080.0,"ymin":760.0,"xmax":3140.0,"ymax":966.0},{"id":2,"contenttext":"紀伊侯より政治經濟の事を問はれ、","xmin":3060.0,"ymin":995.0,"xmax":3134.0,"ymax":1708.0},{"id":3,"contenttext":"先きに著はせる王匣と","xmin":3053.0,"ymin":1736.0,"xmax":3109.0,"ymax":2200.0},{"id":4,"contenttext":"共に、","xmin":3015.0,"ymin":714.0,"xmax":3066.0,"ymax":826.0},{"id":5,"contenttext":"新に候の爲に「秘本玉匣」を著はして奉れり。","xmin":2987.0,"ymin":854.0,"xmax":3061.0,"ymax":1701.0},{"id":6,"contenttext":"是れより、","xmin":2988.0,"ymin":1734.0,"xmax":3035.0,"ymax":1933.0},{"id":7,"contenttext":"屢〓和歌山に","xmin":2982.0,"ymin":1967.0,"xmax":3031.0,"ymax":2193.0},{"id":8,"contenttext":"赴き、","xmin":2941.0,"ymin":714.0,"xmax":2988.0,"ymax":822.0},{"id":9,"contenttext":"紀伊侯の爲に道を講じ、","xmin":2923.0,"ymin":852.0,"xmax":2989.0,"ymax":1334.0},{"id":10,"contenttext":"內にありては門人日に進み、","xmin":2907.0,"ymin":1359.0,"xmax":2975.0,"ymax":1936.0},{"id":11,"contenttext":"厚く之れが","xmin":2903.0,"ymin":1964.0,"xmax":2959.0,"ymax":2194.0},{"id":12,"contenttext":"〓育に從事せり。","xmin":2857.0,"ymin":711.0,"xmax":2917.0,"ymax":1051.0},{"id":13,"contenttext":"かくて寛政十年に至り、","xmin":2844.0,"ymin":1081.0,"xmax":2905.0,"ymax":1560.0},{"id":14,"contenttext":"「古事記傳」全く成りぬ。","xmin":2830.0,"ymin":1582.0,"xmax":2894.0,"ymax":2028.0},{"id":15,"contenttext":"彼れ自","xmin":2833.0,"ymin":2057.0,"xmax":2880.0,"ymax":2193.0},{"id":16,"contenttext":"ら曰はく、","xmin":2798.0,"ymin":714.0,"xmax":2841.0,"ymax":905.0},{"id":17,"contenttext":"「古事記傳」も、","xmin":2716.0,"ymin":789.0,"xmax":2775.0,"ymax":1052.0},{"id":18,"contenttext":"當月十三日全部四十四卷、","xmin":2699.0,"ymin":1077.0,"xmax":2766.0,"ymax":1610.0},{"id":19,"contenttext":"卒業。","xmin":2700.0,"ymin":1632.0,"xmax":2751.0,"ymax":1743.0},{"id":20,"contenttext":"草稿本書立申候。","xmin":2688.0,"ymin":1772.0,"xmax":2749.0,"ymax":2116.0},{"id":21,"contenttext":"明","xmin":2690.0,"ymin":2145.0,"xmax":2734.0,"ymax":2189.0},{"id":22,"contenttext":"和四年より書はじめ、","xmin":2638.0,"ymin":754.0,"xmax":2701.0,"ymax":1185.0},{"id":23,"contenttext":"三十二年にして終申候。","xmin":2625.0,"ymin":1214.0,"xmax":2685.0,"ymax":1693.0},{"id":24,"contenttext":"命の程を危く存候處、","xmin":2616.0,"ymin":1723.0,"xmax":2672.0,"ymax":2159.0},{"id":25,"contenttext":"皇神の御めぐみにかゝり、","xmin":2565.0,"ymin":752.0,"xmax":2630.0,"ymax":1272.0},{"id":26,"contenttext":"先存命仕りて生涯の願望成就仕、","xmin":2548.0,"ymin":1304.0,"xmax":2613.0,"ymax":1973.0},{"id":27,"contenttext":"大悅の至","xmin":2549.0,"ymin":2002.0,"xmax":2596.0,"ymax":2185.0},{"id":28,"contenttext":"に存候儀に御座候。","xmin":2497.0,"ymin":752.0,"xmax":2560.0,"ymax":1137.0},{"id":29,"contenttext":"(與荒木田久老書)","xmin":2487.0,"ymin":1153.0,"xmax":2548.0,"ymax":1500.0},{"id":30,"contenttext":"と0","xmin":2444.0,"ymin":704.0,"xmax":2474.0,"ymax":762.0},{"id":31,"contenttext":"實に「古事記傳」四十四卷の洪著は、","xmin":2414.0,"ymin":791.0,"xmax":2483.0,"ymax":1460.0},{"id":32,"contenttext":"宣長終生の大業、","xmin":2404.0,"ymin":1488.0,"xmax":2465.0,"ymax":1832.0},{"id":33,"contenttext":"〓究考覈、","xmin":2399.0,"ymin":1858.0,"xmax":2455.0,"ymax":2065.0},{"id":34,"contenttext":"苦辛","xmin":2401.0,"ymin":2092.0,"xmax":2446.0,"ymax":2183.0},{"id":35,"contenttext":"慘憺、","xmin":2361.0,"ymin":697.0,"xmax":2411.0,"ymax":809.0},{"id":36,"contenttext":"博く諸書に渉り、","xmin":2354.0,"ymin":838.0,"xmax":2407.0,"ymax":1176.0},{"id":37,"contenttext":"深く群籍を獵り、","xmin":2340.0,"ymin":1208.0,"xmax":2399.0,"ymax":1546.0},{"id":38,"contenttext":"識見卓拔、","xmin":2335.0,"ymin":1578.0,"xmax":2390.0,"ymax":1783.0},{"id":39,"contenttext":"實に古道學の寶典","xmin":2326.0,"ymin":1809.0,"xmax":2386.0,"ymax":2184.0},{"id":40,"contenttext":"たるに足る。","xmin":2284.0,"ymin":699.0,"xmax":2337.0,"ymax":949.0},{"id":41,"contenttext":"かく宣長、","xmin":2211.0,"ymin":745.0,"xmax":2258.0,"ymax":942.0},{"id":42,"contenttext":"苦辛慘憺、","xmin":2204.0,"ymin":973.0,"xmax":2257.0,"ymax":1178.0},{"id":43,"contenttext":"〓究考覈せしかば、","xmin":2191.0,"ymin":1204.0,"xmax":2253.0,"ymax":1595.0},{"id":44,"contenttext":"「古事記","xmin":2700.0,"ymin":509.0,"xmax":2741.0,"ymax":615.0},{"id":45,"contenttext":"傳","xmin":2679.0,"ymin":514.0,"xmax":2710.0,"ymax":564.0},{"id":46,"contenttext":"苦辛慘憺、","xmin":2204.0,"ymin":973.0,"xmax":2257.0,"ymax":1178.0},{"id":47,"contenttext":"〓究考覈せしかば、","xmin":2191.0,"ymin":1204.0,"xmax":2253.0,"ymax":1595.0},{"id":48,"contenttext":"その博學宏才、","xmin":2184.0,"ymin":1623.0,"xmax":2241.0,"ymax":1922.0},{"id":49,"contenttext":"實に天下を","xmin":2183.0,"ymin":1947.0,"xmax":2230.0,"ymax":2177.0},{"id":50,"contenttext":"を驚倒せしめたり。","xmin":1803.0,"ymin":702.0,"xmax":1850.0,"ymax":1085.0},{"id":51,"contenttext":"享和元年九月二十九日歿す。","xmin":1798.0,"ymin":1119.0,"xmax":1852.0,"ymax":1692.0},{"id":52,"contenttext":"年七十二。","xmin":1798.0,"ymin":1720.0,"xmax":1852.0,"ymax":1926.0},{"id":53,"contenttext":"著はす所、","xmin":1801.0,"ymin":1952.0,"xmax":1851.0,"ymax":2149.0},{"id":54,"contenttext":"五十部、","xmin":1729.0,"ymin":702.0,"xmax":1779.0,"ymax":852.0},{"id":55,"contenttext":"百三十餘卷に達せり。","xmin":1727.0,"ymin":886.0,"xmax":1776.0,"ymax":1318.0},{"id":56,"contenttext":"宣長は先づ神の意義を以つて、","xmin":1655.0,"ymin":747.0,"xmax":1704.0,"ymax":1361.0},{"id":57,"contenttext":"尋常に卓越せる德を有し畏るべき性能","xmin":1655.0,"ymin":1397.0,"xmax":1704.0,"ymax":2183.0},{"id":58,"contenttext":"モロ〓〓","xmin":1625.0,"ymin":1511.0,"xmax":1649.0,"ymax":1588.0},{"id":59,"contenttext":"を有せるものとし、","xmin":1584.0,"ymin":702.0,"xmax":1631.0,"ymax":1081.0},{"id":60,"contenttext":"古典に見ゆる天地の諸の神だちを初めて、","xmin":1582.0,"ymin":1117.0,"xmax":1633.0,"ymax":1963.0},{"id":61,"contenttext":"そを祀れ","xmin":1584.0,"ymin":2002.0,"xmax":1631.0,"ymax":2183.0},{"id":62,"contenttext":"る社に坐す御靈をも申し、","xmin":1508.0,"ymin":704.0,"xmax":1556.0,"ymax":1222.0},{"id":63,"contenttext":"又人はさらにも云はず、","xmin":1508.0,"ymin":1258.0,"xmax":1556.0,"ymax":1731.0},{"id":64,"contenttext":"鳥獸木草までも皆か","xmin":1508.0,"ymin":1769.0,"xmax":1556.0,"ymax":2179.0},{"id":65,"contenttext":"ゝる德を有するものは神となしぬ。","xmin":1443.0,"ymin":710.0,"xmax":1486.0,"ymax":1412.0},{"id":66,"contenttext":"從つて宣長は神に善惡ありとし、","xmin":1441.0,"ymin":1444.0,"xmax":1488.0,"ymax":2105.0},{"id":67,"contenttext":"吉","xmin":1443.0,"ymin":2141.0,"xmax":1486.0,"ymax":2187.0},{"id":68,"contenttext":"凶禍福も之れによりて生ずとなせり。","xmin":1365.0,"ymin":702.0,"xmax":1413.0,"ymax":1459.0},{"id":69,"contenttext":"されど彼れの主張にかゝる「神の道」","xmin":1365.0,"ymin":1491.0,"xmax":1416.0,"ymax":2193.0},{"id":70,"contenttext":"の神なるものは、","xmin":1292.0,"ymin":702.0,"xmax":1339.0,"ymax":1028.0},{"id":71,"contenttext":"必ずしも鳥獸草木までも意味する神にはあらざるが如し。","xmin":1290.0,"ymin":1056.0,"xmax":1341.0,"ymax":2195.0},{"id":72,"contenttext":"故に彼れ曰はく、","xmin":1218.0,"ymin":698.0,"xmax":1267.0,"ymax":1034.0},{"id":73,"contenttext":"「皇國の神道は、","xmin":1214.0,"ymin":1060.0,"xmax":1267.0,"ymax":1361.0},{"id":74,"contenttext":"皇祖神の始め賜ひたもち賜ふ道なり」と。","xmin":1216.0,"ymin":1397.0,"xmax":1269.0,"ymax":2195.0},{"id":75,"contenttext":"以つて彼れの神の觀念知るべき也。","xmin":1147.0,"ymin":700.0,"xmax":1194.0,"ymax":1414.0},{"id":76,"contenttext":"吾人は更に進んでその道なるものに","xmin":1149.0,"ymin":1444.0,"xmax":1193.0,"ymax":2180.0},{"id":77,"contenttext":"就いて述べざるべからず。","xmin":1069.0,"ymin":698.0,"xmax":1117.0,"ymax":1224.0},{"id":78,"contenttext":"彼れは先づ道なる文字を解して曰はく、","xmin":1069.0,"ymin":1254.0,"xmax":1122.0,"ymax":2052.0},{"id":79,"contenttext":"美知は御路にて、","xmin":987.0,"ymin":792.0,"xmax":1038.0,"ymax":1128.0},{"id":80,"contenttext":"知と云ふが本語なり。","xmin":985.0,"ymin":1164.0,"xmax":1038.0,"ymax":1598.0},{"id":81,"contenttext":"今も山路·野路·舟路通ひ路な","xmin":987.0,"ymin":1626.0,"xmax":1038.0,"ymax":2183.0},{"id":82,"contenttext":"どは、","xmin":915.0,"ymin":747.0,"xmax":960.0,"ymax":846.0},{"id":83,"contenttext":"知とのみ云ふを以て知るべし。","xmin":914.0,"ymin":886.0,"xmax":962.0,"ymax":1504.0},{"id":84,"contenttext":"それに美をそへて美知と云ふな","xmin":914.0,"ymin":1532.0,"xmax":962.0,"ymax":2178.0},{"id":85,"contenttext":"神道史綱要","xmin":846.0,"ymin":821.0,"xmax":885.0,"ymax":1026.0},{"id":86,"contenttext":"三五","xmin":846.0,"ymin":1965.0,"xmax":879.0,"ymax":2001.0},{"id":87,"contenttext":"年七十二。","xmin":1798.0,"ymin":1720.0,"xmax":1852.0,"ymax":1926.0},{"id":88,"contenttext":"著はす所、","xmin":1801.0,"ymin":1952.0,"xmax":1851.0,"ymax":2149.0},{"id":89,"contenttext":"神の意義","xmin":1654.0,"ymin":503.0,"xmax":1696.0,"ymax":626.0},{"id":90,"contenttext":"道の字義","xmin":1067.0,"ymin":502.0,"xmax":1108.0,"ymax":623.0}]