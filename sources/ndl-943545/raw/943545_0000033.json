[{"id":0,"contenttext":"要","xmin":3158.0,"ymin":1967.0,"xmax":3196.0,"ymax":2007.0},{"id":1,"contenttext":"記して、","xmin":3078.0,"ymin":747.0,"xmax":3125.0,"ymax":903.0},{"id":2,"contenttext":"わが神代の古傳說を蔑如せり。","xmin":3073.0,"ymin":935.0,"xmax":3127.0,"ymax":1558.0},{"id":3,"contenttext":"門人鈴木重胤之を憤り、","xmin":3068.0,"ymin":1587.0,"xmax":3126.0,"ymax":2069.0},{"id":4,"contenttext":"辨ぜ","xmin":3072.0,"ymin":2098.0,"xmax":3117.0,"ymax":2191.0},{"id":5,"contenttext":"んことを請ふ。","xmin":3008.0,"ymin":749.0,"xmax":3050.0,"ymax":1046.0},{"id":6,"contenttext":"世にかゝる惑の人おほかりと見ゆれば、","xmin":2999.0,"ymin":1074.0,"xmax":3052.0,"ymax":1882.0},{"id":7,"contenttext":"さる人々にも","xmin":3002.0,"ymin":1918.0,"xmax":3045.0,"ymax":2193.0},{"id":8,"contenttext":"見せまほしくて、","xmin":2937.0,"ymin":749.0,"xmax":2982.0,"ymax":1091.0},{"id":9,"contenttext":"重胤が請にまかせぬるこの「憐駁者」なり。","xmin":2930.0,"ymin":1123.0,"xmax":2982.0,"ymax":1925.0},{"id":10,"contenttext":"(憐駁者)","xmin":2929.0,"ymin":1945.0,"xmax":2977.0,"ymax":2111.0},{"id":11,"contenttext":"と。","xmin":2874.0,"ymin":704.0,"xmax":2902.0,"ymax":759.0},{"id":12,"contenttext":"已にして居を京師にトし、","xmin":2859.0,"ymin":794.0,"xmax":2908.0,"ymax":1324.0},{"id":13,"contenttext":"帷を下して諸生に〓授す。","xmin":2854.0,"ymin":1354.0,"xmax":2907.0,"ymax":1882.0},{"id":14,"contenttext":"名けて報本學","xmin":2853.0,"ymin":1910.0,"xmax":2904.0,"ymax":2187.0},{"id":15,"contenttext":"舍と云ふ。","xmin":2786.0,"ymin":700.0,"xmax":2835.0,"ymax":901.0},{"id":16,"contenttext":"是れより諸方の求めに應じて學を講じ、","xmin":2781.0,"ymin":933.0,"xmax":2835.0,"ymax":1741.0},{"id":17,"contenttext":"名、","xmin":2782.0,"ymin":1771.0,"xmax":2831.0,"ymax":1841.0},{"id":18,"contenttext":"關西に振ふ。","xmin":2782.0,"ymin":1863.0,"xmax":2831.0,"ymax":2113.0},{"id":19,"contenttext":"津","xmin":2784.0,"ymin":2143.0,"xmax":2829.0,"ymax":2187.0},{"id":20,"contenttext":"和野藩主龜井侯、","xmin":2710.0,"ymin":698.0,"xmax":2761.0,"ymax":1042.0},{"id":21,"contenttext":"隆正の博學を嘉みし、","xmin":2708.0,"ymin":1074.0,"xmax":2761.0,"ymax":1510.0},{"id":22,"contenttext":"諭して藩籍に復せしむ。","xmin":2706.0,"ymin":1540.0,"xmax":2755.0,"ymax":2019.0},{"id":23,"contenttext":"隆正之","xmin":2704.0,"ymin":2047.0,"xmax":2755.0,"ymax":2191.0},{"id":24,"contenttext":"れに從ひ、","xmin":2638.0,"ymin":702.0,"xmax":2685.0,"ymax":903.0},{"id":25,"contenttext":"津和野と江戶とに往來し、","xmin":2634.0,"ymin":933.0,"xmax":2686.0,"ymax":1461.0},{"id":26,"contenttext":"皇典を以つて藩の子弟を〓授せり。","xmin":2631.0,"ymin":1493.0,"xmax":2682.0,"ymax":2197.0},{"id":27,"contenttext":"明治四年八月十七日東京津和野藩邸に歿す。","xmin":2561.0,"ymin":698.0,"xmax":2610.0,"ymax":1609.0},{"id":28,"contenttext":"年八十。","xmin":2559.0,"ymin":1642.0,"xmax":2610.0,"ymax":1803.0},{"id":29,"contenttext":"著はす所、","xmin":2491.0,"ymin":745.0,"xmax":2540.0,"ymax":952.0},{"id":30,"contenttext":"「本學擧要」二卷、","xmin":2489.0,"ymin":964.0,"xmax":2540.0,"ymax":1277.0},{"id":31,"contenttext":"「本〓神理說」一卷、","xmin":2487.0,"ymin":1291.0,"xmax":2538.0,"ymax":1649.0},{"id":32,"contenttext":"「神代校異傳五卷、","xmin":2482.0,"ymin":1666.0,"xmax":2540.0,"ymax":2019.0},{"id":33,"contenttext":"「憐駁者」","xmin":2485.0,"ymin":2037.0,"xmax":2532.0,"ymax":2201.0},{"id":34,"contenttext":"二卷、","xmin":2422.0,"ymin":700.0,"xmax":2471.0,"ymax":807.0},{"id":35,"contenttext":"「歌學入門」一卷、","xmin":2419.0,"ymin":826.0,"xmax":2470.0,"ymax":1135.0},{"id":36,"contenttext":"「眞誥眞釋」二卷、","xmin":2417.0,"ymin":1153.0,"xmax":2471.0,"ymax":1464.0},{"id":37,"contenttext":"「古傳通解」九卷、","xmin":2416.0,"ymin":1481.0,"xmax":2467.0,"ymax":1788.0},{"id":38,"contenttext":"「昇降運轉」一卷、","xmin":2412.0,"ymin":1805.0,"xmax":2467.0,"ymax":2112.0},{"id":39,"contenttext":"そ","xmin":2424.0,"ymin":2143.0,"xmax":2455.0,"ymax":2183.0},{"id":40,"contenttext":"の他數十部あり。","xmin":2341.0,"ymin":700.0,"xmax":2397.0,"ymax":1043.0},{"id":41,"contenttext":"隆正、","xmin":2269.0,"ymin":739.0,"xmax":2321.0,"ymax":854.0},{"id":42,"contenttext":"先づ自己の立脚地を示して曰はく、","xmin":2266.0,"ymin":884.0,"xmax":2320.0,"ymax":1598.0},{"id":43,"contenttext":"我徒は造天地の眞說によりて、","xmin":2199.0,"ymin":790.0,"xmax":2248.0,"ymax":1412.0},{"id":44,"contenttext":"萬事を論定するにより、","xmin":2191.0,"ymin":1441.0,"xmax":2245.0,"ymax":1922.0},{"id":45,"contenttext":"鬼神を有と","xmin":2195.0,"ymin":1953.0,"xmax":2240.0,"ymax":2183.0},{"id":46,"contenttext":"隆正の立","xmin":2234.0,"ymin":496.0,"xmax":2267.0,"ymax":617.0},{"id":47,"contenttext":"脚地","xmin":2207.0,"ymin":494.0,"xmax":2240.0,"ymax":558.0},{"id":48,"contenttext":"鬼神を有と","xmin":2195.0,"ymin":1953.0,"xmax":2240.0,"ymax":2183.0},{"id":49,"contenttext":"定め、","xmin":1811.0,"ymin":735.0,"xmax":1863.0,"ymax":845.0},{"id":50,"contenttext":"天地を神造とし、","xmin":1812.0,"ymin":873.0,"xmax":1869.0,"ymax":1217.0},{"id":51,"contenttext":"治亂興廢を神の處置とす。","xmin":1817.0,"ymin":1251.0,"xmax":1875.0,"ymax":1771.0},{"id":52,"contenttext":"儒學者は造天地の","xmin":1824.0,"ymin":1799.0,"xmax":1880.0,"ymax":2167.0},{"id":53,"contenttext":"眞說なき國の說によりて萬事を論定するにより、","xmin":1737.0,"ymin":734.0,"xmax":1798.0,"ymax":1721.0},{"id":54,"contenttext":"鬼神を無に屬し、","xmin":1751.0,"ymin":1752.0,"xmax":1801.0,"ymax":2095.0},{"id":55,"contenttext":"天","xmin":1756.0,"ymin":2125.0,"xmax":1803.0,"ymax":2168.0},{"id":56,"contenttext":"地を固有とし、","xmin":1664.0,"ymin":736.0,"xmax":1715.0,"ymax":1028.0},{"id":57,"contenttext":"治亂興廢を偶然に歸す。","xmin":1666.0,"ymin":1059.0,"xmax":1723.0,"ymax":1543.0},{"id":58,"contenttext":"(憐駁者)","xmin":1674.0,"ymin":1558.0,"xmax":1725.0,"ymax":1721.0},{"id":59,"contenttext":"と。","xmin":1600.0,"ymin":694.0,"xmax":1631.0,"ymax":750.0},{"id":60,"contenttext":"以つてその立脚地宣長篤胤を宗とせるものにあるを知るべし。","xmin":1589.0,"ymin":781.0,"xmax":1651.0,"ymax":2050.0},{"id":61,"contenttext":"かく","xmin":1608.0,"ymin":2084.0,"xmax":1649.0,"ymax":2166.0},{"id":62,"contenttext":"て彼れは神道の本義を說きて曰はく、","xmin":1516.0,"ymin":694.0,"xmax":1574.0,"ymax":1444.0},{"id":63,"contenttext":"我が日本國の大道は、","xmin":1447.0,"ymin":784.0,"xmax":1495.0,"ymax":1214.0},{"id":64,"contenttext":"それらの小道(株)","xmin":1445.0,"ymin":1248.0,"xmax":1510.0,"ymax":1572.0},{"id":65,"contenttext":"云","xmin":1449.0,"ymin":1573.0,"xmax":1480.0,"ymax":1613.0},{"id":66,"contenttext":"國の","xmin":1478.0,"ymin":1575.0,"xmax":1507.0,"ymax":1655.0},{"id":67,"contenttext":"ふ","xmin":1447.0,"ymin":1620.0,"xmax":1478.0,"ymax":1657.0},{"id":68,"contenttext":"〓)と同じからず。","xmin":1453.0,"ymin":1665.0,"xmax":1510.0,"ymax":2003.0},{"id":69,"contenttext":"大本を","xmin":1457.0,"ymin":2033.0,"xmax":1506.0,"ymax":2173.0},{"id":70,"contenttext":"神代に起し、","xmin":1373.0,"ymin":738.0,"xmax":1426.0,"ymax":986.0},{"id":71,"contenttext":"中を天皇に立てゝ、","xmin":1377.0,"ymin":1015.0,"xmax":1427.0,"ymax":1400.0},{"id":72,"contenttext":"それより次第をおひ、","xmin":1382.0,"ymin":1434.0,"xmax":1433.0,"ymax":1864.0},{"id":73,"contenttext":"おの〓〓その","xmin":1387.0,"ymin":1901.0,"xmax":1433.0,"ymax":2169.0},{"id":74,"contenttext":"君父夫をうやまひかしづき、","xmin":1303.0,"ymin":739.0,"xmax":1358.0,"ymax":1310.0},{"id":75,"contenttext":"臣子婦をあはれみをしへ、","xmin":1309.0,"ymin":1341.0,"xmax":1362.0,"ymax":1866.0},{"id":76,"contenttext":"交友かたみに","xmin":1314.0,"ymin":1896.0,"xmax":1362.0,"ymax":2170.0},{"id":77,"contenttext":"まことを失なはず。","xmin":1232.0,"ymin":741.0,"xmax":1283.0,"ymax":1124.0},{"id":78,"contenttext":"家職產業をつとめて身をたもち家をたもち國をた","xmin":1234.0,"ymin":1155.0,"xmax":1295.0,"ymax":2171.0},{"id":79,"contenttext":"もつ。","xmin":1163.0,"ymin":745.0,"xmax":1204.0,"ymax":850.0},{"id":80,"contenttext":"そのたもついとま〓〓に己が好むいやしからぬ業をして樂しみ","xmin":1160.0,"ymin":882.0,"xmax":1219.0,"ymax":2171.0},{"id":81,"contenttext":"くらすを常とす。","xmin":1085.0,"ymin":742.0,"xmax":1135.0,"ymax":1084.0},{"id":82,"contenttext":"武臣は武備怠らずして、","xmin":1089.0,"ymin":1109.0,"xmax":1136.0,"ymax":1588.0},{"id":83,"contenttext":"國をかため、","xmin":1095.0,"ymin":1620.0,"xmax":1138.0,"ymax":1868.0},{"id":84,"contenttext":"文人は日本の","xmin":1097.0,"ymin":1900.0,"xmax":1142.0,"ymax":2170.0},{"id":85,"contenttext":"古事を悟り、","xmin":1013.0,"ymin":742.0,"xmax":1063.0,"ymax":985.0},{"id":86,"contenttext":"外國の事にわたり、","xmin":1017.0,"ymin":1021.0,"xmax":1066.0,"ymax":1404.0},{"id":87,"contenttext":"古今を知りて、","xmin":1021.0,"ymin":1438.0,"xmax":1065.0,"ymax":1727.0},{"id":88,"contenttext":"國の光をみがきいだ","xmin":1025.0,"ymin":1758.0,"xmax":1071.0,"ymax":2175.0},{"id":89,"contenttext":"すなり。","xmin":944.0,"ymin":742.0,"xmax":985.0,"ymax":890.0},{"id":90,"contenttext":"之をわが國の國體とし神道とす。","xmin":943.0,"ymin":928.0,"xmax":996.0,"ymax":1582.0},{"id":91,"contenttext":"神を祭ることのあつきはこ","xmin":950.0,"ymin":1621.0,"xmax":997.0,"ymax":2169.0},{"id":92,"contenttext":"神道史綱要","xmin":883.0,"ymin":819.0,"xmax":922.0,"ymax":1024.0},{"id":93,"contenttext":"毛七","xmin":893.0,"ymin":1957.0,"xmax":924.0,"ymax":1997.0},{"id":94,"contenttext":"かく","xmin":1608.0,"ymin":2084.0,"xmax":1649.0,"ymax":2166.0},{"id":95,"contenttext":"日本國の","xmin":1457.0,"ymin":498.0,"xmax":1492.0,"ymax":613.0},{"id":96,"contenttext":"大道","xmin":1429.0,"ymin":496.0,"xmax":1463.0,"ymax":558.0}]