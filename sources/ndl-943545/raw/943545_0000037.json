[{"id":0,"contenttext":"六","xmin":3194.0,"ymin":1959.0,"xmax":3227.0,"ymax":1997.0},{"id":1,"contenttext":"吉凶禍福を擧げて諸れを直里福津日二神に附し、","xmin":3108.0,"ymin":752.0,"xmax":3180.0,"ymax":1744.0},{"id":2,"contenttext":"〓淨自然を以つて、","xmin":3099.0,"ymin":1772.0,"xmax":3161.0,"ymax":2159.0},{"id":3,"contenttext":"人道の極致となす。","xmin":3045.0,"ymin":749.0,"xmax":3098.0,"ymax":1141.0},{"id":4,"contenttext":"その言頗る辯ずれども、","xmin":3035.0,"ymin":1169.0,"xmax":3092.0,"ymax":1646.0},{"id":5,"contenttext":"之れを要するに、","xmin":3028.0,"ymin":1678.0,"xmax":3083.0,"ymax":2017.0},{"id":6,"contenttext":"皆老莊","xmin":3027.0,"ymin":2049.0,"xmax":3076.0,"ymax":2187.0},{"id":7,"contenttext":"の糟粕。","xmin":2980.0,"ymin":751.0,"xmax":3025.0,"ymax":905.0},{"id":8,"contenttext":"その徒亦自らその說老莊に類するを嫌ひ、","xmin":2962.0,"ymin":936.0,"xmax":3026.0,"ymax":1785.0},{"id":9,"contenttext":"乃ち曰はく、","xmin":2963.0,"ymin":1818.0,"xmax":3008.0,"ymax":2062.0},{"id":10,"contenttext":"「老莊","xmin":2954.0,"ymin":2078.0,"xmax":3006.0,"ymax":2184.0},{"id":11,"contenttext":"の所謂自然は、","xmin":2901.0,"ymin":751.0,"xmax":2957.0,"ymax":1043.0},{"id":12,"contenttext":"猶未だ聖人の道に溺るゝを免れず。","xmin":2887.0,"ymin":1073.0,"xmax":2951.0,"ymax":1799.0},{"id":13,"contenttext":"吾が所謂自然は、","xmin":2879.0,"ymin":1811.0,"xmax":2937.0,"ymax":2153.0},{"id":14,"contenttext":"皆神意に本づく」と。","xmin":2827.0,"ymin":747.0,"xmax":2878.0,"ymax":1132.0},{"id":15,"contenttext":"特にその弊必ず胸臆に任じ、","xmin":2812.0,"ymin":1165.0,"xmax":2876.0,"ymax":1740.0},{"id":16,"contenttext":"私智を逞くし、","xmin":2808.0,"ymin":1766.0,"xmax":2862.0,"ymax":2061.0},{"id":17,"contenttext":"剛復","xmin":2806.0,"ymin":2090.0,"xmax":2857.0,"ymax":2183.0},{"id":18,"contenttext":"自ら喜ぶに至るを知らざるのみ。","xmin":2744.0,"ymin":746.0,"xmax":2811.0,"ymax":1413.0},{"id":19,"contenttext":"(弘道館記述義)","xmin":2741.0,"ymin":1429.0,"xmax":2796.0,"ymax":1730.0},{"id":20,"contenttext":"と。","xmin":2692.0,"ymin":702.0,"xmax":2726.0,"ymax":758.0},{"id":21,"contenttext":"以つて宣長等の努むる所は、","xmin":2674.0,"ymin":789.0,"xmax":2735.0,"ymax":1366.0},{"id":22,"contenttext":"私智を以つて神代を測るものとし、","xmin":2658.0,"ymin":1396.0,"xmax":2722.0,"ymax":2110.0},{"id":23,"contenttext":"そ","xmin":2669.0,"ymin":2137.0,"xmax":2700.0,"ymax":2179.0},{"id":24,"contenttext":"の學を排斥せり。","xmin":2606.0,"ymin":699.0,"xmax":2660.0,"ymax":1035.0},{"id":25,"contenttext":"若し夫れ會澤正志に至りては、","xmin":2528.0,"ymin":742.0,"xmax":2586.0,"ymax":1366.0},{"id":26,"contenttext":"特に書を著はして、","xmin":2520.0,"ymin":1394.0,"xmax":2575.0,"ymax":1781.0},{"id":27,"contenttext":"堂々宣長の說を反","xmin":2512.0,"ymin":1811.0,"xmax":2570.0,"ymax":2179.0},{"id":28,"contenttext":"駁辯論せり。","xmin":2464.0,"ymin":695.0,"xmax":2518.0,"ymax":943.0},{"id":29,"contenttext":"正志は、","xmin":2463.0,"ymin":976.0,"xmax":2514.0,"ymax":1132.0},{"id":30,"contenttext":"東湖と相並び、","xmin":2456.0,"ymin":1163.0,"xmax":2510.0,"ymax":1458.0},{"id":31,"contenttext":"水戶派の學者の錚々たるものなれ","xmin":2444.0,"ymin":1486.0,"xmax":2503.0,"ymax":2175.0},{"id":32,"contenttext":"ども、","xmin":2401.0,"ymin":696.0,"xmax":2440.0,"ymax":801.0},{"id":33,"contenttext":"世、","xmin":2393.0,"ymin":831.0,"xmax":2448.0,"ymax":899.0},{"id":34,"contenttext":"東湖の如く、","xmin":2388.0,"ymin":926.0,"xmax":2446.0,"ymax":1178.0},{"id":35,"contenttext":"之れを知らず。","xmin":2381.0,"ymin":1206.0,"xmax":2441.0,"ymax":1503.0},{"id":36,"contenttext":"正志名は安、","xmin":2371.0,"ymin":1529.0,"xmax":2434.0,"ymax":1781.0},{"id":37,"contenttext":"字は伯民、","xmin":2371.0,"ymin":1805.0,"xmax":2429.0,"ymax":2010.0},{"id":38,"contenttext":"通稱恒","xmin":2369.0,"ymin":2037.0,"xmax":2421.0,"ymax":2177.0},{"id":39,"contenttext":"藏、","xmin":2318.0,"ymin":690.0,"xmax":2373.0,"ymax":754.0},{"id":40,"contenttext":"正志齋と號す。","xmin":2318.0,"ymin":786.0,"xmax":2371.0,"ymax":1085.0},{"id":41,"contenttext":"宣長の歿せる當時正に成年に達せり。","xmin":2298.0,"ymin":1110.0,"xmax":2366.0,"ymax":1873.0},{"id":42,"contenttext":"生れて學を好","xmin":2295.0,"ymin":1901.0,"xmax":2351.0,"ymax":2179.0},{"id":43,"contenttext":"み、","xmin":2250.0,"ymin":690.0,"xmax":2295.0,"ymax":752.0},{"id":44,"contenttext":"東湖の父幽谷の門に入り、","xmin":2235.0,"ymin":783.0,"xmax":2299.0,"ymax":1313.0},{"id":45,"contenttext":"その高第弟子たりき。","xmin":2229.0,"ymin":1341.0,"xmax":2285.0,"ymax":1775.0},{"id":46,"contenttext":"彰考館寫宇生より、","xmin":2219.0,"ymin":1803.0,"xmax":2282.0,"ymax":2181.0},{"id":47,"contenttext":"そ","xmin":2669.0,"ymin":2137.0,"xmax":2700.0,"ymax":2179.0},{"id":48,"contenttext":"會澤正志","xmin":2540.0,"ymin":496.0,"xmax":2581.0,"ymax":617.0},{"id":49,"contenttext":"身を起し、","xmin":1796.0,"ymin":698.0,"xmax":1848.0,"ymax":897.0},{"id":50,"contenttext":"遂に彰考館總裁となり、","xmin":1792.0,"ymin":929.0,"xmax":1846.0,"ymax":1408.0},{"id":51,"contenttext":"後種々の職に轉ぜり。","xmin":1792.0,"ymin":1438.0,"xmax":1846.0,"ymax":1869.0},{"id":52,"contenttext":"常に東湖等と","xmin":1792.0,"ymin":1902.0,"xmax":1841.0,"ymax":2177.0},{"id":53,"contenttext":"國事に奔走し、","xmin":1723.0,"ymin":696.0,"xmax":1770.0,"ymax":989.0},{"id":54,"contenttext":"文久三年を以つて歿しぬ。","xmin":1721.0,"ymin":1021.0,"xmax":1770.0,"ymax":1543.0},{"id":55,"contenttext":"年八十二。","xmin":1719.0,"ymin":1577.0,"xmax":1770.0,"ymax":1780.0},{"id":56,"contenttext":"著書、","xmin":1721.0,"ymin":1808.0,"xmax":1770.0,"ymax":1917.0},{"id":57,"contenttext":"『孝經考』","xmin":1721.0,"ymin":1924.0,"xmax":1770.0,"ymax":2111.0},{"id":58,"contenttext":"卷、","xmin":1651.0,"ymin":696.0,"xmax":1704.0,"ymax":762.0},{"id":59,"contenttext":"『讀直毘靈』","xmin":1648.0,"ymin":765.0,"xmax":1704.0,"ymax":996.0},{"id":60,"contenttext":"一度、","xmin":1649.0,"ymin":1029.0,"xmax":1700.0,"ymax":1132.0},{"id":61,"contenttext":"『讀葛花』","xmin":1649.0,"ymin":1133.0,"xmax":1700.0,"ymax":1320.0},{"id":62,"contenttext":"一種、","xmin":1649.0,"ymin":1354.0,"xmax":1700.0,"ymax":1457.0},{"id":63,"contenttext":"『新論』","xmin":1649.0,"ymin":1458.0,"xmax":1700.0,"ymax":1600.0},{"id":64,"contenttext":"二卷、","xmin":1649.0,"ymin":1624.0,"xmax":1700.0,"ymax":1737.0},{"id":65,"contenttext":"『正志齋雜錄』","xmin":1645.0,"ymin":1737.0,"xmax":1702.0,"ymax":2020.0},{"id":66,"contenttext":"一卷等","xmin":1647.0,"ymin":2051.0,"xmax":1698.0,"ymax":2179.0},{"id":67,"contenttext":"あり。","xmin":1584.0,"ymin":700.0,"xmax":1621.0,"ymax":801.0},{"id":68,"contenttext":"彼れは常に水戶流の神道を信奉せり。","xmin":1504.0,"ymin":745.0,"xmax":1557.0,"ymax":1498.0},{"id":69,"contenttext":"その說に曰はく、","xmin":1504.0,"ymin":1530.0,"xmax":1555.0,"ymax":1865.0},{"id":70,"contenttext":"夫れ天地剖判始めて人民ありてより、","xmin":1429.0,"ymin":792.0,"xmax":1481.0,"ymax":1547.0},{"id":71,"contenttext":"天胤四海に君臨し、","xmin":1427.0,"ymin":1576.0,"xmax":1482.0,"ymax":1965.0},{"id":72,"contenttext":"一姓歷々","xmin":1429.0,"ymin":2004.0,"xmax":1476.0,"ymax":2173.0},{"id":73,"contenttext":"未だ甞て一人の敢へて天位を覬覦せるものあらず。","xmin":1357.0,"ymin":745.0,"xmax":1408.0,"ymax":1778.0},{"id":74,"contenttext":"以つて今日に至る","xmin":1355.0,"ymin":1810.0,"xmax":1404.0,"ymax":2173.0},{"id":75,"contenttext":"ものは、","xmin":1287.0,"ymin":744.0,"xmax":1334.0,"ymax":898.0},{"id":76,"contenttext":"豈に其れ偶然ならんや。","xmin":1286.0,"ymin":927.0,"xmax":1335.0,"ymax":1408.0},{"id":77,"contenttext":"夫れ君臣の義は、","xmin":1283.0,"ymin":1437.0,"xmax":1336.0,"ymax":1778.0},{"id":78,"contenttext":"天地の大義也。","xmin":1283.0,"ymin":1810.0,"xmax":1335.0,"ymax":2103.0},{"id":79,"contenttext":"父","xmin":1283.0,"ymin":2131.0,"xmax":1330.0,"ymax":2177.0},{"id":80,"contenttext":"子の親は天下の至恩也。","xmin":1208.0,"ymin":743.0,"xmax":1263.0,"ymax":1222.0},{"id":81,"contenttext":"義の大なる者、","xmin":1208.0,"ymin":1252.0,"xmax":1263.0,"ymax":1545.0},{"id":82,"contenttext":"恩の至れるものと、","xmin":1210.0,"ymin":1575.0,"xmax":1259.0,"ymax":1960.0},{"id":83,"contenttext":"天地の間","xmin":1208.0,"ymin":1992.0,"xmax":1260.0,"ymax":2177.0},{"id":84,"contenttext":"に並び立ち、","xmin":1132.0,"ymin":745.0,"xmax":1185.0,"ymax":991.0},{"id":85,"contenttext":"漸漬積累、","xmin":1134.0,"ymin":1019.0,"xmax":1185.0,"ymax":1222.0},{"id":86,"contenttext":"人心に沿決し、","xmin":1134.0,"ymin":1250.0,"xmax":1185.0,"ymax":1547.0},{"id":87,"contenttext":"久遠にして變ぜず。","xmin":1134.0,"ymin":1575.0,"xmax":1185.0,"ymax":1966.0},{"id":88,"contenttext":"此れ帝王、","xmin":1132.0,"ymin":1994.0,"xmax":1183.0,"ymax":2183.0},{"id":89,"contenttext":"天地を經緯し、","xmin":1060.0,"ymin":742.0,"xmax":1114.0,"ymax":1035.0},{"id":90,"contenttext":"億兆を綱紀する所以の大資也。","xmin":1059.0,"ymin":1064.0,"xmax":1110.0,"ymax":1680.0},{"id":91,"contenttext":"昔は、","xmin":1063.0,"ymin":1712.0,"xmax":1112.0,"ymax":1823.0},{"id":92,"contenttext":"天祖肇めて鴻基","xmin":1058.0,"ymin":1850.0,"xmax":1112.0,"ymax":2175.0},{"id":93,"contenttext":"を建つ。","xmin":986.0,"ymin":743.0,"xmax":1036.0,"ymax":899.0},{"id":94,"contenttext":"位は即ち天位、","xmin":986.0,"ymin":927.0,"xmax":1038.0,"ymax":1222.0},{"id":95,"contenttext":"德は即ち天德、","xmin":986.0,"ymin":1252.0,"xmax":1038.0,"ymax":1543.0},{"id":96,"contenttext":"以つて天業を經綸す。","xmin":985.0,"ymin":1572.0,"xmax":1038.0,"ymax":2007.0},{"id":97,"contenttext":"細大の","xmin":985.0,"ymin":2035.0,"xmax":1036.0,"ymax":2173.0},{"id":98,"contenttext":"事一も天に非るものなし。","xmin":918.0,"ymin":743.0,"xmax":965.0,"ymax":1265.0},{"id":99,"contenttext":"德を玉に比し、","xmin":916.0,"ymin":1297.0,"xmax":963.0,"ymax":1590.0},{"id":100,"contenttext":"明を鏡に比し、","xmin":916.0,"ymin":1620.0,"xmax":961.0,"ymax":1911.0},{"id":101,"contenttext":"威を劔に比","xmin":911.0,"ymin":1942.0,"xmax":963.0,"ymax":2175.0},{"id":102,"contenttext":"神道史綱要","xmin":851.0,"ymin":802.0,"xmax":889.0,"ymax":1006.0},{"id":103,"contenttext":"奎","xmin":842.0,"ymin":1943.0,"xmax":879.0,"ymax":1980.0}]