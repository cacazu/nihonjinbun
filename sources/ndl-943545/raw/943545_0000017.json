[{"id":0,"contenttext":"云","xmin":3174.0,"ymin":1969.0,"xmax":3206.0,"ymax":2007.0},{"id":1,"contenttext":"かりて立てるものは、","xmin":3092.0,"ymin":716.0,"xmax":3141.0,"ymax":1149.0},{"id":2,"contenttext":"山崎闇齋その人也。","xmin":3087.0,"ymin":1179.0,"xmax":3141.0,"ymax":1568.0},{"id":3,"contenttext":"谷重遠曰はく、「伊勢流","xmin":3079.0,"ymin":1597.0,"xmax":3136.0,"ymax":2061.0},{"id":4,"contenttext":"『日本","xmin":3080.0,"ymin":2089.0,"xmax":3127.0,"ymax":2195.0},{"id":5,"contenttext":"起","xmin":3019.0,"ymin":712.0,"xmax":3070.0,"ymax":780.0},{"id":6,"contenttext":"に口傳なし。","xmin":3019.0,"ymin":809.0,"xmax":3066.0,"ymax":1053.0},{"id":7,"contenttext":"只字面を談ずるのみ。","xmin":3014.0,"ymin":1086.0,"xmax":3066.0,"ymax":1516.0},{"id":8,"contenttext":"埀加後にト部の說を聞き、","xmin":3005.0,"ymin":1553.0,"xmax":3062.0,"ymax":2077.0},{"id":9,"contenttext":"其の","xmin":3006.0,"ymin":2109.0,"xmax":3055.0,"ymax":2195.0},{"id":10,"contenttext":"傑れる者を擧げ、","xmin":2945.0,"ymin":712.0,"xmax":2994.0,"ymax":1057.0},{"id":11,"contenttext":"之れを信守に訂す。","xmin":2937.0,"ymin":1086.0,"xmax":2995.0,"ymax":1477.0},{"id":12,"contenttext":"信守反つて腹立て聽かず。","xmin":2932.0,"ymin":1506.0,"xmax":2991.0,"ymax":2032.0},{"id":13,"contenttext":"又、","xmin":2931.0,"ymin":2058.0,"xmax":2983.0,"ymax":2126.0},{"id":14,"contenttext":"伊","xmin":2933.0,"ymin":2154.0,"xmax":2980.0,"ymax":2197.0},{"id":15,"contenttext":"勢の明說を擧げて、","xmin":2869.0,"ymin":714.0,"xmax":2921.0,"ymax":1104.0},{"id":16,"contenttext":"之れを吉川惟足に質す。","xmin":2865.0,"ymin":1131.0,"xmax":2914.0,"ymax":1610.0},{"id":17,"contenttext":"惟足亦絶然たり。","xmin":2863.0,"ymin":1641.0,"xmax":2910.0,"ymax":1978.0},{"id":18,"contenttext":"各〓自ら賛","xmin":2859.0,"ymin":2015.0,"xmax":2906.0,"ymax":2197.0},{"id":19,"contenttext":"して他人の說を聞かず。","xmin":2798.0,"ymin":714.0,"xmax":2845.0,"ymax":1192.0},{"id":20,"contenttext":"是れ其の弊、","xmin":2794.0,"ymin":1221.0,"xmax":2845.0,"ymax":1472.0},{"id":21,"contenttext":"久し矣。","xmin":2794.0,"ymin":1501.0,"xmax":2843.0,"ymax":1656.0},{"id":22,"contenttext":"埀加社の神道、","xmin":2790.0,"ymin":1688.0,"xmax":2841.0,"ymax":1982.0},{"id":23,"contenttext":"大いに諸","xmin":2788.0,"ymin":2011.0,"xmax":2837.0,"ymax":2193.0},{"id":24,"contenttext":"說に勝るものは、","xmin":2724.0,"ymin":714.0,"xmax":2773.0,"ymax":1053.0},{"id":25,"contenttext":"他なし。","xmin":2722.0,"ymin":1084.0,"xmax":2769.0,"ymax":1239.0},{"id":26,"contenttext":"偏主なき也。","xmin":2722.0,"ymin":1271.0,"xmax":2769.0,"ymax":1521.0},{"id":27,"contenttext":"忌部流之れを石手帶刀に聞き、","xmin":2712.0,"ymin":1549.0,"xmax":2769.0,"ymax":2165.0},{"id":28,"contenttext":"ト部流之れを視吾に聞き、","xmin":2648.0,"ymin":714.0,"xmax":2703.0,"ymax":1239.0},{"id":29,"contenttext":"復之れを土津に質す。","xmin":2645.0,"ymin":1271.0,"xmax":2700.0,"ymax":1709.0},{"id":30,"contenttext":"伊勢流之れを信守及び","xmin":2643.0,"ymin":1727.0,"xmax":2696.0,"ymax":2195.0},{"id":31,"contenttext":"大宮司精長に聞き、","xmin":2573.0,"ymin":712.0,"xmax":2624.0,"ymax":1096.0},{"id":32,"contenttext":"加茂說之れを梨木(祐之)に聞き、","xmin":2571.0,"ymin":1129.0,"xmax":2623.0,"ymax":1747.0},{"id":33,"contenttext":"諸家の秘を集むる此","xmin":2565.0,"ymin":1778.0,"xmax":2617.0,"ymax":2193.0},{"id":34,"contenttext":"の如し。","xmin":2500.0,"ymin":712.0,"xmax":2547.0,"ymax":867.0},{"id":35,"contenttext":"實に千金の義也」秦山集)と。","xmin":2497.0,"ymin":898.0,"xmax":2551.0,"ymax":1422.0},{"id":36,"contenttext":"かく集大成を務めたる闇齋の說果し","xmin":2488.0,"ymin":1455.0,"xmax":2546.0,"ymax":2191.0},{"id":37,"contenttext":"て如何。","xmin":2426.0,"ymin":714.0,"xmax":2473.0,"ymax":865.0},{"id":38,"contenttext":"彼れ曰はく、","xmin":2354.0,"ymin":757.0,"xmax":2401.0,"ymax":1003.0},{"id":39,"contenttext":"「唯一之神道と云事は、","xmin":2349.0,"ymin":1022.0,"xmax":2402.0,"ymax":1470.0},{"id":40,"contenttext":"異邦の〓を習合せざるのみを云に","xmin":2347.0,"ymin":1499.0,"xmax":2399.0,"ymax":2189.0},{"id":41,"contenttext":"非ず。","xmin":2283.0,"ymin":709.0,"xmax":2334.0,"ymax":820.0},{"id":42,"contenttext":"天人唯一之道と云名目也。","xmin":2281.0,"ymin":849.0,"xmax":2334.0,"ymax":1375.0},{"id":43,"contenttext":"天地と人と全く一と云事也」と。","xmin":2274.0,"ymin":1406.0,"xmax":2329.0,"ymax":2021.0},{"id":44,"contenttext":"以つて","xmin":2275.0,"ymin":2056.0,"xmax":2326.0,"ymax":2193.0},{"id":45,"contenttext":"我が神道哲學の根柢を得來り、","xmin":2206.0,"ymin":707.0,"xmax":2258.0,"ymax":1325.0},{"id":46,"contenttext":"而して實踐哲學の方面に於いては、","xmin":2201.0,"ymin":1358.0,"xmax":2256.0,"ymax":2067.0},{"id":47,"contenttext":"日神","xmin":2205.0,"ymin":2103.0,"xmax":2248.0,"ymax":2191.0},{"id":48,"contenttext":"の道なるものを說けり。","xmin":1800.0,"ymin":681.0,"xmax":1855.0,"ymax":1159.0},{"id":49,"contenttext":"即ち彼れは日神即ち天照大神を以つて、","xmin":1805.0,"ymin":1192.0,"xmax":1866.0,"ymax":1995.0},{"id":50,"contenttext":"至大至","xmin":1814.0,"ymin":2025.0,"xmax":1865.0,"ymax":2162.0},{"id":51,"contenttext":"高の德を有し、","xmin":1729.0,"ymin":683.0,"xmax":1776.0,"ymax":975.0},{"id":52,"contenttext":"全く天御中主尊と同じ德を保ち給ふと雖も、","xmin":1732.0,"ymin":1007.0,"xmax":1789.0,"ymax":1900.0},{"id":53,"contenttext":"而かも人體","xmin":1741.0,"ymin":1930.0,"xmax":1789.0,"ymax":2161.0},{"id":54,"contenttext":"を有し給ふ。","xmin":1654.0,"ymin":683.0,"xmax":1705.0,"ymax":931.0},{"id":55,"contenttext":"是れ此の大神が、","xmin":1657.0,"ymin":962.0,"xmax":1712.0,"ymax":1300.0},{"id":56,"contenttext":"人類萬世の師表となられ給ふ所以也とな","xmin":1664.0,"ymin":1329.0,"xmax":1718.0,"ymax":2163.0},{"id":57,"contenttext":"し、","xmin":1586.0,"ymin":684.0,"xmax":1627.0,"ymax":744.0},{"id":58,"contenttext":"而して此の道は人々の具有する所なりとし、","xmin":1581.0,"ymin":777.0,"xmax":1646.0,"ymax":1672.0},{"id":59,"contenttext":"曰はく、","xmin":1596.0,"ymin":1708.0,"xmax":1641.0,"ymax":1858.0},{"id":60,"contenttext":"「道と云は、","xmin":1596.0,"ymin":1876.0,"xmax":1643.0,"ymax":2093.0},{"id":61,"contenttext":"人","xmin":1600.0,"ymin":2119.0,"xmax":1647.0,"ymax":2166.0},{"id":62,"contenttext":"々の心に備はりたる天然也、","xmin":1506.0,"ymin":689.0,"xmax":1566.0,"ymax":1260.0},{"id":63,"contenttext":"人は天の下の神物と云も是故也。","xmin":1517.0,"ymin":1288.0,"xmax":1574.0,"ymax":1954.0},{"id":64,"contenttext":"其道を備","xmin":1525.0,"ymin":1987.0,"xmax":1574.0,"ymax":2168.0},{"id":65,"contenttext":"へても、","xmin":1433.0,"ymin":692.0,"xmax":1478.0,"ymax":838.0},{"id":66,"contenttext":"自ら知らざれば詮すべなし」(天津神籬磐境極秘書)と。","xmin":1433.0,"ymin":871.0,"xmax":1502.0,"ymax":1905.0},{"id":67,"contenttext":"已に道は人","xmin":1446.0,"ymin":1939.0,"xmax":1503.0,"ymax":2171.0},{"id":68,"contenttext":"々具有すと雖も、","xmin":1355.0,"ymin":689.0,"xmax":1411.0,"ymax":1029.0},{"id":69,"contenttext":"自ら知らざれば詮すべなし。","xmin":1364.0,"ymin":1059.0,"xmax":1419.0,"ymax":1631.0},{"id":70,"contenttext":"是に於いてか〓を要す。","xmin":1370.0,"ymin":1662.0,"xmax":1425.0,"ymax":2146.0},{"id":71,"contenttext":"故に又曰はく、","xmin":1287.0,"ymin":687.0,"xmax":1338.0,"ymax":982.0},{"id":72,"contenttext":"「神道は天人唯一にして、","xmin":1291.0,"ymin":999.0,"xmax":1347.0,"ymax":1492.0},{"id":73,"contenttext":"道は日神の道、","xmin":1297.0,"ymin":1523.0,"xmax":1350.0,"ymax":1816.0},{"id":74,"contenttext":"〓は猿田彥の導","xmin":1303.0,"ymin":1849.0,"xmax":1353.0,"ymax":2171.0},{"id":75,"contenttext":"き給ふ處、","xmin":1224.0,"ymin":692.0,"xmax":1271.0,"ymax":893.0},{"id":76,"contenttext":"土金の〓天人を貫く敬の至り也」(同上)と。","xmin":1223.0,"ymin":922.0,"xmax":1284.0,"ymax":1732.0},{"id":77,"contenttext":"かくて彼れは宋儒の","xmin":1237.0,"ymin":1760.0,"xmax":1285.0,"ymax":2171.0},{"id":78,"contenttext":"說を取り來りて其の神道を說けり。","xmin":1147.0,"ymin":692.0,"xmax":1207.0,"ymax":1403.0},{"id":79,"contenttext":"吾人の以上述べ來れる唯一神道以下の種々の神道說は、","xmin":1072.0,"ymin":740.0,"xmax":1139.0,"ymax":1871.0},{"id":80,"contenttext":"皆我が固有の","xmin":1089.0,"ymin":1900.0,"xmax":1143.0,"ymax":2175.0},{"id":81,"contenttext":"神道の思想を發揮せんことを努めたるものなりと雖も、","xmin":994.0,"ymin":694.0,"xmax":1063.0,"ymax":1824.0},{"id":82,"contenttext":"而かも皆又或は","xmin":1014.0,"ymin":1856.0,"xmax":1067.0,"ymax":2177.0},{"id":83,"contenttext":"佛により、","xmin":928.0,"ymin":698.0,"xmax":971.0,"ymax":895.0},{"id":84,"contenttext":"或は儒に附會して、","xmin":928.0,"ymin":927.0,"xmax":980.0,"ymax":1317.0},{"id":85,"contenttext":"その說を構成せり。","xmin":938.0,"ymin":1347.0,"xmax":983.0,"ymax":1729.0},{"id":86,"contenttext":"從つて荷田春滿の所","xmin":938.0,"ymin":1763.0,"xmax":991.0,"ymax":2179.0},{"id":87,"contenttext":"神道史綱要","xmin":859.0,"ymin":814.0,"xmax":903.0,"ymax":1022.0},{"id":88,"contenttext":"〓","xmin":879.0,"ymin":1950.0,"xmax":909.0,"ymax":1984.0}]