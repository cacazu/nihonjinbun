[{"id":1,"contenttext":"家社會の秩序を保存せんことを務むるの結果、","xmin":2999.0,"ymin":672.0,"xmax":3073.0,"ymax":1603.0},{"id":2,"contenttext":"忠孝仁義の說に、","xmin":3022.0,"ymin":1664.0,"xmax":3083.0,"ymax":1975.0},{"id":3,"contenttext":"深遠な","xmin":3033.0,"ymin":2042.0,"xmax":3084.0,"ymax":2142.0},{"id":4,"contenttext":"る理由を說き得たり。","xmin":2929.0,"ymin":676.0,"xmax":2990.0,"ymax":1096.0},{"id":5,"contenttext":"而して今や我が國にありては、","xmin":2942.0,"ymin":1147.0,"xmax":3002.0,"ymax":1740.0},{"id":6,"contenttext":"人智の發達と共に、","xmin":2955.0,"ymin":1805.0,"xmax":3009.0,"ymax":2146.0},{"id":7,"contenttext":"固有の神道の形式着色を變ずるの必要を生じたるに當り、","xmin":2856.0,"ymin":676.0,"xmax":2936.0,"ymax":1834.0},{"id":8,"contenttext":"儒〓盛に傳來","xmin":2885.0,"ymin":1901.0,"xmax":2942.0,"ymax":2145.0},{"id":9,"contenttext":"せらる。","xmin":2790.0,"ymin":684.0,"xmax":2833.0,"ymax":820.0},{"id":10,"contenttext":"著しく神道に影響し、","xmin":2787.0,"ymin":866.0,"xmax":2854.0,"ymax":1289.0},{"id":11,"contenttext":"之れが形式着色に一層の發展を促したる、","xmin":2797.0,"ymin":1339.0,"xmax":2871.0,"ymax":2155.0},{"id":12,"contenttext":"爭ふべからざるの事實也。","xmin":2712.0,"ymin":681.0,"xmax":2773.0,"ymax":1189.0},{"id":13,"contenttext":"かく儒〓は、","xmin":2726.0,"ymin":1248.0,"xmax":2780.0,"ymax":1470.0},{"id":14,"contenttext":"神道の發展に貢獻せる所初より","xmin":2729.0,"ymin":1528.0,"xmax":2796.0,"ymax":2145.0},{"id":15,"contenttext":"少からざりしも、","xmin":2644.0,"ymin":684.0,"xmax":2695.0,"ymax":1010.0},{"id":16,"contenttext":"尋いで輸入せられたる佛〓は、","xmin":2652.0,"ymin":1061.0,"xmax":2710.0,"ymax":1653.0},{"id":17,"contenttext":"之れが發展を一時沮礙","xmin":2665.0,"ymin":1715.0,"xmax":2721.0,"ymax":2147.0},{"id":18,"contenttext":"せる所ありき。","xmin":2573.0,"ymin":686.0,"xmax":2619.0,"ymax":965.0},{"id":19,"contenttext":"但し此の","xmin":2523.0,"ymin":1073.0,"xmax":2563.0,"ymax":1219.0},{"id":20,"contenttext":"年代","xmin":2528.0,"ymin":1246.0,"xmax":2565.0,"ymax":1314.0},{"id":21,"contenttext":"を以つて輸入せられたる佛〓は、","xmin":2506.0,"ymin":1339.0,"xmax":2571.0,"ymax":1983.0},{"id":22,"contenttext":"深遠な","xmin":2524.0,"ymin":2054.0,"xmax":2575.0,"ymax":2152.0},{"id":23,"contenttext":"欽明天皇十三年","xmin":2494.0,"ymin":734.0,"xmax":2552.0,"ymax":1047.0},{"id":24,"contenttext":"には異論あり","xmin":2496.0,"ymin":1077.0,"xmax":2535.0,"ymax":1313.0},{"id":25,"contenttext":"る哲學的學說に富み、","xmin":2417.0,"ymin":690.0,"xmax":2477.0,"ymax":1108.0},{"id":26,"contenttext":"恰も發達し來れる當時の文明の空氣を呼吸せる急","xmin":2428.0,"ymin":1158.0,"xmax":2501.0,"ymax":2155.0},{"id":27,"contenttext":"進派或は高襟者流の嗜好に投ぜるのみならず、","xmin":2343.0,"ymin":690.0,"xmax":2421.0,"ymax":1621.0},{"id":28,"contenttext":"之れを傳ふるに百濟は王、","xmin":2369.0,"ymin":1679.0,"xmax":2427.0,"ymax":2163.0},{"id":29,"contenttext":"「是の法は諸法の中に於いて最も殊に勝れたり、","xmin":2270.0,"ymin":688.0,"xmax":2343.0,"ymax":1620.0},{"id":30,"contenttext":"解し難く入り難し、","xmin":2292.0,"ymin":1681.0,"xmax":2350.0,"ymax":2036.0},{"id":31,"contenttext":"周公","xmin":2303.0,"ymin":2102.0,"xmax":2352.0,"ymax":2160.0},{"id":32,"contenttext":"孔子も尙知ること能はず、","xmin":2200.0,"ymin":696.0,"xmax":2259.0,"ymax":1208.0},{"id":33,"contenttext":"此の法能く無量無邊の福徳果報を生じ、","xmin":2213.0,"ymin":1260.0,"xmax":2279.0,"ymax":2040.0},{"id":34,"contenttext":"乃至","xmin":2230.0,"ymin":2109.0,"xmax":2281.0,"ymax":2162.0},{"id":35,"contenttext":":","xmin":2195.0,"ymin":2148.0,"xmax":2228.0,"ymax":2175.0},{"id":36,"contenttext":"無上菩提を成辨す。","xmin":2124.0,"ymin":697.0,"xmax":2189.0,"ymax":1072.0},{"id":37,"contenttext":"譬へば人の意に隨ふ實を懷いて用ひ盡すべき所に逐","xmin":2133.0,"ymin":1121.0,"xmax":2213.0,"ymax":2167.0},{"id":38,"contenttext":"佛教の影","xmin":2500.0,"ymin":484.0,"xmax":2538.0,"ymax":599.0},{"id":39,"contenttext":"響","xmin":2473.0,"ymin":486.0,"xmax":2506.0,"ymax":513.0},{"id":40,"contenttext":"편 ","xmin":1798.0,"ymin":1808.0,"xmax":1821.0,"ymax":1818.0},{"id":41,"contenttext":"つて情のまゝなるが如し。","xmin":1761.0,"ymin":679.0,"xmax":1814.0,"ymax":1188.0},{"id":42,"contenttext":"此の妙法の寳も亦復然り。","xmin":1759.0,"ymin":1240.0,"xmax":1808.0,"ymax":1739.0},{"id":43,"contenttext":"祈め願つて情にし","xmin":1757.0,"ymin":1806.0,"xmax":1804.0,"ymax":2138.0},{"id":44,"contenttext":"たがひ乏しき所なし」(日本書紀)と云ひ、","xmin":1684.0,"ymin":677.0,"xmax":1742.0,"ymax":1466.0},{"id":45,"contenttext":"且天竺以東の諸國皆之れを禮す","xmin":1683.0,"ymin":1521.0,"xmax":1738.0,"ymax":2140.0},{"id":46,"contenttext":"るの語を附加し、","xmin":1614.0,"ymin":677.0,"xmax":1670.0,"ymax":1002.0},{"id":47,"contenttext":"釋迦佛像及び經論等を奉る。","xmin":1613.0,"ymin":1052.0,"xmax":1666.0,"ymax":1600.0},{"id":48,"contenttext":"先きに輸入せられたる儒","xmin":1610.0,"ymin":1662.0,"xmax":1662.0,"ymax":2140.0},{"id":49,"contenttext":"〓の崇拜する所のものは天なりと雖も、","xmin":1537.0,"ymin":677.0,"xmax":1593.0,"ymax":1466.0},{"id":50,"contenttext":"その天や頗る漠として殆んど拘","xmin":1534.0,"ymin":1523.0,"xmax":1589.0,"ymax":2140.0},{"id":51,"contenttext":"はる所なし。","xmin":1474.0,"ymin":679.0,"xmax":1519.0,"ymax":909.0},{"id":52,"contenttext":"是れ神道と能く調和し得る所以也。","xmin":1465.0,"ymin":959.0,"xmax":1518.0,"ymax":1645.0},{"id":53,"contenttext":"然るに此の佛〓は崇拜","xmin":1463.0,"ymin":1708.0,"xmax":1510.0,"ymax":2138.0},{"id":54,"contenttext":"すべき對象佛を有せり。","xmin":1395.0,"ymin":674.0,"xmax":1449.0,"ymax":1137.0},{"id":55,"contenttext":"而してたとひ神を祭らずとも、","xmin":1394.0,"ymin":1192.0,"xmax":1443.0,"ymax":1783.0},{"id":56,"contenttext":"能く佛に祈願す","xmin":1392.0,"ymin":1850.0,"xmax":1441.0,"ymax":2137.0},{"id":57,"contenttext":"れば、","xmin":1328.0,"ymin":665.0,"xmax":1377.0,"ymax":773.0},{"id":58,"contenttext":"無量無邊の福德果報を生じ來るとす。","xmin":1321.0,"ymin":817.0,"xmax":1377.0,"ymax":1556.0},{"id":59,"contenttext":"是に於いてか、","xmin":1320.0,"ymin":1614.0,"xmax":1371.0,"ymax":1878.0},{"id":60,"contenttext":"新奇を好む","xmin":1318.0,"ymin":1942.0,"xmax":1370.0,"ymax":2138.0},{"id":61,"contenttext":"の人士は、","xmin":1253.0,"ymin":677.0,"xmax":1306.0,"ymax":865.0},{"id":62,"contenttext":"爭ふて佛に歸し、","xmin":1251.0,"ymin":911.0,"xmax":1300.0,"ymax":1230.0},{"id":63,"contenttext":"亦神道を奉ぜざるに至れり。","xmin":1249.0,"ymin":1286.0,"xmax":1298.0,"ymax":1830.0},{"id":64,"contenttext":"是れ神道の發","xmin":1247.0,"ymin":1896.0,"xmax":1298.0,"ymax":2142.0},{"id":65,"contenttext":"達が著しく沮礙を蒙りたる所以也。","xmin":1172.0,"ymin":674.0,"xmax":1229.0,"ymax":1370.0},{"id":66,"contenttext":"當時熱心なる佛〓の信徒たりし、","xmin":1102.0,"ymin":722.0,"xmax":1151.0,"ymax":1367.0},{"id":67,"contenttext":"厩戶皇子及び蘇我馬子等は、","xmin":1095.0,"ymin":1425.0,"xmax":1150.0,"ymax":1970.0},{"id":68,"contenttext":"物部中","xmin":1095.0,"ymin":2037.0,"xmax":1147.0,"ymax":2138.0},{"id":69,"contenttext":"臣等の神道家を壓倒し、","xmin":1025.0,"ymin":672.0,"xmax":1081.0,"ymax":1139.0},{"id":70,"contenttext":"盛に佛〓を興隆せしも、","xmin":1020.0,"ymin":1190.0,"xmax":1075.0,"ymax":1644.0},{"id":71,"contenttext":"皇子皇位に即かずして","xmin":1020.0,"ymin":1706.0,"xmax":1073.0,"ymax":2136.0},{"id":72,"contenttext":"薨じ給ひ、","xmin":953.0,"ymin":672.0,"xmax":1001.0,"ymax":858.0},{"id":73,"contenttext":"蘇我氏亦滅びて、","xmin":951.0,"ymin":905.0,"xmax":1002.0,"ymax":1228.0},{"id":74,"contenttext":"朝廷にも、","xmin":951.0,"ymin":1282.0,"xmax":997.0,"ymax":1457.0},{"id":75,"contenttext":"〓心なる佛〓家を見ざるのみな","xmin":950.0,"ymin":1517.0,"xmax":997.0,"ymax":2132.0},{"id":76,"contenttext":"らず、","xmin":883.0,"ymin":674.0,"xmax":928.0,"ymax":768.0},{"id":77,"contenttext":"却つて崇佛政治の反動として心を神道に傾けたる政治家の出づる","xmin":872.0,"ymin":811.0,"xmax":931.0,"ymax":2134.0},{"id":78,"contenttext":"神道史綱要","xmin":815.0,"ymin":784.0,"xmax":856.0,"ymax":975.0},{"id":79,"contenttext":"九","xmin":811.0,"ymin":1948.0,"xmax":844.0,"ymax":1956.0},{"id":80,"contenttext":"朝廷の態","xmin":1079.0,"ymin":474.0,"xmax":1118.0,"ymax":585.0},{"id":81,"contenttext":"度","xmin":1053.0,"ymin":474.0,"xmax":1084.0,"ymax":501.0}]