[{"id":1,"contenttext":"て、","xmin":3035.0,"ymin":667.0,"xmax":3082.0,"ymax":712.0},{"id":2,"contenttext":"子々孫々無窮に傳ふるが如く、","xmin":3037.0,"ymin":757.0,"xmax":3088.0,"ymax":1357.0},{"id":3,"contenttext":"又、","xmin":3043.0,"ymin":1414.0,"xmax":3094.0,"ymax":1448.0},{"id":4,"contenttext":"無窮に傳ふる所のもの也。","xmin":3048.0,"ymin":1511.0,"xmax":3102.0,"ymax":1998.0},{"id":5,"contenttext":"唯夫","xmin":3055.0,"ymin":2076.0,"xmax":3100.0,"ymax":2130.0},{"id":6,"contenttext":"れ身體を被ふ所の衣服冠冕は、","xmin":2960.0,"ymin":663.0,"xmax":3021.0,"ymax":1265.0},{"id":7,"contenttext":"時代の要求に應じて變遷するが如く、","xmin":2972.0,"ymin":1323.0,"xmax":3034.0,"ymax":2044.0},{"id":8,"contenttext":"神","xmin":2984.0,"ymin":2123.0,"xmax":3035.0,"ymax":2125.0},{"id":9,"contenttext":"道の根本の實際界に現はるヽ所、","xmin":2888.0,"ymin":663.0,"xmax":2956.0,"ymax":1311.0},{"id":10,"contenttext":"即ち神道の形式着色は、","xmin":2901.0,"ymin":1371.0,"xmax":2963.0,"ymax":1816.0},{"id":11,"contenttext":"時代と共に種","xmin":2912.0,"ymin":1891.0,"xmax":2961.0,"ymax":2123.0},{"id":12,"contenttext":"々に變遷するを免れざる也。","xmin":2817.0,"ymin":670.0,"xmax":2880.0,"ymax":1223.0},{"id":13,"contenttext":"吾人之れよりその變遷に就いて聊か述ぶる","xmin":2825.0,"ymin":1279.0,"xmax":2891.0,"ymax":2122.0},{"id":14,"contenttext":"所あるべし。","xmin":2745.0,"ymin":667.0,"xmax":2794.0,"ymax":901.0},{"id":15,"contenttext":"西洋にては已に古代に論理學の如きの研究を見たりと雖ども、","xmin":2654.0,"ymin":709.0,"xmax":2741.0,"ymax":1959.0},{"id":16,"contenttext":"我が古","xmin":2688.0,"ymin":2037.0,"xmax":2747.0,"ymax":2131.0},{"id":17,"contenttext":"代は言擧せぬを以て國風とせしかば、","xmin":2581.0,"ymin":666.0,"xmax":2648.0,"ymax":1399.0},{"id":18,"contenttext":"神道にも特に言論を立てざりき。","xmin":2600.0,"ymin":1469.0,"xmax":2664.0,"ymax":2106.0},{"id":19,"contenttext":"而かも、","xmin":2514.0,"ymin":670.0,"xmax":2559.0,"ymax":799.0},{"id":20,"contenttext":"神道は能く我が國民の總べての要求に應じたりしも、","xmin":2513.0,"ymin":854.0,"xmax":2589.0,"ymax":1912.0},{"id":21,"contenttext":"朝鮮·支那","xmin":2544.0,"ymin":1995.0,"xmax":2596.0,"ymax":2134.0},{"id":22,"contenttext":"等との交通漸次頻煩となり、","xmin":2446.0,"ymin":672.0,"xmax":2502.0,"ymax":1225.0},{"id":23,"contenttext":"文明益〓發達し來るや、","xmin":2454.0,"ymin":1287.0,"xmax":2513.0,"ymax":1686.0},{"id":24,"contenttext":"從來の形式着色にて","xmin":2463.0,"ymin":1758.0,"xmax":2517.0,"ymax":2130.0},{"id":25,"contenttext":"は、","xmin":2375.0,"ymin":672.0,"xmax":2418.0,"ymax":719.0},{"id":26,"contenttext":"少年が老人の衣服を用ひんとするが如くにて、","xmin":2372.0,"ymin":766.0,"xmax":2438.0,"ymax":1686.0},{"id":27,"contenttext":"我が國民の要求を十","xmin":2392.0,"ymin":1759.0,"xmax":2447.0,"ymax":2132.0},{"id":28,"contenttext":"分に滿足せしむる能はざるに至りぬ。","xmin":2301.0,"ymin":675.0,"xmax":2361.0,"ymax":1411.0},{"id":29,"contenttext":"さりとて我が國民には實際界には、","xmin":2316.0,"ymin":1478.0,"xmax":2371.0,"ymax":2136.0},{"id":30,"contenttext":"豐臣秀吉の如き偉人を見しと雖も、","xmin":2226.0,"ymin":677.0,"xmax":2287.0,"ymax":1368.0},{"id":31,"contenttext":"學者には、","xmin":2239.0,"ymin":1429.0,"xmax":2292.0,"ymax":1601.0},{"id":32,"contenttext":"アリストテレースの如き、","xmin":2243.0,"ymin":1670.0,"xmax":2301.0,"ymax":2139.0},{"id":33,"contenttext":"カントの如き、","xmin":2152.0,"ymin":681.0,"xmax":2209.0,"ymax":953.0},{"id":34,"contenttext":"組織的頭腦を有せる偉人出でざりき。","xmin":2158.0,"ymin":1008.0,"xmax":2219.0,"ymax":1736.0},{"id":35,"contenttext":"從つて神道の根本","xmin":2169.0,"ymin":1804.0,"xmax":2230.0,"ymax":2135.0},{"id":36,"contenttext":"外國思想","xmin":2530.0,"ymin":474.0,"xmax":2567.0,"ymax":582.0},{"id":37,"contenttext":"の影響","xmin":2501.0,"ymin":477.0,"xmax":2538.0,"ymax":557.0},{"id":38,"contenttext":"の上に一大學說を組織し、","xmin":1772.0,"ymin":709.0,"xmax":1821.0,"ymax":1211.0},{"id":39,"contenttext":"我が國民の要求を遺憾なく滿足せしむるもの","xmin":1760.0,"ymin":1275.0,"xmax":1820.0,"ymax":2165.0},{"id":40,"contenttext":"なかりき。","xmin":1707.0,"ymin":709.0,"xmax":1749.0,"ymax":887.0},{"id":41,"contenttext":"是に於いてか古來比較的に傑出せる人士は、","xmin":1691.0,"ymin":940.0,"xmax":1750.0,"ymax":1813.0},{"id":42,"contenttext":"支那に發達せる","xmin":1689.0,"ymin":1888.0,"xmax":1742.0,"ymax":2163.0},{"id":43,"contenttext":"學說、","xmin":1629.0,"ymin":705.0,"xmax":1678.0,"ymax":793.0},{"id":44,"contenttext":"印度に發達せる學說、","xmin":1625.0,"ymin":847.0,"xmax":1674.0,"ymax":1257.0},{"id":45,"contenttext":"西洋に發達せる學說を取り來りて、","xmin":1614.0,"ymin":1319.0,"xmax":1673.0,"ymax":1999.0},{"id":46,"contenttext":"之れを","xmin":1613.0,"ymin":2076.0,"xmax":1663.0,"ymax":2166.0},{"id":47,"contenttext":"神道の根柢の幹枝とし、","xmin":1551.0,"ymin":703.0,"xmax":1600.0,"ymax":1163.0},{"id":48,"contenttext":"以つて一の完全なる神道の學說を搆成し、","xmin":1542.0,"ymin":1223.0,"xmax":1599.0,"ymax":2044.0},{"id":49,"contenttext":"我が","xmin":1543.0,"ymin":2125.0,"xmax":1590.0,"ymax":2164.0},{"id":50,"contenttext":"國民の總べての要求に應ぜんとせり。","xmin":1484.0,"ymin":700.0,"xmax":1528.0,"ymax":1439.0},{"id":51,"contenttext":"かくて最も初めに影響を蒙りたるものは、","xmin":1412.0,"ymin":751.0,"xmax":1459.0,"ymax":1578.0},{"id":52,"contenttext":"儒〓也。","xmin":1408.0,"ymin":1645.0,"xmax":1459.0,"ymax":1766.0},{"id":53,"contenttext":"勿論、","xmin":1402.0,"ymin":1837.0,"xmax":1456.0,"ymax":1904.0},{"id":54,"contenttext":"儒〓は古の","xmin":1399.0,"ymin":1978.0,"xmax":1454.0,"ymax":2162.0},{"id":55,"contenttext":"聖帝堯舜の創むる所と稱す。","xmin":1339.0,"ymin":698.0,"xmax":1388.0,"ymax":1253.0},{"id":56,"contenttext":"而かも彼れ等は、","xmin":1335.0,"ymin":1315.0,"xmax":1384.0,"ymax":1622.0},{"id":57,"contenttext":"匹夫を擧げて九五の尊を","xmin":1325.0,"ymin":1693.0,"xmax":1383.0,"ymax":2161.0},{"id":58,"contenttext":"緒がしめて怪まず。","xmin":1265.0,"ymin":698.0,"xmax":1317.0,"ymax":1069.0},{"id":59,"contenttext":"又古の聖王湯武の唱ふる所と云ふ。","xmin":1258.0,"ymin":1122.0,"xmax":1315.0,"ymax":1807.0},{"id":60,"contenttext":"而かも彼れ等は、","xmin":1251.0,"ymin":1880.0,"xmax":1304.0,"ymax":2165.0},{"id":61,"contenttext":"君主を伐ちて萬乘の位を奪ひて耻ぢず。","xmin":1189.0,"ymin":698.0,"xmax":1243.0,"ymax":1481.0},{"id":62,"contenttext":"君臣の大義、","xmin":1184.0,"ymin":1551.0,"xmax":1239.0,"ymax":1762.0},{"id":63,"contenttext":"上下の名分、","xmin":1181.0,"ymin":1836.0,"xmax":1234.0,"ymax":2042.0},{"id":64,"contenttext":"その","xmin":1183.0,"ymin":2122.0,"xmax":1224.0,"ymax":2156.0},{"id":65,"contenttext":"根本に於いて誤れり。","xmin":1118.0,"ymin":696.0,"xmax":1167.0,"ymax":1112.0},{"id":66,"contenttext":"從つて儒〓の思想は、","xmin":1116.0,"ymin":1170.0,"xmax":1167.0,"ymax":1576.0},{"id":67,"contenttext":"我が神道の根本に對し、","xmin":1104.0,"ymin":1645.0,"xmax":1165.0,"ymax":2089.0},{"id":68,"contenttext":"些","xmin":1108.0,"ymin":2158.0,"xmax":1155.0,"ymax":2164.0},{"id":69,"contenttext":"の貢獻する所あらざりし也。","xmin":1048.0,"ymin":700.0,"xmax":1093.0,"ymax":1253.0},{"id":70,"contenttext":"唯~彼れ儒〓にありては、","xmin":1036.0,"ymin":1313.0,"xmax":1093.0,"ymax":1760.0},{"id":71,"contenttext":"たとひ大義名分の","xmin":1033.0,"ymin":1836.0,"xmax":1086.0,"ymax":2157.0},{"id":72,"contenttext":"根柢は喪へりと雖も、","xmin":975.0,"ymin":694.0,"xmax":1024.0,"ymax":1108.0},{"id":73,"contenttext":"而かも一たび君となり、","xmin":971.0,"ymin":1168.0,"xmax":1020.0,"ymax":1617.0},{"id":74,"contenttext":"上となりし所謂聖人は、","xmin":962.0,"ymin":1690.0,"xmax":1020.0,"ymax":2128.0},{"id":75,"contenttext":"萬民をして大義を守らしめ、","xmin":899.0,"ymin":691.0,"xmax":949.0,"ymax":1247.0},{"id":76,"contenttext":"名分を正さしめ、","xmin":895.0,"ymin":1308.0,"xmax":944.0,"ymax":1617.0},{"id":77,"contenttext":"自らの地位を維持し、","xmin":888.0,"ymin":1688.0,"xmax":939.0,"ymax":2083.0},{"id":78,"contenttext":"國","xmin":891.0,"ymin":2156.0,"xmax":934.0,"ymax":2160.0},{"id":79,"contenttext":"神道史綱要","xmin":834.0,"ymin":817.0,"xmax":873.0,"ymax":1001.0},{"id":80,"contenttext":"管","xmin":1400.0,"ymin":499.0,"xmax":1431.0,"ymax":521.0},{"id":81,"contenttext":"需教の影","xmin":1424.0,"ymin":499.0,"xmax":1463.0,"ymax":607.0}]