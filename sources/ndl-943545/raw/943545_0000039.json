[{"id":0,"contenttext":"交","xmin":3139.0,"ymin":1977.0,"xmax":3176.0,"ymax":2018.0},{"id":1,"contenttext":"て違ふことなきを道と云ひ、","xmin":3084.0,"ymin":769.0,"xmax":3140.0,"ymax":1335.0},{"id":2,"contenttext":"〓と云ふ。","xmin":3080.0,"ymin":1368.0,"xmax":3136.0,"ymax":1574.0},{"id":3,"contenttext":"と。","xmin":3027.0,"ymin":725.0,"xmax":3059.0,"ymax":779.0},{"id":4,"contenttext":"かくて彼れは水戶流の特色を帶びて、","xmin":3007.0,"ymin":812.0,"xmax":3066.0,"ymax":1566.0},{"id":5,"contenttext":"儒〓によりて、","xmin":3003.0,"ymin":1600.0,"xmax":3059.0,"ymax":1886.0},{"id":6,"contenttext":"神道を說けり。","xmin":3004.0,"ymin":1922.0,"xmax":3051.0,"ymax":2207.0},{"id":7,"contenttext":"而かも勿論神道を主とせるものにして、「朱髯綠眼の非類」など往々極端の言","xmin":2925.0,"ymin":720.0,"xmax":2998.0,"ymax":2200.0},{"id":8,"contenttext":"をなせりと雖も、","xmin":2871.0,"ymin":720.0,"xmax":2916.0,"ymax":1053.0},{"id":9,"contenttext":"又「後世學者狹隘の見を懷き、","xmin":2861.0,"ymin":1090.0,"xmax":2920.0,"ymax":1656.0},{"id":10,"contenttext":"同を合せ、","xmin":2859.0,"ymin":1689.0,"xmax":2910.0,"ymax":1888.0},{"id":11,"contenttext":"異を兼ぬるこ","xmin":2855.0,"ymin":1922.0,"xmax":2904.0,"ymax":2195.0},{"id":12,"contenttext":"と能はず」と云ひ、","xmin":2793.0,"ymin":720.0,"xmax":2846.0,"ymax":1051.0},{"id":13,"contenttext":"偏狹徒らに他を排斥するを歎せり。","xmin":2783.0,"ymin":1088.0,"xmax":2843.0,"ymax":1797.0},{"id":14,"contenttext":"以つて其の志の存","xmin":2777.0,"ymin":1825.0,"xmax":2836.0,"ymax":2200.0},{"id":15,"contenttext":"する所を知るべし。","xmin":2720.0,"ymin":716.0,"xmax":2771.0,"ymax":1100.0},{"id":16,"contenttext":"宗〓的神道は、","xmin":2639.0,"ymin":759.0,"xmax":2695.0,"ymax":1051.0},{"id":17,"contenttext":"吾人の已に述べたる中古の佛〓的色釆を帶びたる山王","xmin":2617.0,"ymin":1084.0,"xmax":2693.0,"ymax":2194.0},{"id":18,"contenttext":"一實神道、","xmin":2569.0,"ymin":722.0,"xmax":2620.0,"ymax":906.0},{"id":19,"contenttext":"兩部習合神道、","xmin":2564.0,"ymin":943.0,"xmax":2618.0,"ymax":1231.0},{"id":20,"contenttext":"唯一神道の如き、","xmin":2559.0,"ymin":1268.0,"xmax":2612.0,"ymax":1600.0},{"id":21,"contenttext":"尙幕末に至るまで勢力を有","xmin":2551.0,"ymin":1638.0,"xmax":2609.0,"ymax":2191.0},{"id":22,"contenttext":"し來りしが、","xmin":2497.0,"ymin":710.0,"xmax":2547.0,"ymax":952.0},{"id":23,"contenttext":"別に幕府の初期に長谷川角行なるものあり。","xmin":2483.0,"ymin":988.0,"xmax":2545.0,"ymax":1880.0},{"id":24,"contenttext":"皇國は萬國の","xmin":2482.0,"ymin":1914.0,"xmax":2533.0,"ymax":2189.0},{"id":25,"contenttext":"宗國にして、","xmin":2426.0,"ymin":710.0,"xmax":2475.0,"ymax":950.0},{"id":26,"contenttext":"富士は地球の鎭守たりとし、","xmin":2415.0,"ymin":988.0,"xmax":2472.0,"ymax":1554.0},{"id":27,"contenttext":"富士講を初めたり。","xmin":2414.0,"ymin":1589.0,"xmax":2465.0,"ymax":1976.0},{"id":28,"contenttext":"されど富","xmin":2410.0,"ymin":2010.0,"xmax":2459.0,"ymax":2191.0},{"id":29,"contenttext":"士講には種々の弊害ありしかば、","xmin":2344.0,"ymin":710.0,"xmax":2405.0,"ymax":1368.0},{"id":30,"contenttext":"幕府は之れを禁止したり。","xmin":2337.0,"ymin":1402.0,"xmax":2396.0,"ymax":1930.0},{"id":31,"contenttext":"德川時代にありて、","xmin":2273.0,"ymin":753.0,"xmax":2329.0,"ymax":1135.0},{"id":32,"contenttext":"宗〓的神道を鼓吹して其の名を知られたるものに、","xmin":2260.0,"ymin":1170.0,"xmax":2325.0,"ymax":2191.0},{"id":33,"contenttext":"黑住宗忠あり。","xmin":2203.0,"ymin":706.0,"xmax":2252.0,"ymax":997.0},{"id":34,"contenttext":"宗〓的神","xmin":2663.0,"ymin":515.0,"xmax":2707.0,"ymax":637.0},{"id":35,"contenttext":"道","xmin":2641.0,"ymin":516.0,"xmax":2673.0,"ymax":550.0},{"id":36,"contenttext":"黑住宗忠","xmin":1805.0,"ymin":492.0,"xmax":1837.0,"ymax":612.0},{"id":37,"contenttext":"宗忠は備前の人、","xmin":1805.0,"ymin":738.0,"xmax":1859.0,"ymax":1077.0},{"id":38,"contenttext":"安永九年を以つて生る。","xmin":1798.0,"ymin":1112.0,"xmax":1855.0,"ymax":1595.0},{"id":39,"contenttext":"生れて至孝、","xmin":1803.0,"ymin":1624.0,"xmax":1850.0,"ymax":1866.0},{"id":40,"contenttext":"年三十三、","xmin":1798.0,"ymin":1902.0,"xmax":1850.0,"ymax":2099.0},{"id":41,"contenttext":"父","xmin":1798.0,"ymin":2133.0,"xmax":1848.0,"ymax":2181.0},{"id":42,"contenttext":"母の死に遇ひ悲哀の極に達せり。","xmin":1732.0,"ymin":691.0,"xmax":1789.0,"ymax":1355.0},{"id":43,"contenttext":"窮すれば則ち通ず。","xmin":1731.0,"ymin":1389.0,"xmax":1782.0,"ymax":1778.0},{"id":44,"contenttext":"遂に豁然悟る所あ","xmin":1724.0,"ymin":1805.0,"xmax":1780.0,"ymax":2179.0},{"id":45,"contenttext":"り、","xmin":1672.0,"ymin":694.0,"xmax":1702.0,"ymax":745.0},{"id":46,"contenttext":"一派の神道を創む。","xmin":1660.0,"ymin":784.0,"xmax":1710.0,"ymax":1161.0},{"id":47,"contenttext":"嘉永三年歿す。","xmin":1657.0,"ymin":1191.0,"xmax":1707.0,"ymax":1472.0},{"id":48,"contenttext":"年七十一、","xmin":1651.0,"ymin":1498.0,"xmax":1710.0,"ymax":1700.0},{"id":49,"contenttext":"後","xmin":1655.0,"ymin":1720.0,"xmax":1704.0,"ymax":1780.0},{"id":50,"contenttext":"宗忠大明神の宣下","xmin":1649.0,"ymin":1807.0,"xmax":1706.0,"ymax":2179.0},{"id":51,"contenttext":"を蒙る。","xmin":1594.0,"ymin":692.0,"xmax":1639.0,"ymax":846.0},{"id":52,"contenttext":"その說、","xmin":1590.0,"ymin":876.0,"xmax":1637.0,"ymax":1017.0},{"id":53,"contenttext":"「神國の人に生れ常に信心なき事」","xmin":1582.0,"ymin":1043.0,"xmax":1638.0,"ymax":1725.0},{"id":54,"contenttext":"「腹を立、","xmin":1581.0,"ymin":1750.0,"xmax":1634.0,"ymax":1912.0},{"id":55,"contenttext":"物を苦にす","xmin":1582.0,"ymin":1945.0,"xmax":1629.0,"ymax":2175.0},{"id":56,"contenttext":"る事、","xmin":1519.0,"ymin":690.0,"xmax":1568.0,"ymax":793.0},{"id":57,"contenttext":"「己が慢心にて人を見下すこと」など七箇條の信條を示し、","xmin":1505.0,"ymin":818.0,"xmax":1572.0,"ymax":1958.0},{"id":58,"contenttext":"天照大神","xmin":1502.0,"ymin":1990.0,"xmax":1559.0,"ymax":2177.0},{"id":59,"contenttext":"を主神とし、","xmin":1441.0,"ymin":687.0,"xmax":1493.0,"ymax":932.0},{"id":60,"contenttext":"極めて熱心にその神道を說きたり。","xmin":1437.0,"ymin":968.0,"xmax":1490.0,"ymax":1678.0},{"id":61,"contenttext":"之れを黑住〓と云ふ。","xmin":1430.0,"ymin":1711.0,"xmax":1487.0,"ymax":2148.0},{"id":62,"contenttext":"宗忠と殆んど同時に井上正鐵あり。","xmin":1364.0,"ymin":685.0,"xmax":1419.0,"ymax":1400.0},{"id":63,"contenttext":"正鐵は武藏の人、","xmin":1291.0,"ymin":732.0,"xmax":1346.0,"ymax":1071.0},{"id":64,"contenttext":"寛政二年を以つて生る。","xmin":1288.0,"ymin":1104.0,"xmax":1341.0,"ymax":1586.0},{"id":65,"contenttext":"長じて白河家の門に入り遂","xmin":1282.0,"ymin":1613.0,"xmax":1338.0,"ymax":2171.0},{"id":66,"contenttext":"に一家を成せしかば、","xmin":1221.0,"ymin":685.0,"xmax":1273.0,"ymax":1114.0},{"id":67,"contenttext":"信徒日に集る。","xmin":1219.0,"ymin":1149.0,"xmax":1272.0,"ymax":1445.0},{"id":68,"contenttext":"新說世を惑はすの嫌疑により、","xmin":1212.0,"ymin":1474.0,"xmax":1270.0,"ymax":2091.0},{"id":69,"contenttext":"伊","xmin":1216.0,"ymin":2125.0,"xmax":1263.0,"ymax":2173.0},{"id":70,"contenttext":"豆の三宅島に流さる。","xmin":1147.0,"ymin":682.0,"xmax":1197.0,"ymax":1116.0},{"id":71,"contenttext":"島民その〓を奉ず。","xmin":1144.0,"ymin":1150.0,"xmax":1198.0,"ymax":1539.0},{"id":72,"contenttext":"嘉永二年二月島中に歿す。","xmin":1134.0,"ymin":1566.0,"xmax":1197.0,"ymax":2097.0},{"id":73,"contenttext":"年","xmin":1138.0,"ymin":2122.0,"xmax":1187.0,"ymax":2166.0},{"id":74,"contenttext":"六十。","xmin":1067.0,"ymin":680.0,"xmax":1124.0,"ymax":797.0},{"id":75,"contenttext":"明治維新の後、","xmin":1069.0,"ymin":821.0,"xmax":1122.0,"ymax":1112.0},{"id":76,"contenttext":"その信徒等相議して禊〓を立せり。","xmin":1065.0,"ymin":1150.0,"xmax":1120.0,"ymax":1860.0},{"id":77,"contenttext":"幕末の宗〓的神道を唱へたるものに、","xmin":986.0,"ymin":728.0,"xmax":1043.0,"ymax":1489.0},{"id":78,"contenttext":"尙","xmin":990.0,"ymin":1518.0,"xmax":1038.0,"ymax":1566.0},{"id":79,"contenttext":"川手文治郎あり。","xmin":985.0,"ymin":1607.0,"xmax":1038.0,"ymax":1952.0},{"id":80,"contenttext":"竹澤寛三","xmin":985.0,"ymin":1981.0,"xmax":1034.0,"ymax":2166.0},{"id":81,"contenttext":"郞あり。","xmin":922.0,"ymin":678.0,"xmax":969.0,"ymax":833.0},{"id":82,"contenttext":"又記する所あるを要す。","xmin":918.0,"ymin":866.0,"xmax":967.0,"ymax":1347.0},{"id":83,"contenttext":"神道史網要","xmin":865.0,"ymin":790.0,"xmax":901.0,"ymax":997.0},{"id":84,"contenttext":"充","xmin":854.0,"ymin":1945.0,"xmax":885.0,"ymax":1984.0},{"id":85,"contenttext":"井上正〓","xmin":1301.0,"ymin":485.0,"xmax":1343.0,"ymax":610.0},{"id":86,"contenttext":"竹澤寛三","xmin":985.0,"ymin":1981.0,"xmax":1034.0,"ymax":2166.0},{"id":87,"contenttext":"充","xmin":854.0,"ymin":1945.0,"xmax":885.0,"ymax":1984.0}]