[{"id":0,"contenttext":"圖","xmin":3176.0,"ymin":1957.0,"xmax":3211.0,"ymax":1995.0},{"id":1,"contenttext":"その學に服し、","xmin":3113.0,"ymin":708.0,"xmax":3166.0,"ymax":1000.0},{"id":2,"contenttext":"直に名簿を松坂に送り、","xmin":3103.0,"ymin":1030.0,"xmax":3161.0,"ymax":1511.0},{"id":3,"contenttext":"その門人たらんことを求む。","xmin":3093.0,"ymin":1541.0,"xmax":3148.0,"ymax":2106.0},{"id":4,"contenttext":"會","xmin":3090.0,"ymin":2135.0,"xmax":3135.0,"ymax":2199.0},{"id":5,"contenttext":"宣長歿せしを以つて茲に所謂歿後の門人となりき。","xmin":3026.0,"ymin":705.0,"xmax":3097.0,"ymax":1738.0},{"id":6,"contenttext":"是れより全く一身を","xmin":3016.0,"ymin":1772.0,"xmax":3075.0,"ymax":2188.0},{"id":7,"contenttext":"國學に委ね、","xmin":2968.0,"ymin":703.0,"xmax":3028.0,"ymax":951.0},{"id":8,"contenttext":"研鑽年久しく、","xmin":2965.0,"ymin":982.0,"xmax":3017.0,"ymax":1273.0},{"id":9,"contenttext":"遂に欝然一家をなせり。","xmin":2951.0,"ymin":1304.0,"xmax":3011.0,"ymax":1785.0},{"id":10,"contenttext":"先づ『呵妄書』を著","xmin":2940.0,"ymin":1815.0,"xmax":3002.0,"ymax":2188.0},{"id":11,"contenttext":"はして、","xmin":2898.0,"ymin":703.0,"xmax":2950.0,"ymax":858.0},{"id":12,"contenttext":"大宰春臺を罵倒し、『鬼神新論』","xmin":2882.0,"ymin":887.0,"xmax":2950.0,"ymax":1511.0},{"id":13,"contenttext":"を著はして、","xmin":2879.0,"ymin":1535.0,"xmax":2934.0,"ymax":1785.0},{"id":14,"contenttext":"儒者を叱斥し、","xmin":2866.0,"ymin":1814.0,"xmax":2930.0,"ymax":2110.0},{"id":15,"contenttext":"而","xmin":2869.0,"ymin":2141.0,"xmax":2916.0,"ymax":2187.0},{"id":16,"contenttext":"して後『古史徵』·『古史成文」·『靈能眞柱』等を公にして、","xmin":2798.0,"ymin":701.0,"xmax":2880.0,"ymax":1783.0},{"id":17,"contenttext":"進んで積極的に復","xmin":2793.0,"ymin":1811.0,"xmax":2854.0,"ymax":2184.0},{"id":18,"contenttext":"古神道を天下に唱ふ。","xmin":2742.0,"ymin":700.0,"xmax":2802.0,"ymax":1133.0},{"id":19,"contenttext":"天下負笈の士集り來りて其の門に投ず。","xmin":2719.0,"ymin":1163.0,"xmax":2791.0,"ymax":1969.0},{"id":20,"contenttext":"文政六年","xmin":2716.0,"ymin":1997.0,"xmax":2773.0,"ymax":2184.0},{"id":21,"contenttext":"著書數部を提げて京師に入り、","xmin":2663.0,"ymin":697.0,"xmax":2727.0,"ymax":1315.0},{"id":22,"contenttext":"之れを禁裡及び仙洞に献ず。","xmin":2650.0,"ymin":1343.0,"xmax":2711.0,"ymax":1918.0},{"id":23,"contenttext":"茲にその著","xmin":2644.0,"ymin":1948.0,"xmax":2696.0,"ymax":2179.0},{"id":24,"contenttext":"書は天覽叡感の四字を冠し、","xmin":2591.0,"ymin":695.0,"xmax":2659.0,"ymax":1268.0},{"id":25,"contenttext":"一層の光輝を放つに至れり。","xmin":2578.0,"ymin":1306.0,"xmax":2640.0,"ymax":1867.0},{"id":26,"contenttext":"かくて當時有","xmin":2572.0,"ymin":1903.0,"xmax":2624.0,"ymax":2179.0},{"id":27,"contenttext":"力なりし吉田家は、","xmin":2526.0,"ymin":699.0,"xmax":2581.0,"ymax":1084.0},{"id":28,"contenttext":"篤胤を聘して神官の〓授たらしめ、","xmin":2506.0,"ymin":1114.0,"xmax":2575.0,"ymax":1822.0},{"id":29,"contenttext":"神祇伯白川の資","xmin":2500.0,"ymin":1852.0,"xmax":2556.0,"ymax":2178.0},{"id":30,"contenttext":"敬王は、","xmin":2454.0,"ymin":690.0,"xmax":2513.0,"ymax":848.0},{"id":31,"contenttext":"篤胤を擢んじて學師の重職に任じぬ。","xmin":2436.0,"ymin":877.0,"xmax":2508.0,"ymax":1635.0},{"id":32,"contenttext":"是に至り篤胤の盛名赫々","xmin":2423.0,"ymin":1664.0,"xmax":2489.0,"ymax":2173.0},{"id":33,"contenttext":"天下に鳴る。","xmin":2380.0,"ymin":689.0,"xmax":2435.0,"ymax":933.0},{"id":34,"contenttext":"秋田藩見て大いに喜び、","xmin":2366.0,"ymin":967.0,"xmax":2431.0,"ymax":1448.0},{"id":35,"contenttext":"その歸藩を求む。","xmin":2359.0,"ymin":1476.0,"xmax":2414.0,"ymax":1817.0},{"id":36,"contenttext":"是れより秋田藩","xmin":2349.0,"ymin":1848.0,"xmax":2405.0,"ymax":2171.0},{"id":37,"contenttext":"士となれり。","xmin":2312.0,"ymin":691.0,"xmax":2361.0,"ymax":934.0},{"id":38,"contenttext":"既にして篤胤の熱心なる敬神尊王の說は、","xmin":2284.0,"ymin":965.0,"xmax":2358.0,"ymax":1812.0},{"id":39,"contenttext":"動もすれば幕府","xmin":2276.0,"ymin":1844.0,"xmax":2333.0,"ymax":2169.0},{"id":40,"contenttext":"成立の基礎を危くせんとするの虞あり。","xmin":2224.0,"ymin":685.0,"xmax":2289.0,"ymax":1482.0},{"id":41,"contenttext":"戰々兢々家康の業を失墜せんこ","xmin":2203.0,"ymin":1516.0,"xmax":2270.0,"ymax":2165.0},{"id":42,"contenttext":"盛名天下","xmin":2398.0,"ymin":492.0,"xmax":2443.0,"ymax":613.0},{"id":43,"contenttext":"に鳴る","xmin":2373.0,"ymin":496.0,"xmax":2405.0,"ymax":582.0},{"id":44,"contenttext":"とを恐るゝ當路の吏、","xmin":1790.0,"ymin":699.0,"xmax":1851.0,"ymax":1129.0},{"id":45,"contenttext":"遂に默する能はず。","xmin":1800.0,"ymin":1161.0,"xmax":1857.0,"ymax":1548.0},{"id":46,"contenttext":"江戶を追ひ、","xmin":1806.0,"ymin":1576.0,"xmax":1861.0,"ymax":1828.0},{"id":47,"contenttext":"國に歸らしめ、","xmin":1811.0,"ymin":1852.0,"xmax":1867.0,"ymax":2149.0},{"id":48,"contenttext":"且つ將來の著書を禁ぜり。","xmin":1718.0,"ymin":700.0,"xmax":1776.0,"ymax":1225.0},{"id":49,"contenttext":"天保十四年閏九月十一日篤胤遂に秋田に歿し","xmin":1726.0,"ymin":1257.0,"xmax":1794.0,"ymax":2183.0},{"id":50,"contenttext":"ぬ。","xmin":1653.0,"ymin":706.0,"xmax":1692.0,"ymax":759.0},{"id":51,"contenttext":"年六十八。","xmin":1647.0,"ymin":794.0,"xmax":1700.0,"ymax":997.0},{"id":52,"contenttext":"束脩の門人五百五十餘人。","xmin":1649.0,"ymin":1024.0,"xmax":1711.0,"ymax":1554.0},{"id":53,"contenttext":"歿後の門人一千三百餘人に及","xmin":1658.0,"ymin":1580.0,"xmax":1724.0,"ymax":2186.0},{"id":54,"contenttext":"べりと云ふ。","xmin":1580.0,"ymin":710.0,"xmax":1625.0,"ymax":948.0},{"id":55,"contenttext":"著はす所、","xmin":1577.0,"ymin":977.0,"xmax":1634.0,"ymax":1182.0},{"id":56,"contenttext":"右に擧げたるものゝ外、『古史傳』三十二卷、","xmin":1583.0,"ymin":1212.0,"xmax":1645.0,"ymax":2065.0},{"id":57,"contenttext":"『古道","xmin":1598.0,"ymin":2065.0,"xmax":1645.0,"ymax":2185.0},{"id":58,"contenttext":"大意』二卷、","xmin":1508.0,"ymin":704.0,"xmax":1562.0,"ymax":931.0},{"id":59,"contenttext":"『大道或問』一卷、","xmin":1513.0,"ymin":941.0,"xmax":1566.0,"ymax":1267.0},{"id":60,"contenttext":"氣吹壓三卷、","xmin":1517.0,"ymin":1294.0,"xmax":1571.0,"ymax":1556.0},{"id":61,"contenttext":"『俗神道大意』四卷、","xmin":1521.0,"ymin":1560.0,"xmax":1574.0,"ymax":1954.0},{"id":62,"contenttext":"『印度藏志』","xmin":1529.0,"ymin":1957.0,"xmax":1576.0,"ymax":2185.0},{"id":63,"contenttext":"二十五卷、","xmin":1437.0,"ymin":704.0,"xmax":1492.0,"ymax":905.0},{"id":64,"contenttext":"『出定笑語』六卷、","xmin":1443.0,"ymin":915.0,"xmax":1496.0,"ymax":1263.0},{"id":65,"contenttext":"『赤縣太古傳』","xmin":1445.0,"ymin":1263.0,"xmax":1503.0,"ymax":1546.0},{"id":66,"contenttext":"三卷、","xmin":1451.0,"ymin":1550.0,"xmax":1502.0,"ymax":1664.0},{"id":67,"contenttext":"『西籍〓論』四卷等百有餘","xmin":1452.0,"ymin":1666.0,"xmax":1511.0,"ymax":2189.0},{"id":68,"contenttext":"部あり。","xmin":1365.0,"ymin":708.0,"xmax":1410.0,"ymax":858.0},{"id":69,"contenttext":"篤胤、","xmin":1284.0,"ymin":745.0,"xmax":1338.0,"ymax":850.0},{"id":70,"contenttext":"資性豪悍不屈、","xmin":1287.0,"ymin":883.0,"xmax":1346.0,"ymax":1170.0},{"id":71,"contenttext":"甞て道を說き道を學ぶものは、","xmin":1296.0,"ymin":1206.0,"xmax":1358.0,"ymax":1822.0},{"id":72,"contenttext":"人の信ずると信","xmin":1307.0,"ymin":1856.0,"xmax":1363.0,"ymax":2183.0},{"id":73,"contenttext":"ぜぬとに少しも心を殘さず","xmin":1205.0,"ymin":701.0,"xmax":1270.0,"ymax":1256.0},{"id":74,"contenttext":"獨立獨行","xmin":1224.0,"ymin":1395.0,"xmax":1277.0,"ymax":1584.0},{"id":75,"contenttext":"眞の道を學ぶと云へり。","xmin":1229.0,"ymin":1719.0,"xmax":1287.0,"ymax":2192.0},{"id":76,"contenttext":"されは、","xmin":1136.0,"ymin":704.0,"xmax":1182.0,"ymax":850.0},{"id":77,"contenttext":"宣長が歿後の門人となり、","xmin":1140.0,"ymin":887.0,"xmax":1199.0,"ymax":1413.0},{"id":78,"contenttext":"深く宣長を尊崇せりと雖ども、","xmin":1150.0,"ymin":1441.0,"xmax":1214.0,"ymax":2059.0},{"id":79,"contenttext":"その","xmin":1167.0,"ymin":2094.0,"xmax":1212.0,"ymax":2181.0},{"id":80,"contenttext":"學說は、","xmin":1069.0,"ymin":712.0,"xmax":1116.0,"ymax":865.0},{"id":81,"contenttext":"純粹に之れを紹述せるにあらず。","xmin":1070.0,"ymin":896.0,"xmax":1130.0,"ymax":1562.0},{"id":82,"contenttext":"今茲にその主なるものを述ぶ","xmin":1083.0,"ymin":1591.0,"xmax":1135.0,"ymax":2189.0},{"id":83,"contenttext":"れば、","xmin":993.0,"ymin":713.0,"xmax":1049.0,"ymax":823.0},{"id":84,"contenttext":"神道創世の說に於いて、","xmin":997.0,"ymin":849.0,"xmax":1056.0,"ymax":1333.0},{"id":85,"contenttext":"彼れは高皇產靈·神皇產靈二神天地を鎔造","xmin":1006.0,"ymin":1362.0,"xmax":1067.0,"ymax":2195.0},{"id":86,"contenttext":"せられたりと云ふ宣長の說を遵奉せりと雖も、","xmin":921.0,"ymin":716.0,"xmax":988.0,"ymax":1652.0},{"id":87,"contenttext":"宣長が高天原を虛空の上","xmin":936.0,"ymin":1685.0,"xmax":993.0,"ymax":2197.0},{"id":88,"contenttext":"四五","xmin":877.0,"ymin":1961.0,"xmax":907.0,"ymax":1999.0},{"id":89,"contenttext":"神道史綱要","xmin":862.0,"ymin":821.0,"xmax":900.0,"ymax":1028.0},{"id":90,"contenttext":"宣長の說","xmin":1076.0,"ymin":511.0,"xmax":1115.0,"ymax":633.0},{"id":91,"contenttext":"に盲從せ","xmin":1047.0,"ymin":513.0,"xmax":1086.0,"ymax":633.0}]