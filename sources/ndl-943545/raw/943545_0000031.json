[{"id":0,"contenttext":"吾","xmin":3121.0,"ymin":1983.0,"xmax":3151.0,"ymax":2019.0},{"id":1,"contenttext":"なり。","xmin":3068.0,"ymin":720.0,"xmax":3106.0,"ymax":824.0},{"id":2,"contenttext":"考へ玉へ云云。","xmin":3056.0,"ymin":853.0,"xmax":3112.0,"ymax":1151.0},{"id":3,"contenttext":"と以つてその人となりを見るべし。","xmin":2986.0,"ymin":720.0,"xmax":3038.0,"ymax":1427.0},{"id":4,"contenttext":"弘化三年十月十四日病んで京都に歿","xmin":2968.0,"ymin":1456.0,"xmax":3030.0,"ymax":2202.0},{"id":5,"contenttext":"す。","xmin":2923.0,"ymin":714.0,"xmax":2965.0,"ymax":775.0},{"id":6,"contenttext":"年七十四。","xmin":2916.0,"ymin":806.0,"xmax":2970.0,"ymax":1012.0},{"id":7,"contenttext":"若狹國發心寺に葬る。","xmin":2910.0,"ymin":1039.0,"xmax":2967.0,"ymax":1476.0},{"id":8,"contenttext":"著はす所、","xmin":2908.0,"ymin":1505.0,"xmax":2959.0,"ymax":1704.0},{"id":9,"contenttext":"『神社私考』『假字本末』『鎭","xmin":2896.0,"ymin":1719.0,"xmax":2960.0,"ymax":2204.0},{"id":10,"contenttext":"魂傅』『信友隨筆』『正ト考』等百有餘部、","xmin":2837.0,"ymin":714.0,"xmax":2899.0,"ymax":1447.0},{"id":11,"contenttext":"『日本紀』等校訂せるもの五十餘部。","xmin":2826.0,"ymin":1474.0,"xmax":2889.0,"ymax":2171.0},{"id":12,"contenttext":"信友は常にその書齋の床上に、","xmin":2759.0,"ymin":756.0,"xmax":2830.0,"ymax":1376.0},{"id":13,"contenttext":"シ","xmin":2790.0,"ymin":1765.0,"xmax":2814.0,"ymax":1809.0},{"id":14,"contenttext":"孔子の「述而不作信而好古の書軸を揭げ、","xmin":2733.0,"ymin":1406.0,"xmax":2811.0,"ymax":2204.0},{"id":15,"contenttext":"吾が意を得たりとせるものなれば、","xmin":2689.0,"ymin":709.0,"xmax":2754.0,"ymax":1423.0},{"id":16,"contenttext":"その學風亦篤胤の如きと全く相反し、","xmin":2664.0,"ymin":1451.0,"xmax":2737.0,"ymax":2202.0},{"id":17,"contenttext":"終始考證是れ事とせり。","xmin":2620.0,"ymin":707.0,"xmax":2681.0,"ymax":1188.0},{"id":18,"contenttext":"從つて距厲風發の學說は信友に期すべからず。","xmin":2592.0,"ymin":1218.0,"xmax":2668.0,"ymax":2163.0},{"id":19,"contenttext":"彼れは實に正確なる考證の大家なりき。","xmin":2540.0,"ymin":707.0,"xmax":2607.0,"ymax":1509.0},{"id":20,"contenttext":"吾人茲にその神道哲學に關せる","xmin":2517.0,"ymin":1541.0,"xmax":2588.0,"ymax":2186.0},{"id":21,"contenttext":"事項に就いて、","xmin":2480.0,"ymin":703.0,"xmax":2538.0,"ymax":1000.0},{"id":22,"contenttext":"彼れの考證學の一斑を示さむ。","xmin":2461.0,"ymin":1026.0,"xmax":2530.0,"ymax":1646.0},{"id":23,"contenttext":"彼れは天神地祇に就いて曰はく、","xmin":2393.0,"ymin":750.0,"xmax":2465.0,"ymax":1415.0},{"id":24,"contenttext":"『神祇令』に、","xmin":2329.0,"ymin":791.0,"xmax":2387.0,"ymax":1041.0},{"id":25,"contenttext":"y","xmin":2344.0,"ymin":1800.0,"xmax":2376.0,"ymax":1849.0},{"id":26,"contenttext":"「凡天神地祇者、","xmin":2320.0,"ymin":1057.0,"xmax":2381.0,"ymax":1367.0},{"id":27,"contenttext":"神祇官皆依常典祭之」た「凡天皇即位總","xmin":2296.0,"ymin":1394.0,"xmax":2371.0,"ymax":2194.0},{"id":28,"contenttext":"祭天神地祇」とあり。","xmin":2253.0,"ymin":748.0,"xmax":2313.0,"ymax":1127.0},{"id":29,"contenttext":"天神とは天上にまします神、","xmin":2238.0,"ymin":1161.0,"xmax":2302.0,"ymax":1736.0},{"id":30,"contenttext":"また天よりこの國土","xmin":2227.0,"ymin":1770.0,"xmax":2286.0,"ymax":2186.0},{"id":31,"contenttext":"で","xmin":2228.0,"ymin":884.0,"xmax":2252.0,"ymax":926.0},{"id":32,"contenttext":";","xmin":2220.0,"ymin":1066.0,"xmax":2250.0,"ymax":1114.0},{"id":33,"contenttext":"に降り坐る神を稱すなり。","xmin":2181.0,"ymin":746.0,"xmax":2237.0,"ymax":1270.0},{"id":34,"contenttext":"その天地の神八百萬群神坐します中に、","xmin":2154.0,"ymin":1296.0,"xmax":2227.0,"ymax":2106.0},{"id":35,"contenttext":"ニ","xmin":2193.0,"ymin":2141.0,"xmax":2215.0,"ymax":2181.0},{"id":36,"contenttext":"別","xmin":2156.0,"ymin":2139.0,"xmax":2199.0,"ymax":2183.0},{"id":37,"contenttext":"述而不作","xmin":2796.0,"ymin":514.0,"xmax":2835.0,"ymax":636.0},{"id":38,"contenttext":"考證學","xmin":2502.0,"ymin":506.0,"xmax":2540.0,"ymax":599.0},{"id":39,"contenttext":"に由緣ある神たちを、","xmin":1819.0,"ymin":745.0,"xmax":1869.0,"ymax":1182.0},{"id":40,"contenttext":"國々に社定めて祭給へる事、","xmin":1816.0,"ymin":1209.0,"xmax":1868.0,"ymax":1784.0},{"id":41,"contenttext":"大御政の機原にし","xmin":1821.0,"ymin":1816.0,"xmax":1867.0,"ymax":2185.0},{"id":42,"contenttext":"て、","xmin":1753.0,"ymin":747.0,"xmax":1790.0,"ymax":805.0},{"id":43,"contenttext":"太古より皇朝の大道なり。","xmin":1739.0,"ymin":837.0,"xmax":1793.0,"ymax":1357.0},{"id":44,"contenttext":"(神社私考)","xmin":1741.0,"ymin":1385.0,"xmax":1792.0,"ymax":1594.0},{"id":45,"contenttext":"と。","xmin":1684.0,"ymin":698.0,"xmax":1715.0,"ymax":752.0},{"id":46,"contenttext":"かく彼れは諸國に神社を建てゝ、","xmin":1668.0,"ymin":790.0,"xmax":1722.0,"ymax":1455.0},{"id":47,"contenttext":"天神地祇を祭祀するは、","xmin":1672.0,"ymin":1491.0,"xmax":1721.0,"ymax":1970.0},{"id":48,"contenttext":"皇朝の大","xmin":1674.0,"ymin":2002.0,"xmax":1723.0,"ymax":2189.0},{"id":49,"contenttext":"道なりとし、","xmin":1604.0,"ymin":698.0,"xmax":1649.0,"ymax":946.0},{"id":50,"contenttext":"以つて此れ等の諸神に就いて種々の研究を行へり。","xmin":1595.0,"ymin":978.0,"xmax":1649.0,"ymax":2019.0},{"id":51,"contenttext":"茲に聊","xmin":1598.0,"ymin":2049.0,"xmax":1645.0,"ymax":2187.0},{"id":52,"contenttext":"か八幡大神に就いて彼れが述べし所のものを揭ぐべし。","xmin":1527.0,"ymin":696.0,"xmax":1576.0,"ymax":1831.0},{"id":53,"contenttext":"曰はく、","xmin":1529.0,"ymin":1869.0,"xmax":1572.0,"ymax":2017.0},{"id":54,"contenttext":"ハ","xmin":1496.0,"ymin":837.0,"xmax":1523.0,"ymax":883.0},{"id":55,"contenttext":"名神、","xmin":1474.0,"ymin":2106.0,"xmax":1508.0,"ymax":2199.0},{"id":56,"contenttext":"八幡の本宮は、","xmin":1453.0,"ymin":788.0,"xmax":1504.0,"ymax":1089.0},{"id":57,"contenttext":"一八七","xmin":1455.0,"ymin":1092.0,"xmax":1504.0,"ymax":1187.0},{"id":58,"contenttext":"に豐前國字佐郡三座メート、","xmin":1443.0,"ymin":1209.0,"xmax":1510.0,"ymax":1692.0},{"id":59,"contenttext":"八幡大菩薩宇佐宮","xmin":1451.0,"ymin":1722.0,"xmax":1504.0,"ymax":2103.0},{"id":60,"contenttext":"大","xmin":1447.0,"ymin":2102.0,"xmax":1482.0,"ymax":2140.0},{"id":61,"contenttext":"比賣神社","xmin":1382.0,"ymin":743.0,"xmax":1433.0,"ymax":936.0},{"id":62,"contenttext":"大名","xmin":1371.0,"ymin":931.0,"xmax":1439.0,"ymax":980.0},{"id":63,"contenttext":"神","xmin":1399.0,"ymin":979.0,"xmax":1439.0,"ymax":1040.0},{"id":64,"contenttext":"大帶姬神社大","xmin":1370.0,"ymin":1070.0,"xmax":1440.0,"ymax":1353.0},{"id":65,"contenttext":"名神と並べ載せられて、","xmin":1371.0,"ymin":1306.0,"xmax":1441.0,"ymax":1787.0},{"id":66,"contenttext":"此三所同地に坐す","xmin":1377.0,"ymin":1816.0,"xmax":1433.0,"ymax":2187.0},{"id":67,"contenttext":"を、","xmin":1316.0,"ymin":743.0,"xmax":1353.0,"ymax":805.0},{"id":68,"contenttext":"惣ても八幡神と申し、","xmin":1308.0,"ymin":833.0,"xmax":1357.0,"ymax":1270.0},{"id":69,"contenttext":"八幡宮とも、","xmin":1307.0,"ymin":1302.0,"xmax":1359.0,"ymax":1550.0},{"id":70,"contenttext":"又八幡三所ノ神とも申來れり。","xmin":1308.0,"ymin":1581.0,"xmax":1357.0,"ymax":2154.0},{"id":71,"contenttext":"此神の古く史に見え給へるは、","xmin":1234.0,"ymin":739.0,"xmax":1286.0,"ymax":1367.0},{"id":72,"contenttext":"『續日本紀』","xmin":1232.0,"ymin":1372.0,"xmax":1288.0,"ymax":1611.0},{"id":73,"contenttext":"、聖武天皇の御世に、","xmin":1234.0,"ymin":1630.0,"xmax":1288.0,"ymax":2019.0},{"id":74,"contenttext":"「天平九","xmin":1234.0,"ymin":2037.0,"xmax":1288.0,"ymax":2187.0},{"id":75,"contenttext":"い","xmin":1202.0,"ymin":1041.0,"xmax":1230.0,"ymax":1089.0},{"id":76,"contenttext":"シ","xmin":1204.0,"ymin":1352.0,"xmax":1226.0,"ymax":1398.0},{"id":77,"contenttext":"ニ","xmin":1202.0,"ymin":1538.0,"xmax":1226.0,"ymax":1584.0},{"id":78,"contenttext":"年四月乙巳、","xmin":1163.0,"ymin":741.0,"xmax":1212.0,"ymax":993.0},{"id":79,"contenttext":"遣使伊勢神宮·大神社筑紫住","xmin":1161.0,"ymin":1023.0,"xmax":1214.0,"ymax":1582.0},{"id":80,"contenttext":"吉·八幡二社及香椎宮、","xmin":1161.0,"ymin":1582.0,"xmax":1212.0,"ymax":2026.0},{"id":81,"contenttext":"奉弊以","xmin":1163.0,"ymin":2049.0,"xmax":1212.0,"ymax":2187.0},{"id":82,"contenttext":"告新羅無禮之狀」とあり。","xmin":1087.0,"ymin":741.0,"xmax":1138.0,"ymax":1224.0},{"id":83,"contenttext":"又菩薩號を唱られ給へる事の書に見えたるは、","xmin":1087.0,"ymin":1258.0,"xmax":1136.0,"ymax":2193.0},{"id":84,"contenttext":"大同三年七月丙申の太政官符に、","xmin":1014.0,"ymin":739.0,"xmax":1067.0,"ymax":1410.0},{"id":85,"contenttext":"應令國司出納八幡大菩薩宮雜物事右","xmin":1012.0,"ymin":1440.0,"xmax":1065.0,"ymax":2185.0},{"id":86,"contenttext":"得太宰府解〓。","xmin":944.0,"ymin":737.0,"xmax":995.0,"ymax":1036.0},{"id":87,"contenttext":"太政官去延曆十八年十一月五日符備、","xmin":939.0,"ymin":106