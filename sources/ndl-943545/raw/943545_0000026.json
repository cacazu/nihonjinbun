[{"id":0,"contenttext":"里","xmin":3156.0,"ymin":1965.0,"xmax":3186.0,"ymax":2005.0},{"id":1,"contenttext":"惣體の道理を、","xmin":3088.0,"ymin":759.0,"xmax":3139.0,"ymax":1055.0},{"id":2,"contenttext":"よく心得おくべし。","xmin":3086.0,"ymin":1086.0,"xmax":3131.0,"ymax":1472.0},{"id":3,"contenttext":"其道理とは、","xmin":3078.0,"ymin":1499.0,"xmax":3127.0,"ymax":1747.0},{"id":4,"contenttext":"此天地も諸神も萬物","xmin":3072.0,"ymin":1777.0,"xmax":3126.0,"ymax":2193.0},{"id":5,"contenttext":"も、","xmin":3027.0,"ymin":761.0,"xmax":3062.0,"ymax":820.0},{"id":6,"contenttext":"皆、","xmin":3019.0,"ymin":849.0,"xmax":3066.0,"ymax":914.0},{"id":7,"contenttext":"こと〓〓く其本は、","xmin":3012.0,"ymin":947.0,"xmax":3059.0,"ymax":1328.0},{"id":8,"contenttext":"高皇產靈神、","xmin":3005.0,"ymin":1360.0,"xmax":3061.0,"ymax":1609.0},{"id":9,"contenttext":"神皇產靈神と申す二神の、","xmin":2999.0,"ymin":1638.0,"xmax":3057.0,"ymax":2165.0},{"id":10,"contenttext":"產靈のみたまと申すものによりて、","xmin":2929.0,"ymin":755.0,"xmax":2991.0,"ymax":1468.0},{"id":11,"contenttext":"成出來たるものにして、","xmin":2927.0,"ymin":1499.0,"xmax":2980.0,"ymax":1977.0},{"id":12,"contenttext":"世々に人","xmin":2923.0,"ymin":2009.0,"xmax":2976.0,"ymax":2196.0},{"id":13,"contenttext":"類の生れ出で、","xmin":2860.0,"ymin":757.0,"xmax":2919.0,"ymax":1053.0},{"id":14,"contenttext":"萬物.萬事の成出るも、","xmin":2853.0,"ymin":1082.0,"xmax":2914.0,"ymax":1515.0},{"id":15,"contenttext":"皆此御靈にあらずと云ふことな","xmin":2842.0,"ymin":1543.0,"xmax":2906.0,"ymax":2192.0},{"id":16,"contenttext":"Lo","xmin":2798.0,"ymin":761.0,"xmax":2837.0,"ymax":818.0},{"id":17,"contenttext":"されば神代のはじめに、","xmin":2778.0,"ymin":852.0,"xmax":2838.0,"ymax":1327.0},{"id":18,"contenttext":"伊邪那岐·伊邪那美二柱の大御神の、","xmin":2773.0,"ymin":1358.0,"xmax":2832.0,"ymax":2073.0},{"id":19,"contenttext":"國土","xmin":2775.0,"ymin":2100.0,"xmax":2822.0,"ymax":2195.0},{"id":20,"contenttext":"萬物、","xmin":2718.0,"ymin":755.0,"xmax":2767.0,"ymax":867.0},{"id":21,"contenttext":"もろ〓〓の神だちを生成し給へるも、","xmin":2710.0,"ymin":898.0,"xmax":2761.0,"ymax":1650.0},{"id":22,"contenttext":"その本は皆かの二神の產","xmin":2704.0,"ymin":1683.0,"xmax":2753.0,"ymax":2189.0},{"id":23,"contenttext":"靈の御靈によれるものなり。","xmin":2638.0,"ymin":755.0,"xmax":2696.0,"ymax":1327.0},{"id":24,"contenttext":"(玉匣)","xmin":2638.0,"ymin":1348.0,"xmax":2688.0,"ymax":1459.0},{"id":25,"contenttext":"と。","xmin":2581.0,"ymin":712.0,"xmax":2616.0,"ymax":766.0},{"id":26,"contenttext":"以上述べ來れるが如くにして、","xmin":2563.0,"ymin":800.0,"xmax":2622.0,"ymax":1417.0},{"id":27,"contenttext":"宣長は、","xmin":2565.0,"ymin":1448.0,"xmax":2616.0,"ymax":1605.0},{"id":28,"contenttext":"道の起源は、","xmin":2563.0,"ymin":1636.0,"xmax":2614.0,"ymax":1884.0},{"id":29,"contenttext":"高皇產靈神·神","xmin":2556.0,"ymin":1913.0,"xmax":2610.0,"ymax":2192.0},{"id":30,"contenttext":"皇產靈神二神にありて、","xmin":2496.0,"ymin":705.0,"xmax":2554.0,"ymax":1188.0},{"id":31,"contenttext":"此の二神の御靈によりて、","xmin":2490.0,"ymin":1215.0,"xmax":2546.0,"ymax":1743.0},{"id":32,"contenttext":"伊弉諾·伊弉冉二神種","xmin":2486.0,"ymin":1773.0,"xmax":2539.0,"ymax":2187.0},{"id":33,"contenttext":"々に之れを發展せられ、","xmin":2425.0,"ymin":710.0,"xmax":2485.0,"ymax":1186.0},{"id":34,"contenttext":"天照大神その根元大本を示され、","xmin":2416.0,"ymin":1217.0,"xmax":2476.0,"ymax":1883.0},{"id":35,"contenttext":"その他の諸神","xmin":2414.0,"ymin":1912.0,"xmax":2465.0,"ymax":2189.0},{"id":36,"contenttext":"祇亦之れが種々の方面を示され、","xmin":2346.0,"ymin":705.0,"xmax":2412.0,"ymax":1372.0},{"id":37,"contenttext":"從つて道は神代の事跡に皆備はりて、","xmin":2337.0,"ymin":1400.0,"xmax":2398.0,"ymax":2159.0},{"id":38,"contenttext":"不足せる所なしとなせる也。","xmin":2276.0,"ymin":704.0,"xmax":2333.0,"ymax":1276.0},{"id":39,"contenttext":"以上宣長の神道說の〓要也。","xmin":2201.0,"ymin":705.0,"xmax":2262.0,"ymax":1280.0},{"id":40,"contenttext":"其の說は彼れの嫡子春庭、","xmin":2190.0,"ymin":1308.0,"xmax":2251.0,"ymax":1832.0},{"id":41,"contenttext":"養子大平、","xmin":2187.0,"ymin":1866.0,"xmax":2240.0,"ymax":2065.0},{"id":42,"contenttext":"門","xmin":2189.0,"ymin":2098.0,"xmax":2232.0,"ymax":2144.0},{"id":43,"contenttext":"足らざる","xmin":2376.0,"ymin":509.0,"xmax":2410.0,"ymax":624.0},{"id":44,"contenttext":"所なし","xmin":2346.0,"ymin":506.0,"xmax":2378.0,"ymax":597.0},{"id":45,"contenttext":"其の說は彼れの嫡子春庭、","xmin":2190.0,"ymin":1308.0,"xmax":2251.0,"ymax":1832.0},{"id":46,"contenttext":"養子大平、","xmin":2187.0,"ymin":1866.0,"xmax":2240.0,"ymax":2065.0},{"id":47,"contenttext":"門","xmin":2189.0,"ymin":2098.0,"xmax":2232.0,"ymax":2144.0},{"id":48,"contenttext":"人服部中庸、","xmin":1816.0,"ymin":696.0,"xmax":1868.0,"ymax":936.0},{"id":49,"contenttext":"齋藤彥麿、","xmin":1816.0,"ymin":972.0,"xmax":1868.0,"ymax":1167.0},{"id":50,"contenttext":"植松有信、","xmin":1816.0,"ymin":1203.0,"xmax":1868.0,"ymax":1400.0},{"id":51,"contenttext":"渡邊重名、","xmin":1813.0,"ymin":1434.0,"xmax":1868.0,"ymax":1632.0},{"id":52,"contenttext":"鈴木腺、","xmin":1815.0,"ymin":1669.0,"xmax":1868.0,"ymax":1819.0},{"id":53,"contenttext":"城戶千楯、","xmin":1815.0,"ymin":1859.0,"xmax":1866.0,"ymax":2052.0},{"id":54,"contenttext":"村田","xmin":1816.0,"ymin":2088.0,"xmax":1865.0,"ymax":2181.0},{"id":55,"contenttext":"春門、","xmin":1745.0,"ymin":696.0,"xmax":1794.0,"ymax":799.0},{"id":56,"contenttext":"藤井高尙等によりて盛に提唱せられたり。","xmin":1741.0,"ymin":835.0,"xmax":1793.0,"ymax":1686.0},{"id":57,"contenttext":"殊に本居大平の如きは、","xmin":1741.0,"ymin":1720.0,"xmax":1792.0,"ymax":2183.0},{"id":58,"contenttext":"養子內遠、","xmin":1670.0,"ymin":696.0,"xmax":1719.0,"ymax":893.0},{"id":59,"contenttext":"加納諸平、","xmin":1667.0,"ymin":928.0,"xmax":1721.0,"ymax":1125.0},{"id":60,"contenttext":"足代弘訓等一千餘人の門下を養成し、","xmin":1668.0,"ymin":1162.0,"xmax":1719.0,"ymax":1917.0},{"id":61,"contenttext":"陸離たる光","xmin":1668.0,"ymin":1949.0,"xmax":1715.0,"ymax":2179.0},{"id":62,"contenttext":"彩を發揮せり。","xmin":1598.0,"ymin":694.0,"xmax":1645.0,"ymax":985.0},{"id":63,"contenttext":"尙宣長の歿後に門人となりて、","xmin":1591.0,"ymin":1021.0,"xmax":1646.0,"ymax":1633.0},{"id":64,"contenttext":"國學界に傑出せしもの二","xmin":1594.0,"ymin":1669.0,"xmax":1643.0,"ymax":2175.0},{"id":65,"contenttext":"人あり。","xmin":1529.0,"ymin":702.0,"xmax":1572.0,"ymax":849.0},{"id":66,"contenttext":"之れを平田篤胤及び伴信友となす。","xmin":1523.0,"ymin":884.0,"xmax":1572.0,"ymax":1593.0},{"id":67,"contenttext":"吾人是れより進んで聊か此","xmin":1523.0,"ymin":1624.0,"xmax":1572.0,"ymax":2181.0},{"id":68,"contenttext":"の二人に就いて述ぶべし。","xmin":1453.0,"ymin":700.0,"xmax":1502.0,"ymax":1222.0},{"id":69,"contenttext":"篤胤は、","xmin":1367.0,"ymin":741.0,"xmax":1416.0,"ymax":893.0},{"id":70,"contenttext":"秋田の人。","xmin":1365.0,"ymin":925.0,"xmax":1415.0,"ymax":1130.0},{"id":71,"contenttext":"安永五年八月二十四日を以つて生る。","xmin":1363.0,"ymin":1158.0,"xmax":1416.0,"ymax":1916.0},{"id":72,"contenttext":"父は大和田","xmin":1365.0,"ymin":1945.0,"xmax":1415.0,"ymax":2177.0},{"id":73,"contenttext":"祚胤、","xmin":1290.0,"ymin":690.0,"xmax":1343.0,"ymax":802.0},{"id":74,"contenttext":"母は那珂氏。","xmin":1292.0,"ymin":835.0,"xmax":1339.0,"ymax":1081.0},{"id":75,"contenttext":"篤胤はその第四子たり。","xmin":1290.0,"ymin":1111.0,"xmax":1339.0,"ymax":1588.0},{"id":76,"contenttext":"幼名は正吉、","xmin":1290.0,"ymin":1620.0,"xmax":1340.0,"ymax":1872.0},{"id":77,"contenttext":"大壑と號し、","xmin":1290.0,"ymin":1900.0,"xmax":1339.0,"ymax":2146.0},{"id":78,"contenttext":"伊吹の屋と稱す。","xmin":1216.0,"ymin":694.0,"xmax":1265.0,"ymax":1032.0},{"id":79,"contenttext":"年甫めて八歲、","xmin":1216.0,"ymin":1064.0,"xmax":1266.0,"ymax":1359.0},{"id":80,"contenttext":"儒學を藩儒中山靑義に受く。","xmin":1216.0,"ymin":1389.0,"xmax":1265.0,"ymax":1962.0},{"id":81,"contenttext":"已にして","xmin":1216.0,"ymin":1992.0,"xmax":1263.0,"ymax":2173.0},{"id":82,"contenttext":"篤胤の生母那珂氏歿し、","xmin":1142.0,"ymin":694.0,"xmax":1194.0,"ymax":1175.0},{"id":83,"contenttext":"繼母小野氏入る。","xmin":1142.0,"ymin":1205.0,"xmax":1189.0,"ymax":1547.0},{"id":84,"contenttext":"篤胤年二十、","xmin":1140.0,"ymin":1575.0,"xmax":1192.0,"ymax":1825.0},{"id":85,"contenttext":"乃ち郷關を脫し、","xmin":1141.0,"ymin":1852.0,"xmax":1191.0,"ymax":2181.0},{"id":86,"contenttext":"絕大の志を抱いて江戶に來りぬ。","xmin":1069.0,"ymin":694.0,"xmax":1118.0,"ymax":1357.0},{"id":87,"contenttext":"苦學前後五年。","xmin":1069.0,"ymin":1389.0,"xmax":1120.0,"ymax":1684.0},{"id":88,"contenttext":"偶〓松山の板倉侯の臣平","xmin":1071.0,"ymin":1714.0,"xmax":1117.0,"ymax":2173.0},{"id":89,"contenttext":"田篤穩に知られ、","xmin":994.0,"ymin":696.0,"xmax":1049.0,"ymax":1034.0},{"id":90,"contenttext":"その養嗣子となり、","xmin":996.0,"ymin":1064.0,"xmax":1046.0,"ymax":1449.0},{"id":91,"contenttext":"爾後、","xmin":996.0,"ymin":1481.0,"xmax":1047.0,"ymax":1590.0},{"id":92,"contenttext":"學業に專心することを得た","xmin":996.0,"ymin":1622.0,"xmax":1046.0,"ymax":2175.0},{"id":93,"contenttext":"り0","xmin":930.0,"ymin":694.0,"xmax":964.0,"ymax":758.0},{"id":94,"contenttext":"享和元年篤胤年二十六、","xmin":921.0,"ymin":786.0,"xmax":974.0,"ymax":1266.0},{"id":95,"contenttext":"初めて宣長の著書に接す。","xmin":924.0,"ymin":1299.0,"xmax":973.0,"ymax":1823.0},{"id":96,"contenttext":"之れを見て深く","xmin":924.0,"ymin":1855.0,"xmax":973.0,"ymax":2173.0},{"id":97,"contenttext":"神道史綱要","xmin":856.0,"ymin":808.0,"xmax":891.0,"ymax":1012.0},{"id":98,"contenttext":"豐","xmin":852.0,"ymin":1941.0,"xmax":889.0,"ymax":1987.0},{"id":99,"contenttext":"秋田の人","xmin":1375.0,"ymin":496.0,"xmax":1414.0,"ymax":618.0},{"id":100,"contenttext":"宣長の著","xmin":934.0,"ymin":496.0,"xmax":971.0,"ymax":615.0},{"id":101,"contenttext":"書に接す","xmin":902.0,"ymin":497.0,"xmax":942.0,"ymax":616.0}]