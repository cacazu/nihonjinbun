[{"id":1,"contenttext":"もちにて、","xmin":3070.0,"ymin":802.0,"xmax":3112.0,"ymax":985.0},{"id":2,"contenttext":"荷田の翁に見えそめられしとぞ。","xmin":3056.0,"ymin":1035.0,"xmax":3112.0,"ymax":1685.0},{"id":3,"contenttext":"(玉襷)","xmin":3051.0,"ymin":1732.0,"xmax":3100.0,"ymax":1819.0},{"id":4,"contenttext":"と。","xmin":3008.0,"ymin":756.0,"xmax":3039.0,"ymax":800.0},{"id":5,"contenttext":"爾來、","xmin":2998.0,"ymin":847.0,"xmax":3047.0,"ymax":942.0},{"id":6,"contenttext":"荷田の學風を慕ひつゝありしが、","xmin":2981.0,"ymin":985.0,"xmax":3043.0,"ymax":1634.0},{"id":7,"contenttext":"遂に享保十八年京師に上り、","xmin":2964.0,"ymin":1690.0,"xmax":3032.0,"ymax":2229.0},{"id":8,"contenttext":"その門に入りぬ。","xmin":2918.0,"ymin":748.0,"xmax":2974.0,"ymax":1074.0},{"id":9,"contenttext":"時に年三十七。","xmin":2910.0,"ymin":1122.0,"xmax":2969.0,"ymax":1403.0},{"id":10,"contenttext":"荷田門に在學する四年、","xmin":2899.0,"ymin":1451.0,"xmax":2962.0,"ymax":1908.0},{"id":11,"contenttext":"その篤き〓授","xmin":2892.0,"ymin":1972.0,"xmax":2948.0,"ymax":2214.0},{"id":12,"contenttext":"を受けしが、","xmin":2851.0,"ymin":746.0,"xmax":2898.0,"ymax":977.0},{"id":13,"contenttext":"偶、春滿歿せしを以つて、","xmin":2836.0,"ymin":1027.0,"xmax":2894.0,"ymax":1495.0},{"id":14,"contenttext":"元文二年〓に歸り、","xmin":2825.0,"ymin":1550.0,"xmax":2884.0,"ymax":1910.0},{"id":15,"contenttext":"翌年江戶に出","xmin":2820.0,"ymin":1972.0,"xmax":2874.0,"ymax":2216.0},{"id":16,"contenttext":"で、","xmin":2784.0,"ymin":743.0,"xmax":2827.0,"ymax":791.0},{"id":17,"contenttext":"玆に初めて古道の學を唱道せり。","xmin":2765.0,"ymin":836.0,"xmax":2827.0,"ymax":1486.0},{"id":18,"contenttext":"篤胤曰はく、","xmin":2763.0,"ymin":1540.0,"xmax":2810.0,"ymax":1763.0},{"id":19,"contenttext":"是は、","xmin":2704.0,"ymin":835.0,"xmax":2755.0,"ymax":930.0},{"id":20,"contenttext":"荷田翁の上を一層高く見解を爲し、","xmin":2688.0,"ymin":975.0,"xmax":2754.0,"ymax":1673.0},{"id":21,"contenttext":"始めて古の道を明らかに","xmin":2674.0,"ymin":1727.0,"xmax":2736.0,"ymax":2206.0},{"id":22,"contenttext":"知らんとするには、","xmin":2625.0,"ymin":786.0,"xmax":2680.0,"ymax":1161.0},{"id":23,"contenttext":"코","xmin":2598.0,"ymin":835.0,"xmax":2622.0,"ymax":862.0},{"id":24,"contenttext":"漢意佛意を〓く捨果ざれば、","xmin":2610.0,"ymin":1212.0,"xmax":2672.0,"ymax":1765.0},{"id":25,"contenttext":"其眞を得がたく、","xmin":2601.0,"ymin":1825.0,"xmax":2657.0,"ymax":2132.0},{"id":26,"contenttext":"歌","xmin":2600.0,"ymin":2199.0,"xmax":2649.0,"ymax":2211.0},{"id":27,"contenttext":"を詠も、","xmin":2563.0,"ymin":787.0,"xmax":2604.0,"ymax":924.0},{"id":28,"contenttext":"古言を解釋するにも、","xmin":2549.0,"ymin":971.0,"xmax":2602.0,"ymax":1388.0},{"id":29,"contenttext":"凡て古道を明らむべき梯なる由を言ひ","xmin":2533.0,"ymin":1444.0,"xmax":2594.0,"ymax":2202.0},{"id":30,"contenttext":"ハシダテ","xmin":2567.0,"ymin":1916.0,"xmax":2603.0,"ymax":1971.0},{"id":31,"contenttext":"サ:","xmin":2530.0,"ymin":780.0,"xmax":2553.0,"ymax":810.0},{"id":32,"contenttext":"誨され候。","xmin":2484.0,"ymin":782.0,"xmax":2539.0,"ymax":972.0},{"id":33,"contenttext":"(入學問答)","xmin":2477.0,"ymin":1001.0,"xmax":2534.0,"ymax":1200.0},{"id":34,"contenttext":"60","xmin":2422.0,"ymin":739.0,"xmax":2463.0,"ymax":790.0},{"id":35,"contenttext":"徂徠已に死し、","xmin":2334.0,"ymin":782.0,"xmax":2393.0,"ymax":1065.0},{"id":36,"contenttext":"鳩巢亦逝き、","xmin":2331.0,"ymin":1109.0,"xmax":2384.0,"ymax":1339.0},{"id":37,"contenttext":"東涯新に物故し、","xmin":2322.0,"ymin":1393.0,"xmax":2378.0,"ymax":1711.0},{"id":38,"contenttext":"さしも旺盛を極めたり","xmin":2311.0,"ymin":1770.0,"xmax":2369.0,"ymax":2198.0},{"id":39,"contenttext":"し儒林、","xmin":2265.0,"ymin":731.0,"xmax":2323.0,"ymax":878.0},{"id":40,"contenttext":"巨星の連沒に遇ひ、","xmin":2257.0,"ymin":921.0,"xmax":2316.0,"ymax":1296.0},{"id":41,"contenttext":"轉た寂寥の觀なき能はず。","xmin":2240.0,"ymin":1342.0,"xmax":2311.0,"ymax":1851.0},{"id":42,"contenttext":"此の時に膺り、","xmin":2234.0,"ymin":1908.0,"xmax":2291.0,"ymax":2171.0},{"id":43,"contenttext":"眞淵、","xmin":2195.0,"ymin":730.0,"xmax":2244.0,"ymax":830.0},{"id":44,"contenttext":"千代田城下に高く標榜して古道の學を唱ふ。","xmin":2172.0,"ymin":872.0,"xmax":2242.0,"ymax":1754.0},{"id":45,"contenttext":"名聲忽ち遠近を風靡","xmin":2161.0,"ymin":1814.0,"xmax":2221.0,"ymax":2200.0},{"id":46,"contenttext":"し、","xmin":1811.0,"ymin":703.0,"xmax":1854.0,"ymax":752.0},{"id":47,"contenttext":"俊才爭ふてその門に輻輳す。","xmin":1807.0,"ymin":794.0,"xmax":1862.0,"ymax":1355.0},{"id":48,"contenttext":"延享の三年、","xmin":1816.0,"ymin":1409.0,"xmax":1869.0,"ymax":1634.0},{"id":49,"contenttext":"田安侯召して古學の博士","xmin":1819.0,"ymin":1692.0,"xmax":1881.0,"ymax":2175.0},{"id":50,"contenttext":"となしぬ。","xmin":1735.0,"ymin":707.0,"xmax":1783.0,"ymax":894.0},{"id":51,"contenttext":"德川伯爵家の「悠然公略傳」に曰はく、","xmin":1736.0,"ymin":942.0,"xmax":1793.0,"ymax":1634.0},{"id":52,"contenttext":"賀茂眞淵を徵し侍臣となす。","xmin":1662.0,"ymin":798.0,"xmax":1721.0,"ymax":1360.0},{"id":53,"contenttext":"給するに禀米を以つてす。","xmin":1671.0,"ymin":1407.0,"xmax":1729.0,"ymax":1916.0},{"id":54,"contenttext":"歌書を捜索","xmin":1682.0,"ymin":1977.0,"xmax":1729.0,"ymax":2175.0},{"id":55,"contenttext":"し日々講論す。","xmin":1594.0,"ymin":754.0,"xmax":1649.0,"ymax":1031.0},{"id":56,"contenttext":"啓發する所あり。","xmin":1602.0,"ymin":1085.0,"xmax":1657.0,"ymax":1407.0},{"id":57,"contenttext":"眞淵國學に長じ、","xmin":1608.0,"ymin":1460.0,"xmax":1657.0,"ymax":1776.0},{"id":58,"contenttext":"最も萬葉に善し、","xmin":1616.0,"ymin":1838.0,"xmax":1664.0,"ymax":2144.0},{"id":59,"contenttext":"古風の學者今に至り仰いで泰斗と爲す。","xmin":1520.0,"ymin":753.0,"xmax":1585.0,"ymax":1548.0},{"id":60,"contenttext":"(賀茂眞淵翁全集)","xmin":1533.0,"ymin":1591.0,"xmax":1592.0,"ymax":1916.0},{"id":61,"contenttext":"と0","xmin":1455.0,"ymin":712.0,"xmax":1489.0,"ymax":757.0},{"id":62,"contenttext":"眞淵、","xmin":1449.0,"ymin":801.0,"xmax":1498.0,"ymax":897.0},{"id":63,"contenttext":"田安侯に仕ふること前後十四年、","xmin":1450.0,"ymin":942.0,"xmax":1512.0,"ymax":1593.0},{"id":64,"contenttext":"入つては侯に侍し、","xmin":1463.0,"ymin":1650.0,"xmax":1520.0,"ymax":2011.0},{"id":65,"contenttext":"出でゝ","xmin":1472.0,"ymin":2075.0,"xmax":1519.0,"ymax":2173.0},{"id":66,"contenttext":"は著書に從事し、","xmin":1371.0,"ymin":711.0,"xmax":1433.0,"ymax":1041.0},{"id":67,"contenttext":"門人を〓化せしかば、","xmin":1378.0,"ymin":1085.0,"xmax":1440.0,"ymax":1505.0},{"id":68,"contenttext":"古道大いに起り、","xmin":1390.0,"ymin":1560.0,"xmax":1439.0,"ymax":1873.0},{"id":69,"contenttext":"藤原宇萬伎、","xmin":1396.0,"ymin":1934.0,"xmax":1447.0,"ymax":2152.0},{"id":70,"contenttext":"楫取魚、彥、","xmin":1300.0,"ymin":712.0,"xmax":1353.0,"ymax":900.0},{"id":71,"contenttext":"本居宣長、","xmin":1306.0,"ymin":949.0,"xmax":1359.0,"ymax":1134.0},{"id":72,"contenttext":"荒木田久老、","xmin":1309.0,"ymin":1182.0,"xmax":1365.0,"ymax":1415.0},{"id":73,"contenttext":"加藤千蔭等の人才を出しぬ。","xmin":1313.0,"ymin":1465.0,"xmax":1372.0,"ymax":2011.0},{"id":74,"contenttext":"中に就","xmin":1326.0,"ymin":2079.0,"xmax":1372.0,"ymax":2181.0},{"id":75,"contenttext":"いて本居宣長を出藍の器となす。","xmin":1227.0,"ymin":717.0,"xmax":1290.0,"ymax":1363.0},{"id":76,"contenttext":"宣長は、","xmin":1163.0,"ymin":760.0,"xmax":1212.0,"ymax":900.0},{"id":77,"contenttext":"伊勢松坂の人。","xmin":1163.0,"ymin":948.0,"xmax":1219.0,"ymax":1224.0},{"id":78,"contenttext":"享保十五年を以つて生る。","xmin":1171.0,"ymin":1276.0,"xmax":1226.0,"ymax":1783.0},{"id":79,"contenttext":"父は三四右衞門定","xmin":1179.0,"ymin":1841.0,"xmax":1232.0,"ymax":2181.0},{"id":80,"contenttext":"利","xmin":1085.0,"ymin":712.0,"xmax":1142.0,"ymax":770.0},{"id":81,"contenttext":"母は村田氏。","xmin":1089.0,"ymin":809.0,"xmax":1146.0,"ymax":1045.0},{"id":82,"contenttext":"家初め北畠氏に仕へしが、","xmin":1093.0,"ymin":1091.0,"xmax":1158.0,"ymax":1601.0},{"id":83,"contenttext":"後下りて商賈となり、","xmin":1105.0,"ymin":1654.0,"xmax":1161.0,"ymax":2060.0},{"id":84,"contenttext":"定利","xmin":1110.0,"ymin":2125.0,"xmax":1165.0,"ymax":2183.0},{"id":85,"contenttext":"の當時二個の支店を江戶に置き、","xmin":1012.0,"ymin":718.0,"xmax":1076.0,"ymax":1370.0},{"id":86,"contenttext":"巨萬の富を致したりき。","xmin":1026.0,"ymin":1422.0,"xmax":1083.0,"ymax":1875.0},{"id":87,"contenttext":"然るに幾ばく","xmin":1038.0,"ymin":1941.0,"xmax":1087.0,"ymax":2183.0},{"id":88,"contenttext":"ならずして家道衰へぬ。","xmin":941.0,"ymin":718.0,"xmax":994.0,"ymax":1184.0},{"id":89,"contenttext":"元文五年定利歿す。","xmin":945.0,"ymin":1235.0,"xmax":1008.0,"ymax":1603.0},{"id":90,"contenttext":"時に宣長年僅に十一。","xmin":955.0,"ymin":1659.0,"xmax":1011.0,"ymax":2065.0},{"id":91,"contenttext":"義兄","xmin":965.0,"ymin":2127.0,"xmax":1014.0,"ymax":2187.0},{"id":92,"contenttext":"三","xmin":895.0,"ymin":1994.0,"xmax":924.0,"ymax":1999.0},{"id":93,"contenttext":"神道史綱要","xmin":877.0,"ymin":835.0,"xmax":916.0,"ymax":1028.0},{"id":94,"contenttext":"田安侯召して古學の博士","xmin":1819.0,"ymin":1692.0,"xmax":1881.0,"ymax":2175.0},{"id":95,"contenttext":"本居宣長","xmin":1166.0,"ymin":516.0,"xmax":1210.0,"ymax":632.0}]