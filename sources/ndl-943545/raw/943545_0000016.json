[{"id":0,"contenttext":"三","xmin":3151.0,"ymin":1961.0,"xmax":3182.0,"ymax":1997.0},{"id":1,"contenttext":"陰陽五行及び宋儒の說を取捨してその學說を構成せり。","xmin":3078.0,"ymin":699.0,"xmax":3141.0,"ymax":1826.0},{"id":2,"contenttext":"殊に注目すべき","xmin":3075.0,"ymin":1856.0,"xmax":3122.0,"ymax":2177.0},{"id":3,"contenttext":"は、","xmin":3025.0,"ymin":698.0,"xmax":3066.0,"ymax":758.0},{"id":4,"contenttext":"彼れが親房·兼良二卿と同じく三種の神器を尊重せることなり。","xmin":2997.0,"ymin":789.0,"xmax":3068.0,"ymax":2054.0},{"id":5,"contenttext":"曰は","xmin":2998.0,"ymin":2090.0,"xmax":3040.0,"ymax":2173.0},{"id":6,"contenttext":"く、","xmin":2957.0,"ymin":700.0,"xmax":2990.0,"ymax":757.0},{"id":7,"contenttext":"「事を云へば三種の靈賓","xmin":2933.0,"ymin":775.0,"xmax":2996.0,"ymax":1260.0},{"id":8,"contenttext":"理を云へば天子の御心也。","xmin":2925.0,"ymin":1302.0,"xmax":2988.0,"ymax":1828.0},{"id":9,"contenttext":"三種の靈寶は收","xmin":2919.0,"ymin":1854.0,"xmax":2977.0,"ymax":2179.0},{"id":10,"contenttext":"まりて胸中にあり。","xmin":2871.0,"ymin":698.0,"xmax":2916.0,"ymax":1079.0},{"id":11,"contenttext":"胸中は三種の靈寶に現はる」(神代卷家傳聞書)と云ひ、","xmin":2847.0,"ymin":1112.0,"xmax":2914.0,"ymax":2147.0},{"id":12,"contenttext":"事相より云へば、","xmin":2797.0,"ymin":693.0,"xmax":2850.0,"ymax":1037.0},{"id":13,"contenttext":"天照大神の授與せられし以前にはなきも、","xmin":2788.0,"ymin":1067.0,"xmax":2844.0,"ymax":1911.0},{"id":14,"contenttext":"理より云へ","xmin":2781.0,"ymin":1946.0,"xmax":2829.0,"ymax":2167.0},{"id":15,"contenttext":"ば","xmin":2739.0,"ymin":694.0,"xmax":2782.0,"ymax":736.0},{"id":16,"contenttext":"己に存せしとし、","xmin":2732.0,"ymin":788.0,"xmax":2780.0,"ymax":1126.0},{"id":17,"contenttext":"曰はく、","xmin":2728.0,"ymin":1160.0,"xmax":2771.0,"ymax":1310.0},{"id":18,"contenttext":"「其理は、","xmin":2718.0,"ymin":1324.0,"xmax":2774.0,"ymax":1497.0},{"id":19,"contenttext":"伊弉諾·伊弉冉尊、","xmin":2718.0,"ymin":1528.0,"xmax":2769.0,"ymax":1866.0},{"id":20,"contenttext":"天瓊戈を得玉","xmin":2714.0,"ymin":1900.0,"xmax":2761.0,"ymax":2173.0},{"id":21,"contenttext":"ひし所より備はりて、","xmin":2654.0,"ymin":695.0,"xmax":2712.0,"ymax":1127.0},{"id":22,"contenttext":"天地自然の靈寶也。","xmin":2645.0,"ymin":1157.0,"xmax":2705.0,"ymax":1543.0},{"id":23,"contenttext":"それを天照大神の受續給ひて、","xmin":2632.0,"ymin":1574.0,"xmax":2701.0,"ymax":2181.0},{"id":24,"contenttext":"今三種の神器として御附屬あるぞ。","xmin":2571.0,"ymin":689.0,"xmax":2634.0,"ymax":1403.0},{"id":25,"contenttext":"事相を以て御附屬ある事、","xmin":2564.0,"ymin":1429.0,"xmax":2623.0,"ymax":1958.0},{"id":26,"contenttext":"甚深微妙","xmin":2563.0,"ymin":1988.0,"xmax":2614.0,"ymax":2173.0},{"id":27,"contenttext":"の義、","xmin":2512.0,"ymin":694.0,"xmax":2559.0,"ymax":799.0},{"id":28,"contenttext":"吾國萬國の最上たる事、","xmin":2503.0,"ymin":828.0,"xmax":2555.0,"ymax":1305.0},{"id":29,"contenttext":"此一事に明白也」(同上)と云ひ、","xmin":2493.0,"ymin":1337.0,"xmax":2551.0,"ymax":1909.0},{"id":30,"contenttext":"進んで「三種","xmin":2489.0,"ymin":1941.0,"xmax":2538.0,"ymax":2168.0},{"id":31,"contenttext":"は鼎の三足の如し、","xmin":2433.0,"ymin":689.0,"xmax":2486.0,"ymax":1078.0},{"id":32,"contenttext":"寔に神道の肝心、","xmin":2426.0,"ymin":1106.0,"xmax":2484.0,"ymax":1449.0},{"id":33,"contenttext":"王法の樞機、","xmin":2426.0,"ymin":1477.0,"xmax":2473.0,"ymax":1724.0},{"id":34,"contenttext":"代々の御守りとして","xmin":2420.0,"ymin":1758.0,"xmax":2471.0,"ymax":2169.0},{"id":35,"contenttext":"國土普き光也」(同上)と說きぬ。","xmin":2359.0,"ymin":687.0,"xmax":2415.0,"ymax":1261.0},{"id":36,"contenttext":"惟足と同時に度會延佳あり。","xmin":2285.0,"ymin":732.0,"xmax":2341.0,"ymax":1310.0},{"id":37,"contenttext":"「神道と云は、","xmin":2289.0,"ymin":1323.0,"xmax":2332.0,"ymax":1578.0},{"id":38,"contenttext":"上","xmin":2291.0,"ymin":1618.0,"xmax":2326.0,"ymax":1687.0},{"id":39,"contenttext":"人より下萬民まで行ふ","xmin":2280.0,"ymin":1707.0,"xmax":2324.0,"ymax":2163.0},{"id":40,"contenttext":"且暮の道なり。","xmin":2222.0,"ymin":686.0,"xmax":2269.0,"ymax":971.0},{"id":41,"contenttext":"天神地神より相傳の中極の道を根として行ふ時は、","xmin":2206.0,"ymin":1014.0,"xmax":2265.0,"ymax":2042.0},{"id":42,"contenttext":"日用","xmin":2203.0,"ymin":2080.0,"xmax":2246.0,"ymax":2168.0},{"id":43,"contenttext":"農會延佳","xmin":2305.0,"ymin":489.0,"xmax":2344.0,"ymax":613.0},{"id":44,"contenttext":"の間、","xmin":1796.0,"ymin":729.0,"xmax":1834.0,"ymax":828.0},{"id":45,"contenttext":"神道ならずと云事なし","xmin":1792.0,"ymin":866.0,"xmax":1839.0,"ymax":1326.0},{"id":46,"contenttext":"さして是は神道なりと","xmin":1792.0,"ymin":1379.0,"xmax":1837.0,"ymax":1837.0},{"id":47,"contenttext":"々指南に及べ","xmin":1794.0,"ymin":1887.0,"xmax":1836.0,"ymax":2156.0},{"id":48,"contenttext":"き","xmin":1797.0,"ymin":2163.0,"xmax":1833.0,"ymax":2209.0},{"id":49,"contenttext":"道にはあらず」(大神宮神道或問)と云ひ、","xmin":1723.0,"ymin":727.0,"xmax":1768.0,"ymax":1482.0},{"id":50,"contenttext":"又、","xmin":1723.0,"ymin":1511.0,"xmax":1769.0,"ymax":1577.0},{"id":51,"contenttext":"「中極の道を神道と云事なれば、","xmin":1721.0,"ymin":1593.0,"xmax":1768.0,"ymax":2213.0},{"id":52,"contenttext":"三","xmin":1690.0,"ymin":1656.0,"xmax":1715.0,"ymax":1698.0},{"id":53,"contenttext":"中道を修行し、","xmin":1647.0,"ymin":724.0,"xmax":1703.0,"ymax":1018.0},{"id":54,"contenttext":"正直の御〓を信じて、","xmin":1647.0,"ymin":1049.0,"xmax":1700.0,"ymax":1484.0},{"id":55,"contenttext":"本心に任し、","xmin":1647.0,"ymin":1511.0,"xmax":1698.0,"ymax":1762.0},{"id":56,"contenttext":"又正しきに從ふて以","xmin":1647.0,"ymin":1789.0,"xmax":1698.0,"ymax":2205.0},{"id":57,"contenttext":"つて〓淨と爲、","xmin":1576.0,"ymin":727.0,"xmax":1625.0,"ymax":1018.0},{"id":58,"contenttext":"惡に隨ふて以つて不淨とすとの神記を恐れて、","xmin":1576.0,"ymin":1047.0,"xmax":1625.0,"ymax":1991.0},{"id":59,"contenttext":"起居動靜","xmin":1572.0,"ymin":2022.0,"xmax":1624.0,"ymax":2210.0},{"id":60,"contenttext":"キヨクイサギヨクイモホリツェシミ","xmin":1527.0,"ymin":1648.0,"xmax":1569.0,"ymax":1956.0},{"id":61,"contenttext":"に、","xmin":1502.0,"ymin":727.0,"xmax":1545.0,"ymax":785.0},{"id":62,"contenttext":"心の塵を去り、","xmin":1502.0,"ymin":819.0,"xmax":1551.0,"ymax":1110.0},{"id":63,"contenttext":"黑心なく、","xmin":1502.0,"ymin":1141.0,"xmax":1549.0,"ymax":1341.0},{"id":64,"contenttext":"丹心を以つて、","xmin":1502.0,"ymin":1374.0,"xmax":1551.0,"ymax":1660.0},{"id":65,"contenttext":"〓淨齋愼、","xmin":1502.0,"ymin":1697.0,"xmax":1553.0,"ymax":1897.0},{"id":66,"contenttext":"左物を右に移","xmin":1500.0,"ymin":1930.0,"xmax":1552.0,"ymax":2207.0},{"id":67,"contenttext":"さず、","xmin":1429.0,"ymin":727.0,"xmax":1474.0,"ymax":834.0},{"id":68,"contenttext":"右物を左に移さず、","xmin":1424.0,"ymin":864.0,"xmax":1478.0,"ymax":1251.0},{"id":69,"contenttext":"左を左とし、","xmin":1424.0,"ymin":1280.0,"xmax":1478.0,"ymax":1531.0},{"id":70,"contenttext":"右を右とせよとの御〓を守りて、","xmin":1427.0,"ymin":1558.0,"xmax":1476.0,"ymax":2211.0},{"id":71,"contenttext":"天下の主にてましまさば、","xmin":1353.0,"ymin":724.0,"xmax":1404.0,"ymax":1246.0},{"id":72,"contenttext":"天下萬民をあはれみ給ひて、","xmin":1355.0,"ymin":1280.0,"xmax":1404.0,"ymax":1852.0},{"id":73,"contenttext":"君上の御職分を","xmin":1353.0,"ymin":1883.0,"xmax":1406.0,"ymax":2207.0},{"id":74,"contenttext":"つくし給ひ、","xmin":1283.0,"ymin":729.0,"xmax":1330.0,"ymax":971.0},{"id":75,"contenttext":"諸臣下は右の御〓を守りて忠をつくし、","xmin":1283.0,"ymin":1000.0,"xmax":1330.0,"ymax":1804.0},{"id":76,"contenttext":"君につかへたてま","xmin":1283.0,"ymin":1838.0,"xmax":1330.0,"ymax":2205.0},{"id":77,"contenttext":"つり、","xmin":1216.0,"ymin":731.0,"xmax":1257.0,"ymax":831.0},{"id":78,"contenttext":"一國一家上下も、","xmin":1212.0,"ymin":872.0,"xmax":1259.0,"ymax":1202.0},{"id":79,"contenttext":"亦かくの如く、","xmin":1212.0,"ymin":1237.0,"xmax":1260.0,"ymax":1525.0},{"id":80,"contenttext":"父子、","xmin":1212.0,"ymin":1558.0,"xmax":1261.0,"ymax":1668.0},{"id":81,"contenttext":"夫婦、","xmin":1212.0,"ymin":1699.0,"xmax":1261.0,"ymax":1809.0},{"id":82,"contenttext":"兄弟、","xmin":1212.0,"ymin":1836.0,"xmax":1259.0,"ymax":1948.0},{"id":83,"contenttext":"朋友も、","xmin":1212.0,"ymin":1975.0,"xmax":1259.0,"ymax":2132.0},{"id":84,"contenttext":"彼","xmin":1216.0,"ymin":2161.0,"xmax":1261.0,"ymax":2207.0},{"id":85,"contenttext":"の御〓を守りて、","xmin":1138.0,"ymin":727.0,"xmax":1187.0,"ymax":1063.0},{"id":86,"contenttext":"父子、","xmin":1134.0,"ymin":1092.0,"xmax":1189.0,"ymax":1204.0},{"id":87,"contenttext":"夫婦、","xmin":1138.0,"ymin":1233.0,"xmax":1189.0,"ymax":1343.0},{"id":88,"contenttext":"兄弟、","xmin":1137.0,"ymin":1371.0,"xmax":1192.0,"ymax":1485.0},{"id":89,"contenttext":"朋友のすべき道をつくし、","xmin":1136.0,"ymin":1509.0,"xmax":1187.0,"ymax":2038.0},{"id":90,"contenttext":"士農工","xmin":1138.0,"ymin":2067.0,"xmax":1189.0,"ymax":2207.0},{"id":91,"contenttext":"商までも、","xmin":1063.0,"ymin":725.0,"xmax":1112.0,"ymax":924.0},{"id":92,"contenttext":"かの御〓に順ひて、","xmin":1063.0,"ymin":958.0,"xmax":1114.0,"ymax":1347.0},{"id":93,"contenttext":"其の職をつとむるを、","xmin":1063.0,"ymin":1372.0,"xmax":1112.0,"ymax":1805.0},{"id":94,"contenttext":"左を左とし、","xmin":1061.0,"ymin":1834.0,"xmax":1114.0,"ymax":2085.0},{"id":95,"contenttext":"右を","xmin":1063.0,"ymin":2114.0,"xmax":1112.0,"ymax":2205.0},{"id":96,"contenttext":"右とすと申すなり」(同上)と說き、","xmin":985.0,"ymin":726.0,"xmax":1037.0,"ymax":1345.0},{"id":97,"contenttext":"盛に一家の神道を講ぜり。","xmin":985.0,"ymin":1372.0,"xmax":1036.0,"ymax":1902.0},{"id":98,"contenttext":"延佳の神道を聞き、","xmin":910.0,"ymin":771.0,"xmax":967.0,"ymax":1159.0},{"id":99,"contenttext":"更に惟足の說を承け、","xmin":910.0,"ymin":1188.0,"xmax":965.0,"ymax":1621.0},{"id":100,"contenttext":"惟足より埀加靈社の號を授","xmin":910.0,"ymin":1650.0,"xmax":963.0,"ymax":2207.0},{"id":101,"contenttext":"神道史綱要","xmin":842.0,"ymin":839.0,"xmax":879.0,"ymax":1044.0},{"id":102,"contenttext":"三","xmin":846.0,"ymin":1981.0,"xmax":877.0,"ymax":2017.0},{"id":103,"contenttext":"山崎闇齋","xmin":924.0,"ymin":530.0,"xmax":963.0,"ymax":648.0}]