[{"id":0,"contenttext":"吾","xmin":3125.0,"ymin":1983.0,"xmax":3156.0,"ymax":2019.0},{"id":1,"contenttext":"去年十二月二十一日符倆、","xmin":3063.0,"ymin":754.0,"xmax":3130.0,"ymax":1289.0},{"id":2,"contenttext":"大菩薩並比咩神封云云。","xmin":3053.0,"ymin":1314.0,"xmax":3116.0,"ymax":1801.0},{"id":3,"contenttext":"『類聚國史』","xmin":3042.0,"ymin":1802.0,"xmax":3106.0,"ymax":2041.0},{"id":4,"contenttext":"に、","xmin":3047.0,"ymin":2063.0,"xmax":3088.0,"ymax":2130.0},{"id":5,"contenttext":"天","xmin":3041.0,"ymin":2157.0,"xmax":3090.0,"ymax":2201.0},{"id":6,"contenttext":"長六年五月丁酉、","xmin":2998.0,"ymin":750.0,"xmax":3057.0,"ymax":1096.0},{"id":7,"contenttext":"令僧十口轉續一切經八幡大菩薩宮寺とあるなどを始","xmin":2970.0,"ymin":1126.0,"xmax":3047.0,"ymax":2202.0},{"id":8,"contenttext":"て、","xmin":2939.0,"ymin":755.0,"xmax":2980.0,"ymax":815.0},{"id":9,"contenttext":"此後もはら菩薩號を唱られたり。","xmin":2917.0,"ymin":844.0,"xmax":2983.0,"ymax":1516.0},{"id":10,"contenttext":"(八幡考)","xmin":2910.0,"ymin":1534.0,"xmax":2967.0,"ymax":1702.0},{"id":11,"contenttext":"と。","xmin":2874.0,"ymin":708.0,"xmax":2908.0,"ymax":768.0},{"id":12,"contenttext":"而して曰はく、","xmin":2857.0,"ymin":798.0,"xmax":2911.0,"ymax":1094.0},{"id":13,"contenttext":"いかに佛道を好み給へばとて、","xmin":2769.0,"ymin":799.0,"xmax":2841.0,"ymax":1424.0},{"id":14,"contenttext":"やごとなき大神を、","xmin":2758.0,"ymin":1449.0,"xmax":2818.0,"ymax":1840.0},{"id":15,"contenttext":"菩薩としも唱し","xmin":2751.0,"ymin":1868.0,"xmax":2807.0,"ymax":2196.0},{"id":16,"contenttext":"給へるは如何にぞや。","xmin":2705.0,"ymin":746.0,"xmax":2764.0,"ymax":1184.0},{"id":17,"contenttext":"そも〓〓此大神は、","xmin":2690.0,"ymin":1214.0,"xmax":2756.0,"ymax":1608.0},{"id":18,"contenttext":"ことに既くよりかにかく佛","xmin":2678.0,"ymin":1639.0,"xmax":2742.0,"ymax":2196.0},{"id":19,"contenttext":"ざまにあへしらへ給へるまゝにて鎭りまし、","xmin":2621.0,"ymin":748.0,"xmax":2690.0,"ymax":1652.0},{"id":20,"contenttext":"又各國におつる事なく、","xmin":2607.0,"ymin":1680.0,"xmax":2666.0,"ymax":2161.0},{"id":21,"contenttext":"いと數箇所同じさまに祭られ給ひ、","xmin":2552.0,"ymin":750.0,"xmax":2621.0,"ymax":1462.0},{"id":22,"contenttext":"はた亂世の武夫等に、","xmin":2540.0,"ymin":1492.0,"xmax":2603.0,"ymax":1926.0},{"id":23,"contenttext":"軍神と崇ま","xmin":2538.0,"ymin":1957.0,"xmax":2587.0,"ymax":2187.0},{"id":24,"contenttext":"れ給へるも、","xmin":2495.0,"ymin":745.0,"xmax":2544.0,"ymax":991.0},{"id":25,"contenttext":"いとあやしきことになむありける。","xmin":2476.0,"ymin":1030.0,"xmax":2539.0,"ymax":1742.0},{"id":26,"contenttext":"(同上)","xmin":2473.0,"ymin":1761.0,"xmax":2518.0,"ymax":1873.0},{"id":27,"contenttext":"と。","xmin":2438.0,"ymin":702.0,"xmax":2471.0,"ymax":752.0},{"id":28,"contenttext":"かくて彼れは『神名帳』頭注に、","xmin":2413.0,"ymin":789.0,"xmax":2479.0,"ymax":1409.0},{"id":29,"contenttext":"「八幡三所者、","xmin":2401.0,"ymin":1426.0,"xmax":2468.0,"ymax":1693.0},{"id":30,"contenttext":"一〓八幡、","xmin":2399.0,"ymin":1730.0,"xmax":2457.0,"ymax":1875.0},{"id":31,"contenttext":"二ム比女神、","xmin":2393.0,"ymin":1908.0,"xmax":2454.0,"ymax":2113.0},{"id":32,"contenttext":"三","xmin":2399.0,"ymin":2131.0,"xmax":2442.0,"ymax":2193.0},{"id":33,"contenttext":"大帶姫命也」とあるにより、","xmin":2341.0,"ymin":699.0,"xmax":2404.0,"ymax":1225.0},{"id":34,"contenttext":"八幡大神の祭神は、","xmin":2327.0,"ymin":1259.0,"xmax":2391.0,"ymax":1645.0},{"id":35,"contenttext":"應神天皇·田心姫命·端津姬","xmin":2317.0,"ymin":1678.0,"xmax":2379.0,"ymax":2194.0},{"id":36,"contenttext":"命·市杵島姫命·神功皇后となしぬ。","xmin":2264.0,"ymin":697.0,"xmax":2333.0,"ymax":1369.0},{"id":37,"contenttext":"信友の學說は要するに考證的にして神","xmin":2245.0,"ymin":1400.0,"xmax":2312.0,"ymax":2190.0},{"id":38,"contenttext":"道研究の材料を供するに過ぎざりき、","xmin":2190.0,"ymin":697.0,"xmax":2262.0,"ymax":1455.0},{"id":39,"contenttext":"大國隆正の如きは則ち然らざる也。","xmin":2173.0,"ymin":1490.0,"xmax":2239.0,"ymax":2194.0},{"id":40,"contenttext":"八幡の祭","xmin":2442.0,"ymin":494.0,"xmax":2477.0,"ymax":617.0},{"id":41,"contenttext":"神","xmin":2416.0,"ymin":494.0,"xmax":2452.0,"ymax":531.0},{"id":42,"contenttext":"大國隆正","xmin":2222.0,"ymin":518.0,"xmax":2256.0,"ymax":638.0},{"id":43,"contenttext":"隆正、","xmin":1815.0,"ymin":749.0,"xmax":1865.0,"ymax":858.0},{"id":44,"contenttext":"通稱仲衞、","xmin":1812.0,"ymin":887.0,"xmax":1865.0,"ymax":1094.0},{"id":45,"contenttext":"葵園·如意園·佐紀の屋などの號を有せり。","xmin":1798.0,"ymin":1125.0,"xmax":1860.0,"ymax":1928.0},{"id":46,"contenttext":"姓は藤原、","xmin":1799.0,"ymin":1958.0,"xmax":1852.0,"ymax":2161.0},{"id":47,"contenttext":"初め野々口と稱し、","xmin":1736.0,"ymin":700.0,"xmax":1793.0,"ymax":1096.0},{"id":48,"contenttext":"後、","xmin":1733.0,"ymin":1119.0,"xmax":1786.0,"ymax":1187.0},{"id":49,"contenttext":"大國と改む。","xmin":1727.0,"ymin":1214.0,"xmax":1785.0,"ymax":1466.0},{"id":50,"contenttext":"寛政四年江戶に生る。","xmin":1719.0,"ymin":1494.0,"xmax":1782.0,"ymax":1931.0},{"id":51,"contenttext":"父は秀馨と","xmin":1721.0,"ymin":1959.0,"xmax":1773.0,"ymax":2189.0},{"id":52,"contenttext":"云ひ津和野藩士たり。","xmin":1658.0,"ymin":702.0,"xmax":1716.0,"ymax":1141.0},{"id":53,"contenttext":"文化三年、","xmin":1655.0,"ymin":1166.0,"xmax":1706.0,"ymax":1369.0},{"id":54,"contenttext":"篤胤の門に入りしも幾ばくならずして","xmin":1645.0,"ymin":1401.0,"xmax":1701.0,"ymax":2185.0},{"id":55,"contenttext":"父命じて昌平黌に學ばしむ。","xmin":1586.0,"ymin":700.0,"xmax":1642.0,"ymax":1276.0},{"id":56,"contenttext":"乃ち業を古賀精里に受けり。","xmin":1579.0,"ymin":1307.0,"xmax":1633.0,"ymax":1875.0},{"id":57,"contenttext":"己にして以爲","xmin":1578.0,"ymin":1912.0,"xmax":1625.0,"ymax":2187.0},{"id":58,"contenttext":"らく、","xmin":1529.0,"ymin":702.0,"xmax":1561.0,"ymax":805.0},{"id":59,"contenttext":"我が皇國に生れ皇學を修めずして漢籍を學ぶ、","xmin":1504.0,"ymin":840.0,"xmax":1570.0,"ymax":1789.0},{"id":60,"contenttext":"可ならんや。","xmin":1506.0,"ymin":1816.0,"xmax":1553.0,"ymax":2064.0},{"id":61,"contenttext":"須ら","xmin":1504.0,"ymin":2094.0,"xmax":1550.0,"ymax":2185.0},{"id":62,"contenttext":"く皇學を修め後漢籍に及ぼすべきなりと。","xmin":1434.0,"ymin":699.0,"xmax":1497.0,"ymax":1552.0},{"id":63,"contenttext":"文化七年昌平黌を辭し、","xmin":1429.0,"ymin":1580.0,"xmax":1487.0,"ymax":2063.0},{"id":64,"contenttext":"四方","xmin":1429.0,"ymin":2090.0,"xmax":1480.0,"ymax":2184.0},{"id":65,"contenttext":"に遊學せり。","xmin":1370.0,"ymin":697.0,"xmax":1429.0,"ymax":945.0},{"id":66,"contenttext":"已にして父老い家を嗣き藩の大納戶武具役となりぬ。","xmin":1356.0,"ymin":979.0,"xmax":1424.0,"ymax":2063.0},{"id":67,"contenttext":"會、同","xmin":1355.0,"ymin":2080.0,"xmax":1410.0,"ymax":2184.0},{"id":68,"contenttext":"僚私をなすものあり。","xmin":1293.0,"ymin":693.0,"xmax":1352.0,"ymax":1133.0},{"id":69,"contenttext":"隆正禍の及ばんことを虞れ、","xmin":1287.0,"ymin":1159.0,"xmax":1347.0,"ymax":1738.0},{"id":70,"contenttext":"乃ち亡命す。","xmin":1283.0,"ymin":1767.0,"xmax":1337.0,"ymax":2015.0},{"id":71,"contenttext":"以後身","xmin":1283.0,"ymin":2043.0,"xmax":1334.0,"ymax":2183.0},{"id":72,"contenttext":"を專ら學業に委ね、","xmin":1222.0,"ymin":693.0,"xmax":1280.0,"ymax":1084.0},{"id":73,"contenttext":"造詣甚だ深し。","xmin":1217.0,"ymin":1114.0,"xmax":1273.0,"ymax":1411.0},{"id":74,"contenttext":"天保七年播磨の小野藩に聘せられ、","xmin":1208.0,"ymin":1439.0,"xmax":1270.0,"ymax":2148.0},{"id":75,"contenttext":"歸正館を起し一藩の子弟を〓育せり。","xmin":1145.0,"ymin":691.0,"xmax":1204.0,"ymax":1453.0},{"id":76,"contenttext":"當時一儒「駁本居翁書」なるものを著","xmin":1134.0,"ymin":1484.0,"xmax":1193.0,"ymax":2177.0},{"id":77,"contenttext":"はし宣長の說を攻擊す。","xmin":1080.0,"ymin":693.0,"xmax":1135.0,"ymax":1176.0},{"id":78,"contenttext":"隆正乃ち門人鈴木重胤の請に從ひ「憐駁者」を著は","xmin":1064.0,"ymin":1202.0,"xmax":1132.0,"ymax":2177.0},{"id":79,"contenttext":"し、","xmin":1015.0,"ymin":692.0,"xmax":1059.0,"ymax":754.0},{"id":80,"contenttext":"更に之れを反駁せり。","xmin":1000.0,"ymin":783.0,"xmax":1057.0,"ymax":1220.0},{"id":81,"contenttext":"曰はく、","xmin":1005.0,"ymin":1256.0,"xmax":1046.0,"ymax":1406.0},{"id":82,"contenttext":"ある儒生外國の聖賢を虛譽するあまり、","xmin":925.0,"ymin":783.0,"xmax":985.0,"ymax":1588.0},{"id":83,"contenttext":"「駁本居翁書」と題せる書を筆","xmin":919.0,"ymin":1609.0,"xmax":974.0,"ymax":2173.0},{"id":84,"contenttext":"神道史綱要","xmin":867.0,"ymin":806.0,"xmax":907.0,"ymax":1012.0},{"id":85,"contenttext":"〓","xmin":858.0,"ymin":1951.0,"xmax":896.0,"ymax":1989.0},{"id":86,"contenttext":"家を嗣ぐ","xmin":1392.0,"ymin":498.0,"xmax":1427.0,"ymax":619.0},{"id":87,"contenttext":"「駁本居翁書」と題せる書を筆","xmin":919.0,"ymin":1609.0,"xmax":974.0,"ymax":2173.0},{"id":88,"contenttext":"〓","xmin":858.0,"ymin":1951.0,"xmax":896.0,"ymax":1989.0}]