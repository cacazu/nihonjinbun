[{"id":0,"contenttext":"三","xmin":3119.0,"ymin":1887.0,"xmax":3154.0,"ymax":1923.0},{"id":1,"contenttext":"はかくて大佛を以つて天照大神と同一神靈の表現なりとの鞏固なる信念","xmin":3014.0,"ymin":632.0,"xmax":3098.0,"ymax":2110.0},{"id":2,"contenttext":"四五、","xmin":3010.0,"ymin":2057.0,"xmax":3035.0,"ymax":2117.0},{"id":3,"contenttext":"を懷き給ひ、","xmin":2944.0,"ymin":634.0,"xmax":2995.0,"ymax":881.0},{"id":4,"contenttext":"皇后太子群臣を率ゐ、","xmin":2949.0,"ymin":913.0,"xmax":3012.0,"ymax":1348.0},{"id":5,"contenttext":"大佛に對して北面し、","xmin":2963.0,"ymin":1376.0,"xmax":3016.0,"ymax":1805.0},{"id":6,"contenttext":"「三寳乃奴止仕","xmin":2974.0,"ymin":1826.0,"xmax":3019.0,"ymax":2113.0},{"id":7,"contenttext":"3,","xmin":2910.0,"ymin":639.0,"xmax":2937.0,"ymax":699.0},{"id":8,"contenttext":"奉流","xmin":2868.0,"ymin":633.0,"xmax":2923.0,"ymax":724.0},{"id":9,"contenttext":"天皇羅我","xmin":2872.0,"ymin":729.0,"xmax":2926.0,"ymax":909.0},{"id":10,"contenttext":"命處合那保雅大前七奏賜都正奏ふとの言を宣ふに至れり。","xmin":2877.0,"ymin":918.0,"xmax":2955.0,"ymax":2090.0},{"id":11,"contenttext":"之れを承けて孝謙天皇亦厚く神佛一致の說を信じ給ひ、","xmin":2794.0,"ymin":638.0,"xmax":2877.0,"ymax":1769.0},{"id":12,"contenttext":"之れを國民に示","xmin":2824.0,"ymin":1793.0,"xmax":2878.0,"ymax":2115.0},{"id":13,"contenttext":"し給ひぬ。","xmin":2728.0,"ymin":641.0,"xmax":2775.0,"ymax":840.0},{"id":14,"contenttext":"かく當時の佛〓家は最も巧妙なる方法を案出し、","xmin":2732.0,"ymin":873.0,"xmax":2802.0,"ymax":1859.0},{"id":15,"contenttext":"神佛一致の","xmin":2753.0,"ymin":1887.0,"xmax":2800.0,"ymax":2115.0},{"id":16,"contenttext":"說を主張し、","xmin":2652.0,"ymin":642.0,"xmax":2707.0,"ymax":894.0},{"id":17,"contenttext":"先づ朝廷より之れを信じ給はざるを得ざるが如くし、","xmin":2656.0,"ymin":920.0,"xmax":2732.0,"ymax":2000.0},{"id":18,"contenttext":"以つ","xmin":2678.0,"ymin":2027.0,"xmax":2732.0,"ymax":2119.0},{"id":19,"contenttext":"て國民に臨めり。","xmin":2575.0,"ymin":648.0,"xmax":2635.0,"ymax":985.0},{"id":20,"contenttext":"國民亦漸く之れを信じ、","xmin":2584.0,"ymin":1014.0,"xmax":2646.0,"ymax":1495.0},{"id":21,"contenttext":"先の煩悶を脫し、","xmin":2597.0,"ymin":1521.0,"xmax":2655.0,"ymax":1863.0},{"id":22,"contenttext":"盛に佛〓に","xmin":2606.0,"ymin":1892.0,"xmax":2655.0,"ymax":2117.0},{"id":23,"contenttext":"歸せり。","xmin":2506.0,"ymin":649.0,"xmax":2551.0,"ymax":803.0},{"id":24,"contenttext":"神佛一致の說によりて多くの國民は、","xmin":2433.0,"ymin":695.0,"xmax":2497.0,"ymax":1449.0},{"id":25,"contenttext":"皆佛に歸せりと雖も、","xmin":2451.0,"ymin":1480.0,"xmax":2505.0,"ymax":1911.0},{"id":26,"contenttext":"而かも內","xmin":2458.0,"ymin":1940.0,"xmax":2510.0,"ymax":2125.0},{"id":27,"contenttext":"心安ずる所を得ざるものあり。","xmin":2356.0,"ymin":652.0,"xmax":2421.0,"ymax":1268.0},{"id":28,"contenttext":"蓋し神佛の一致は種々の託宣によりて示","xmin":2372.0,"ymin":1296.0,"xmax":2441.0,"ymax":2126.0},{"id":29,"contenttext":"さると雖も、","xmin":2293.0,"ymin":657.0,"xmax":2334.0,"ymax":899.0},{"id":30,"contenttext":"我が古傳に一も事實の徵すべきなし。","xmin":2291.0,"ymin":928.0,"xmax":2357.0,"ymax":1683.0},{"id":31,"contenttext":"さればやゝ思慮ある","xmin":2309.0,"ymin":1715.0,"xmax":2365.0,"ymax":2126.0},{"id":32,"contenttext":"ものは、","xmin":2210.0,"ymin":654.0,"xmax":2265.0,"ymax":807.0},{"id":33,"contenttext":"尙一種の疑惑を脫する能はざりし也。","xmin":2215.0,"ymin":838.0,"xmax":2290.0,"ymax":1596.0},{"id":34,"contenttext":"此の疑惑を脫せしめんが","xmin":2235.0,"ymin":1623.0,"xmax":2297.0,"ymax":2128.0},{"id":35,"contenttext":"爲に玆に傳說を習合し、","xmin":2134.0,"ymin":656.0,"xmax":2203.0,"ymax":1138.0},{"id":36,"contenttext":"本地埀跡を說き、","xmin":2149.0,"ymin":1163.0,"xmax":2210.0,"ymax":1505.0},{"id":37,"contenttext":"神道の學理を構成するの擧を","xmin":2158.0,"ymin":1531.0,"xmax":2219.0,"ymax":2132.0},{"id":38,"contenttext":"傳說の習","xmin":2152.0,"ymin":459.0,"xmax":2192.0,"ymax":580.0},{"id":39,"contenttext":"合","xmin":2126.0,"ymin":461.0,"xmax":2157.0,"ymax":495.0},{"id":40,"contenttext":"見るに至りぬ。","xmin":1782.0,"ymin":688.0,"xmax":1825.0,"ymax":979.0},{"id":41,"contenttext":"是れ佛〓的神道の起れる所以也。","xmin":1775.0,"ymin":1008.0,"xmax":1827.0,"ymax":1674.0},{"id":42,"contenttext":"佛〓的神道の中に就いて、","xmin":1704.0,"ymin":730.0,"xmax":1757.0,"ymax":1253.0},{"id":43,"contenttext":"最初のものは山王一實神道也。","xmin":1701.0,"ymin":1284.0,"xmax":1756.0,"ymax":1904.0},{"id":44,"contenttext":"山王一實神","xmin":1700.0,"ymin":1932.0,"xmax":1750.0,"ymax":2161.0},{"id":45,"contenttext":"道は僧最澄によりて創めらると稱す。","xmin":1635.0,"ymin":686.0,"xmax":1680.0,"ymax":1443.0},{"id":46,"contenttext":"勿論吾人は彼れが後世謂ふ所の山","xmin":1626.0,"ymin":1472.0,"xmax":1681.0,"ymax":2163.0},{"id":47,"contenttext":"王一實神道を說きたりと謂ふにはあらず。","xmin":1555.0,"ymin":684.0,"xmax":1605.0,"ymax":1531.0},{"id":48,"contenttext":"唯〓その端を發したりと謂ふの","xmin":1551.0,"ymin":1562.0,"xmax":1604.0,"ymax":2158.0},{"id":49,"contenttext":"ゐ。","xmin":1486.0,"ymin":686.0,"xmax":1525.0,"ymax":746.0},{"id":50,"contenttext":"抑も山王神は元來支那天台山の鎭守也。","xmin":1410.0,"ymin":729.0,"xmax":1461.0,"ymax":1535.0},{"id":51,"contenttext":"最澄之れを又叡山に移し祭れ","xmin":1403.0,"ymin":1560.0,"xmax":1458.0,"ymax":2157.0},{"id":52,"contenttext":"るものゝ如し。","xmin":1339.0,"ymin":688.0,"xmax":1384.0,"ymax":976.0},{"id":53,"contenttext":"之れを移すに就いては、","xmin":1339.0,"ymin":1007.0,"xmax":1386.0,"ymax":1486.0},{"id":54,"contenttext":"「按ずるに日吉神號は、","xmin":1333.0,"ymin":1501.0,"xmax":1384.0,"ymax":1948.0},{"id":55,"contenttext":"傳〓小比","xmin":1333.0,"ymin":1977.0,"xmax":1382.0,"ymax":2162.0},{"id":56,"contenttext":"叡峯に於いて三光の日輪を見る。","xmin":1262.0,"ymin":683.0,"xmax":1317.0,"ymax":1347.0},{"id":57,"contenttext":"釋迦·藥師·彌陀の像を現ず。","xmin":1260.0,"ymin":1378.0,"xmax":1316.0,"ymax":1907.0},{"id":58,"contenttext":"〓その名を","xmin":1257.0,"ymin":1932.0,"xmax":1310.0,"ymax":2161.0},{"id":59,"contenttext":"問ふ。","xmin":1189.0,"ymin":682.0,"xmax":1234.0,"ymax":791.0},{"id":60,"contenttext":"神〓げて曰はく、","xmin":1189.0,"ymin":820.0,"xmax":1242.0,"ymax":1157.0},{"id":61,"contenttext":"竪の三點に橫の一點を加ふ。","xmin":1187.0,"ymin":1192.0,"xmax":1239.0,"ymax":1763.0},{"id":62,"contenttext":"橫の三點に竪の一","xmin":1185.0,"ymin":1791.0,"xmax":1234.0,"ymax":2148.0},{"id":63,"contenttext":"點を添ふ。","xmin":1116.0,"ymin":682.0,"xmax":1163.0,"ymax":883.0},{"id":64,"contenttext":"言ひ已てその光空に昇つて去る。","xmin":1118.0,"ymin":915.0,"xmax":1165.0,"ymax":1573.0},{"id":65,"contenttext":"数、","xmin":1116.0,"ymin":1603.0,"xmax":1167.0,"ymax":1668.0},{"id":66,"contenttext":"文字に之れを見るに、","xmin":1111.0,"ymin":1697.0,"xmax":1164.0,"ymax":2130.0},{"id":67,"contenttext":"竪の三點に橫の一點を山字となす。","xmin":1038.0,"ymin":683.0,"xmax":1096.0,"ymax":1392.0},{"id":68,"contenttext":"橫の三點に竪の一點を王字となす。","xmin":1032.0,"ymin":1423.0,"xmax":1095.0,"ymax":2134.0},{"id":69,"contenttext":"高大不動なるものは山也。","xmin":966.0,"ymin":684.0,"xmax":1015.0,"ymax":1208.0},{"id":70,"contenttext":"三才に經緯たるものは王也。","xmin":964.0,"ymin":1239.0,"xmax":1018.0,"ymax":1807.0},{"id":71,"contenttext":"是れより遂に崇","xmin":963.0,"ymin":1838.0,"xmax":1012.0,"ymax":2158.0},{"id":72,"contenttext":"んで號して山王と曰ふ」(本朝神社考)と云ふが如き說を作り、","xmin":893.0,"ymin":686.0,"xmax":949.0,"ymax":1904.0},{"id":73,"contenttext":"山王神の本","xmin":891.0,"ymin":1930.0,"xmax":938.0,"ymax":2160.0},{"id":74,"contenttext":"神道史綱要","xmin":836.0,"ymin":790.0,"xmax":875.0,"ymax":996.0},{"id":75,"contenttext":"三","xmin":834.0,"ymin":1934.0,"xmax":865.0,"ymax":1970.0},{"id":76,"contenttext":"佛教的神","xmin":1717.0,"ymin":487.0,"xmax":1754.0,"ymax":607.0},{"id":77,"contenttext":"道","xmin":1690.0,"ymin":485.0,"xmax":1721.0,"ymax":523.0}]