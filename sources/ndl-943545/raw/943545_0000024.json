[{"id":0,"contenttext":"元","xmin":3190.0,"ymin":1965.0,"xmax":3225.0,"ymax":2002.0},{"id":1,"contenttext":"ことなく、","xmin":3125.0,"ymin":757.0,"xmax":3162.0,"ymax":946.0},{"id":2,"contenttext":"天下は穩に治まりて、","xmin":3112.0,"ymin":986.0,"xmax":3166.0,"ymax":1417.0},{"id":3,"contenttext":"天津日嗣いや遠長に傳はり來坐せり、","xmin":3102.0,"ymin":1447.0,"xmax":3162.0,"ymax":2191.0},{"id":4,"contenttext":"さればかの異國の名にならひていはゞ、","xmin":3034.0,"ymin":754.0,"xmax":3100.0,"ymax":1553.0},{"id":5,"contenttext":"是ぞ上もなき優れたる大き道","xmin":3026.0,"ymin":1584.0,"xmax":3089.0,"ymax":2186.0},{"id":6,"contenttext":"ニ","xmin":3004.0,"ymin":1493.0,"xmax":3026.0,"ymax":1535.0},{"id":7,"contenttext":"にして、","xmin":2973.0,"ymin":750.0,"xmax":3020.0,"ymax":904.0},{"id":8,"contenttext":"實の道なるが故に、","xmin":2965.0,"ymin":935.0,"xmax":3018.0,"ymax":1321.0},{"id":9,"contenttext":"道てふ言なく、","xmin":2961.0,"ymin":1349.0,"xmax":3013.0,"ymax":1644.0},{"id":10,"contenttext":"道てふことなけれど、","xmin":2954.0,"ymin":1674.0,"xmax":3009.0,"ymax":2110.0},{"id":11,"contenttext":"道","xmin":2953.0,"ymin":2139.0,"xmax":3002.0,"ymax":2187.0},{"id":12,"contenttext":"ありしなりけり。","xmin":2898.0,"ymin":751.0,"xmax":2942.0,"ymax":1088.0},{"id":13,"contenttext":"(直毘靈)","xmin":2890.0,"ymin":1108.0,"xmax":2944.0,"ymax":1270.0},{"id":14,"contenttext":"と。","xmin":2831.0,"ymin":704.0,"xmax":2867.0,"ymax":762.0},{"id":15,"contenttext":"かくて、","xmin":2827.0,"ymin":796.0,"xmax":2867.0,"ymax":948.0},{"id":16,"contenttext":"彼れは我が上古に大道は嚴として行はれしと雖も、","xmin":2808.0,"ymin":978.0,"xmax":2870.0,"ymax":2012.0},{"id":17,"contenttext":"而かも","xmin":2808.0,"ymin":2047.0,"xmax":2853.0,"ymax":2181.0},{"id":18,"contenttext":"敢へて之れを道と稱せず。","xmin":2744.0,"ymin":700.0,"xmax":2798.0,"ymax":1224.0},{"id":19,"contenttext":"後、","xmin":2743.0,"ymin":1254.0,"xmax":2794.0,"ymax":1320.0},{"id":20,"contenttext":"彼れの文物輸入せられ、","xmin":2736.0,"ymin":1347.0,"xmax":2794.0,"ymax":1830.0},{"id":21,"contenttext":"道なる文字の用","xmin":2732.0,"ymin":1858.0,"xmax":2787.0,"ymax":2181.0},{"id":22,"contenttext":"ひらるゝ場合を知り、","xmin":2677.0,"ymin":702.0,"xmax":2722.0,"ymax":1130.0},{"id":23,"contenttext":"初めて我が大道に名くるに神の道を以つてせりと","xmin":2661.0,"ymin":1161.0,"xmax":2723.0,"ymax":2183.0},{"id":24,"contenttext":"なせり私淑言)。","xmin":2610.0,"ymin":698.0,"xmax":2655.0,"ymax":1003.0},{"id":25,"contenttext":"然らば則ち、","xmin":2606.0,"ymin":1019.0,"xmax":2653.0,"ymax":1267.0},{"id":26,"contenttext":"支那·印度の思想を混入せざる我が固有の大","xmin":2589.0,"ymin":1298.0,"xmax":2655.0,"ymax":2176.0},{"id":27,"contenttext":"道なるものは、","xmin":2533.0,"ymin":698.0,"xmax":2586.0,"ymax":992.0},{"id":28,"contenttext":"抑も如何なるものぞ。","xmin":2527.0,"ymin":1021.0,"xmax":2581.0,"ymax":1453.0},{"id":29,"contenttext":"是れ宣長の全力を擧げて主張せる","xmin":2515.0,"ymin":1484.0,"xmax":2579.0,"ymax":2177.0},{"id":30,"contenttext":"所の大いなる道也。","xmin":2460.0,"ymin":694.0,"xmax":2513.0,"ymax":1081.0},{"id":31,"contenttext":"彼れは曰はく、","xmin":2454.0,"ymin":1114.0,"xmax":2507.0,"ymax":1409.0},{"id":32,"contenttext":"此道は、","xmin":2389.0,"ymin":790.0,"xmax":2436.0,"ymax":946.0},{"id":33,"contenttext":"『古事記』·『書紀』の二與に記されたる、","xmin":2379.0,"ymin":947.0,"xmax":2437.0,"ymax":1680.0},{"id":34,"contenttext":"神代·上代の、","xmin":2373.0,"ymin":1713.0,"xmax":2428.0,"ymax":1965.0},{"id":35,"contenttext":"もろ〓〓","xmin":2379.0,"ymin":1998.0,"xmax":2416.0,"ymax":2166.0},{"id":36,"contenttext":"の事跡のうへに備はりたり。","xmin":2320.0,"ymin":745.0,"xmax":2367.0,"ymax":1312.0},{"id":37,"contenttext":"(初山踏)","xmin":2311.0,"ymin":1334.0,"xmax":2358.0,"ymax":1492.0},{"id":38,"contenttext":"と。","xmin":2256.0,"ymin":700.0,"xmax":2289.0,"ymax":756.0},{"id":39,"contenttext":"更に曰はく、","xmin":2250.0,"ymin":786.0,"xmax":2295.0,"ymax":1030.0},{"id":40,"contenttext":"最上の大","xmin":3062.0,"ymin":504.0,"xmax":3102.0,"ymax":627.0},{"id":41,"contenttext":"道","xmin":3033.0,"ymin":504.0,"xmax":3070.0,"ymax":542.0},{"id":42,"contenttext":"神代·上代の、","xmin":2373.0,"ymin":1713.0,"xmax":2428.0,"ymax":1965.0},{"id":43,"contenttext":"もろ〓〓","xmin":2379.0,"ymin":1998.0,"xmax":2416.0,"ymax":2166.0},{"id":44,"contenttext":"道は、","xmin":1823.0,"ymin":786.0,"xmax":1872.0,"ymax":895.0},{"id":45,"contenttext":"此二典にしるされたる、","xmin":1823.0,"ymin":925.0,"xmax":1872.0,"ymax":1404.0},{"id":46,"contenttext":"神代のもろ〓〓の事跡のうへに備は","xmin":1821.0,"ymin":1432.0,"xmax":1870.0,"ymax":2168.0},{"id":47,"contenttext":"りたれども、","xmin":1754.0,"ymin":741.0,"xmax":1796.0,"ymax":983.0},{"id":48,"contenttext":"儒〓佛などの書のやうに、","xmin":1749.0,"ymin":1017.0,"xmax":1796.0,"ymax":1494.0},{"id":49,"contenttext":"其道のさまを、","xmin":1749.0,"ymin":1526.0,"xmax":1796.0,"ymax":1819.0},{"id":50,"contenttext":"かやう〓〓と、","xmin":1749.0,"ymin":1853.0,"xmax":1789.0,"ymax":2140.0},{"id":51,"contenttext":"さして〓へたることなければ、","xmin":1676.0,"ymin":741.0,"xmax":1731.0,"ymax":1357.0},{"id":52,"contenttext":"かの儒佛の目うつしに之を見ては、","xmin":1672.0,"ymin":1389.0,"xmax":1724.0,"ymax":2095.0},{"id":53,"contenttext":"道","xmin":1674.0,"ymin":2127.0,"xmax":1721.0,"ymax":2170.0},{"id":54,"contenttext":"の趣、","xmin":1606.0,"ymin":741.0,"xmax":1655.0,"ymax":850.0},{"id":55,"contenttext":"いかなるものとも知りがたく、","xmin":1606.0,"ymin":884.0,"xmax":1650.0,"ymax":1494.0},{"id":56,"contenttext":"とらへどころなきが如くなる故","xmin":1604.0,"ymin":1528.0,"xmax":1648.0,"ymax":2170.0},{"id":57,"contenttext":"に、","xmin":1537.0,"ymin":743.0,"xmax":1576.0,"ymax":797.0},{"id":58,"contenttext":"むかしより世々の物しり人も、","xmin":1537.0,"ymin":835.0,"xmax":1581.0,"ymax":1449.0},{"id":59,"contenttext":"之をえとらへず、","xmin":1535.0,"ymin":1481.0,"xmax":1580.0,"ymax":1821.0},{"id":60,"contenttext":"さとらずして、","xmin":1537.0,"ymin":1855.0,"xmax":1578.0,"ymax":2142.0},{"id":61,"contenttext":"或は佛道の意により、","xmin":1461.0,"ymin":741.0,"xmax":1515.0,"ymax":1171.0},{"id":62,"contenttext":"或は儒道の意にすがりて、","xmin":1461.0,"ymin":1203.0,"xmax":1510.0,"ymax":1727.0},{"id":63,"contenttext":"之を說きたり。","xmin":1461.0,"ymin":1759.0,"xmax":1510.0,"ymax":2054.0},{"id":64,"contenttext":"其內、","xmin":1461.0,"ymin":2082.0,"xmax":1510.0,"ymax":2179.0},{"id":65,"contenttext":"昔の說は、","xmin":1388.0,"ymin":741.0,"xmax":1441.0,"ymax":942.0},{"id":66,"contenttext":"多く佛道によりたりしを、","xmin":1388.0,"ymin":970.0,"xmax":1437.0,"ymax":1496.0},{"id":67,"contenttext":"百五六十年以來は、","xmin":1382.0,"ymin":1522.0,"xmax":1439.0,"ymax":1913.0},{"id":68,"contenttext":"かの佛道に","xmin":1386.0,"ymin":1945.0,"xmax":1439.0,"ymax":2173.0},{"id":69,"contenttext":"よれる說の非なることをばさとりて、","xmin":1309.0,"ymin":743.0,"xmax":1362.0,"ymax":1498.0},{"id":70,"contenttext":"其佛道の意をばよくのぞきぬれ","xmin":1310.0,"ymin":1530.0,"xmax":1358.0,"ymax":2168.0},{"id":71,"contenttext":"ども、","xmin":1247.0,"ymin":743.0,"xmax":1281.0,"ymax":844.0},{"id":72,"contenttext":"その輩の說は、","xmin":1236.0,"ymin":878.0,"xmax":1286.0,"ymax":1173.0},{"id":73,"contenttext":"又皆儒道の意に落入て、","xmin":1236.0,"ymin":1203.0,"xmax":1282.0,"ymax":1682.0},{"id":74,"contenttext":"近世の神學者流みな然","xmin":1234.0,"ymin":1712.0,"xmax":1283.0,"ymax":2170.0},{"id":75,"contenttext":"なり。","xmin":1173.0,"ymin":743.0,"xmax":1208.0,"ymax":846.0},{"id":76,"contenttext":"其中にも流々ありて、","xmin":1167.0,"ymin":880.0,"xmax":1214.0,"ymax":1312.0},{"id":77,"contenttext":"すこしづゝのかはりはあれども、","xmin":1165.0,"ymin":1344.0,"xmax":1215.0,"ymax":2005.0},{"id":78,"contenttext":"大抵み","xmin":1165.0,"ymin":2035.0,"xmax":1214.0,"ymax":2170.0},{"id":79,"contenttext":"な同じやうなるものにて、『神代紀』","xmin":1093.0,"ymin":741.0,"xmax":1147.0,"ymax":1453.0},{"id":80,"contenttext":"をはじめ、","xmin":1091.0,"ymin":1477.0,"xmax":1146.0,"ymax":1685.0},{"id":81,"contenttext":"もろ〓〓の神典のとり","xmin":1093.0,"ymin":1718.0,"xmax":1140.0,"ymax":2170.0},{"id":82,"contenttext":"さばき、","xmin":1024.0,"ymin":743.0,"xmax":1071.0,"ymax":897.0},{"id":83,"contenttext":"たゞ陰陽八卦五行など、","xmin":1020.0,"ymin":929.0,"xmax":1073.0,"ymax":1406.0},{"id":84,"contenttext":"すべてからめきたるさだのみにして、","xmin":1017.0,"ymin":1434.0,"xmax":1071.0,"ymax":2181.0},{"id":85,"contenttext":"いさゝかも古の意にかなへることなく、","xmin":945.0,"ymin":745.0,"xmax":994.0,"ymax":1540.0},{"id":86,"contenttext":"說くところ悉皆儒道にて、","xmin":943.0,"ymin":1573.0,"xmax":994.0,"ymax":2099.0},{"id":87,"contenttext":"た","xmin":948.0,"ymin":2131.0,"xmax":992.0,"ymax":2173.0},{"id":88,"contenttext":"神道史綱要","xmin":879.0,"ymin":808.0,"xmax":920.0,"ymax":1013.0},{"id":89,"contenttext":"元","xmin":877.0,"ymin":1951.0,"xmax":913.0,"ymax":1989.0},{"id":90,"contenttext":"經典なし","xmin":1762.0,"ymin":494.0,"xmax":1796.0,"ymax":611.0}]