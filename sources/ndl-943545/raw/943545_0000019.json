[{"id":1,"contenttext":"めて多し。","xmin":3078.0,"ymin":729.0,"xmax":3138.0,"ymax":920.0},{"id":2,"contenttext":"享保中に江戶に遊びて聲名あり。","xmin":3086.0,"ymin":961.0,"xmax":3142.0,"ymax":1609.0},{"id":3,"contenttext":"特に內命ありて侍臣某を","xmin":3090.0,"ymin":1670.0,"xmax":3139.0,"ymax":2146.0},{"id":4,"contenttext":"して從遊せしめて、","xmin":3009.0,"ymin":728.0,"xmax":3067.0,"ymax":1104.0},{"id":5,"contenttext":"古書を校せしめ給ふ。","xmin":3012.0,"ymin":1153.0,"xmax":3068.0,"ymax":1566.0},{"id":6,"contenttext":"居ること數年にして疾を得","xmin":3015.0,"ymin":1626.0,"xmax":3069.0,"ymax":2148.0},{"id":7,"contenttext":"て京に歸らる。","xmin":2937.0,"ymin":732.0,"xmax":2986.0,"ymax":1008.0},{"id":8,"contenttext":"已にして伏見奉行北條遠江守をして、","xmin":2938.0,"ymin":1059.0,"xmax":2993.0,"ymax":1797.0},{"id":9,"contenttext":"內命を傳へて銀","xmin":2943.0,"ymin":1858.0,"xmax":2992.0,"ymax":2146.0},{"id":10,"contenttext":"若干を賜ふ。","xmin":2865.0,"ymin":728.0,"xmax":2914.0,"ymax":961.0},{"id":11,"contenttext":"大人嘗て國學校を創立する志ありて。","xmin":2865.0,"ymin":1009.0,"xmax":2917.0,"ymax":1750.0},{"id":12,"contenttext":"上書して執事に啓","xmin":2869.0,"ymin":1814.0,"xmax":2918.0,"ymax":2148.0},{"id":13,"contenttext":"するに未だ報あらずして歿せり。","xmin":2806.0,"ymin":730.0,"xmax":2851.0,"ymax":1371.0},{"id":14,"contenttext":"其志は遂げざれども、","xmin":2806.0,"ymin":1434.0,"xmax":2853.0,"ymax":1839.0},{"id":15,"contenttext":"其言は傳ふべ","xmin":2808.0,"ymin":1908.0,"xmax":2855.0,"ymax":2142.0},{"id":16,"contenttext":"Lo","xmin":2739.0,"ymin":730.0,"xmax":2777.0,"ymax":779.0},{"id":17,"contenttext":"(玉襷)","xmin":2732.0,"ymin":808.0,"xmax":2782.0,"ymax":914.0},{"id":18,"contenttext":"to","xmin":2675.0,"ymin":684.0,"xmax":2709.0,"ymax":728.0},{"id":19,"contenttext":"又、","xmin":2665.0,"ymin":770.0,"xmax":2715.0,"ymax":825.0},{"id":20,"contenttext":"曰はく、","xmin":2666.0,"ymin":871.0,"xmax":2718.0,"ymax":1005.0},{"id":21,"contenttext":"此翁の著書","xmin":2600.0,"ymin":774.0,"xmax":2651.0,"ymax":995.0},{"id":22,"contenttext":"春滿は著はす所少かさりしも其の大部分は終焉に臨み","xmin":2590.0,"ymin":1049.0,"xmax":2636.0,"ymax":2150.0},{"id":23,"contenttext":"は、","xmin":2528.0,"ymin":730.0,"xmax":2572.0,"ymax":777.0},{"id":24,"contenttext":"故ありて一","xmin":2527.0,"ymin":822.0,"xmax":2578.0,"ymax":1025.0},{"id":25,"contenttext":"門人をして皆焚かしめぬ。","xmin":2544.0,"ymin":1047.0,"xmax":2588.0,"ymax":1557.0},{"id":26,"contenttext":"世に傳れる物少けれども、","xmin":2455.0,"ymin":728.0,"xmax":2513.0,"ymax":1231.0},{"id":27,"contenttext":"すべて吾が古學の規則は、","xmin":2463.0,"ymin":1286.0,"xmax":2512.0,"ymax":1805.0},{"id":28,"contenttext":"此翁に相立初申","xmin":2467.0,"ymin":1853.0,"xmax":2516.0,"ymax":2142.0},{"id":29,"contenttext":"候","xmin":2399.0,"ymin":728.0,"xmax":2445.0,"ymax":777.0},{"id":30,"contenttext":"(入學問答)","xmin":2397.0,"ymin":812.0,"xmax":2451.0,"ymax":1006.0},{"id":31,"contenttext":"と。","xmin":2346.0,"ymin":686.0,"xmax":2375.0,"ymax":721.0},{"id":32,"contenttext":"以つて春滿は嚴格なる意味に於ける古道學の祖となすべき也。","xmin":2331.0,"ymin":772.0,"xmax":2387.0,"ymax":2028.0},{"id":33,"contenttext":"彼れ","xmin":2340.0,"ymin":2095.0,"xmax":2389.0,"ymax":2148.0},{"id":34,"contenttext":"常に曰はく","xmin":2273.0,"ymin":682.0,"xmax":2318.0,"ymax":895.0},{"id":35,"contenttext":"學びの道は、","xmin":2209.0,"ymin":774.0,"xmax":2258.0,"ymax":1008.0},{"id":36,"contenttext":"天の下の大路なれば、","xmin":2206.0,"ymin":1055.0,"xmax":2261.0,"ymax":1472.0},{"id":37,"contenttext":"己ひとり立らむが如くほこるべ","xmin":2213.0,"ymin":1532.0,"xmax":2258.0,"ymax":2140.0},{"id":38,"contenttext":"國學校","xmin":2837.0,"ymin":483.0,"xmax":2876.0,"ymax":564.0},{"id":39,"contenttext":"此翁に相立初申","xmin":2467.0,"ymin":1853.0,"xmax":2516.0,"ymax":2142.0},{"id":40,"contenttext":"彼れ","xmin":2340.0,"ymin":2095.0,"xmax":2389.0,"ymax":2148.0},{"id":41,"contenttext":"天の下の大路なれば、","xmin":2206.0,"ymin":1055.0,"xmax":2261.0,"ymax":1472.0},{"id":42,"contenttext":"己ひとり立らむが如くほこるべ","xmin":2213.0,"ymin":1532.0,"xmax":2258.0,"ymax":2140.0},{"id":43,"contenttext":"からず。","xmin":1783.0,"ymin":778.0,"xmax":1832.0,"ymax":919.0},{"id":44,"contenttext":"學ぶ人も師の〓なりとてあながちに泥むべからず。","xmin":1784.0,"ymin":966.0,"xmax":1856.0,"ymax":1983.0},{"id":45,"contenttext":"(春葉集序","xmin":1811.0,"ymin":2038.0,"xmax":1860.0,"ymax":2201.0},{"id":46,"contenttext":"と。","xmin":1717.0,"ymin":734.0,"xmax":1751.0,"ymax":777.0},{"id":47,"contenttext":"此の訓陶を受く、","xmin":1714.0,"ymin":824.0,"xmax":1767.0,"ymax":1149.0},{"id":48,"contenttext":"その門下豈に偉器なからむや。","xmin":1718.0,"ymin":1203.0,"xmax":1781.0,"ymax":1797.0},{"id":49,"contenttext":"果して賀茂の眞淵","xmin":1732.0,"ymin":1863.0,"xmax":1790.0,"ymax":2198.0},{"id":50,"contenttext":"その門に出でぬ。","xmin":1641.0,"ymin":732.0,"xmax":1694.0,"ymax":1055.0},{"id":51,"contenttext":"眞淵は元祿十年を以つて遠江國敷智郡岡部に生る。","xmin":1565.0,"ymin":779.0,"xmax":1645.0,"ymax":1807.0},{"id":52,"contenttext":"通稱參四。","xmin":1589.0,"ymin":1865.0,"xmax":1649.0,"ymax":2034.0},{"id":53,"contenttext":"後改め","xmin":1598.0,"ymin":2103.0,"xmax":1649.0,"ymax":2199.0},{"id":54,"contenttext":"1","xmin":1533.0,"ymin":780.0,"xmax":1566.0,"ymax":806.0},{"id":55,"contenttext":"て衞士と云ふ。","xmin":1492.0,"ymin":736.0,"xmax":1547.0,"ymax":1014.0},{"id":56,"contenttext":"眞淵はその名也。","xmin":1500.0,"ymin":1064.0,"xmax":1555.0,"ymax":1384.0},{"id":57,"contenttext":"父は岡部の新宮の禰宜定信、","xmin":1508.0,"ymin":1443.0,"xmax":1570.0,"ymax":1987.0},{"id":58,"contenttext":"母は竹山","xmin":1523.0,"ymin":2059.0,"xmax":1574.0,"ymax":2215.0},{"id":59,"contenttext":"氏","xmin":1418.0,"ymin":734.0,"xmax":1469.0,"ymax":787.0},{"id":60,"contenttext":"幼にして姊夫政盛の養子たりしが、","xmin":1420.0,"ymin":830.0,"xmax":1489.0,"ymax":1527.0},{"id":61,"contenttext":"後去りて濱松の本陣、","xmin":1438.0,"ymin":1586.0,"xmax":1497.0,"ymax":1991.0},{"id":62,"contenttext":"梅谷甚三","xmin":1446.0,"ymin":2056.0,"xmax":1502.0,"ymax":2202.0},{"id":63,"contenttext":"郞方良の養子となりぬ。","xmin":1344.0,"ymin":736.0,"xmax":1404.0,"ymax":1199.0},{"id":64,"contenttext":"初め徂徠派の渡邊蒙闇に就いて漢籍詩文を修め","xmin":1354.0,"ymin":1255.0,"xmax":1426.0,"ymax":2201.0},{"id":65,"contenttext":"しも、","xmin":1286.0,"ymin":743.0,"xmax":1318.0,"ymax":828.0},{"id":66,"contenttext":"壯なるに及び心を古道の學に傾け、","xmin":1277.0,"ymin":880.0,"xmax":1340.0,"ymax":1574.0},{"id":67,"contenttext":"春滿に見えて益々その志を深","xmin":1293.0,"ymin":1636.0,"xmax":1354.0,"ymax":2206.0},{"id":68,"contenttext":"くせり。","xmin":1212.0,"ymin":743.0,"xmax":1251.0,"ymax":879.0},{"id":69,"contenttext":"篤胤記して曰はく、","xmin":1209.0,"ymin":927.0,"xmax":1265.0,"ymax":1294.0},{"id":70,"contenttext":"此のほど濱松に二人の友あり。","xmin":1133.0,"ymin":836.0,"xmax":1197.0,"ymax":1437.0},{"id":71,"contenttext":"諏訪の社の大祝杉浦信濃守國顯と、","xmin":1143.0,"ymin":1497.0,"xmax":1214.0,"ymax":2180.0},{"id":72,"contenttext":"五社の神主森民部少輔暉昌となり。","xmin":1060.0,"ymin":790.0,"xmax":1126.0,"ymax":1482.0},{"id":73,"contenttext":"此二人ともに東麿大人の〓子なる","xmin":1073.0,"ymin":1544.0,"xmax":1139.0,"ymax":2206.0},{"id":74,"contenttext":"に、","xmin":986.0,"ymin":796.0,"xmax":1032.0,"ymax":838.0},{"id":75,"contenttext":"况て國顯が妻マサキといひしは、","xmin":985.0,"ymin":884.0,"xmax":1055.0,"ymax":1534.0},{"id":76,"contenttext":"荷田の大人の姪なりなりしかば、","xmin":1002.0,"ymin":1592.0,"xmax":1064.0,"ymax":2216.0},{"id":77,"contenttext":"大人江戶に物せらるゝ時々は、","xmin":910.0,"ymin":790.0,"xmax":973.0,"ymax":1394.0},{"id":78,"contenttext":"此家に宿られける。","xmin":925.0,"ymin":1453.0,"xmax":980.0,"ymax":1811.0},{"id":79,"contenttext":"故に此人々の執り","xmin":931.0,"ymin":1876.0,"xmax":989.0,"ymax":2208.0},{"id":80,"contenttext":"神道史綱要","xmin":838.0,"ymin":867.0,"xmax":887.0,"ymax":1058.0},{"id":81,"contenttext":"元","xmin":871.0,"ymin":2029.0,"xmax":907.0,"ymax":2031.0},{"id":82,"contenttext":"賀茂眞淵","xmin":1572.0,"ymin":529.0,"xmax":1613.0,"ymax":645.0}]