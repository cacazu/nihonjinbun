[{"id":1,"contenttext":"略を記し、小册子となし、聊か斯道研究者日常の便","xmin":3001.0,"ymin":674.0,"xmax":3098.0,"ymax":2139.0},{"id":2,"contenttext":"に供せんとす。若し夫れ詳密なる〓究に至りては、","xmin":2908.0,"ymin":676.0,"xmax":3004.0,"ymax":2151.0},{"id":3,"contenttext":"予が終生の業、冀くは大方諸賢の高〓を得て、之れ","xmin":2811.0,"ymin":676.0,"xmax":2910.0,"ymax":2139.0},{"id":4,"contenttext":"が大成を得んことを。","xmin":2720.0,"ymin":680.0,"xmax":2807.0,"ymax":1308.0},{"id":5,"contenttext":"大正四年七月","xmin":2605.0,"ymin":825.0,"xmax":2676.0,"ymax":1229.0},{"id":6,"contenttext":"東京に於いて","xmin":2493.0,"ymin":1435.0,"xmax":2563.0,"ymax":1820.0},{"id":7,"contenttext":"著","xmin":2379.0,"ymin":1585.0,"xmax":2481.0,"ymax":1649.0},{"id":8,"contenttext":"者","xmin":2383.0,"ymin":1814.0,"xmax":2483.0,"ymax":1874.0},{"id":9,"contenttext":"識","xmin":2383.0,"ymin":2041.0,"xmax":2487.0,"ymax":2095.0},{"id":10,"contenttext":"神道史綱要","xmin":1677.0,"ymin":675.0,"xmax":1810.0,"ymax":1355.0},{"id":11,"contenttext":":","xmin":1578.0,"ymin":1901.0,"xmax":1602.0,"ymax":1901.0},{"id":12,"contenttext":"能","xmin":1519.0,"ymin":1881.0,"xmax":1590.0,"ymax":1915.0},{"id":13,"contenttext":"文學士","xmin":1521.0,"ymin":1281.0,"xmax":1594.0,"ymax":1436.0},{"id":14,"contenttext":"田","xmin":1523.0,"ymin":1540.0,"xmax":1592.0,"ymax":1584.0},{"id":15,"contenttext":"中","xmin":1523.0,"ymin":1656.0,"xmax":1584.0,"ymax":1687.0},{"id":16,"contenttext":"義","xmin":1519.0,"ymin":1766.0,"xmax":1590.0,"ymax":1802.0},{"id":17,"contenttext":"著","xmin":1521.0,"ymin":2001.0,"xmax":1588.0,"ymax":2025.0},{"id":18,"contenttext":"熟ら宇宙の現象を觀るに、","xmin":1377.0,"ymin":727.0,"xmax":1427.0,"ymax":1228.0},{"id":19,"contenttext":"其の活動は、","xmin":1377.0,"ymin":1296.0,"xmax":1429.0,"ymax":1508.0},{"id":20,"contenttext":"皆一定の方向に行はれ、","xmin":1377.0,"ymin":1581.0,"xmax":1429.0,"ymax":2017.0},{"id":21,"contenttext":"盲目","xmin":1380.0,"ymin":2099.0,"xmax":1422.0,"ymax":2144.0},{"id":22,"contenttext":"的","xmin":1304.0,"ymin":675.0,"xmax":1357.0,"ymax":721.0},{"id":23,"contenttext":"機械的に活動せるものにあらざるが如し。","xmin":1304.0,"ymin":773.0,"xmax":1353.0,"ymax":1606.0},{"id":24,"contenttext":"請ふ靜に之れを觀察せよ。","xmin":1304.0,"ymin":1672.0,"xmax":1351.0,"ymax":2156.0},{"id":25,"contenttext":"日月の運行、","xmin":1232.0,"ymin":677.0,"xmax":1283.0,"ymax":901.0},{"id":26,"contenttext":"四時の循環、","xmin":1230.0,"ymin":951.0,"xmax":1281.0,"ymax":1167.0},{"id":27,"contenttext":"百物の生る、","xmin":1228.0,"ymin":1216.0,"xmax":1279.0,"ymax":1437.0},{"id":28,"contenttext":"皆秩序もあり、","xmin":1230.0,"ymin":1494.0,"xmax":1277.0,"ymax":1747.0},{"id":29,"contenttext":"統一もあるを知る","xmin":1230.0,"ymin":1817.0,"xmax":1279.0,"ymax":2140.0},{"id":30,"contenttext":"んbb","xmin":1163.0,"ymin":683.0,"xmax":1206.0,"ymax":774.0},{"id":31,"contenttext":"その他宇宙の美的性質、","xmin":1155.0,"ymin":819.0,"xmax":1210.0,"ymax":1276.0},{"id":32,"contenttext":"經濟的構成、","xmin":1157.0,"ymin":1342.0,"xmax":1208.0,"ymax":1553.0},{"id":33,"contenttext":"是れ皆大生命の顯現、","xmin":1157.0,"ymin":1627.0,"xmax":1208.0,"ymax":2015.0},{"id":34,"contenttext":"所謂","xmin":1159.0,"ymin":2099.0,"xmax":1208.0,"ymax":2144.0},{"id":35,"contenttext":"天地の公道の存在を語れるものにあらずや。","xmin":1087.0,"ymin":672.0,"xmax":1138.0,"ymax":1555.0},{"id":36,"contenttext":"我が古傳は此の大生命を造","xmin":1087.0,"ymin":1624.0,"xmax":1134.0,"ymax":2142.0},{"id":37,"contenttext":"化の三神と稱す。","xmin":1016.0,"ymin":672.0,"xmax":1065.0,"ymax":989.0},{"id":38,"contenttext":"曰はく、","xmin":1018.0,"ymin":1047.0,"xmax":1067.0,"ymax":1170.0},{"id":39,"contenttext":"天御中主神、","xmin":1013.0,"ymin":1224.0,"xmax":1066.0,"ymax":1431.0},{"id":40,"contenttext":"高皇產靈神、","xmin":1013.0,"ymin":1496.0,"xmax":1065.0,"ymax":1698.0},{"id":41,"contenttext":"神皇產靈神と。","xmin":1013.0,"ymin":1764.0,"xmax":1061.0,"ymax":2019.0},{"id":42,"contenttext":"而し","xmin":1013.0,"ymin":2095.0,"xmax":1062.0,"ymax":2141.0},{"id":43,"contenttext":"て天御中主神は高天原即ち天の眞中にまし〓〓て、","xmin":938.0,"ymin":677.0,"xmax":995.0,"ymax":1668.0},{"id":44,"contenttext":"一切現象の本源にまし","xmin":940.0,"ymin":1746.0,"xmax":988.0,"ymax":2138.0},{"id":45,"contenttext":"ますと云ふ。","xmin":869.0,"ymin":672.0,"xmax":917.0,"ymax":905.0},{"id":46,"contenttext":"蓋し天とは此の大宇宙の謂にして、","xmin":867.0,"ymin":957.0,"xmax":920.0,"ymax":1644.0},{"id":47,"contenttext":"此の大字宙を本體とせ","xmin":867.0,"ymin":1718.0,"xmax":917.0,"ymax":2138.0},{"id":48,"contenttext":"神道史綱要","xmin":805.0,"ymin":817.0,"xmax":845.0,"ymax":1003.0},{"id":49,"contenttext":"-","xmin":811.0,"ymin":1944.0,"xmax":836.0,"ymax":1970.0},{"id":50,"contenttext":"造化の三","xmin":1108.0,"ymin":472.0,"xmax":1143.0,"ymax":578.0},{"id":51,"contenttext":"神","xmin":1083.0,"ymin":474.0,"xmax":1118.0,"ymax":499.0}]