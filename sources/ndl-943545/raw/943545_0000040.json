[{"id":0,"contenttext":"七〇","xmin":3196.0,"ymin":1967.0,"xmax":3229.0,"ymax":2009.0},{"id":1,"contenttext":"文治郞は備中大谷の人。","xmin":3119.0,"ymin":757.0,"xmax":3177.0,"ymax":1245.0},{"id":2,"contenttext":"人となり至誠、","xmin":3118.0,"ymin":1270.0,"xmax":3168.0,"ymax":1557.0},{"id":3,"contenttext":"年四十二、","xmin":3113.0,"ymin":1595.0,"xmax":3168.0,"ymax":1794.0},{"id":4,"contenttext":"大患を病み、","xmin":3113.0,"ymin":1830.0,"xmax":3164.0,"ymax":2074.0},{"id":5,"contenttext":"專心","xmin":3111.0,"ymin":2108.0,"xmax":3160.0,"ymax":2201.0},{"id":6,"contenttext":"神に祈り、","xmin":3055.0,"ymin":708.0,"xmax":3102.0,"ymax":905.0},{"id":7,"contenttext":"癒ゆるを得たり。","xmin":3051.0,"ymin":943.0,"xmax":3098.0,"ymax":1286.0},{"id":8,"contenttext":"是に於いてか益〓信念を强くし、","xmin":3041.0,"ymin":1317.0,"xmax":3095.0,"ymax":1934.0},{"id":9,"contenttext":"遂に神託を","xmin":3039.0,"ymin":1967.0,"xmax":3090.0,"ymax":2199.0},{"id":10,"contenttext":"受け、","xmin":2982.0,"ymin":708.0,"xmax":3031.0,"ymax":812.0},{"id":11,"contenttext":"天地金乃神を立て、","xmin":2973.0,"ymin":847.0,"xmax":3031.0,"ymax":1235.0},{"id":12,"contenttext":"之れを天地主宰の神とし、","xmin":2965.0,"ymin":1265.0,"xmax":3028.0,"ymax":1793.0},{"id":13,"contenttext":"忠孝彜倫の〓を說","xmin":2965.0,"ymin":1824.0,"xmax":3017.0,"ymax":2197.0},{"id":14,"contenttext":"けり。","xmin":2912.0,"ymin":708.0,"xmax":2951.0,"ymax":812.0},{"id":15,"contenttext":"之れを金光〓と云ふ。","xmin":2897.0,"ymin":847.0,"xmax":2956.0,"ymax":1286.0},{"id":16,"contenttext":"明治十六年十月十日を以つて逝く。","xmin":2890.0,"ymin":1315.0,"xmax":2952.0,"ymax":2030.0},{"id":17,"contenttext":"寛三郞は東洋と號す。","xmin":2828.0,"ymin":751.0,"xmax":2881.0,"ymax":1188.0},{"id":18,"contenttext":"阿波の人、","xmin":2827.0,"ymin":1219.0,"xmax":2876.0,"ymax":1416.0},{"id":19,"contenttext":"後姓名を改め、","xmin":2821.0,"ymin":1452.0,"xmax":2875.0,"ymax":1744.0},{"id":20,"contenttext":"新田邦光と稱す。","xmin":2819.0,"ymin":1779.0,"xmax":2870.0,"ymax":2122.0},{"id":21,"contenttext":"そ","xmin":2827.0,"ymin":2149.0,"xmax":2861.0,"ymax":2193.0},{"id":22,"contenttext":"の說、","xmin":2763.0,"ymin":706.0,"xmax":2812.0,"ymax":809.0},{"id":23,"contenttext":"造化三神を主とし、","xmin":2757.0,"ymin":845.0,"xmax":2811.0,"ymax":1229.0},{"id":24,"contenttext":"伊弉諾伊弉册二神は、","xmin":2752.0,"ymin":1261.0,"xmax":2809.0,"ymax":1694.0},{"id":25,"contenttext":"天神の命を受け、","xmin":2748.0,"ymin":1729.0,"xmax":2805.0,"ymax":2069.0},{"id":26,"contenttext":"國土","xmin":2751.0,"ymin":2100.0,"xmax":2798.0,"ymax":2198.0},{"id":27,"contenttext":"を修理固成せらる。","xmin":2685.0,"ymin":702.0,"xmax":2740.0,"ymax":1094.0},{"id":28,"contenttext":"故に修理固成の神事は、","xmin":2680.0,"ymin":1123.0,"xmax":2738.0,"ymax":1603.0},{"id":29,"contenttext":"人世の最大要義なりとし、","xmin":2677.0,"ymin":1638.0,"xmax":2728.0,"ymax":2158.0},{"id":30,"contenttext":"五倫五常の如き、","xmin":2612.0,"ymin":699.0,"xmax":2670.0,"ymax":1041.0},{"id":31,"contenttext":"皆是れより出づとなせり。","xmin":2612.0,"ymin":1076.0,"xmax":2660.0,"ymax":1602.0},{"id":32,"contenttext":"之れを神道修成派と云ふ。","xmin":2600.0,"ymin":1634.0,"xmax":2659.0,"ymax":2165.0},{"id":33,"contenttext":"此れ等宗〓的神道の民間に勢力を布殖すると同時に、","xmin":2520.0,"ymin":749.0,"xmax":2587.0,"ymax":1831.0},{"id":34,"contenttext":"中流以上の社會","xmin":2520.0,"ymin":1867.0,"xmax":2571.0,"ymax":2191.0},{"id":35,"contenttext":"には、","xmin":2462.0,"ymin":701.0,"xmax":2507.0,"ymax":803.0},{"id":36,"contenttext":"本居、","xmin":2457.0,"ymin":840.0,"xmax":2511.0,"ymax":946.0},{"id":37,"contenttext":"平田一派の神道偉大なる勢力を占め、","xmin":2451.0,"ymin":982.0,"xmax":2507.0,"ymax":1734.0},{"id":38,"contenttext":"明治維新の鴻業と共","xmin":2450.0,"ymin":1771.0,"xmax":2497.0,"ymax":2189.0},{"id":39,"contenttext":"に、","xmin":2393.0,"ymin":700.0,"xmax":2436.0,"ymax":754.0},{"id":40,"contenttext":"神佛習合の弊を打破し、","xmin":2385.0,"ymin":789.0,"xmax":2444.0,"ymax":1272.0},{"id":41,"contenttext":"大いに固有の大道を發揮せり。","xmin":2381.0,"ymin":1305.0,"xmax":2434.0,"ymax":1929.0},{"id":42,"contenttext":"此の時に當","xmin":2380.0,"ymin":1956.0,"xmax":2430.0,"ymax":2187.0},{"id":43,"contenttext":"り、","xmin":2326.0,"ymin":700.0,"xmax":2358.0,"ymax":750.0},{"id":44,"contenttext":"明治天皇は大詔を發せられ、","xmin":2314.0,"ymin":790.0,"xmax":2367.0,"ymax":1360.0},{"id":45,"contenttext":"宣はく、〓","xmin":2313.0,"ymin":1396.0,"xmax":2363.0,"ymax":1580.0},{"id":46,"contenttext":"シ","xmin":2277.0,"ymin":1395.0,"xmax":2307.0,"ymax":1445.0},{"id":47,"contenttext":":","xmin":2279.0,"ymin":1454.0,"xmax":2303.0,"ymax":1498.0},{"id":48,"contenttext":"今也、","xmin":2244.0,"ymin":788.0,"xmax":2292.0,"ymax":895.0},{"id":49,"contenttext":"天運循環、","xmin":2242.0,"ymin":931.0,"xmax":2295.0,"ymax":1126.0},{"id":50,"contenttext":"百度維新、","xmin":2242.0,"ymin":1162.0,"xmax":2290.0,"ymax":1359.0},{"id":51,"contenttext":"宣明治〓以宣揚惟神之大道也。","xmin":2236.0,"ymin":1385.0,"xmax":2289.0,"ymax":2008.0},{"id":52,"contenttext":"川手文次","xmin":3151.0,"ymin":510.0,"xmax":3192.0,"ymax":636.0},{"id":53,"contenttext":"郞","xmin":3125.0,"ymin":510.0,"xmax":3162.0,"ymax":548.0},{"id":54,"contenttext":"竹澤寛三","xmin":2849.0,"ymin":506.0,"xmax":2888.0,"ymax":625.0},{"id":55,"contenttext":"郞","xmin":2824.0,"ymin":506.0,"xmax":2857.0,"ymax":540.0},{"id":56,"contenttext":"明治維新","xmin":2538.0,"ymin":502.0,"xmax":2577.0,"ymax":623.0},{"id":57,"contenttext":"と。","xmin":1841.0,"ymin":761.0,"xmax":1878.0,"ymax":818.0},{"id":58,"contenttext":"と。","xmin":1841.0,"ymin":761.0,"xmax":1878.0,"ymax":818.0},{"id":59,"contenttext":"尋いで〓部省は三箇條の〓則を頒布せり。","xmin":1831.0,"ymin":847.0,"xmax":1880.0,"ymax":1696.0},{"id":60,"contenttext":"曰はく、","xmin":1835.0,"ymin":1734.0,"xmax":1878.0,"ymax":1876.0},{"id":61,"contenttext":"第一條","xmin":1754.0,"ymin":845.0,"xmax":1805.0,"ymax":985.0},{"id":62,"contenttext":"敬神愛國の旨を體すべき事。","xmin":1751.0,"ymin":1031.0,"xmax":1803.0,"ymax":1604.0},{"id":63,"contenttext":"第二條","xmin":1676.0,"ymin":846.0,"xmax":1732.0,"ymax":988.0},{"id":64,"contenttext":"天理人道を明にすべき事。","xmin":1676.0,"ymin":1033.0,"xmax":1727.0,"ymax":1555.0},{"id":65,"contenttext":"第三條","xmin":1602.0,"ymin":846.0,"xmax":1657.0,"ymax":986.0},{"id":66,"contenttext":"皇上を奉體し朝旨を遵守すべき事。","xmin":1602.0,"ymin":1031.0,"xmax":1651.0,"ymax":1739.0},{"id":67,"contenttext":"是れ也。","xmin":1529.0,"ymin":755.0,"xmax":1578.0,"ymax":912.0},{"id":68,"contenttext":"當時事皆未だ緒にかず、","xmin":1525.0,"ymin":939.0,"xmax":1576.0,"ymax":1414.0},{"id":69,"contenttext":"制度種々に變遷せしが、","xmin":1525.0,"ymin":1452.0,"xmax":1576.0,"ymax":1925.0},{"id":70,"contenttext":"明治十五年に","xmin":1527.0,"ymin":1961.0,"xmax":1578.0,"ymax":2236.0},{"id":71,"contenttext":"至り、","xmin":1455.0,"ymin":757.0,"xmax":1498.0,"ymax":858.0},{"id":72,"contenttext":"神官、","xmin":1447.0,"ymin":891.0,"xmax":1504.0,"ymax":999.0},{"id":73,"contenttext":"〓導職の兼務を禁ぜしかば、","xmin":1449.0,"ymin":1033.0,"xmax":1502.0,"ymax":1600.0},{"id":74,"contenttext":"從來の宗〓的傾向を有したる","xmin":1447.0,"ymin":1634.0,"xmax":1500.0,"ymax":2232.0},{"id":75,"contenttext":"〓派は、","xmin":1380.0,"ymin":755.0,"xmax":1429.0,"ymax":903.0},{"id":76,"contenttext":"玆に各〓〓派派立固有の大道に基いて宗〓界に雄飛せんとするに","xmin":1373.0,"ymin":939.0,"xmax":1427.0,"ymax":2232.0},{"id":77,"contenttext":"至れり。","xmin":1308.0,"ymin":757.0,"xmax":1355.0,"ymax":907.0},{"id":78,"contenttext":"即ち伊勢にありては、","xmin":1306.0,"ymin":941.0,"xmax":1353.0,"ymax":1367.0},{"id":79,"contenttext":"大宮司田中賴庸本官を辭し、","xmin":1302.0,"ymin":1405.0,"xmax":1355.0,"ymax":1972.0},{"id":80,"contenttext":"神宮〓の管","xmin":1304.0,"ymin":2004.0,"xmax":1355.0,"ymax":2236.0},{"id":81,"contenttext":"長となり出雲大社を中心とする大社〓亦獨立せり。","xmin":1230.0,"ymin":753.0,"xmax":1282.0,"ymax":1792.0},{"id":82,"contenttext":"而して黑住〓は已に","xmin":1232.0,"ymin":1820.0,"xmax":1279.0,"ymax":2232.0},{"id":83,"contenttext":"明治九年に獨立せしが、","xmin":1160.0,"ymin":755.0,"xmax":1214.0,"ymax":1226.0},{"id":84,"contenttext":"吾人の已に述べたる長谷川角行の創唱せる富士","xmin":1157.0,"ymin":1264.0,"xmax":1211.0,"ymax":2232.0},{"id":85,"contenttext":"講は、","xmin":1087.0,"ymin":751.0,"xmax":1134.0,"ymax":855.0},{"id":86,"contenttext":"明治の世となり、","xmin":1087.0,"ymin":892.0,"xmax":1134.0,"ymax":1226.0},{"id":87,"contenttext":"二派となり、","xmin":1085.0,"ymin":1262.0,"xmax":1132.0,"ymax":1502.0},{"id":88,"contenttext":"一は實行〓となり、","xmin":1085.0,"ymin":1550.0,"xmax":1134.0,"ymax":1919.0},{"id":89,"contenttext":"一は扶桑〓と","xmin":1087.0,"ymin":1967.0,"xmax":1136.0,"ymax":2230.0},{"id":90,"contenttext":"なれり。","xmin":1018.0,"ymin":755.0,"xmax":1063.0,"ymax":905.0},{"id":91,"contenttext":"別に平山省齋は大成〓を起し、","xmin":1012.0,"ymin":939.0,"xmax":1061.0,"ymax":1549.0},{"id":92,"contenttext":"芳村正秉は神習〓を立し、","xmin":1010.0,"ymin":1585.0,"xmax":1064.0,"ymax":2107.0},{"id":93,"contenttext":"下山","xmin":1018.0,"ymin":2141.0,"xmax":1063.0,"ymax":2232.0},{"id":94,"contenttext":"應助の唱へたる御嶽神社を信仰の中心とせる御嶽〓は、","xmin":939.0,"ymin":751.0,"xmax":990.0,"ymax":1872.0},{"id":95,"contenttext":"もと大成〓に屬","xmin":941.0,"ymin":1912.0,"xmax":989.0,"ymax":2232.0},{"id":96,"contenttext":"神道史綱要","xmin":879.0,"ymin":892.0,"xmax":918.0,"ymax":1095.0},{"id":97,"contenttext":"と〓","xmin":883.0,"ymin":2020.0,"xmax":913.0,"ymax":2054.0},{"id":98,"contenttext":"曰はく、","xmin":1835.0,"ymin":1734.0,"xmax":1878.0,"ymax":1876.0}]