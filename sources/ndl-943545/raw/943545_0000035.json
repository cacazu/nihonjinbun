[{"id":0,"contenttext":"층","xmin":3168.0,"ymin":1955.0,"xmax":3201.0,"ymax":1995.0},{"id":1,"contenttext":"玆に聊かその學說の一斑を","xmin":3081.0,"ymin":1625.0,"xmax":3142.0,"ymax":2185.0},{"id":2,"contenttext":"吾人他日之れを世に紹介せんと欲すと雖も、","xmin":3090.0,"ymin":701.0,"xmax":3159.0,"ymax":1596.0},{"id":3,"contenttext":"玆に聊かその學說の一斑を","xmin":3081.0,"ymin":1625.0,"xmax":3142.0,"ymax":2185.0},{"id":4,"contenttext":"示すべし。","xmin":3033.0,"ymin":702.0,"xmax":3080.0,"ymax":903.0},{"id":5,"contenttext":"彼れは大道を說き曰はく、","xmin":2947.0,"ymin":744.0,"xmax":3007.0,"ymax":1270.0},{"id":6,"contenttext":"祭を嚴にし政を正しくし、","xmin":2874.0,"ymin":793.0,"xmax":2933.0,"ymax":1319.0},{"id":7,"contenttext":"天下を整給ふ事はしも、","xmin":2867.0,"ymin":1347.0,"xmax":2924.0,"ymax":1828.0},{"id":8,"contenttext":"皇祖天神より、","xmin":2865.0,"ymin":1859.0,"xmax":2913.0,"ymax":2150.0},{"id":9,"contenttext":"皇御孫命に附與し奉給ふ天統高御座の御職にして、","xmin":2794.0,"ymin":742.0,"xmax":2862.0,"ymax":1779.0},{"id":10,"contenttext":"此餘に道なく、","xmin":2794.0,"ymin":1810.0,"xmax":2841.0,"ymax":2101.0},{"id":11,"contenttext":"此","xmin":2790.0,"ymin":2133.0,"xmax":2837.0,"ymax":2179.0},{"id":12,"contenttext":"餘に〓無く、","xmin":2737.0,"ymin":743.0,"xmax":2786.0,"ymax":987.0},{"id":13,"contenttext":"實に隨在天神の大道此なり。","xmin":2722.0,"ymin":1018.0,"xmax":2785.0,"ymax":1595.0},{"id":14,"contenttext":"(祝詞講義)","xmin":2717.0,"ymin":1608.0,"xmax":2779.0,"ymax":1824.0},{"id":15,"contenttext":"と。","xmin":2675.0,"ymin":700.0,"xmax":2706.0,"ymax":752.0},{"id":16,"contenttext":"以つて儒佛の如きは、","xmin":2657.0,"ymin":785.0,"xmax":2713.0,"ymax":1218.0},{"id":17,"contenttext":"私道私〓にして何人も眞に之れを實行する能","xmin":2639.0,"ymin":1251.0,"xmax":2706.0,"ymax":2173.0},{"id":18,"contenttext":"はざる道なるも、","xmin":2594.0,"ymin":694.0,"xmax":2638.0,"ymax":1032.0},{"id":19,"contenttext":"此の大道は如何なるものも能く行ひ得、","xmin":2573.0,"ymin":1063.0,"xmax":2635.0,"ymax":1865.0},{"id":20,"contenttext":"又行はざるべ","xmin":2571.0,"ymin":1896.0,"xmax":2620.0,"ymax":2166.0},{"id":21,"contenttext":"からざる道なりとし、","xmin":2517.0,"ymin":694.0,"xmax":2567.0,"ymax":1124.0},{"id":22,"contenttext":"進んでその大道を、","xmin":2503.0,"ymin":1155.0,"xmax":2560.0,"ymax":1541.0},{"id":23,"contenttext":"皇祖天神の御規則に因て、","xmin":2437.0,"ymin":783.0,"xmax":2495.0,"ymax":1309.0},{"id":24,"contenttext":"須臾も離るまじき道なるが、","xmin":2430.0,"ymin":1339.0,"xmax":2486.0,"ymax":1910.0},{"id":25,"contenttext":"君君たり、","xmin":2426.0,"ymin":1943.0,"xmax":2471.0,"ymax":2142.0},{"id":26,"contenttext":"臣臣たり、","xmin":2379.0,"ymin":737.0,"xmax":2422.0,"ymax":934.0},{"id":27,"contenttext":"父父たり、","xmin":2373.0,"ymin":968.0,"xmax":2421.0,"ymax":1169.0},{"id":28,"contenttext":"子子たる當然の道を云ふなり。","xmin":2359.0,"ymin":1198.0,"xmax":2422.0,"ymax":1817.0},{"id":29,"contenttext":"孝德天皇御「紀」に、","xmin":2354.0,"ymin":1838.0,"xmax":2412.0,"ymax":2181.0},{"id":30,"contenttext":"惟神者謂隨神道亦自有神道也と有る如く、","xmin":2290.0,"ymin":732.0,"xmax":2356.0,"ymax":1585.0},{"id":31,"contenttext":"皇祖天神の御規則即天下公","xmin":2276.0,"ymin":1617.0,"xmax":2342.0,"ymax":2171.0},{"id":32,"contenttext":"正の大道にして、","xmin":2226.0,"ymin":735.0,"xmax":2276.0,"ymax":1075.0},{"id":33,"contenttext":"隨神道とは此に因准するを云ふなり。","xmin":2207.0,"ymin":1102.0,"xmax":2273.0,"ymax":1864.0},{"id":34,"contenttext":"(同上)","xmin":2206.0,"ymin":1880.0,"xmax":2260.0,"ymax":1998.0},{"id":35,"contenttext":"重胤の學","xmin":2970.0,"ymin":502.0,"xmax":3010.0,"ymax":621.0},{"id":36,"contenttext":"說","xmin":2949.0,"ymin":502.0,"xmax":2982.0,"ymax":535.0},{"id":37,"contenttext":"と說明し、","xmin":1815.0,"ymin":697.0,"xmax":1869.0,"ymax":902.0},{"id":38,"contenttext":"而して之れを更に詳に說明して曰はく、","xmin":1818.0,"ymin":932.0,"xmax":1882.0,"ymax":1740.0},{"id":39,"contenttext":"天皇と在しては皇祖天神の授給ふ御事の依隨に、","xmin":1741.0,"ymin":791.0,"xmax":1812.0,"ymax":1791.0},{"id":40,"contenttext":"天社國社の皇神等","xmin":1758.0,"ymin":1819.0,"xmax":1817.0,"ymax":2194.0},{"id":41,"contenttext":"を齋祀らせ給ひて、","xmin":1666.0,"ymin":747.0,"xmax":1719.0,"ymax":1141.0},{"id":42,"contenttext":"天下公民を撫給ひ重給ひて萬國を經綸給ふを以て","xmin":1671.0,"ymin":1170.0,"xmax":1736.0,"ymax":2189.0},{"id":43,"contenttext":"隨在天神の御行業と申奉るべく、","xmin":1592.0,"ymin":746.0,"xmax":1654.0,"ymax":1419.0},{"id":44,"contenttext":"臣下と有ては天皇の行はせ給ふ御行","xmin":1603.0,"ymin":1450.0,"xmax":1662.0,"ymax":2193.0},{"id":45,"contenttext":"業に違奉らず、","xmin":1519.0,"ymin":749.0,"xmax":1572.0,"ymax":1047.0},{"id":46,"contenttext":"淨く明き心を以て仕奉り、","xmin":1523.0,"ymin":1078.0,"xmax":1581.0,"ymax":1606.0},{"id":47,"contenttext":"大御政を輔相ひ輔佐け仕奉","xmin":1530.0,"ymin":1637.0,"xmax":1593.0,"ymax":2196.0},{"id":48,"contenttext":"+","xmin":1490.0,"ymin":986.0,"xmax":1512.0,"ymax":1013.0},{"id":49,"contenttext":"て、","xmin":1451.0,"ymin":753.0,"xmax":1492.0,"ymax":812.0},{"id":50,"contenttext":"天下を安泰からしむべく、","xmin":1447.0,"ymin":843.0,"xmax":1501.0,"ymax":1374.0},{"id":51,"contenttext":"又大御世を無窮に傳させ給ふ中には、","xmin":1454.0,"ymin":1405.0,"xmax":1517.0,"ymax":2167.0},{"id":52,"contenttext":"邂逅に神代の御規則に背はせ給ふ事も絕て無しとは申可らず。","xmin":1375.0,"ymin":751.0,"xmax":1442.0,"ymax":2028.0},{"id":53,"contenttext":"然もあ","xmin":1396.0,"ymin":2059.0,"xmax":1441.0,"ymax":2195.0},{"id":54,"contenttext":"らば臣の臣たる道を以て諫奏奉りて、","xmin":1308.0,"ymin":753.0,"xmax":1367.0,"ymax":1519.0},{"id":55,"contenttext":"君をして君たらしむるぞ臣下た","xmin":1317.0,"ymin":1550.0,"xmax":1376.0,"ymax":2198.0},{"id":56,"contenttext":"る人の隨在天神なる美德と云可く、","xmin":1232.0,"ymin":757.0,"xmax":1295.0,"ymax":1472.0},{"id":57,"contenttext":"公民としては左にも右にも上の御","xmin":1244.0,"ymin":1503.0,"xmax":1303.0,"ymax":2199.0},{"id":58,"contenttext":"趣けに因准ひ奉り、","xmin":1158.0,"ymin":755.0,"xmax":1212.0,"ymax":1147.0},{"id":59,"contenttext":"各も各も神賦の家業を守りて、","xmin":1164.0,"ymin":1178.0,"xmax":1224.0,"ymax":1800.0},{"id":60,"contenttext":"衣食住の資となし、","xmin":1175.0,"ymin":1832.0,"xmax":1228.0,"ymax":2208.0},{"id":61,"contenttext":"身を修め、","xmin":1084.0,"ymin":756.0,"xmax":1137.0,"ymax":963.0},{"id":62,"contenttext":"德を行ひ、","xmin":1089.0,"ymin":992.0,"xmax":1140.0,"ymax":1200.0},{"id":63,"contenttext":"世の爲、","xmin":1093.0,"ymin":1227.0,"xmax":1144.0,"ymax":1392.0},{"id":64,"contenttext":"人の爲に功德を建て相助け相救ひ、","xmin":1092.0,"ymin":1413.0,"xmax":1159.0,"ymax":2132.0},{"id":65,"contenttext":"己","xmin":1110.0,"ymin":2161.0,"xmax":1148.0,"ymax":2203.0},{"id":66,"contenttext":"じ","xmin":1057.0,"ymin":902.0,"xmax":1079.0,"ymax":946.0},{"id":67,"contenttext":"を棄、","xmin":1014.0,"ymin":761.0,"xmax":1065.0,"ymax":871.0},{"id":68,"contenttext":"佗を起し、","xmin":1015.0,"ymin":902.0,"xmax":1067.0,"ymax":1104.0},{"id":69,"contenttext":"隨在天神の大御政の少しも安からむことを須臾も忘","xmin":1015.0,"ymin":1135.0,"xmax":1084.0,"ymax":2204.0},{"id":70,"contenttext":"るべからず。","xmin":946.0,"ymin":765.0,"xmax":988.0,"ymax":1012.0},{"id":71,"contenttext":"如此く爲る時は父子親愛有り夫婦愛敬ありて人道の極み、","xmin":941.0,"ymin":1043.0,"xmax":1011.0,"ymax":2212.0},{"id":72,"contenttext":"神道史綱要","xmin":880.0,"ymin":830.0,"xmax":923.0,"ymax":1041.0},{"id":73,"contenttext":"츠","xmin":896.0,"ymin":1986.0,"xmax":932.0,"ymax":2022.0}]