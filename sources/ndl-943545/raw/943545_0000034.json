[{"id":0,"contenttext":"天","xmin":3154.0,"ymin":1961.0,"xmax":3192.0,"ymax":2005.0},{"id":1,"contenttext":"の大本を神代にたゞし","xmin":3082.0,"ymin":759.0,"xmax":3129.0,"ymax":1216.0},{"id":2,"contenttext":"てあればなり","xmin":3071.0,"ymin":1222.0,"xmax":3117.0,"ymax":1501.0},{"id":3,"contenttext":"この故に皇統連綿として萬世か","xmin":3055.0,"ymin":1549.0,"xmax":3117.0,"ymax":2190.0},{"id":4,"contenttext":"はり給はず、","xmin":3006.0,"ymin":757.0,"xmax":3054.0,"ymax":999.0},{"id":5,"contenttext":"別に大政府ありて、","xmin":3002.0,"ymin":1033.0,"xmax":3047.0,"ymax":1418.0},{"id":6,"contenttext":"お","xmin":3002.0,"ymin":1458.0,"xmax":3033.0,"ymax":1492.0},{"id":7,"contenttext":"づから大帝爵の國體をあらはし、","xmin":2983.0,"ymin":1546.0,"xmax":3040.0,"ymax":2200.0},{"id":8,"contenttext":"遂には萬國をしたがへつ","xmin":2931.0,"ymin":753.0,"xmax":2980.0,"ymax":1259.0},{"id":9,"contenttext":"べき芽を含めり。","xmin":2924.0,"ymin":1265.0,"xmax":2970.0,"ymax":1591.0},{"id":10,"contenttext":"かくの如く大本かたく中道","xmin":2912.0,"ymin":1635.0,"xmax":2968.0,"ymax":2190.0},{"id":11,"contenttext":"正しきにより、","xmin":2863.0,"ymin":753.0,"xmax":2914.0,"ymax":1043.0},{"id":12,"contenttext":"古へより支那の如き賊亂もなく、","xmin":2843.0,"ymin":1073.0,"xmax":2909.0,"ymax":1740.0},{"id":13,"contenttext":"異言の人に國を奪れ","xmin":2834.0,"ymin":1770.0,"xmax":2895.0,"ymax":2188.0},{"id":14,"contenttext":"す。","xmin":2794.0,"ymin":751.0,"xmax":2841.0,"ymax":813.0},{"id":15,"contenttext":"同言の人も亦皇位を奪ふことを得ず。","xmin":2770.0,"ymin":840.0,"xmax":2838.0,"ymax":1603.0},{"id":16,"contenttext":"(古傳通解)","xmin":2769.0,"ymin":1620.0,"xmax":2822.0,"ymax":1831.0},{"id":17,"contenttext":"と。","xmin":2726.0,"ymin":704.0,"xmax":2757.0,"ymax":760.0},{"id":18,"contenttext":"此の說誠に篤胤のそれを紹述せるものにして、","xmin":2693.0,"ymin":793.0,"xmax":2764.0,"ymax":1736.0},{"id":19,"contenttext":"能く神道の眞意を發","xmin":2685.0,"ymin":1764.0,"xmax":2745.0,"ymax":2184.0},{"id":20,"contenttext":"揮せり。","xmin":2645.0,"ymin":700.0,"xmax":2690.0,"ymax":855.0},{"id":21,"contenttext":"此の如くにして彼れは遂に一家を成せり。","xmin":2618.0,"ymin":885.0,"xmax":2687.0,"ymax":1736.0},{"id":22,"contenttext":"想ふに篤胤の神道說巳に蘭學に依れる所尠からざりしと雖も、","xmin":2543.0,"ymin":744.0,"xmax":2618.0,"ymax":2010.0},{"id":23,"contenttext":"隆正は","xmin":2540.0,"ymin":2043.0,"xmax":2589.0,"ymax":2181.0},{"id":24,"contenttext":"更に甚しく之れを取りてその說を構成し、","xmin":2482.0,"ymin":695.0,"xmax":2547.0,"ymax":1546.0},{"id":25,"contenttext":"遂に蘭學習合の評を蒙るに至","xmin":2467.0,"ymin":1576.0,"xmax":2529.0,"ymax":2177.0},{"id":26,"contenttext":"れり。","xmin":2430.0,"ymin":696.0,"xmax":2477.0,"ymax":798.0},{"id":27,"contenttext":"蘭學を取り來る素より不可なしと雖も、","xmin":2407.0,"ymin":830.0,"xmax":2476.0,"ymax":1637.0},{"id":28,"contenttext":"その消化の十分ならざり","xmin":2389.0,"ymin":1668.0,"xmax":2459.0,"ymax":2176.0},{"id":29,"contenttext":"しは彼れの說の缺點なりとす。","xmin":2336.0,"ymin":693.0,"xmax":2405.0,"ymax":1317.0},{"id":30,"contenttext":"隆正巳にその神道の精神を以つて〓育に從事す。","xmin":2252.0,"ymin":736.0,"xmax":2327.0,"ymax":1730.0},{"id":31,"contenttext":"門下爲に英才を出せ","xmin":2240.0,"ymin":1756.0,"xmax":2304.0,"ymax":2176.0},{"id":32,"contenttext":"bo","xmin":2213.0,"ymin":694.0,"xmax":2244.0,"ymax":748.0},{"id":33,"contenttext":"就中その出藍の器を鈴木重胤及び福羽美靜となす。","xmin":2176.0,"ymin":781.0,"xmax":2250.0,"ymax":1822.0},{"id":34,"contenttext":"此の二人後共に、","xmin":2168.0,"ymin":1848.0,"xmax":2225.0,"ymax":2202.0},{"id":35,"contenttext":"蘭學習合","xmin":2502.0,"ymin":501.0,"xmax":2541.0,"ymax":620.0},{"id":36,"contenttext":"平田門に學び、","xmin":1816.0,"ymin":684.0,"xmax":1871.0,"ymax":981.0},{"id":37,"contenttext":"前者は偉大なる學者となり、","xmin":1816.0,"ymin":1009.0,"xmax":1871.0,"ymax":1581.0},{"id":38,"contenttext":"後者は有力なる實際家とな","xmin":1819.0,"ymin":1609.0,"xmax":1872.0,"ymax":2164.0},{"id":39,"contenttext":"れり。","xmin":1747.0,"ymin":688.0,"xmax":1791.0,"ymax":789.0},{"id":40,"contenttext":"重胤は、","xmin":1672.0,"ymin":733.0,"xmax":1721.0,"ymax":887.0},{"id":41,"contenttext":"淡路の人。","xmin":1672.0,"ymin":917.0,"xmax":1723.0,"ymax":1122.0},{"id":42,"contenttext":"幼名雄三郞、","xmin":1672.0,"ymin":1148.0,"xmax":1723.0,"ymax":1398.0},{"id":43,"contenttext":"後勝右衞門と云ひ、","xmin":1672.0,"ymin":1428.0,"xmax":1723.0,"ymax":1815.0},{"id":44,"contenttext":"或は府生と云ふ。","xmin":1671.0,"ymin":1846.0,"xmax":1724.0,"ymax":2177.0},{"id":45,"contenttext":"橿通家と號す。","xmin":1602.0,"ymin":686.0,"xmax":1651.0,"ymax":980.0},{"id":46,"contenttext":"文化九年を以つて生る。","xmin":1602.0,"ymin":1011.0,"xmax":1653.0,"ymax":1490.0},{"id":47,"contenttext":"夙に學を好み、","xmin":1602.0,"ymin":1520.0,"xmax":1653.0,"ymax":1815.0},{"id":48,"contenttext":"隆正の門に入り、","xmin":1604.0,"ymin":1845.0,"xmax":1650.0,"ymax":2173.0},{"id":49,"contenttext":"その業を授かれり。","xmin":1526.0,"ymin":685.0,"xmax":1579.0,"ymax":1071.0},{"id":50,"contenttext":"後江戶に遊學し篤胤の學を慕ひその門に入らんとせ","xmin":1527.0,"ymin":1103.0,"xmax":1578.0,"ymax":2164.0},{"id":51,"contenttext":"しも未だ果ざりき。","xmin":1455.0,"ymin":686.0,"xmax":1504.0,"ymax":1072.0},{"id":52,"contenttext":"已にして遂に意を決し秋田に赴き、","xmin":1453.0,"ymin":1105.0,"xmax":1507.0,"ymax":1815.0},{"id":53,"contenttext":"其の〓を請はん","xmin":1457.0,"ymin":1845.0,"xmax":1504.0,"ymax":2166.0},{"id":54,"contenttext":"とせり。","xmin":1386.0,"ymin":690.0,"xmax":1424.0,"ymax":836.0},{"id":55,"contenttext":"偶、篤胤歿せしかば直に墓前にて歿後の門人となりぬ。","xmin":1384.0,"ymin":872.0,"xmax":1433.0,"ymax":1950.0},{"id":56,"contenttext":"巳に平田","xmin":1383.0,"ymin":1987.0,"xmax":1434.0,"ymax":2167.0},{"id":57,"contenttext":"門に入り攻學研鑚、","xmin":1308.0,"ymin":686.0,"xmax":1361.0,"ymax":1075.0},{"id":58,"contenttext":"才氣縱橫、","xmin":1308.0,"ymin":1105.0,"xmax":1358.0,"ymax":1308.0},{"id":59,"contenttext":"嶄然として頭角を見はせり。","xmin":1306.0,"ymin":1336.0,"xmax":1357.0,"ymax":1905.0},{"id":60,"contenttext":"而して彼れ","xmin":1308.0,"ymin":1939.0,"xmax":1357.0,"ymax":2166.0},{"id":61,"contenttext":"性、","xmin":1232.0,"ymin":684.0,"xmax":1283.0,"ymax":750.0},{"id":62,"contenttext":"豪放不覊小節を願みず。","xmin":1232.0,"ymin":780.0,"xmax":1286.0,"ymax":1261.0},{"id":63,"contenttext":"盛に他を誹謗し、","xmin":1232.0,"ymin":1291.0,"xmax":1286.0,"ymax":1631.0},{"id":64,"contenttext":"その師と雖も憚らず。","xmin":1231.0,"ymin":1662.0,"xmax":1285.0,"ymax":2094.0},{"id":65,"contenttext":"爲","xmin":1236.0,"ymin":2122.0,"xmax":1283.0,"ymax":2170.0},{"id":66,"contenttext":"に平田門を除かれ、","xmin":1161.0,"ymin":692.0,"xmax":1212.0,"ymax":1077.0},{"id":67,"contenttext":"後遂に奇禍を買ひ、","xmin":1158.0,"ymin":1104.0,"xmax":1214.0,"ymax":1495.0},{"id":68,"contenttext":"文久三年八月十五日刺客の爲に","xmin":1159.0,"ymin":1524.0,"xmax":1212.0,"ymax":2168.0},{"id":69,"contenttext":"斃れぬ。","xmin":1087.0,"ymin":688.0,"xmax":1138.0,"ymax":838.0},{"id":70,"contenttext":"年五十二。著はす所、","xmin":1087.0,"ymin":851.0,"xmax":1138.0,"ymax":1271.0},{"id":71,"contenttext":"「日本書紀傳」百四十四卷、","xmin":1087.0,"ymin":1291.0,"xmax":1138.0,"ymax":1782.0},{"id":72,"contenttext":"「祝祠講義」三十卷、","xmin":1087.0,"ymin":1789.0,"xmax":1138.0,"ymax":2140.0},{"id":73,"contenttext":"「經緯歌」一卷、","xmin":1016.0,"ymin":686.0,"xmax":1065.0,"ymax":937.0},{"id":74,"contenttext":"「世繼草」三卷、","xmin":1016.0,"ymin":953.0,"xmax":1067.0,"ymax":1218.0},{"id":75,"contenttext":"「開闢圖」一卷等あり。","xmin":1014.0,"ymin":1235.0,"xmax":1063.0,"ymax":1631.0},{"id":76,"contenttext":"殊に「日本書紀傳」及び「祝祠","xmin":1014.0,"ymin":1665.0,"xmax":1067.0,"ymax":2173.0},{"id":77,"contenttext":"講義」は、","xmin":946.0,"ymin":690.0,"xmax":993.0,"ymax":844.0},{"id":78,"contenttext":"頗る浩瀚なるものにして、","xmin":943.0,"ymin":874.0,"xmax":994.0,"ymax":1402.0},{"id":79,"contenttext":"學者の參考に資すべきもの尠からず、","xmin":944.0,"ymin":1434.0,"xmax":993.0,"ymax":2179.0},{"id":80,"contenttext":"五九","xmin":873.0,"ymin":1924.0,"xmax":903.0,"ymax":1962.0},{"id":81,"contenttext":"神道史綱要","xmin":862.0,"ymin":796.0,"xmax":903.0,"ymax":1001.0},{"id":82,"contenttext":"前者は偉大なる學者となり、","xmin":1816.0,"ymin":1009.0,"xmax":1871.0,"ymax":1581.0},{"id":83,"contenttext":"後者は有力なる實際家とな","xmin":1819.0,"ymin":1609.0,"xmax":1872.0,"ymax":2164.0},{"id":84,"contenttext":"鈴木重胤","xmin":1680.0,"ymin":487.0,"xmax":1719.0,"ymax":607.0},{"id":85,"contenttext":"五九","xmin":873.0,"ymin":1924.0,"xmax":903.0,"ymax":1962.0}]