[{"id":0,"contenttext":"삣","xmin":3160.0,"ymin":1972.0,"xmax":3195.0,"ymax":2018.0},{"id":1,"contenttext":"申したる云云。","xmin":3107.0,"ymin":767.0,"xmax":3161.0,"ymax":1066.0},{"id":2,"contenttext":"(俗神道大意)","xmin":3095.0,"ymin":1084.0,"xmax":3152.0,"ymax":1339.0},{"id":3,"contenttext":"と說き、","xmin":3039.0,"ymin":716.0,"xmax":3088.0,"ymax":871.0},{"id":4,"contenttext":"尙、","xmin":3035.0,"ymin":902.0,"xmax":3082.0,"ymax":964.0},{"id":5,"contenttext":"自家の神道を古道と云ひ、","xmin":3016.0,"ymin":996.0,"xmax":3078.0,"ymax":1521.0},{"id":6,"contenttext":"抑も古道と申候は、","xmin":2952.0,"ymin":805.0,"xmax":3015.0,"ymax":1197.0},{"id":7,"contenttext":"何の事もなく古の道と申すことにて、","xmin":2930.0,"ymin":1229.0,"xmax":2999.0,"ymax":1987.0},{"id":8,"contenttext":"其は天皇","xmin":2923.0,"ymin":2017.0,"xmax":2979.0,"ymax":2200.0},{"id":9,"contenttext":"祖神のこの天地を御造りなされ候を始め、","xmin":2867.0,"ymin":756.0,"xmax":2940.0,"ymax":1616.0},{"id":10,"contenttext":"上代の事實の上に備はり候。","xmin":2847.0,"ymin":1644.0,"xmax":2917.0,"ymax":2210.0},{"id":11,"contenttext":"眞の道を聊も外國風の說を混へず、","xmin":2796.0,"ymin":754.0,"xmax":2869.0,"ymax":1475.0},{"id":12,"contenttext":"純粹なる古意古言を以つて、","xmin":2776.0,"ymin":1501.0,"xmax":2844.0,"ymax":2075.0},{"id":13,"contenttext":"すな","xmin":2776.0,"ymin":2104.0,"xmax":2822.0,"ymax":2196.0},{"id":14,"contenttext":"ほに說明し、","xmin":2739.0,"ymin":754.0,"xmax":2791.0,"ymax":1008.0},{"id":15,"contenttext":"その事實の上にて、","xmin":2719.0,"ymin":1034.0,"xmax":2788.0,"ymax":1428.0},{"id":16,"contenttext":"天皇命の天下を治め給ふ御政の本を","xmin":2698.0,"ymin":1454.0,"xmax":2775.0,"ymax":2196.0},{"id":17,"contenttext":"も、","xmin":2679.0,"ymin":756.0,"xmax":2710.0,"ymax":810.0},{"id":18,"contenttext":"人道の本をも知り候學問故、","xmin":2649.0,"ymin":844.0,"xmax":2718.0,"ymax":1424.0},{"id":19,"contenttext":"古學と申し、","xmin":2639.0,"ymin":1452.0,"xmax":2699.0,"ymax":1700.0},{"id":20,"contenttext":"その道をさして古道と","xmin":2628.0,"ymin":1730.0,"xmax":2690.0,"ymax":2190.0},{"id":21,"contenttext":"は申候事に候。","xmin":2588.0,"ymin":750.0,"xmax":2642.0,"ymax":1047.0},{"id":22,"contenttext":"(入學問答)","xmin":2582.0,"ymin":1066.0,"xmax":2638.0,"ymax":1276.0},{"id":23,"contenttext":"と說けり。","xmin":2526.0,"ymin":704.0,"xmax":2571.0,"ymax":898.0},{"id":24,"contenttext":"彼れが此れ等の言の示すが如く、","xmin":2497.0,"ymin":927.0,"xmax":2568.0,"ymax":1603.0},{"id":25,"contenttext":"彼れの神道說は、","xmin":2487.0,"ymin":1631.0,"xmax":2550.0,"ymax":1975.0},{"id":26,"contenttext":"徹頭徹尾","xmin":2483.0,"ymin":2002.0,"xmax":2537.0,"ymax":2191.0},{"id":27,"contenttext":"宣長のそれの紹述也。","xmin":2437.0,"ymin":698.0,"xmax":2500.0,"ymax":1147.0},{"id":28,"contenttext":"敷衍也。","xmin":2430.0,"ymin":1164.0,"xmax":2487.0,"ymax":1324.0},{"id":29,"contenttext":"要するに篤胤の學說は、","xmin":2360.0,"ymin":745.0,"xmax":2425.0,"ymax":1233.0},{"id":30,"contenttext":"高天原及び夜見國を說くの點に於いて、","xmin":2331.0,"ymin":1257.0,"xmax":2411.0,"ymax":2067.0},{"id":31,"contenttext":"幽冥","xmin":2332.0,"ymin":2093.0,"xmax":2383.0,"ymax":2187.0},{"id":32,"contenttext":"を云ひ、","xmin":2297.0,"ymin":694.0,"xmax":2348.0,"ymax":854.0},{"id":33,"contenttext":"未來を論じ、","xmin":2289.0,"ymin":884.0,"xmax":2344.0,"ymax":1137.0},{"id":34,"contenttext":"復古神道に大いに宗〓的色釆を與へしの點に於い","xmin":2255.0,"ymin":1164.0,"xmax":2338.0,"ymax":2184.0},{"id":35,"contenttext":"て、","xmin":2232.0,"ymin":696.0,"xmax":2273.0,"ymax":756.0},{"id":36,"contenttext":"深く佛〓を研究し、","xmin":2211.0,"ymin":783.0,"xmax":2278.0,"ymax":1179.0},{"id":37,"contenttext":"盛に破佛論を唱へしの點に於いて、","xmin":2190.0,"ymin":1207.0,"xmax":2265.0,"ymax":1922.0},{"id":38,"contenttext":"熱心に諸子","xmin":2181.0,"ymin":1948.0,"xmax":2241.0,"ymax":2184.0},{"id":39,"contenttext":"彼れの神道說は、","xmin":2487.0,"ymin":1631.0,"xmax":2550.0,"ymax":1975.0},{"id":40,"contenttext":"徹頭徹尾","xmin":2483.0,"ymin":2002.0,"xmax":2537.0,"ymax":2191.0},{"id":41,"contenttext":"百家を研究し、","xmin":1813.0,"ymin":696.0,"xmax":1860.0,"ymax":987.0},{"id":42,"contenttext":"殊に玄道を取り來りて、","xmin":1813.0,"ymin":1023.0,"xmax":1860.0,"ymax":1496.0},{"id":43,"contenttext":"自家の學說構成の用に供せしの","xmin":1813.0,"ymin":1535.0,"xmax":1862.0,"ymax":2175.0},{"id":44,"contenttext":"點に於いて、","xmin":1735.0,"ymin":698.0,"xmax":1787.0,"ymax":943.0},{"id":45,"contenttext":"その他種々の點に於いて、","xmin":1735.0,"ymin":978.0,"xmax":1790.0,"ymax":1500.0},{"id":46,"contenttext":"宣長學の範圍を逸脫して、","xmin":1735.0,"ymin":1533.0,"xmax":1790.0,"ymax":2056.0},{"id":47,"contenttext":"一家","xmin":1739.0,"ymin":2098.0,"xmax":1790.0,"ymax":2181.0},{"id":48,"contenttext":"の見を立せしは吾人の深く注意せざるべからざる所也。","xmin":1660.0,"ymin":700.0,"xmax":1711.0,"ymax":1825.0},{"id":49,"contenttext":"就中篤胤が、","xmin":1662.0,"ymin":1860.0,"xmax":1713.0,"ymax":2101.0},{"id":50,"contenttext":"天","xmin":1662.0,"ymin":2138.0,"xmax":1711.0,"ymax":2181.0},{"id":51,"contenttext":"御中主神を以つて無始無終の神とし、","xmin":1586.0,"ymin":698.0,"xmax":1639.0,"ymax":1453.0},{"id":52,"contenttext":"『古事記』の『成神』を『古史成文』に『有神』","xmin":1588.0,"ymin":1472.0,"xmax":1641.0,"ymax":2185.0},{"id":53,"contenttext":"に改めたるが如き、","xmin":1514.0,"ymin":700.0,"xmax":1561.0,"ymax":1079.0},{"id":54,"contenttext":"然りとなす。","xmin":1514.0,"ymin":1115.0,"xmax":1561.0,"ymax":1359.0},{"id":55,"contenttext":"篤胤の門に、","xmin":1514.0,"ymin":1393.0,"xmax":1561.0,"ymax":1633.0},{"id":56,"contenttext":"養子平田鐵胤、","xmin":1514.0,"ymin":1672.0,"xmax":1566.0,"ymax":1962.0},{"id":57,"contenttext":"生田國秀、","xmin":1514.0,"ymin":1999.0,"xmax":1566.0,"ymax":2183.0},{"id":58,"contenttext":"佐藤信淵、","xmin":1443.0,"ymin":698.0,"xmax":1492.0,"ymax":892.0},{"id":59,"contenttext":"大國隆正、","xmin":1443.0,"ymin":931.0,"xmax":1492.0,"ymax":1128.0},{"id":60,"contenttext":"六人部是香、","xmin":1441.0,"ymin":1167.0,"xmax":1494.0,"ymax":1407.0},{"id":61,"contenttext":"權田直助、","xmin":1443.0,"ymin":1443.0,"xmax":1494.0,"ymax":1637.0},{"id":62,"contenttext":"矢野玄道、","xmin":1443.0,"ymin":1676.0,"xmax":1494.0,"ymax":1869.0},{"id":63,"contenttext":"久保季茲等出","xmin":1443.0,"ymin":1907.0,"xmax":1494.0,"ymax":2185.0},{"id":64,"contenttext":"で盛に篤胤の說を唱ふ。","xmin":1367.0,"ymin":702.0,"xmax":1420.0,"ymax":1179.0},{"id":65,"contenttext":"されど吾人は筆を轉じて伴信友に就いて述べん。","xmin":1367.0,"ymin":1214.0,"xmax":1422.0,"ymax":2191.0},{"id":66,"contenttext":"、","xmin":1326.0,"ymin":1654.0,"xmax":1357.0,"ymax":1721.0},{"id":67,"contenttext":"信友亦篤胤と同じく宣長歿後の門人也。","xmin":1286.0,"ymin":745.0,"xmax":1341.0,"ymax":1548.0},{"id":68,"contenttext":"幼名。銳、","xmin":1290.0,"ymin":1578.0,"xmax":1341.0,"ymax":1729.0},{"id":69,"contenttext":"後","xmin":1288.0,"ymin":1762.0,"xmax":1341.0,"ymax":1819.0},{"id":70,"contenttext":"州五郞と改む。","xmin":1290.0,"ymin":1856.0,"xmax":1343.0,"ymax":2150.0},{"id":71,"contenttext":"父は山岸","xmin":1212.0,"ymin":2001.0,"xmax":1262.0,"ymax":2185.0},{"id":72,"contenttext":"事負と號す。","xmin":1212.0,"ymin":698.0,"xmax":1259.0,"ymax":949.0},{"id":73,"contenttext":"安永二年二月廿五日を以つて若狭國小濱に生る。","xmin":1209.0,"ymin":976.0,"xmax":1262.0,"ymax":1963.0},{"id":74,"contenttext":"次郞太夫惟智。","xmin":1136.0,"ymin":698.0,"xmax":1186.0,"ymax":995.0},{"id":75,"contenttext":"母は片岡氏。","xmin":1136.0,"ymin":1028.0,"xmax":1186.0,"ymax":1275.0},{"id":76,"contenttext":"信友はその第四子也。","xmin":1136.0,"ymin":1304.0,"xmax":1186.0,"ymax":1735.0},{"id":77,"contenttext":"天明六年年甫めて十","xmin":1138.0,"ymin":1768.0,"xmax":1192.0,"ymax":2183.0},{"id":78,"contenttext":"四、","xmin":1065.0,"ymin":702.0,"xmax":1112.0,"ymax":758.0},{"id":79,"contenttext":"小濱藩御勘定頭伴信頭の養嗣子となり翌年江戶に來り住す。","xmin":1062.0,"ymin":794.0,"xmax":1115.0,"ymax":2013.0},{"id":80,"contenttext":"天明八","xmin":1067.0,"ymin":2046.0,"xmax":1117.0,"ymax":2183.0},{"id":81,"contenttext":"年初めて藩に出仕し、","xmin":988.0,"ymin":700.0,"xmax":1040.0,"ymax":1130.0},{"id":82,"contenttext":"爾來精勤屢〓賞賜せらる。","xmin":988.0,"ymin":1167.0,"xmax":1037.0,"ymax":1643.0},{"id":83,"contenttext":"公務の餘暇、","xmin":990.0,"ymin":1676.0,"xmax":1041.0,"ymax":1916.0},{"id":84,"contenttext":"心を國學に","xmin":993.0,"ymin":1954.0,"xmax":1044.0,"ymax":2181.0},{"id":85,"contenttext":"傾け、","xmin":918.0,"ymin":700.0,"xmax":963.0,"ymax":805.0},{"id":86,"contenttext":"研鑚年あり。","xmin":918.0,"ymin":839.0,"xmax":964.0,"ymax":1085.0},{"id":87,"contenttext":"偶〓宣宣の『古事記傳』·「詞の玉の〓』等の書を得て、","xmin":916.0,"ymin":1117.0,"xmax":971.0,"ymax":2101.0},{"id":88,"contenttext":"、深","xmin":919.0,"ymin":2136.0,"xmax":971.0,"ymax":2185.0},{"id":89,"contenttext":"神道史綱要","xmin":846.0,"ymin":812.0,"xmax":885.0,"ymax":1018.0},{"id":90,"contenttext":"四元","xmin":846.0,"ymin":1954.0,"xmax":881.0,"ymax":1991.0},{"id":91,"contenttext":"若狭の人","xmin":1210.0,"ymin":502.0,"xmax":1249.0,"ymax":621.0}]