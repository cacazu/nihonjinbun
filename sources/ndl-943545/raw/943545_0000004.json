[{"id":0,"contenttext":"324.-456","xmin":1688.0,"ymin":342.0,"xmax":1962.0,"ymax":401.0},{"id":1,"contenttext":"序","xmin":1668.0,"ymin":671.0,"xmax":1798.0,"ymax":795.0},{"id":2,"contenttext":"凡そ現代の現象を正確に忠實に理解せんには","xmin":1540.0,"ymin":746.0,"xmax":1631.0,"ymax":2155.0},{"id":3,"contenttext":"先づ須らく其の由來を詳にせざるべからず。蓋し","xmin":1449.0,"ymin":675.0,"xmax":1540.0,"ymax":2150.0},{"id":4,"contenttext":"現代の現象は、今日忽焉として出で來れるものに","xmin":1353.0,"ymin":673.0,"xmax":1446.0,"ymax":2148.0},{"id":5,"contenttext":"あらざれば也。されば苟も我が固有の大道、即ち神","xmin":1264.0,"ymin":671.0,"xmax":1358.0,"ymax":2151.0},{"id":6,"contenttext":"道に對し、正確、忠實なる〓究を行はんと欲するも","xmin":1174.0,"ymin":669.0,"xmax":1263.0,"ymax":2144.0},{"id":7,"contenttext":"のは、亦、應にそが史的〓究を行はざるべからず予","xmin":1081.0,"ymin":671.0,"xmax":1167.0,"ymax":2142.0},{"id":8,"contenttext":"や不敏、敢へて自ら揣らず、此の方面の〓究に從事","xmin":987.0,"ymin":667.0,"xmax":1074.0,"ymax":2142.0},{"id":9,"contenttext":"する、年あり。茲に從來〓究せる所の神道變遷の〓","xmin":897.0,"ymin":669.0,"xmax":985.0,"ymax":2140.0}]