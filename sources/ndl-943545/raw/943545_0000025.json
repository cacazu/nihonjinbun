[{"id":0,"contenttext":"명","xmin":3149.0,"ymin":1975.0,"xmax":3182.0,"ymax":2013.0},{"id":1,"contenttext":"此神道家の說を","xmin":3071.0,"ymin":1864.0,"xmax":3127.0,"ymax":2193.0},{"id":2,"contenttext":"いやしめ笑ふは、","xmin":2996.0,"ymin":1869.0,"xmax":3048.0,"ymax":2197.0},{"id":3,"contenttext":"ヾ名のみぞ神道には有ける。","xmin":3087.0,"ymin":761.0,"xmax":3143.0,"ymax":1323.0},{"id":4,"contenttext":"されば世の儒者などの、","xmin":3075.0,"ymin":1357.0,"xmax":3135.0,"ymax":1836.0},{"id":5,"contenttext":"此神道家の說を","xmin":3071.0,"ymin":1864.0,"xmax":3127.0,"ymax":2193.0},{"id":6,"contenttext":"聞て、","xmin":3023.0,"ymin":753.0,"xmax":3068.0,"ymax":862.0},{"id":7,"contenttext":"神道といふ物は、","xmin":3011.0,"ymin":891.0,"xmax":3067.0,"ymax":1235.0},{"id":8,"contenttext":"近き世に作れる事なりとて、","xmin":3003.0,"ymin":1264.0,"xmax":3059.0,"ymax":1838.0},{"id":9,"contenttext":"いやしめ笑ふは、","xmin":2996.0,"ymin":1869.0,"xmax":3048.0,"ymax":2197.0},{"id":10,"contenttext":"げにことはりなり。","xmin":2942.0,"ymin":754.0,"xmax":2993.0,"ymax":1137.0},{"id":11,"contenttext":"(初山踏)","xmin":2935.0,"ymin":1160.0,"xmax":2991.0,"ymax":1328.0},{"id":12,"contenttext":"と。","xmin":2882.0,"ymin":710.0,"xmax":2915.0,"ymax":768.0},{"id":13,"contenttext":"かくて宣長は固有の大道を以つて、","xmin":2859.0,"ymin":799.0,"xmax":2924.0,"ymax":1513.0},{"id":14,"contenttext":"世の所謂神道なるものとは、","xmin":2850.0,"ymin":1541.0,"xmax":2911.0,"ymax":2116.0},{"id":15,"contenttext":"全","xmin":2853.0,"ymin":2145.0,"xmax":2898.0,"ymax":2189.0},{"id":16,"contenttext":"く異るものにして、","xmin":2797.0,"ymin":706.0,"xmax":2850.0,"ymax":1094.0},{"id":17,"contenttext":"專ら『記』·『紀』二典に記されたる事跡の上に備はるも","xmin":2773.0,"ymin":1122.0,"xmax":2843.0,"ymax":2187.0},{"id":18,"contenttext":"のとなせり。","xmin":2730.0,"ymin":706.0,"xmax":2776.0,"ymax":957.0},{"id":19,"contenttext":"而して說いて曰はく、","xmin":2718.0,"ymin":977.0,"xmax":2774.0,"ymax":1415.0},{"id":20,"contenttext":"そも此道はいかなる道ぞと尋ぬるに、","xmin":2641.0,"ymin":797.0,"xmax":2705.0,"ymax":1553.0},{"id":21,"contenttext":"天地、おのづからなる道にもあ","xmin":2632.0,"ymin":1586.0,"xmax":2691.0,"ymax":2185.0},{"id":22,"contenttext":"らず、","xmin":2585.0,"ymin":749.0,"xmax":2630.0,"ymax":856.0},{"id":23,"contenttext":"人の作れる道にもあらず、","xmin":2572.0,"ymin":885.0,"xmax":2629.0,"ymax":1415.0},{"id":24,"contenttext":"此道はしも、","xmin":2571.0,"ymin":1444.0,"xmax":2618.0,"ymax":1690.0},{"id":25,"contenttext":"可畏きや、","xmin":2561.0,"ymin":1723.0,"xmax":2615.0,"ymax":1926.0},{"id":26,"contenttext":"高御產巢日","xmin":2561.0,"ymin":1955.0,"xmax":2608.0,"ymax":2183.0},{"id":27,"contenttext":"カムロギ","xmin":2542.0,"ymin":1164.0,"xmax":2573.0,"ymax":1259.0},{"id":28,"contenttext":"神の御靈によりて、","xmin":2512.0,"ymin":745.0,"xmax":2559.0,"ymax":1134.0},{"id":29,"contenttext":"神祖伊邪那岐大神、","xmin":2500.0,"ymin":1166.0,"xmax":2556.0,"ymax":1553.0},{"id":30,"contenttext":"伊邪那美大神の始めたまひて、","xmin":2489.0,"ymin":1584.0,"xmax":2548.0,"ymax":2191.0},{"id":31,"contenttext":"天照大御神の受たまひ、","xmin":2435.0,"ymin":746.0,"xmax":2495.0,"ymax":1229.0},{"id":32,"contenttext":"たもちたまひ、","xmin":2432.0,"ymin":1259.0,"xmax":2481.0,"ymax":1552.0},{"id":33,"contenttext":"傳へたまふ道なり。","xmin":2422.0,"ymin":1576.0,"xmax":2476.0,"ymax":1967.0},{"id":34,"contenttext":"故是以神","xmin":2414.0,"ymin":1995.0,"xmax":2472.0,"ymax":2188.0},{"id":35,"contenttext":"の道とは申すぞかし。","xmin":2361.0,"ymin":746.0,"xmax":2419.0,"ymax":1182.0},{"id":36,"contenttext":"(直毘靈)","xmin":2355.0,"ymin":1197.0,"xmax":2413.0,"ymax":1361.0},{"id":37,"contenttext":"と。","xmin":2303.0,"ymin":698.0,"xmax":2342.0,"ymax":756.0},{"id":38,"contenttext":"彼の樂水の如きは亦之れを攻擊して曰はく、","xmin":2276.0,"ymin":787.0,"xmax":2346.0,"ymax":1684.0},{"id":39,"contenttext":"道は天津理のまゝなるものならば、","xmin":2205.0,"ymin":787.0,"xmax":2274.0,"ymax":1501.0},{"id":40,"contenttext":"そのまゝ天御中主尊の御心なり。","xmin":2192.0,"ymin":1531.0,"xmax":2257.0,"ymax":2186.0},{"id":41,"contenttext":"國史の成","xmin":2818.0,"ymin":502.0,"xmax":2855.0,"ymax":624.0},{"id":42,"contenttext":"跡","xmin":2790.0,"ymin":502.0,"xmax":2824.0,"ymax":540.0},{"id":43,"contenttext":"神の道の","xmin":2655.0,"ymin":500.0,"xmax":2692.0,"ymax":619.0},{"id":44,"contenttext":"意義","xmin":2628.0,"ymin":500.0,"xmax":2663.0,"ymax":562.0},{"id":45,"contenttext":"〓","xmin":1850.0,"ymin":1060.0,"xmax":1868.0,"ymax":1083.0},{"id":46,"contenttext":"故天御中主尊の御靈によりてなれりといはむにはさるべきを、","xmin":1803.0,"ymin":731.0,"xmax":1855.0,"ymax":1997.0},{"id":47,"contenttext":"高御產","xmin":1808.0,"ymin":2028.0,"xmax":1857.0,"ymax":2165.0},{"id":48,"contenttext":"シヒゴト","xmin":1769.0,"ymin":1661.0,"xmax":1801.0,"ymax":1754.0},{"id":49,"contenttext":"巢日神の御靈よりなれりといへるは、","xmin":1729.0,"ymin":731.0,"xmax":1780.0,"ymax":1488.0},{"id":50,"contenttext":"いたき誣言なりけり。","xmin":1733.0,"ymin":1526.0,"xmax":1778.0,"ymax":1952.0},{"id":51,"contenttext":"高皇產靈","xmin":1733.0,"ymin":1983.0,"xmax":1784.0,"ymax":2168.0},{"id":52,"contenttext":"尊は、","xmin":1660.0,"ymin":733.0,"xmax":1704.0,"ymax":840.0},{"id":53,"contenttext":"現身の神にてわたらせ給ふなり。","xmin":1657.0,"ymin":872.0,"xmax":1704.0,"ymax":1539.0},{"id":54,"contenttext":"(級長戶風)","xmin":1657.0,"ymin":1556.0,"xmax":1704.0,"ymax":1764.0},{"id":55,"contenttext":"と。","xmin":1592.0,"ymin":692.0,"xmax":1629.0,"ymax":750.0},{"id":56,"contenttext":"之れは是れ儒〓的天の見解を以つて、","xmin":1584.0,"ymin":782.0,"xmax":1637.0,"ymax":1541.0},{"id":57,"contenttext":"宣長の說を駁せるもの。","xmin":1584.0,"ymin":1568.0,"xmax":1640.0,"ymax":2048.0},{"id":58,"contenttext":"到底","xmin":1588.0,"ymin":2077.0,"xmax":1639.0,"ymax":2170.0},{"id":59,"contenttext":"俗に所謂水掛論に了らんのみ。","xmin":1510.0,"ymin":690.0,"xmax":1559.0,"ymax":1307.0},{"id":60,"contenttext":"蓋し儒〓には多く天を以つて、","xmin":1510.0,"ymin":1336.0,"xmax":1561.0,"ymax":1956.0},{"id":61,"contenttext":"天帝若く","xmin":1512.0,"ymin":1988.0,"xmax":1561.0,"ymax":2168.0},{"id":62,"contenttext":"は上帝に解し、","xmin":1437.0,"ymin":692.0,"xmax":1488.0,"ymax":985.0},{"id":63,"contenttext":"之れを萬物の主宰者とす。","xmin":1437.0,"ymin":1013.0,"xmax":1490.0,"ymax":1541.0},{"id":64,"contenttext":"此の天を以つて、","xmin":1437.0,"ymin":1571.0,"xmax":1490.0,"ymax":1915.0},{"id":65,"contenttext":"我が天御中","xmin":1441.0,"ymin":1943.0,"xmax":1492.0,"ymax":2173.0},{"id":66,"contenttext":"主神に配す。","xmin":1363.0,"ymin":692.0,"xmax":1414.0,"ymax":938.0},{"id":67,"contenttext":"絕對的に不可なりと云ふべからざるものあるに似たり。","xmin":1361.0,"ymin":968.0,"xmax":1417.0,"ymax":2097.0},{"id":68,"contenttext":"而","xmin":1369.0,"ymin":2129.0,"xmax":1416.0,"ymax":2175.0},{"id":69,"contenttext":"かも宣長は爾かく解せざる也。","xmin":1292.0,"ymin":692.0,"xmax":1341.0,"ymax":1306.0},{"id":70,"contenttext":"彼れは吾人の已に述べたるが如く天御中","xmin":1290.0,"ymin":1339.0,"xmax":1346.0,"ymax":2173.0},{"id":71,"contenttext":"主神を以つて單に「天眞中に坐々て、","xmin":1214.0,"ymin":694.0,"xmax":1265.0,"ymax":1403.0},{"id":72,"contenttext":"世中の字斯たる神(古事記傳)と解し、","xmin":1216.0,"ymin":1434.0,"xmax":1269.0,"ymax":2148.0},{"id":73,"contenttext":"唯〓宇宙の大綱を取り、","xmin":1144.0,"ymin":694.0,"xmax":1195.0,"ymax":1124.0},{"id":74,"contenttext":"其の秩序を維持せらるゝの神とのみ解し、","xmin":1144.0,"ymin":1158.0,"xmax":1194.0,"ymax":2004.0},{"id":75,"contenttext":"從つて","xmin":1151.0,"ymin":2039.0,"xmax":1196.0,"ymax":2173.0},{"id":76,"contenttext":"森羅萬象の生々發展するは、","xmin":1073.0,"ymin":696.0,"xmax":1125.0,"ymax":1268.0},{"id":77,"contenttext":"產靈二神の御靈によるものとせり。","xmin":1070.0,"ymin":1299.0,"xmax":1128.0,"ymax":2007.0},{"id":78,"contenttext":"是れ神","xmin":1076.0,"ymin":2038.0,"xmax":1131.0,"ymax":2180.0},{"id":79,"contenttext":"道の由て來る所を此の二神に歸せる所以也。","xmin":998.0,"ymin":696.0,"xmax":1057.0,"ymax":1598.0},{"id":80,"contenttext":"故に更に曰はく、","xmin":1000.0,"ymin":1623.0,"xmax":1054.0,"ymax":1966.0},{"id":81,"contenttext":"まことの道の趣を、","xmin":932.0,"ymin":792.0,"xmax":978.0,"ymax":1175.0},{"id":82,"contenttext":"あら〓〓申さむには、","xmin":932.0,"ymin":1209.0,"xmax":975.0,"ymax":1639.0},{"id":83,"contenttext":"まづ第一に、","xmin":932.0,"ymin":1669.0,"xmax":978.0,"ymax":1919.0},{"id":84,"contenttext":"此世の中の","xmin":932.0,"ymin":1947.0,"xmax":978.0,"ymax":2175.0},{"id":85,"contenttext":"神道史網要","xmin":873.0,"ymin":814.0,"xmax":912.0,"ymax":1022.0},{"id":86,"contenttext":"四三","xmin":877.0,"ymin":1947.0,"xmax":906.0,"ymax":1979.0},{"id":87,"contenttext":"天と天御","xmin":1451.0,"ymin":494.0,"xmax":1492.0,"ymax":613.0},{"id":88,"contenttext":"中圭得","xmin":1422.0,"ymin":494.0,"xmax":1461.0,"ymax":585.0}]