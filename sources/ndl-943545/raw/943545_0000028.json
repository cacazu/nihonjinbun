[{"id":0,"contenttext":"四六","xmin":3158.0,"ymin":1975.0,"xmax":3196.0,"ymax":2014.0},{"id":1,"contenttext":"の國とせるには反對し、","xmin":3100.0,"ymin":727.0,"xmax":3166.0,"ymax":1207.0},{"id":2,"contenttext":"之れを北極の上空なりとし、","xmin":3083.0,"ymin":1232.0,"xmax":3149.0,"ymax":1805.0},{"id":3,"contenttext":"又太陽なりと主張","xmin":3068.0,"ymin":1835.0,"xmax":3130.0,"ymax":2207.0},{"id":4,"contenttext":"せり。","xmin":3049.0,"ymin":727.0,"xmax":3088.0,"ymax":830.0},{"id":5,"contenttext":"次に宣長は夜見國を以つて支那の黄泉と同一視し、","xmin":3005.0,"ymin":862.0,"xmax":3094.0,"ymax":1898.0},{"id":6,"contenttext":"死して靈魂の","xmin":2994.0,"ymin":1925.0,"xmax":3055.0,"ymax":2202.0},{"id":7,"contenttext":"赴く所と解せり。","xmin":2958.0,"ymin":719.0,"xmax":3022.0,"ymax":1056.0},{"id":8,"contenttext":"然るに篤胤は、","xmin":2949.0,"ymin":1089.0,"xmax":3008.0,"ymax":1385.0},{"id":9,"contenttext":"人の靈魂の赴く所は幽冥にして、","xmin":2924.0,"ymin":1414.0,"xmax":2996.0,"ymax":2078.0},{"id":10,"contenttext":"古傳","xmin":2923.0,"ymin":2108.0,"xmax":2972.0,"ymax":2203.0},{"id":11,"contenttext":"の夜見國は月球なりとなしぬ。","xmin":2875.0,"ymin":717.0,"xmax":2946.0,"ymax":1340.0},{"id":12,"contenttext":"かくて篤胤は、","xmin":2868.0,"ymin":1369.0,"xmax":2926.0,"ymax":1661.0},{"id":13,"contenttext":"太陽は高天原にして、","xmin":2850.0,"ymin":1690.0,"xmax":2916.0,"ymax":2127.0},{"id":14,"contenttext":"天","xmin":2851.0,"ymin":2153.0,"xmax":2898.0,"ymax":2197.0},{"id":15,"contenttext":"照大神之れを統治し、","xmin":2810.0,"ymin":713.0,"xmax":2879.0,"ymax":1150.0},{"id":16,"contenttext":"地球は皇孫命の統治せらるゝ御國也。","xmin":2785.0,"ymin":1177.0,"xmax":2860.0,"ymax":1933.0},{"id":17,"contenttext":"月球は即ち","xmin":2778.0,"ymin":1964.0,"xmax":2830.0,"ymax":2194.0},{"id":18,"contenttext":"夜見國にして、","xmin":2742.0,"ymin":713.0,"xmax":2798.0,"ymax":1006.0},{"id":19,"contenttext":"素盞鳴尊の統治せらるゝ所となしぬ。","xmin":2714.0,"ymin":1034.0,"xmax":2789.0,"ymax":1792.0},{"id":20,"contenttext":"以つて彼れは宣長","xmin":2699.0,"ymin":1820.0,"xmax":2766.0,"ymax":2194.0},{"id":21,"contenttext":"の未だ手を附けざりし、","xmin":2664.0,"ymin":711.0,"xmax":2724.0,"ymax":1188.0},{"id":22,"contenttext":"西洋天文の說を取り來りて茲に地動說をも唱へ","xmin":2628.0,"ymin":1218.0,"xmax":2710.0,"ymax":2182.0},{"id":23,"contenttext":"ぬ。","xmin":2608.0,"ymin":710.0,"xmax":2647.0,"ymax":770.0},{"id":24,"contenttext":"曰はく、","xmin":2604.0,"ymin":802.0,"xmax":2646.0,"ymax":950.0},{"id":25,"contenttext":"天つ日は高く上に位を定めて動き轉ることなく、","xmin":2499.0,"ymin":797.0,"xmax":2578.0,"ymax":1784.0},{"id":26,"contenttext":"地は元よりのまゝ","xmin":2488.0,"ymin":1815.0,"xmax":2544.0,"ymax":2178.0},{"id":27,"contenttext":"タャヨヒメグ","xmin":2491.0,"ymin":772.0,"xmax":2522.0,"ymax":895.0},{"id":28,"contenttext":"に漂旋り、","xmin":2453.0,"ymin":748.0,"xmax":2505.0,"ymax":947.0},{"id":29,"contenttext":"月泉は地の底に成りて、","xmin":2435.0,"ymin":977.0,"xmax":2498.0,"ymax":1458.0},{"id":30,"contenttext":"もと地に漂ひ旋れる物なるけにや、","xmin":2410.0,"ymin":1488.0,"xmax":2486.0,"ymax":2188.0},{"id":31,"contenttext":"斷れ離れて後もその如く、","xmin":2366.0,"ymin":742.0,"xmax":2433.0,"ymax":1265.0},{"id":32,"contenttext":"地に屬て旋ること今の現に見るが如し。","xmin":2336.0,"ymin":1297.0,"xmax":2418.0,"ymax":2106.0},{"id":33,"contenttext":"こ","xmin":2344.0,"ymin":2135.0,"xmax":2375.0,"ymax":2173.0},{"id":34,"contenttext":"호,","xmin":2326.0,"ymin":1336.0,"xmax":2356.0,"ymax":1402.0},{"id":35,"contenttext":"と","xmin":2324.0,"ymin":1436.0,"xmax":2354.0,"ymax":1486.0},{"id":36,"contenttext":"れ等のことすべて神の產靈の奇く妙なる理によりて然るなれば、","xmin":2263.0,"ymin":740.0,"xmax":2357.0,"ymax":2055.0},{"id":37,"contenttext":"更に","xmin":2261.0,"ymin":2078.0,"xmax":2309.0,"ymax":2172.0},{"id":38,"contenttext":"人の小き智をもて、","xmin":2225.0,"ymin":738.0,"xmax":2282.0,"ymax":1123.0},{"id":39,"contenttext":"とかく測識るべき限にあらず。","xmin":2207.0,"ymin":1157.0,"xmax":2269.0,"ymax":1771.0},{"id":40,"contenttext":"(靈能眞柱)","xmin":2195.0,"ymin":1788.0,"xmax":2253.0,"ymax":1996.0},{"id":41,"contenttext":"地訪說","xmin":2692.0,"ymin":512.0,"xmax":2728.0,"ymax":605.0},{"id":42,"contenttext":"ど。","xmin":1794.0,"ymin":702.0,"xmax":1831.0,"ymax":758.0},{"id":43,"contenttext":"かくして彼れは當時一部の學者の間に漸く盛に行はれ來れる西洋の","xmin":1786.0,"ymin":792.0,"xmax":1837.0,"ymax":2179.0},{"id":44,"contenttext":"學理を應用して、","xmin":1715.0,"ymin":698.0,"xmax":1762.0,"ymax":1040.0},{"id":45,"contenttext":"その學說を構成し、","xmin":1715.0,"ymin":1072.0,"xmax":1762.0,"ymax":1457.0},{"id":46,"contenttext":"而して是れ皆我が眞の古傳なりと","xmin":1713.0,"ymin":1489.0,"xmax":1762.0,"ymax":2179.0},{"id":47,"contenttext":"なしぬ。","xmin":1643.0,"ymin":698.0,"xmax":1688.0,"ymax":852.0},{"id":48,"contenttext":"篤胤は、","xmin":1568.0,"ymin":747.0,"xmax":1616.0,"ymax":903.0},{"id":49,"contenttext":"その神道說に於いては、","xmin":1568.0,"ymin":933.0,"xmax":1616.0,"ymax":1412.0},{"id":50,"contenttext":"殆んど忠實に宣長の學を信奉せり。","xmin":1568.0,"ymin":1442.0,"xmax":1616.0,"ymax":2154.0},{"id":51,"contenttext":"曰はく、","xmin":1499.0,"ymin":703.0,"xmax":1547.0,"ymax":856.0},{"id":52,"contenttext":"この天地を御造り遊ばしたる天つ神、","xmin":1424.0,"ymin":796.0,"xmax":1481.0,"ymax":1553.0},{"id":53,"contenttext":"高皇產靈神·神皇產靈神の始ま","xmin":1424.0,"ymin":1583.0,"xmax":1478.0,"ymax":2187.0},{"id":54,"contenttext":"して、","xmin":1355.0,"ymin":749.0,"xmax":1396.0,"ymax":856.0},{"id":55,"contenttext":"伊邪那岐·伊邪那美神の御受繼あそばして、","xmin":1353.0,"ymin":888.0,"xmax":1402.0,"ymax":1738.0},{"id":56,"contenttext":"世にありとある事物","xmin":1355.0,"ymin":1771.0,"xmax":1404.0,"ymax":2187.0},{"id":57,"contenttext":"の本を御始なされ、","xmin":1279.0,"ymin":745.0,"xmax":1335.0,"ymax":1138.0},{"id":58,"contenttext":"又その事物を悉に持分けしろしめす神々を御生な","xmin":1277.0,"ymin":1168.0,"xmax":1330.0,"ymax":2185.0},{"id":59,"contenttext":"されて、","xmin":1206.0,"ymin":747.0,"xmax":1253.0,"ymax":903.0},{"id":60,"contenttext":"其功德は天照大御神に御傳へあそばし、","xmin":1204.0,"ymin":935.0,"xmax":1257.0,"ymax":1741.0},{"id":61,"contenttext":"偖","xmin":1204.0,"ymin":1767.0,"xmax":1255.0,"ymax":1833.0},{"id":62,"contenttext":"皇御孫通々杵尊、","xmin":1204.0,"ymin":1865.0,"xmax":1253.0,"ymax":2193.0},{"id":63,"contenttext":"御天降り遊ばさるゝ時、","xmin":1136.0,"ymin":751.0,"xmax":1181.0,"ymax":1232.0},{"id":64,"contenttext":"天御祖產靈の御神、","xmin":1132.0,"ymin":1262.0,"xmax":1183.0,"ymax":1649.0},{"id":65,"contenttext":"天照大御神より、","xmin":1132.0,"ymin":1679.0,"xmax":1181.0,"ymax":2017.0},{"id":66,"contenttext":"皇御孫","xmin":1132.0,"ymin":2051.0,"xmax":1179.0,"ymax":2187.0},{"id":67,"contenttext":"命の御代々、","xmin":1062.0,"ymin":748.0,"xmax":1118.0,"ymax":1000.0},{"id":68,"contenttext":"天の下を知し召す御政のやうを御傳へあそばし、","xmin":1063.0,"ymin":1031.0,"xmax":1116.0,"ymax":2021.0},{"id":69,"contenttext":"偖","xmin":1061.0,"ymin":2047.0,"xmax":1114.0,"ymax":2115.0},{"id":70,"contenttext":"御","xmin":1061.0,"ymin":2143.0,"xmax":1110.0,"ymax":2187.0},{"id":71,"contenttext":"代々の天皇其の御依しのまに〓〓、","xmin":988.0,"ymin":751.0,"xmax":1040.0,"ymax":1457.0},{"id":72,"contenttext":"己命の御さかしらを御加へあそば","xmin":986.0,"ymin":1495.0,"xmax":1040.0,"ymax":2187.0},{"id":73,"contenttext":"さず、","xmin":924.0,"ymin":751.0,"xmax":969.0,"ymax":858.0},{"id":74,"contenttext":"天地と共に御世しろしめすことぢやが、","xmin":922.0,"ymin":890.0,"xmax":969.0,"ymax":1692.0},{"id":75,"contenttext":"斯道をさして、","xmin":922.0,"ymin":1724.0,"xmax":969.0,"ymax":2019.0},{"id":76,"contenttext":"神道と","xmin":922.0,"ymin":2051.0,"xmax":967.0,"ymax":2185.0},{"id":77,"contenttext":"神道史綱要","xmin":867.0,"ymin":810.0,"xmax":905.0,"ymax":1020.0},{"id":78,"contenttext":"恩","xmin":869.0,"ymin":1957.0,"xmax":903.0,"ymax":1995.0},{"id":79,"contenttext":"宣長學の","xmin":1579.0,"ymin":497.0,"xmax":1617.0,"ymax":618.0},{"id":80,"contenttext":"紹述","xmin":1553.0,"ymin":500.0,"xmax":1588.0,"ymax":564.0},{"id":81,"contenttext":"その神道說に於いては、","xmin":1568.0,"ymin":933.0,"xmax":1616.0,"ymax":1412.0},{"id":82,"contenttext":"殆んど忠實に宣長の學を信奉せり。","xmin":1568.0,"ymin":1442.0,"xmax":1616.0,"ymax":2154.0}]