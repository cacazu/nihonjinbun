[{"id":0,"contenttext":"종","xmin":3131.0,"ymin":1992.0,"xmax":3166.0,"ymax":2031.0},{"id":1,"contenttext":"くその卓見に服し、","xmin":3077.0,"ymin":736.0,"xmax":3135.0,"ymax":1121.0},{"id":2,"contenttext":"敬慕措かず。","xmin":3069.0,"ymin":1150.0,"xmax":3130.0,"ymax":1403.0},{"id":3,"contenttext":"遂にその門に入らんとす。","xmin":3050.0,"ymin":1428.0,"xmax":3119.0,"ymax":1959.0},{"id":4,"contenttext":"而かも紹介","xmin":3049.0,"ymin":1985.0,"xmax":3101.0,"ymax":2218.0},{"id":5,"contenttext":"を托するものなし。","xmin":3009.0,"ymin":736.0,"xmax":3061.0,"ymax":1123.0},{"id":6,"contenttext":"人あり、","xmin":3008.0,"ymin":1152.0,"xmax":3051.0,"ymax":1302.0},{"id":7,"contenttext":"村田春門の宣長が門人たるを告ぐ。","xmin":2980.0,"ymin":1333.0,"xmax":3050.0,"ymax":2049.0},{"id":8,"contenttext":"乃ち春","xmin":2979.0,"ymin":2079.0,"xmax":3028.0,"ymax":2216.0},{"id":9,"contenttext":"門を介して入門せんことを求む。","xmin":2927.0,"ymin":730.0,"xmax":2994.0,"ymax":1397.0},{"id":10,"contenttext":"春門快諾、","xmin":2919.0,"ymin":1426.0,"xmax":2979.0,"ymax":1631.0},{"id":11,"contenttext":"書を松坂に致して、","xmin":2909.0,"ymin":1662.0,"xmax":2971.0,"ymax":2051.0},{"id":12,"contenttext":"信友の","xmin":2906.0,"ymin":2077.0,"xmax":2957.0,"ymax":2213.0},{"id":13,"contenttext":"名簿を送り、","xmin":2863.0,"ymin":730.0,"xmax":2917.0,"ymax":980.0},{"id":14,"contenttext":"且つその志を〓ぐ。","xmin":2853.0,"ymin":1010.0,"xmax":2911.0,"ymax":1395.0},{"id":15,"contenttext":"時に享和元年にして恰も宣長の歿せる","xmin":2827.0,"ymin":1426.0,"xmax":2902.0,"ymax":2210.0},{"id":16,"contenttext":"後たり。","xmin":2794.0,"ymin":731.0,"xmax":2843.0,"ymax":884.0},{"id":17,"contenttext":"嗣子大平信友の志に感じ、","xmin":2770.0,"ymin":913.0,"xmax":2846.0,"ymax":1444.0},{"id":18,"contenttext":"名簿を靈前に供へ門人に列す。","xmin":2757.0,"ymin":1472.0,"xmax":2823.0,"ymax":2092.0},{"id":19,"contenttext":"當時","xmin":2759.0,"ymin":2120.0,"xmax":2802.0,"ymax":2211.0},{"id":20,"contenttext":"信友年二十九、","xmin":2714.0,"ymin":728.0,"xmax":2772.0,"ymax":1027.0},{"id":21,"contenttext":"已に著書に着手し、","xmin":2702.0,"ymin":1053.0,"xmax":2760.0,"ymax":1440.0},{"id":22,"contenttext":"以後年として殆んど二三種の稿を脫","xmin":2682.0,"ymin":1470.0,"xmax":2751.0,"ymax":2214.0},{"id":23,"contenttext":"せざるはなかりき。","xmin":2638.0,"ymin":730.0,"xmax":2696.0,"ymax":1115.0},{"id":24,"contenttext":"文政四年に至り、","xmin":2624.0,"ymin":1142.0,"xmax":2690.0,"ymax":1487.0},{"id":25,"contenttext":"病により仕を辭し、","xmin":2615.0,"ymin":1514.0,"xmax":2676.0,"ymax":1904.0},{"id":26,"contenttext":"是れより全く","xmin":2610.0,"ymin":1934.0,"xmax":2663.0,"ymax":2208.0},{"id":27,"contenttext":"學者の生活に入り、","xmin":2562.0,"ymin":725.0,"xmax":2622.0,"ymax":1113.0},{"id":28,"contenttext":"日夜書齋に蟄居し、","xmin":2550.0,"ymin":1143.0,"xmax":2611.0,"ymax":1531.0},{"id":29,"contenttext":"社交を絕ち、","xmin":2545.0,"ymin":1557.0,"xmax":2601.0,"ymax":1810.0},{"id":30,"contenttext":"書籍堆積の間に端","xmin":2535.0,"ymin":1840.0,"xmax":2592.0,"ymax":2208.0},{"id":31,"contenttext":"坐し、","xmin":2500.0,"ymin":727.0,"xmax":2551.0,"ymax":834.0},{"id":32,"contenttext":"深更に至るも筆を措かず。","xmin":2483.0,"ymin":861.0,"xmax":2547.0,"ymax":1391.0},{"id":33,"contenttext":"專ら著書研學に從事し、","xmin":2469.0,"ymin":1418.0,"xmax":2533.0,"ymax":1902.0},{"id":34,"contenttext":"嚴寒酷暑と雖","xmin":2462.0,"ymin":1929.0,"xmax":2519.0,"ymax":2204.0},{"id":35,"contenttext":"も一日も之れを廢せず。","xmin":2413.0,"ymin":723.0,"xmax":2477.0,"ymax":1201.0},{"id":36,"contenttext":"吾人此れ等の點に於いて遙に英吉利のスペンサ","xmin":2388.0,"ymin":1232.0,"xmax":2467.0,"ymax":2204.0},{"id":37,"contenttext":"ーを聯想す。","xmin":2344.0,"ymin":721.0,"xmax":2402.0,"ymax":970.0},{"id":38,"contenttext":"殊に信友が攝生の道を重んぜしは、","xmin":2325.0,"ymin":999.0,"xmax":2396.0,"ymax":1714.0},{"id":39,"contenttext":"全くスペンサーと一致","xmin":2319.0,"ymin":1742.0,"xmax":2374.0,"ymax":2204.0},{"id":40,"contenttext":"せり。","xmin":2285.0,"ymin":722.0,"xmax":2323.0,"ymax":823.0},{"id":41,"contenttext":"信友甞て杉田玄伯に攝生の道を問ふ。","xmin":2256.0,"ymin":856.0,"xmax":2326.0,"ymax":1617.0},{"id":42,"contenttext":"玄伯七不可を書して答ふ。","xmin":2243.0,"ymin":1645.0,"xmax":2306.0,"ymax":2176.0},{"id":43,"contenttext":"七不可とは何ぞ、","xmin":2199.0,"ymin":716.0,"xmax":2257.0,"ymax":1059.0},{"id":44,"contenttext":"曰はく、","xmin":2203.0,"ymin":1092.0,"xmax":2244.0,"ymax":1243.0},{"id":45,"contenttext":"「昨日非不可恨悔","xmin":2185.0,"ymin":1259.0,"xmax":2244.0,"ymax":1614.0},{"id":46,"contenttext":"明日是不可慮念。","xmin":2175.0,"ymin":1643.0,"xmax":2237.0,"ymax":1989.0},{"id":47,"contenttext":"飮與食不","xmin":2171.0,"ymin":2013.0,"xmax":2227.0,"ymax":2202.0},{"id":48,"contenttext":"致仕","xmin":2665.0,"ymin":530.0,"xmax":2704.0,"ymax":595.0},{"id":49,"contenttext":"七不可","xmin":2226.0,"ymin":522.0,"xmax":2264.0,"ymax":613.0},{"id":50,"contenttext":"ニ","xmin":1841.0,"ymin":823.0,"xmax":1866.0,"ymax":862.0},{"id":51,"contenttext":"ンド","xmin":1836.0,"ymin":911.0,"xmax":1867.0,"ymax":961.0},{"id":52,"contenttext":"可過度","xmin":1798.0,"ymin":700.0,"xmax":1851.0,"ymax":850.0},{"id":53,"contenttext":"非正物不可苟〓。","xmin":1798.0,"ymin":884.0,"xmax":1851.0,"ymax":1232.0},{"id":54,"contenttext":"無事時不可服藥。","xmin":1800.0,"ymin":1256.0,"xmax":1854.0,"ymax":1607.0},{"id":55,"contenttext":"賴壯實不可過房","xmin":1800.0,"ymin":1628.0,"xmax":1854.0,"ymax":1979.0},{"id":56,"contenttext":"勤動作不","xmin":1803.0,"ymin":2000.0,"xmax":1854.0,"ymax":2193.0},{"id":57,"contenttext":"可好安」","xmin":1725.0,"ymin":700.0,"xmax":1774.0,"ymax":858.0},{"id":58,"contenttext":"と。","xmin":1731.0,"ymin":888.0,"xmax":1766.0,"ymax":948.0},{"id":59,"contenttext":"信友之れを得て深く喜び、","xmin":1723.0,"ymin":978.0,"xmax":1776.0,"ymax":1506.0},{"id":60,"contenttext":"能く之れを守りたりと云ふ。","xmin":1725.0,"ymin":1534.0,"xmax":1776.0,"ymax":2107.0},{"id":61,"contenttext":"信友資性謙抑にして、","xmin":1649.0,"ymin":749.0,"xmax":1700.0,"ymax":1183.0},{"id":62,"contenttext":"名利を求めず、","xmin":1649.0,"ymin":1213.0,"xmax":1703.0,"ymax":1508.0},{"id":63,"contenttext":"天下負笈の徒、","xmin":1651.0,"ymin":1536.0,"xmax":1704.0,"ymax":1831.0},{"id":64,"contenttext":"その名を聞き來","xmin":1652.0,"ymin":1863.0,"xmax":1704.0,"ymax":2183.0},{"id":65,"contenttext":"りてその門人たらんことを請ふもの甚だ多かりしも、","xmin":1582.0,"ymin":704.0,"xmax":1629.0,"ymax":1782.0},{"id":66,"contenttext":"皆之れを謝し曰は","xmin":1582.0,"ymin":1814.0,"xmax":1629.0,"ymax":2181.0},{"id":67,"contenttext":"く、","xmin":1516.0,"ymin":704.0,"xmax":1551.0,"ymax":764.0},{"id":68,"contenttext":"「吾が學、","xmin":1506.0,"ymin":784.0,"xmax":1561.0,"ymax":952.0},{"id":69,"contenttext":"人の師たるに足らず」と。","xmin":1510.0,"ymin":980.0,"xmax":1557.0,"ymax":1455.0},{"id":70,"contenttext":"强ひて請はヾ乃ち之れを學友とな","xmin":1510.0,"ymin":1491.0,"xmax":1563.0,"ymax":2183.0},{"id":71,"contenttext":"す。","xmin":1439.0,"ymin":702.0,"xmax":1480.0,"ymax":762.0},{"id":72,"contenttext":"本居大平の門人、","xmin":1433.0,"ymin":796.0,"xmax":1485.0,"ymax":1134.0},{"id":73,"contenttext":"加納諸平に與ふる書、","xmin":1434.0,"ymin":1166.0,"xmax":1486.0,"ymax":1598.0},{"id":74,"contenttext":"その意の存する所を示せり。","xmin":1439.0,"ymin":1632.0,"xmax":1488.0,"ymax":2191.0},{"id":75,"contenttext":"曰はく、","xmin":1364.0,"ymin":707.0,"xmax":1414.0,"ymax":855.0},{"id":76,"contenttext":"生涯博士だちたる心を持ち玉はず、","xmin":1289.0,"ymin":796.0,"xmax":1345.0,"ymax":1511.0},{"id":77,"contenttext":"人にも書にも問ふことをな忘れ","xmin":1291.0,"ymin":1538.0,"xmax":1347.0,"ymax":2185.0},{"id":78,"contenttext":"玉ひそ。","xmin":1216.0,"ymin":751.0,"xmax":1263.0,"ymax":904.0},{"id":79,"contenttext":"自ら師とならんと思ふ一念あれば、","xmin":1218.0,"ymin":937.0,"xmax":1266.0,"ymax":1647.0},{"id":80,"contenttext":"直ちに學事に損なり。","xmin":1220.0,"ymin":1677.0,"xmax":1269.0,"ymax":2105.0},{"id":81,"contenttext":"師","xmin":1224.0,"ymin":2139.0,"xmax":1271.0,"ymax":2185.0},{"id":82,"contenttext":"と稱し候は、","xmin":1147.0,"ymin":753.0,"xmax":1194.0,"ymax":1001.0},{"id":83,"contenttext":"人より恭ふ稱なり。","xmin":1149.0,"ymin":1033.0,"xmax":1194.0,"ymax":1409.0},{"id":84,"contenttext":"弟子と稱すれども、","xmin":1149.0,"ymin":1446.0,"xmax":1196.0,"ymax":1832.0},{"id":85,"contenttext":"〓を受くるもの","xmin":1153.0,"ymin":1865.0,"xmax":1198.0,"ymax":2183.0},{"id":86,"contenttext":"ゝ稱なり。","xmin":1079.0,"ymin":757.0,"xmax":1122.0,"ymax":948.0},{"id":87,"contenttext":"師と云ひ弟子と云ふも、","xmin":1075.0,"ymin":982.0,"xmax":1124.0,"ymax":1463.0},{"id":88,"contenttext":"自らの口より云ふべき詞にあらず。","xmin":1078.0,"ymin":1497.0,"xmax":1131.0,"ymax":2193.0},{"id":89,"contenttext":"殊に御國の學は、","xmin":998.0,"ymin":753.0,"xmax":1050.0,"ymax":1093.0},{"id":90,"contenttext":"漢なとゝは樣子異れば、","xmin":1001.0,"ymin":1123.0,"xmax":1050.0,"ymax":1600.0},{"id":91,"contenttext":"師弟の別はなき趣なり。","xmin":1002.0,"ymin":1632.0,"xmax":1056.0,"ymax":2118.0},{"id":92,"contenttext":"講","xmin":1007.0,"ymin":2139.0,"xmax":1059.0,"ymax":2187.0},{"id":93,"contenttext":"習討論の上座とか、","xmin":925.0,"ymin":753.0,"xmax":973.0,"ymax":1136.0},{"id":94,"contenttext":"長座とか云ふべきものか。","xmin":925.0,"ymin":1170.0,"xmax":974.0,"ymax":1691.0},{"id":95,"contenttext":"但しこれは小子が私論","xmin":929.0,"ymin":1726.0,"xmax":980.0,"ymax":2185.0},{"id":96,"contenttext":"神道史網要","xmin":867.0,"ymin":812.0,"xmax":905.0,"ymax":1020.0},{"id":97,"contenttext":"五一","xmin":873.0,"ymin":1961.0,"xmax":901.0,"ymax":1995.0},{"id":98,"contenttext":"學友","xmin":1521.0,"ymin":502.0,"xmax":1559.0,"ymax":568.0}]