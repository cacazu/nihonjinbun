[{"id":0,"contenttext":"ぬ。","xmin":3023.0,"ymin":661.0,"xmax":3064.0,"ymax":717.0},{"id":1,"contenttext":"快活的現世的感情の如き、","xmin":3019.0,"ymin":748.0,"xmax":3081.0,"ymax":1270.0},{"id":2,"contenttext":"希臘人の間にも大いに之れを認め得べく、","xmin":3032.0,"ymin":1304.0,"xmax":3102.0,"ymax":2141.0},{"id":3,"contenttext":"發展的膨脹的性格の如き、","xmin":2941.0,"ymin":658.0,"xmax":3005.0,"ymax":1178.0},{"id":4,"contenttext":"羅馬人の間にも著しく之れを認め得べし。","xmin":2955.0,"ymin":1212.0,"xmax":3029.0,"ymax":2074.0},{"id":5,"contenttext":"而","xmin":2984.0,"ymin":2094.0,"xmax":3031.0,"ymax":2142.0},{"id":6,"contenttext":"かも被れ等國民は、","xmin":2871.0,"ymin":660.0,"xmax":2929.0,"ymax":1039.0},{"id":7,"contenttext":"至中至正にましましたる天照大神の如き、","xmin":2879.0,"ymin":1077.0,"xmax":2951.0,"ymax":1922.0},{"id":8,"contenttext":"偉大なる","xmin":2903.0,"ymin":1955.0,"xmax":2957.0,"ymax":2139.0},{"id":9,"contenttext":"人格神を有せざりしが爲に、","xmin":2795.0,"ymin":660.0,"xmax":2856.0,"ymax":1225.0},{"id":10,"contenttext":"不幸にも之れを偏して有せしのみならず、","xmin":2809.0,"ymin":1261.0,"xmax":2882.0,"ymax":2106.0},{"id":11,"contenttext":"その引續ける國運の沈替と共にその偏せるものをも殆んど之れを銷磨し","xmin":2721.0,"ymin":660.0,"xmax":2809.0,"ymax":2145.0},{"id":12,"contenttext":"去れり。","xmin":2647.0,"ymin":663.0,"xmax":2694.0,"ymax":809.0},{"id":13,"contenttext":"獨り我が國民はかゝる精神の精を體し華を集め給ひ、","xmin":2646.0,"ymin":846.0,"xmax":2727.0,"ymax":1924.0},{"id":14,"contenttext":"所謂か","xmin":2679.0,"ymin":1961.0,"xmax":2726.0,"ymax":2101.0},{"id":15,"contenttext":"そ","xmin":2616.0,"ymin":2104.0,"xmax":2647.0,"ymax":2144.0},{"id":16,"contenttext":"る精神の權化とも稱しまつるべき天照大神其の他種々の神聖を有し、","xmin":2570.0,"ymin":667.0,"xmax":2652.0,"ymax":2067.0},{"id":17,"contenttext":"れら神聖の行ひ給ひ、","xmin":2499.0,"ymin":669.0,"xmax":2547.0,"ymax":1092.0},{"id":18,"contenttext":"示し給ひし事蹟は、","xmin":2506.0,"ymin":1131.0,"xmax":2559.0,"ymax":1509.0},{"id":19,"contenttext":"々國民に偉大なる印象を與","xmin":2518.0,"ymin":1594.0,"xmax":2574.0,"ymax":2151.0},{"id":20,"contenttext":"へ、","xmin":2432.0,"ymin":675.0,"xmax":2467.0,"ymax":717.0},{"id":21,"contenttext":"政治と云はず、","xmin":2430.0,"ymin":759.0,"xmax":2476.0,"ymax":1045.0},{"id":22,"contenttext":"宗〓と云はず、","xmin":2435.0,"ymin":1085.0,"xmax":2488.0,"ymax":1372.0},{"id":23,"contenttext":"道徳と云はず、","xmin":2444.0,"ymin":1411.0,"xmax":2493.0,"ymax":1694.0},{"id":24,"contenttext":"あらゆる國民行爲の","xmin":2449.0,"ymin":1735.0,"xmax":2509.0,"ymax":2149.0},{"id":25,"contenttext":"規範となり","xmin":2354.0,"ymin":667.0,"xmax":2399.0,"ymax":901.0},{"id":26,"contenttext":"國民依つて以つて云爲し、","xmin":2359.0,"ymin":945.0,"xmax":2415.0,"ymax":1466.0},{"id":27,"contenttext":"依つて以つて行動し、","xmin":2372.0,"ymin":1502.0,"xmax":2429.0,"ymax":1930.0},{"id":28,"contenttext":"益々我が","xmin":2382.0,"ymin":1968.0,"xmax":2435.0,"ymax":2149.0},{"id":29,"contenttext":"國民的精神を發揮し、","xmin":2275.0,"ymin":667.0,"xmax":2331.0,"ymax":1096.0},{"id":30,"contenttext":"我が國家をして啻に亡滅の厄に超然たらし","xmin":2284.0,"ymin":1130.0,"xmax":2357.0,"ymax":2014.0},{"id":31,"contenttext":"むるの","xmin":2312.0,"ymin":2013.0,"xmax":2358.0,"ymax":2149.0},{"id":32,"contenttext":"みならず、","xmin":2205.0,"ymin":673.0,"xmax":2246.0,"ymax":862.0},{"id":33,"contenttext":"却つて愈々之れを興隆し、","xmin":2209.0,"ymin":904.0,"xmax":2264.0,"ymax":1421.0},{"id":34,"contenttext":"愈々之れを發展し、","xmin":2220.0,"ymin":1459.0,"xmax":2275.0,"ymax":1839.0},{"id":35,"contenttext":"我が皇運をし","xmin":2233.0,"ymin":1876.0,"xmax":2284.0,"ymax":2153.0},{"id":36,"contenttext":"て天壤と與に無窮ならしむ","xmin":2127.0,"ymin":673.0,"xmax":2188.0,"ymax":1235.0},{"id":37,"contenttext":"かく古來の神聖の事蹟より由來せる國民の","xmin":2143.0,"ymin":1279.0,"xmax":2212.0,"ymax":2153.0},{"id":38,"contenttext":"義","xmin":2641.0,"ymin":467.0,"xmax":2675.0,"ymax":503.0},{"id":39,"contenttext":"神道の意","xmin":2667.0,"ymin":467.0,"xmax":2710.0,"ymax":587.0},{"id":40,"contenttext":"云爲行動の根柢となり、","xmin":1733.0,"ymin":645.0,"xmax":1780.0,"ymax":1112.0},{"id":41,"contenttext":"規範となる所のものを呼んで神道と云ふ","xmin":1728.0,"ymin":1152.0,"xmax":1777.0,"ymax":1993.0},{"id":42,"contenttext":"かゝる神道は、","xmin":1658.0,"ymin":710.0,"xmax":1712.0,"ymax":998.0},{"id":43,"contenttext":"古代に於いて已に非常なる勢力を有し、","xmin":1657.0,"ymin":1031.0,"xmax":1709.0,"ymax":1827.0},{"id":44,"contenttext":"當時の國民の","xmin":1660.0,"ymin":1859.0,"xmax":1711.0,"ymax":2134.0},{"id":45,"contenttext":"知識的·感情的意意的要求に應じたりし也。","xmin":1590.0,"ymin":661.0,"xmax":1637.0,"ymax":1504.0},{"id":46,"contenttext":"故にそが實際界に現はれては、","xmin":1585.0,"ymin":1534.0,"xmax":1636.0,"ymax":2138.0},{"id":47,"contenttext":"從來、","xmin":1517.0,"ymin":659.0,"xmax":1571.0,"ymax":781.0},{"id":48,"contenttext":"我が國民の道德界に非常なる影響を及ぼしたる儒〓の傳來前に於","xmin":1513.0,"ymin":798.0,"xmax":1570.0,"ymax":2136.0},{"id":49,"contenttext":"ける我が國民の道德となりし也。","xmin":1451.0,"ymin":661.0,"xmax":1497.0,"ymax":1318.0},{"id":50,"contenttext":"又、","xmin":1447.0,"ymin":1348.0,"xmax":1498.0,"ymax":1412.0},{"id":51,"contenttext":"我が國民の宗〓界に甚大なる勢力","xmin":1445.0,"ymin":1442.0,"xmax":1496.0,"ymax":2134.0},{"id":52,"contenttext":"を有したる佛〓の傳來前に於ける、","xmin":1377.0,"ymin":659.0,"xmax":1427.0,"ymax":1364.0},{"id":53,"contenttext":"我が國民を安心立命せしめし所の宗","xmin":1371.0,"ymin":1395.0,"xmax":1428.0,"ymax":2134.0},{"id":54,"contenttext":"〓たりし也。","xmin":1306.0,"ymin":659.0,"xmax":1353.0,"ymax":905.0},{"id":55,"contenttext":"而して恐くも、","xmin":1308.0,"ymin":939.0,"xmax":1352.0,"ymax":1226.0},{"id":56,"contenttext":"明治天皇陛下が、","xmin":1302.0,"ymin":1254.0,"xmax":1353.0,"ymax":1596.0},{"id":57,"contenttext":"明治三年正月三日、","xmin":1300.0,"ymin":1628.0,"xmax":1351.0,"ymax":2010.0},{"id":58,"contenttext":"勅を","xmin":1302.0,"ymin":2043.0,"xmax":1347.0,"ymax":2132.0},{"id":59,"contenttext":"下して、","xmin":1230.0,"ymin":659.0,"xmax":1277.0,"ymax":813.0},{"id":60,"contenttext":"朕、","xmin":1226.0,"ymin":886.0,"xmax":1279.0,"ymax":954.0},{"id":61,"contenttext":"恭惟、","xmin":1228.0,"ymin":980.0,"xmax":1277.0,"ymax":1091.0},{"id":62,"contenttext":"天神天祖、","xmin":1226.0,"ymin":1119.0,"xmax":1279.0,"ymax":1320.0},{"id":63,"contenttext":"立極埀統、","xmin":1226.0,"ymin":1350.0,"xmax":1277.0,"ymax":1551.0},{"id":64,"contenttext":"列聖相承、","xmin":1226.0,"ymin":1581.0,"xmax":1277.0,"ymax":1780.0},{"id":65,"contenttext":"繼之述之、","xmin":1226.0,"ymin":1812.0,"xmax":1277.0,"ymax":2013.0},{"id":66,"contenttext":"祭政","xmin":1226.0,"ymin":2041.0,"xmax":1277.0,"ymax":2134.0},{"id":67,"contenttext":"一、あ、","xmin":1155.0,"ymin":667.0,"xmax":1204.0,"ymax":766.0},{"id":68,"contenttext":"億兆同心、","xmin":1153.0,"ymin":796.0,"xmax":1204.0,"ymax":996.0},{"id":69,"contenttext":"治〓明于上、","xmin":1153.0,"ymin":1025.0,"xmax":1204.0,"ymax":1273.0},{"id":70,"contenttext":"風俗美于下。","xmin":1153.0,"ymin":1305.0,"xmax":1204.0,"ymax":1553.0},{"id":71,"contenttext":"と宣はせたるが如く、","xmin":1151.0,"ymin":1585.0,"xmax":1200.0,"ymax":2010.0},{"id":72,"contenttext":"上古","xmin":1151.0,"ymin":2043.0,"xmax":1200.0,"ymax":2136.0},{"id":73,"contenttext":"より祭政一致にして、","xmin":1080.0,"ymin":659.0,"xmax":1132.0,"ymax":1088.0},{"id":74,"contenttext":"支那王覇の道の傳來せるより以前に、","xmin":1077.0,"ymin":1115.0,"xmax":1131.0,"ymax":1870.0},{"id":75,"contenttext":"巳に政治の","xmin":1079.0,"ymin":1902.0,"xmax":1128.0,"ymax":2126.0},{"id":76,"contenttext":"道となりし也。","xmin":1012.0,"ymin":657.0,"xmax":1057.0,"ymax":948.0},{"id":77,"contenttext":"その他、","xmin":1010.0,"ymin":980.0,"xmax":1054.0,"ymax":1132.0},{"id":78,"contenttext":"神道は、","xmin":1008.0,"ymin":1164.0,"xmax":1059.0,"ymax":1320.0},{"id":79,"contenttext":"我が國民の實際的生活の總べての方面","xmin":1005.0,"ymin":1350.0,"xmax":1059.0,"ymax":2132.0},{"id":80,"contenttext":"に勢力を有せし也。","xmin":933.0,"ymin":657.0,"xmax":984.0,"ymax":1042.0},{"id":81,"contenttext":"元來、","xmin":861.0,"ymin":700.0,"xmax":913.0,"ymax":809.0},{"id":82,"contenttext":"神道の根本は、","xmin":861.0,"ymin":839.0,"xmax":913.0,"ymax":1136.0},{"id":83,"contenttext":"吾人大和民族が此の身體髮膚を神祖より禀け得","xmin":853.0,"ymin":1164.0,"xmax":920.0,"ymax":2132.0},{"id":84,"contenttext":"神道史綱要","xmin":799.0,"ymin":755.0,"xmax":838.0,"ymax":962.0},{"id":85,"contenttext":"五","xmin":797.0,"ymin":1857.0,"xmax":830.0,"ymax":1884.0},{"id":86,"contenttext":"カ","xmin":1647.0,"ymin":465.0,"xmax":1680.0,"ymax":501.0},{"id":87,"contenttext":"神道の勢","xmin":1672.0,"ymin":465.0,"xmax":1713.0,"ymax":587.0},{"id":88,"contenttext":"神道と其","xmin":871.0,"ymin":459.0,"xmax":907.0,"ymax":576.0},{"id":89,"contenttext":"の","xmin":844.0,"ymin":459.0,"xmax":880.0,"ymax":494.0},{"id":90,"contenttext":"變遷","xmin":844.0,"ymin":485.0,"xmax":879.0,"ymax":548.0},{"id":91,"contenttext":"吾人大和民族が此の身體髮膚を神祖より禀け得","xmin":853.0,"ymin":1164.0,"xmax":920.0,"ymax":2132.0},{"id":92,"contenttext":"五","xmin":797.0,"ymin":1857.0,"xmax":830.0,"ymax":1884.0}]