[{"id":0,"contenttext":"六","xmin":3129.0,"ymin":1918.0,"xmax":3166.0,"ymax":1955.0},{"id":1,"contenttext":"故に成佛と云ふて成神と云はず。","xmin":3030.0,"ymin":661.0,"xmax":3084.0,"ymax":1328.0},{"id":2,"contenttext":"物にして神靈を含藏せずと云ふことな","xmin":3037.0,"ymin":1354.0,"xmax":3091.0,"ymax":2142.0},{"id":3,"contenttext":"し」名法要集)と。","xmin":2955.0,"ymin":662.0,"xmax":3012.0,"ymax":965.0},{"id":4,"contenttext":"然れども是れ亦佛〓に基ける所ならずや。","xmin":2962.0,"ymin":984.0,"xmax":3016.0,"ymax":1835.0},{"id":5,"contenttext":"かくてト部家にては、","xmin":2888.0,"ymin":712.0,"xmax":2939.0,"ymax":1143.0},{"id":6,"contenttext":"神道の學理的方面のみならず、","xmin":2890.0,"ymin":1170.0,"xmax":2950.0,"ymax":1791.0},{"id":7,"contenttext":"進んで儀式的方","xmin":2900.0,"ymin":1820.0,"xmax":2951.0,"ymax":2146.0},{"id":8,"contenttext":"面も、","xmin":2816.0,"ymin":665.0,"xmax":2859.0,"ymax":770.0},{"id":9,"contenttext":"皆佛〓より取り來り、","xmin":2816.0,"ymin":802.0,"xmax":2868.0,"ymax":1230.0},{"id":10,"contenttext":"神道護摩、","xmin":2820.0,"ymin":1263.0,"xmax":2874.0,"ymax":1466.0},{"id":11,"contenttext":"神道加持などの法を設けり。","xmin":2824.0,"ymin":1493.0,"xmax":2878.0,"ymax":2069.0},{"id":12,"contenttext":"『鹽","xmin":2833.0,"ymin":2075.0,"xmax":2878.0,"ymax":2144.0},{"id":13,"contenttext":"尻","xmin":2745.0,"ymin":663.0,"xmax":2794.0,"ymax":717.0},{"id":14,"contenttext":"に神道護摩の條下に曰はく、","xmin":2743.0,"ymin":759.0,"xmax":2801.0,"ymax":1337.0},{"id":15,"contenttext":"「吉田兼倶の子僧九江、","xmin":2751.0,"ymin":1341.0,"xmax":2807.0,"ymax":1793.0},{"id":16,"contenttext":"吉田山下に一寺","xmin":2759.0,"ymin":1820.0,"xmax":2806.0,"ymax":2142.0},{"id":17,"contenttext":"を建て神龍院と號。","xmin":2669.0,"ymin":665.0,"xmax":2717.0,"ymax":1047.0},{"id":18,"contenttext":"九江法師、","xmin":2670.0,"ymin":1079.0,"xmax":2730.0,"ymax":1281.0},{"id":19,"contenttext":"此寺に始て行ひそめし法也。","xmin":2674.0,"ymin":1311.0,"xmax":2733.0,"ymax":1884.0},{"id":20,"contenttext":"然れば僧こ","xmin":2683.0,"ymin":1912.0,"xmax":2735.0,"ymax":2140.0},{"id":21,"contenttext":"そ修すべきに今詞官等傳受して之れを修するは、","xmin":2594.0,"ymin":665.0,"xmax":2656.0,"ymax":1648.0},{"id":22,"contenttext":"實に似げなき妄作なり」","xmin":2608.0,"ymin":1679.0,"xmax":2657.0,"ymax":2146.0},{"id":23,"contenttext":"と云へり。","xmin":2522.0,"ymin":669.0,"xmax":2571.0,"ymax":860.0},{"id":24,"contenttext":"但し神龍院とは、","xmin":2524.0,"ymin":898.0,"xmax":2573.0,"ymax":1234.0},{"id":25,"contenttext":"龍女神道を弘法に傳ふ。","xmin":2527.0,"ymin":1266.0,"xmax":2586.0,"ymax":1747.0},{"id":26,"contenttext":"之れ吉田家の神道","xmin":2535.0,"ymin":1773.0,"xmax":2589.0,"ymax":2144.0},{"id":27,"contenttext":"の本也。","xmin":2450.0,"ymin":667.0,"xmax":2500.0,"ymax":821.0},{"id":28,"contenttext":"故に善女龍神の名によりて名けしなりと。","xmin":2451.0,"ymin":849.0,"xmax":2508.0,"ymax":1694.0},{"id":29,"contenttext":"何れの方面より見る","xmin":2463.0,"ymin":1728.0,"xmax":2512.0,"ymax":2138.0},{"id":30,"contenttext":"も唯一神道の佛〓に基ける多きを見るべし。","xmin":2376.0,"ymin":667.0,"xmax":2434.0,"ymax":1564.0},{"id":31,"contenttext":"當時、","xmin":2305.0,"ymin":714.0,"xmax":2351.0,"ymax":821.0},{"id":32,"contenttext":"戰亂の世なりしも、","xmin":2303.0,"ymin":851.0,"xmax":2358.0,"ymax":1237.0},{"id":33,"contenttext":"別に二大神道哲學者の出づるありき。","xmin":2309.0,"ymin":1268.0,"xmax":2367.0,"ymax":2023.0},{"id":34,"contenttext":"即ち","xmin":2320.0,"ymin":2055.0,"xmax":2365.0,"ymax":2144.0},{"id":35,"contenttext":"北畠親房及び一條兼良の二卿也。","xmin":2229.0,"ymin":667.0,"xmax":2286.0,"ymax":1328.0},{"id":36,"contenttext":"親房は特に三種の神器を重んじ、","xmin":2237.0,"ymin":1360.0,"xmax":2292.0,"ymax":2024.0},{"id":37,"contenttext":"曰は","xmin":2248.0,"ymin":2055.0,"xmax":2291.0,"ymax":2140.0},{"id":38,"contenttext":"く","xmin":2168.0,"ymin":671.0,"xmax":2195.0,"ymax":719.0},{"id":39,"contenttext":"「轉輪王の世七寶具足す。","xmin":2157.0,"ymin":751.0,"xmax":2213.0,"ymax":1239.0},{"id":40,"contenttext":"福力の感ずる所たりと雖も、","xmin":2163.0,"ymin":1264.0,"xmax":2219.0,"ymax":1835.0},{"id":41,"contenttext":"子孫に傳ふる","xmin":2173.0,"ymin":1867.0,"xmax":2217.0,"ymax":2140.0},{"id":42,"contenttext":"北畠親房","xmin":2314.0,"ymin":469.0,"xmax":2352.0,"ymax":591.0},{"id":43,"contenttext":"璽符にあらず。","xmin":1810.0,"ymin":673.0,"xmax":1854.0,"ymax":965.0},{"id":44,"contenttext":"夏·商·周の世、","xmin":1803.0,"ymin":996.0,"xmax":1851.0,"ymax":1241.0},{"id":45,"contenttext":"九鼎を以つて寳となす。","xmin":1798.0,"ymin":1274.0,"xmax":1849.0,"ymax":1752.0},{"id":46,"contenttext":"此の鼎は乃ち夏后","xmin":1787.0,"ymin":1781.0,"xmax":1841.0,"ymax":2151.0},{"id":47,"contenttext":"氏の鑄造する所也。","xmin":1734.0,"ymin":671.0,"xmax":1788.0,"ymax":1057.0},{"id":48,"contenttext":"秦·漢より以來、","xmin":1728.0,"ymin":1086.0,"xmax":1781.0,"ymax":1378.0},{"id":49,"contenttext":"傳國の重あり。","xmin":1727.0,"ymin":1411.0,"xmax":1776.0,"ymax":1703.0},{"id":50,"contenttext":"始皇の制する所。","xmin":1718.0,"ymin":1736.0,"xmax":1769.0,"ymax":2077.0},{"id":51,"contenttext":"李","xmin":1717.0,"ymin":2104.0,"xmax":1766.0,"ymax":2150.0},{"id":52,"contenttext":"斯の書する所也。","xmin":1661.0,"ymin":669.0,"xmax":1713.0,"ymax":1012.0},{"id":53,"contenttext":"我が國の靈器に至つては、","xmin":1651.0,"ymin":1041.0,"xmax":1712.0,"ymax":1566.0},{"id":54,"contenttext":"神也、","xmin":1651.0,"ymin":1593.0,"xmax":1702.0,"ymax":1707.0},{"id":55,"contenttext":"又妙也。","xmin":1644.0,"ymin":1735.0,"xmax":1702.0,"ymax":1892.0},{"id":56,"contenttext":"之れを傳ふ","xmin":1638.0,"ymin":1919.0,"xmax":1698.0,"ymax":2149.0},{"id":57,"contenttext":"るもの即ち神聖、","xmin":1584.0,"ymin":671.0,"xmax":1638.0,"ymax":1010.0},{"id":58,"contenttext":"之れを齋くもの即ち天庭。","xmin":1577.0,"ymin":1039.0,"xmax":1633.0,"ymax":1566.0},{"id":59,"contenttext":"掛も畏き御宇珍子。","xmin":1572.0,"ymin":1595.0,"xmax":1628.0,"ymax":1979.0},{"id":60,"contenttext":"自ら貴","xmin":1570.0,"ymin":2012.0,"xmax":1615.0,"ymax":2148.0},{"id":61,"contenttext":"ぶべきは、","xmin":1516.0,"ymin":673.0,"xmax":1559.0,"ymax":867.0},{"id":62,"contenttext":"此の理也」(神國要道篇)と云ひ、","xmin":1505.0,"ymin":898.0,"xmax":1561.0,"ymax":1515.0},{"id":63,"contenttext":"進んで曰はく、","xmin":1500.0,"ymin":1548.0,"xmax":1552.0,"ymax":1837.0},{"id":64,"contenttext":"「鏡は一物をた","xmin":1493.0,"ymin":1860.0,"xmax":1548.0,"ymax":2147.0},{"id":65,"contenttext":"くはへず、","xmin":1441.0,"ymin":667.0,"xmax":1486.0,"ymax":869.0},{"id":66,"contenttext":"私の心なくして萬象を照すに是非善惡のすがたあらはれずと","xmin":1419.0,"ymin":898.0,"xmax":1489.0,"ymax":2142.0},{"id":67,"contenttext":"いふとなし。","xmin":1369.0,"ymin":673.0,"xmax":1410.0,"ymax":914.0},{"id":68,"contenttext":"そのすがたにしたがひて感應するを德とす。","xmin":1355.0,"ymin":945.0,"xmax":1415.0,"ymax":1840.0},{"id":69,"contenttext":"これ正直の本","xmin":1346.0,"ymin":1868.0,"xmax":1403.0,"ymax":2145.0},{"id":70,"contenttext":"源也。","xmin":1298.0,"ymin":667.0,"xmax":1341.0,"ymax":773.0},{"id":71,"contenttext":"玉は柔和善順を德とす。","xmin":1294.0,"ymin":804.0,"xmax":1341.0,"ymax":1281.0},{"id":72,"contenttext":"慈悲の本源也。","xmin":1288.0,"ymin":1311.0,"xmax":1337.0,"ymax":1605.0},{"id":73,"contenttext":"劔は剛利決斷を德とす。","xmin":1276.0,"ymin":1635.0,"xmax":1335.0,"ymax":2116.0},{"id":74,"contenttext":"知惠の本源也。","xmin":1224.0,"ymin":667.0,"xmax":1275.0,"ymax":960.0},{"id":75,"contenttext":"この三德を翕受ずしては、","xmin":1215.0,"ymin":992.0,"xmax":1272.0,"ymax":1511.0},{"id":76,"contenttext":"天下の治らんこと、","xmin":1208.0,"ymin":1541.0,"xmax":1266.0,"ymax":1926.0},{"id":77,"contenttext":"まことに","xmin":1208.0,"ymin":1960.0,"xmax":1252.0,"ymax":2137.0},{"id":78,"contenttext":"かたかるべし」(神皇正統記)と。","xmin":1149.0,"ymin":667.0,"xmax":1206.0,"ymax":1277.0},{"id":79,"contenttext":"かくて彼れは神道を神國の要道とし、","xmin":1134.0,"ymin":1310.0,"xmax":1204.0,"ymax":2069.0},{"id":80,"contenttext":"大","xmin":1134.0,"ymin":2096.0,"xmax":1187.0,"ymax":2144.0},{"id":81,"contenttext":"いに神道を以つて天下を統治せんとせり。","xmin":1069.0,"ymin":669.0,"xmax":1131.0,"ymax":1507.0},{"id":82,"contenttext":"されど彼れの神道は要するに","xmin":1055.0,"ymin":1541.0,"xmax":1122.0,"ymax":2137.0},{"id":83,"contenttext":"神佛によりてその說を成せるものなりき。","xmin":998.0,"ymin":663.0,"xmax":1055.0,"ymax":1511.0},{"id":84,"contenttext":"兼良亦儒〓佛及び道〓の理によりてその說を構成せり。","xmin":916.0,"ymin":710.0,"xmax":982.0,"ymax":1787.0},{"id":85,"contenttext":"かくて兼良は「三","xmin":908.0,"ymin":1815.0,"xmax":965.0,"ymax":2139.0},{"id":86,"contenttext":"神道史綱要","xmin":867.0,"ymin":784.0,"xmax":905.0,"ymax":987.0},{"id":87,"contenttext":"元","xmin":856.0,"ymin":1920.0,"xmax":891.0,"ymax":1955.0},{"id":88,"contenttext":"條兼良","xmin":943.0,"ymin":492.0,"xmax":980.0,"ymax":582.0},{"id":89,"contenttext":"かくて兼良は「三","xmin":908.0,"ymin":1815.0,"xmax":965.0,"ymax":2139.0},{"id":90,"contenttext":"元","xmin":856.0,"ymin":1920.0,"xmax":891.0,"ymax":1955.0}]