[{"id":0,"contenttext":"〓","xmin":3127.0,"ymin":1971.0,"xmax":3162.0,"ymax":2011.0},{"id":1,"contenttext":"定治家を嗣ぐ。","xmin":3065.0,"ymin":714.0,"xmax":3116.0,"ymax":1008.0},{"id":2,"contenttext":"寳曆元年定治亦歿す。","xmin":3051.0,"ymin":1036.0,"xmax":3113.0,"ymax":1474.0},{"id":3,"contenttext":"宣長乃ち家を嗣ぐことゝなりぬ。","xmin":3040.0,"ymin":1502.0,"xmax":3101.0,"ymax":2167.0},{"id":4,"contenttext":"時に年二十二。","xmin":2986.0,"ymin":713.0,"xmax":3046.0,"ymax":1010.0},{"id":5,"contenttext":"當時宣長が一家の狀態を見るに、","xmin":2970.0,"ymin":1034.0,"xmax":3040.0,"ymax":1703.0},{"id":6,"contenttext":"江戶の支店は已に閉ぢ","xmin":2962.0,"ymin":1731.0,"xmax":3024.0,"ymax":2194.0},{"id":7,"contenttext":"家產としては親戚小津氏に托したる四百金の利子あるのみ。","xmin":2895.0,"ymin":707.0,"xmax":2971.0,"ymax":1930.0},{"id":8,"contenttext":"宣長の母以","xmin":2889.0,"ymin":1960.0,"xmax":2946.0,"ymax":2192.0},{"id":9,"contenttext":"爲らく、","xmin":2851.0,"ymin":710.0,"xmax":2894.0,"ymax":862.0},{"id":10,"contenttext":"跡つぐ彌四郞(爐","xmin":2759.0,"ymin":798.0,"xmax":2827.0,"ymax":1126.0},{"id":11,"contenttext":"名","xmin":2761.0,"ymin":1127.0,"xmax":2794.0,"ymax":1165.0},{"id":12,"contenttext":"很の)あきなひのすぢにはうとくて、","xmin":2739.0,"ymin":1125.0,"xmax":2825.0,"ymax":1833.0},{"id":13,"contenttext":"たゞ書を讀むこ","xmin":2749.0,"ymin":1867.0,"xmax":2798.0,"ymax":2185.0},{"id":14,"contenttext":"とをのみ好めば、","xmin":2694.0,"ymin":752.0,"xmax":2756.0,"ymax":1092.0},{"id":15,"contenttext":"今より後商人となるとも事ゆかじ。","xmin":2681.0,"ymin":1118.0,"xmax":2743.0,"ymax":1834.0},{"id":16,"contenttext":"又家の資も隱居","xmin":2670.0,"ymin":1860.0,"xmax":2732.0,"ymax":2188.0},{"id":17,"contenttext":"家(小津氏)の店衰へぬればゆくさきうしろめたし。","xmin":2613.0,"ymin":747.0,"xmax":2685.0,"ymax":1740.0},{"id":18,"contenttext":"若かの店事あらむに","xmin":2598.0,"ymin":1768.0,"xmax":2657.0,"ymax":2184.0},{"id":19,"contenttext":"はわれ等何を以つてか世を渡らむ。","xmin":2540.0,"ymin":749.0,"xmax":2602.0,"ymax":1458.0},{"id":20,"contenttext":"かねて其心づかひせではあるべか","xmin":2528.0,"ymin":1490.0,"xmax":2590.0,"ymax":2179.0},{"id":21,"contenttext":"らず。","xmin":2477.0,"ymin":747.0,"xmax":2523.0,"ymax":856.0},{"id":22,"contenttext":"然れば彌四郎は、","xmin":2465.0,"ymin":883.0,"xmax":2527.0,"ymax":1227.0},{"id":23,"contenttext":"京に上りて學問をしくすしにならんこそよか","xmin":2450.0,"ymin":1257.0,"xmax":2522.0,"ymax":2177.0},{"id":24,"contenttext":"らめ。","xmin":2408.0,"ymin":749.0,"xmax":2446.0,"ymax":850.0},{"id":25,"contenttext":"(家の昔物語)","xmin":2397.0,"ymin":872.0,"xmax":2448.0,"ymax":1128.0},{"id":26,"contenttext":"と。","xmin":2344.0,"ymin":702.0,"xmax":2375.0,"ymax":755.0},{"id":27,"contenttext":"宣長乃ち寳曆二年を以つて京師に上り、","xmin":2317.0,"ymin":789.0,"xmax":2381.0,"ymax":1593.0},{"id":28,"contenttext":"儒堀景山の門に入り、","xmin":2306.0,"ymin":1623.0,"xmax":2367.0,"ymax":2057.0},{"id":29,"contenttext":"先づ","xmin":2307.0,"ymin":2086.0,"xmax":2356.0,"ymax":2177.0},{"id":30,"contenttext":"儒學を修め、","xmin":2252.0,"ymin":696.0,"xmax":2315.0,"ymax":948.0},{"id":31,"contenttext":"同四年典藥武川幸順に就き初めて醫學を學べり。","xmin":2236.0,"ymin":975.0,"xmax":2305.0,"ymax":1961.0},{"id":32,"contenttext":"かくて宣","xmin":2231.0,"ymin":1993.0,"xmax":2281.0,"ymax":2177.0},{"id":33,"contenttext":"長偶、契沖の「百人一首改觀抄」、","xmin":2176.0,"ymin":693.0,"xmax":2242.0,"ymax":1282.0},{"id":34,"contenttext":"「古今餘材抄」、「勢語臆斷等の書に接し、","xmin":2164.0,"ymin":1280.0,"xmax":2227.0,"ymax":2053.0},{"id":35,"contenttext":"茲に","xmin":2162.0,"ymin":2084.0,"xmax":2209.0,"ymax":2175.0},{"id":36,"contenttext":"古學〓究の志を起しぬ。","xmin":1774.0,"ymin":696.0,"xmax":1825.0,"ymax":1175.0},{"id":37,"contenttext":"宣長年二十八、","xmin":1698.0,"ymin":743.0,"xmax":1751.0,"ymax":1034.0},{"id":38,"contenttext":"松坂に歸り、","xmin":1698.0,"ymin":1066.0,"xmax":1747.0,"ymax":1312.0},{"id":39,"contenttext":"醫を開業せり。","xmin":1698.0,"ymin":1344.0,"xmax":1747.0,"ymax":1635.0},{"id":40,"contenttext":"當時彼れ又眞淵の「冠辭考」","xmin":1698.0,"ymin":1666.0,"xmax":1757.0,"ymax":2189.0},{"id":41,"contenttext":"を得、","xmin":1629.0,"ymin":696.0,"xmax":1678.0,"ymax":805.0},{"id":42,"contenttext":"益〓古學神道〓究の志を深うし、","xmin":1627.0,"ymin":835.0,"xmax":1676.0,"ymax":1451.0},{"id":43,"contenttext":"更に「冠辭考」を熟讀するや、","xmin":1625.0,"ymin":1482.0,"xmax":1678.0,"ymax":2007.0},{"id":44,"contenttext":"愈、眞淵","xmin":1632.0,"ymin":2038.0,"xmax":1681.0,"ymax":2175.0},{"id":45,"contenttext":"に接せんの希望を起しぬ。","xmin":1555.0,"ymin":698.0,"xmax":1604.0,"ymax":1220.0},{"id":46,"contenttext":"乃ち記して曰はく、","xmin":1555.0,"ymin":1252.0,"xmax":1604.0,"ymax":1635.0},{"id":47,"contenttext":"かへす〓〓讀み味ふほどに、","xmin":1480.0,"ymin":792.0,"xmax":1529.0,"ymax":1357.0},{"id":48,"contenttext":"いよ〓〓心ざし深くなりつゝ此大人を","xmin":1479.0,"ymin":1393.0,"xmax":1533.0,"ymax":2175.0},{"id":49,"contenttext":"したふ心、","xmin":1408.0,"ymin":743.0,"xmax":1455.0,"ymax":944.0},{"id":50,"contenttext":"日にそへてせちなりし。","xmin":1408.0,"ymin":978.0,"xmax":1456.0,"ymax":1455.0},{"id":51,"contenttext":"(王勝間)","xmin":1408.0,"ymin":1473.0,"xmax":1455.0,"ymax":1635.0},{"id":52,"contenttext":"と。","xmin":1347.0,"ymin":700.0,"xmax":1377.0,"ymax":752.0},{"id":53,"contenttext":"偶〓眞淵松坂に來るに會し、","xmin":1335.0,"ymin":790.0,"xmax":1386.0,"ymax":1314.0},{"id":54,"contenttext":"初めて刺を通ずるを得たり。","xmin":1337.0,"ymin":1344.0,"xmax":1384.0,"ymax":1913.0},{"id":55,"contenttext":"眞淵一たび","xmin":1339.0,"ymin":1943.0,"xmax":1388.0,"ymax":2173.0},{"id":56,"contenttext":"見て宣長の偉器たるを認め、","xmin":1263.0,"ymin":696.0,"xmax":1312.0,"ymax":1267.0},{"id":57,"contenttext":"智襟を開いて之れと道を語り、","xmin":1263.0,"ymin":1299.0,"xmax":1312.0,"ymax":1913.0},{"id":58,"contenttext":"江戶に歸る","xmin":1263.0,"ymin":1944.0,"xmax":1318.0,"ymax":2173.0},{"id":59,"contenttext":"や、","xmin":1198.0,"ymin":698.0,"xmax":1243.0,"ymax":760.0},{"id":60,"contenttext":"門弟子を集めて宴を設け、","xmin":1192.0,"ymin":788.0,"xmax":1241.0,"ymax":1314.0},{"id":61,"contenttext":"賢才を得たるを祝したりと云ふ。","xmin":1191.0,"ymin":1344.0,"xmax":1243.0,"ymax":2009.0},{"id":62,"contenttext":"勿論、","xmin":1124.0,"ymin":745.0,"xmax":1171.0,"ymax":849.0},{"id":63,"contenttext":"宣長、","xmin":1122.0,"ymin":882.0,"xmax":1171.0,"ymax":993.0},{"id":64,"contenttext":"江戶に出でゝ眞淵に朝夕親炙する能はざりしと雖も、","xmin":1118.0,"ymin":1021.0,"xmax":1172.0,"ymax":2099.0},{"id":65,"contenttext":"爾","xmin":1128.0,"ymin":2131.0,"xmax":1173.0,"ymax":2175.0},{"id":66,"contenttext":"來、","xmin":1048.0,"ymin":694.0,"xmax":1106.0,"ymax":762.0},{"id":67,"contenttext":"文書を以つて盛に交通し、","xmin":1050.0,"ymin":788.0,"xmax":1102.0,"ymax":1316.0},{"id":68,"contenttext":"眞淵の指導の下に熱心〓究に從事し、","xmin":1050.0,"ymin":1344.0,"xmax":1104.0,"ymax":2105.0},{"id":69,"contenttext":"一","xmin":1063.0,"ymin":2141.0,"xmax":1096.0,"ymax":2164.0},{"id":70,"contenttext":"方に於いては終生の大業たる「古事記傳」を編纂すると同時に、","xmin":972.0,"ymin":696.0,"xmax":1026.0,"ymax":1916.0},{"id":71,"contenttext":"「直日靈」、","xmin":976.0,"ymin":1936.0,"xmax":1027.0,"ymax":2112.0},{"id":72,"contenttext":"爲","xmin":981.0,"ymin":2116.0,"xmax":1026.0,"ymax":2181.0},{"id":73,"contenttext":"花、","xmin":895.0,"ymin":694.0,"xmax":952.0,"ymax":763.0},{"id":74,"contenttext":"「馭戎〓言、","xmin":899.0,"ymin":788.0,"xmax":950.0,"ymax":1003.0},{"id":75,"contenttext":"「玉匣」等幾多有益なる著書を公にせり。","xmin":896.0,"ymin":1007.0,"xmax":949.0,"ymax":1778.0},{"id":76,"contenttext":"神道史綱要","xmin":832.0,"ymin":825.0,"xmax":871.0,"ymax":1032.0},{"id":77,"contenttext":"量","xmin":834.0,"ymin":1955.0,"xmax":871.0,"ymax":2001.0},{"id":78,"contenttext":"量","xmin":834.0,"ymin":1955.0,"xmax":871.0,"ymax":2001.0}]